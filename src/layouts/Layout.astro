---
import Header from '../components/Header.astro';
import Footer from '@/components/sections/Footer.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import CookieConsent from '@/components/common/CookieConsent.astro';

import SpeedInsights from '@vercel/speed-insights/astro';
import '@styles/global.css';
import { initMobileEnhancements } from '@utils/mobile-enhancements';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'service' | 'organization';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  schema?: object;
}

// Use SEO config from page if available, otherwise use individual props
const seoData = Astro.props.seoConfig || Astro.props;

const {
  title = seoData.title,
  description = seoData.description,
  keywords = seoData.keywords,
  image = seoData.image,
  canonical = seoData.canonical,
  noindex = seoData.noindex || false,
  type = seoData.type || 'website',
  publishedTime = seoData.publishedTime,
  modifiedTime = seoData.modifiedTime,
  author = seoData.author,
  schema = seoData.schema
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '');
const lang = path.startsWith('/fi') ? 'fi' : 'en';

// SEO defaults
const siteName = "Cyber Security Finland";
const siteUrl = "https://cybersecurity.fi";
const defaultDescription = lang === 'fi'
  ? "Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta. ISO 27001, NIS2, GDPR ja DORA -toteutus todistetuin menetelmin maailmanlaajuisille organisaatioille."
  : "Enterprise cybersecurity and compliance advisory. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies for global organizations.";

const pageTitle = title ? `${title} | ${siteName}` : siteName;
const pageDescription = description || defaultDescription;
const pageImage = image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : `${siteUrl}/images/social.png`;
const pageUrl = canonical || `${siteUrl}${Astro.url.pathname}`;

// Generate hreflang links
const basePath = lang === 'fi' ? path.replace(/^\/fi/, '') || '/' : path;
const enUrl = `${siteUrl}${basePath}`;
const fiUrl = `${siteUrl}/fi${basePath === '/' ? '' : basePath}`;
---

<html lang={lang} class="scroll-pt-28">
  <head>
    <!-- Google tag (gtag.js) -->
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V1WCCZBL3S" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-V1WCCZBL3S');
    </script>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Basic SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {keywords && <meta name="keywords" content={keywords} />}
    
    <!-- Robots -->
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Canonical URL -->
    <link rel="canonical" href={pageUrl} />
    
    <!-- Hreflang -->
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="fi" href={fiUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    
    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={pageImage} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={lang === 'fi' ? 'fi_FI' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={pageImage} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/Logo Blue_F.svg" />
    <link rel="apple-touch-icon" href="/Logo Blue_F.svg" />

    <!-- PWA Meta Tags -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0EA5E9" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="CyberSecFI">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="format-detection" content="telephone=no">

    <!-- Preconnect to external domains for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />

    <!-- DNS prefetch for better performance -->
    <link rel="dns-prefetch" href="//www.google-analytics.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />

    <!-- Resource hints for critical assets -->
    <link rel="preload" href="/cyber-security-finland-nis2-service-compliance.png" as="image" />

    <!-- Performance optimization styles -->
    <style>
      /* Prevent layout shift */
      img[loading="lazy"] {
        aspect-ratio: attr(width) / attr(height);
        background: #f1f5f9;
      }

      /* Critical CSS for faster rendering */
      .critical { opacity: 1; }
      .non-critical { opacity: 0; }
    </style>
    
    <!-- Structured Data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Default Organization Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Cyber Security Finland",
        "url": "https://cybersecurity.fi",
        "logo": "https://cybersecurity.fi/csf-logo-2026.png",
        "sameAs": [
          "https://www.linkedin.com/company/cyber-security-finland"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+358 44 5040308",
          "contactType": "customer service",
          "availableLanguage": ["English", "Finnish"]
        },
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "FI",
          "addressLocality": "Finland"
        },
        "description": "Enterprise cybersecurity and compliance advisory services. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies trusted by global organizations.",
        "serviceType": [
          "Cybersecurity Consulting",
          "ISO 27001 Implementation",
          "NIS2 Compliance",
          "GDPR Compliance",
          "DORA Implementation",
          "Risk Management",
          "Information Security",
          "Enterprise Security Advisory",
          "Compliance Framework Implementation"
        ],
        "areaServed": [
          {
            "@type": "Country",
            "name": "Finland"
          },
          {
            "@type": "Place",
            "name": "European Union"
          },
          {
            "@type": "Place",
            "name": "Global"
          }
        ],
        "foundingDate": "2020",
        "knowsLanguage": ["en", "fi"],
        "award": [
          "ISO 27001 Certified",
          "GDPR Compliance Experts",
          "NIS2 Directive Specialists"
        ]
      }
    </script>

    <!-- Service Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "serviceType": "Enterprise Cybersecurity Advisory",
        "provider": {
          "@type": "Organization",
          "name": "Cyber Security Finland"
        },
        "areaServed": [
          {
            "@type": "Country",
            "name": "Finland"
          },
          {
            "@type": "Place",
            "name": "European Union"
          },
          {
            "@type": "Place",
            "name": "Global"
          }
        ],
        "offers": {
          "@type": "Offer",
          "priceSpecification": {
            "@type": "PriceSpecification",
            "valueAddedTaxIncluded": "true"
          }
        },
        "description": "Enterprise cybersecurity and compliance advisory services including ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies for global organizations."
      }
    </script>

    <!-- Local Business Schema (for Finland market) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Cyber Security Finland",
        "image": "https://cybersecurity.fi/csf-logo-2026.png",
        "telephone": "+358 44 5040308",
        "email": "info@cybersecurity.fi",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "FI",
          "addressRegion": "Finland"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 60.1699,
          "longitude": 24.9384
        },
        "url": "https://cybersecurity.fi",
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "17:00"
        },
        "areaServed": {
          "@type": "Country",
          "name": "FI"
        },
        "availableLanguage": ["English", "Finnish"],
        "serviceType": "Cybersecurity Services"
      }
    </script>
    <!-- Force Lexend font globally -->
<style is:global>
  /* Override everything with Lexend */
  html, body, *, *::before, *::after {
    font-family: 'Lexend', sans-serif !important;
  }
  
  /* Keep monospace for code elements */
  code, pre, kbd, samp {
    font-family: 'SF Mono', 'Monaco', 'Courier New', monospace !important;
  }
</style>
  </head>
  <!-- Clean white background - Hero and Trust Bar control their own gradients -->
  <body class="bg-white">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-white px-4 py-2 rounded shadow">Skip to content</a>

    <!-- Header with Improved Navigation -->
    <Header />

    <!-- Enhanced Breadcrumbs -->
    {(() => {
      if (path === '' || path === '/' || path === '/fi') return null;
      return <Breadcrumbs />;
    })()}

    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>

    <Footer />
    <CookieConsent />
    <SpeedInsights />

    <!-- Enhanced initialization script -->
    <script>
      // Only run on client-side
      if (typeof window !== 'undefined') {
        // Initialize mobile enhancements
        import('@utils/mobile-enhancements').then(mod => {
          mod.initMobileEnhancements();
        }).catch(err => {
          // Silently fail for non-critical enhancement
        });

        // Initialize accessibility features
        import('@utils/accessibility').then(mod => {
          mod.initAccessibilityFeatures();
        }).catch(err => {
          // Silently fail for non-critical enhancement
        });

        // Initialize performance optimizations
        import('@utils/performance').then(mod => {
          mod.initPerformanceOptimizations();
        }).catch(err => {
          // Silently fail for non-critical enhancement
        });

        // Register Service Worker for performance optimization (skip on local dev, and
        // proactively clean up any worker/cache left over from before this fix existed,
        // so cached pages never mask changes while iterating)
        const isLocalDev = ['localhost', '127.0.0.1'].includes(window.location.hostname);
        if ('serviceWorker' in navigator && !isLocalDev) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js')
              .then(() => {
                // Service worker registered successfully
              })
              .catch(() => {
                // Service worker registration failed - non-critical
              });
          });
        } else if ('serviceWorker' in navigator && isLocalDev) {
          navigator.serviceWorker.getRegistrations().then(regs => {
            regs.forEach(reg => reg.unregister());
          });
          if (window.caches) {
            caches.keys().then(keys => keys.forEach(key => caches.delete(key)));
          }
        }

        // Performance monitoring
        window.addEventListener('load', () => {
          // Send performance metrics to service worker
          if (navigator.serviceWorker && navigator.serviceWorker.controller) {
            navigator.serviceWorker.controller.postMessage({
              type: 'PERFORMANCE_METRICS',
              metrics: {
                loadTime: performance.now(),
                domContentLoaded: performance.timing.domContentLoadedEventEnd - performance.timing.navigationStart,
                networkTime: performance.timing.responseEnd - performance.timing.fetchStart,
                page: window.location.pathname
              }
            });
          }
        });
      }
    </script>
  </body>
</html>