---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = lang === 'fi' ? "Kriittinen infrastruktuuri" : "Critical Infrastructure";

const content = {
  en: {
    title: "Critical Infrastructure",
    subtitle: "Critical Infrastructure Cybersecurity",
    heroDescription: "Comprehensive cybersecurity and compliance services for energy and critical infrastructure organizations. We help protect critical systems and ensure continuous operation.",
    forWho: "Energy producers, power grids, water utilities, transportation systems, industrial facilities, and other critical infrastructure organizations looking to strengthen their cybersecurity.",
    achieve: "NIS2 compliance, critical system protection, operational technology security, and resilient cybersecurity.",
    challenges: {
      title: "Key Challenges",
      subtitle: "Critical infrastructure faces unique cybersecurity challenges that require specialized expertise.",
      items: [
        {
          title: "NIS2 Compliance",
          description: "Meeting EU critical infrastructure cybersecurity directive requirements",
          icon: "shield"
        },
        {
          title: "OT Security",
          description: "Strengthening cybersecurity for industrial systems and SCADA systems",
          icon: "cpu"
        },
        {
          title: "Business Continuity",
          description: "Ensuring critical services continue operating during cyber attacks",
          icon: "bolt"
        },
        {
          title: "Regulatory Compliance",
          description: "Meeting energy and critical infrastructure regulatory requirements",
          icon: "document"
        }
      ]
    },
    solutions: {
      title: "Our Solutions",
      subtitle: "Comprehensive services that help critical infrastructure organizations strengthen their cybersecurity.",
      items: [
        {
          title: "NIS2 Program",
          description: "Comprehensive NIS2 compliance program for critical infrastructure",
          icon: "check"
        },
        {
          title: "OT Cybersecurity",
          description: "Strengthening cybersecurity for operational technology systems",
          icon: "server"
        },
        {
          title: "Incident Response",
          description: "Rapid and effective handling of critical cyber incidents",
          icon: "clock"
        },
        {
          title: "Risk Management",
          description: "Comprehensive risk management system for critical infrastructure",
          icon: "chart"
        }
      ]
    },
    benefits: {
      title: "Benefits",
      subtitle: "Why critical infrastructure organizations choose us for their cybersecurity services.",
      items: [
        "Meet NIS2 and other regulatory requirements",
        "Protect critical systems",
        "Ensure business continuity",
        "Enhance operational technology security",
        "Strengthen cybersecurity resilience"
      ]
    }
  },
  fi: {
    title: "Kriittinen infrastruktuuri",
    subtitle: "Kriittisen infrastruktuurin kyberturva",
    heroDescription: "Kattavat kyberturva- ja yhteensopivuuspalvelut energian ja kriittisen infrastruktuurin organisaatioille. Autamme suojaamaan kriittisiä järjestelmiä ja varmistamaan jatkuvan toiminnan.",
    forWho: "Energian tuottajat, sähköverkot, vesilaitokset, liikennejärjestelmät, teollisuuslaitokset ja muut kriittisen infrastruktuurin organisaatiot, jotka haluavat vahvistaa kyberturvaansa.",
    achieve: "NIS2 yhteensopivuus, kriittisten järjestelmien suoja, operaatioteknologian turvallisuus ja kestävä kyberturva.",
    challenges: {
      title: "Suurimmat haasteet",
      subtitle: "Kriittinen infrastruktuuri kohtaa ainutlaatuisia kyberturvahaasteita, jotka vaativat erikoistunutta osaamista.",
      items: [
        {
          title: "NIS2 Yhteensopivuus",
          description: "EU:n kriittisen infrastruktuurin kyberturvadirektiivin vaatimusten täyttäminen",
          icon: "shield"
        },
        {
          title: "Operaatioteknologian suojaus",
          description: "Teollisuusjärjestelmien ja SCADA-järjestelmien kyberturvan vahvistaminen",
          icon: "cpu"
        },
        {
          title: "Jatkuvan toiminnan varmistus",
          description: "Kriittisten palvelujen toiminnan varmistaminen kyberhyökkäysten aikana",
          icon: "bolt"
        },
        {
          title: "Regulaattorinen yhteensopivuus",
          description: "Energian ja kriittisen infrastruktuurin sääntelyvaatimusten täyttäminen",
          icon: "document"
        }
      ]
    },
    solutions: {
      title: "Ratkaisumme",
      subtitle: "Kattavat palvelut, jotka auttavat kriittisen infrastruktuurin organisaatioita vahvistamaan kyberturvaansa.",
      items: [
        {
          title: "NIS2 Ohjelma",
          description: "Kattava NIS2 yhteensopivuusohjelma kriittiselle infrastruktuurille",
          icon: "check"
        },
        {
          title: "OT Kyberturva",
          description: "Operaatioteknologian järjestelmien kyberturvan vahvistaminen",
          icon: "server"
        },
        {
          title: "Incident Response",
          description: "Kriittisten kyberincidenttien nopea ja tehokas käsittely",
          icon: "clock"
        },
        {
          title: "Riskienhallinta",
          description: "Kattava riskienhallintajärjestelmä kriittiselle infrastruktuurille",
          icon: "chart"
        }
      ]
    },
    benefits: {
      title: "Edut",
      subtitle: "Miksi kriittisen infrastruktuurin organisaatiot valitsevat meidät kyberturvapalveluihinsa.",
      items: [
        "Täytä NIS2 ja muut sääntelyvaatimukset",
        "Suojaa kriittisiä järjestelmiä",
        "Varmista jatkuvan toiminnan",
        "Paranna operaatioteknologian turvallisuutta",
        "Vahvista kyberturvan kestävyyttä"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenges Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.challenges.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.challenges.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.challenges.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-start mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base md:text-lg font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solutions Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.solutions.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.solutions.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.solutions.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-start mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base md:text-lg font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

<!-- Benefits Section -->
<section class="py-12 md:py-16 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
        {currentContent.benefits.title}
      </h2>
      <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
        {currentContent.benefits.subtitle}
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.benefits.items.map((benefit) => (
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                    hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                    transition-all duration-300
                    flex items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[4px] transition-all duration-300 z-20"></div>
          
          <div class="flex-shrink-0 relative z-10">
            <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center
                        border-2 border-[#0EA5E9]
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                        group-hover:border-transparent">
              <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
          </div>
          <span class="text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300 relative z-10">
            {benefit}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>


</Layout>