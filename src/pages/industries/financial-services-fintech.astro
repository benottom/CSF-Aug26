---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = lang === 'fi' ? "Rahoituspalvelut ja Fintech" : "Financial Services";

const content = {
  en: {
    title: "Financial Services",
    subtitle: "Financial Services Cybersecurity",
    heroDescription: "Comprehensive cybersecurity and compliance services for financial services and fintech organizations. We help organizations protect financial data and meet regulatory requirements.",
    forWho: "Banks, insurance companies, investment services, fintech startups, and other financial service organizations looking to strengthen their cybersecurity and meet regulatory requirements.",
    achieve: "DORA compliance, stronger anti-fraud protection, ISO 27001 certification, and resilient cybersecurity.",
    challenges: {
      title: "Key Challenges",
      subtitle: "Financial services face unique cybersecurity challenges that require specialized expertise.",
      items: [
        {
          title: "DORA Compliance",
          description: "Meeting EU Digital Operational Resilience Act requirements",
          icon: "shield"
        },
        {
          title: "PCI DSS Compliance",
          description: "Meeting Payment Card Industry Data Security Standards",
          icon: "creditCard"
        },
        {
          title: "Anti-Fraud Measures",
          description: "Advanced fraud detection and prevention systems",
          icon: "alert"
        },
        {
          title: "Third-Party Risks",
          description: "Managing cybersecurity risks from vendors and partners",
          icon: "network"
        }
      ]
    },
    solutions: {
      title: "Our Solutions",
      subtitle: "Comprehensive services that help financial services strengthen their cybersecurity and meet regulatory requirements.",
      items: [
        {
          title: "DORA Program",
          description: "Comprehensive DORA compliance program for financial services",
          icon: "check"
        },
        {
          title: "ISO 27001 Certification",
          description: "Information security management system certification for financial services",
          icon: "certificate"
        },
        {
          title: "Fraud Risk Assessment",
          description: "Comprehensive fraud risk assessment and management system",
          icon: "shield"
        },
        {
          title: "Risk Management",
          description: "Comprehensive risk management system for financial services",
          icon: "chart"
        }
      ]
    },
    benefits: {
      title: "Benefits",
      subtitle: "Why financial service organizations choose us for their cybersecurity services.",
      items: [
        "Meet DORA and other regulatory requirements",
        "Protect customer financial data",
        "Strengthen anti-fraud measures",
        "Enhance customer trust",
        "Strengthen cybersecurity resilience"
      ]
    }
  },
  fi: {
    title: "Rahoituspalvelut",
    subtitle: "Rahoituspalvelujen kyberturva",
    heroDescription: "Kattavat kyberturva- ja yhteensopivuuspalvelut rahoituspalveluille ja fintech-yrityksille. Autamme organisaatioita suojaamaan rahoitustietoja ja täyttämään sääntelyvaatimukset.",
    forWho: "Pankit, vakuutusyhtiöt, sijoituspalvelut, fintech-startupit ja muut rahoituspalveluorganisaatiot, jotka haluavat vahvistaa kyberturvaansa ja täyttää sääntelyvaatimukset.",
    achieve: "DORA yhteensopivuus, vahvempi petosten vastainen suojaus, ISO 27001 sertifiointi ja kestävä kyberturva.",
    challenges: {
      title: "Suurimmat haasteet",
      subtitle: "Rahoituspalvelut kohtaavat ainutlaatuisia kyberturvahaasteita, jotka vaativat erikoistunutta osaamista.",
      items: [
        {
          title: "DORA Yhteensopivuus",
          description: "EU:n digitaalisen operatiivisen resilienssin lain vaatimusten täyttäminen",
          icon: "shield"
        },
        {
          title: "PCI DSS Yhteensopivuus",
          description: "Luottokorttitietojen käsittelyn turvallisuusstandardien täyttäminen",
          icon: "creditCard"
        },
        {
          title: "Petosten vastaiset toimenpiteet",
          description: "Edistyneet petosten tunnistus- ja estojärjestelmät",
          icon: "alert"
        },
        {
          title: "Kolmannen osapuolen riskit",
          description: "Toimittajien ja kumppaneiden kyberturvariskien hallinta",
          icon: "network"
        }
      ]
    },
    solutions: {
      title: "Ratkaisumme",
      subtitle: "Kattavat palvelut, jotka auttavat rahoituspalveluja vahvistamaan kyberturvaansa ja täyttämään sääntelyvaatimukset.",
      items: [
        {
          title: "DORA Ohjelma",
          description: "Kattava DORA yhteensopivuusohjelma rahoituspalveluille",
          icon: "check"
        },
        {
          title: "ISO 27001 Sertifiointi",
          description: "Tietoturvajärjestelmän sertifiointi rahoituspalveluille",
          icon: "certificate"
        },
        {
          title: "Petosten riskinarviointi",
          description: "Kattava petosten riskinarviointi ja hallintajärjestelmä",
          icon: "shield"
        },
        {
          title: "Riskienhallinta",
          description: "Kattava riskienhallintajärjestelmä rahoituspalveluille",
          icon: "chart"
        }
      ]
    },
    benefits: {
      title: "Edut",
      subtitle: "Miksi rahoituspalveluorganisaatiot valitsevat meidät kyberturvapalveluihinsa.",
      items: [
        "Täytä DORA ja muut sääntelyvaatimukset",
        "Suojaa asiakkaiden rahoitustiedot",
        "Vahvista petosten vastaisia toimenpiteitä",
        "Paranna asiakkaiden luottamusta",
        "Vahvista kyberturvan kestävyyttä"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Challenges Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.challenges.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.challenges.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.challenges.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-start mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base md:text-lg font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Solutions Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.solutions.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.solutions.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.solutions.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-start mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base md:text-lg font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[4px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <span class="text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300 relative z-10">
              {benefit}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>