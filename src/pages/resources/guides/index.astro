---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Ohjeet ja oppaat" : "Guides & Tutorials",
  description: lang === 'fi'
    ? "Lataa ohjeita ja oppaita kyberturvallisuuden ja sääntelyn noudattamiseksi."
    : "Download guides and tutorials for cybersecurity and compliance.",
  type: "page" as const,
};

const guides = [
  {
    title: lang === 'fi' ? 'ISO 27001 Pika-aloitusopas' : 'ISO 27001 Quick Start Guide',
    description: lang === 'fi' 
      ? '25-sivuinen toteutusroadmap organisaatiollesi' 
      : '25-page implementation roadmap for your organization',
    framework: 'ISO 27001',
    date: '2024-01-15',
    readTime: '5 min',
    url: '/resources/guides/iso-27001-quick-start',
    category: 'Implementation'
  },
  {
    title: lang === 'fi' ? 'NIS2 Vaatimustarkistuslista' : 'NIS2 Compliance Checklist',
    description: lang === 'fi' 
      ? 'Täydellinen vaatimusanalyysityökalu' 
      : 'Complete requirement assessment tool',
    framework: 'NIS2',
    date: '2024-02-20',
    readTime: '3 min',
    url: '/resources/guides/nis2-compliance-checklist',
    category: 'Compliance'
  },
  {
    title: lang === 'fi' ? 'Riskienhallinnan Paraslähestymistapa' : 'Risk Management Best Practices',
    description: lang === 'fi' 
      ? 'ISO 27005 ja ISO 31000 -standardien mukainen' 
      : 'Based on ISO 27005 and ISO 31000 standards',
    framework: 'Risk Management',
    date: '2024-02-05',
    readTime: '12 min',
    url: '/resources/guides/risk-management-best-practices',
    category: 'Best Practices'
  },
  {
    title: lang === 'fi' ? 'DORA Vaatimustenmukaisuus -Tarkistuslista' : 'DORA Compliance Checklist',
    description: lang === 'fi' 
      ? 'Digitaalisen toiminnan resilierenssin arviointi' 
      : 'Digital operational resilience assessment',
    framework: 'DORA',
    date: '2024-03-10',
    readTime: '4 min',
    url: '/resources/guides/dora-compliance-checklist',
    category: 'Compliance'
  }
];

const currentContent = { guides };
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {isFi ? 'Ohjeet ja oppaat' : 'Guides & Tutorials'}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {isFi 
            ? 'Lataa ohjeita ja oppaita kyberturvallisuuden ja sääntelyn noudattamiseksi.'
            : 'Download guides and tutorials for cybersecurity and compliance.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Guides Grid -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {guides.map((guide) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start justify-between mb-3 relative z-10">
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-[#3B82F6]/10 text-[#3B82F6]">
                  {guide.category}
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  {guide.framework}
                </span>
              </div>
              <Icon name="bookOpen" class="h-5 w-5 text-slate-400 group-hover:text-[#3B82F6] transition-colors duration-300" />
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {guide.title}
            </h3>
            
            <p class="text-sm text-slate-500 leading-relaxed mb-4 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {guide.description}
            </p>
            
            <div class="flex items-center justify-between text-xs text-slate-400 mb-4 relative z-10">
              <span>{guide.date}</span>
              <span>{guide.readTime}</span>
            </div>
            
            <a 
              href={guide.url}
              class="mt-auto inline-flex items-center justify-center px-4 py-2 rounded-full border-2 border-[#3B82F6] text-[#3B82F6] hover:bg-gradient-to-r hover:from-[#3bb1f6] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 relative z-10"
            >
              {isFi ? 'Lataa opas' : 'Download Guide'}
              <Icon name="arrowDownTray" class="h-4 w-4" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>