---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: 'Trust Center - Cyber Security Finland',
  description: 'Our Trust Center provides comprehensive information about security, compliance, and operational practices at Cyber Security Finland.',
  keywords: 'trust center, security practices, compliance, ISO 27001, GDPR, NIS2, data protection',
  type: 'trust' as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Trust Center",
      subtitle: "Comprehensive information about our security practices, compliance, and commitment to protecting your data",
    },
    security: {
      title: "Security & Compliance",
      items: [
        { title: "Our Approach to ISO 27001", description: "We apply ISO 27001 information security management principles in how we operate, and help clients implement ISO 27001 themselves. Cyber Security Finland does not hold ISO 27001 certification as an organization." },
        { title: "GDPR", description: "As a company processing personal data in the EU, we are subject to GDPR and maintain data protection policies accordingly." }
      ]
    },
    dataProtection: {
      title: "Data Protection Practices",
      items: [
        { title: "Data Minimization", description: "We aim to collect only the data necessary to provide our services." },
        { title: "Encrypted Transmission", description: "Our website and client-facing systems use TLS/SSL encryption in transit." },
        { title: "Access Controls", description: "Access to client data is limited to authorized personnel." },
        { title: "Incident Handling", description: "We have a process for handling and reporting security incidents. Contact us for details relevant to your engagement." }
      ]
    },
    certifications: {
      title: "Standards We Work With",
      items: [
        "ISO 27001 - Information Security Management",
        "GDPR - General Data Protection Regulation",
        "NIS2 - Network and Information Systems Security Directive",
        "CRA - Cyber Resilience Act",
        "DORA - Digital Operational Resilience Act"
      ]
    },
    privacy: {
      title: "Privacy & Transparency",
      items: [
        { title: "Privacy Policy", description: "Our privacy policy outlines how we collect, use, and protect personal data in compliance with GDPR and other regulations.", link: "/privacy", linkText: "Read our Privacy Policy" },
        { title: "Data Processing Agreement (DPA)", description: "We can provide a Data Processing Agreement for clients requiring formal documentation of our data handling practices.", link: "/contact", linkText: "Request a DPA" },
        { title: "Transparency Reports", description: "We are committed to transparency in our operations and security practices. For questions, please contact us.", link: "mailto:info@cybersecurity.fi", linkText: "Contact Us" }
      ]
    },
    cta: {
      title: "Questions About Security & Trust?",
      subtitle: "If you have concerns about our security practices or need detailed information about compliance certifications:",
      buttonText: "Contact Our Security Team",
      buttonHref: "mailto:info@cybersecurity.fi"
    },
    resources: {
      title: "Related Resources",
      items: [
        { title: "Scam Awareness", description: "Learn about common scams and how to protect yourself.", href: "/resources/scam-awareness" },
        { title: "DORA Compliance", description: "Understanding Digital Operational Resilience Act requirements.", href: "/resources/dora-compliance" }
      ]
    }
  },
  fi: {
    hero: {
      title: "Luottamuskeskus",
      subtitle: "Kattava tieto turvallisuuskäytännöistämme, vaatimustenmukaisuudesta ja sitoutumisestamme tietojesi suojaamiseen",
    },
    security: {
      title: "Turvallisuus & vaatimustenmukaisuus",
      items: [
        { title: "Lähestymistapamme ISO 27001:een", description: "Sovellamme ISO 27001 -tietoturvallisuuden hallinnan periaatteita omassa toiminnassamme ja autamme asiakkaita toteuttamaan ISO 27001:n itse. Cyber Security Finlandilla ei ole organisaationa ISO 27001 -sertifiointia." },
        { title: "GDPR", description: "EU:ssa henkilötietoja käsittelevänä yrityksenä olemme GDPR:n alaisia ja ylläpidämme tietosuojakäytäntöjä sen mukaisesti." }
      ]
    },
    dataProtection: {
      title: "Tietosuojakäytännöt",
      items: [
        { title: "Tietojen minimointi", description: "Pyrimme keräämään vain palvelujemme tarjoamiseen tarvittavat tiedot." },
        { title: "Salattu tiedonsiirto", description: "Verkkosivustomme ja asiakasjärjestelmämme käyttävät TLS/SSL-salausta tiedonsiirrossa." },
        { title: "Käyttöoikeuksien hallinta", description: "Pääsy asiakastietoihin on rajattu valtuutetulle henkilöstölle." },
        { title: "Poikkeamien käsittely", description: "Meillä on prosessi tietoturvapoikkeamien käsittelyyn ja raportointiin. Ota yhteyttä saadaksesi toimeksiantoosi liittyvät yksityiskohdat." }
      ]
    },
    certifications: {
      title: "Standardit, joiden parissa työskentelemme",
      items: [
        "ISO 27001 - Tietoturvallisuuden hallinta",
        "GDPR - Yleinen tietosuoja-asetus",
        "NIS2 - Verkko- ja tietoturvadirektiivi",
        "CRA - Kyberkestävyyssäädös",
        "DORA - Digitaalisen toimintakyvyn säädös"
      ]
    },
    privacy: {
      title: "Tietosuoja & läpinäkyvyys",
      items: [
        { title: "Tietosuojakäytäntö", description: "Tietosuojakäytäntömme kuvaa, miten keräämme, käytämme ja suojaamme henkilötietoja GDPR:n ja muiden säännösten mukaisesti.", link: "/privacy", linkText: "Lue tietosuojakäytäntömme" },
        { title: "Tietojenkäsittelysopimus (DPA)", description: "Voimme tarjota tietojenkäsittelysopimuksen asiakkaille, jotka tarvitsevat muodollista dokumentaatiota tietojenkäsittelykäytännöistämme.", link: "/contact", linkText: "Pyydä DPA" },
        { title: "Läpinäkyvyysraportit", description: "Olemme sitoutuneet läpinäkyvyyteen toiminnassamme ja turvallisuuskäytännöissämme. Kysyttävää? Ota yhteyttä.", link: "mailto:info@cybersecurity.fi", linkText: "Ota yhteyttä" }
      ]
    },
    cta: {
      title: "Kysyttävää turvallisuudesta ja luottamuksesta?",
      subtitle: "Jos sinulla on huolenaiheita turvallisuuskäytännöistämme tai tarvitset yksityiskohtaisia tietoja vaatimustenmukaisuussertifikaateista:",
      buttonText: "Ota yhteyttä turvallisuustiimiimme",
      buttonHref: "mailto:info@cybersecurity.fi"
    },
    resources: {
      title: "Aiheeseen liittyvät resurssit",
      items: [
        { title: "Petostietoisuus", description: "Opi yleisistä huijauksista ja kuinka suojautua niiltä.", href: "/resources/scam-awareness" },
        { title: "DORA-vaatimustenmukaisuus", description: "Digitaalisen toimintakyvyn säädös (DORA) -vaatimusten ymmärtäminen.", href: "/resources/dora-compliance" }
      ]
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered with icon, matching home page -->
<section class="bg-blue-50 text-slate-900 py-10 md:py-14">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="shieldCheck" class="w-8 h-8 text-[#131c2e]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#131c2e]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
      {currentContent.hero.subtitle}
    </p>
    
  </div>
</section>

<!-- Security & Compliance Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
        {currentContent.security.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.security.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-[#131c2e] group-hover:shadow-lg">
              <Icon name="shieldCheck" class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Data Protection Practices -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
        {currentContent.dataProtection.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentContent.dataProtection.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-lg
                    transition-all duration-300
                    p-5 group">
          
          <h3 class="text-md font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300 flex items-center gap-2">
            <span class="text-blue-500 text-lg">✓</span> {item.title}
          </h3>
          <p class="text-slate-500 text-xs leading-relaxed pl-6">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Certifications & Standards -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
        {currentContent.certifications.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {currentContent.certifications.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-md
                    transition-all duration-300
                    p-4 text-center group">
          <div class="text-blue-500 text-2xl mb-2">★</div>
          <p class="text-slate-700 text-sm group-hover:text-blue-700 transition-colors duration-300">{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Privacy & Transparency -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
        {currentContent.privacy.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {currentContent.privacy.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    p-6 text-center group">
          
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-[#131c2e] group-hover:shadow-lg">
              <Icon name="documentText" class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed mb-4">
            {item.description}
          </p>
          
          <a href={item.link} class="inline-flex items-center text-[#14171a] hover:text-[#003580] font-semibold text-sm gap-1 transition-all duration-300">
            {item.linkText}
            <svg class="w-3 h-3 transition-transform duration-300 group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#131c2e]">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.buttonHref} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          📧 {currentContent.cta.buttonText}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href="/contact" 
           class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          Contact Us
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

<!-- Related Resources -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
        {currentContent.resources.title}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {currentContent.resources.items.map((resource) => (
        <a href={resource.href} 
           class="bg-slate-50/50 rounded-xl border border-slate-100 p-5 text-center
                  hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                  transition-all duration-300 group block">
          
          <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-700 transition-colors duration-300">
            {resource.title}
          </h3>
          <p class="text-slate-500 text-sm leading-relaxed">
            {resource.description}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>

</Layout>