---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Whitepaperit ja tarkistuslistat" : "Whitepapers & Checklists",
  description: lang === 'fi'
    ? "Lataa syvällisiä whitepaperitutkimuksia ja käytännönläheisiä tarkistuslistoja kyberturvallisuuden ja sääntelyn noudattamiseksi."
    : "Download in-depth whitepapers and practical checklists for cybersecurity and compliance.",
  type: "page" as const,
};

const whitepapers = [
  {
    title: lang === 'fi' ? 'NIS2 Direktiivin vaikutus analyysi' : 'NIS2 Directive Impact Analysis',
    description: lang === 'fi' 
      ? 'Yksityiskohtainen analyysi NIS2-direktiivin vaikutuksista eri toimialoille ja miten yritykset voivat valmistautua.' 
      : 'Detailed analysis of the NIS2 directive impacts across industries and how organizations can prepare.',
    date: '2024-03-15',
    pages: 24,
    category: 'Regulatory',
    framework: 'NIS2',
    url: '/downloads/whitepapers/nis2-impact-analysis.pdf',
    tags: ['NIS2', 'Compliance', 'Risk Management']
  },
  {
    title: lang === 'fi' ? 'ISO 27001 ja GDPR -yhdistäminen' : 'Combining ISO 27001 and GDPR',
    description: lang === 'fi' 
      ? 'Parhaat käytännöt informaation turvallisuuden hallintajärjestelmän ja tietosuojan yhdistämiseksi.' 
      : 'Best practices for integrating Information Security Management Systems with data protection.',
    date: '2024-02-20',
    pages: 18,
    category: 'Compliance',
    framework: 'ISO 27001',
    url: '/downloads/whitepapers/iso27001-gdpr-combination.pdf',
    tags: ['ISO 27001', 'GDPR', 'Integration']
  },
  {
    title: lang === 'fi' ? 'DORA-sääntelyn vaikutus rahoitussektoriin' : 'DORA Regulation Impact on Financial Sector',
    description: lang === 'fi' 
      ? 'Täydellinen katsaus DORA-sääntelyn vaikutuksiin ja miten rahoituslaitokset voivat varautua.' 
      : 'Comprehensive overview of DORA regulation impacts and how financial institutions can prepare.',
    date: '2024-04-10',
    pages: 32,
    category: 'Financial Services',
    framework: 'DORA',
    url: '/downloads/whitepapers/dora-impact-financial-sector.pdf',
    tags: ['DORA', 'Financial Services', 'Operational Resilience']
  },
  {
    title: lang === 'fi' ? 'Kyberturvallisuuden riskienhallinta - Parhaat käytännöt' : 'Cybersecurity Risk Management - Best Practices',
    description: lang === 'fi' 
      ? 'Täydellinen opas kyberturvallisuuden riskienhallintaan ISO 27005 -standardin mukaisesti.' 
      : 'Comprehensive guide to cybersecurity risk management according to ISO 27005 standards.',
    date: '2024-01-30',
    pages: 28,
    category: 'Risk Management',
    framework: 'ISO 27005',
    url: '/downloads/whitepapers/cybersecurity-risk-management.pdf',
    tags: ['Risk Management', 'ISO 27005', 'Best Practices']
  }
];

const checklists = [
  {
    title: lang === 'fi' ? 'ISO 27001 -valmius tarkistuslista' : 'ISO 27001 Readiness Checklist',
    description: lang === 'fi' 
      ? 'Tarkistuslista organisaation valmiuksien arviointiin ennen ISO 27001 -todennusta.' 
      : 'Checklist for assessing organizational readiness before ISO 27001 certification.',
    date: '2024-02-15',
    items: 45,
    category: 'Compliance',
    framework: 'ISO 27001',
    url: '/downloads/checklists/iso27001-readiness-checklist.pdf',
    tags: ['ISO 27001', 'Audit', 'Preparation']
  },
  {
    title: lang === 'fi' ? 'GDPR -tietosuojarikkomusten hallinta' : 'GDPR Data Breach Management',
    description: lang === 'fi' 
      ? 'Tarkistuslista tietosuojarikkomusten hallintaan GDPR:n vaatimusten mukaisesti.' 
      : 'Checklist for managing data breaches according to GDPR requirements.',
    date: '2024-03-05',
    items: 22,
    category: 'Privacy',
    framework: 'GDPR',
    url: '/downloads/checklists/gdpr-data-breach-checklist.pdf',
    tags: ['GDPR', 'Privacy', 'Incident Response']
  },
  {
    title: lang === 'fi' ? 'NIS2 -vaatimustarkistus' : 'NIS2 Requirements Checklist',
    description: lang === 'fi' 
      ? 'Täydellinen tarkistuslista NIS2-direktiivin vaatimusten noudattamiseksi.' 
      : 'Complete checklist for meeting NIS2 directive requirements.',
    date: '2024-04-01',
    items: 68,
    category: 'Regulatory',
    framework: 'NIS2',
    url: '/downloads/checklists/nis2-requirements-checklist.pdf',
    tags: ['NIS2', 'Compliance', 'Assessment']
  }
];
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {lang === 'fi' ? 'Whitepaperit ja tarkistuslistat' : 'Whitepapers & Checklists'}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {lang === 'fi' 
            ? 'Lataa syvällisiä whitepaperitutkimuksia ja käytännönläheisiä tarkistuslistoja kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
            : 'Download in-depth whitepapers and practical checklists for cybersecurity and compliance.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Whitepapers Section -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {lang === 'fi' ? 'Whitepaperit' : 'Whitepapers'}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {lang === 'fi' 
            ? 'Syvällisiä tutkimuksia ja analyyseja ajankohtaisista kyberturvallisuuden ja sääntelyn teemoista.' 
            : 'In-depth research and analysis on current cybersecurity and compliance topics.'}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        {whitepapers.map((paper) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start justify-between mb-3 relative z-10">
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-[#003580]/10 text-[#003580]">
                  {paper.category}
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-blue-100 text-blue-800">
                  {paper.framework}
                </span>
              </div>
              <Icon name="document-text" class="h-5 w-5 text-slate-400 group-hover:text-[#003580] transition-colors duration-300" />
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {paper.title}
            </h3>
            
            <p class="text-sm text-slate-500 leading-relaxed mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {paper.description}
            </p>
            
            <div class="flex flex-wrap gap-1.5 mb-3 relative z-10">
              {paper.tags.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded-[2px] text-xs font-medium bg-slate-100 text-slate-700 group-hover:bg-[#003580]/10 group-hover:text-[#003580] transition-colors duration-300">
                  {tag}
                </span>
              ))}
            </div>
            
            <div class="flex items-center justify-between text-xs text-slate-400 mb-4 relative z-10">
              <span>{paper.date}</span>
              <span>{paper.pages} {lang === 'fi' ? 'sivua' : 'pages'}</span>
            </div>
            
            <a 
              href={paper.url}
              class="mt-auto inline-flex items-center justify-center px-4 py-2 rounded-[2px] border-2 border-[#003580] text-[#003580] hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 relative z-10"
            >
              {lang === 'fi' ? 'Lataa whitepaper' : 'Download Whitepaper'}
              <Icon name="arrowDownTray" class="h-4 w-4" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Checklists Section -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {lang === 'fi' ? 'Tarkistuslistat' : 'Checklists'}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {lang === 'fi' 
            ? 'Käytännönläheisiä tarkistuslistoja, jotka auttavat varmistamaan noudattamisen ja hallinnoida riskejä.' 
            : 'Practical checklists to help ensure compliance and manage risks effectively.'}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {checklists.map((checklist) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start justify-between mb-3 relative z-10">
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-[#003580]/10 text-[#003580]">
                  {checklist.category}
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-blue-100 text-blue-800">
                  {checklist.framework}
                </span>
              </div>
              <Icon name="clipboard-document-list" class="h-5 w-5 text-slate-400 group-hover:text-[#003580] transition-colors duration-300" />
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {checklist.title}
            </h3>
            
            <p class="text-sm text-slate-500 leading-relaxed mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {checklist.description}
            </p>
            
            <div class="flex flex-wrap gap-1.5 mb-3 relative z-10">
              {checklist.tags.map((tag) => (
                <span class="inline-flex items-center px-2 py-0.5 rounded-[2px] text-xs font-medium bg-slate-100 text-slate-700 group-hover:bg-[#003580]/10 group-hover:text-[#003580] transition-colors duration-300">
                  {tag}
                </span>
              ))}
            </div>
            
            <div class="flex items-center justify-between text-xs text-slate-400 mb-4 relative z-10">
              <span>{checklist.date}</span>
              <span>{checklist.items} {lang === 'fi' ? 'kohtaa' : 'items'}</span>
            </div>
            
            <a 
              href={checklist.url}
              class="mt-auto inline-flex items-center justify-center px-4 py-2 rounded-[2px] border-2 border-[#003580] text-[#003580] hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 relative z-10"
            >
              {lang === 'fi' ? 'Lataa tarkistuslista' : 'Download Checklist'}
              <Icon name="arrowDownTray" class="h-4 w-4" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl border-2 border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 p-8 md:p-12 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580]"></div>
        
        <div class="flex items-center justify-center gap-4 mb-4">
          <div class="h-px w-10 bg-transparent"></div>
          <span class="text-[#131c2e] text-xl font-bold">✦</span>
          <div class="h-px w-10 bg-transparent"></div>
        </div>
        
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3 text-[#131c2e]">
          {lang === 'fi' ? 'Tarvitsetko apua dokumenttien soveltamisessa?' : 'Need help applying these documents?'}
        </h2>
        <p class="text-sm md:text-base text-[#131c2e] mb-6 max-w-2xl mx-auto leading-relaxed">
          {lang === 'fi' 
            ? 'Asiantuntijatietoomme auttaa sinua hyödyntämään näitä resursseja tehokkaasti organisaatiossasi.' 
            : 'Our expertise can help you leverage these resources effectively in your organization.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] bg-[#003580] text-white hover:bg-[#2E6FBA] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2 group"
          >
            {lang === 'fi' ? 'Ota yhteyttä asiantuntijoihimme' : 'Contact Our Experts'}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>