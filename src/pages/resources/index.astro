---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Resource Library | Cybersecurity Guides, Templates & Checklists",
  description: "Download guides, templates, and checklists for cybersecurity and compliance. ISO 27001, NIS2, GDPR, DORA resources available.",
  keywords: "cybersecurity resources, compliance guides, templates, checklists, ISO 27001, NIS2, GDPR, DORA",
  type: "library" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const resources = [
  {
    title: lang === 'fi' ? 'ISO 27001 Pika-aloitusopas' : 'ISO 27001 Quick Start Guide',
    description: lang === 'fi' 
      ? '25-sivuinen toteutusroadmap organisaatiollesi' 
      : '25-page implementation roadmap for your organization',
    category: 'Guide',
    framework: 'ISO 27001',
    type: 'download',
    url: '/resources/guides/iso-27001-quick-start',
    date: '2024-01-15',
    readTime: '5 min'
  },
  {
    title: lang === 'fi' ? 'NIS2 Vaatimustarkistuslista' : 'NIS2 Compliance Checklist',
    description: lang === 'fi' 
      ? 'Täydellinen vaatimusanalyysityökalu' 
      : 'Complete requirement assessment tool',
    category: 'Checklist',
    framework: 'NIS2',
    type: 'download',
    url: '/resources/guides/nis2-compliance-checklist',
    date: '2024-02-20',
    readTime: '3 min'
  },
  {
    title: lang === 'fi' ? 'GDPR Tietosuojavaikutusten Arviointi -Malli' : 'GDPR Privacy Impact Assessment Template',
    description: lang === 'fi' 
      ? 'Valmiiksi määritelty PIA-kehys' 
      : 'Ready-to-use PIA framework',
    category: 'Template',
    framework: 'GDPR',
    type: 'download',
    url: '/resources/guides/gdpr-pia-template',
    date: '2024-01-30',
    readTime: '8 min'
  },
  {
    title: lang === 'fi' ? 'DORA Vaatimustenmukaisuus -Tarkistuslista' : 'DORA Compliance Checklist',
    description: lang === 'fi' 
      ? 'Digitaalisen toiminnan resilierenssin arviointi' 
      : 'Digital operational resilience assessment',
    category: 'Checklist',
    framework: 'DORA',
    type: 'download',
    url: '/resources/guides/dora-compliance-checklist',
    date: '2024-03-10',
    readTime: '4 min'
  },
];

const categories = [
  { id: 'all', label: lang === 'fi' ? 'Kaikki' : 'All', count: 4 },
  { id: 'guide', label: lang === 'fi' ? 'Oppaat' : 'Guides', count: 1 },
  { id: 'template', label: lang === 'fi' ? 'Mallit' : 'Templates', count: 1 },
  { id: 'checklist', label: lang === 'fi' ? 'Tarkistuslistat' : 'Checklists', count: 2 }
];

const frameworks = [
  { id: 'all', label: lang === 'fi' ? 'Kaikki' : 'All', count: 4 },
  { id: 'iso-27001', label: 'ISO 27001', count: 1 },
  { id: 'nis2', label: 'NIS2', count: 1 },
  { id: 'gdpr', label: 'GDPR', count: 1 },
  { id: 'dora', label: 'DORA', count: 1 }
];

const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {isFi ? 'Resurssikirjasto' : 'Resource Library'}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {isFi 
            ? 'Lataa oppaita, malleja ja tarkistuslistoja kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
            : 'Download guides, templates, and checklists for cybersecurity and compliance.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Filters Section -->
  <section class="py-6 bg-white border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row gap-6">
        
        <!-- Category Filter -->
        <div class="flex-1">
          <h3 class="text-xs font-semibold text-[#14171a] mb-2">
            {isFi ? 'Kategoria' : 'Category'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {categories.map(cat => (
              <button
                class={`px-3 py-1.5 text-xs rounded-[2px] transition-all duration-200 ${
                  cat.id === 'all' 
                    ? 'bg-[#131c2e] text-white' 
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {cat.label} ({cat.count})
              </button>
            ))}
          </div>
        </div>

        <!-- Framework Filter -->
        <div class="flex-1">
          <h3 class="text-xs font-semibold text-[#14171a] mb-2">
            {isFi ? 'Standardi' : 'Framework'}
          </h3>
          <div class="flex flex-wrap gap-2">
            {frameworks.map(framework => (
              <button
                class={`px-3 py-1.5 text-xs rounded-[2px] transition-all duration-200 ${
                  framework.id === 'all' 
                    ? 'bg-[#131c2e] text-white' 
                    : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
                }`}
              >
                {framework.label} ({framework.count})
              </button>
            ))}
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- Resources Grid -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {resources.map((resource) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-between items-start mb-3 relative z-10">
              <div class="flex flex-wrap gap-1.5">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-[#003580]/10 text-[#003580]">
                  {resource.category}
                </span>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-blue-100 text-blue-800">
                  {resource.framework}
                </span>
              </div>
              <div class="flex-shrink-0">
                <div class="w-8 h-8 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={resource.type === 'download' ? 'arrowDownTray' : 'eye'} class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {resource.title}
            </h3>
            
            <p class="text-sm text-slate-500 leading-relaxed mb-3 flex-1 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {resource.description}
            </p>
            
            <div class="flex items-center justify-between text-xs text-slate-500 mb-4 relative z-10">
              <span>{resource.date}</span>
              <span>{resource.readTime}</span>
            </div>
            
            <a 
              href={resource.url}
              class="mt-auto inline-flex items-center justify-center px-4 py-2 rounded-[2px] border-2 border-[#003580] text-[#003580] hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 relative z-10"
            >
              {resource.type === 'download' 
                ? (isFi ? 'Lataa nyt' : 'Download Now') 
                : (isFi ? 'Lue lisää' : 'Read More')}
              <Icon name={resource.type === 'download' ? 'arrowDownTray' : 'arrowRight'} class="h-4 w-4" />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-2xl border-2 border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 p-8 md:p-12 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580]"></div>
        
        <div class="flex items-center justify-center gap-4 mb-4">
          <div class="h-px w-10 bg-transparent"></div>
          <span class="text-[#131c2e] text-xl font-bold">✦</span>
          <div class="h-px w-10 bg-transparent"></div>
        </div>
        
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3 text-[#131c2e]">
          {isFi ? 'Tarvitsetko apua resurssien käytössä?' : 'Need help using these resources?'}
        </h2>

        <p class="text-sm md:text-base text-[#131c2e] mb-6 max-w-2xl mx-auto leading-relaxed">
          {isFi 
            ? 'Asiantuntijamme voivat auttaa sinua hyödyntämään näitä resursseja tehokkaasti organisaatiossasi.' 
            : 'Our experts can help you leverage these resources effectively in your organization.'}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/contact" 
             class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] bg-[#003580] text-white hover:bg-[#2E6FBA] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2 group">
            {isFi ? 'Ota yhteyttä' : 'Contact Us'}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/services" 
             class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-2 group">
            {isFi ? 'Tutustu palveluihimme' : 'View Our Services'}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>