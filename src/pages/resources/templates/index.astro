---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const templates = [
  {
    title: lang === 'fi' ? 'GDPR Tietosuojavaikutusten Arviointi -Malli' : 'GDPR Privacy Impact Assessment Template',
    description: lang === 'fi' 
      ? 'Valmiiksi määritelty PIA-kehys' 
      : 'Ready-to-use PIA framework',
    framework: 'GDPR',
    date: '2024-01-30',
    readTime: '8 min',
    url: '/resources/templates/gdpr-pia-template',
    category: 'Assessment'
  },
  {
    title: lang === 'fi' ? 'Tietosuojarikkomusten Ilmoittamisen Malli' : 'Data Breach Notification Template',
    description: lang === 'fi' 
      ? 'GDPR-yhteensopiva ilmoituspohja viranomaisille' 
      : 'GDPR-compliant notification template for authorities',
    framework: 'GDPR',
    date: '2024-01-25',
    readTime: '6 min',
    url: '/resources/templates/data-breach-notification',
    category: 'Compliance'
  },
  {
    title: lang === 'fi' ? 'Riskienhallintasuunnitelman Malli' : 'Risk Management Plan Template',
    description: lang === 'fi' 
      ? 'ISO 27005 -standardin mukainen suunnitelmamalli' 
      : 'ISO 27005-compliant risk management plan',
    framework: 'ISO 27001',
    date: '2024-02-10',
    readTime: '10 min',
    url: '/resources/templates/risk-management-plan',
    category: 'Planning'
  },
  {
    title: lang === 'fi' ? 'Toimittajariskien Hallintamalli' : 'Vendor Risk Assessment Template',
    description: lang === 'fi' 
      ? 'Toimittajien kyberturvallisuuden arviointipohja' 
      : 'Vendor cybersecurity assessment framework',
    framework: 'Risk Management',
    date: '2024-02-15',
    readTime: '7 min',
    url: '/resources/templates/vendor-risk-assessment',
    category: 'Assessment'
  }
];
---

<Layout 
  title={lang === 'fi' ? 'Mallit ja pohjat' : 'Templates & Frameworks'} 
  description={lang === 'fi' 
    ? 'Lataa valmiita malleja ja pohjia kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
    : 'Download ready-made templates and frameworks for cybersecurity and compliance.'}
>
  <!-- Hero Section -->
  <section class="bg-slate-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          {lang === 'fi' ? 'Mallit ja pohjat' : 'Templates & Frameworks'}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {lang === 'fi' 
            ? 'Lataa valmiita malleja ja pohjia kyberturvallisuuden ja sääntelyn noudattamiseksi.' 
            : 'Download ready-made templates and frameworks for cybersecurity and compliance.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Templates Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {templates.map(template => (
          <div class="bg-white rounded-xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="p-6">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-sky-100 text-sky-800">
                    {template.category}
                  </span>
                  <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium bg-cyan-100 text-cyan-800">
                    {template.framework}
                  </span>
                </div>
                <Icon name="documentDuplicate" class="h-5 w-5 text-slate-500" />
              </div>
              
              <h3 class="text-lg font-semibold text-slate-900 mb-2">
                {template.title}
              </h3>
              <p class="text-slate-600 text-sm mb-4">
                {template.description}
              </p>
              
              <div class="flex items-center justify-between text-xs text-slate-500 mb-4">
                <span>{template.date}</span>
                <span>{template.readTime}</span>
              </div>
              
              <a 
                href={template.url}
                class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-sky-600 hover:bg-sky-700"
              >
                {lang === 'fi' ? 'Lataa malli' : 'Download Template'}
                <Icon name="arrowDownTray" class="ml-2 -mr-1 h-4 w-4" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>