---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const gdprSections = [
  {
    title: lang === 'fi' ? 'Perusasiat' : 'Basics',
    content: lang === 'fi' 
      ? 'GDPR (General Data Protection Regulation) on EU:n tietosuojalainsäädäntö, joka astui voimaan 25.5.2018. Se korvasi vuodelta 1995 peräisin olleen tietosuojadirektiivin ja on suoraan sovellettavissa kaikissa EU:n jäsenvaltioissa.' 
      : 'GDPR (General Data Protection Regulation) is EU data protection legislation that came into effect on May 25, 2018. It replaced the 1995 data protection directive and is directly applicable in all EU member states.',
    icon: 'information-circle'
  },
  {
    title: lang === 'fi' ? 'Keskeiset periaatteet' : 'Key Principles',
    content: lang === 'fi' 
      ? 'Lupaa edellyttävä ja yksiselitteinen suostumus, tietojen käsittelyn lainmukaisuus, tietojen minimointi, tarkoitus sidottu käyttö, rajallinen säilytysaika, tietojen tarkkuus, läpinäkyvyys, tietoturva ja tilivelvollisuus.' 
      : 'Lawful and unambiguous consent, lawfulness of processing, data minimization, purpose limitation, storage limitation, accuracy, transparency, security, and accountability.',
    icon: 'light-bulb'
  },
  {
    title: lang === 'fi' ? 'Oikeudet' : 'Rights',
    content: lang === 'fi' 
      ? 'Yksilöillä on oikeus tietää, mitä tietoja heistä kerätään, tietojen korjaamiseen, poistamiseen ("oikeus unohdettavuuteen"), rajoittamiseen, siirrettävyyteen ja suostumuksen peruuttamiseen.' 
      : 'Individuals have the right to know what data is collected about them, to rectification, erasure ("right to be forgotten"), restriction, portability, and withdrawal of consent.',
    icon: 'user-circle'
  },
  {
    title: lang === 'fi' ? 'Rangaistukset' : 'Penalties',
    content: lang === 'fi' 
      ? 'Rikkomuksista voi seurata merkittäviä sakkoja, jopa 4 % edellisen tilikauden maailmanlaajuisesta liikevaihdosta tai 20 miljoonaa euroa, riippuen kummasta on suurempi.' 
      : 'Violations can result in significant penalties, up to 4% of annual global turnover or €20 million, whichever is greater.',
    icon: 'exclamation-triangle'
  }
];

const gdprSteps = [
  {
    step: 1,
    title: lang === 'fi' ? 'Arvioi nykytilanne' : 'Assess Current State',
    description: lang === 'fi' 
      ? 'Tee kartoitus kaikista tietojen käsittelytoiminnoista ja määrittele henkilötiedot, jotka keräämme, käsittelemme ja tallennamme.' 
      : 'Take inventory of all data processing activities and identify personal data we collect, process, and store.'
  },
  {
    step: 2,
    title: lang === 'fi' ? 'Tee vaikutustenarviointi' : 'Perform Impact Assessment',
    description: lang === 'fi' 
      ? 'Arvioi tietosuojan vaikutukset ja tee tarvittaessa tietosuojavaikutusten arviointi (DPIA).' 
      : 'Assess privacy impacts and conduct Data Protection Impact Assessments (DPIA) where required.'
  },
  {
    step: 3,
    title: lang === 'fi' ? 'Päivitä käytännöt' : 'Update Practices',
    description: lang === 'fi' 
      ? 'Päivitä tietosuojakäytännöt, suostumusmekanismit ja prosessointisopimukset GDPR:n vaatimusten mukaisesti.' 
      : 'Update privacy policies, consent mechanisms, and processing agreements to comply with GDPR requirements.'
  },
  {
    step: 4,
    title: lang === 'fi' ? 'Kouluta henkilökuntaa' : 'Train Staff',
    description: lang === 'fi' 
      ? 'Varmista, että kaikki työntekijät ymmärtävät GDPR:n vaatimukset ja tietosuojan periaatteet.' 
      : 'Ensure all staff understand GDPR requirements and privacy principles.'
  },
  {
    step: 5,
    title: lang === 'fi' ? 'Valvo ja ylläpidä' : 'Monitor & Maintain',
    description: lang === 'fi' 
      ? 'Toteuta jatkuvaa valvontaa ja ylläpitoa varmistaaksesi jatkuvan noudattamisen.' 
      : 'Implement ongoing monitoring and maintenance to ensure continued compliance.'
  }
];
---

<Layout 
  title={lang === 'fi' ? 'Ymmärrä GDPR: Yksityiskohtainen opas' : 'Understanding GDPR: A Comprehensive Guide'} 
  description={lang === 'fi' 
    ? 'Kattava opas EU:n yleiseen tietosuoja-asetukseen ja sen vaatimuksiin.' 
    : 'Comprehensive guide to the EU General Data Protection Regulation and its requirements.'}
>
  <!-- Hero Section -->
  <section class="bg-blue-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-flex items-center px-3 py-1 rounded-[2px] text-sm font-medium bg-blue-100 text-blue-800 mb-4">
          <Icon name="shield-check" class="w-4 h-4 mr-1" />
          GDPR
        </span>
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          {lang === 'fi' ? 'Ymmärrä GDPR: Yksityiskohtainen opas' : 'Understanding GDPR: A Comprehensive Guide'}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {lang === 'fi' 
            ? 'Kattava opas EU:n yleiseen tietosuoja-asetukseen ja sen vaatimuksiin.' 
            : 'Comprehensive guide to the EU General Data Protection Regulation and its requirements.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Key Sections -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {gdprSections.map((section, index) => (
          <div class={`${index % 2 === 0 ? 'bg-blue-50' : 'bg-cyan-50'} rounded-xl border border-slate-200 p-6`}>
            <div class="flex items-start">
              <div class="flex-shrink-0 mt-1">
                <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center">
                  <Icon name={section.icon} class="w-5 h-5 text-blue-600" />
                </div>
              </div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-slate-900 mb-2">{section.title}</h3>
                <p class="text-slate-600">{section.content}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'GDPR:n toteutusvaiheet' : 'GDPR Implementation Steps'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          {lang === 'fi' 
            ? 'Seuraa näitä vaiheita varmistaaksesi GDPR:n noudattamisen organisaatiossasi.' 
            : 'Follow these steps to ensure GDPR compliance in your organization.'}
        </p>
      </div>
      
      <div class="space-y-8">
        {gdprSteps.map(step => (
          <div class="flex">
            <div class="flex-shrink-0">
              <div class="flex items-center justify-center w-10 h-10 rounded-full bg-blue-500 text-white font-bold">
                {step.step}
              </div>
            </div>
            <div class="ml-4 flex-1">
              <h3 class="text-lg font-semibold text-slate-900">{step.title}</h3>
              <p class="text-slate-600 mt-2">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-blue-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        {lang === 'fi' ? 'Tarvitsetko apua GDPR:n toteutuksessa?' : 'Need help with GDPR implementation?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {lang === 'fi' 
          ? 'Asiantuntijatietoomme auttaa sinua rakentamaan GDPR-yhteensopivan tietosuojan hallintokehyksen.' 
          : 'Our expertise can help you build a GDPR-compliant privacy management framework.'}
      </p>
      <a 
        href="/services/virtual-dpo" 
        class="inline-block bg-white text-cyan-600 font-medium py-3 px-6 rounded-lg hover:bg-slate-100 transition-colors"
      >
        {lang === 'fi' ? 'Tutustu V-DPO-palveluumme' : 'Explore Our V-DPO Service'}
      </a>
    </div>
  </section>
</Layout>