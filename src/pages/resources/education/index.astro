---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const educationalTopics = [
  {
    title: lang === 'fi' ? 'Ymmärrä GDPR' : 'Understanding GDPR',
    description: lang === 'fi' 
      ? 'Kattava opas EU:n yleiseen tietosuoja-asetukseen ja sen vaatimuksiin' 
      : 'Comprehensive guide to the EU General Data Protection Regulation and its requirements',
    icon: 'shield-check',
    url: '/resources/education/gdpr-explained',
    level: 'Beginner',
    duration: '15 min'
  },
  {
    title: lang === 'fi' ? 'NIS2 Direktiivi Selitettynä' : 'NIS2 Directive Explained',
    description: lang === 'fi' 
      ? 'Yksityiskohtainen katsaus NIS2-direktiivin vaatimuksiin ja vaikutuksiin' 
      : 'Detailed overview of NIS2 directive requirements and implications',
    icon: 'globe-alt',
    url: '/resources/education/nis2-explained',
    level: 'Intermediate',
    duration: '20 min'
  },
  {
    title: lang === 'fi' ? 'ISO 27001 Perusteet' : 'ISO 27001 Fundamentals',
    description: lang === 'fi' 
      ? 'Opas informaation turvallisuuden hallintajärjestelmän periaatteisiin' 
      : 'Guide to the fundamentals of Information Security Management Systems',
    icon: 'lock-closed',
    url: '/resources/education/iso-27001-fundamentals',
    level: 'Beginner',
    duration: '12 min'
  },
  {
    title: lang === 'fi' ? 'DORA Sääntely selitetty' : 'DORA Regulation Explained',
    description: lang === 'fi' 
      ? 'Ymmärrä digitaalisen toiminnan resilierenssin sääntely vaatimukset' 
      : 'Understanding the Digital Operational Resilience Act requirements',
    icon: 'building-library',
    url: '/resources/education/dora-explained',
    level: 'Advanced',
    duration: '25 min'
  },
  {
    title: lang === 'fi' ? 'Riskienhallinnan Perusteet' : 'Risk Management Basics',
    description: lang === 'fi' 
      ? 'Perusasiat kyberturvallisuuden riskienhallinnasta' 
      : 'Basics of cybersecurity risk management',
    icon: 'chart-bar',
    url: '/resources/education/risk-management-basics',
    level: 'Beginner',
    duration: '10 min'
  },
  {
    title: lang === 'fi' ? 'Tietosuojan Johtamisjärjestelmä' : 'Privacy Management System',
    description: lang === 'fi' 
      ? 'ISO/IEC 27701 -standardin yhdistäminen ISMS:iin' 
      : 'Integrating ISO/IEC 27701 standard with ISMS',
    icon: 'user-group',
    url: '/resources/education/pims-integration',
    level: 'Advanced',
    duration: '30 min'
  }
];
---

<Layout 
  title={lang === 'fi' ? 'Koulutussisällöt' : 'Educational Content'} 
  description={lang === 'fi' 
    ? 'Opettele kyberturvallisuuden ja sääntelyn perusteet yksinkertaisesti selitettynä.' 
    : 'Learn cybersecurity and compliance fundamentals explained in simple terms.'}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-50 via-white to-blue-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          {lang === 'fi' ? 'Koulutussisällöt' : 'Educational Content'}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {lang === 'fi' 
            ? 'Opettele kyberturvallisuuden ja sääntelyn perusteet yksinkertaisesti selitettynä.' 
            : 'Learn cybersecurity and compliance fundamentals explained in simple terms.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Educational Topics Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {educationalTopics.map(topic => (
          <div class="bg-gradient-to-br from-white to-slate-50 rounded-xl border border-slate-200 overflow-hidden hover:shadow-lg transition-shadow duration-300">
            <div class="p-6">
              <div class="flex justify-between items-start mb-4">
                <div class="p-3 bg-teal-100 rounded-lg">
                  <Icon name={topic.icon} class="h-6 w-6 text-teal-600" />
                </div>
                <span class={`px-2 py-1 text-xs font-medium rounded-full ${
                  topic.level === 'Beginner' ? 'bg-green-100 text-green-800' :
                  topic.level === 'Intermediate' ? 'bg-yellow-100 text-yellow-800' :
                  'bg-red-100 text-red-800'
                }`}>
                  {topic.level}
                </span>
              </div>
              
              <h3 class="text-lg font-semibold text-slate-900 mb-2">
                {topic.title}
              </h3>
              <p class="text-slate-600 text-sm mb-4">
                {topic.description}
              </p>
              
              <div class="flex items-center justify-between text-xs text-slate-500 mb-4">
                <span>{topic.duration}</span>
              </div>
              
              <a 
                href={topic.url}
                class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-gradient-to-r from-teal-600 to-cyan-600 hover:from-teal-700 hover:to-cyan-700"
              >
                {lang === 'fi' ? 'Lue lisää' : 'Read More'}
                <Icon name="arrowRight" class="ml-2 -mr-1 h-4 w-4" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Explanation Section -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">
          {lang === 'fi' ? 'Miksi koulutus on tärkeää?' : 'Why Education Matters?'}
        </h2>
        <p class="text-xl text-slate-600 max-w-3xl mx-auto">
          {lang === 'fi' 
            ? 'Ymmärtämällä sääntelyvaatimukset ja parhaat käytännöt voit rakentaa vahvemman kyberturvallisuuden perustan organisaatiollesi.' 
            : 'Understanding regulatory requirements and best practices enables you to build a stronger cybersecurity foundation for your organization.'}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-xl border border-slate-200">
          <div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name="lightBulb" class="h-6 w-6 text-teal-600" />
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Rakenna tietoutta' : 'Build Knowledge'}
          </h3>
          <p class="text-slate-600">
            {lang === 'fi' 
              ? 'Syvä ymmärrys sääntelyvaatimuksista auttaa organisaatiotasi noudattamaan lakeja tehokkaasti.' 
              : 'Deep understanding of regulatory requirements helps your organization comply effectively.'}
          </p>
        </div>
        
        <div class="bg-white p-6 rounded-xl border border-slate-200">
          <div class="w-12 h-12 bg-cyan-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name="shield-check" class="h-6 w-6 text-cyan-600" />
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Vähennä riskejä' : 'Reduce Risks'}
          </h3>
          <p class="text-slate-600">
            {lang === 'fi' 
              ? 'Koulutus auttaa tunnistamaan ja lieventämään kyberturvallisuusriskit ennen kuin ne aiheuttavat vahinkoa.' 
              : 'Education helps identify and mitigate cybersecurity risks before they cause harm.'}
          </p>
        </div>
        
        <div class="bg-white p-6 rounded-xl border border-slate-200">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name="academic-cap" class="h-6 w-6 text-blue-600" />
          </div>
          <h3 class="text-xl font-semibold text-slate-900 mb-2">
            {lang === 'fi' ? 'Edistä kulttuuria' : 'Foster Culture'}
          </h3>
          <p class="text-slate-600">
            {lang === 'fi' 
              ? 'Koulutus luo turvallisuuskulttuuria, jossa kaikki ymmärtävät roolinsa kyberturvallisuudessa.' 
              : 'Education creates a security culture where everyone understands their role in cybersecurity.'}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>