---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    title: "All Resources",
    description: "The comprehensive resources list has moved. View updated resources on the main resources page.",
    buttonText: "Go to Resources",
    buttonHref: "/resources"
  },
  fi: {
    title: "Kaikki resurssit",
    description: "Resurssisivu on siirretty. Päivitetty luettelo löytyy pääresurssisivulta.",
    buttonText: "Siirry resurssisivulle",
    buttonHref: "/fi/resources"
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={currentContent.title} description={currentContent.description}>
  <!-- Hero Section - Centered, NO image -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-28 md:py-36">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="flex justify-center mb-6">
        <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
          <svg class="w-8 h-8 text-[#0F172A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
      
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 text-[#0F172A]">
        {currentContent.title}
      </h1>
      
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
        {currentContent.description}
      </p>
      
      <a 
        href={currentContent.buttonHref} 
        class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#0F172A] to-[#0EA5E9] text-white hover:from-[#0EA5E9] hover:to-[#0F172A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base gap-2"
      >
        {currentContent.buttonText}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
      
    </div>
  </section>
</Layout>