---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const industryResources = {
  finance: [
    {
      title: lang === 'fi' ? 'DORA-sääntelyn noudattaminen rahoitussektorilla' : 'DORA Compliance in Financial Services',
      description: lang === 'fi' ? 'Käytännönläheinen opas digitaalisen toiminnan resilierenssin sääntelyn noudattamiseen' : 'Practical guide to digital operational resilience act compliance',
      type: 'Guide',
      url: '/resources/industry/finance/dora-compliance',
      date: '2024-03-15'
    },
    {
      title: lang === 'fi' ? 'PCI DSS -tietoturvaohje rahoituslaitoksille' : 'PCI DSS Security Guide for Financial Institutions',
      description: lang === 'fi' ? 'Krediittikorttitietojen käsittelyn turvallisuus PCI DSS -standardin mukaisesti' : 'Securing credit card data handling according to PCI DSS standards',
      type: 'Guide',
      url: '/resources/industry/finance/pci-dss-guide',
      date: '2024-02-20'
    },
    {
      title: lang === 'fi' ? 'Rahoitussektorin riskienhallintamalli' : 'Financial Sector Risk Management Template',
      description: lang === 'fi' ? 'Valmis malli rahoitussektorin erityispiirteisiin soveltuvaan riskienhallintaan' : 'Ready-made template for financial sector-specific risk management',
      type: 'Template',
      url: '/resources/industry/finance/risk-template',
      date: '2024-01-30'
    }
  ],
  healthcare: [
    {
      title: lang === 'fi' ? 'Terveyssektorin GDPR-vaatimukset' : 'Healthcare GDPR Requirements',
      description: lang === 'fi' ? 'Potilastietojen käsittely GDPR:n mukaisesti terveydenhuollossa' : 'Handling patient data according to GDPR in healthcare',
      type: 'Guide',
      url: '/resources/industry/healthcare/gdpr-requirements',
      date: '2024-03-05'
    },
    {
      title: lang === 'fi' ? 'Lääketieteellisten laitteiden kyberturvallisuus' : 'Medical Device Cybersecurity',
      description: lang === 'fi' ? 'Lääketieteellisten laitteiden kyberturvallisuuden hallinta ISO/IEC 81001-5-1 -standardin mukaisesti' : 'Managing medical device cybersecurity according to ISO/IEC 81001-5-1 standard',
      type: 'Guide',
      url: '/resources/industry/healthcare/medical-device-security',
      date: '2024-02-15'
    }
  ],
  technology: [
    {
      title: lang === 'fi' ? 'SaaS-palveluiden SOC 2 -valmius' : 'SaaS SOC 2 Readiness',
      description: lang === 'fi' ? 'SOC 2 Type I & II -valmiuden saavuttaminen pilvipalveluiden tarjoajille' : 'Achieving SOC 2 Type I & II readiness for cloud service providers',
      type: 'Guide',
      url: '/resources/industry/technology/saas-soc2-readiness',
      date: '2024-03-10'
    },
    {
      title: lang === 'fi' ? 'Kolmannen osapuolen hallintamalli teknologiayrityksille' : 'Third-Party Management Template for Tech Companies',
      description: lang === 'fi' ? 'Toimittajariskien hallinta teknologiapalveluiden ostajille' : 'Managing vendor risks for technology service buyers',
      type: 'Template',
      url: '/resources/industry/technology/vendor-risk-template',
      date: '2024-02-25'
    }
  ]
};

const industries = [
  { id: 'finance', name: lang === 'fi' ? 'Rahoituspalvelut' : 'Financial Services', icon: 'bank-notes', color: 'from-blue-500 to-cyan-500' },
  { id: 'healthcare', name: lang === 'fi' ? 'Terveysala' : 'Healthcare', icon: 'heart', color: 'from-green-500 to-emerald-500' },
  { id: 'technology', name: lang === 'fi' ? 'Teknologia' : 'Technology', icon: 'computer-desktop', color: 'from-purple-500 to-indigo-500' },
  { id: 'manufacturing', name: lang === 'fi' ? 'Teollisuus' : 'Manufacturing', icon: 'cog', color: 'from-orange-500 to-amber-500' },
  { id: 'energy', name: lang === 'fi' ? 'Energia' : 'Energy', icon: 'bolt', color: 'from-yellow-500 to-amber-500' },
  { id: 'government', name: lang === 'fi' ? 'Julkinen sektori' : 'Government', icon: 'building-office', color: 'from-slate-500 to-zinc-500' }
];
---

<Layout 
  title={lang === 'fi' ? 'Toimialakohtaiset resurssit' : 'Industry-Specific Resources'} 
  description={lang === 'fi' 
    ? 'Lataa toimialasi erityispiirteisiin soveltuvia oppaita, malleja ja tarkistuslistoja.' 
    : 'Download guides, templates, and checklists tailored to your industry specifics.'}
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-slate-50 via-white to-blue-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          {lang === 'fi' ? 'Toimialakohtaiset resurssit' : 'Industry-Specific Resources'}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {lang === 'fi' 
            ? 'Lataa toimialasi erityispiirteisiin soveltuvia oppaita, malleja ja tarkistuslistoja.' 
            : 'Download guides, templates, and checklists tailored to your industry specifics.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Industry Selection -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map(industry => (
          <a 
            href={`/resources/industry/${industry.id}`}
            class="group block bg-gradient-to-br from-white to-slate-50 rounded-xl border border-slate-200 p-6 hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-center">
              <div class={`w-12 h-12 rounded-lg bg-gradient-to-r ${industry.color} flex items-center justify-center text-white`}>
                <Icon name={industry.icon} class="w-6 h-6" />
              </div>
              <h3 class="ml-4 text-lg font-semibold text-slate-900 group-hover:text-sky-600 transition-colors">
                {industry.name}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Resources by Industry -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-16">
        <!-- Finance Section -->
        <div>
          <div class="flex items-center mb-8">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-r from-blue-500 to-cyan-500 flex items-center justify-center text-white mr-3">
              <Icon name="bank-notes" class="w-5 h-5" />
            </div>
            <h2 class="text-2xl font-bold text-slate-900">
              {lang === 'fi' ? 'Rahoituspalvelut' : 'Financial Services'}
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {industryResources.finance.map(resource => (
              <div class="bg-white rounded-lg border border-slate-200 p-5 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-3">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    {resource.type}
                  </span>
                  <span class="text-xs text-slate-500">{resource.date}</span>
                </div>
                <h3 class="font-semibold text-slate-900 mb-2">{resource.title}</h3>
                <p class="text-sm text-slate-600 mb-4">{resource.description}</p>
                <a 
                  href={resource.url}
                  class="inline-flex items-center text-sky-600 hover:text-sky-800 text-sm font-medium"
                >
                  {lang === 'fi' ? 'Lue lisää' : 'Read more'}
                  <Icon name="arrowRight" class="w-4 h-4 ml-1" />
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Healthcare Section -->
        <div>
          <div class="flex items-center mb-8">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-r from-green-500 to-emerald-500 flex items-center justify-center text-white mr-3">
              <Icon name="heart" class="w-5 h-5" />
            </div>
            <h2 class="text-2xl font-bold text-slate-900">
              {lang === 'fi' ? 'Terveysala' : 'Healthcare'}
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {industryResources.healthcare.map(resource => (
              <div class="bg-white rounded-lg border border-slate-200 p-5 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-3">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    {resource.type}
                  </span>
                  <span class="text-xs text-slate-500">{resource.date}</span>
                </div>
                <h3 class="font-semibold text-slate-900 mb-2">{resource.title}</h3>
                <p class="text-sm text-slate-600 mb-4">{resource.description}</p>
                <a 
                  href={resource.url}
                  class="inline-flex items-center text-sky-600 hover:text-sky-800 text-sm font-medium"
                >
                  {lang === 'fi' ? 'Lue lisää' : 'Read more'}
                  <Icon name="arrowRight" class="w-4 h-4 ml-1" />
                </a>
              </div>
            ))}
          </div>
        </div>

        <!-- Technology Section -->
        <div>
          <div class="flex items-center mb-8">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-r from-purple-500 to-indigo-500 flex items-center justify-center text-white mr-3">
              <Icon name="computer-desktop" class="w-5 h-5" />
            </div>
            <h2 class="text-2xl font-bold text-slate-900">
              {lang === 'fi' ? 'Teknologia' : 'Technology'}
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {industryResources.technology.map(resource => (
              <div class="bg-white rounded-lg border border-slate-200 p-5 hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-3">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    {resource.type}
                  </span>
                  <span class="text-xs text-slate-500">{resource.date}</span>
                </div>
                <h3 class="font-semibold text-slate-900 mb-2">{resource.title}</h3>
                <p class="text-sm text-slate-600 mb-4">{resource.description}</p>
                <a 
                  href={resource.url}
                  class="inline-flex items-center text-sky-600 hover:text-sky-800 text-sm font-medium"
                >
                  {lang === 'fi' ? 'Lue lisää' : 'Read more'}
                  <Icon name="arrowRight" class="w-4 h-4 ml-1" />
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-r from-blue-600 to-cyan-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        {lang === 'fi' ? 'Tarvitsetko toimialasi asiantuntemusta?' : 'Need industry-specific expertise?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {lang === 'fi' 
          ? 'Meillä on syvää asiantuntemusta eri toimialoilla ja voimme auttaa sinua ratkaisemaan toimialasi ainutlaatuiset haasteet.' 
          : 'We have deep expertise in various industries and can help you solve your industry-specific challenges.'}
      </p>
      <a 
        href="/contact" 
        class="inline-block bg-white text-cyan-600 font-medium py-3 px-6 rounded-lg hover:bg-slate-100 transition-colors"
      >
        {lang === 'fi' ? 'Ota yhteyttä asiantuntijaamme' : 'Contact Our Experts'}
      </a>
    </div>
  </section>
</Layout>