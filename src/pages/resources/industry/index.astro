---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const industries = [
  { id: 'financial-services-fintech', name: lang === 'fi' ? 'Rahoituspalvelut' : 'Financial Services', icon: 'bank-notes', color: 'bg-blue-500' },
  { id: 'healthcare-life-sciences', name: lang === 'fi' ? 'Terveysala' : 'Healthcare', icon: 'heart', color: 'bg-green-500' },
  { id: 'saas-technology', name: lang === 'fi' ? 'Teknologia' : 'Technology', icon: 'computer-desktop', color: 'bg-purple-500' },
  { id: 'manufacturing-industrial', name: lang === 'fi' ? 'Teollisuus' : 'Manufacturing', icon: 'cog', color: 'bg-orange-500' },
  { id: 'critical-infrastructure-energy', name: lang === 'fi' ? 'Energia' : 'Energy', icon: 'bolt', color: 'bg-yellow-500' },
  { id: 'public-sector-finland', name: lang === 'fi' ? 'Julkinen sektori' : 'Government', icon: 'building-office', color: 'bg-slate-500' }
];
---

<Layout 
  title={lang === 'fi' ? 'Toimialakohtaiset resurssit' : 'Industry-Specific Resources'} 
  description={lang === 'fi' 
    ? 'Lataa toimialasi erityispiirteisiin soveltuvia oppaita, malleja ja tarkistuslistoja.' 
    : 'Download guides, templates, and checklists tailored to your industry specifics.'}
>
  <!-- Hero Section -->
  <section class="bg-slate-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          {lang === 'fi' ? 'Toimialakohtaiset resurssit' : 'Industry-Specific Resources'}
        </h1>
        <p class="text-xl text-slate-600 mb-8">
          {lang === 'fi' 
            ? 'Lataa toimialasi erityispiirteisiin soveltuvia oppaita, malleja ja tarkistuslistoja.' 
            : 'Download guides, templates, and checklists tailored to your industry specifics.'}
        </p>
      </div>
    </div>
  </section>

  <!-- Industry Selection -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {industries.map(industry => (
          <a 
            href={lang === 'fi' ? `/fi/industries/${industry.id}` : `/industries/${industry.id}`}
            class="group block bg-white rounded-xl border border-slate-200 p-6 hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-center">
              <div class={`w-12 h-12 rounded-lg ${industry.color} flex items-center justify-center text-white`}>
                <Icon name={industry.icon} class="w-6 h-6" />
              </div>
              <h3 class="ml-4 text-lg font-semibold text-slate-900 group-hover:text-sky-600 transition-colors">
                {industry.name}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-blue-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">
        {lang === 'fi' ? 'Tarvitsetko toimialasi asiantuntemusta?' : 'Need industry-specific expertise?'}
      </h2>
      <p class="text-xl mb-8 opacity-90">
        {lang === 'fi' 
          ? 'Meillä on syvää asiantuntemusta eri toimialoilla ja voimme auttaa sinua ratkaisemaan toimialasi ainutlaatuiset haasteet.' 
          : 'We have deep expertise in various industries and can help you solve your industry-specific challenges.'}
      </p>
      <a 
        href="/contact" 
        class="inline-block bg-white text-cyan-600 font-medium py-3 px-6 rounded-lg hover:bg-slate-100 transition-colors"
      >
        {lang === 'fi' ? 'Ota yhteyttä asiantuntijaamme' : 'Contact Our Experts'}
      </a>
    </div>
  </section>
</Layout>