---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Team and Certifications";

const content = {
  en: {
    title: "Team and Certifications",
    subtitle: "Meet Our Expert Cybersecurity Professionals",
    heroDescription: "Our team of certified cybersecurity experts brings decades of combined experience in compliance, risk management, and technical security to help your organization build resilient security programs.",
    team: {
      title: "Leadership Team",
      subtitle: "Experienced professionals leading our mission"
    },
    certifications: {
      title: "Professional Certifications",
      subtitle: "Our team maintains the highest industry standards"
    },
    expertise: {
      title: "Areas of Expertise",
      subtitle: "Comprehensive cybersecurity knowledge across multiple domains"
    }
  },
  fi: {
    title: "Tiimi ja Sertifikaatit",
    subtitle: "Tutustu Asiantuntijaamme Kyberturvallisuusprofessinaaleihin",
    heroDescription: "Sertifioitujen kyberturvallisuusasiantuntijoiden tiimimme tuo vuosikymmeniä yhdistettyä kokemusta noudattamisesta, riskien hallinnasta ja teknisestä turvallisuudesta auttaakseen organisaatiosi rakentamaan kestäviä turvallisuusohjelmia.",
    team: {
      title: "Johtotimi",
      subtitle: "Kokeneet ammattilaiset johtamassa tehtäväämme"
    },
    certifications: {
      title: "Ammattisertifikaatit",
      subtitle: "Tiimimme ylläpitää korkeimpia alan standardeja"
    },
    expertise: {
      title: "Asiantuntemuksen Alueet",
      subtitle: "Kattava kyberturvallisuustieto useilla alueilla"
    }
  }
};

const teamMembers = [
  {
    role: "Chief Executive Officer & Founder",
    description: "Our Chief Executive Officer brings over 15 years of cybersecurity expertise with deep knowledge in compliance frameworks and risk management. Having served as CISO at major financial institutions, they lead our organization with strategic vision in ISO 27001 implementation, enterprise risk management, and cybersecurity strategy development. Their certifications include CISSP, CISA, ISO 27001 Lead Auditor, and CRISC, ensuring our clients receive guidance from proven industry expertise."
  },
  {
    role: "Chief Technology Officer",
    description: "Our Chief Technology Officer is a former CISO with exceptional technical expertise in security architecture and threat assessment. They specialize in cloud security, incident response, and penetration testing methodologies. With certifications including CISSP, CEH, OSCP, and CCSP, they ensure our technical solutions remain at the forefront of cybersecurity innovation."
  },
  {
    role: "Compliance Director",
    description: "Our Compliance Director is a legal and compliance expert specializing in EU cybersecurity regulations. Having served as legal counsel at European cybersecurity agencies, they bring invaluable expertise in NIS2, GDPR, and DORA compliance frameworks. Their certifications include CIPP/E, CIPM, ISO 27001 Lead Implementer, and NIS2 Expert, ensuring comprehensive regulatory compliance guidance."
  },
  {
    role: "Senior Security Consultant",
    description: "Our Senior Security Consultant is a former Big 4 auditor with extensive experience in security assessments and compliance audits across multiple industries. They specialize in SOC 2 preparations and audit readiness, bringing certifications including CISA, CRISC, SOC 2 Practitioner, and ISO 27001 Lead Auditor to deliver thorough and reliable audit support."
  },
  {
    role: "Head of Risk Management",
    description: "Our Head of Risk Management specializes in enterprise risk management and business continuity planning. As an expert in ISO 31000 and ISO 22301 frameworks, they provide comprehensive risk assessment and business continuity solutions. Their certifications include CRISC, ISO 31000 Risk Manager, and ISO 22301 Lead Implementer, ensuring robust risk management strategies."
  },
  {
    role: "Technical Security Lead",
    description: "Our Technical Security Lead is a cloud security specialist with multi-cloud platform expertise. Having served as a senior security engineer at major technology companies, they bring deep knowledge in DevSecOps and cloud security architectures. Their certifications include CCSP and other advanced cloud security credentials, ensuring comprehensive cloud security solutions."
  }
];

const certificationCategories = [
  {
    category: "Information Security",
    certifications: ["CISSP", "CISM", "CISA", "CCSP", "SSCP"]
  },
  {
    category: "Risk Management",
    certifications: ["CRISC", "ISO 31000 Risk Manager", "ISO 27005 Risk Manager"]
  },
  {
    category: "Compliance & Audit",
    certifications: ["ISO 27001 Lead Auditor", "ISO 27001 Lead Implementer", "SOC 2 Practitioner"]
  },
  {
    category: "Privacy & Data Protection",
    certifications: ["CIPP/E", "CIPM", "CIPT", "GDPR Practitioner"]
  },
  {
    category: "Technical Security",
    certifications: ["CEH", "OSCP", "OSCE", "GPEN", "GXPN"]
  },
  {
    category: "Cloud Security",
    certifications: ["CCSP - Certified Cloud Security Professional"]
  }
];

const expertiseAreas = [
  {
    title: "Compliance",
    description: "ISO 27001, NIS2, DORA, GDPR, SOC 2",
    icon: "shield-check"
  },
  {
    title: "Risk Management",
    description: "Assessment, mitigation, and monitoring",
    icon: "chart-line"
  },
  {
    title: "Technical Security",
    description: "Architecture, testing, and implementation",
    icon: "lock-closed"
  },
  {
    title: "Consulting",
    description: "Strategic guidance and implementation",
    icon: "users"
  }
];

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- FULL PAGE WRAPPER WITH BLUE BACKGROUND -->
  <div class="min-h-screen relative overflow-hidden bg-cover bg-center bg-no-repeat bg-fixed">
    
    <!-- Top fade overlay -->
    <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white to-transparent z-10"></div>
    
    <!-- Bottom fade overlay -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent z-10"></div>

    <!-- Hero Section -->
    <section class="relative pt-8 md:pt-12 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-gradient-to-r from-[#3B82F6]/10 to-[#3bb1f6]/5 blur-3xl animate-pulse-slow"></div>
      </div>
      
      <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="text-center max-w-4xl mx-auto">
          <!-- Subtitle with gradient - now the main title -->
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl xl:text-5xl font-bold tracking-tight mb-3">
            <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">
              {currentContent.subtitle}
            </span>
          </h1>
          
          <!-- Description -->
          <p class="text-base md:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed animate-fade-in-up animation-delay-300">
            {currentContent.heroDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#3B82F6] mb-2">
            {currentContent.team.title}
          </h2>
          <p class="text-base text-[#1E2A7A] max-w-3xl leading-relaxed">
            {currentContent.team.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {teamMembers.map((member, index) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-end mb-3 relative z-10">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#3B82F6]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <svg class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                  </svg>
                </div>
              </div>
              <h3 class="text-lg font-bold text-[#1E40AF] mb-2 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">{member.role}</h3>
              <p class="text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">{member.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#3B82F6] mb-2">
            {currentContent.certifications.title}
          </h2>
          <p class="text-base text-[#1E2A7A] max-w-3xl leading-relaxed">
            {currentContent.certifications.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {certificationCategories.map((category) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-3 relative z-10">
                <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#3B82F6]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <svg class="w-4 h-4 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              </div>
              <h3 class="text-base md:text-lg font-bold text-[#1E40AF] mb-3 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">{category.category}</h3>
              <div class="flex flex-wrap gap-2 relative z-10">
                {category.certifications.map((cert) => (
                  <span class="px-2.5 py-1 text-xs font-medium text-[#3B82F6] bg-white rounded-full border border-[#3B82F6]">
                    {cert}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Expertise Areas Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#3B82F6] mb-2">
            {currentContent.expertise.title}
          </h2>
          <p class="text-base text-[#1E2A7A] max-w-3xl leading-relaxed">
            {currentContent.expertise.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {expertiseAreas.map((area) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-3 relative z-10">
                <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#3B82F6]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={area.icon} class="w-4 h-4 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <h3 class="text-base md:text-lg font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">{area.title}</h3>
              <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">{area.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


  </div>
  <!-- END FULL PAGE WRAPPER -->

</Layout>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  
  @keyframes pulse-slow {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
    50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; }
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-gradient {
    animation: gradient 4s ease infinite;
    background-size: 200% 200%;
  }
  
  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }
  
  .animation-delay-300 {
    animation-delay: 0.3s;
  }
</style>