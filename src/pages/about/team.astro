---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "How We Work";

const content = {
  en: {
    title: "How We Work",
    subtitle: "How We Deliver Engagements",
    heroDescription: "Cyber Security Finland structures engagements around defined roles covering compliance, governance, and technical security — so every program has a clear point of accountability from scoping through evidence delivery.",
    team: {
      title: "How We Deliver Engagements",
      subtitle: "Every engagement is structured around these functions"
    },
    certifications: {
      title: "",
      subtitle: ""
    },
    expertise: {
      title: "Areas of Expertise",
      subtitle: "Cybersecurity and compliance domains we work in"
    }
  },
  fi: {
    title: "Näin Toimimme",
    subtitle: "Näin Toteutamme Toimeksiantoja",
    heroDescription: "Cyber Security Finland rakentaa toimeksiannot määriteltyjen roolien ympärille, jotka kattavat vaatimustenmukaisuuden, hallinnon ja teknisen tietoturvan – jotta jokaisella ohjelmalla on selkeä vastuuhenkilö laajuuden määrittelystä näytön toimittamiseen asti.",
    team: {
      title: "Näin Toteutamme Toimeksiantoja",
      subtitle: "Jokainen toimeksianto rakentuu näiden roolien ympärille"
    },
    certifications: {
      title: "",
      subtitle: ""
    },
    expertise: {
      title: "Asiantuntemuksen Alueet",
      subtitle: "Kyberturvallisuus- ja vaatimustenmukaisuusalueet, joilla toimimme"
    }
  }
};

const teamMembers = [
  {
    role: "Engagement Lead",
    description: "Owns the overall program, coordinates scope and timeline, and is the primary point of contact between your organization and our team throughout the engagement."
  },
  {
    role: "Compliance Specialist",
    description: "Works through the applicable regulatory or standards requirements (NIS2, CRA, ISO 27001, DORA, GDPR) with your team, translating them into a concrete gap assessment and control set."
  },
  {
    role: "Technical Security Specialist",
    description: "Supports the technical implementation and validation side of an engagement — architecture, control implementation, and evidence gathering for audit or certification readiness."
  }
];

const expertiseAreas = [
  {
    title: "Compliance",
    description: "ISO 27001, NIS2, DORA, GDPR, SOC 2",
    icon: "shield-check"
  },
  {
    title: "Risk Management",
    description: "Assessment, mitigation, and monitoring",
    icon: "chart-line"
  },
  {
    title: "Technical Security",
    description: "Architecture, testing, and implementation",
    icon: "lock-closed"
  },
  {
    title: "Consulting",
    description: "Strategic guidance and implementation",
    icon: "users"
  }
];

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- FULL PAGE WRAPPER WITH BLUE BACKGROUND -->
  <div class="min-h-screen relative overflow-hidden bg-cover bg-center bg-no-repeat bg-fixed">
    
    <!-- Top fade overlay -->
    <div class="absolute top-0 left-0 right-0 h-24 bg-white z-10"></div>
    
    <!-- Bottom fade overlay -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-white z-10"></div>

    <!-- Hero Section -->
    <section class="relative pt-8 md:pt-12 overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[#003580]/10 blur-3xl animate-pulse-slow"></div>
      </div>
      
      <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="text-center max-w-4xl mx-auto">
          <!-- Subtitle with gradient - now the main title -->
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl xl:text-5xl font-bold tracking-tight mb-3">
            <span class="bg-[#131c2e] bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">
              {currentContent.subtitle}
            </span>
          </h1>
          
          <!-- Description -->
          <p class="text-base md:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed animate-fade-in-up animation-delay-300">
            {currentContent.heroDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
            {currentContent.team.title}
          </h2>
          <p class="text-base text-[#131c2e] max-w-3xl leading-relaxed">
            {currentContent.team.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {teamMembers.map((member, index) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-end mb-3 relative z-10">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                  </svg>
                </div>
              </div>
              <h3 class="text-lg font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">{member.role}</h3>
              <p class="text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">{member.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Expertise Areas Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-left mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
            {currentContent.expertise.title}
          </h2>
          <p class="text-base text-[#131c2e] max-w-3xl leading-relaxed">
            {currentContent.expertise.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {expertiseAreas.map((area) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-3 relative z-10">
                <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={area.icon} class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <h3 class="text-base md:text-lg font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">{area.title}</h3>
              <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">{area.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


  </div>
  <!-- END FULL PAGE WRAPPER -->

</Layout>

<style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  
  @keyframes pulse-slow {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
    50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; }
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-gradient {
    animation: gradient 4s ease infinite;
    background-size: 200% 200%;
  }
  
  .animate-pulse-slow {
    animation: pulse-slow 4s ease-in-out infinite;
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }
  
  .animation-delay-300 {
    animation-delay: 0.3s;
  }
</style>