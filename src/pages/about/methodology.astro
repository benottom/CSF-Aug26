---
import Layout from '@/layouts/Layout.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Methodology";

const content = {
  en: {
    title: "Our Methodology",
    subtitle: "Proven Approach to Cybersecurity Excellence",
    heroDescription: "Our systematic methodology combines industry best practices with practical experience to deliver measurable results and sustainable security improvements.",
    approach: {
      title: "Our Approach",
      subtitle: "Systematic and results-driven methodology"
    },
    phases: {
      title: "Implementation Phases",
      subtitle: "Structured approach to achieving your security goals"
    },
    frameworks: {
      title: "Framework Integration",
      subtitle: "Seamlessly integrate multiple compliance standards"
    },
    tools: {
      title: "Tools and Technologies",
      subtitle: "Practical tools and technologies to support delivery"
    }
  },
  fi: {
    title: "Metodologiamme",
    subtitle: "Todistettu Lähestymistapa Kyberturvallisuuden Erinomaisuuteen",
    heroDescription: "Systemaattinen metodologiamme yhdistää alan parhaat käytännöt käytännönkokemukseen tuottaakseen mitattavia tuloksia ja kestäviä turvallisuusparannuksia.",
    approach: {
      title: "Lähestymistapamme",
      subtitle: "Systemaattinen ja tuloksellinen metodologia"
    },
    phases: {
      title: "Toteutusvaiheet",
      subtitle: "Järjestelmällinen lähestymistapa turvallisuustavoitteidesi saavuttamiseen"
    },
    frameworks: {
      title: "Kehysten Integrointi",
      subtitle: "Integroi saumattomasti useita noudattamisstandardeja"
    },
    tools: {
      title: "Työkalut ja Teknologiat",
      subtitle: "Käytännön työkalut ja teknologiat toteutuksen tukena"
    }
  }
};

const methodologyPhases = [
  {
    phase: "1",
    title: "Assessment & Discovery",
    description: "Comprehensive evaluation of current security posture, risks, and compliance gaps",
    activities: ["Security maturity assessment", "Risk identification", "Gap analysis", "Stakeholder interviews"],
    duration: "2-4 weeks"
  },
  {
    phase: "2",
    title: "Strategy & Planning",
    description: "Develop comprehensive security strategy aligned with business objectives and compliance requirements",
    activities: ["Security roadmap creation", "Resource planning", "Timeline development", "Success metrics definition"],
    duration: "2-3 weeks"
  },
  {
    phase: "3",
    title: "Implementation & Execution",
    description: "Systematic implementation of security controls, policies, and procedures",
    activities: ["Control implementation", "Policy development", "Training delivery", "Process documentation"],
    duration: "8-16 weeks"
  },
  {
    phase: "4",
    title: "Validation & Optimization",
    description: "Verify effectiveness of implemented controls and optimize for continuous improvement",
    activities: ["Control testing", "Audit preparation", "Performance optimization", "Continuous monitoring setup"],
    duration: "2-4 weeks"
  }
];

const frameworkIntegration = [
  {
    name: "ISO 27001",
    description: "Information Security Management System foundation",
    benefits: ["Risk-based approach", "Continuous improvement", "International recognition"]
  },
  {
    name: "NIS2",
    description: "EU cybersecurity directive compliance",
    benefits: ["Regulatory alignment", "Incident reporting", "Supply chain security"]
  },
  {
    name: "DORA",
    description: "Digital Operational Resilience for financial services",
    benefits: ["ICT risk management", "Digital resilience", "Financial sector focus"]
  },
  {
    name: "GDPR",
    description: "Data protection and privacy compliance",
    benefits: ["Privacy by design", "Data governance", "Rights management"]
  },
  {
    name: "SOC 2",
    description: "Trust services criteria for service organizations",
    benefits: ["Third-party assurance", "Control effectiveness", "Customer confidence"]
  }
];

const toolsAndTechnologies = [
  {
    category: "Risk Assessment",
    tools: ["Qualys", "Rapid7", "Tenable", "Custom risk matrices"]
  },
  {
    category: "Compliance Management",
    tools: ["OneTrust", "TrustArc", "Custom compliance dashboards"]
  },
  {
    category: "Security Testing",
    tools: ["Burp Suite", "Metasploit", "Nmap", "Custom testing frameworks"]
  },
  {
    category: "Monitoring & Analytics",
    tools: ["Splunk", "ELK Stack", "Custom SIEM solutions"]
  }
];

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- Hero Section - Matching homepage -->
  <section class="bg-blue-50 text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#131c2e]">{currentContent.title}</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
          {currentContent.subtitle}
        </p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.heroDescription}
        </p>
      </div>
      
    </div>
  </section>

  <!-- Approach Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.approach.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.approach.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-20 h-20 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-[#131c2e] transition-all duration-300">
              <svg class="w-10 h-10 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#131c2e] transition-colors duration-300">Evidence-Based</h3>
          <p class="text-sm text-slate-500">Our recommendations are grounded in industry research, best practices, and real-world experience.</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-20 h-20 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-[#131c2e] transition-all duration-300">
              <svg class="w-10 h-10 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#131c2e] transition-colors duration-300">Risk-Focused</h3>
          <p class="text-sm text-slate-500">We prioritize security measures based on actual risk exposure and business impact.</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-20 h-20 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-[#131c2e] transition-all duration-300">
              <svg class="w-10 h-10 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#131c2e] transition-colors duration-300">Continuous Improvement</h3>
          <p class="text-sm text-slate-500">We establish processes for ongoing monitoring, assessment, and enhancement of security posture.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Phases Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.phases.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="space-y-6">
        {methodologyPhases.map((phase) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-md transition-all duration-300">
            <div class="flex flex-col md:flex-row md:items-start gap-6">
              <div class="flex-shrink-0">
                <div class="w-16 h-16 bg-[#131c2e] text-white rounded-xl flex items-center justify-center text-2xl font-bold shadow-md">
                  {phase.phase}
                </div>
              </div>
              <div class="flex-1">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
                  <h3 class="text-xl font-bold text-slate-900 mb-2 md:mb-0">{phase.title}</h3>
                  <span class="inline-flex items-center px-3 py-1 rounded-[2px] bg-blue-100 text-blue-700 text-xs font-medium">
                    {phase.duration}
                  </span>
                </div>
                <p class="text-sm text-slate-500 mb-4">{phase.description}</p>
                <div>
                  <p class="text-sm font-semibold text-slate-700 mb-2">Key Activities:</p>
                  <ul class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    {phase.activities.map((activity) => (
                      <li class="flex items-center gap-2 text-sm text-slate-600">
                        <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {activity}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Framework Integration Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.frameworks.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.frameworks.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {frameworkIntegration.map((framework) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#131c2e] transition-colors duration-300">{framework.name}</h3>
            <p class="text-sm text-slate-500 mb-4">{framework.description}</p>
            <div>
              <p class="text-sm font-semibold text-slate-700 mb-2">Key Benefits:</p>
              <ul class="space-y-1">
                {framework.benefits.map((benefit) => (
                  <li class="flex items-center gap-2 text-sm text-slate-600">
                    <svg class="w-3.5 h-3.5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {benefit}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tools Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.tools.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.tools.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {toolsAndTechnologies.map((category) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 transition-all duration-300">
            <h3 class="text-xl font-bold text-[#131c2e] mb-4">{category.category}</h3>
            <div class="space-y-2">
              {category.tools.map((tool) => (
                <div class="flex items-center gap-2">
                  <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-slate-600 text-sm">{tool}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section - Matching homepage -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#131c2e]">
          Ready to Implement Our Methodology?
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          Let's discuss how our systematic approach can transform your security posture.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            Get Started
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>