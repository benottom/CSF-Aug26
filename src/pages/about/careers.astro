---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Careers";

const content = {
  en: {
    title: "Careers",
    subtitle: "Join Our Mission to Secure the Digital World",
    heroDescription: "Build your career with a team of cybersecurity experts who are passionate about protecting organizations and advancing the industry. We offer challenging opportunities, continuous learning, and a collaborative environment.",
    culture: {
      title: "Our Culture",
      subtitle: "What makes CyberSecurity.fi a great place to work"
    },
    benefits: {
      title: "Benefits & Perks",
      subtitle: "We take care of our team members"
    },
    opportunities: {
      title: "Open Positions",
      subtitle: "Join our growing team of cybersecurity professionals"
    },
    growth: {
      title: "Professional Growth",
      subtitle: "Continuous learning and career development opportunities"
    }
  },
  fi: {
    title: "Ura",
    subtitle: "Liity Tehtäväämme Suojella Digitaalista Maailmaa",
    heroDescription: "Rakenna uraasi kyberturvallisuusasiantuntijoiden tiimin kanssa, jotka ovat intohimoisia organisaatioiden suojaamisesta ja alan kehittämisestä. Tarjoamme haastavia mahdollisuuksia, jatkuvaa oppimista ja yhteistyökeskeisen ympäristön.",
    culture: {
      title: "Kulttuurimme",
      subtitle: "Mikä tekee CyberSecurity.fi:stä hienon työpaikan"
    },
    benefits: {
      title: "Edut ja Bonukset",
      subtitle: "Huolehdimme tiimijäsenistämme"
    },
    opportunities: {
      title: "Avoimet Paikat",
      subtitle: "Liity kasvavaan kyberturvallisuusprofessinaalien tiimiimme"
    },
    growth: {
      title: "Ammatillinen Kasvu",
      subtitle: "Jatkuvan oppimisen ja uran kehitysmahdollisuudet"
    }
  }
};

const companyBenefits = [
  {
    category: "Learning & Development",
    benefits: [
      "Professional certification support",
      "Ongoing training and knowledge sharing"
    ]
  },
  {
    category: "Work-Life Balance",
    benefits: [
      "Remote work options",
      "Flexible scheduling"
    ]
  }
];

const growthOpportunities = [
  {
    title: "Certification Support",
    description: "Support for relevant industry certifications such as CISSP, CISM, and CISA",
    icon: "certificate"
  },
  {
    title: "Internal Training",
    description: "Regular internal knowledge sharing sessions and technical deep-dives",
    icon: "users"
  },
  {
    title: "Real Client Work",
    description: "Direct involvement in NIS2, CRA, ISO 27001, and DORA engagements from day one",
    icon: "trending-up"
  }
];

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- FULL PAGE WRAPPER WITH BLUE BACKGROUND -->
  <div class="min-h-screen relative overflow-hidden bg-cover bg-center bg-no-repeat bg-fixed">
    
    <!-- Top fade overlay -->
    <div class="absolute top-0 left-0 right-0 h-24 bg-white z-10"></div>
    
    <!-- Bottom fade overlay -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-white z-10"></div>

<!-- Hero Section -->
<section class="text-slate-900 flex items-center relative pt-8 md:pt-12 overflow-hidden">
  <!-- Animated background glow -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-[#003580]/10 blur-3xl animate-pulse-slow"></div>
  </div>
  
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    
    <div class="text-center max-w-4xl mx-auto">
      <!-- Main title with gradient - from subtitle -->
      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-4xl xl:text-5xl font-bold tracking-tight mb-3">
        <span class="bg-[#131c2e] bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">
          {currentContent.subtitle}
        </span>
      </h1>
      
      <!-- Description -->
<p class="text-base md:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed animate-fade-in-up animation-delay-300">
  {currentContent.heroDescription}
</p>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }
  
  .animation-delay-300 {
    animation-delay: 0.3s;
  }
</style>
</section>

    <!-- Culture Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-8 md:mb-10">
<h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2 text-left">
  {currentContent.culture.title}
</h2>
<p class="text-base text-[#131c2e] max-w-3xl leading-relaxed text-left">
  {currentContent.culture.subtitle}
</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Culture 1 -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-3 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
            </div>
            <h3 class="text-lg font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">Continuous Learning</h3>
            <p class="text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">We believe in lifelong learning and provide extensive opportunities for professional development.</p>
          </div>
          
          <!-- Culture 2 -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#131c2e] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-3 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
            </div>
            <h3 class="text-lg font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">Collaborative Environment</h3>
            <p class="text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">Work with talented professionals in a supportive, team-oriented culture.</p>
          </div>
          
          <!-- Culture 3 -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#2E6FBA] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-3 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
            </div>
            <h3 class="text-lg font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">Impact & Purpose</h3>
            <p class="text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">Make a real difference in protecting organizations from cyber threats.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
            {currentContent.benefits.title}
          </h2>
          <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
            {currentContent.benefits.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
          {companyBenefits.map((category) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-2 relative z-10">
                <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
              
              <h3 class="text-base md:text-lg font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">{category.category}</h3>
              <ul class="space-y-1.5 relative z-10">
                {category.benefits.map((benefit) => (
                  <li class="flex items-start gap-1.5 text-xs md:text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                    <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {benefit}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Open Positions Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
            {currentContent.opportunities.title}
          </h2>
          <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
            {currentContent.opportunities.subtitle}
          </p>
        </div>

        <div class="max-w-2xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 md:p-8 text-center">
          <p class="text-sm md:text-base text-slate-600 leading-relaxed mb-4">
            {lang === 'fi'
              ? 'Meillä ei ole tällä hetkellä avoimia hakuja listattuna. Olemme kuitenkin aina kiinnostuneita kuulemaan kokeneista kyberturvallisuus- ja vaatimustenmukaisuusasiantuntijoista.'
              : "We don't have specific openings listed right now. We're always interested in hearing from experienced cybersecurity and compliance professionals."}
          </p>
          <a href="/contact" class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5">
            {lang === 'fi' ? 'Ota yhteyttä' : 'Get in Touch'}
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Growth Opportunities Section -->
    <section class="py-12 md:py-16 bg-white/90 backdrop-blur-sm relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center mb-8 md:mb-10">
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
            {currentContent.growth.title}
          </h2>
          <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
            {currentContent.growth.subtitle}
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
          {growthOpportunities.map((opportunity) => (
            <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                        hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                        transition-all duration-300
                        flex flex-col p-5 md:p-6 group relative overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
              
              <div class="flex justify-start mb-2 relative z-10">
                <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
              <h3 class="text-base md:text-lg font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">{opportunity.title}</h3>
              <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">{opportunity.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>
  <!-- END FULL PAGE WRAPPER -->

</Layout>