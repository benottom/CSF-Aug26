---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Our Story";

const content = {
  en: {
    title: "About CSF",
    subtitle: "Cyber Security Finland - Your Trusted Security Partner",
    heroDescription: "CSF provides comprehensive cybersecurity services to protect organizations and maintain safe digital environments worldwide.",
    story: {
      title: "About CSF",
      content: "CSF delivers a comprehensive suite of Governance, Risk & Compliance Services, Security Testing, Supply Chain Information Risk Management, Secure Code Testing, Security Awareness Training, Virtual CISO Service, Red Team Testing, Information Security Threat & Risk Assessments, Information Security Management Systems, Social Engineering, Gap Analysis, Risk Assessment, PCI DSS, DPA & GDPR, ISO 27001, SOC 2 Type 2, Cyber Essentials and Penetration Testing.",
      vision: "Our mission is to create and maintain secure digital environments through threat analysis, protection, investigations, consulting, intelligence, and security training services. We've developed an efficient, secure, and streamlined approach to managing security and penetration testing projects. Our seasoned experts deliver customized solutions tailored to each client's unique needs, working proactively to prevent security incidents before they occur. This dedication, combined with our team's expertise and proven results, has established CSF as the global benchmark for protective and investigative services.",
      growth: "Our comprehensive Cybersecurity Support encompasses Security Assessments, Computer Network Operations and Defense, Security Certification and Accreditation, Perimeter Defense Design and Implementation, and Independent Security Testing and Evaluation. Founded in 2021 and headquartered in Helsinki, Finland, we are a leading Computer and Network Security company with 11-50 specialized professionals. Our expertise spans cyber security, risk assessment, risk management, penetration testing, and vulnerability management."
    },
    milestones: {
      title: "Company Information",
      items: [
        {
          year: "2021",
          title: "Founded",
          description: "Established in Helsinki, Finland"
        },
        {
          year: "11-50",
          title: "Team Size",
          description: "Cybersecurity specialists"
        },
        {
          year: "Finland",
          title: "Headquarters",
          description: "Based in Helsinki, serving globally"
        },
        {
          year: "Global",
          title: "Reach",
          description: "Worldwide protective services"
        }
      ]
    },
    values: {
      title: "Our Specialties",
      items: [
        {
          title: "Cyber Security",
          description: "Comprehensive security solutions and threat management."
        },
        {
          title: "Risk Assessment",
          description: "Thorough analysis and assessment methodologies."
        },
        {
          title: "Risk Management",
          description: "Strategic frameworks and implementation guidance."
        },
        {
          title: "Penetration Testing",
          description: "Advanced testing and vulnerability assessment."
        },
        {
          title: "Vulnerability Management",
          description: "Continuous management and remediation strategies."
        }
      ]
    }
  },
  fi: {
    title: "Tarinaamme",
    subtitle: "Rakennamme Turvallista Digitaalista Tulevaisuutta Vuodesta 2018",
    heroDescription: "Tutustu matkaan, joka johti meidät Suomen johtavaksi kyberturvallisuuskonsultiksi, joka on omistautunut organisaatioiden suojaamiseen ja kestävien turvallisuusohjelmien rakentamiseen.",
    story: {
      title: "Alku",
      content: "CyberSecurity.fi perustettiin vuonna 2018 yksinkertaisesta mutta voimakkaasta visiosta: tehdä yritystason kyberturvallisuudesta saavutettavissa kaikille organisaatioille. Perustajamme, kokeneet kyberturvallisuusasiantuntijat, joilla on yhteensä vuosikymmeniä kokemusta, tunnistivat kasvavan kuilun monimutkaisten sääntelyvaatimusten ja käytännön toteutuskapasiteetin välillä.",
      vision: "Kuvittelimme maailman, jossa organisaatiot voisivat navigoida monimutkaisessa kyberturvallisuusmaisemassa luottavaisesti, asiantuntijoiden tuella, jotka ymmärtävät sekä tekniset että liiketoiminnan turvallisuusnäkökohdat.",
      growth: "Helsingissä, Suomessa, olemme kasvaneet pienestä konsultista Suomen johtavaksi kyberturvallisuuden noudattamisen ja riskien hallinnan konsultiksi. Asiantuntemuksemme kattaa useita kehystöjä, mukaan lukien ISO 27001, NIS2, DORA, GDPR ja SOC 2, palvelemme asiakkaita ympäri Eurooppaa ja sen ulkopuolella."
    },
    milestones: {
      title: "Keskeiset Virstanpylväät",
      items: [
        {
          year: "2018",
          title: "Perustaminen",
          description: "Yritys perustettu"
        },
        {
          year: "2020",
          title: "Laajentuminen",
          description: "Tiimi laajennettu"
        },
        {
          year: "2022",
          title: "Kasvu",
          description: "DORA-palvelut käynnistetty"
        },
        {
          year: "2024",
          title: "Johtajuus",
          description: "Tunnustettu parhaaksi"
        }
      ]
    },
    values: {
      title: "Keskeiset Arvomme",
      items: [
        {
          title: "Erinomaisuus",
          description: "Pyrimme erinomaisuuteen jokaisessa työsuhteessa."
        },
        {
          title: "Rehellisyys",
          description: "Toimimme korkeimmilla eettisillä standardeilla."
        },
        {
          title: "Innovaatio",
          description: "Jatkuvasti innovoimme lähestymistapojamme."
        },
        {
          title: "Kumppanuus",
          description: "Rakennamme pitkäaikaisia kumppanuuksia."
        }
      ]
    }
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- FULL PAGE WRAPPER WITH WHITE BACKGROUND -->
  <div class="min-h-screen bg-white">
    
    <!-- Hero Section -->
    <section class="pt-12 md:pt-16 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
            <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
              {currentContent.subtitle}
            </span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl">
            {currentContent.heroDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl">
          <h2 class="text-2xl md:text-3xl font-bold text-[#0EA5E9] mb-6">
            {currentContent.story.title}
          </h2>
          
          <div class="space-y-4 text-slate-600 text-base md:text-lg leading-relaxed text-justify">
            <p>{currentContent.story.content}</p>
            <p>{currentContent.story.vision}</p>
            <p>{currentContent.story.growth}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Information Section -->
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0EA5E9] mb-6">
          {currentContent.milestones.title}
        </h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {currentContent.milestones.items.map((item) => (
            <div class="bg-white rounded-xl border border-slate-200 p-5 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
              <div class="text-2xl md:text-3xl font-bold text-[#0F172A] mb-1">{item.year}</div>
              <div class="font-semibold text-slate-800 mb-1">{item.title}</div>
              <div class="text-sm text-slate-500">{item.description}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Specialties Section -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0EA5E9] mb-6">
          {currentContent.values.title}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {currentContent.values.items.map((item) => (
            <div class="bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:-translate-y-1 hover:shadow-md transition-all duration-300">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-[#0EA5E9]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-800 mb-1">{item.title}</h3>
                  <p class="text-sm text-slate-500 leading-relaxed">{item.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>

</Layout>