---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Our Story";

const content = {
  en: {
    title: "Our Story",
    subtitle: "Cyber Security Finland",
    heroDescription: "Cyber Security Finland Oy helps organizations translate EU cybersecurity regulation into implemented controls, technical evidence, and audit-ready compliance programs.",
    story: {
      title: "What We Do",
      content: "We work on cybersecurity compliance engineering, assurance, and advisory services for organizations operating under European cybersecurity regulation — including NIS2, the Cyber Resilience Act (CRA), ISO 27001, DORA, EUCC, and GDPR.",
      vision: "Our approach connects regulatory requirements to governance, architecture, technical controls, implementation, testing, and evidence. The objective isn't just to document compliance — it's to make cybersecurity controls demonstrable, maintainable, and defensible.",
      growth: "We're based in Helsinki, Finland, and deliver engagements across Finland and the EU."
    },
    milestones: {
      title: "Company Information",
      items: [
        {
          year: "3195889-5",
          title: "Business ID",
          description: "Cyber Security Finland Oy"
        },
        {
          year: "Helsinki",
          title: "Headquarters",
          description: "Mikonkatu 9, 00100 Helsinki"
        },
        {
          year: "EU-Wide",
          title: "Delivery Scope",
          description: "Finland and the European Union"
        },
        {
          year: "EN / FI",
          title: "Languages",
          description: "English and Finnish"
        }
      ]
    },
    values: {
      title: "Areas We Work In",
      items: [
        {
          title: "Compliance Engineering",
          description: "Translating regulatory requirements into technical controls, testing, and evidence."
        },
        {
          title: "NIS2 & CRA",
          description: "Scope assessment, gap analysis, and implementation support."
        },
        {
          title: "ISO 27001",
          description: "ISMS design, control implementation, and audit readiness."
        },
        {
          title: "Risk & Governance",
          description: "Risk assessment, management frameworks, and governance support."
        },
        {
          title: "VAPT",
          description: "Vulnerability assessment and penetration testing, delivered with our red team partner."
        }
      ]
    }
  },
  fi: {
    title: "Tarinamme",
    subtitle: "Cyber Security Finland",
    heroDescription: "Cyber Security Finland Oy auttaa organisaatioita muuttamaan EU:n kyberturvallisuussääntelyn toteutetuiksi kontrolleiksi, tekniseksi näytöksi ja auditointivalmiiksi vaatimustenmukaisuusohjelmiksi.",
    story: {
      title: "Mitä Teemme",
      content: "Teemme kyberturvallisuuden vaatimustenmukaisuuden toteutus-, varmennus- ja neuvontatyötä organisaatioille, jotka toimivat eurooppalaisen kyberturvallisuussääntelyn alaisina – mukaan lukien NIS2, kyberkestävyyssäädös (CRA), ISO 27001, DORA, EUCC ja GDPR.",
      vision: "Lähestymistapamme yhdistää sääntelyvaatimukset hallintoon, arkkitehtuuriin, teknisiin kontrolleihin, toteutukseen, testaukseen ja näyttöön. Tavoitteena ei ole vain dokumentoida vaatimustenmukaisuutta, vaan tehdä kyberturvallisuuskontrolleista osoitettavia, ylläpidettäviä ja puolustettavia.",
      growth: "Toimimme Helsingistä, Suomesta käsin ja toteutamme toimeksiantoja Suomessa ja EU:ssa."
    },
    milestones: {
      title: "Yrityksen Tiedot",
      items: [
        {
          year: "3195889-5",
          title: "Y-tunnus",
          description: "Cyber Security Finland Oy"
        },
        {
          year: "Helsinki",
          title: "Pääkonttori",
          description: "Mikonkatu 9, 00100 Helsinki"
        },
        {
          year: "EU-laajuinen",
          title: "Toimituslaajuus",
          description: "Suomi ja Euroopan unioni"
        },
        {
          year: "EN / FI",
          title: "Kielet",
          description: "Englanti ja suomi"
        }
      ]
    },
    values: {
      title: "Osaamisalueemme",
      items: [
        {
          title: "Compliance Engineering",
          description: "Sääntelyvaatimusten muuttaminen teknisiksi kontrolleiksi, testaukseksi ja näytöksi."
        },
        {
          title: "NIS2 ja CRA",
          description: "Soveltuvuusarviointi, aukkoanalyysi ja toteutustuki."
        },
        {
          title: "ISO 27001",
          description: "ISMS-suunnittelu, kontrollien toteutus ja auditointivalmius."
        },
        {
          title: "Riskit ja Hallinto",
          description: "Riskienarviointi, hallintakehykset ja hallintotuki."
        },
        {
          title: "VAPT",
          description: "Haavoittuvuusarviointi ja tunkeutumistestaus, toteutettuna red team -kumppanimme kanssa."
        }
      ]
    }
  }
};

const currentContent = content[lang];
---

<Layout title={title}>

  <!-- FULL PAGE WRAPPER WITH WHITE BACKGROUND -->
  <div class="min-h-screen bg-white">
    
    <!-- Hero Section -->
    <section class="pt-12 md:pt-16 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
            <span class="bg-[#131c2e] bg-clip-text text-transparent">
              {currentContent.subtitle}
            </span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl">
            {currentContent.heroDescription}
          </p>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl">
          <h2 class="text-2xl md:text-3xl font-bold text-[#003580] mb-6">
            {currentContent.story.title}
          </h2>
          
          <div class="space-y-4 text-slate-600 text-base md:text-lg leading-relaxed text-justify">
            <p>{currentContent.story.content}</p>
            <p>{currentContent.story.vision}</p>
            <p>{currentContent.story.growth}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Information Section -->
    <section class="py-12 md:py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#003580] mb-6">
          {currentContent.milestones.title}
        </h2>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {currentContent.milestones.items.map((item) => (
            <div class="bg-white rounded-xl border border-slate-200 p-5 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
              <div class="text-2xl md:text-3xl font-bold text-[#131c2e] mb-1">{item.year}</div>
              <div class="font-semibold text-slate-800 mb-1">{item.title}</div>
              <div class="text-sm text-slate-500">{item.description}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Specialties Section -->
    <section class="py-12 md:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#003580] mb-6">
          {currentContent.values.title}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {currentContent.values.items.map((item) => (
            <div class="bg-white rounded-xl border border-slate-200 p-5 hover:shadow-lg hover:-translate-y-1 hover:shadow-md transition-all duration-300">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-[#003580]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-slate-800 mb-1">{item.title}</h3>
                  <p class="text-sm text-slate-500 leading-relaxed">{item.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

  </div>

</Layout>