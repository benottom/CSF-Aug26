          coverage: "Verkko- ja tietoturva",
          difficulty: "Keskitaso",
          icon: "globe"
        },
        {
          title: "Yleinen turvallisuustila",
          description: "Kattava arviointi kyberturvallisuuden kypsyystasosta",
          duration: "50-65 minuuttia",
          questions: "110 kysymystä",
          coverage: "Kaikki turvallisuusalueet",
          difficulty: "Kaikki tasot",
          icon: "chart-line"
        }
      ]
    },
    process: {
      title: "Kartoitusprosessi",
      description: "Miten valmiuskartoituksemme toimivat ja mitä voit odottaa.",
      steps: [
        {
          step: "1",
          title: "Valitse kartoitus",
          description: "Valitse kartoitus, joka parhaiten vastaa tarpeitasi ja yhteensopivuusvaatimuksia",
