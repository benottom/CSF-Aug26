        },
        {
          step: "2",
          title: "Vastaa kysymyksiin",
          description: "Vastaa kattaviin kysymyksiin nykyisistä turvallisuuskäytännöistäsi ja valvontatoimista",
          duration: "30-75 minuuttia"
        },
        {
          step: "3",
          title: "Saa analyysi",
          description: "Saa yksityiskohtaiset tulokset pisteillä, suosituksilla ja toimintasuunnitelmalla",
          duration: "Välittömästi"
        },
        {
          step: "4",
