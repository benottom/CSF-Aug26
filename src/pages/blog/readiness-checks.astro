          icon: "search"
        },
        {
          title: "Save Time",
          description: "Avoid costly mistakes by understanding requirements upfront",
          icon: "clock"
        },
        {
          title: "Prioritize Actions",
          description: "Focus resources on the most critical security improvements",
          icon: "trending-up"
        },
        {
          title: "Track Progress",
          description: "Monitor your security maturity improvements over time",
          icon: "chart-line"
        },
        {
          title: "Compliance Confidence",
          description: "Build confidence in your ability to meet regulatory requirements",
          icon: "shield-check"
        },
        {
