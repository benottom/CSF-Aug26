          description: "Access to cybersecurity experts for implementation support",
          icon: "users"
        }
      ]
    },
    sample: {
      title: "Sample Questions",
      description: "Get a preview of the types of questions you'll encounter in our assessments.",
      questions: [
        {
          category: "Access Control",
