        },
        {
          category: "Tietojen suojaus",
          question: "Onko kaikki arkaluontoiset tietoaineistot luokiteltu ja merkitty arkaluonteisuustasonsa mukaan?",
          options: ["Kyllä, kattava luokittelu", "Kyllä, perusluokittelu", "Osittainen luokittelu", "Ei luokittelua"]
        },
        {
          category: "Tapahtumavastaus",
          question: "Onko sinulla dokumentoitu tapahtumavastaussuunnitelma, jota testataan vuosittain?",
          options: ["Kyllä, testataan vuosittain", "Kyllä, testataan satunnaisesti", "Kyllä, mutta ei testata", "Ei suunnitelmaa"]
        },
        {
          category: "Riskien hallinta",
          question: "Kuinka usein suoritatte kattavia turvallisuusriskien arviointeja?",
