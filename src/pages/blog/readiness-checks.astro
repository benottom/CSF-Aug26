  fi: {
    title: "Valmiuskartoitukset",
    subtitle: "Arvioi kyberturvallisuustilasi",
    heroDescription: "Ota kattavat valmiuskartoituksemme arvioidaksesi organisaatiosi kyberturvallisuuden kypsyystasoa ja tunnistaa parannusalueet.",
    assessments: {
      title: "Saatavissa olevat kartoitukset",
      description: "Valitse erikoistuneiden valmiuskartoituksemme joukosta, jotka on suunniteltu erilaisille yhteensopivuuskehyksille ja turvallisuusalueille.",
