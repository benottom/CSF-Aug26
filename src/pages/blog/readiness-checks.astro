        }
      ]
    },
    benefits: {
      title: "Valmiuskartoituksen hyödyt",
      description: "Miksi organisaatiot valitsevat arviointityökalumme.",
      advantages: [
        {
          title: "Tunnista kuilut",
          description: "Tunnista tarkat alueet, joissa turvallisuustilasi tarvitsee parannusta",
          icon: "search"
        },
        {
          title: "Säästä aikaa",
          description: "Vältä kalliita virheitä ymmärtämällä vaatimukset etukäteen",
          icon: "clock"
        },
        {
          title: "Priorisoi toimenpiteet",
          description: "Keskitä resursseja kriittisimpiin turvallisuusparannuksiin",
          icon: "trending-up"
        },
        {
          title: "Seuraa edistymistä",
          description: "Seuraa turvallisuuden kypsyystason parannuksia ajan myötä",
          icon: "chart-line"
        },
        {
