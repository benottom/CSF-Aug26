---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const title = "Blog";
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    title: "Blog & Guides",
    subtitle: "Expert Insights, Practical Guides & Industry Resources",
    description: "Stay ahead of cybersecurity trends with our expert insights, comprehensive implementation guides, and practical resources. From compliance frameworks to emerging threats, we cover everything you need to know.",
    featuredSection: "Featured Content",
    guidesSection: "Implementation Guides",
    eventsSection: "Webinars & Events",
    caseStudiesSection: "Success Stories",
    trustSection: "Trust & Certification",
    readinessSection: "Assessment Tools",
    viewAll: "View All",
    latestPosts: "Latest Articles",
    categories: "Content Categories",
    subscribe: "Get Expert Insights",
    subscribeText: "Join 10,000+ security professionals getting weekly insights",
    emailPlaceholder: "Enter your email address",
    subscribeButton: "Subscribe Now"
  },
  fi: {
    title: "Blogi ja oppaat",
    subtitle: "Asiantuntijanäkemyksiä, käytännön oppaita ja toimialaresursseja",
    description: "Pysy kyberturvallisuustrendien kärjessä asiantuntijanäkemyksillemme, kattavilla toteutusoppaillamme ja käytännön resursseilla. Compliance-kehikoista nouseviin uhkiin - käsittelemme kaiken mitä tarvitset.",
    featuredSection: "Suositeltu sisältö",
    guidesSection: "Toteutusoppaat",
    eventsSection: "Webinaarit ja tapahtumat",
    caseStudiesSection: "Menestystarinat",
    trustSection: "Luottamus ja sertifiointi",
    readinessSection: "Arviointityökalut",
    viewAll: "Katso kaikki",
    latestPosts: "Uusimmat artikkelit",
    categories: "Sisältökategoriat",
    subscribe: "Saa asiantuntijanäkemyksiä",
    subscribeText: "Liity 10 000+ turvallisuusasiantuntijan joukkoon - viikoittaiset oivallukset",
    emailPlaceholder: "Syötä sähköpostiosoitteesi",
    subscribeButton: "Tilaa nyt"
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

const blogCategories = [
  {
    icon: 'book',
    titleFi: 'Toteutusoppaat',
    titleEn: 'Implementation Guides',
    descFi: 'Yksityiskohtaiset, vaiheittaiset oppaat compliance-kehikoiden toteutukseen',
    descEn: 'Detailed, step-by-step guides for implementing compliance frameworks',
    href: '/blog/guides-and-templates',
    countFi: '25+ opasta',
    countEn: '25+ guides',
    color: 'blue'
  },
  {
    icon: 'users',
    titleFi: 'Webinaarit ja tapahtumat',
    titleEn: 'Webinars & Events',
    descFi: 'Asiantuntijawebinaarit, virtuaalitapahtumat ja koulutusmateriaalit',
    descEn: 'Expert webinars, virtual events and training materials',
    href: '/blog/webinars-and-events',
    countFi: 'Viikoittain',
    countEn: 'Weekly',
    color: 'green'
  },
  {
    icon: 'trending-up',
    titleFi: 'Menestystarinat',
    titleEn: 'Success Stories',
    descFi: 'Asiakastapaukset ja onnistuneet compliance-toteutukset',
    descEn: 'Customer cases and successful compliance implementations',
    href: '/blog/case-studies',
    countFi: '15+ tarinaa',
    countEn: '15+ stories',
    color: 'purple'
  },
  {
    icon: 'shield-check',
    titleFi: 'Luottamuskeskus',
    titleEn: 'Trust Center',
    descFi: 'Sertifioinnit, auditointiraportit ja turvallisuusperiaatteet',
    descEn: 'Certifications, audit reports and security principles',
    href: '/blog/trust-center',
    countFi: 'Reaaliaikainen',
    countEn: 'Real-time',
    color: 'indigo'
  },
  {
    icon: 'check-circle',
    titleFi: 'Valmiusarvioinnit',
    titleEn: 'Readiness Assessments',
    descFi: 'Ilmaiset itsearviointityökalut ja valmiuskartoitukset',
    descEn: 'Free self-assessment tools and readiness evaluations',
    href: '/blog/readiness-checks',
    countFi: '10+ työkalua',
    countEn: '10+ tools',
    color: 'orange'
  }
];

const featuredArticles = [
  {
    titleFi: 'NIS2-direktiivi: Suomen toteutus ja vaikutukset',
    titleEn: 'NIS2 Directive: Finland Implementation and Impact',
    descFi: 'Kattava analyysi NIS2-direktiivin kansallisesta toimeenpanosta ja vaikutuksista suomalaisiin yrityksiin',
    descEn: 'Comprehensive analysis of NIS2 directive national implementation and impact on Finnish companies',
    author: 'DataNova Team',
    date: '2024-12-15',
    readTime: '8 min',
    category: 'Regulation',
    href: '/regulatory/nis2-finland'
  },
  {
    titleFi: 'ISO 27001:2022 - Mitä muuttui ja miten valmistautua',
    titleEn: 'ISO 27001:2022 - What Changed and How to Prepare',
    descFi: 'Yksityiskohtainen vertailu vanhan ja uuden version välillä sekä käytännön neuvoja siirtymiseen',
    descEn: 'Detailed comparison between old and new versions plus practical advice for transition',
    author: 'Security Expert',
    date: '2024-12-10',
    readTime: '12 min',
    category: 'Standards',
    href: '/frameworks/iso-27001'
  },
  {
    titleFi: 'DORA-säännöstö: Digitaalinen resilienssisääntely rahoitusalalla',
    titleEn: 'DORA Regulation: Digital Operational Resilience in Finance',
    descFi: 'Rahoitusalan digitaalisen operatiivisen kestävyyden säännöstön vaatimukset ja toteutus',
    descEn: 'Requirements and implementation of digital operational resilience regulation in finance',
    author: 'Compliance Specialist',
    date: '2024-12-05',
    readTime: '10 min',
    category: 'Finance',
    href: '/regulatory/dora'
  }
];

const stats = [
  { valueFi: '10k+', valueEn: '10k+', labelFi: 'Kuukausittaista lukijaa', labelEn: 'Monthly readers' },
  { valueFi: '150+', valueEn: '150+', labelFi: 'Asiantuntija-artikkelia', labelEn: 'Expert articles' },
  { valueFi: '25+', valueEn: '25+', labelFi: 'Toteutusopasta', labelEn: 'Implementation guides' },
  { valueFi: '50+', valueEn: '50+', labelFi: 'Webinaaritaltiointia', labelEn: 'Webinar recordings' }
];
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.title}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.subtitle}
        </p>
        <p class="text-sm md:text-base text-slate-500 leading-relaxed max-w-3xl mx-auto mt-2">
          {currentContent.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-8 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-[#0EA5E9] mb-1">
              {isFi ? stat.valueFi : stat.valueEn}
            </div>
            <div class="text-slate-500 text-sm">
              {isFi ? stat.labelFi : stat.labelEn}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Articles Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.featuredSection}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {isFi 
            ? 'Uusimmat asiantuntija-artikkelit ja toteutusoppaat'
            : 'Latest expert articles and implementation guides'}
        </p>
      </div>

      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {featuredArticles.map((article) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex items-center justify-between mb-3">
              <span class="px-3 py-1 bg-[#0EA5E9] text-white rounded-full text-xs font-medium">
                {article.category}
              </span>
              <span class="text-xs text-slate-500">{article.readTime}</span>
            </div>
            <h3 class="text-base font-bold text-[#1E293B] mb-2 group-hover:text-[#22D3EE] transition-colors duration-300 line-clamp-2">
              {isFi ? article.titleFi : article.titleEn}
            </h3>
            <p class="text-xs text-slate-500 mb-4 group-hover:text-slate-600 transition-colors duration-300 flex-1 line-clamp-3">
              {isFi ? article.descFi : article.descEn}
            </p>
            <div class="flex items-center justify-between pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                  <Icon name="user" class="w-4 h-4 text-[#0EA5E9]" />
                </div>
                <div>
                  <div class="text-xs font-medium text-slate-900">{article.author}</div>
                  <div class="text-xs text-slate-400">{article.date}</div>
                </div>
              </div>
              <a href={article.href} class="text-[#1E293B] group-hover:text-[#22D3EE] text-xs font-semibold transition-colors duration-300">
                {isFi ? 'Lue lisää' : 'Read More'} →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Content Categories Section -->
  <section id="categories" class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.categories}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {isFi 
            ? 'Löydä sisältö kategorian mukaan - oppaista webinaareihin'
            : 'Find content by category - from guides to webinars'}
        </p>
      </div>

      <div class="max-w-5xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {blogCategories.map((category) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex justify-end mb-3">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0F172A] group-hover:to-[#0EA5E9] group-hover:shadow-lg">
                <Icon name={category.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-base font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300">
              {isFi ? category.titleFi : category.titleEn}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 flex-1">
              {isFi ? category.descFi : category.descEn}
            </p>
            <div class="text-xs text-[#0EA5E9] font-semibold mb-3">
              {isFi ? category.countFi : category.countEn}
            </div>
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <a href={category.href} class="inline-flex items-center text-[#1E293B] group-hover:text-[#0EA5E9] font-semibold text-xs gap-1 transition-all duration-300">
                {isFi ? 'Tutustu sisältöön' : 'Explore Content'}
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Subscribe Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
        {currentContent.subscribe}
      </h2>
      <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed mb-6">
        {currentContent.subscribeText}
      </p>
      
      <form class="max-w-md mx-auto">
        <div class="flex flex-col sm:flex-row gap-3">
          <input 
            type="email" 
            placeholder={currentContent.emailPlaceholder}
            class="flex-1 px-4 py-3 border-2 border-slate-200 rounded-full focus:ring-2 focus:ring-[#0EA5E9] focus:border-[#0EA5E9] outline-none transition-all duration-300 text-sm"
            required
          />
          <a href="/contact" 
             class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] text-white rounded-full hover:from-[#22D3EE] hover:to-[#0EA5E9] transition-all duration-300 hover:shadow-xl font-medium text-sm">
            {currentContent.subscribeButton}
          </a>
        </div>
        <p class="text-xs text-slate-400 mt-3">
          {isFi 
            ? 'Ei roskapostia. Voit perua tilauksen milloin tahansa.'
            : 'No spam. You can unsubscribe at any time.'}
        </p>
      </form>
    </div>
  </section>

</Layout>