const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.title}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.subtitle}
        </p>
        <p class="text-sm md:text-base text-slate-500 leading-relaxed max-w-3xl mx-auto mt-2">
          {currentContent.heroDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- Security Practices Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.security.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.security.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.security.practices.map((practice) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group">
            <div class="flex items-center justify-between mb-2">
              <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={practice.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
              <span class="px-3 py-1 bg-[#2E6FBA]/20 text-[#2E6FBA] rounded-[2px] text-xs font-medium">{practice.status}</span>
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {practice.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
              {practice.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.compliance.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.compliance.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        {currentContent.compliance.certifications.map((cert) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex justify-end mb-2">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={cert.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-base font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {cert.name}
              </h3>
              <span class="px-3 py-1 bg-[#2E6FBA]/20 text-[#2E6FBA] rounded-[2px] text-xs font-medium">{cert.status}</span>
            </div>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300">
              {cert.description}
            </p>
            <div class="space-y-1 pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <div class="flex justify-between text-xs">
                <span class="text-slate-500">Valid until:</span>
                <span class="text-slate-700 font-medium">{cert.validUntil}</span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-slate-500">Scope:</span>
                <span class="text-slate-700 font-medium">{cert.scope}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Privacy Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.privacy.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.privacy.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.privacy.policies.map((policy) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group">
            <div class="flex justify-end mb-2">
              <div class="w-10 h-10 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={policy.icon} class="w-5 h-5 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {policy.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 flex-1">
              {policy.description}
            </p>
            <div class="mt-auto pt-2 border-t border-slate-100 text-xs text-[#003580] font-medium">
              {policy.compliance}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transparency Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.transparency.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.transparency.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        {currentContent.transparency.reports.map((report) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex justify-end mb-2">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={report.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {report.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 flex-1">
              {report.description}
            </p>
            <div class="flex justify-between text-xs pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <span class="text-slate-500">Frequency: <span class="text-slate-700 font-medium">{report.frequency}</span></span>
              <span class="text-slate-500">Updated: <span class="text-slate-700 font-medium">{report.lastUpdated}</span></span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governance Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.governance.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.governance.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        {currentContent.governance.framework.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex justify-end mb-2">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 flex-1">
              {item.description}
            </p>
            <div class="space-y-1 pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <div class="flex justify-between text-xs">
                <span class="text-slate-500">Frequency:</span>
                <span class="text-slate-700 font-medium">{item.frequency}</span>
              </div>
              <div class="flex justify-between text-xs">
                <span class="text-slate-500">Owner:</span>
                <span class="text-slate-700 font-medium">{item.owner}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.contact.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.contact.description}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {currentContent.contact.channels.map((channel) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center">
            <div class="flex justify-center mb-3">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={channel.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {channel.title}
            </h3>
            <div class="space-y-1 text-xs text-slate-500">
              <div>{channel.email}</div>
              <div>{channel.phone}</div>
              <div class="text-[#003580] font-medium">Response: {channel.response}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


</Layout>