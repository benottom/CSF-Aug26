      title: "Industry Solutions",
      description: "Explore case studies specific to your industry and compliance requirements.",
      sectors: [
        {
          name: "Financial Services",
          count: "12 case studies",
          icon: "building-library",
          description: "Banking, insurance, and fintech compliance solutions"
        },
        {
          name: "Healthcare",
