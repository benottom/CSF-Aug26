      description: "Hear directly from our clients about their experience and results.",
      quotes: [
        {
          quote: "CyberSecurity Finland transformed our cybersecurity posture completely. We achieved ISO 27001 certification in record time while building a sustainable security culture.",
          author: "Maria Lindström",
          title: "CISO",
          company: "Nordic Financial Group",
          rating: 5
        },
        {
          quote: "The team's expertise in GDPR compliance helped us navigate complex requirements and achieve full compliance across all our European operations.",
          author: "Dr. Thomas Weber",
          title: "Data Protection Officer",
          company: "European Healthcare Network",
          rating: 5
        },
        {
          quote: "Working with CyberSecurity Finland was a game-changer. Their SOC 2 preparation methodology was comprehensive and their ongoing support exceptional.",
          author: "Sarah Chen",
          title: "VP of Security",
