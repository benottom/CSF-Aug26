    industries: {
      title: "Toimialaratkaisut",
      description: "Tutustu toimialasi ja yhteensopivuusvaatimustesi mukaisiin tapaustutkimuksiin.",
      sectors: [
        {
          name: "Rahoituspalvelut",
          count: "12 tapaustutkimusta",
          icon: "building-library",
          description: "Pankkitoiminta, vakuutus ja fintech-yhteensopivuusratkaisut"
        },
        {
          name: "Terveydenhuolto",
          count: "8 tapaustutkimusta",
          icon: "heart",
          description: "HIPAA, GDPR ja terveydenhuollon turvallisuustoteutukset"
        },
        {
          name: "Valmistus",
          count: "15 tapaustutkimusta",
          icon: "cog",
          description: "Teollinen kyberturvallisuus ja toimitusketjun turvallisuus"
        },
        {
          name: "Teknologia",
          count: "20 tapaustutkimusta",
          icon: "computer",
          description: "SaaS, pilviturvallisuus ja ohjelmistokehitys"
        },
        {
          name: "Vähittäiskauppa",
          count: "10 tapaustutkimusta",
          icon: "shopping-bag",
          description: "E-kaupan turvallisuus ja PCI DSS -yhteensopivuus"
        },
        {
          name: "Julkishallinto",
          count: "6 tapaustutkimusta",
          icon: "building",
          description: "Julkisen sektorin kyberturvallisuus ja yhteensopivuus"
        }
      ]
    },
    methodologies: {
      title: "Toteutusmetodologiat",
      description: "Lue todistetuista lähestymistavoista, jotka tuottavat menestyksekkäitä tuloksia.",
      approaches: [
        {
          title: "Nopea toteutus",
          description: "Nopeutettu käyttöönotto kiireellisiin yhteensopivuustarpeisiin",
          duration: "3-6 kuukautta",
          bestFor: "Organisaatiot, joilla on välittömiä yhteensopivuusajoja",
          successRate: "95%"
        },
        {
          title: "Vaiheittainen käyttöönotto",
          description: "Asteittainen toteutus useissa osastoissa",
          duration: "6-18 kuukautta",
          bestFor: "Suuret organisaatiot monimutkaisilla infrastruktuureilla",
          successRate: "98%"
        },
        {
          title: "Mukautettu kehitys",
          description: "Räätälöidyt ratkaisut ainutlaatuisiin organisaatiovaatimukset",
          duration: "6-24 kuukautta",
          bestFor: "Organisaatiot, joilla on erityisiä yhteensopivuustarpeita",
          successRate: "92%"
        }
      ]
    },
    testimonials: {
      title: "Asiakkaiden suositukset",
      description: "Kuule suoraan asiakkailtamme heidän kokemuksestaan ja tuloksistaan.",
      quotes: [
        {
          quote: "CyberSecurity Finland muutti kyberturvallisuustilamme täysin. Saavutimme ISO 27001 -sertifioinnin ennätysajassa samalla kun rakensimme kestävän turvallisuuskulttuurin.",
          author: "Maria Lindström",
          title: "CISO",
          company: "Pohjoismainen rahoitusryhmä",
          rating: 5
        },
        {
          quote: "Tiimin GDPR-yhteensopivuuden asiantuntemus auttoi meitä navigoimaan monimutkaisissa vaatimuksissa ja saavuttamaan täyden yhteensopivuuden kaikissa eurooppalaisissa toimissamme.",
          author: "Dr. Thomas Weber",
          title: "Tietosuojavastaava",
          company: "Eurooppalainen terveydenhuoltoverkosto",
          rating: 5
        },
        {
          quote: "CyberSecurity Finlandin kanssa työskentely oli mullistavaa. Heidän SOC 2 -valmistelumetodologiansa oli kattava ja jatkuva tuki erinomaista.",
          author: "Sarah Chen",
          title: "Turvallisuuden VP",
          company: "TechFlow Solutions",
          rating: 5
        }
      ]
    },
    download: {
      title: "Lataa tapaustutkimukset",
      description: "Käytä yksityiskohtaisia tapaustutkimuksia ja toteutusoppaita kyberturvallisuusaloitteidesi tukemiseen.",
      resources: [
        {
          title: "Kattava tapaustutkimuskokoelma",
          description: "Kaikki tapaustutkimukset yhdessä kattavassa dokumentissa",
          format: "PDF",
          size: "15.2 MB",
          download: "Lataa kaikki"
        },
        {
          title: "Toteutusopas",
          description: "Vaiheittainen opas menestyksekkäiden toteutusten perusteella",
          format: "PDF",
          size: "8.7 MB",
          download: "Lataa opas"
        },
        {
          title: "ROI-laskuri",
          description: "Interaktiivinen työkalu turvallisuussijoitusten mahdollisten tuottojen laskemiseen",
          format: "Excel",
          size: "2.1 MB",
          download: "Lataa työkalu"
        }
      ]
    },
    cta: {
      title: "Valmiit aloittamaan menestystarinasi?",
      subtitle: "Keskustellaan siitä, miten voimme auttaa sinua saavuttamaan samankaltaisia tuloksia organisaatiossasi.",
      button: "Aikatauluta konsultaatio",
      link: "/contact"
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.title}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.subtitle}
        </p>
        <p class="text-sm md:text-base text-slate-500 leading-relaxed max-w-3xl mx-auto mt-2">
          {currentContent.heroDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Case Studies Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.featured.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.featured.description}
        </p>
      </div>
      
      <div class="space-y-8">
        {currentContent.featured.studies.map((study, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 md:p-8 hover:shadow-xl transition-all duration-300">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="bg-[#003580] text-white px-3 py-1 rounded-[2px] text-xs font-medium">{study.industry}</span>
            </div>
            <h3 class="text-xl font-bold text-[#131c2e] mb-4">{study.title}</h3>
            
            <div class="grid md:grid-cols-2 gap-8">
              <div>
                <div class="mb-4">
                  <h4 class="text-sm font-semibold text-[#14171a] mb-1">Challenge:</h4>
                  <p class="text-sm text-slate-600">{study.challenge}</p>
                </div>
                <div class="mb-4">
                  <h4 class="text-sm font-semibold text-[#14171a] mb-1">Solution:</h4>
                  <p class="text-sm text-slate-600">{study.solution}</p>
                </div>
                <div>
                  <h4 class="text-sm font-semibold text-[#14171a] mb-1">Results:</h4>
                  <ul class="space-y-1">
                    {study.results.map((result) => (
                      <li class="flex items-center text-sm text-slate-600">
                        <svg class="w-4 h-4 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        {result}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              
              <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
                <h4 class="text-sm font-semibold text-[#14171a] mb-4 text-center">Key Metrics</h4>
                <div class="grid grid-cols-3 gap-4">
                  <div class="text-center">
                    <div class="text-2xl font-bold text-[#003580] mb-1">{study.metrics.timeline}</div>
                    <div class="text-xs text-slate-500">Timeline</div>
                  </div>
                  <div class="text-center">
                    <div class="text-2xl font-bold text-green-600 mb-1">{study.metrics.improvement}</div>
                    <div class="text-xs text-slate-500">Improvement</div>
                  </div>
                  <div class="text-center">
                    <div class="text-lg font-bold text-[#131c2e] mb-1">{study.metrics.certification}</div>
                    <div class="text-xs text-slate-500">Certification</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Solutions Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.industries.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industries.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.industries.sectors.map((sector) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex justify-end mb-3">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name={sector.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {sector.name}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300">
              {sector.description}
            </p>
            <div class="mt-auto pt-2 border-t border-slate-100 text-xs text-[#003580] font-semibold">
              {sector.count}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Methodologies Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.methodologies.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.methodologies.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {currentContent.methodologies.approaches.map((approach) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center">
            <div class="flex justify-center mb-3">
              <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name="shield-check" class="w-6 h-6 text-green-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {approach.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300">
              {approach.description}
            </p>
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 space-y-1 text-xs">
              <div><span class="font-semibold text-[#14171a]">Duration:</span> <span class="text-slate-500">{approach.duration}</span></div>
              <div><span class="font-semibold text-[#14171a]">Best for:</span> <span class="text-slate-500">{approach.bestFor}</span></div>
              <div><span class="font-semibold text-[#14171a]">Success Rate:</span> <span class="text-green-600 font-bold">{approach.successRate}</span></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.testimonials.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.testimonials.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {currentContent.testimonials.quotes.map((testimonial) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group">
            <div class="flex items-center mb-3">
              {[...Array(testimonial.rating)].map((_, i) => (
                <svg key={i} class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>
            <blockquote class="text-sm text-slate-600 mb-4 italic flex-1">"{testimonial.quote}"</blockquote>
            <div class="pt-3 border-t border-slate-100">
              <div class="text-sm font-semibold text-[#14171a]">{testimonial.author}</div>
              <div class="text-xs text-slate-500">{testimonial.title}</div>
              <div class="text-xs text-[#003580]">{testimonial.company}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Download Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.download.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.download.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {currentContent.download.resources.map((resource) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center">
            <div class="flex justify-center mb-3">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                          transition-all duration-300
                          group-hover:bg-[#131c2e] group-hover:shadow-lg">
                <Icon name="document" class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {resource.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300">
              {resource.description}
            </p>
            <div class="text-xs text-slate-400 mb-3">
              {resource.format} • {resource.size}
            </div>
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <Button variant="brand" className="w-full text-sm py-2">
                {resource.download}
              </Button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 md:py-16 bg-[#131c2e]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">
        {currentContent.cta.title}
      </h2>
      <p class="text-base text-blue-100 mb-6 max-w-2xl mx-auto">
        {currentContent.cta.subtitle}
      </p>
      <a href={currentContent.cta.link} class="inline-block bg-white text-[#131c2e] font-semibold py-3 px-8 rounded-[2px] hover:bg-slate-100 transition duration-300 shadow-lg hover:shadow-xl">
        {currentContent.cta.button}
      </a>
    </div>
  </section>

</Layout>