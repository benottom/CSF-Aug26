    download: {
      title: "Download Case Studies",
      description: "Access detailed case studies and implementation guides to support your cybersecurity initiatives.",
      resources: [
        {
          title: "Complete Case Study Collection",
          description: "All case studies in one comprehensive document",
          format: "PDF",
          size: "15.2 MB",
