          metrics: {
            timeline: "6 kuukautta",
            improvement: "40%",
            certification: "ISO 27001:2022"
          }
        },
        {
          title: "Terveydenhuoltopalveluntarjoaja: GDPR-yhteensopivuuden muutos",
          industry: "Terveydenhuolto",
