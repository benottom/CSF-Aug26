---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const title = "Guides and Templates";
const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Oppaat ja mallit" : "Guides and Templates",
  description: lang === 'fi'
    ? "Kattava kokoelma kyberturvallisuusoppaita, yhteensopivuusmalleja ja parhaiden käytäntöjen resursseja."
    : "Comprehensive collection of cybersecurity guides, compliance templates, and best practice resources.",
  type: "page" as const,
};

const content = {
  en: {
    title: "Guides and Templates",
    subtitle: "Expert Resources for Cybersecurity Success",
    heroDescription: "Access our comprehensive collection of cybersecurity guides, compliance templates, and best practice resources to accelerate your security journey.",
    guides: {
      title: "Cybersecurity Guides",
      description: "Step-by-step guides covering essential cybersecurity topics and compliance requirements.",
      iso27001: {
        title: "ISO 27001 Implementation Guide",
        description: "Complete roadmap for implementing ISO 27001 Information Security Management System",
        duration: "45 min read",
        level: "Intermediate",
        tags: ["ISO 27001", "Information Security", "Compliance"]
      },
      gdpr: {
        title: "GDPR Compliance Guide",
        description: "Essential steps to achieve and maintain GDPR compliance in your organization",
        duration: "30 min read",
        level: "Beginner",
        tags: ["GDPR", "Data Protection", "Privacy"]
      },
      soc2: {
        title: "SOC 2 Type II Preparation",
        description: "Comprehensive guide to preparing for SOC 2 Type II certification audit",
        duration: "60 min read",
        level: "Advanced",
        tags: ["SOC 2", "Audit", "Trust Services"]
      },
      dora: {
        title: "DORA Compliance Framework",
        description: "Understanding and implementing the Digital Operational Resilience Act requirements",
        duration: "40 min read",
        level: "Intermediate",
        tags: ["DORA", "Financial Services", "Resilience"]
      }
    },
    templates: {
      title: "Ready-to-Use Templates",
      description: "Downloadable templates and checklists to streamline your compliance processes.",
      policies: {
        title: "Security Policy Templates",
        description: "Comprehensive security policy templates for various organizational needs",
        items: ["Information Security Policy", "Acceptable Use Policy", "Incident Response Policy", "Data Classification Policy"]
      },
      checklists: {
        title: "Compliance Checklists",
        description: "Detailed checklists for various compliance frameworks and audits",
        items: ["ISO 27001 Gap Analysis", "GDPR Assessment", "SOC 2 Readiness", "Vendor Security Assessment"]
      },
      procedures: {
        title: "Standard Operating Procedures",
        description: "Step-by-step procedures for common security operations",
        items: ["Security Incident Response", "Access Management", "Change Management", "Risk Assessment"]
      }
    },
    resources: {
      title: "Additional Resources",
      description: "Tools, calculators, and interactive resources to support your cybersecurity initiatives.",
      tools: [
        {
          title: "Risk Assessment Calculator",
          description: "Interactive tool to assess and quantify cybersecurity risks",
          icon: "chart"
        },
        {
          title: "Compliance Timeline Planner",
          description: "Customizable timeline for compliance project planning",
          icon: "calendar"
        },
        {
          title: "Security Maturity Assessment",
          description: "Self-assessment tool to evaluate your security posture",
          icon: "trending-up"
        },
        {
          title: "Vendor Security Questionnaire",
          description: "Comprehensive questionnaire for third-party security assessments",
          icon: "clipboard"
        }
      ]
    },
    featured: {
      title: "Featured Resources",
      description: "Our most popular and recently updated guides and templates.",
      items: [
        {
          title: "Cybersecurity Maturity Model",
          description: "Framework for assessing and improving your organization's security posture",
          category: "Framework",
          updated: "2 weeks ago"
        },
        {
          title: "Incident Response Playbook",
          description: "Comprehensive playbook for handling security incidents effectively",
          category: "Response",
          updated: "1 month ago"
        },
        {
          title: "Compliance Roadmap Template",
          description: "Visual roadmap template for planning compliance initiatives",
          category: "Planning",
          updated: "3 weeks ago"
        }
      ]
    }
  },
  fi: {
    title: "Oppaat ja mallit",
    subtitle: "Asiantuntevat resurssit kyberturvallisuuden menestykseen",
    heroDescription: "Käytä kattavaa kokoelmaamme kyberturvallisuusoppaita, yhteensopivuusmalleja ja parhaiden käytäntöjen resursseja nopeuttaaksesi turvallisuusmatkaasi.",
    guides: {
      title: "Kyberturvallisuusoppaat",
      description: "Vaiheittaiset oppaat, jotka kattavat tärkeimmät kyberturvallisuusaiheet ja yhteensopivuusvaatimukset.",
      iso27001: {
        title: "ISO 27001 -toteutusopas",
        description: "Täydellinen tiekartta ISO 27001 tietoturvajohtamisjärjestelmän toteuttamiseen",
        duration: "45 min lukuaika",
        level: "Keskitaso",
        tags: ["ISO 27001", "Tietoturva", "Yhteensopivuus"]
      },
      gdpr: {
        title: "GDPR-yhteensopivuusopas",
        description: "Olennaiset vaiheet GDPR-yhteensopivuuden saavuttamiseen ja ylläpitämiseen organisaatiossasi",
        duration: "30 min lukuaika",
        level: "Aloittelija",
        tags: ["GDPR", "Tietosuoja", "Yksityisyys"]
      },
      soc2: {
        title: "SOC 2 Type II -valmistelu",
        description: "Kattava opas SOC 2 Type II -sertifiointitarkastuksen valmisteluun",
        duration: "60 min lukuaika",
        level: "Edistynyt",
        tags: ["SOC 2", "Tarkastus", "Luottamuspalvelut"]
      },
      dora: {
        title: "DORA-yhteensopivuuskehys",
        description: "Digital Operational Resilience Act -vaatimusten ymmärtäminen ja toteuttaminen",
        duration: "40 min lukuaika",
        level: "Keskitaso",
        tags: ["DORA", "Rahoituspalvelut", "Resilienssi"]
      }
    },
    templates: {
      title: "Käyttövalmiit mallit",
      description: "Ladattavat mallit ja tarkistuslistat yhteensopivuusprosessien sujuvoittamiseen.",
      policies: {
        title: "Turvallisuuspolitiikkamallit",
        description: "Kattavat turvallisuuspolitiikkamallit erilaisiin organisaatiotarpeisiin",
        items: ["Tietoturvapolitiikka", "Hyväksyttävä käyttöpolitiikka", "Tapahtumavastauspolitiikka", "Tietojen luokittelupolitiikka"]
      },
      checklists: {
        title: "Yhteensopivuustarkistuslistat",
        description: "Yksityiskohtaiset tarkistuslistat erilaisille yhteensopivuuskehyksille ja tarkistuksille",
        items: ["ISO 27001 -kuiluanalyysi", "GDPR-arviointi", "SOC 2 -valmius", "Toimittajan turvallisuusarviointi"]
      },
      procedures: {
        title: "Vakiokäyttömenettelyt",
        description: "Vaiheittaiset menettelyt yleisille turvallisuustoiminnoille",
        items: ["Turvallisuustapahtumavastaus", "Käyttöoikeuksien hallinta", "Muutosten hallinta", "Riskien arviointi"]
      }
    },
    resources: {
      title: "Lisäresurssit",
      description: "Työkalut, laskurit ja interaktiiviset resurssit kyberturvallisuusaloitteidesi tukemiseen.",
      tools: [
        {
          title: "Riskien arviointilaskuri",
          description: "Interaktiivinen työkalu kyberturvallisuusriskien arviointiin ja mittaamiseen",
          icon: "chart"
        },
        {
          title: "Yhteensopivuusajastinsuunnittelija",
          description: "Mukautettava ajastin yhteensopivuusprojektien suunnitteluun",
          icon: "calendar"
        },
        {
          title: "Turvallisuuden kypsyysarviointi",
          description: "Itsearviointityökalu turvallisuustilan arviointiin",
          icon: "trending-up"
        },
        {
          title: "Toimittajan turvallisuuskysely",
          description: "Kattava kysely kolmannen osapuolen turvallisuusarviointeihin",
          icon: "clipboard"
        }
      ]
    },
    featured: {
      title: "Suositellut resurssit",
      description: "Suosituimmat ja hiljattain päivitetyt oppaat ja mallit.",
      items: [
        {
          title: "Kyberturvallisuuden kypsyysmalli",
          description: "Kehys organisaatiosi turvallisuustilan arviointiin ja parantamiseen",
          category: "Kehys",
          updated: "2 viikkoa sitten"
        },
        {
          title: "Tapahtumavastauskäsikirja",
          description: "Kattava käsikirja turvallisuustapahtumien tehokkaaseen käsittelyyn",
          category: "Vastaus",
          updated: "1 kuukausi sitten"
        },
        {
          title: "Yhteensopivuustiekarttamalli",
          description: "Visuaalinen tiekarttamalli yhteensopivuusaloitteiden suunnitteluun",
          category: "Suunnittelu",
          updated: "3 viikkoa sitten"
        }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- Guides Section -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.guides.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.guides.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
        {[currentContent.guides.iso27001, currentContent.guides.gdpr, currentContent.guides.soc2, currentContent.guides.dora].map((guide) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center justify-between mb-3 relative z-10">
              <span class="px-3 py-1 bg-[#003580] text-white rounded-[2px] text-xs font-medium">{guide.level}</span>
              <span class="text-xs text-slate-500">{guide.duration}</span>
            </div>
            <h3 class="text-base font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {guide.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 flex-1 relative z-10">
              {guide.description}
            </p>
            <div class="flex flex-wrap gap-1.5 pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              {guide.tags.map((tag) => (
                <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-xs">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Templates Section -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.templates.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.templates.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {[
          { key: 'policies', title: currentContent.templates.policies.title, description: currentContent.templates.policies.description, items: currentContent.templates.policies.items, icon: 'document' },
          { key: 'checklists', title: currentContent.templates.checklists.title, description: currentContent.templates.checklists.description, items: currentContent.templates.checklists.items, icon: 'clipboard-check' },
          { key: 'procedures', title: currentContent.templates.procedures.title, description: currentContent.templates.procedures.description, items: currentContent.templates.procedures.items, icon: 'cog' }
        ].map((template) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={template.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {template.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {template.description}
            </p>
            <ul class="space-y-1 mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              {template.items.map((item) => (
                <li class="flex items-center text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Additional Resources Section -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.resources.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.resources.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-4 gap-6">
        {currentContent.resources.tools.map((tool) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={tool.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {tool.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {tool.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Resources Section -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.featured.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.featured.description}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
        {currentContent.featured.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center justify-between mb-3 relative z-10">
              <span class="px-3 py-1 bg-[#003580] text-white rounded-[2px] text-xs font-medium">{item.category}</span>
              <span class="text-xs text-slate-500">{item.updated}</span>
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>