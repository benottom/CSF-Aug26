---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const title = lang === 'fi' ? 'Tuki ja työkalut' : 'Support & Tools';
const description = lang === 'fi' 
  ? 'Kattava valikoima tukipalveluja, työkaluja ja resursseja. Ilmaiset mallit, tarkistuslistat ja asiantuntijatuki.'
  : 'Comprehensive range of support services, tools and resources. Free templates, checklists and expert support.';

const supportCategories = [
  {
    icon: 'book',
    titleFi: 'Tietopankki',
    titleEn: 'Knowledge Base',
    descFi: 'Kattava dokumentaatio, ohjeet ja usein kysytyt kysymykset',
    descEn: 'Comprehensive documentation, guides and frequently asked questions',
    href: '/support/knowledge-base',
    features: [
      { fi: 'Asennusoppaat', en: 'Installation guides' },
      { fi: 'Ongelmanratkaisu', en: 'Troubleshooting' },
      { fi: 'Usein kysytyt kysymykset', en: 'Frequently asked questions' },
      { fi: 'Video-ohjeet', en: 'Video tutorials' }
    ]
  }
];

const supportChannels = [
  {
    icon: 'mail',
    titleFi: 'Sähköpostituki',
    titleEn: 'Email Support',
    descFi: 'Yksityiskohtainen apu ja dokumentaatio sähköpostitse',
    descEn: 'Detailed help and documentation via email',
    availability: 'info@cybersecurity.fi'
  },
  {
    icon: 'phone',
    titleFi: 'Puhelintuki',
    titleEn: 'Phone Support',
    descFi: 'Suora yhteys tiimiimme',
    descEn: 'Direct connection to our team',
    availability: '+358 44 5040308'
  }
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="bg-[#f4f1ea] py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <div class="inline-flex items-center px-4 py-2 bg-[#E6EEF8] text-[#002D6C] rounded-[2px] text-sm font-medium mb-6">
          <Icon name="headphones" class="w-4 h-4 mr-2" />
          {lang === 'fi' ? 'Tuki ja työkalut' : 'Support & Tools'}
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
          {lang === 'fi' ? 'Saa apua' : 'Get Help'}
        </h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto mb-8">
          {lang === 'fi'
            ? 'Kysymyksiä palveluistamme tai compliance-työstäsi? Ota yhteyttä tai tutustu tietopankkiimme.'
            : 'Questions about our services or your compliance work? Get in touch, or browse our knowledge base.'
          }
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/contact" variant="primary">
            {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Support'}
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Categories -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {lang === 'fi' ? 'Tukipalvelut' : 'Support Services'}
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          {lang === 'fi' 
            ? 'Löydä oikea tukimuoto tarpeisiisi - dokumentaatiosta henkilökohtaiseen neuvontaan'
            : 'Find the right type of support for your needs - from documentation to personal consultation'
          }
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {supportCategories.map((category) => (
          <div class="bg-gray-50 rounded-lg p-8">
            <div class="w-12 h-12 bg-[#E6EEF8] rounded-lg flex items-center justify-center mb-6">
              <Icon name={category.icon} class="w-6 h-6 text-[#003580]" />
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-3">
              {lang === 'fi' ? category.titleFi : category.titleEn}
            </h3>
            <p class="text-gray-600 mb-6">
              {lang === 'fi' ? category.descFi : category.descEn}
            </p>
            
            <ul class="space-y-2 mb-6">
              {category.features.map((feature) => (
                <li class="flex items-start text-sm text-gray-600">
                  <Icon name="check" class="w-4 h-4 text-green-500 mr-2 mt-0.5 flex-shrink-0" />
                  {lang === 'fi' ? feature.fi : feature.en}
                </li>
              ))}
            </ul>
            
            <Button href={category.href} variant="secondary" className="w-full">
              {lang === 'fi' ? 'Tutustu sisältöön' : 'Explore Content'}
            </Button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Support Channels -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          {lang === 'fi' ? 'Tukikanavat' : 'Support Channels'}
        </h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          {lang === 'fi' 
            ? 'Valitse sinulle sopivin tapa ottaa yhteyttä asiantuntijoihimme'
            : 'Choose the most suitable way to contact our experts'
          }
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {supportChannels.map((channel) => (
          <div class="bg-white rounded-lg p-6 text-center shadow-lg hover:shadow-xl transition-shadow">
            <div class="w-16 h-16 bg-[#14171a] rounded-lg flex items-center justify-center mx-auto mb-4">
              <Icon name={channel.icon} class="w-8 h-8 text-white" />
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              {lang === 'fi' ? channel.titleFi : channel.titleEn}
            </h3>
            <p class="text-gray-600 text-sm mb-4">
              {lang === 'fi' ? channel.descFi : channel.descEn}
            </p>
            <p class="font-medium text-[#003580] text-sm">{channel.availability}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-[#131c2e]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">
        {lang === 'fi' ? 'Tarvitsetko henkilökohtaista apua?' : 'Need Personal Help?'}
      </h2>
      <p class="text-xl text-[#eef1f5] mb-8">
        {lang === 'fi'
          ? 'Ota yhteyttä asiantuntijoihimme saadaksesi räätälöityä tukea ja neuvontaa.'
          : 'Contact our experts to get tailored support and consultation.'
        }
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contact" variant="white">
          {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
        </Button>
      </div>
    </div>
  </section>
</Layout>
