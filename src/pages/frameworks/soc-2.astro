---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "SOC 2 Trust Service Excellence Framework | SOC 2 Type I & Type II Compliance",
  description: "Comprehensive SOC 2 Type I and Type II compliance for SaaS, cloud, and technology companies. Achieve SOC 2 certification with our expert guidance.",
  keywords: "SOC 2, SOC 2 Type II, trust service criteria, SaaS compliance, cloud security, Finland",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "SOC 2",
      subtitle: "Trust Service Excellence Framework",
      description: "Cybersecurity.fi specializes in SOC 2 compliance preparation, helping Finnish and Nordic technology organizations achieve certification across all Trust Service Criteria while building customer confidence through demonstrated security, availability, processing integrity, confidentiality, and privacy excellence.",
      primaryCTA: { text: "Start SOC 2 Compliance Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/soc-2" }
    },
    forWho: "For SaaS, cloud, and technology companies seeking SOC 2 Type I and Type II certification.",
    achieve: "SOC 2 Type II certification with comprehensive trust service criteria compliance and customer confidence.",
    overview: {
      title: "Overview",
      description: "SOC 2 is a compliance framework developed by the American Institute of CPAs (AICPA) that specifies how service organizations should manage customer data. It's based on five Trust Service Criteria: Security, Availability, Processing Integrity, Confidentiality, and Privacy.",
      highlight: "Our expert team provides comprehensive SOC 2 preparation and implementation support, guiding your organization through Type I and Type II certification while building customer confidence and competitive advantage."
    },
    benefits: {
      title: "Why Choose Our SOC 2 Services",
      subtitle: "We deliver SOC 2 Type II certification with Nordic market expertise, ensuring your service organization controls meet both international standards and local business requirements.",
      items: [
        { title: "Customer Trust Acceleration", description: "Build immediate credibility with enterprise customers requiring SOC 2 certification, accelerating sales cycles and enabling access to larger deals and enterprise markets.", icon: "target" },
        { title: "Competitive Differentiation", description: "Distinguish your organization from competitors through independently verified security and privacy controls, creating sustainable competitive advantage in B2B markets.", icon: "rocket" },
        { title: "Comprehensive Control Framework", description: "Implement robust, auditor-approved control framework covering all five Trust Service Criteria with customization for your specific business model and risk profile.", icon: "shield" },
        { title: "Accelerated Implementation", description: "Achieve SOC 2 Type I readiness in 12 weeks and Type II certification within 15 months using our proven methodology and expert guidance.", icon: "lightning" },
        { title: "Nordic Market Expertise", description: "Deep understanding of Nordic business practices, GDPR alignment, and cultural considerations for seamless SOC 2 implementation in European markets.", icon: "globe" },
        { title: "Auditor Partnership Program", description: "Direct collaboration with accredited SOC 2 auditors and streamlined audit process to ensure smooth certification and cost-effective compliance journey.", icon: "handshake" }
      ]
    },
    criteria: {
      title: "SOC 2 Trust Service Criteria",
      subtitle: "Our SOC 2 preparation covers all five trust service criteria, ensuring comprehensive compliance and customer confidence.",
      items: [
        { title: "Security (Mandatory)", description: "Protection against unauthorized access, use, disclosure, disruption, modification, or destruction of information and systems", icon: "lock-closed", auditFocus: "64 common criteria controls", controls: ["Logical and physical access controls with MFA", "Network security controls and perimeter protection", "Vulnerability management and penetration testing", "Security monitoring and incident response", "Change management and SDLC controls"] },
        { title: "Availability (Optional)", description: "Systems, products, and services are available for operation and use as committed or agreed", icon: "clock", auditFocus: "13 additional controls", controls: ["Business continuity and disaster recovery testing", "Capacity management and performance monitoring", "Redundancy and failover mechanisms", "Service level monitoring and escalation", "Preventive maintenance capabilities"] },
        { title: "Processing Integrity (Optional)", description: "System processing is complete, valid, accurate, timely, and authorized", icon: "check-circle", auditFocus: "11 additional controls", controls: ["Data validation and input controls", "Processing controls and quality assurance", "Error handling and exception management", "Data accuracy monitoring and correction", "Authorized processing controls"] },
        { title: "Confidentiality (Optional)", description: "Information designated as confidential is protected as committed or agreed", icon: "eye-slash", auditFocus: "8 additional controls", controls: ["Data classification and labeling systems", "Encryption and data protection technologies", "Access restrictions and need-to-know", "Confidentiality agreements management", "Secure disposal and data destruction"] },
        { title: "Privacy (Optional)", description: "Personal information is collected, used, retained, disclosed, and disposed of in conformity with privacy notice", icon: "shield-check", auditFocus: "19 additional controls", controls: ["Privacy policies and notice management", "Data subject rights management", "Cross-border data transfer controls", "Data retention and disposal policies", "Privacy impact assessments"] }
      ]
    },
    roadmap: {
      title: "12-Week Implementation Roadmap",
      subtitle: "Structured approach ensuring successful SOC 2 Type II preparation within 12 weeks while maintaining business operations.",
      items: [
        { phase: "Phase 1: Assessment & Planning", duration: "Weeks 1-3", activities: ["Gap Analysis", "Scope Definition", "Risk Assessment", "Control Selection"], deliverables: ["Gap Analysis Report", "Project Plan", "Risk Assessment", "Control Matrix"] },
        { phase: "Phase 2: Control Design", duration: "Weeks 4-6", activities: ["Control Documentation", "Policy Development", "Process Design", "Training Materials"], deliverables: ["Control Documentation", "Policy Suite", "Process Maps", "Training Program"] },
        { phase: "Phase 3: Implementation", duration: "Weeks 7-9", activities: ["Control Implementation", "Training Delivery", "Testing Procedures", "Evidence Collection"], deliverables: ["Implemented Controls", "Training Records", "Test Results", "Evidence Repository"] },
        { phase: "Phase 4: Pre-Audit & Certification", duration: "Weeks 10-12", activities: ["Internal Testing", "Remediation", "Auditor Preparation", "SOC 2 Report"], deliverables: ["SOC 2 Type II Report", "Control Effectiveness", "Audit Readiness", "Certification"] }
      ]
    },
    industries: {
      title: "Industry-Specific Success Stories",
      subtitle: "See how we've helped technology organizations across different industries achieve SOC 2 Type II certification.",
      items: [
        { industry: "SaaS Platform", challenge: "Demonstrating security controls for multi-tenant cloud platform serving EU customers", solution: "Comprehensive security framework with privacy-by-design controls and GDPR alignment", outcome: "SOC 2 Type II achieved in 10 weeks with enhanced customer trust" },
        { industry: "Fintech Solution", challenge: "Meeting financial services security requirements while preparing for SOC 2", solution: "Integrated approach combining FIN-FSA requirements with SOC 2 controls", outcome: "SOC 2 certification with regulatory compliance maintained" },
        { industry: "Healthcare Technology", challenge: "Protecting patient data under GDPR while implementing SOC 2 controls", solution: "Privacy-focused control framework with healthcare-specific security measures", outcome: "SOC 2 Type II with comprehensive data protection compliance" }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your cybersecurity posture with our complementary services and frameworks.",
      items: [
        { title: "ISO 27001 Implementation", description: "Information security management", href: "/frameworks/iso-27001" },
        { title: "GDPR Compliance", description: "Data protection and privacy", href: "/frameworks/gdpr" },
        { title: "Risk Assessment", description: "Comprehensive risk evaluation", href: "/frameworks/risk-assessments" },
        { title: "Policy Development", description: "Governance framework", href: "/frameworks/policy-development" }
      ]
    },
    cta: {
      title: "Ready to Achieve SOC 2 Type II Certification?",
      subtitle: "Join Finnish and Nordic technology organizations that have successfully achieved SOC 2 certification with our expert guidance. Let's discuss how we can help you build trust with your customers.",
      primaryCTA: { text: "Start Your SOC 2 Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/soc-2" }
    }
  },
  fi: {
    hero: {
      title: "SOC 2",
      subtitle: "Luottamuspalvelujen huippuosaamiskehys",
      description: "Cybersecurity.fi on erikoistunut SOC 2 -vaatimustenmukaisuuden valmisteluun auttaen suomalaisia ja pohjoismaisia teknologiayrityksiä saavuttamaan sertifioinnin kaikissa luottamuspalvelukriteereissä samalla kun rakennetaan asiakasluottamusta osoitetun turvallisuuden, saatavuuden, käsittelyn eheyden, luottamuksellisuuden ja yksityisyyden huippuosaamisen kautta.",
      primaryCTA: { text: "Aloita SOC 2 -vaatimustenmukaisuusmatka", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/soc-2" }
    },
    forWho: "SaaS-, pilvi- ja teknologiayrityksille, jotka tavoittelevat SOC 2 Type I ja Type II -sertifiointia.",
    achieve: "SOC 2 Type II -sertifiointi kattavalla luottamuspalvelukriteerien vaatimustenmukaisuudella ja asiakasluottamuksella.",
    overview: {
      title: "Yleiskatsaus",
      description: "SOC 2 on American Institute of CPAs (AICPA) kehittämä vaatimustenmukaisuuskehys, joka määrittelee, kuinka palveluorganisaatioiden tulisi hallita asiakastietoja. Se perustuu viiteen luottamuspalvelukriteeriin: Turvallisuus, Saatavuus, Käsittelyn eheys, Luottamuksellisuus ja Yksityisyys.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa SOC 2 -valmistelu- ja toteutustukea ohjaten organisaatiosi Type I ja Type II -sertifioinnin läpi samalla kun rakennat asiakasluottamusta ja kilpailuetua."
    },
    benefits: {
      title: "Miksi valita SOC 2 -palvelumme",
      subtitle: "Tarjoamme SOC 2 Type II -sertifioinnin Pohjoismaiden markkinaosaamisella varmistaen, että palveluorganisaatiosi kontrollit täyttävät sekä kansainväliset standardit että paikalliset liiketoimintavaatimukset.",
      items: [
        { title: "Asiakasluottamuksen nopeutus", description: "Rakenna välitöntä uskottavuutta SOC 2 -sertifiointia vaativien yritysasiakkaiden kanssa nopeuttaen myyntisyklejä ja mahdollistaen pääsyn suurempiin sopimuksiin ja yritysmarkkinoille.", icon: "target" },
        { title: "Kilpailullinen erottautuminen", description: "Erota organisaatiosi kilpailijoista riippumattomasti varmennettujen turvallisuus- ja tietosuojakontrollien avulla luoden kestävää kilpailuetua B2B-markkinoilla.", icon: "rocket" },
        { title: "Kattava kontrollikehys", description: "Toteuta vankka, auditoijan hyväksymä kontrollikehys, joka kattaa kaikki viisi luottamuspalvelukriteeriä räätälöitynä liiketoimintamallillesi ja riskiprofiilillesi.", icon: "shield" },
        { title: "Nopeutettu toteutus", description: "Saavuta SOC 2 Type I -valmius 12 viikossa ja Type II -sertifiointi 15 kuukauden kuluessa todistetulla metodologiallamme ja asiantuntijaohjauksellamme.", icon: "lightning" },
        { title: "Pohjoismaiden markkinaosaaminen", description: "Syvä ymmärrys pohjoismaisista liiketoimintakäytännöistä, GDPR-yhdenmukaisuudesta ja kulttuurisista näkökohdista saumattomaan SOC 2 -toteutukseen Euroopan markkinoilla.", icon: "globe" },
        { title: "Auditorin kumppanuusohjelma", description: "Suora yhteistyö akkreditoitujen SOC 2 -auditorien kanssa ja virtaviivaistettu auditointiprosessi varmistaakseen sujuvan sertifioinnin ja kustannustehokkaan vaatimustenmukaisuusmatkan.", icon: "handshake" }
      ]
    },
    criteria: {
      title: "SOC 2 -luottamuspalvelukriteerit",
      subtitle: "SOC 2 -valmistelumme kattaa kaikki viisi luottamuspalvelukriteeriä varmistaen kattavan vaatimustenmukaisuuden ja asiakasluottamuksen.",
      items: [
        { title: "Turvallisuus (Pakollinen)", description: "Suoja luvattomalta pääsyltä, käytöltä, luovuttamiselta, häiriöltä, muuttamiselta tai tietojen ja järjestelmien tuhoamiselta", icon: "lock-closed", auditFocus: "64 yleistä kriteerikontrollia", controls: ["Loogiset ja fyysiset pääsykontrollit MFA:lla", "Verkkoturvakontrollit ja reunan suoja", "Haavoittuvuuksien hallinta ja tunkeutumistestaus", "Turvallisuuden seuranta ja tapahtumien hallinta", "Muutosten hallinta ja SDLC-kontrollit"] },
        { title: "Saatavuus (Valinnainen)", description: "Järjestelmät, tuotteet ja palvelut ovat käytettävissä sitoutuneen mukaisesti", icon: "clock", auditFocus: "13 lisäkontrollia", controls: ["Liiketoiminnan jatkuvuus- ja katastrofipalautustestaus", "Kapasiteetinhallinta ja suorituskyvyn seuranta", "Redundanssi- ja vikasietomekanismit", "Palvelutason seuranta ja eskalointi", "Ennaltaehkäisevä ylläpito"] },
        { title: "Käsittelyn eheys (Valinnainen)", description: "Järjestelmän käsittely on täydellistä, pätevää, tarkkaa, oikea-aikaista ja valtuutettua", icon: "check-circle", auditFocus: "11 lisäkontrollia", controls: ["Datan validointi ja syöttökontrollit", "Käsittelykontrollit ja laadunvarmistus", "Virheiden käsittely ja poikkeusten hallinta", "Datan tarkkuuden seuranta ja korjaus", "Valtuutettu käsittelykontrollit"] },
        { title: "Luottamuksellisuus (Valinnainen)", description: "Luottamukselliseksi määritelty tieto suojataan sitoutuneen mukaisesti", icon: "eye-slash", auditFocus: "8 lisäkontrollia", controls: ["Datan luokittelu ja merkintäjärjestelmät", "Salaus- ja tietosuojateknologiat", "Käyttörajoitukset ja tarveperiaate", "Luottamuksellisuussopimusten hallinta", "Turvallinen hävittäminen"] },
        { title: "Yksityisyys (Valinnainen)", description: "Henkilötietoja kerätään, käytetään, säilytetään, luovutetaan ja hävitetään tietosuojailmoituksen mukaisesti", icon: "shield-check", auditFocus: "19 lisäkontrollia", controls: ["Tietosuojakäytännöt ja ilmoitusten hallinta", "Rekisteröityjen oikeuksien hallinta", "Rajat ylittävän datasiirron kontrollit", "Datan säilytys- ja hävittämiskäytännöt", "Tietosuojan vaikutusten arvioinnit"] }
      ]
    },
    roadmap: {
      title: "12 viikon toteutussuunnitelma",
      subtitle: "Rakenteinen lähestymistapa varmistaa onnistuneen SOC 2 Type II -valmistelun 12 viikon kuluessa samalla kun liiketoiminta säilyy.",
      items: [
        { phase: "Vaihe 1: Arviointi ja suunnittelu", duration: "Viikot 1-3", activities: ["Aukkoanalyysi", "Laajuuden määrittely", "Riskinarviointi", "Kontrollien valinta"], deliverables: ["Aukkoanalyysiraportti", "Projektisuunnitelma", "Riskinarviointi", "Kontrollimatriisi"] },
        { phase: "Vaihe 2: Kontrollien suunnittelu", duration: "Viikot 4-6", activities: ["Kontrollidokumentaatio", "Politiikkojen kehitys", "Prosessien suunnittelu", "Koulutusmateriaalit"], deliverables: ["Kontrollidokumentaatio", "Politiikkakokonaisuus", "Prosessikartat", "Koulutusohjelma"] },
        { phase: "Vaihe 3: Toteutus", duration: "Viikot 7-9", activities: ["Kontrollien toteutus", "Koulutusten toteutus", "Testausmenettelyt", "Todisteiden keruu"], deliverables: ["Toteutetut kontrollit", "Koulutustiedot", "Testitulokset", "Todisteiden arkisto"] },
        { phase: "Vaihe 4: Esiauditointi ja sertifiointi", duration: "Viikot 10-12", activities: ["Sisäinen testaus", "Korjaavat toimenpiteet", "Auditointivalmistelu", "SOC 2 -raportti"], deliverables: ["SOC 2 Type II -raportti", "Kontrollien tehokkuus", "Auditointivalmius", "Sertifiointi"] }
      ]
    },
    industries: {
      title: "Toimialakohtaiset menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet teknologiayrityksiä eri toimialoilla saavuttamaan SOC 2 Type II -sertifioinnin.",
      items: [
        { industry: "SaaS-alusta", challenge: "Monivuokralaispilvialustan turvakontrollien osoittaminen EU asiakkaita palvellen", solution: "Kattava turvallisuuskehys tietosuoja-by-design -kontrolleilla ja GDPR-yhdenmukaisuudella", outcome: "SOC 2 Type II saavutettu 10 viikossa parannetulla asiakasluottamuksella" },
        { industry: "Fintech-ratkaisu", challenge: "Rahoituspalveluiden turvallisuusvaatimusten täyttäminen SOC 2 -valmistelun yhteydessä", solution: "Integroitu lähestymistapa, joka yhdistää FIN-FSA-vaatimukset SOC 2 -kontrolleihin", outcome: "SOC 2 -sertifiointi ylläpidetyllä sääntelyvaatimustenmukaisuudella" },
        { industry: "Terveysteknologia", challenge: "Potilastietojen suojaaminen GDPR:n alaisuudessa SOC 2 -kontrollien toteuttamisen aikana", solution: "Tietosuojakeskeinen kontrollikehys terveydenhuollon erityisillä turvatoimilla", outcome: "SOC 2 Type II kattavalla tietosuojan vaatimustenmukaisuudella" }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna kyberturvallisuusasemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "ISO 27001 -toteutus", description: "Tietoturvallisuuden hallinta", href: "/frameworks/iso-27001" },
        { title: "GDPR-vaatimustenmukaisuus", description: "Tietosuoja", href: "/frameworks/gdpr" },
        { title: "Riskiarviointi", description: "Kattava riskien arviointi", href: "/frameworks/risk-assessments" },
        { title: "Politiikkojen kehitys", description: "Hallintakehys", href: "/frameworks/policy-development" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan SOC 2 Type II -sertifioinnin?",
      subtitle: "Liity suomalaisten ja pohjoismaisten teknologiayritysten joukkoon, jotka ovat onnistuneesti saavuttaneet SOC 2 -sertifioinnin asiantuntijaohjauksellamme. Keskustellaan, kuinka voimme auttaa sinua rakentamaan luottamusta asiakkaidesi kanssa.",
      primaryCTA: { text: "Aloita SOC 2 -matkasi", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/soc-2" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#0EA5E9] p-4 rounded-r-lg">
          <p class="text-[#0F172A] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-end mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Service Criteria Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.criteria.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.criteria.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.criteria.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-between items-start mb-3">
              <div class="flex justify-end">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#0EA5E9]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-medium text-[#0EA5E9] bg-blue-50 px-2 py-1 rounded-full border border-[#0EA5E9]">
                  {item.auditFocus}
                </span>
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 mb-3">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1.5">{isFi ? 'Keskeiset kontrollit:' : 'Key Controls:'}</h4>
              <ul class="space-y-1">
                {item.controls.slice(0, 4).map((control) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {control}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Roadmap Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.roadmap.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.roadmap.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        {currentContent.roadmap.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center justify-between mb-3 relative z-10">
              <h3 class="text-sm font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                {phase.phase}
              </h3>
              <span class="text-xs font-medium text-[#0EA5E9] bg-blue-50 px-2 py-1 rounded-full border border-[#0EA5E9] relative z-10">
                {phase.duration}
              </span>
            </div>
            
            <div class="grid md:grid-cols-2 gap-4 relative z-10">
              <div>
                <h4 class="font-semibold text-[#1E293B] text-xs mb-1.5">{isFi ? 'Keskeiset toimet:' : 'Key Activities:'}</h4>
                <ul class="space-y-1">
                  {phase.activities.map((activity) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {activity}
                    </li>
                  ))}
                </ul>
              </div>
              
              <div>
                <h4 class="font-semibold text-[#1E293B] text-xs mb-1.5">{isFi ? 'Tuotokset:' : 'Deliverables:'}</h4>
                <ul class="space-y-1">
                  {phase.deliverables.map((deliverable) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      {deliverable}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Examples Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.industries.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industries.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {currentContent.industries.items.map((example) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="mb-3 relative z-10">
              <span class="inline-block bg-[#0EA5E9]/10 text-[#1E293B] text-xs font-medium px-3 py-1 rounded-full group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:text-white transition-all duration-300">
                {example.industry}
              </span>
            </div>
            
            <div class="relative z-10">
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1">{isFi ? 'Haaste:' : 'Challenge:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.challenge}</p>
              
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1">{isFi ? 'Ratkaisumme:' : 'Our Solution:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.solution}</p>
              
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1">{isFi ? 'Tulos:' : 'Outcome:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">{example.outcome}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.related.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.related.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-4 gap-6">
        {currentContent.related.items.map((service) => (
          <a href={service.href} class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center relative overflow-hidden block">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>


</Layout>