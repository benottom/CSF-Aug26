---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Regulatory Frameworks | Cybersecurity Regulations & Standards",
  description: "Comprehensive collection of key cybersecurity regulations and standards. Detailed guides for implementation and compliance. NIS2, DORA, GDPR, eIDAS, ISO 27001, SOC 2.",
  keywords: "regulatory frameworks, NIS2, DORA, GDPR, eIDAS, ISO 27001, SOC 2, cybersecurity compliance",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Cybersecurity Regulatory Frameworks",
      subtitle: "Comprehensive collection of key cybersecurity regulations and standards",
      description: "Detailed implementation guides and compliance support for all major cybersecurity regulations and standards.",
      primaryCTA: { text: "Browse Regulations", href: "#frameworks" },
      secondaryCTA: { text: "Get Expert Help", href: "/contact" }
    },
    forWho: "For organizations seeking to understand and implement cybersecurity regulations and standards.",
    achieve: "Comprehensive compliance with all major cybersecurity regulations and standards.",
    overview: {
      title: "Overview",
      description: "Navigating the complex landscape of cybersecurity regulations and standards is essential for organizations operating in today's digital environment. From EU directives like NIS2 and DORA to global standards like ISO 27001 and SOC 2, understanding and implementing these frameworks is critical for protecting your organization and maintaining stakeholder trust.",
      highlight: "Our expert team provides comprehensive guidance and implementation support for all major cybersecurity regulations and standards, helping you achieve and maintain compliance efficiently."
    },
    stats: [
      { value: "6+", label: "Major regulations" },
      { value: "100+", label: "Requirements covered" },
      { value: "25+", label: "Industries supported" },
      { value: "98%", label: "Compliance success rate" }
    ],
    process: {
      title: "Implementation Process",
      subtitle: "Five-phase methodology for successful implementation of regulations and standards",
      steps: [
        { step: "1", title: "Current state assessment", icon: "search" },
        { step: "2", title: "Requirements analysis", icon: "list" },
        { step: "3", title: "Implementation planning", icon: "map" },
        { step: "4", title: "Practical implementation", icon: "tool" },
        { step: "5", title: "Audit and certification", icon: "award" }
      ]
    },
    frameworks: {
      title: "Supported Regulatory Frameworks",
      subtitle: "Comprehensive support for key cybersecurity regulations and standards",
      items: [
        {
          title: "NIS2 Directive",
          description: "European Union Network and Information Security Directive v2",
          icon: "shield",
          scope: "EU",
          deadline: "2024-10-17",
          sectors: ["Energy", "Transport", "Banking", "Health", "Digital Infrastructure"],
          href: "/frameworks/nis2",
          requirements: ["Cybersecurity risk management", "Incident reporting", "Supply chain security", "Staff training"]
        },
        {
          title: "DORA Regulation",
          description: "Digital Operational Resilience Act for financial sector",
          icon: "building",
          scope: "EU",
          deadline: "2025-01-17",
          sectors: ["Banking", "Insurance", "Investment", "Payment Services"],
          href: "/frameworks/dora",
          requirements: ["ICT risk management", "Third-party risk management", "Digital operational resilience", "Testing and exercises"]
        },
        {
          title: "GDPR Regulation",
          description: "General Data Protection Regulation for personal data processing",
          icon: "user-check",
          scope: "EU + Global",
          deadline: "2018-05-25",
          sectors: ["All sectors processing personal data"],
          href: "/frameworks/gdpr",
          requirements: ["Data protection impact assessments", "Personal data protection", "Data breach notification", "Individual rights"]
        },
        {
          title: "eIDAS Regulation",
          description: "Electronic identification and trust services",
          icon: "key",
          scope: "EU",
          deadline: "2016-07-01",
          sectors: ["Digital Services", "Public Services", "E-commerce"],
          href: "/frameworks/eidas",
          requirements: ["Electronic signatures", "Electronic sealed documents", "Time stamping", "Authentication services"]
        },
        {
          title: "ISO 27001",
          description: "International information security management system standard",
          icon: "award",
          scope: "Global",
          deadline: "Ongoing",
          sectors: ["All sectors"],
          href: "/frameworks/iso-27001",
          requirements: ["Information security policy", "Risk assessment process", "Security controls", "Continuous improvement"]
        },
        {
          title: "SOC 2",
          description: "Service organization control auditing",
          icon: "check-circle",
          scope: "Global",
          deadline: "Ongoing",
          sectors: ["SaaS", "Cloud Services", "Data Centers"],
          href: "/frameworks/soc-2",
          requirements: ["Security", "Availability", "Processing Integrity", "Confidentiality"]
        }
      ]
    },
    cta: {
      title: "Start Your Compliance Journey",
      subtitle: "Contact our experts and get a tailored implementation plan.",
      primaryCTA: { text: "Contact Us", href: "/contact" },
      secondaryCTA: { text: "Book Demo", href: "/demo" }
    }
  },
  fi: {
    hero: {
      title: "Kyberturvallisuuden säädöskehikot",
      subtitle: "Kattava kokoelma tärkeimmistä kyberturvallisuuden säädöksistä ja standardeista",
      description: "Yksityiskohtaiset toteutusoppaat ja compliance-tuet kaikille keskeisille kyberturvallisuuden säädöksille ja standardeille.",
      primaryCTA: { text: "Selaa säädöksiä", href: "#frameworks" },
      secondaryCTA: { text: "Pyydä asiantuntija-apua", href: "/contact" }
    },
    forWho: "Organisaatioille, jotka haluavat ymmärtää ja toteuttaa kyberturvallisuuden säädöksiä ja standardeja.",
    achieve: "Kattava vaatimustenmukaisuus kaikkien keskeisten kyberturvallisuuden säädösten ja standardien kanssa.",
    overview: {
      title: "Yleiskatsaus",
      description: "Kyberturvallisuuden säädösten ja standardien monimutkaisessa kentässä navigointi on välttämätöntä organisaatioille, jotka toimivat nykypäivän digitaalisessa ympäristössä. EU-direktiiveistä kuten NIS2 ja DORA globaaleihin standardeihin kuten ISO 27001 ja SOC 2, näiden kehysten ymmärtäminen ja toteuttaminen on kriittistä organisaatiosi suojaamiseksi ja sidosryhmien luottamuksen ylläpitämiseksi.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa ohjausta ja toteutustukea kaikille keskeisille kyberturvallisuuden säädöksille ja standardeille auttaen sinua saavuttamaan ja ylläpitämään vaatimustenmukaisuutta tehokkaasti."
    },
    stats: [
      { value: "6+", label: "Tärkeintä säädöstä" },
      { value: "100+", label: "Vaatimusta katettu" },
      { value: "25+", label: "Toimialaa tuettu" },
      { value: "98%", label: "Compliance-onnistuminen" }
    ],
    process: {
      title: "Toteutusprosessi",
      subtitle: "Viiden vaiheen metodologia säädösten ja standardien onnistuneeseen toteutukseen",
      steps: [
        { step: "1", title: "Nykytilanteen kartoitus", icon: "search" },
        { step: "2", title: "Vaatimusten analysointi", icon: "list" },
        { step: "3", title: "Toteutussuunnitelman laadinta", icon: "map" },
        { step: "4", title: "Käytännön toteutus", icon: "tool" },
        { step: "5", title: "Auditointi ja sertifiointi", icon: "award" }
      ]
    },
    frameworks: {
      title: "Tuetut säädöskehikot",
      subtitle: "Kattava tuki tärkeimmille kyberturvallisuuden säädöksille ja standardeille",
      items: [
        {
          title: "NIS2-direktiivi",
          description: "EU:n verkko- ja tietoturvadirektiivin toinen versio",
          icon: "shield",
          scope: "EU",
          deadline: "2024-10-17",
          sectors: ["Energia", "Liikenne", "Pankkitoiminta", "Terveys", "Digitaalinen infrastruktuuri"],
          href: "/frameworks/nis2",
          requirements: ["Kyberturvallisuusriskien hallinta", "Incidenttien raportointi", "Toimitusketjun turvallisuus", "Henkilöstön koulutus"]
        },
        {
          title: "DORA-asetus",
          description: "Digitaalinen operatiivinen resilienssisääntely rahoitusalalla",
          icon: "building",
          scope: "EU",
          deadline: "2025-01-17",
          sectors: ["Pankkitoiminta", "Vakuutus", "Sijoituspalvelut", "Maksupalvelut"],
          href: "/frameworks/dora",
          requirements: ["ICT-riskinhallinta", "Kolmannen osapuolen riskien hallinta", "Digitaalinen operatiivinen kestävyys", "Testaus ja harjoitukset"]
        },
        {
          title: "GDPR-asetus",
          description: "Yleinen tietosuoja-asetus henkilötietojen käsittelyyn",
          icon: "user-check",
          scope: "EU + Global",
          deadline: "2018-05-25",
          sectors: ["Kaikki henkilötietoja käsittelevät toimialat"],
          href: "/frameworks/gdpr",
          requirements: ["Tietosuojan vaikutusarvioinnit", "Henkilötietojen suoja", "Tietomurtojen ilmoittaminen", "Henkilöiden oikeudet"]
        },
        {
          title: "eIDAS-asetus",
          description: "Sähköinen tunnistaminen ja luottamuspalvelut",
          icon: "key",
          scope: "EU",
          deadline: "2016-07-01",
          sectors: ["Digitaaliset palvelut", "Julkiset palvelut", "Verkkokauppa"],
          href: "/frameworks/eidas",
          requirements: ["Sähköiset allekirjoitukset", "Sähköiset sinetatut asiakirjat", "Aikaleimaus", "Tunnistautumispalvelut"]
        },
        {
          title: "ISO 27001",
          description: "Kansainvälinen tietoturvallisuuden hallintajärjestelmästandardi",
          icon: "award",
          scope: "Global",
          deadline: "Jatkuva",
          sectors: ["Kaikki toimialat"],
          href: "/frameworks/iso-27001",
          requirements: ["Tietoturvallisuuspolitiikka", "Riskinarviointiprosessi", "Turvallisuuskontrollit", "Jatkuva parantaminen"]
        },
        {
          title: "SOC 2",
          description: "Palvelujärjestelmien kontrolliauditointi",
          icon: "check-circle",
          scope: "Global",
          deadline: "Jatkuva",
          sectors: ["SaaS", "Pilvipalvelut", "Datakeskukset"],
          href: "/frameworks/soc-2",
          requirements: ["Turvallisuus (Security)", "Käytettävyys (Availability)", "Käsittelyn eheys (Processing Integrity)", "Luottamuksellisuus (Confidentiality)"]
        }
      ]
    },
    cta: {
      title: "Aloita compliance-matka",
      subtitle: "Ota yhteyttä asiantuntijoihimme ja saa räätälöity toteutussuunnitelma.",
      primaryCTA: { text: "Ota yhteyttä", href: "/contact" },
      secondaryCTA: { text: "Varaa demo", href: "/demo" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#131c2e] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#003580] p-4 rounded-r-lg">
          <p class="text-[#131c2e] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-8 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {currentContent.stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-[#003580] mb-1">
              {stat.value}
            </div>
            <div class="text-slate-500 text-sm">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
        {currentContent.process.steps.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.step}
              </div>
            </div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={step.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Frameworks Grid Section -->
  <section id="frameworks" class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.frameworks.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.frameworks.subtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {currentContent.frameworks.items.map((framework) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-between items-start mb-3 relative z-10">
              <div class="flex justify-end">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={framework.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <div class="text-right">
                <div class="text-xs font-medium text-[#003580] bg-blue-50 px-2 py-0.5 rounded-[2px] border border-[#003580]">{framework.scope}</div>
                <div class="text-xs text-slate-400 mt-0.5">{framework.deadline}</div>
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {framework.title}
            </h3>
            
            <p class="text-xs text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 mb-3 relative z-10">
              {framework.description}
            </p>
            
            <div class="mb-3 relative z-10">
              <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Keskeiset vaatimukset:' : 'Key Requirements:'}</h4>
              <ul class="space-y-1">
                {framework.requirements.map((req) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="mb-3 relative z-10">
              <div class="text-xs font-semibold text-[#14171a] mb-1.5">{isFi ? 'Toimialat:' : 'Sectors:'}</div>
              <div class="flex flex-wrap gap-1.5">
                {framework.sectors.map((sector) => (
                  <span class="px-2 py-0.5 bg-[#003580]/10 text-[#14171a] rounded-[2px] text-xs">
                    {sector}
                  </span>
                ))}
              </div>
            </div>
            
<div class="flex justify-center mt-4 relative z-10">
  <a href={framework.href} class="inline-flex items-center justify-center px-4 py-2 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-1.5">
    {isFi ? 'Lue lisää' : 'Learn More'}
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </a>
</div>
          </div>
        ))}
      </div>
    </div>
  </section>


</Layout>