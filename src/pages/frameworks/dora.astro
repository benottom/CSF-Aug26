---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "DORA Digital Operational Resilience Act | EU Financial Services Compliance",
  description: "Comprehensive EU financial services cybersecurity compliance for digital operational resilience excellence. Expert DORA implementation for Finnish financial institutions.",
  keywords: "DORA, Digital Operational Resilience Act, EU regulation, financial services cybersecurity, operational resilience, Finland",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "DORA",
      subtitle: "Digital Operational Resilience Act",
      description: "Cybersecurity.fi specializes in DORA implementation for Finnish financial institutions and critical ICT service providers, delivering digital operational resilience frameworks that ensure business continuity, protect against cyber threats, and meet EU regulatory requirements. DORA has been applicable since 17 January 2025 — compliance is an ongoing obligation, not a one-time deadline.",
      primaryCTA: { text: "Start DORA Compliance Program", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/dora-compliance" }
    },
    forWho: "For financial institutions and critical ICT service providers subject to EU DORA regulations.",
    achieve: "DORA compliance with comprehensive digital operational resilience and regulatory readiness.",
    overview: {
      title: "Overview",
      description: "The Digital Operational Resilience Act (DORA) establishes uniform requirements for the security of network and information systems supporting the business processes of financial entities and critical ICT third-party service providers in the EU.",
      highlight: "DORA compliance is mandatory for all in-scope financial entities and has been enforced since 17 January 2025. Our expert team provides end-to-end DORA implementation support, from ICT risk management and incident response through operational resilience testing and third-party management."
    },
    benefits: {
      title: "Why Choose Our DORA Services",
      subtitle: "We deliver DORA compliance with financial services expertise, ensuring your organization meets EU digital operational resilience requirements while maintaining business operations.",
      items: [
        { title: "Financial Services Specialization", description: "Deep expertise in FIN-FSA requirements, EU financial regulations, and integration with existing risk management frameworks specific to banking, insurance, and investment services.", icon: "building-library" },
        { title: "Structured Compliance Methodology", description: "A structured, proven methodology for achieving and maintaining DORA compliance while sustaining business operations.", icon: "lightning" },
        { title: "Risk-Based Digital Resilience", description: "Comprehensive ICT risk management framework aligned with DORA requirements and financial sector operational risk management.", icon: "target" },
        { title: "Operational Resilience Testing", description: "Advanced digital operational resilience testing including threat-led penetration testing (TLPT) for significant entities.", icon: "wrench" },
        { title: "Third-Party ICT Management", description: "Comprehensive critical ICT service provider management, contractual frameworks, and oversight mechanisms.", icon: "handshake" },
        { title: "Intelligence & Information Sharing", description: "Participation in cyber threat intelligence sharing platforms and information sharing arrangements.", icon: "chart-bar" }
      ]
    },
    requirements: {
      title: "DORA Directive Requirements",
      subtitle: "Our DORA implementation covers all key requirements, ensuring comprehensive compliance with EU digital operational resilience standards.",
      items: [
        { title: "ICT Risk Management Framework", description: "Establish comprehensive ICT risk management framework integrated with overall operational risk management", icon: "chart-line", timeline: "6-9 months", scope: "All financial entities", controls: ["ICT risk management policy with board oversight", "Risk assessment methodologies and treatment processes", "ICT asset inventory and dependency mapping", "Risk monitoring and key risk indicator frameworks"] },
        { title: "ICT-Related Incident Management", description: "Implement robust incident detection, classification, response, and regulatory reporting capabilities", icon: "bell", timeline: "4-6 months", scope: "Mandatory for all entities", controls: ["Incident detection and response capabilities", "Incident classification framework with severity levels", "Regulatory reporting to competent authorities", "Root cause analysis and lessons learned"] },
        { title: "Digital Operational Resilience Testing", description: "Conduct comprehensive testing of ICT systems, applications, and business processes", icon: "magnifying-glass", timeline: "Ongoing cycles", scope: "TLPT for significant entities", controls: ["Threat-led penetration testing (TLPT) programs", "Vulnerability assessments and penetration testing", "Scenario-based testing for critical functions", "Advanced red team and purple team exercises"] },
        { title: "Third-Party ICT Provider Management", description: "Comprehensive oversight and management of critical ICT service providers", icon: "link", timeline: "12-18 months", scope: "Enhanced oversight requirements", controls: ["Critical ICT service provider identification", "Contractual arrangements with DORA requirements", "Continuous monitoring and performance oversight", "Exit strategies and contingency planning"] },
        { title: "Information and Intelligence Sharing", description: "Participate in cybersecurity information sharing mechanisms", icon: "share", timeline: "3-6 months", scope: "Voluntary but encouraged", controls: ["Arrangements for sharing cyber threat intelligence", "Participation in information sharing platforms", "Threat intelligence analysis capabilities", "Information sharing agreements with peers"] }
      ]
    },
    phases: {
      title: "8-Month Implementation Roadmap",
      subtitle: "Structured approach ensuring successful DORA compliance within 8 months while maintaining business continuity.",
      items: [
        { phase: "Phase 1: Assessment & Planning", duration: "Months 1-2", activities: ["Gap Analysis", "Scope Definition", "Risk Assessment", "Stakeholder Engagement"], deliverables: ["Gap Analysis Report", "Project Charter", "Risk Register", "Stakeholder Map"] },
        { phase: "Phase 2: Framework Design", duration: "Months 3-4", activities: ["Control Framework", "Policy Development", "Process Design", "Training Planning"], deliverables: ["Control Framework", "Policy Suite", "Process Maps", "Training Program"] },
        { phase: "Phase 3: Implementation", duration: "Months 5-6", activities: ["Control Implementation", "Training Delivery", "Testing", "Documentation"], deliverables: ["Implemented Controls", "Training Records", "Test Results", "Compliance Documentation"] },
        { phase: "Phase 4: Testing & Validation", duration: "Months 7-8", activities: ["Resilience Testing", "Incident Response Testing", "Validation", "Final Documentation"], deliverables: ["Test Results", "Validation Report", "Final DORA Framework", "Compliance Certificate"] }
      ]
    },
    industries: {
      title: "Financial Services Success Stories",
      subtitle: "See how we've helped financial institutions across different sectors achieve DORA compliance.",
      items: [
        { industry: "Traditional Banking", challenge: "Modernizing legacy systems while implementing DORA requirements", solution: "Phased approach combining legacy modernization with DORA controls", outcome: "DORA compliance achieved with enhanced digital resilience" },
        { industry: "Fintech Platform", challenge: "Meeting DORA requirements for cloud-native financial services", solution: "Cloud security framework with DORA-aligned controls and monitoring", outcome: "DORA compliance with scalable cloud security architecture" },
        { industry: "Investment Services", challenge: "Implementing DORA across multiple jurisdictions and regulatory regimes", solution: "Unified framework addressing DORA, local regulations, and international standards", outcome: "Comprehensive compliance with reduced implementation complexity" }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your cybersecurity posture with our complementary services and frameworks.",
      items: [
        { title: "ISO 27001 Implementation", description: "Information security management", href: "/frameworks/iso-27001" },
        { title: "NIS2 Compliance", description: "EU cybersecurity directive", href: "/frameworks/nis2" },
        { title: "Third-Party Risk Management", description: "Supply chain security", href: "/services/risk-and-assessment-services/third-party-risk" },
        { title: "Compliance Engineering", description: "NIS2, CRA and EUCC implementation", href: "/services/compliance-engineering" }
      ]
    },
    cta: {
      title: "Ready to Achieve DORA Compliance?",
      subtitle: "Let's discuss how we can help you meet EU digital operational resilience requirements.",
      primaryCTA: { text: "Request a Compliance Assessment", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/dora-compliance" }
    }
  },
  fi: {
    hero: {
      title: "DORA",
      subtitle: "Digitaalisen toimintakyvyn säädös",
      description: "Cybersecurity.fi on erikoistunut DORA-toteutukseen suomalaisille rahoituslaitoksille ja kriittisille ICT-palveluntarjoajille tarjoten digitaalisen toimintakyvyn kehyksiä, jotka varmistavat liiketoiminnan jatkuvuuden, suojaavat kyberuhkilta ja täyttävät EU:n sääntelyvaatimukset. DORA on ollut sovellettavissa 17.1.2025 alkaen — vaatimustenmukaisuus on jatkuva velvoite, ei kertaluonteinen määräaika.",
      primaryCTA: { text: "Aloita DORA-vaatimustenmukaisuusohjelma", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/dora-compliance" }
    },
    forWho: "Rahoituslaitoksille ja kriittisille ICT-palveluntarjoajille, jotka ovat EU:n DORA-sääntelyn alaisia.",
    achieve: "DORA-vaatimustenmukaisuus kattavalla digitaalisella toimintakyvyllä ja sääntelyvalmiudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "Digitaalisen operatiivisen resilienssin säädös (DORA) asettaa yhtenäiset vaatimukset rahoituslaitosten ja kriittisten kolmannen osapuolen ICT-palveluntarjoajien liiketoimintaprosesseja tukevien tietoverkkojen ja tietojärjestelmien turvallisuudelle EU:ssa.",
      highlight: "DORA-vaatimustenmukaisuus on pakollinen kaikille soveltamisalaan kuuluville rahoituslaitoksille, ja sitä on valvottu 17. tammikuuta 2025 alkaen. Asiantuntijatiimimme tarjoaa kattavaa DORA-toteutustukea ICT-riskienhallinnasta ja tapahtumien hallinnasta toimintakyvyn testaukseen ja kolmannen osapuolen hallintaan."
    },
    benefits: {
      title: "Miksi valita DORA-palvelumme",
      subtitle: "Tarjoamme DORA-vaatimustenmukaisuuden rahoituspalvelualan asiantuntemuksella varmistaen, että organisaatiosi täyttää EU:n digitaalisen toimintakyvyn vaatimukset samalla kun ylläpidät liiketoimintaa.",
      items: [
        { title: "Rahoituspalvelualan erikoisosaaminen", description: "Syvä asiantuntemus FIN-FSA-vaatimuksista, EU:n rahoitussäännöksistä ja integroinnista olemassa oleviin riskienhallintakehyksiin pankeille, vakuutusyhtiöille ja sijoituspalveluille.", icon: "building-library" },
        { title: "Jäsennelty vaatimustenmukaisuusmenetelmä", description: "Jäsennelty, todistettu menetelmä DORA-vaatimustenmukaisuuden saavuttamiseen ja ylläpitämiseen liiketoimintaa keskeyttämättä.", icon: "lightning" },
        { title: "Riskipohjainen digitaalinen resilienssi", description: "Kattava ICT-riskienhallintakehys, joka on linjassa DORA-vaatimusten ja rahoitusalan operatiivisen riskienhallinnan kanssa.", icon: "target" },
        { title: "Toimintakyvyn testaus", description: "Edistynyt digitaalisen toimintakyvyn testaus mukaan lukien uhkajohtoinen penetraatiotestaus (TLPT) merkittäville toimijoille.", icon: "wrench" },
        { title: "Kolmannen osapuolen ICT-hallinta", description: "Kattava kriittisten ICT-palveluntarjoajien hallinta, sopimuskehykset ja valvontamekanismit.", icon: "handshake" },
        { title: "Tiedustelu ja tiedonjako", description: "Osallistuminen kyberuhkatiedustelun jakamisalustoille ja tiedonjakomenetelmien toteuttaminen.", icon: "chart-bar" }
      ]
    },
    requirements: {
      title: "DORA-direktiivin vaatimukset",
      subtitle: "DORA-toteutuksemme kattaa kaikki keskeiset vaatimukset varmistaen kattavan vaatimustenmukaisuuden EU:n digitaalisen toimintakyvyn standardien kanssa.",
      items: [
        { title: "ICT-riskienhallintakehys", description: "Perusta kattava ICT-riskienhallintakehys integroituna yleiseen operatiiviseen riskienhallintaan", icon: "chart-line", timeline: "6-9 kuukautta", scope: "Kaikki rahoitustoimijat", controls: ["ICT-riskienhallintapolitiikka hallituksen valvonnassa", "Riskinarviointimenetelmät ja -prosessit", "ICT-omaisuusluettelo ja riippuvuuskartoitus", "Riskien seuranta ja keskeiset riski-indikaattorit"] },
        { title: "ICT-tapahtumien hallinta", description: "Toteuta vankka tapahtumien havaitsemis-, luokittelu-, reagointi- ja sääntelyraportointikyvykkyydet", icon: "bell", timeline: "4-6 kuukautta", scope: "Pakollinen kaikille toimijoille", controls: ["24/7 tapahtumien havaitsemis- ja reagointikyvykkyydet", "Tapahtumien luokittelukehys vakavuusasteilla", "Sääntelyraportointi toimivaltaisille viranomaisille", "Perimmäisen syyn analyysi ja opitut asiat"] },
        { title: "Digitaalisen toimintakyvyn testaus", description: "Suorita kattava ICT-järjestelmien, -sovellusten ja liiketoimintaprosessien testaus", icon: "magnifying-glass", timeline: "Jatkuvat syklit", scope: "TLPT merkittäville toimijoille", controls: ["Uhkajohtoinen penetraatiotestaus (TLPT) -ohjelmat", "Haavoittuvuusarvioinnit ja tunkeutumistestaus", "Skenaariopohjainen kriittisten toimintojen testaus", "Edistyneet punaisen ja purppuratiimin harjoitukset"] },
        { title: "Kolmannen osapuolen ICT-palveluntarjoajien hallinta", description: "Kattava kriittisten ICT-palveluntarjoajien valvonta ja hallinta", icon: "link", timeline: "12-18 kuukautta", scope: "Tehostetut valvontavaatimukset", controls: ["Kriittisten ICT-palveluntarjoajien tunnistaminen", "Sopimusjärjestelyt DORA-vaatimuksilla", "Jatkuva seuranta ja suorituskyvyn valvonta", "Poistumisstrategiat ja varautumissuunnittelu"] },
        { title: "Tiedustelu ja tiedonjako", description: "Osallistu kyberturvallisuuden tiedonjakomekanismeihin", icon: "share", timeline: "3-6 kuukautta", scope: "Vapaaehtoista mutta suositeltavaa", controls: ["Järjestelyt kyberuhkatiedustelun jakamiseen", "Osallistuminen tiedonjakofoorumeille", "Uhkatiedustelun analysointikyvykkyydet", "Tiedonjakosopimukset alan toimijoiden kanssa"] }
      ]
    },
    phases: {
      title: "8 kuukauden toteutussuunnitelma",
      subtitle: "Rakenteinen lähestymistapa varmistaa onnistuneen DORA-vaatimustenmukaisuuden 8 kuukauden kuluessa samalla kun liiketoiminnan jatkuvuus säilyy.",
      items: [
        { phase: "Vaihe 1: Arviointi ja suunnittelu", duration: "Kuukaudet 1-2", activities: ["Aukkoanalyysi", "Laajuuden määrittely", "Riskinarviointi", "Sidosryhmien osallistuminen"], deliverables: ["Aukkoanalyysiraportti", "Projektisuunnitelma", "Riskirekisteri", "Sidosryhmäkartta"] },
        { phase: "Vaihe 2: Kehyksen suunnittelu", duration: "Kuukaudet 3-4", activities: ["Kontrollikehys", "Politiikkojen kehitys", "Prosessien suunnittelu", "Koulutussuunnittelu"], deliverables: ["Kontrollikehys", "Politiikkakokonaisuus", "Prosessikartat", "Koulutusohjelma"] },
        { phase: "Vaihe 3: Toteutus", duration: "Kuukaudet 5-6", activities: ["Kontrollien toteutus", "Koulutusten toteutus", "Testaus", "Dokumentointi"], deliverables: ["Toteutetut kontrollit", "Koulutustiedot", "Testitulokset", "Vaatimustenmukaisuusdokumentaatio"] },
        { phase: "Vaihe 4: Testaus ja validointi", duration: "Kuukaudet 7-8", activities: ["Toimintakyvyn testaus", "Tapahtumien hallinnan testaus", "Validointi", "Lopullinen dokumentointi"], deliverables: ["Testitulokset", "Validointiraportti", "Lopullinen DORA-kehys", "Vaatimustenmukaisuussertifikaatti"] }
      ]
    },
    industries: {
      title: "Rahoituspalvelujen menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet rahoituslaitoksia eri sektoreilla saavuttamaan DORA-vaatimustenmukaisuuden.",
      items: [
        { industry: "Perinteinen pankkitoiminta", challenge: "Perinteisten järjestelmien modernisointi DORA-vaatimusten käyttöönoton yhteydessä", solution: "Vaiheittainen lähestymistapa, joka yhdistää perinteisten järjestelmien modernisoinnin DORA-kontrolleihin", outcome: "DORA-vaatimustenmukaisuus saavutettu parannetulla digitaalisella resilienssillä" },
        { industry: "Fintech-alusta", challenge: "DORA-vaatimusten täyttäminen pilvipohjaisille rahoituspalveluille", solution: "Pilviturvakehys DORA-yhteensopivilla kontrolleilla ja seurannalla", outcome: "DORA-vaatimustenmukaisuus skaalautuvalla pilviturva-arkkitehtuurilla" },
        { industry: "Sijoituspalvelut", challenge: "DORAn toteuttaminen useilla lainkäyttöalueilla ja sääntelyjärjestelmissä", solution: "Yhtenäinen kehys, joka kattaa DORA:n, paikalliset säännökset ja kansainväliset standardit", outcome: "Kattava vaatimustenmukaisuus vähentyneellä toteutuksen monimutkaisuudella" }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna kyberturvallisuusasemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "ISO 27001 -toteutus", description: "Tietoturvallisuuden hallinta", href: "/frameworks/iso-27001" },
        { title: "NIS2-vaatimustenmukaisuus", description: "EU:n kyberturvallisuusdirektiivi", href: "/frameworks/nis2" },
        { title: "Kolmannen osapuolen riskienhallinta", description: "Toimitusketjun turvallisuus", href: "/services/risk-and-assessment-services/third-party-risk" },
        { title: "Compliance Engineering", description: "NIS2-, CRA- ja EUCC-toteutus", href: "/services/compliance-engineering" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan DORA-vaatimustenmukaisuuden?",
      subtitle: "Keskustellaan, kuinka voimme auttaa sinua täyttämään EU:n digitaalisen toimintakyvyn vaatimukset.",
      primaryCTA: { text: "Pyydä vaatimustenmukaisuusarviointi", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/dora-compliance" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#131c2e] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#003580] p-4 rounded-r-lg">
          <p class="text-[#131c2e] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-end mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DORA Requirements Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.requirements.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirements.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.requirements.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-between items-start mb-3">
              <div class="flex justify-end">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-medium text-[#003580] bg-blue-50 px-2 py-1 rounded-[2px] border border-[#003580]">
                  {item.timeline}
                </span>
                <p class="text-xs text-slate-500 mt-1">{item.scope}</p>
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 mb-3">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Keskeiset kontrollit:' : 'Key Controls:'}</h4>
              <ul class="space-y-1">
                {item.controls.slice(0, 4).map((control) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {control}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Phases Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.phases.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        {currentContent.phases.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center justify-between mb-3 relative z-10">
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {phase.phase}
              </h3>
              <span class="text-xs font-medium text-[#003580] bg-blue-50 px-2 py-1 rounded-[2px] border border-[#003580] relative z-10">
                {phase.duration}
              </span>
            </div>
            
            <div class="grid md:grid-cols-2 gap-4 relative z-10">
              <div>
                <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Keskeiset toimet:' : 'Key Activities:'}</h4>
                <ul class="space-y-1">
                  {phase.activities.map((activity) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {activity}
                    </li>
                  ))}
                </ul>
              </div>
              
              <div>
                <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Tuotokset:' : 'Deliverables:'}</h4>
                <ul class="space-y-1">
                  {phase.deliverables.map((deliverable) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      {deliverable}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Examples Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.industries.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industries.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {currentContent.industries.items.map((example) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="mb-3 relative z-10">
              <span class="inline-block bg-[#003580]/10 text-[#14171a] text-xs font-medium px-3 py-1 rounded-[2px] group-hover:bg-[#003580] group-hover:text-white transition-all duration-300">
                {example.industry}
              </span>
            </div>
            
            <div class="relative z-10">
              <h4 class="font-semibold text-[#14171a] text-xs mb-1">{isFi ? 'Haaste:' : 'Challenge:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.challenge}</p>
              
              <h4 class="font-semibold text-[#14171a] text-xs mb-1">{isFi ? 'Ratkaisumme:' : 'Our Solution:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.solution}</p>
              
              <h4 class="font-semibold text-[#14171a] text-xs mb-1">{isFi ? 'Tulos:' : 'Outcome:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">{example.outcome}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.related.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.related.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-4 gap-6">
        {currentContent.related.items.map((service) => (
          <a href={service.href} class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center relative overflow-hidden block">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-8 md:p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-slate-900">
          {currentContent.cta.title}
        </h2>

        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          {currentContent.cta.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          
          <a href={currentContent.cta.primaryCTA.href} 
             class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium gap-2">
            {currentContent.cta.primaryCTA.text}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          
          <a href={currentContent.cta.secondaryCTA.href} 
             class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
            {currentContent.cta.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>