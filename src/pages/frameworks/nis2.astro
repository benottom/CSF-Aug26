---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "NIS2 Network and Information Security Directive | EU Cybersecurity Compliance",
  description: "Comprehensive EU cybersecurity compliance for critical infrastructure and essential service providers. Expert NIS2 implementation for Finnish organizations.",
  keywords: "NIS2, NIS2 directive, EU cybersecurity, critical infrastructure, essential services, Finland",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "NIS2",
      subtitle: "Network and Information Security Directive",
      description: "Cybersecurity.fi specializes in NIS2 Directive implementation, helping Finnish organizations achieve full compliance with enhanced cybersecurity requirements while building resilient digital infrastructure that protects critical operations and ensures regulatory alignment across the EU.",
      primaryCTA: { text: "Start NIS2 Compliance Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/nis2" }
    },
    forWho: "For essential and important entities across 18 sectors including energy, transport, banking, health, and digital infrastructure.",
    achieve: "Full NIS2 compliance with enhanced cybersecurity posture, incident response capabilities, and regulatory readiness.",
    overview: {
      title: "Overview",
      description: "The NIS2 Directive strengthens cybersecurity requirements for critical infrastructure and essential service providers across the EU. It establishes a common level of cybersecurity across member states, requiring organizations to implement comprehensive risk management, incident reporting, and supply chain security measures.",
      highlight: "Our expert team provides comprehensive NIS2 implementation support, guiding your organization through every step of the compliance journey and building resilient cybersecurity foundations that protect critical operations."
    },
    benefits: {
      title: "Why Choose Our NIS2 Services",
      subtitle: "We deliver NIS2 compliance with Finnish market expertise, ensuring your organization meets EU cybersecurity requirements while maintaining business operations.",
      items: [
        { title: "Regulatory Compliance Assurance", description: "Achieve full NIS2 compliance with expert guidance through complex EU cybersecurity requirements, ensuring your organization meets all mandatory obligations and avoids significant penalties.", icon: "target" },
        { title: "Finnish Market Specialization", description: "Deep understanding of Finnish implementation of EU directives, local business context, and Traficom requirements and reporting procedures.", icon: "flag" },
        { title: "Accelerated Implementation", description: "Achieve NIS2 compliance in 12-16 weeks with our proven methodology, expert guidance, and parallel workstream approach that minimizes business disruption.", icon: "lightning" },
        { title: "24/7 Incident Response", description: "Robust incident detection, reporting, and response capabilities meeting EU cybersecurity requirements with 24-hour, 72-hour, and monthly reporting timelines.", icon: "bell" },
        { title: "Risk-Based Security Framework", description: "Comprehensive risk assessment and management aligned with NIS2 requirements, integrating cybersecurity risk management with business strategy.", icon: "shield" },
        { title: "Supply Chain Protection", description: "Advanced third-party risk management and supply chain security controls protecting against cascade failures and ensuring partner ecosystem security alignment.", icon: "link" }
      ]
    },
    requirements: {
      title: "NIS2 Directive Requirements",
      subtitle: "Our NIS2 implementation covers all key requirements, ensuring comprehensive compliance with EU cybersecurity standards.",
      items: [
        { title: "Cybersecurity Risk Management", description: "Implement comprehensive cybersecurity risk management framework with policies, procedures, and continuous monitoring", icon: "chart-line", timeline: "3-4 months", penalty: "Up to €10M or 2% annual turnover", controls: ["Risk analysis and information system security policies", "Incident handling and business continuity management", "Supply chain security and vendor risk management", "Security in acquisition, development and maintenance", "Policies to assess effectiveness of cybersecurity measures"] },
        { title: "ICT-Related Incident Management", description: "Establish 24/7 incident detection, response, and regulatory reporting capabilities with specific timelines", icon: "bell", timeline: "2-3 months", penalty: "Personal liability for senior management", controls: ["Computer security incident detection and response", "Early warning systems and threat monitoring", "24-hour initial notification to authorities", "72-hour detailed incident report submission", "Monthly progress reports and final incident assessment"] },
        { title: "Technical & Organizational Measures", description: "Deploy appropriate technical and organizational cybersecurity measures proportionate to identified risks", icon: "shield", timeline: "4-6 months", penalty: "Operational sanctions and service suspension", controls: ["Multi-factor authentication and secure communications", "Encryption mechanisms and cryptographic security", "Network security and network segmentation", "Backup mechanisms and disaster recovery", "Security testing and vulnerability management"] },
        { title: "Third-Party ICT Provider Management", description: "Comprehensive management of ICT service provider relationships and supply chain security", icon: "link", timeline: "2-4 months", penalty: "Enhanced supervisory measures", controls: ["Third-party risk assessment and due diligence", "Contractual security requirements and SLAs", "Continuous monitoring of provider performance", "Incident coordination and information sharing", "Exit strategies and contingency planning"] },
        { title: "Digital Operational Resilience Testing", description: "Regular testing of cybersecurity measures and operational resilience capabilities", icon: "magnifying-glass", timeline: "Ongoing", penalty: "Compliance monitoring and audit requirements", controls: ["Vulnerability assessments and penetration testing", "Security testing programs and methodologies", "Testing documentation and reporting procedures", "Remediation tracking and validation processes", "Advanced testing for critical entities (TLPT)"] },
        { title: "Information Sharing & Reporting", description: "Participate in cybersecurity information sharing and maintain comprehensive documentation", icon: "share", timeline: "Ongoing", penalty: "Regulatory enforcement actions", controls: ["Cyber threat intelligence sharing arrangements", "Participation in information sharing platforms", "Documentation of cybersecurity measures", "Regular reporting to competent authorities", "Cooperation with supervisory authorities"] }
      ]
    },
    phases: {
      title: "8-Month Implementation Roadmap",
      subtitle: "Structured approach ensuring successful NIS2 compliance within 8 months while maintaining business continuity.",
      items: [
        { phase: "Phase 1: Assessment & Legal Analysis", duration: "Months 1-2", activities: ["NIS2 applicability determination", "Comprehensive gap analysis", "Current cybersecurity posture assessment", "Stakeholder engagement", "Risk assessment methodology", "Regulatory mapping"], deliverables: ["NIS2 Legal Applicability Assessment", "Gap Analysis Report", "Current State Assessment", "Project Charter", "Risk Assessment Framework", "Regulatory Roadmap"] },
        { phase: "Phase 2: Framework Design", duration: "Months 3-4", activities: ["Cybersecurity governance framework", "Risk management policies", "Technical security control framework", "Incident response framework", "Supply chain security framework", "Training program design"], deliverables: ["Cybersecurity Governance Charter", "NIS2 Policy Suite", "Technical Security Control Framework", "Incident Response Plan", "Supply Chain Security Framework", "Training Materials"] },
        { phase: "Phase 3: Technical Implementation", duration: "Months 5-6", activities: ["Technical security controls", "Security monitoring deployment", "Multi-factor authentication", "Network segmentation", "Backup and disaster recovery", "Vulnerability management"], deliverables: ["Deployed Technical Controls", "24/7 SOC Capabilities", "IAM System", "Network Security Architecture", "BCP/DR Procedures", "Vulnerability Management Program"] },
        { phase: "Phase 4: Validation & Certification", duration: "Months 7-8", activities: ["Compliance testing and validation", "Internal audit execution", "Incident response testing", "Regulatory reporting testing", "Staff training delivery", "Continuous monitoring program"], deliverables: ["Compliance Validation Report", "Internal Audit Results", "Tested Incident Capabilities", "Regulatory Reporting System", "Trained Staff Records", "Monitoring Program"] }
      ]
    },
    industries: {
      title: "Industry-Specific Success Stories",
      subtitle: "See how we've helped organizations across different critical sectors achieve NIS2 compliance.",
      items: [
        { industry: "Energy Sector", challenge: "Securing critical energy infrastructure while meeting NIS2 requirements", solution: "Integrated OT/IT security approach with energy-specific controls", outcome: "NIS2 compliance achieved with enhanced infrastructure protection" },
        { industry: "Financial Services", challenge: "Meeting FIN-FSA and NIS2 requirements simultaneously", solution: "Unified compliance framework addressing both regulatory regimes", outcome: "Comprehensive compliance with reduced implementation complexity" },
        { industry: "Healthcare", challenge: "Protecting patient care systems under NIS2 and GDPR", solution: "Privacy-by-design security framework with healthcare focus", outcome: "NIS2 compliance with enhanced patient data protection" }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your cybersecurity posture with our complementary services and frameworks.",
      items: [
        { title: "ISO 27001 Implementation", description: "Information security management", href: "/frameworks/iso-27001" },
        { title: "Risk Assessment", description: "Comprehensive risk evaluation", href: "/frameworks/risk-assessments" },
        { title: "Incident Response", description: "Security incident management", href: "/frameworks/incident-response" },
        { title: "Business Continuity", description: "BCP and DR planning", href: "/frameworks/business-continuity" }
      ]
    },
    cta: {
      title: "Ready to Achieve NIS2 Compliance?",
      subtitle: "Join Finnish organizations that have successfully implemented NIS2 with our expert guidance. Let's discuss how we can help you meet EU cybersecurity requirements.",
      primaryCTA: { text: "Start Your NIS2 Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/nis2" }
    }
  },
  fi: {
    hero: {
      title: "NIS2",
      subtitle: "Verkko- ja tietoturvadirektiivi",
      description: "Cybersecurity.fi on erikoistunut NIS2-direktiivin toteutukseen auttaen suomalaisia organisaatioita saavuttamaan täyden vaatimustenmukaisuuden tehostetuilla kyberturvallisuusvaatimuksilla samalla kun rakennetaan joustavaa digitaalista infrastruktuuria, joka suojaa kriittisiä toimintoja ja varmistaa sääntelyn yhdenmukaisuuden EU:ssa.",
      primaryCTA: { text: "Aloita NIS2-vaatimustenmukaisuusmatka", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/nis2" }
    },
    forWho: "Oleellisille ja tärkeille toimijoille 18 sektorilla, mukaan lukien energia, liikenne, pankki, terveys ja digitaalinen infrastruktuuri.",
    achieve: "Täysi NIS2-vaatimustenmukaisuus parannetulla kyberturvallisuudella, tapahtumien hallintakyvyillä ja sääntelyvalmiudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "NIS2-direktiivi vahvistaa kyberturvallisuusvaatimuksia kriittiselle infrastruktuurille ja keskeisille palveluntarjoajille EU:ssa. Se luo yhteisen kyberturvallisuustason jäsenvaltioissa, vaatien organisaatioita toteuttamaan kattavan riskienhallinnan, tapahtumaraportoinnin ja toimitusketjun turvallisuustoimenpiteet.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa NIS2-toteutustukea ohjaten organisaatiosi jokaisen vaatimustenmukaisuusmatkan vaiheen läpi ja rakentaen joustavia kyberturvallisuusperustoja, jotka suojaavat kriittisiä toimintoja."
    },
    benefits: {
      title: "Miksi valita NIS2-palvelumme",
      subtitle: "Tarjoamme NIS2-vaatimustenmukaisuuden Suomen markkinaosaamisella varmistaen, että organisaatiosi täyttää EU:n kyberturvallisuusvaatimukset samalla kun ylläpidät liiketoimintaa.",
      items: [
        { title: "Sääntelyvaatimustenmukaisuuden varmistus", description: "Saavuta täysi NIS2-vaatimustenmukaisuus asiantuntijaohjauksella monimutkaisten EU:n kyberturvallisuusvaatimusten läpi varmistaen, että organisaatiosi täyttää kaikki pakolliset velvoitteet ja välttää merkittävät seuraamukset.", icon: "target" },
        { title: "Suomen markkinoiden erikoisosaaminen", description: "Syvä ymmärrys EU-direktiivien Suomen täytäntöönpanosta, paikallisesta liiketoimintakontekstista sekä Traficomin vaatimuksista ja raportointimenettelyistä.", icon: "flag" },
        { title: "Nopeutettu toteutus", description: "Saavuta NIS2-vaatimustenmukaisuus 12-16 viikossa todistetulla metodologiallamme, asiantuntijaohjauksella ja rinnakkaisella työnkulkulähestymistavalla, joka minimoi liiketoimintahäiriöt.", icon: "lightning" },
        { title: "24/7 tapahtumien hallinta", description: "Vankka tapahtumien havaitsemis-, raportointi- ja reagointikyvykkyys, joka täyttää EU:n kyberturvallisuusvaatimukset 24 tunnin, 72 tunnin ja kuukausittaisilla raportointiaikatauluilla.", icon: "bell" },
        { title: "Riskipohjainen turvallisuuskehys", description: "Kattava riskinarviointi ja -hallinta NIS2-vaatimusten mukaisesti, joka integroi kyberturvallisuusriskienhallinnan liiketoimintastrategiaan.", icon: "shield" },
        { title: "Toimitusketjun suoja", description: "Edistynyt kolmannen osapuolen riskienhallinta ja toimitusketjun turvallisuuskontrollit suojaavat kaskadivaurioilta ja varmistavat kumppaniekosysteemin turvallisuuden yhdenmukaisuuden.", icon: "link" }
      ]
    },
    requirements: {
      title: "NIS2-direktiivin vaatimukset",
      subtitle: "NIS2-toteutuksemme kattaa kaikki keskeiset vaatimukset varmistaen kattavan vaatimustenmukaisuuden EU:n kyberturvallisuusstandardien kanssa.",
      items: [
        { title: "Kyberturvallisuusriskien hallinta", description: "Toteuta kattava kyberturvallisuusriskienhallintakehys politiikoilla, menettelyillä ja jatkuvalla seurannalla", icon: "chart-line", timeline: "3-4 kuukautta", penalty: "Jopa 10 miljoonaa euroa tai 2% vuosiliikevaihdosta", controls: ["Riskianalyysi ja tietojärjestelmien turvallisuuspolitiikat", "Tapahtumien hallinta ja liiketoiminnan jatkuvuuden hallinta", "Toimitusketjun turvallisuus ja toimittajariskien hallinta", "Turvallisuus hankinnassa, kehityksessä ja ylläpidossa", "Politiikat kyberturvatoimien tehokkuuden arvioimiseksi"] },
        { title: "ICT-tapahtumien hallinta", description: "Perusta 24/7 tapahtumien havaitsemis-, reagointi- ja sääntelyraportointikyvykkyydet erityisillä aikatauluilla", icon: "bell", timeline: "2-3 kuukautta", penalty: "Johdon henkilökohtainen vastuu", controls: ["Tietoturvatapahtumien havaitseminen ja reagointi", "Ennakkovaroitusjärjestelmät ja uhkien seuranta", "24 tunnin alkuilmoitus viranomaisille", "72 tunnin yksityiskohtainen tapahtumaraportti", "Kuukausittaiset edistymisraportit ja lopullinen tapahtuma-arviointi"] },
        { title: "Tekniset ja organisatoriset toimenpiteet", description: "Käytä asianmukaisia teknisiä ja organisatorisia kyberturvatoimia, jotka ovat oikeassa suhteessa tunnistettuihin riskeihin", icon: "shield", timeline: "4-6 kuukautta", penalty: "Operatiiviset seuraamukset ja palvelun keskeytys", controls: ["Monivaiheinen tunnistautuminen ja turvallinen viestintä", "Salausmekanismit ja kryptografinen turvallisuus", "Verkkoturvallisuus ja verkon segmentointi", "Varmuuskopiointimekanismit ja katastrofipalautus", "Turvallisuustestaus ja haavoittuvuuksien hallinta"] },
        { title: "Kolmannen osapuolen ICT-palveluntarjoajien hallinta", description: "Kattava ICT-palveluntarjoajasuhteiden ja toimitusketjun turvallisuuden hallinta", icon: "link", timeline: "2-4 kuukautta", penalty: "Tehostetut valvontatoimenpiteet", controls: ["Kolmannen osapuolen riskinarviointi ja due diligence", "Sopimukselliset turvallisuusvaatimukset ja SLAt", "Palveluntarjoajan suorituskyvyn jatkuva seuranta", "Tapahtumien koordinointi ja tiedonjako", "Poistumisstrategiat ja varautumissuunnittelu"] },
        { title: "Digitaalisen toimintakyvyn testaus", description: "Kyberturvatoimien ja operatiivisen resilienssin säännöllinen testaus", icon: "magnifying-glass", timeline: "Jatkuva", penalty: "Vaatimustenmukaisuuden seuranta ja auditointivaatimukset", controls: ["Haavoittuvuusarvioinnit ja tunkeutumistestaus", "Turvallisuustestausohjelmat ja -menetelmät", "Testausdokumentaatio ja raportointimenettelyt", "Korjaustoimien seuranta ja validointiprosessit", "Edistynyt testaus kriittisille toimijoille (TLPT)"] },
        { title: "Tiedonjako ja raportointi", description: "Osallistu kyberturvallisuustiedonjakoon ja ylläpidä kattavaa dokumentaatiota", icon: "share", timeline: "Jatkuva", penalty: "Sääntelyn täytäntöönpanotoimet", controls: ["Kyberuhkatiedustelun jakamisjärjestelyt", "Osallistuminen tiedonjakoalustoille", "Kyberturvatoimien dokumentointi", "Säännöllinen raportointi toimivaltaisille viranomaisille", "Yhteistyö valvontaviranomaisten kanssa"] }
      ]
    },
    phases: {
      title: "8 kuukauden toteutussuunnitelma",
      subtitle: "Rakenteinen lähestymistapa varmistaa onnistuneen NIS2-vaatimustenmukaisuuden 8 kuukauden kuluessa samalla kun liiketoiminnan jatkuvuus säilyy.",
      items: [
        { phase: "Vaihe 1: Arviointi ja oikeudellinen analyysi", duration: "Kuukaudet 1-2", activities: ["NIS2-sovellettavuuden määrittely", "Kattava aukkoanalyysi", "Nykyisen kyberturvallisuustason arviointi", "Sidosryhmien osallistaminen", "Riskinarviointimenetelmä", "Sääntelykartoitus"], deliverables: ["NIS2-oikeudellinen sovellettavuusarviointi", "Aukkoanalyysiraportti", "Nykytilan arviointi", "Projektisuunnitelma", "Riskinarviointikehys", "Sääntelyn tiekartta"] },
        { phase: "Vaihe 2: Kehyksen suunnittelu", duration: "Kuukaudet 3-4", activities: ["Kyberturvallisuuden hallintakehys", "Riskienhallintapolitiikat", "Tekninen turvakontrollikehys", "Tapahtumien hallintakehys", "Toimitusketjun turvallisuuskehys", "Koulutusohjelman suunnittelu"], deliverables: ["Kyberturvallisuuden hallintaperuskirja", "NIS2-politiikkakokonaisuus", "Tekninen turvakontrollikehys", "Tapahtumien hallintasuunnitelma", "Toimitusketjun turvallisuuskehys", "Koulutusmateriaalit"] },
        { phase: "Vaihe 3: Tekninen toteutus", duration: "Kuukaudet 5-6", activities: ["Tekniset turvakontrollit", "Turvallisuusseurannan käyttöönotto", "Monivaiheinen tunnistautuminen", "Verkon segmentointi", "Varmuuskopiointi ja katastrofipalautus", "Haavoittuvuuksien hallinta"], deliverables: ["Käyttöönotetut tekniset kontrollit", "24/7 SOC-kyvykkyydet", "IAM-järjestelmä", "Verkkoturva-arkkitehtuuri", "BCP/DR-menettelyt", "Haavoittuvuuksien hallintaohjelma"] },
        { phase: "Vaihe 4: Validointi ja sertifiointi", duration: "Kuukaudet 7-8", activities: ["Vaatimustenmukaisuustestaus", "Sisäinen auditointi", "Tapahtumien hallinnan testaus", "Sääntelyraportoinnin testaus", "Henkilöstön koulutus", "Jatkuvan seurannan ohjelma"], deliverables: ["Vaatimustenmukaisuuden validointiraportti", "Sisäiset auditoinnitulokset", "Testatut tapahtumakyvykkyydet", "Sääntelyraportointijärjestelmä", "Koulutetun henkilöstön tiedot", "Seurantaohjelma"] }
      ]
    },
    industries: {
      title: "Toimialakohtaiset menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet organisaatioita eri kriittisillä toimialoilla saavuttamaan NIS2-vaatimustenmukaisuuden.",
      items: [
        { industry: "Energiasektori", challenge: "Kriittisen energiainfrastruktuurin turvaaminen samalla kun NIS2-vaatimukset täytetään", solution: "Integroitu OT/IT-turvallisuuslähestymistapa energiaspesifisillä kontrolleilla", outcome: "NIS2-vaatimustenmukaisuus saavutettu parannetulla infrastruktuurin suojauksella" },
        { industry: "Rahoituspalvelut", challenge: "FIN-FSA- ja NIS2-vaatimusten täyttäminen samanaikaisesti", solution: "Yhtenäinen vaatimustenmukaisuuskehys, joka kattaa molemmat sääntelyjärjestelmät", outcome: "Kattava vaatimustenmukaisuus vähentyneellä toteutuksen monimutkaisuudella" },
        { industry: "Terveydenhuolto", challenge: "Potilaiden hoitojärjestelmien suojaaminen NIS2:n ja GDPR:n alaisuudessa", solution: "Tietosuoja-by-design -turvallisuuskehys terveydenhuollon painopisteellä", outcome: "NIS2-vaatimustenmukaisuus parannetulla potilastietojen suojauksella" }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna kyberturvallisuusasemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "ISO 27001 -toteutus", description: "Tietoturvallisuuden hallinta", href: "/frameworks/iso-27001" },
        { title: "Riskiarviointi", description: "Kattava riskien arviointi", href: "/frameworks/risk-assessments" },
        { title: "Tapahtumien hallinta", description: "Tietoturvatapahtumien hallinta", href: "/frameworks/incident-response" },
        { title: "Liiketoiminnan jatkuvuus", description: "BCP- ja DR-suunnittelu", href: "/frameworks/business-continuity" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan NIS2-vaatimustenmukaisuuden?",
      subtitle: "Liity suomalaisten organisaatioiden joukkoon, jotka ovat onnistuneesti toteuttaneet NIS2:n asiantuntijaohjauksellamme. Keskustellaan, kuinka voimme auttaa sinua täyttämään EU:n kyberturvallisuusvaatimukset.",
      primaryCTA: { text: "Aloita NIS2-matkasi", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/nis2" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#0F172A] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#0EA5E9] p-4 rounded-r-lg">
          <p class="text-[#0F172A] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-end mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NIS2 Requirements Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.requirements.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirements.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.requirements.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-between items-start mb-3">
              <div class="flex justify-end">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#0EA5E9]
                            transition-all duration-300
                            group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-medium text-[#0EA5E9] bg-blue-50 px-2 py-1 rounded-full border border-[#0EA5E9]">
                  {item.timeline}
                </span>
                <p class="text-xs text-red-600 mt-1 font-semibold">{item.penalty}</p>
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 mb-3">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1.5">{isFi ? 'Keskeiset kontrollit:' : 'Key Controls:'}</h4>
              <ul class="space-y-1">
                {item.controls.slice(0, 4).map((control) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {control}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Phases Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.phases.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        {currentContent.phases.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center justify-between mb-3 relative z-10">
              <h3 class="text-sm font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                {phase.phase}
              </h3>
              <span class="text-xs font-medium text-[#0EA5E9] bg-blue-50 px-2 py-1 rounded-full border border-[#0EA5E9] relative z-10">
                {phase.duration}
              </span>
            </div>
            
            <div class="grid md:grid-cols-2 gap-4 relative z-10">
              <div>
                <h4 class="font-semibold text-[#1E293B] text-xs mb-1.5">{isFi ? 'Keskeiset toimet:' : 'Key Activities:'}</h4>
                <ul class="space-y-1">
                  {phase.activities.slice(0, 5).map((activity) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {activity}
                    </li>
                  ))}
                </ul>
              </div>
              
              <div>
                <h4 class="font-semibold text-[#1E293B] text-xs mb-1.5">{isFi ? 'Tuotokset:' : 'Deliverables:'}</h4>
                <ul class="space-y-1">
                  {phase.deliverables.slice(0, 5).map((deliverable) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      {deliverable}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Examples Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.industries.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industries.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {currentContent.industries.items.map((example) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="mb-3 relative z-10">
              <span class="inline-block bg-[#0EA5E9]/10 text-[#1E293B] text-xs font-medium px-3 py-1 rounded-full group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:text-white transition-all duration-300">
                {example.industry}
              </span>
            </div>
            
            <div class="relative z-10">
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1">{isFi ? 'Haaste:' : 'Challenge:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.challenge}</p>
              
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1">{isFi ? 'Ratkaisumme:' : 'Our Solution:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.solution}</p>
              
              <h4 class="font-semibold text-[#1E293B] text-xs mb-1">{isFi ? 'Tulos:' : 'Outcome:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">{example.outcome}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.related.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.related.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-4 gap-6">
        {currentContent.related.items.map((service) => (
          <a href={service.href} class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center relative overflow-hidden block">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>


</Layout>