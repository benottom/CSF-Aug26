---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "GDPR & Data Privacy Excellence Framework | Data Protection Compliance",
  description: "Comprehensive data protection compliance with privacy-by-design implementation and sustainable privacy governance. Build robust data protection frameworks for Finnish organizations.",
  keywords: "GDPR, data privacy, data protection, privacy-by-design, DPIA, GDPR compliance, Finland",
  type: "framework" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "GDPR",
      subtitle: "Data Protection & Privacy-by-Design",
      description: "Cybersecurity.fi specializes in GDPR and data privacy compliance, helping Finnish organizations build robust data protection frameworks that safeguard personal data, ensure regulatory compliance, and create competitive advantage through privacy excellence and customer trust.",
      primaryCTA: { text: "Start GDPR Compliance Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/gdpr-privacy" }
    },
    forWho: "For organizations handling personal data of EU residents that need to achieve and maintain GDPR compliance.",
    achieve: "GDPR compliance with privacy-by-design, automated subject rights, and sustainable privacy governance.",
    overview: {
      title: "Overview",
      description: "The General Data Protection Regulation (GDPR) establishes comprehensive data protection requirements for organizations handling personal data of EU residents. Achieving compliance requires systematic implementation of privacy controls, comprehensive documentation, and ongoing management of data protection risks.",
      highlight: "Our expert team provides comprehensive GDPR implementation and privacy management services, guiding your organization through every step of the compliance journey and transforming privacy obligations into competitive advantages."
    },
    benefits: {
      title: "Why Choose Our GDPR Services",
      subtitle: "We deliver GDPR compliance with privacy-by-design principles, ensuring your organization protects personal data while maintaining business operations.",
      items: [
        { title: "Privacy-by-Design Excellence", description: "Integrate comprehensive data protection principles into every aspect of business operations, technology architecture, and organizational processes.", icon: "shield-check" },
        { title: "Finnish Legal Expertise", description: "Deep understanding of Finnish Data Protection Act, Tietosuojavaltuutettu requirements, and EU GDPR implementation with local regulatory nuances.", icon: "flag" },
        { title: "Competitive Privacy Advantage", description: "Transform privacy compliance into competitive differentiation, building customer trust and enabling premium positioning in privacy-conscious markets.", icon: "lightning" },
        { title: "Risk-Based Implementation", description: "Comprehensive Data Protection Impact Assessments (DPIAs) and risk-based approach ensuring proportionate and effective privacy controls.", icon: "chart-line" },
        { title: "Sustainable Compliance", description: "Ongoing monitoring, continuous improvement, and adaptive privacy governance ensuring long-term compliance as regulations evolve.", icon: "refresh" },
        { title: "Cost-Effective Implementation", description: "Efficient privacy program implementation that maximizes compliance value while minimizing operational overhead.", icon: "currency-euro" }
      ]
    },
    requirements: {
      title: "GDPR Compliance Requirements",
      subtitle: "Our GDPR implementation covers all key requirements, ensuring comprehensive compliance with EU data protection standards.",
      items: [
        { title: "Data Processing Principles & Legal Basis", description: "Implement lawful, fair, and transparent data processing practices with clearly established legal basis", icon: "balance-scale", penalty: "Up to €20M or 4% annual turnover", timeline: "2-4 months", controls: ["Legal basis identification and documentation", "Purpose limitation assessments", "Data minimization and necessity evaluations", "Accuracy maintenance and storage limitation", "Integrity, confidentiality, and accountability frameworks"] },
        { title: "Data Subject Rights Management", description: "Enable individuals to exercise their comprehensive GDPR rights effectively with automated systems", icon: "user-circle", penalty: "Individual fines up to €20M or 4% annual turnover", timeline: "3-6 months", controls: ["Access request fulfillment within 30 days", "Rectification and correction procedures", "Right to erasure (right to be forgotten)", "Data portability and structured export", "Right to object and automated decision-making opt-outs"] },
        { title: "Data Protection Impact Assessment (DPIA)", description: "Conduct systematic privacy impact assessments for high-risk processing activities", icon: "magnifying-glass", penalty: "Processing prohibition until compliant DPIA completed", timeline: "4-8 weeks", controls: ["DPIA methodology and risk identification", "Stakeholder consultation and expert review", "Mitigation measures and risk assessment", "Documentation and ongoing monitoring", "Prior consultation with supervisory authority"] },
        { title: "Data Breach Notification & Response", description: "Implement comprehensive data breach detection, assessment, notification, and response capabilities", icon: "exclamation-triangle", penalty: "€10M or 2% annual turnover", timeline: "Immediate", controls: ["72-hour supervisory authority notification", "Data subject notification without undue delay when required", "Breach detection and assessment", "Documentation and evidence preservation", "Recovery procedures and lessons learned"] },
        { title: "Privacy Governance & Documentation", description: "Establish comprehensive privacy governance framework with complete documentation", icon: "document-text", penalty: "€10M or 2% annual turnover", timeline: "6-12 months", controls: ["Privacy policies and procedure documentation", "Record of processing activities (Article 30)", "Privacy governance and management oversight", "Staff training and competency tracking", "Regular compliance audits and assessments"] },
        { title: "International Transfers & Third Parties", description: "Ensure lawful international data transfers and comprehensive third-party data processing agreements", icon: "globe", penalty: "€20M or 4% annual turnover", timeline: "3-6 months", controls: ["Transfer impact assessments", "Standard Contractual Clauses (SCCs)", "Binding Corporate Rules (BCRs)", "Data processing agreements (DPAs)", "Sub-processor management"] }
      ]
    },
    phases: {
      title: "20-Week Implementation Roadmap",
      subtitle: "Structured approach ensuring successful GDPR compliance within 20 weeks while maintaining business operations.",
      items: [
        { phase: "Phase 1: Assessment & Mapping", duration: "Weeks 1-4", activities: ["Data Inventory", "Processing Activities", "Legal Basis Review", "Risk Assessment"], deliverables: ["Data Map", "Processing Register", "Legal Basis Matrix", "Risk Register"] },
        { phase: "Phase 2: Framework Design", duration: "Weeks 5-8", activities: ["Policy Development", "Process Design", "Training Materials", "Technology Assessment"], deliverables: ["Privacy Policy", "Process Maps", "Training Program", "Technology Roadmap"] },
        { phase: "Phase 3: Implementation", duration: "Weeks 9-16", activities: ["Control Implementation", "Training Delivery", "Testing", "Documentation"], deliverables: ["Implemented Controls", "Training Records", "Test Results", "Compliance Documentation"] },
        { phase: "Phase 4: Validation & Monitoring", duration: "Weeks 17-20", activities: ["Compliance Testing", "Audit Preparation", "Monitoring Setup", "Continuous Improvement"], deliverables: ["Compliance Report", "Audit Readiness", "Monitoring Dashboard", "Improvement Plan"] }
      ]
    },
    industries: {
      title: "Industry-Specific Success Stories",
      subtitle: "See how we've helped organizations across different industries achieve GDPR compliance.",
      items: [
        { industry: "Healthcare", challenge: "Protecting patient data under GDPR while maintaining care quality", solution: "Privacy-by-design healthcare framework with patient consent management", outcome: "GDPR compliance with enhanced patient trust and data protection" },
        { industry: "E-commerce", challenge: "Managing customer consent and data across multiple touchpoints", solution: "Integrated consent management platform with transparent data practices", outcome: "GDPR compliance with improved customer experience and trust" },
        { industry: "Financial Services", challenge: "Balancing GDPR requirements with financial services regulations", solution: "Unified compliance framework addressing both GDPR and FIN-FSA requirements", outcome: "Comprehensive compliance with reduced regulatory complexity" }
      ]
    },
    related: {
      title: "Related Services",
      subtitle: "Enhance your data protection posture with our complementary services and frameworks.",
      items: [
        { title: "ISO 27001 Implementation", description: "Information security management", href: "/frameworks/iso-27001" },
        { title: "Data Protection Impact Assessment", description: "Privacy risk evaluation", href: "/frameworks/dpia" },
        { title: "Third-Party Risk Management", description: "Supplier data protection", href: "/frameworks/tprm" },
        { title: "Incident Response", description: "Data breach management", href: "/frameworks/incident-response" }
      ]
    },
    cta: {
      title: "Ready to Achieve GDPR Compliance?",
      subtitle: "Join Finnish organizations that have successfully implemented GDPR with our expert guidance. Let's discuss how we can help you protect personal data while maintaining business operations.",
      primaryCTA: { text: "Start Your GDPR Journey", href: "/contact" },
      secondaryCTA: { text: "View Our Services", href: "/services/gdpr-privacy" }
    }
  },
  fi: {
    hero: {
      title: "GDPR",
      subtitle: "Tietosuoja & tietosuoja-by-design",
      description: "Cybersecurity.fi on erikoistunut GDPR- ja tietosuojan vaatimustenmukaisuuteen auttaen suomalaisia organisaatioita rakentamaan vankkoja tietosuojakehyksiä, jotka turvaavat henkilötiedot, varmistavat sääntelyn vaatimustenmukaisuuden ja luovat kilpailuetua tietosuojan huippuosaamisen ja asiakasluottamuksen kautta.",
      primaryCTA: { text: "Aloita GDPR-vaatimustenmukaisuusmatka", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/gdpr-privacy" }
    },
    forWho: "Organisaatioille, jotka käsittelevät EU:n asukkaiden henkilötietoja ja joiden on saavutettava ja ylläpidettävä GDPR-vaatimustenmukaisuus.",
    achieve: "GDPR-vaatimustenmukaisuus tietosuoja-by-designilla, automatisoiduilla rekisteröityjen oikeuksilla ja kestävällä tietosuojahallinnalla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Yleinen tietosuoja-asetus (GDPR) asettaa kattavat tietosuojavaatimukset organisaatioille, jotka käsittelevät EU:n asukkaiden henkilötietoja. Vaatimustenmukaisuuden saavuttaminen vaatii tietosuojakontrollien systemaattista käyttöönottoa, kattavaa dokumentointia ja tietosuojariskien jatkuvaa hallintaa.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia GDPR-toteutus- ja tietosuojahallintapalveluita ohjaten organisaatiosi jokaisen vaatimustenmukaisuusmatkan vaiheen läpi ja muuttaen tietosuojavelvoitteet kilpailueduiksi."
    },
    benefits: {
      title: "Miksi valita GDPR-palvelumme",
      subtitle: "Tarjoamme GDPR-vaatimustenmukaisuuden tietosuoja-by-design-periaatteilla varmistaen, että organisaatiosi suojaa henkilötietoja samalla kun ylläpidät liiketoimintaa.",
      items: [
        { title: "Tietosuoja-by-design -huippuosaaminen", description: "Integroi kattavat tietosuojausperiaatteet kaikkiin liiketoiminnan osa-alueisiin, teknologia-arkkitehtuuriin ja organisaation prosesseihin.", icon: "shield-check" },
        { title: "Suomalainen laki-asiantuntemus", description: "Syvä ymmärrys Suomen tietosuojalaista, tietosuojavaltuutetun vaatimuksista ja EU:n GDPR-toteutuksesta paikallisin sääntelyvivahteineen.", icon: "flag" },
        { title: "Kilpailuetu tietosuojasta", description: "Muuta tietosuojan vaatimustenmukaisuus kilpailulliseksi erottautumistekijäksi, rakentaen asiakasluottamusta ja mahdollistaen premium-asemoinnin tietosuojatietoisilla markkinoilla.", icon: "lightning" },
        { title: "Riskipohjainen toteutus", description: "Kattavat tietosuojan vaikutusten arvioinnit (DPIA) ja riskipohjainen lähestymistapa oikeasuhteisten ja tehokkaiden tietosuojakontrollien varmistamiseksi.", icon: "chart-line" },
        { title: "Kestävä vaatimustenmukaisuus", description: "Jatkuva seuranta, jatkuva parantaminen ja mukautuva tietosuojahallinta pitkäaikaisen vaatimustenmukaisuuden varmistamiseksi.", icon: "refresh" },
        { title: "Kustannustehokas toteutus", description: "Tehokas tietosuojaohjelman toteutus, joka maksimoi vaatimustenmukaisuuden arvon samalla kun minimoi operatiiviset kustannukset.", icon: "currency-euro" }
      ]
    },
    requirements: {
      title: "GDPR-vaatimustenmukaisuusvaatimukset",
      subtitle: "GDPR-toteutuksemme kattaa kaikki keskeiset vaatimukset varmistaen kattavan vaatimustenmukaisuuden EU:n tietosuojastandardien kanssa.",
      items: [
        { title: "Tietojenkäsittelyperiaatteet & oikeusperusteet", description: "Toteuta lainmukaiset, oikeudenmukaiset ja läpinäkyvät tietojenkäsittelykäytännöt selkeästi määritellyin oikeusperustein", icon: "balance-scale", penalty: "Jopa 20 miljoonaa euroa tai 4% vuosiliikevaihdosta", timeline: "2-4 kuukautta", controls: ["Oikeusperusteen tunnistaminen ja dokumentointi", "Tarkoitussidonnaisuuden arvioinnit", "Tietojen minimointi ja tarpeellisuusarvioinnit", "Tarkkuuden ylläpito ja säilytyksen rajoittaminen", "Eheys, luottamuksellisuus ja vastuullisuuskehykset"] },
        { title: "Rekisteröityjen oikeuksien hallinta", description: "Mahdollista yksilöiden heille kuuluvien GDPR-oikeuksien tehokas käyttö automatisoiduilla järjestelmillä", icon: "user-circle", penalty: "Yksilölliset sakot jopa 20 miljoonaa euroa", timeline: "3-6 kuukautta", controls: ["Tarkastuspyyntöjen toteutus 30 päivässä", "Oikaisu- ja korjausmenettelyt", "Oikeus tulla unohdetuksi", "Tietojen siirrettävyys ja jäsennelty vienti", "Vastustamisoikeus ja automatisoidun päätöksenteon poistumismahdollisuudet"] },
        { title: "Tietosuojan vaikutusten arviointi (DPIA)", description: "Suorita systemaattiset tietosuojan vaikutusten arvioinnit riskialttiille tietojenkäsittelytoimille", icon: "magnifying-glass", penalty: "Käsittelyn kieltäminen, kunnes vaatimustenmukainen DPIA on suoritettu", timeline: "4-8 viikkoa", controls: ["DPIA-menetelmä ja riskien tunnistaminen", "Sidosryhmien kuuleminen ja asiantuntija-arviointi", "Hallintatoimenpiteet ja jäännösriskin arviointi", "Dokumentointi ja jatkuva seuranta", "Ennakkokuuleminen valvontaviranomaisen kanssa"] },
        { title: "Tietoturvaloukkauksen ilmoitus & reagointi", description: "Toteuta kattavat tietoturvaloukkauksen havaitsemis-, arviointi-, ilmoitus- ja reagointikyvykkyydet", icon: "exclamation-triangle", penalty: "10 miljoonaa euroa tai 2% vuosiliikevaihdosta", timeline: "Välitön", controls: ["72 tunnin ilmoitus valvontaviranomaiselle", "Rekisteröidylle ilmoittaminen ilman aiheetonta viivytystä tarvittaessa", "Loukkauksen havaitseminen ja arviointi", "Dokumentointi ja todisteiden säilytys", "Palautusmenettelyt ja opitut asiat"] },
        { title: "Tietosuojahallinta & dokumentointi", description: "Perusta kattava tietosuojahallintakehys täydellisine dokumentaatioineen", icon: "document-text", penalty: "10 miljoonaa euroa tai 2% vuosiliikevaihdosta", timeline: "6-12 kuukautta", controls: ["Tietosuojakäytännöt ja menettelydokumentaatio", "Kirjanpito käsittelytoimista (artikla 30)", "Tietosuojahallinta ja johdon valvonta", "Henkilöstön koulutus ja osaamisen seuranta", "Säännölliset vaatimustenmukaisuusauditoinnit ja arvioinnit"] },
        { title: "Kansainväliset siirrot & kolmannet osapuolet", description: "Varmista lainmukaiset kansainväliset tietosiirrot ja kattavat kolmannen osapuolen tietojenkäsittelysopimukset", icon: "globe", penalty: "Siirron keskeyttäminen ja 20 miljoonaa euroa", timeline: "3-6 kuukautta", controls: ["Siirron vaikutusten arvioinnit", "Vakiosopimuslausekkeet (SCC)", "Sitovat yrityssäännöt (BCR)", "Tietojenkäsittelysopimukset (DPA)", "Alikäsittelijöiden hallinta"] }
      ]
    },
    phases: {
      title: "20 viikon toteutussuunnitelma",
      subtitle: "Rakenteinen lähestymistapa varmistaa onnistuneen GDPR-vaatimustenmukaisuuden 20 viikon kuluessa samalla kun liiketoiminta säilyy.",
      items: [
        { phase: "Vaihe 1: Arviointi ja kartoitus", duration: "Viikot 1-4", activities: ["Tietoinventaario", "Käsittelytoimet", "Oikeusperustan katselmointi", "Riskinarviointi"], deliverables: ["Tietokartta", "Käsittelyrekisteri", "Oikeusperustamatriisi", "Riskirekisteri"] },
        { phase: "Vaihe 2: Kehyksen suunnittelu", duration: "Viikot 5-8", activities: ["Politiikkojen kehitys", "Prosessien suunnittelu", "Koulutusmateriaalit", "Teknologian arviointi"], deliverables: ["Tietosuojakäytäntö", "Prosessikartat", "Koulutusohjelma", "Teknologian tiekartta"] },
        { phase: "Vaihe 3: Toteutus", duration: "Viikot 9-16", activities: ["Kontrollien toteutus", "Koulutusten toteutus", "Testaus", "Dokumentointi"], deliverables: ["Toteutetut kontrollit", "Koulutustiedot", "Testitulokset", "Vaatimustenmukaisuusdokumentaatio"] },
        { phase: "Vaihe 4: Validointi ja seuranta", duration: "Viikot 17-20", activities: ["Vaatimustenmukaisuustestaus", "Auditointivalmistelu", "Seurannan asennus", "Jatkuva parantaminen"], deliverables: ["Vaatimustenmukaisuusraportti", "Auditointivalmius", "Seurannan hallintapaneeli", "Parannussuunnitelma"] }
      ]
    },
    industries: {
      title: "Toimialakohtaiset menestystarinat",
      subtitle: "Katso, kuinka olemme auttaneet organisaatioita eri toimialoilla saavuttamaan GDPR-vaatimustenmukaisuuden.",
      items: [
        { industry: "Terveydenhuolto", challenge: "Potilastietojen suojaaminen GDPR:n mukaisesti samalla kun hoidon laatu säilyy", solution: "Tietosuoja-by-design -terveydenhuoltokehys potilaan suostumushallinnalla", outcome: "GDPR-vaatimustenmukaisuus parannetulla potilasluottamuksella ja tietosuojalla" },
        { industry: "Verkkokauppa", challenge: "Asiakassuostumuksen ja tietojen hallinta useissa kosketuspisteissä", solution: "Integroitu suostumushallinta-alusta läpinäkyvillä tietokäytännöillä", outcome: "GDPR-vaatimustenmukaisuus parannetulla asiakaskokemuksella ja luottamuksella" },
        { industry: "Rahoituspalvelut", challenge: "GDPR-vaatimusten ja rahoituspalvelusäädösten tasapainottaminen", solution: "Yhtenäinen vaatimustenmukaisuuskehys, joka kattaa sekä GDPR:n että FIN-FSA-vaatimukset", outcome: "Kattava vaatimustenmukaisuus vähentyneellä sääntelyn monimutkaisuudella" }
      ]
    },
    related: {
      title: "Aiheeseen liittyvät palvelut",
      subtitle: "Paranna tietosuoja-asemaasi täydentävillä palveluillamme ja kehyksillämme.",
      items: [
        { title: "ISO 27001 -toteutus", description: "Tietoturvallisuuden hallinta", href: "/frameworks/iso-27001" },
        { title: "Tietosuojan vaikutusten arviointi", description: "Tietosuojariskien arviointi", href: "/frameworks/dpia" },
        { title: "Kolmannen osapuolen riskienhallinta", description: "Toimittajan tietosuoja", href: "/frameworks/tprm" },
        { title: "Tapahtumien hallinta", description: "Tietoturvaloukkauksen hallinta", href: "/frameworks/incident-response" }
      ]
    },
    cta: {
      title: "Valmis saavuttamaan GDPR-vaatimustenmukaisuuden?",
      subtitle: "Liity suomalaisten organisaatioiden joukkoon, jotka ovat onnistuneesti toteuttaneet GDPR:n asiantuntijaohjauksellamme. Keskustellaan, kuinka voimme auttaa sinua suojaamaan henkilötietoja samalla kun ylläpidät liiketoimintaa.",
      primaryCTA: { text: "Aloita GDPR-matkasi", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services/gdpr-privacy" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#131c2e] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#003580] p-4 rounded-r-lg">
          <p class="text-[#131c2e] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-end mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GDPR Requirements Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.requirements.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirements.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.requirements.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group">
            
            <div class="flex justify-between items-start mb-3">
              <div class="flex justify-end">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              <div class="text-right">
                <span class="text-xs font-medium text-[#003580] bg-blue-50 px-2 py-1 rounded-[2px] border border-[#003580]">
                  {item.timeline}
                </span>
                <p class="text-xs text-red-600 mt-1 font-semibold">{item.penalty}</p>
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left">
              {item.title}
            </h3>
            
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 mb-3">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Keskeiset kontrollit:' : 'Key Controls:'}</h4>
              <ul class="space-y-1">
                {item.controls.slice(0, 4).map((control) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {control}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Phases Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.phases.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        {currentContent.phases.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center justify-between mb-3 relative z-10">
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {phase.phase}
              </h3>
              <span class="text-xs font-medium text-[#003580] bg-blue-50 px-2 py-1 rounded-[2px] border border-[#003580] relative z-10">
                {phase.duration}
              </span>
            </div>
            
            <div class="grid md:grid-cols-2 gap-4 relative z-10">
              <div>
                <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Keskeiset toimet:' : 'Key Activities:'}</h4>
                <ul class="space-y-1">
                  {phase.activities.map((activity) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      {activity}
                    </li>
                  ))}
                </ul>
              </div>
              
              <div>
                <h4 class="font-semibold text-[#14171a] text-xs mb-1.5">{isFi ? 'Tuotokset:' : 'Deliverables:'}</h4>
                <ul class="space-y-1">
                  {phase.deliverables.map((deliverable) => (
                    <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                      <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                      </svg>
                      {deliverable}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Examples Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.industries.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industries.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {currentContent.industries.items.map((example) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="mb-3 relative z-10">
              <span class="inline-block bg-[#003580]/10 text-[#14171a] text-xs font-medium px-3 py-1 rounded-[2px] group-hover:bg-[#003580] group-hover:text-white transition-all duration-300">
                {example.industry}
              </span>
            </div>
            
            <div class="relative z-10">
              <h4 class="font-semibold text-[#14171a] text-xs mb-1">{isFi ? 'Haaste:' : 'Challenge:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.challenge}</p>
              
              <h4 class="font-semibold text-[#14171a] text-xs mb-1">{isFi ? 'Ratkaisumme:' : 'Our Solution:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 mb-3">{example.solution}</p>
              
              <h4 class="font-semibold text-[#14171a] text-xs mb-1">{isFi ? 'Tulos:' : 'Outcome:'}</h4>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">{example.outcome}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.related.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.related.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-4 gap-6">
        {currentContent.related.items.map((service) => (
          <a href={service.href} class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group text-center relative overflow-hidden block">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-8 md:p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-slate-900">
          {currentContent.cta.title}
        </h2>

        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          {currentContent.cta.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          
          <a href={currentContent.cta.primaryCTA.href} 
             class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium gap-2">
            {currentContent.cta.primaryCTA.text}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          
          <a href={currentContent.cta.secondaryCTA.href} 
             class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
            {currentContent.cta.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

      </div>
    </div>
  </section>

</Layout>