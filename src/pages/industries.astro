---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Industry Solutions | Cybersecurity for Regulated Industries",
  description: "Specialized cybersecurity expertise across regulated industries with deep understanding of sector-specific compliance requirements. Tailored solutions for financial services, healthcare, manufacturing, and more.",
  keywords: "industry solutions, cybersecurity, financial services, healthcare, manufacturing, critical infrastructure, Finland",
  type: "industry" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Industries We Serve",
      subtitle: "Specialized cybersecurity expertise across regulated industries",
      description: "We deliver tailored cybersecurity solutions that address the unique challenges, risks, and regulatory requirements of your industry. Our deep industry expertise allows us to provide targeted cybersecurity solutions that address sector-specific risks and regulatory requirements.",
      primaryCTA: { text: "Explore Industries", href: "#industries" },
      secondaryCTA: { text: "Get Industry Assessment", href: "/contact?assessment=true" }
    },
    industries: {
      title: "Industries We Serve",
      subtitle: "Our deep industry expertise allows us to provide targeted cybersecurity solutions that address sector-specific risks and regulatory requirements.",
      items: [
        {
          title: "Financial Services & Fintech",
          description: "Specialized DORA, PCI DSS, and operational resilience expertise for banks, payment processors, and fintech companies.",
          icon: "building-library",
          href: "/industries/financial-services-fintech",
          challenges: ["DORA compliance requirements", "PCI DSS certification", "Operational resilience testing", "Anti-fraud controls"]
        },
        {
          title: "SaaS & Technology",
          description: "ISO 27001, SOC 2, and cloud security frameworks tailored for software companies and technology service providers.",
          icon: "code",
          href: "/industries/saas-technology",
          challenges: ["SOC 2 Type II certification", "ISO 27001 implementation", "Cloud security architecture", "DevSecOps integration"]
        },
        {
          title: "Healthcare & Life Sciences",
          description: "GDPR, medical device regulations, and patient data protection compliance for healthcare organizations and life sciences companies.",
          icon: "heart",
          href: "/industries/healthcare-life-sciences",
          challenges: ["Patient data protection", "Medical device security", "GDPR compliance", "Clinical trial data security"]
        },
        {
          title: "Critical Infrastructure",
          description: "NIS2 directive implementation, operational technology security, and resilience planning for essential service providers.",
          icon: "bolt",
          href: "/industries/critical-infrastructure-energy",
          challenges: ["NIS2 directive compliance", "OT/IT security convergence", "SCADA protection", "Business continuity planning"]
        },
        {
          title: "Public Sector",
          description: "Government-specific compliance frameworks, public procurement requirements, and citizen data protection standards.",
          icon: "building",
          href: "/industries/public-sector-finland",
          challenges: ["National security frameworks", "Citizen data protection", "EU procurement compliance", "Inter-agency security"]
        },
        {
          title: "Manufacturing & Industrial",
          description: "Industrial IoT security, supply chain protection, and operational continuity for manufacturing and industrial organizations.",
          icon: "cog",
          href: "/industries/manufacturing-industrial",
          challenges: ["Industrial IoT security", "Supply chain protection", "Production system resilience", "Industry 4.0 security"]
        }
      ]
    },
    expertise: {
      title: "Industry Expertise",
      subtitle: "Our team combines deep cybersecurity knowledge with industry-specific experience.",
      items: [
        { title: "Regulatory Expertise", description: "Deep understanding of industry-specific regulations and compliance requirements.", icon: "document-check" },
        { title: "Rapid Response", description: "Quick implementation of security measures tailored to your industry's pace.", icon: "bolt" },
        { title: "Sector Networks", description: "Strong relationships within industry sectors for knowledge sharing and collaboration.", icon: "users" },
        { title: "Proven Results", description: "Track record of successful implementations across various industry sectors.", icon: "trending-up" }
      ]
    },
    cta: {
      title: "Ready to Secure Your Industry?",
      subtitle: "Get industry-specific cybersecurity solutions tailored to your sector's unique challenges and requirements.",
      primaryCTA: { text: "Schedule Consultation", href: "/contact?consultation=true" },
      secondaryCTA: { text: "View Our Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      title: "Toimialat joita palvelemme",
      subtitle: "Erikoistunut kyberturvallisuusasiantuntemus säännellyillä toimialoilla",
      description: "Tarjoamme räätälöityjä kyberturvallisuusratkaisuja, jotka vastaavat toimialasi ainutlaatuisiin haasteisiin, riskeihin ja sääntelyvaatimuksiin. Syvä toimialaosaamisemme antaa meille mahdollisuuden tarjota kohdennettuja kyberturvallisuusratkaisuja, jotka vastaavat toimialakohtaisiin riskeihin ja sääntelyvaatimuksiin.",
      primaryCTA: { text: "Tutustu toimialoihin", href: "#industries" },
      secondaryCTA: { text: "Pyydä toimiala-arviointi", href: "/contact?assessment=true" }
    },
    industries: {
      title: "Toimialat joita palvelemme",
      subtitle: "Syvä toimialaosaamisemme antaa meille mahdollisuuden tarjota kohdennettuja kyberturvallisuusratkaisuja, jotka vastaavat toimialakohtaisiin riskeihin ja sääntelyvaatimuksiin.",
      items: [
        {
          title: "Rahoituspalvelut & Fintech",
          description: "Erikoistunut DORA-, PCI DSS- ja operatiivinen resilienssiasiantuntemus pankeille, maksunvälittäjille ja fintech-yrityksille.",
          icon: "building-library",
          href: "/industries/financial-services-fintech",
          challenges: ["DORA-vaatimustenmukaisuus", "PCI DSS -sertifiointi", "Operatiivinen resilienssitestaus", "Petostentorjuntakontrollit"]
        },
        {
          title: "SaaS & Teknologia",
          description: "ISO 27001, SOC 2 ja pilvipalveluiden turvallisuuskehykset räätälöitynä ohjelmistoyrityksille ja teknologiapalveluntarjoajille.",
          icon: "code",
          href: "/industries/saas-technology",
          challenges: ["SOC 2 Type II -sertifiointi", "ISO 27001 -toteutus", "Pilvipalveluiden turvallisuusarkkitehtuuri", "DevSecOps-integraatio"]
        },
        {
          title: "Terveydenhuolto & Biotieteet",
          description: "GDPR, lääkinnällisten laitteiden määräykset ja potilastietosuojavaatimusten mukaisuus terveydenhuollon organisaatioille ja biotieteen yrityksille.",
          icon: "heart",
          href: "/industries/healthcare-life-sciences",
          challenges: ["Potilastietosuoja", "Lääkinnällisten laitteiden turvallisuus", "GDPR-vaatimustenmukaisuus", "Kliinisen tutkimusdatan turvallisuus"]
        },
        {
          title: "Kriittinen infrastruktuuri",
          description: "NIS2-direktiivin toteutus, operatiivisen teknologian turvallisuus ja resilienssisuunnittelu välttämättömille palveluntarjoajille.",
          icon: "bolt",
          href: "/industries/critical-infrastructure-energy",
          challenges: ["NIS2-direktiivin vaatimustenmukaisuus", "OT/IT-turvallisuusintegraatio", "SCADA-suojaus", "Liiketoiminnan jatkuvuussuunnittelu"]
        },
        {
          title: "Julkinen sektori",
          description: "Julkishallinnon erityiset vaatimustenmukaisuuskehykset, julkiset hankintavaatimukset ja kansalaistietosuojastandardit.",
          icon: "building",
          href: "/industries/public-sector-finland",
          challenges: ["Kansalliset turvallisuuskehykset", "Kansalaistietosuoja", "EU:n hankintavaatimustenmukaisuus", "Viranomaisyhteistyön turvallisuus"]
        },
        {
          title: "Teollisuus & Valmistus",
          description: "Teollisen IoT:n turvallisuus, toimitusketjun suojaaminen ja operatiivinen jatkuvuus valmistus- ja teollisuusorganisaatioille.",
          icon: "cog",
          href: "/industries/manufacturing-industrial",
          challenges: ["Teollinen IoT-turvallisuus", "Toimitusketjun suojaaminen", "Tuotantojärjestelmien resilienssi", "Teollisuus 4.0 -turvallisuus"]
        }
      ]
    },
    expertise: {
      title: "Toimialaosaaminen",
      subtitle: "Tiimimme yhdistää syvällisen kyberturvallisuustietämyksen toimialakohtaiseen kokemukseen.",
      items: [
        { title: "Sääntelyasiantuntemus", description: "Syvä ymmärrys toimialakohtaisista säännöksistä ja vaatimustenmukaisuusvaatimuksista.", icon: "document-check" },
        { title: "Nopea reagointi", description: "Nopea turvatoimien toteutus räätälöitynä toimialasi tahtiin.", icon: "bolt" },
        { title: "Toimialaverkostot", description: "Vahvat suhteet toimialasektoreilla tiedonjakoa ja yhteistyötä varten.", icon: "users" },
        { title: "Todistetut tulokset", description: "Menestyksekäs toteutus historia useilla toimialasektoreilla.", icon: "trending-up" }
      ]
    },
    cta: {
      title: "Valmis turvaamaan toimialasi?",
      subtitle: "Hanki toimialakohtaisia kyberturvallisuusratkaisuja, jotka on räätälöity sektorisi ainutlaatuisiin haasteisiin ja vaatimuksiin.",
      primaryCTA: { text: "Varaa konsultaatio", href: "/contact?consultation=true" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services" }
    }
  }
};

const currentContent = content[lang];
---

<Layout {...seoConfig}>

<!-- Hero Section - Centered, NO image -->
<section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 py-20 md:py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <div class="flex justify-center mb-4">
      <div class="w-16 h-16 bg-blue-100 rounded-2xl flex items-center justify-center">
        <Icon name="building-library" class="w-8 h-8 text-[#0F172A]" />
      </div>
    </div>
    
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-4 text-[#0F172A]">
      {currentContent.hero.title}
    </h1>
    
    <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
      {currentContent.hero.subtitle}
    </p>
    
    <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed mb-10">
      {currentContent.hero.description}
    </p>
    
    <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 justify-center">
      <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#0F172A] to-[#0EA5E9] text-white rounded-full hover:from-[#0EA5E9] hover:to-[#0F172A] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
        {currentContent.hero.primaryCTA.text}
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
      
      <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#1E293B] text-[#1E293B] rounded-full hover:bg-gradient-to-r hover:from-[#0F172A] hover:to-[#0EA5E9] hover:text-white transition-all duration-300 font-medium text-sm sm:text-base">
        {currentContent.hero.secondaryCTA.text}
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Industries Section -->
<section id="industries" class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0F172A] mb-4">
        {currentContent.industries.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.industries.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {currentContent.industries.items.map((industry) => (
        <div class="bg-slate-50/50 rounded-xl border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    flex flex-col h-full p-6 group">
          
          <div class="flex justify-end mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#0F172A] group-hover:to-[#0EA5E9] group-hover:shadow-lg">
              <Icon name={industry.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300 text-left">
            {industry.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed text-left mb-4">
            {industry.description}
          </p>
          
          <div class="mt-auto">
            <h4 class="font-semibold text-slate-800 text-sm mb-2">Key Challenges:</h4>
            <ul class="space-y-1.5">
              {industry.challenges.map((challenge) => (
                <li class="flex items-start text-xs text-slate-500">
                  <svg class="w-3 h-3 text-green-500 mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  {challenge}
                </li>
              ))}
            </ul>
          </div>
          
          <div class="mt-5 pt-4 border-t border-slate-100">
            <a href={industry.href} class="inline-flex items-center justify-center w-full px-4 py-2.5 rounded-full border-2 border-[#1E293B] text-[#1E293B] hover:bg-gradient-to-r hover:from-[#0F172A] hover:to-[#0EA5E9] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5">
              Learn More
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Expertise Section -->
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0F172A] mb-4">
        {currentContent.expertise.title}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
        {currentContent.expertise.subtitle}
      </p>
    </div>
    
    <div class="grid md:grid-cols-4 gap-8">
      {currentContent.expertise.items.map((item) => (
        <div class="bg-slate-50/50 rounded-xl p-6 text-center border border-slate-100
                    hover:border-blue-300 hover:bg-slate-50
                    hover:shadow-xl hover:-translate-y-2
                    transition-all duration-300
                    group">
          
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#0F172A] group-hover:to-[#0EA5E9] group-hover:shadow-lg">
              <Icon name={item.icon} class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-lg font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors duration-300">
            {item.title}
          </h3>
          
          <p class="text-slate-500 text-sm leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-16 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
      
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-slate-900">
        {currentContent.cta.title}
      </h2>

      <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
        {currentContent.cta.subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        
        <a href={currentContent.cta.primaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#0F172A] to-[#0EA5E9] text-white hover:from-[#0EA5E9] hover:to-[#0F172A] transition-all duration-300 hover:shadow-lg font-medium gap-2">
          {currentContent.cta.primaryCTA.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        
        <a href={currentContent.cta.secondaryCTA.href} 
           class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E293B] text-[#1E293B] hover:bg-gradient-to-r hover:from-[#0F172A] hover:to-[#0EA5E9] hover:text-white hover:border-transparent transition-all duration-300 font-medium">
          {currentContent.cta.secondaryCTA.text}
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>

</Layout>