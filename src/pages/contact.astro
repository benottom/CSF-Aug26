---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Ota yhteyttä" : "Contact",
  description: lang === 'fi'
    ? "Ota yhteyttä Cyber Security Finlandin kyberturvallisuusasiantuntijoihin."
    : "Contact Cyber Security Finland's cybersecurity experts.",
  type: "page" as const,
};

const content = {
  en: {
    title: "Contact",
    subtitle: "Get in Touch",
    description: "Connect with our team of cybersecurity experts. We're here to help you with your security challenges.",
  },
  fi: {
    title: "Yhteystiedot",
    subtitle: "Ota yhteyttä",
    description: "Ota yhteyttä kyberturvallisuusasiantuntijatiimiimme. Olemme täällä auttamassa sinua turvallisuushaasteissasi.",
  }
};

const c = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {c.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {c.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information Cards -->
  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Phone -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
            <Icon name="phone" class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">Phone</h3>
          <p class="text-sm text-slate-500">+358 44 5040308</p>
          <p class="text-xs text-slate-400 mt-1">{isFi ? 'Ma-Pe, 9:00-17:00' : 'Mon-Fri, 9:00-17:00'}</p>
        </div>

        <!-- Email -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
            <Icon name="mail" class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">Email</h3>
          <p class="text-sm text-slate-500">info@cybersecurity.fi</p>
          <p class="text-xs text-slate-400 mt-1">{isFi ? 'Vastaamme 24 tunnin sisällä' : 'We respond within 24h'}</p>
        </div>

        <!-- Location -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
            <Icon name="map-pin" class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">Location</h3>
          <p class="text-sm text-slate-500">Helsinki, Finland</p>
          <p class="text-xs text-slate-400 mt-1">{isFi ? 'Palvelemme asiakkaita maailmanlaajuisesti' : 'Serving clients globally'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="text-2xl md:text-3xl font-bold text-[#3B82F6] mb-6">{isFi ? 'Lähetä viesti' : 'Send Us a Message'}</h2>
          <form class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 md:p-8">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Etunimi *' : 'First Name *'}</label>
                <input type="text" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna etunimesi' : 'Enter your first name'}>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Sukunimi *' : 'Last Name *'}</label>
                <input type="text" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna sukunimesi' : 'Enter your last name'}>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-6 mt-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Yritys' : 'Company'}</label>
                <input type="text" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna yrityksesi nimi' : 'Enter your company name'}>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Sähköposti *' : 'Email *'}</label>
                <input type="email" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna sähköpostiosoitteesi' : 'Enter your email address'}>
              </div>
            </div>
            <div class="grid md:grid-cols-2 gap-6 mt-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Puhelinnumero' : 'Phone Number'}</label>
                <input type="tel" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna puhelinnumerosi' : 'Enter your phone number'}>
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Kiinnostuksen kohde' : 'Service Interest'}</label>
                <select class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white">
                  <option value="">{isFi ? 'Valitse palvelu' : 'Select a service'}</option>
                  <option value="iso-27001">ISO 27001 Certification</option>
                  <option value="nis2">NIS2 Compliance</option>
                  <option value="gdpr">GDPR & Privacy</option>
                  <option value="dora">DORA Compliance</option>
                  <option value="soc2">SOC2 Readiness</option>
                  <option value="ciso">CISO as a Service</option>
                  <option value="dpo">DPO as a Service</option>
                  <option value="risk">Risk Assessment</option>
                  <option value="other">{isFi ? 'Muu / Yleinen tiedustelu' : 'Other/General Inquiry'}</option>
                </select>
              </div>
            </div>
            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Viesti *' : 'Message *'}</label>
              <textarea rows="5" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#3B82F6] focus:ring-2 focus:ring-[#3B82F6]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Kuvaile tarpeitasi tai kysymyksiäsi...' : 'Describe your needs or questions...'}></textarea>
            </div>
            <div class="mt-6">
              <button type="submit" class="w-full md:w-auto inline-flex items-center justify-center px-8 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm">
                {isFi ? 'Lähetä viesti' : 'Send Message'}
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          </form>
        </div>
        
        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300">
            <h3 class="text-base font-bold text-[#1E40AF] mb-3 group-hover:text-[#3bb1f6] transition-colors duration-300">{isFi ? 'Palvelumme' : 'Our Services'}</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">ISO 27001</span> — {isFi ? 'Täydellinen ISMS-toteutus 90 päivässä' : 'Complete ISMS implementation in 90 days'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">NIS2 Compliance</span> — {isFi ? 'Valmistaudu NIS2-direktiivin vaatimuksiin' : 'Prepare for NIS2 directive requirements'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">GDPR Compliance</span> — {isFi ? 'Tietosuoja ja tietosuojan hallinta' : 'Data protection and privacy management'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">DORA Compliance</span> — {isFi ? 'Digitaalinen operatiivinen resilienssi' : 'Digital operational resilience'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">V-CISO Service</span> — {isFi ? 'Virtuaalinen tietoturvapäällikkö' : 'Virtual CISO guidance'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">V-DPO Service</span> — {isFi ? 'Virtuaalinen tietosuojavastaava' : 'Virtual Data Protection Officer'}</span>
              </li>
            </ul>
          </div>
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300">
            <h3 class="text-base font-bold text-[#1E40AF] mb-3 group-hover:text-[#3bb1f6] transition-colors duration-300">{isFi ? 'Miksi valita meidät?' : 'Why Choose Us?'}</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Asiantuntijatiimi Suomessa' : 'Expert team based in Finland'}
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Todistetut menetelmät 90 päivän toteutuksella' : 'Proven methodologies with 90-day implementation'}
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Jatkuva tuki ja asiantuntemus' : 'Ongoing support and expertise'}
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Toimialakohtainen asiantuntemus' : 'Industry-specific expertise'}
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>