---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "eIDAS and Digital Trust";

const content = {
  en: {
    title: "eIDAS & Digital Trust",
    subtitle: "EU Digital Identity Services",
    heroDescription: "Professional eIDAS compliance and digital trust services. We help organizations build a strong foundation for digital identity and trust. Build strong digital trust according to eIDAS standard. We help organizations achieve EU digital identity and trust requirements.",
    forWho: "For organizations seeking to build digital trust and comply with EU eIDAS regulations.",
    achieve: "eIDAS compliance with strong digital identity, signatures, and trust services.",
    overview: {
      title: "Overview",
      description: "eIDAS (electronic IDentification, Authentication and trust Services) is an EU regulation that establishes a framework for electronic identification and trust services. It enables secure and seamless digital interactions across EU member states.",
      highlight: "Our expert team provides comprehensive eIDAS compliance services, from digital identity implementation through trust service certification and ongoing compliance monitoring."
    },
    services: {
      title: "eIDAS Services",
      subtitle: "eIDAS provides comprehensive services for digital identity and trust.",
      items: [
        { title: "Digital Identity", description: "Build strong and reliable digital identity", icon: "user", features: ["Identity verification", "Trust levels", "Identity management"] },
        { title: "Digital Signature", description: "Secure and legally binding digital signatures", icon: "document", features: ["QES signatures", "AES signatures", "SES signatures"] },
        { title: "Electronic Mail", description: "Reliable and secure electronic communication", icon: "mail", features: ["Message encryption", "Sender verification", "Recipient verification"] },
        { title: "Trust Services", description: "eIDAS trust services and certification", icon: "shield", features: ["Trust service providers", "Certification", "Supervision"] }
      ]
    },
    levels: {
      title: "Trust Levels",
      subtitle: "eIDAS defines three trust levels for digital services.",
      items: [
        { level: "Low", title: "Low Trust", description: "Basic level digital identity and signature", icon: "minus", requirements: ["Email address", "Password", "Basic security"] },
        { level: "Substantial", title: "Substantial Trust", description: "Medium level digital identity and signature", icon: "check", requirements: ["Identity verification", "Two-factor authentication", "Encryption"] },
        { level: "High", title: "High Trust", description: "High level digital identity and signature", icon: "shield", requirements: ["Identity verification", "Two-factor authentication", "Encryption and certificates"] }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Clear and structured process for eIDAS compliance.",
      items: [
        { number: "01", title: "eIDAS Assessment", description: "Assess current digital trust and eIDAS compliance" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Planning", description: "Plan eIDAS compliance program" },
        { number: "04", title: "Implementation", description: "Implement required digital trust measures" },
        { number: "05", title: "Monitoring", description: "Continuous compliance monitoring and updates" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "eIDAS compliance assessment report",
        "Digital identity implementation framework",
        "Digital signature solution design",
        "Trust service certification support",
        "Identity verification procedures",
        "Compliance monitoring framework",
        "Staff training materials",
        "Ongoing compliance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Meet EU eIDAS requirements",
        "Strengthen digital trust",
        "Improve customer trust",
        "Accelerate digital processes",
        "Competitive advantage in markets"
      ]
    }
  },
  fi: {
    title: "eIDAS & Digitaalinen Luottamus",
    subtitle: "EU:n Digitaalisen Identiteetin Palvelut",
    heroDescription: "Ammattimaiset eIDAS yhteensopivuus- ja digitaalisen luottamuksen palvelut. Autamme organisaatioita rakentamaan vahvan digitaalisen identiteetin ja luottamuksen perustan. Rakennetaan vahva digitaalinen luottamus eIDAS standardin mukaisesti. Autamme organisaatioita saavuttamaan EU:n digitaalisen identiteetin ja luottamuksen vaatimukset.",
    forWho: "Organisaatioille, jotka haluavat rakentaa digitaalista luottamusta ja täyttää EU:n eIDAS-asetuksen vaatimukset.",
    achieve: "eIDAS-vaatimustenmukaisuus vahvalla digitaalisella identiteetillä, allekirjoituksilla ja luottamuspalveluilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "eIDAS (electronic IDentification, Authentication and trust Services) on EU:n asetus, joka luo kehyksen sähköiselle tunnistamiselle ja luottamuspalveluille. Se mahdollistaa turvalliset ja saumattomat digitaaliset vuorovaikutukset EU:n jäsenvaltioiden välillä.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia eIDAS-yhteensopivuuspalveluita digitaalisen identiteetin toteutuksesta luottamuspalveluiden sertifiointiin ja jatkuvaan vaatimustenmukaisuuden seurantaan."
    },
    services: {
      title: "eIDAS Palvelut",
      subtitle: "eIDAS tarjoaa kattavat palvelut digitaaliseen identiteettiin ja luottamukseen.",
      items: [
        { title: "Digitaalinen Identiteetti", description: "Rakennetaan vahva ja luotettava digitaalinen identiteetti", icon: "user", features: ["Identiteetin vahvistus", "Luotettavuustasot", "Identiteetin hallinta"] },
        { title: "Digitaalinen Allekirjoitus", description: "Turvalliset ja laillisesti sitovat digitaaliset allekirjoitukset", icon: "document", features: ["QES allekirjoitukset", "AES allekirjoitukset", "SES allekirjoitukset"] },
        { title: "Sähköinen Posti", description: "Luotettava ja turvallinen sähköinen viestintä", icon: "mail", features: ["Viestien salaus", "Lähettäjän vahvistus", "Vastaanottajan vahvistus"] },
        { title: "Luotettavat Palvelut", description: "eIDAS luotettavat palvelut ja sertifiointi", icon: "shield", features: ["Luotettavuuspalveluntarjoajat", "Sertifiointi", "Valvonta"] }
      ]
    },
    levels: {
      title: "Luotettavuustasot",
      subtitle: "eIDAS määrittelee kolme luotettavuustasoa digitaalisille palveluille.",
      items: [
        { level: "Low", title: "Matala Luotettavuus", description: "Perustason digitaalinen identiteetti ja allekirjoitus", icon: "minus", requirements: ["Sähköpostiosoite", "Salasana", "Perustason tietoturva"] },
        { level: "Substantial", title: "Merkittävä Luotettavuus", description: "Keskitasoinen digitaalinen identiteetti ja allekirjoitus", icon: "check", requirements: ["Henkilöllisyyden vahvistus", "Kaksi tekijän autentikaatio", "Salaus"] },
        { level: "High", title: "Korkea Luotettavuus", description: "Korkeatason digitaalinen identiteetti ja allekirjoitus", icon: "shield", requirements: ["Henkilöllisyyden vahvistus", "Kaksi tekijän autentikaatio", "Salaus ja sertifikaatit"] }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi eIDAS yhteensopivuuteen.",
      items: [
        { number: "01", title: "eIDAS Arviointi", description: "Arvioidaan nykyinen digitaalinen luottamus ja eIDAS yhteensopivuus" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Suunnittelu", description: "Suunnitellaan eIDAS yhteensopivuusohjelma" },
        { number: "04", title: "Toteutus", description: "Toteutetaan tarvittavat digitaalisen luottamuksen toimenpiteet" },
        { number: "05", title: "Valvonta", description: "Jatkuva yhteensopivuuden valvonta ja päivitys" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "eIDAS-yhteensopivuusarviointiraportti",
        "Digitaalisen identiteetin toteutuskehys",
        "Digitaalisen allekirjoitusratkaisun suunnittelu",
        "Luottamuspalveluiden sertifiointituki",
        "Identiteetin vahvistusmenettelyt",
        "Vaatimustenmukaisuuden seurantakehys",
        "Henkilöstön koulutusmateriaalit",
        "Jatkuva yhteensopivuustuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Täytä EU eIDAS vaatimukset",
        "Vahvista digitaalinen luottamus",
        "Paranna asiakkaiden luottamusta",
        "Nopeuta digitaalisia prosesseja",
        "Kilpailuetu markkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Levels Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.levels.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.levels.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.levels.items.map((level) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-between items-start mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={level.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
              <span class="text-xs font-bold text-[#3B82F6] bg-blue-50 px-3 py-1 rounded-full border border-[#3B82F6]">
                {level.level}
              </span>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {level.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {level.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {level.requirements.map((req) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>