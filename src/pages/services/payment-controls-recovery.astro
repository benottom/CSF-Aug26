---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Payment Controls and Recovery Playbooks";

const content = {
  en: {
    title: "Payment Controls",
    subtitle: "Fraud Protection & Incident Response",
    heroDescription: "Harden payment processes and prepare recovery – bank contacts, payment stop, police report. Comprehensive payment fraud protection for your organization.",
    forWho: "For organizations seeking to harden payment processes and prepare fraud recovery playbooks.",
    achieve: "Comprehensive payment fraud protection with preventive controls and recovery playbooks.",
    overview: {
      title: "Overview",
      description: "Payment fraud, including BEC and invoice fraud, is one of the fastest-growing and most costly threats facing organizations. Building robust preventive controls and preparing recovery playbooks are essential to protect your organization.",
      highlight: "Our expert team provides comprehensive payment controls and recovery playbook services, helping you build preventive controls and prepare for effective incident response."
    },
    tracks: {
      title: "Building Payment Controls",
      subtitle: "Three-dimensional approach to payment fraud risk management.",
      items: [
        { title: "Process & System Controls", description: "Four-eyes principle, payment limits and change management", icon: "document" },
        { title: "Training & Verification", description: "Staff training and phone verification processes", icon: "user" },
        { title: "Incident Playbooks", description: "Ready action models for fraud incident handling", icon: "alert-triangle" }
      ]
    },
    recoverySteps: {
      title: "Recovery Playbooks",
      subtitle: "Ready action models for fast and effective payment fraud incident handling.",
      items: [
        { title: "Payment Stop", description: "Immediate payment stop through bank", icon: "stop-circle", actions: ["Call bank contact person", "Provide payment identifiers", "Written confirmation"] },
        { title: "Incident Investigation", description: "Fraud scope and impact assessment", icon: "search", actions: ["Event reconstruction", "Impact assessment", "Evidence collection"] },
        { title: "Authority Notification", description: "Police and other authorities notification", icon: "phone", actions: ["Police report filing", "Bank notification", "Insurance company contact"] },
        { title: "Recovery", description: "Control strengthening and lessons learned", icon: "refresh-cw", actions: ["Vulnerability remediation", "Control updates", "Staff retraining"] }
      ]
    },
    preventiveControls: {
      title: "Preventive Controls",
      subtitle: "Comprehensive control suite for payment fraud risk prevention.",
      items: [
        {
          title: "Technical Protection",
          icon: "shield",
          features: ["SPF/DKIM/DMARC configuration", "Anti-spoofing filters", "MFA for all accounts", "ERP integrations"]
        },
        {
          title: "Process Controls",
          icon: "clipboard",
          features: ["Four-eyes payment approval", "Vendor data locking", "Payment limit setting", "Change process monitoring"]
        },
        {
          title: "Human Controls",
          icon: "users",
          features: ["Regular fraud training", "Phone verification processes", "Reporting channels", "Simulations and tests"]
        }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Structured approach to building payment controls and recovery playbooks.",
      items: [
        { number: "01", title: "Assessment", description: "Assess current payment processes and fraud risks" },
        { number: "02", title: "Control Design", description: "Design preventive controls and recovery playbooks" },
        { number: "03", title: "Implementation", description: "Implement controls and train staff" },
        { number: "04", title: "Testing", description: "Test controls and run simulations" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Payment process risk assessment",
        "Preventive controls framework",
        "Recovery playbook documentation",
        "Staff training materials",
        "Bank contact protocols",
        "Incident response procedures",
        "Simulation and test plan",
        "Ongoing support and updates"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Reduced payment fraud risk",
        "Fast and effective incident response",
        "Protected financial assets",
        "Improved process security",
        "Regulatory compliance assurance"
      ]
    }
  },
  fi: {
    title: "Maksukontrollit",
    subtitle: "Petossuoja & tapahtumien hallinta",
    heroDescription: "Vahvista maksuprosessit ja varaudu palautumiseen – pankkikontaktit, STOP-maksu, rikosilmoitukset. Kattava maksupetossuoja organisaatiollesi.",
    forWho: "Organisaatioille, jotka haluavat vahvistaa maksuprosesseja ja valmistella petosten palautumisohjeita.",
    achieve: "Kattava maksupetossuoja ennaltaehkäisevillä kontrolleilla ja palautumisohjeilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Maksupetokset, kuten BEC ja laskupetokset, ovat yksi nopeimmin kasvavista ja kalleimmista uhista, joita organisaatiot kohtaavat. Vankkojen ennaltaehkäisevien kontrollien rakentaminen ja palautumisohjeiden valmistelu ovat olennaisia organisaatiosi suojaamiseksi.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia maksukontrolli- ja palautumisohjepalveluita auttaen sinua rakentamaan ennaltaehkäiseviä kontrolleja ja valmistautumaan tehokkaaseen tapahtumien hallintaan."
    },
    tracks: {
      title: "Maksukontrollien rakentaminen",
      subtitle: "Kolmiulotteinen lähestymistapa maksupetosriskien hallintaan.",
      items: [
        { title: "Prosessi‑ & järjestelmäkontrollit", description: "Nelisilmäperiaate, maksulimittien ja muutoshallinta", icon: "document" },
        { title: "Koulutus & todennus", description: "Henkilöstökoulutus ja puhelinvahvistusprosessit", icon: "user" },
        { title: "Incident‑playbookit", description: "Valmiit toimintamallit petostapausten käsittelyyn", icon: "alert-triangle" }
      ]
    },
    recoverySteps: {
      title: "Palautumisplaybookit",
      subtitle: "Valmiit toimintamallit maksupetostapausten nopeaan ja tehokkaaseen käsittelyyn.",
      items: [
        { title: "Maksun pysäytys", description: "Välitön maksun pysäytys pankin kautta", icon: "stop-circle", actions: ["Pankin yhteyshenkilön soitto", "Maksun tunnistetietojen välitys", "Kirjallinen vahvistus"] },
        { title: "Tapauksen selvitys", description: "Petoksen laajuuden ja vaikutusten selvitys", icon: "search", actions: ["Tapahtumien rekonstruointi", "Vaikutusten arviointi", "Todistusaineiston keruu"] },
        { title: "Viranomaisilmoitus", description: "Poliisin ja muiden viranomaisten informointi", icon: "phone", actions: ["Rikosilmoituksen teko", "Pankin ilmoitus", "Vakuutusyhtiön kontakti"] },
        { title: "Palautuminen", description: "Kontrollien vahvistaminen ja oppiminen", icon: "refresh-cw", actions: ["Haavoittuvuuksien korjaus", "Kontrollien päivitys", "Henkilöstön koulutus"] }
      ]
    },
    preventiveControls: {
      title: "Ennaltaehkäisevät kontrollit",
      subtitle: "Kattava kontrollien valikoima maksupetosriskien ennaltaehkäisyyn.",
      items: [
        {
          title: "Tekninen suojaus",
          icon: "shield",
          features: ["SPF/DKIM/DMARC konfigurointi", "Anti-spoofing suodattimet", "MFA kaikille tileille", "ERP-integraatiot"]
        },
        {
          title: "Prosessikontrollit",
          icon: "clipboard",
          features: ["Nelisilmäperiaate maksuille", "Toimittajatietojen lukitseminen", "Maksulimittien asettaminen", "Muutosprosessien valvonta"]
        },
        {
          title: "Henkilöstökontrollit",
          icon: "users",
          features: ["Säännöllinen petoskoulutus", "Puhelinvahvistusprosessit", "Raportointikanavat", "Simulaatiot ja testit"]
        }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa maksukontrollien ja palautumisohjeiden rakentamiseen.",
      items: [
        { number: "01", title: "Arviointi", description: "Arvioidaan nykyiset maksuprosessit ja petosriskit" },
        { number: "02", title: "Kontrollisuunnittelu", description: "Suunnitellaan ennaltaehkäisevät kontrollit ja palautumisohjeet" },
        { number: "03", title: "Toteutus", description: "Toteutetaan kontrollit ja koulutetaan henkilöstö" },
        { number: "04", title: "Testaus", description: "Testataan kontrollit ja suoritetaan simulaatiot" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Maksuprosessien riskiarviointi",
        "Ennaltaehkäisevien kontrollien kehys",
        "Palautumisohjeiden dokumentaatio",
        "Henkilöstön koulutusmateriaalit",
        "Pankkikontaktien protokollat",
        "Tapahtumien hallintamenettelyt",
        "Simulaatio- ja testisuunnitelma",
        "Jatkuva tuki ja päivitykset"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Vähentynyt maksupetosriski",
        "Nopea ja tehokas tapahtumien hallinta",
        "Suojatut taloudelliset varat",
        "Parannettu prosessiturvallisuus",
        "Sääntelyvaatimusten noudattamisen varmistus"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Tracks Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.tracks.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.tracks.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.tracks.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Recovery Steps Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.recoverySteps.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.recoverySteps.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.recoverySteps.items.map((step, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                {index + 1}
              </div>
            </div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={step.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {step.actions.map((action) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {action}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Preventive Controls Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.preventiveControls.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.preventiveControls.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.preventiveControls.items.map((control, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={control.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-8 h-8 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-lg flex items-center justify-center text-white font-bold text-xs">
                {index + 1}
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-3 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10 text-center">
              {control.title}
            </h3>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:border-[#3B82F6] transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {control.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>