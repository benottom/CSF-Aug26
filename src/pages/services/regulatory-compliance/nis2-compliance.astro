---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "NIS2 Compliance";

const content = {
  en: {
    title: "NIS2 Compliance",
    subtitle: "EU Cybersecurity Directive Implementation",
    heroDescription: "Comprehensive NIS2 Directive compliance for essential and important entities with expert Finnish regulatory guidance. Gap assessment, risk management implementation, 24/7 incident response capabilities, and regulatory reporting to ensure full compliance while building resilient cybersecurity foundations.",
    forWho: "For essential and important entities across 18 sectors including energy, transport, banking, health, and digital infrastructure.",
    achieve: "Full NIS2 compliance with enhanced cybersecurity posture, incident response capabilities, and regulatory readiness.",
    services: {
      title: "NIS2 Compliance Service Areas",
      subtitle: "Comprehensive support across all NIS2 requirements to ensure your organization achieves and maintains compliance while building cybersecurity resilience.",
      items: [
        {
          title: "NIS2 Gap Assessment & Scoping",
          description: "Comprehensive evaluation of current cybersecurity posture against NIS2 requirements",
          icon: "search",
          deliverables: ["Entity classification (Essential vs Important services)", "Detailed gap analysis against all NIS2 requirements", "Risk assessment and threat landscape analysis", "Implementation roadmap with prioritized actions", "Resource planning and budget estimation"]
        },
        {
          title: "Cybersecurity Risk Management Framework",
          description: "Implementation of comprehensive risk management aligned with NIS2 requirements",
          icon: "shield",
          deliverables: ["Risk management policies and procedures", "ICT asset inventory and classification", "Supply chain security framework", "Business continuity and crisis management", "Regular risk assessment and monitoring processes"]
        },
        {
          title: "Incident Response & Reporting System",
          description: "24/7 incident detection, response, and regulatory reporting capabilities",
          icon: "bolt",
          deliverables: ["24/7 security monitoring and detection", "Incident classification and severity assessment", "Regulatory reporting to Traficom within required timeframes", "Crisis communication and escalation procedures", "Recovery and lessons learned processes"]
        },
        {
          title: "Technical Security Controls Implementation",
          description: "Deployment of appropriate technical and organizational cybersecurity measures",
          icon: "lock-closed",
          deliverables: ["Multi-factor authentication and access controls", "Network security and segmentation", "Encryption and data protection measures", "Backup and disaster recovery systems", "Vulnerability management and security testing"]
        }
      ]
    },
    timeline: {
      title: "NIS2 Compliance Timeline",
      subtitle: "Key dates and milestones for NIS2 implementation and compliance requirements.",
      items: [
        { milestone: "NIS2 Directive Entry into Force", date: "January 16, 2023", status: "completed", description: "EU NIS2 Directive officially entered into force" },
        { milestone: "National Implementation Deadline", date: "October 17, 2024", status: "active", description: "EU Member States must transpose directive into national law" },
        { milestone: "Entity Compliance Deadline", date: "October 17, 2024", status: "mandatory", description: "Organizations must be fully compliant with NIS2 requirements" }
      ]
    },
    penalties: {
      title: "NIS2 Penalties & Sanctions",
      subtitle: "Understanding the potential consequences of non-compliance with NIS2 requirements.",
      items: [
        { violation: "Administrative Fines", penalty: "Up to €10M or 2% of turnover", scope: "Non-compliance with cybersecurity measures", icon: "alert-triangle" },
        { violation: "Management Liability", penalty: "Personal sanctions for senior management", scope: "Failure to implement required measures", icon: "users" },
        { violation: "Operational Sanctions", penalty: "Suspension of services", scope: "Severe non-compliance cases", icon: "building" }
      ]
    }
  },
  fi: {
    title: "NIS2 Yhteensopivuus",
    subtitle: "EU:n kyberturvallisuusdirektiivin toteutus",
    heroDescription: "Kattava NIS2-direktiivin yhteensopivuus oleellisille ja tärkeille toimijoille asiantuntevan suomalaisen sääntelyohjauksen avulla. Tilannekatsaus, riskienhallinnan toteutus, 24/7 häiriönhallintakyvyt ja sääntelyraportointi täyden yhteensopivuuden varmistamiseksi.",
    forWho: "Oleellisille ja tärkeille toimijoille 18 sektorilla, mukaan lukien energia, liikenne, pankki, terveys ja digitaalinen infrastruktuuri.",
    achieve: "Täysi NIS2 vaatimustenmukaisuus parannetulla kyberturvallisuudella, tapahtumien hallintakyvyillä ja sääntelyvalmiudella.",
    services: {
      title: "NIS2 Yhteensopivuuspalvelualueet",
      subtitle: "Kattava tuki kaikkien NIS2:n vaatimusten yli varmistaen että organisaationne saavuttaa ja ylläpitää yhteensopivuutta rakentaen kyberturvallisuusresilienssiä.",
      items: [
        {
          title: "NIS2-tilannekatsaus ja laajuuden määrittely",
          description: "Kattava arviointi nykyisestä kyberturvallisuusasemasta NIS2:n vaatimusten vastapainossa",
          icon: "search",
          deliverables: ["Toimijaluokitus (Oleelliset vs Tärkeät palvelut)", "Yksityiskohtainen aukkoanalyysi kaikkia NIS2:n vaatimuksia vastaan", "Riskinarviointi ja uhkakentän analyysi", "Toteutussuunnitelma priorisoituina toimina", "Resursointisuunnittelu ja budjetointi"]
        },
        {
          title: "Kyberturvallisuuden riskienhallintakehys",
          description: "Kattavan riskienhallinnan toteutus NIS2:n vaatimusten mukaisesti",
          icon: "shield",
          deliverables: ["Riskienhallintakäytännöt ja menettelyt", "ICT-omaisuuden inventointi ja luokittelu", "Toimittajaturvallisuuskehys", "Liiketoiminnan jatkuvuus ja kriisinhallinta", "Säännölliset riskinarvioinnit ja seurantaprosessit"]
        },
        {
          title: "Häiriönhallinta ja raportointijärjestelmä",
          description: "24/7 häiriönhavaitseminen, vastaaminen ja sääntelyraportointikyvyt",
          icon: "bolt",
          deliverables: ["24/7 tietoturvan valvonta ja havaitseminen", "Häiriöiden luokitteleminen ja vakavuusasteen arviointi", "Sääntelyraportointi Traficomiin määräaikojen mukaan", "Kriisiviestintä ja eskalointiprosessit", "Palautuminen ja oppimisen prosessit"]
        },
        {
          title: "Teknisten tietoturvaohjainten toteutus",
          description: "Sopivan teknisten ja organisaatiollisten kyberturvatoimien käyttöönotto",
          icon: "lock-closed",
          deliverables: ["Monivaiheinen tunnistautuminen ja käyttöoikeusohjaimet", "Verkkoturvallisuus ja segmentointi", "Salaus ja tietojen suojaustoimet", "Varmuuskopiointi ja katastrofipalautusjärjestelmät", "Haavoittuvuuden hallinta ja tietoturvatestaus"]
        }
      ]
    },
    timeline: {
      title: "NIS2 Yhteensopivuusaikataulu",
      subtitle: "Avainpäivät ja etapit NIS2:n toteutukseen ja yhteensopivuusvaatimuksiin.",
      items: [
        { milestone: "NIS2-direktiivin voimaantulo", date: "January 16, 2023", status: "completed", description: "EU:n NIS2-direktiivi astui virallisesti voimaan" },
        { milestone: "Kansallisen toteutuksen määräpäivä", date: "October 17, 2024", status: "active", description: "EU:n jäsenvaltioiden on saatettava direktiivi osaksi kansallista lainsäädäntöään" },
        { milestone: "Toimijan yhteensopivuuden määräpäivä", date: "October 17, 2024", status: "mandatory", description: "Organisaatioiden on oltava täysin yhteensopivia NIS2:n vaatimusten kanssa" }
      ]
    },
    penalties: {
      title: "NIS2 Sanktiot ja Seuraamukset",
      subtitle: "Ymmärrä mahdolliset seuraukset NIS2:n vaatimusten noudattamatta jättämisestä.",
      items: [
        { violation: "Hallinnolliset sakot", penalty: "Jopa €10M tai 2% liikevaihdosta", scope: "Tietoturvasäädösten noudattamatta jättö", icon: "alert-triangle" },
        { violation: "Johtohenkilöstön vastuu", penalty: "Henkilökohtaiset seuraamukset johdolle", scope: "Vaadittujen toimenpiteiden toteuttamatta jättö", icon: "users" },
        { violation: "Operaattorisanktiot", penalty: "Palvelujen keskeyttäminen", scope: "Vakavat noudattamatta jättötapaukset", icon: "building" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getStatusColor(status: string) {
  switch(status) {
    case 'completed': return 'bg-green-100 text-green-700';
    case 'active': return 'bg-blue-100 text-blue-700';
    case 'mandatory': return 'bg-red-100 text-red-700';
    default: return 'bg-slate-100 text-slate-700';
  }
}

function getStatusBadgeText(status: string) {
  if (isFi) {
    switch(status) {
      case 'completed': return 'Valmis';
      case 'active': return 'Aktiivinen';
      case 'mandatory': return 'Pakollinen';
      default: return status;
    }
  } else {
    switch(status) {
      case 'completed': return 'Completed';
      case 'active': return 'Active';
      case 'mandatory': return 'Mandatory';
      default: return status;
    }
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((area) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={area.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {area.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {area.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <h4 class="text-xs font-semibold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300">
                {isFi ? 'Avainläpäisijät' : 'Key Deliverables'}
              </h4>
              <ul class="space-y-1">
                {area.deliverables.map((deliverable) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {deliverable}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Timeline Section - Centered with narrower cards -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.timeline.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.timeline.subtitle}
        </p>
      </div>
      
      <div class="max-w-xl mx-auto space-y-4">
        {currentContent.timeline.items.map((item, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-3 p-4 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] text-white rounded-xl flex items-center justify-center text-sm font-bold">
                {index + 1}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-sm font-bold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {item.milestone}
                </h3>
                <span className={`inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-full ${getStatusColor(item.status)}`}>
                  {getStatusBadgeText(item.status)}
                </span>
                <span class="text-xs text-slate-400">{item.date}</span>
              </div>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Penalties Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.penalties.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.penalties.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {currentContent.penalties.items.map((penalty) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={penalty.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {penalty.violation}
            </h3>
            
            <div class="text-base font-bold text-[#1E2A7A] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {penalty.penalty}
            </div>
            
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {penalty.scope}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>