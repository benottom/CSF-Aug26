---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "DORA";

const content = {
  en: {
    title: "DORA",
    subtitle: "Digital Operational Resilience Services",
    heroDescription: "Expert DORA implementation for financial institutions covering ICT risk management, incident response, operational resilience testing, third-party management, and information sharing to ensure business continuity and regulatory compliance.",
    forWho: "For financial institutions including banks, investment firms, insurance companies, and critical ICT third-party providers.",
    achieve: "Full DORA compliance with enhanced digital operational resilience and regulatory readiness.",
    doraAreas: {
      title: "DORA Compliance Service Areas",
      subtitle: "Comprehensive support across all five DORA pillars to ensure your financial institution achieves digital operational resilience excellence.",
      items: [
        {
          title: "ICT Risk Management Framework",
          description: "Comprehensive ICT risk management integrated with overall operational risk management",
          icon: "shield-check",
          timeline: "6-9 months",
          entities: "All financial entities",
          capabilities: [
            "ICT risk management policy with board oversight",
            "Risk assessment methodologies and treatment processes",
            "ICT asset inventory and dependency mapping",
            "Risk monitoring and key risk indicator frameworks"
          ]
        },
        {
          title: "ICT-Related Incident Management",
          description: "24/7 incident detection, response, and regulatory reporting capabilities",
          icon: "bolt",
          timeline: "4-6 months",
          entities: "Mandatory for all entities",
          capabilities: [
            "Computer security incident detection and response",
            "Incident classification and severity assessment",
            "Regulatory reporting to competent authorities",
            "Root cause analysis and lessons learned"
          ]
        },
        {
          title: "Digital Operational Resilience Testing",
          description: "Comprehensive testing framework for ICT systems and operational processes",
          icon: "refresh-cw",
          timeline: "Ongoing cycles",
          entities: "TLPT for significant entities",
          capabilities: [
            "Threat-led penetration testing (TLPT) programs",
            "Vulnerability assessments and penetration testing",
            "Scenario-based operational resilience testing",
            "Advanced red team and purple team exercises"
          ]
        },
        {
          title: "Third-Party ICT Provider Management",
          description: "Comprehensive oversight of critical ICT service providers and supply chain",
          icon: "cog",
          timeline: "12-18 months",
          entities: "Enhanced oversight requirements",
          capabilities: [
            "Critical ICT service provider identification",
            "Contractual arrangements with DORA requirements",
            "Continuous monitoring and performance oversight",
            "Exit strategies and contingency planning"
          ]
        }
      ]
    },
    entities: {
      title: "DORA Applicable Entities",
      subtitle: "Understanding which organizations are subject to DORA requirements and compliance obligations.",
      items: [
        { category: "Credit Institutions", examples: ["Banks", "Credit unions", "Building societies"], requirements: "All DORA pillars apply" },
        { category: "Investment Firms", examples: ["Investment services", "Portfolio management", "Investment advice"], requirements: "Full DORA compliance required" },
        { category: "Insurance & Reinsurance", examples: ["Insurance companies", "Reinsurance undertakings", "Insurance intermediaries"], requirements: "Operational resilience focus" },
        { category: "Critical ICT Third-Party Providers", examples: ["Cloud service providers", "Software providers", "Data analytics services"], requirements: "Enhanced oversight regime" }
      ]
    },
    timeline: {
      title: "DORA Implementation Timeline",
      subtitle: "Key milestones and deadlines for DORA compliance preparation and implementation.",
      items: [
        { date: "January 16, 2023", milestone: "DORA Entry into Force", status: "completed" },
        { date: "January 17, 2024", milestone: "Technical Standards Development", status: "in-progress" },
        { date: "January 17, 2025", milestone: "DORA Application Date", status: "mandatory" }
      ]
    }
  },
  fi: {
    title: "DORA",
    subtitle: "Digitaalisen toimintakyvyn palvelut",
    heroDescription: "Asiantunteva DORA-toteutus suomalaisille rahoituslaitoksille kattaen ICT-riskienhallinnan, tapahtumien hallinnan, toimintakyvyn testauksen, kolmannen osapuolen hallinnan ja tiedonjaon.",
    forWho: "Rahoituslaitoksille, mukaan lukien pankit, sijoituspalveluyritykset, vakuutusyhtiöt ja kriittiset ICT-kolmannen osapuolen palveluntarjoajat.",
    achieve: "Täysi DORA-vaatimustenmukaisuus parannetulla digitaalisella toimintakyvyllä ja sääntelyvalmiudella.",
    doraAreas: {
      title: "DORA-vaatimustenmukaisuuden palvelualueet",
      subtitle: "Kattava tuki kaikkien viiden DORA-pilarin osalta varmistaaksesi, että rahoituslaitoksesi saavuttaa digitaalisen toimintakyvyn huippuosaamisen.",
      items: [
        {
          title: "ICT-riskienhallintakehys",
          description: "Kattava ICT-riskienhallinta integroituna yleiseen operatiiviseen riskienhallintaan",
          icon: "shield-check",
          timeline: "6-9 kuukautta",
          entities: "Kaikki rahoitustoimijat",
          capabilities: [
            "ICT-riskienhallintapolitiikka hallituksen valvonnassa",
            "Riskinarviointimenetelmät ja käsittelyprosessit",
            "ICT-omaisuusluettelo ja riippuvuuskartoitus",
            "Riskien seuranta ja keskeiset riski-indikaattorit"
          ]
        },
        {
          title: "ICT-tapahtumien hallinta",
          description: "24/7 tapahtumien havaitseminen, reagointi ja sääntelyraportointikyvykkyydet",
          icon: "bolt",
          timeline: "4-6 kuukautta",
          entities: "Pakollinen kaikille toimijoille",
          capabilities: [
            "Tietoturvatapahtumien havaitseminen ja reagointi",
            "Tapahtumien luokittelu ja vakavuusasteen arviointi",
            "Sääntelyraportointi toimivaltaisille viranomaisille",
            "Perimmäisen syyn analyysi ja opitut asiat"
          ]
        },
        {
          title: "Digitaalisen toimintakyvyn testaus",
          description: "Kattava testauskehys ICT-järjestelmille ja operatiivisille prosesseille",
          icon: "refresh-cw",
          timeline: "Jatkuvat syklit",
          entities: "TLPT merkittäville toimijoille",
          capabilities: [
            "Uhkajohtoiset penetraatiotestaus (TLPT) -ohjelmat",
            "Haavoittuvuusarvioinnit ja penetraatiotestaus",
            "Skenaariopohjainen toimintakyvyn testaus",
            "Edistyneet punaisten ja purppuratiimien harjoitukset"
          ]
        },
        {
          title: "Kolmannen osapuolen ICT-palveluntarjoajien hallinta",
          description: "Kattava valvonta kriittisille ICT-palveluntarjoajille ja toimitusketjulle",
          icon: "cog",
          timeline: "12-18 kuukautta",
          entities: "Tehostetut valvontavaatimukset",
          capabilities: [
            "Kriittisten ICT-palveluntarjoajien tunnistaminen",
            "Sopimusjärjestelyt DORA-vaatimuksilla",
            "Jatkuva seuranta ja suorituskyvyn valvonta",
            "Poistumisstrategiat ja varautumissuunnittelu"
          ]
        }
      ]
    },
    entities: {
      title: "DORA:n soveltamisalaan kuuluvat toimijat",
      subtitle: "Ymmärrys siitä, mitkä organisaatiot ovat DORA-vaatimusten ja noudattamisvelvoitteiden alaisia.",
      items: [
        { category: "Luottolaitokset", examples: ["Pankit", "Osuuspankit", "Asuntolainayhteisöt"], requirements: "Kaikki DORA-pilarit soveltuvat" },
        { category: "Sijoituspalveluyritykset", examples: ["Sijoituspalvelut", "Salkunhoito", "Sijoitusneuvonta"], requirements: "Täysi DORA-vaatimustenmukaisuus vaaditaan" },
        { category: "Vakuutus- ja jälleenvakuutus", examples: ["Vakuutusyhtiöt", "Jälleenvakuutusyritykset", "Vakuutusvälittäjät"], requirements: "Toiminnallisen resilienssin painopiste" },
        { category: "Kriittiset ICT-kolmannen osapuolen palveluntarjoajat", examples: ["Pilvipalveluntarjoajat", "Ohjelmistotoimittajat", "Data-analytiikkapalvelut"], requirements: "Tehostettu valvontajärjestelmä" }
      ]
    },
    timeline: {
      title: "DORA-toteutuksen aikataulu",
      subtitle: "Tärkeimmät virstanpylväät ja määräajat DORA-vaatimustenmukaisuuden valmistelulle ja toteutukselle.",
      items: [
        { date: "16. tammikuuta 2023", milestone: "DORA:n voimaantulo", status: "completed" },
        { date: "17. tammikuuta 2024", milestone: "Teknisten standardien kehitys", status: "in-progress" },
        { date: "17. tammikuuta 2025", milestone: "DORA:n soveltamispäivä", status: "mandatory" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getStatusColor(status: string) {
  switch(status) {
    case 'completed': return 'bg-green-100 text-green-700';
    case 'in-progress': return 'bg-blue-100 text-blue-700';
    case 'mandatory': return 'bg-red-100 text-red-700';
    default: return 'bg-slate-100 text-slate-700';
  }
}

function getStatusText(status: string) {
  if (isFi) {
    switch(status) {
      case 'completed': return 'Valmis';
      case 'in-progress': return 'Käynnissä';
      case 'mandatory': return 'Pakollinen';
      default: return status;
    }
  } else {
    switch(status) {
      case 'completed': return 'Completed';
      case 'in-progress': return 'In Progress';
      case 'mandatory': return 'Mandatory';
      default: return status;
    }
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DORA Service Areas Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.doraAreas.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.doraAreas.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.doraAreas.items.map((area) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={area.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex items-center justify-between mb-1.5">
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                {area.title}
              </h3>
              <span class="text-xs font-medium text-[#003580] bg-blue-50 px-2 py-0.5 rounded-[2px] border border-[#003580] relative z-10">
                {area.timeline}
              </span>
            </div>
            <p class="text-xs text-slate-500 mb-1.5 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {area.description}
            </p>
            <p class="text-xs text-slate-400 mb-2 relative z-10">{area.entities}</p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {area.capabilities.map((capability) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {capability}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Applicable Entities Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.entities.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.entities.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.entities.items.map((entity) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {entity.category}
            </h3>
            
            <ul class="space-y-1 mb-3 relative z-10">
              {entity.examples.map((example) => (
                <li class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">• {example}</li>
              ))}
            </ul>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <p class="text-xs font-medium text-[#003580]">{entity.requirements}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

<!-- Implementation Timeline Section -->
<section class="py-12 md:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
        {currentContent.timeline.title}
      </h2>
      <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
        {currentContent.timeline.subtitle}
      </p>
    </div>
    
    <div class="max-w-xl mx-auto space-y-4">
      {currentContent.timeline.items.map((item, index) => (
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                    hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                    transition-all duration-300
                    flex flex-col md:flex-row md:items-center gap-3 p-4 group relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
          
          <div class="flex-shrink-0 relative z-10">
            <div class="w-10 h-10 bg-[#003580] text-white rounded-xl flex items-center justify-center text-sm font-bold">
              {index + 1}
            </div>
          </div>
          <div class="flex-1 relative z-10">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {item.milestone}
              </h3>
              <span className={`inline-flex items-center px-2 py-0.5 text-xs font-medium rounded-[2px] ${getStatusColor(item.status)}`}>
                {getStatusText(item.status)}
              </span>
              <span class="text-xs text-slate-400">{item.date}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
</Layout>