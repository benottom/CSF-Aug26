---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "eIDAS";

const content = {
  en: {
    title: "eIDAS",
    subtitle: "Digital Trust & Identity Services",
    heroDescription: "Expert eIDAS implementation and digital identity solutions including qualified electronic signatures, seals, timestamps, and trusted service provider frameworks to enable secure digital transactions and cross-border recognition across the EU.",
    forWho: "For organizations requiring legally recognized electronic signatures, seals, timestamps, and trusted digital identity services across the EU.",
    achieve: "Full eIDAS compliance with cross-border recognition, legal certainty, and enhanced digital security.",
    eidasServices: {
      title: "Comprehensive eIDAS Trust Services",
      subtitle: "Complete digital trust infrastructure enabling secure digital transactions with legal certainty across the European Union.",
      items: [
        {
          title: "Qualified Electronic Signatures (QES)",
          description: "Implementation of qualified electronic signatures with legal equivalence to handwritten signatures",
          icon: "document-check",
          legalValue: "Equivalent to handwritten signatures",
          standards: "EN 319 411, EN 319 412",
          deliverables: [
            "Qualified signature creation device (QSCD) integration",
            "Remote qualified electronic signature services",
            "Signature validation and verification systems",
            "Long-term signature preservation (LTV)",
            "Cross-border signature recognition compliance"
          ]
        },
        {
          title: "Qualified Electronic Seals (QESeal)",
          description: "Organization-level qualified electronic seals for document integrity and authenticity",
          icon: "shield-check",
          legalValue: "Legal presumption of integrity and authenticity",
          standards: "EN 319 411, ETSI TS 119 312",
          deliverables: [
            "Qualified seal creation device implementation",
            "Automated document sealing processes",
            "Seal validation and verification infrastructure",
            "Bulk document sealing capabilities",
            "Organizational identity verification frameworks"
          ]
        },
        {
          title: "Qualified Time Stamps (QTS)",
          description: "Trusted time-stamping services with legal certainty for digital evidence",
          icon: "clock",
          legalValue: "Legal presumption of accuracy of time and integrity",
          standards: "EN 319 421, RFC 3161",
          deliverables: [
            "Qualified time stamp authority (QTSA) services",
            "RFC 3161 compliant time-stamping",
            "Long-term timestamp preservation",
            "Audit trail and non-repudiation evidence",
            "Integration with signature and seal services"
          ]
        },
        {
          title: "Qualified Electronic Delivery (QEDS)",
          description: "Secure delivery of electronic documents with evidence of sending and receipt",
          icon: "mail",
          legalValue: "Legal evidence of sending, receipt and integrity",
          standards: "EN 319 531, ETSI TS 119 524",
          deliverables: [
            "Qualified electronic delivery platform",
            "Proof of sending and receipt generation",
            "Secure mailbox services",
            "Legal evidence preservation",
            "Integration with e-signature workflows"
          ]
        },
        {
          title: "Electronic Identification (eID)",
          description: "Secure electronic identification and authentication frameworks",
          icon: "user-check",
          legalValue: "Cross-border recognition under eIDAS",
          standards: "EN 319 401, SAML 2.0",
          deliverables: [
            "eID scheme design and implementation",
            "Multi-factor authentication integration",
            "Cross-border eID recognition",
            "Mobile eID solutions",
            "Identity proofing and verification processes"
          ]
        },
        {
          title: "Trust Service Provider (TSP) Framework",
          description: "Establishment and operation of qualified trust service provider infrastructure",
          icon: "building-library",
          legalValue: "Supervised trust service provider status",
          standards: "EN 319 401, ETSI EN 319 411",
          deliverables: [
            "TSP qualification and supervision compliance",
            "Trust service provision infrastructure",
            "Qualified certificate authority operations",
            "Regulatory compliance and audit frameworks",
            "Business continuity and disaster recovery"
          ]
        }
      ]
    },
    eidasLevels: {
      title: "eIDAS Assurance Levels",
      subtitle: "Understanding the three levels of assurance for electronic identification under eIDAS regulation.",
      items: [
        { level: "Low", assurance: "Basic identity verification", requirements: ["Username/password", "Basic identity checks"], useCases: ["Low-risk online services", "Information access"] },
        { level: "Substantial", assurance: "Multi-factor authentication required", requirements: ["Multi-factor authentication", "Enhanced identity verification"], useCases: ["Online banking", "Tax filing", "Healthcare services"] },
        { level: "High", assurance: "Highest level of security and identity assurance", requirements: ["Hardware security modules", "In-person identity verification"], useCases: ["Legal documents", "High-value transactions", "Government services"] }
      ]
    },
    benefits: {
      title: "Benefits of eIDAS Compliance",
      subtitle: "Transform your digital capabilities with legally recognized and cross-border interoperable trust services.",
      items: [
        { title: "Cross-Border Recognition", description: "eIDAS-qualified services are recognized across all EU member states", impact: "Seamless business operations across Europe", icon: "globe-alt" },
        { title: "Legal Certainty", description: "Qualified services have presumption of integrity and authenticity", impact: "Reduced legal risks and disputes", icon: "gavel" },
        { title: "Digital Transformation", description: "Enable fully digital business processes and customer journeys", impact: "Increased efficiency and customer satisfaction", icon: "trending-up" },
        { title: "Enhanced Security", description: "Strong cryptographic protection and identity assurance", impact: "Reduced fraud and security incidents", icon: "shield" }
      ]
    }
  },
  fi: {
    title: "eIDAS",
    subtitle: "Digitaalisen luottamuksen ja identiteetin palvelut",
    heroDescription: "Asiantunteva eIDAS-toteutus ja digitaalisen identiteetin ratkaisut, mukaan lukien laatuvarmenteiset sähköiset allekirjoitukset, sinetit, aikaleimat ja luotettujen palveluntarjoajien kehykset turvallisten digitaalisten tapahtumien ja rajat ylittävän tunnustamisen mahdollistamiseksi EU:ssa.",
    forWho: "Organisaatioille, jotka tarvitsevat oikeudellisesti tunnustettuja sähköisiä allekirjoituksia, sinettejä, aikaleimoja ja luotettuja digitaalisia identiteettipalveluita EU:ssa.",
    achieve: "Täysi eIDAS-vaatimustenmukaisuus rajat ylittävällä tunnustamisella, oikeudellisella varmuudella ja tehostetulla digitaalisella turvallisuudella.",
    eidasServices: {
      title: "Kattavat eIDAS-luottamuspalvelut",
      subtitle: "Täydellinen digitaalisen luottamuksen infrastruktuuri, joka mahdollistaa turvalliset digitaaliset tapahtumat oikeudellisella varmuudella koko Euroopan unionin alueella.",
      items: [
        {
          title: "Laatuvarmenteiset sähköiset allekirjoitukset (QES)",
          description: "Laatuvarmenteisten sähköisten allekirjoitusten toteutus oikeudellisesti käsin kirjoitettuja allekirjoituksia vastaavina",
          icon: "document-check",
          legalValue: "Vastaavat käsin kirjoitettuja allekirjoituksia",
          standards: "EN 319 411, EN 319 412",
          deliverables: ["Laatuvarmenteisen allekirjoituksen luontilaitteen (QSCD) integrointi", "Etälaatuvarmenteiset sähköiset allekirjoituspalvelut", "Allekirjoituksen validointi- ja varmennusjärjestelmät", "Pitkäaikainen allekirjoitusten säilytys (LTV)", "Rajat ylittävän allekirjoituksen tunnustamisen vaatimustenmukaisuus"]
        },
        {
          title: "Laatuvarmenteiset sähköiset sinetit (QESeal)",
          description: "Organisaatiotason laatuvarmenteiset sähköiset sinetit asiakirjojen eheydelle ja aitoudelle",
          icon: "shield-check",
          legalValue: "Oikeudellinen oletus eheydestä ja aitoudesta",
          standards: "EN 319 411, ETSI TS 119 312",
          deliverables: ["Laatuvarmenteisen sinetin luontilaitteen toteutus", "Automaattiset asiakirjojen sinetöintiprosessit", "Sinetin validointi- ja varmennusinfrastruktuuri", "Massasinetöintikyvykkyydet", "Organisaation identiteetin varmennuskehykset"]
        },
        {
          title: "Laatuvarmenteiset aikaleimat (QTS)",
          description: "Luotetut aikaleimapalvelut oikeudellisella varmuudella digitaalista todisteaineistoa varten",
          icon: "clock",
          legalValue: "Oikeudellinen oletus ajan tarkkuudesta ja eheydestä",
          standards: "EN 319 421, RFC 3161",
          deliverables: ["Laatuvarmenteisen aikaleima-auktoriteetin (QTSA) palvelut", "RFC 3161 -yhteensopiva aikaleimaus", "Pitkäaikainen aikaleimojen säilytys", "Tarkastuspolku ja kiistämättömyystodisteet", "Integrointi allekirjoitus- ja sinetipalveluihin"]
        },
        {
          title: "Laatuvarmenteiset sähköiset toimituspalvelut (QEDS)",
          description: "Asiakirjojen turvallinen toimitus todisteilla lähettämisestä ja vastaanottamisesta",
          icon: "mail",
          legalValue: "Oikeudellinen todiste lähettämisestä, vastaanottamisesta ja eheydestä",
          standards: "EN 319 531, ETSI TS 119 524",
          deliverables: ["Laatuvarmenteinen sähköinen toimitusalusta", "Lähettämis- ja vastaanottotodisteiden tuottaminen", "Turvalliset postilaatikkopalvelut", "Oikeudellisen todisteaineiston säilytys", "Integrointi sähköisen allekirjoituksen työnkulkuihin"]
        },
        {
          title: "Sähköinen tunnistaminen (eID)",
          description: "Turvalliset sähköisen tunnistamisen ja todennuksen kehykset",
          icon: "user-check",
          legalValue: "Rajat ylittävä tunnustaminen eIDAS-asetuksen nojalla",
          standards: "EN 319 401, SAML 2.0",
          deliverables: ["eID-järjestelmän suunnittelu ja toteutus", "Monivaiheisen todennuksen integrointi", "Rajat ylittävä eID-tunnustaminen", "Mobiili-eID-ratkaisut", "Identiteetin todentamis- ja varmennusprosessit"]
        },
        {
          title: "Luotetun palveluntarjoajan (TSP) kehys",
          description: "Laatuvarmenteisen luotetun palveluntarjoajan infrastruktuurin perustaminen ja ylläpito",
          icon: "building-library",
          legalValue: "Valvottu luotetun palveluntarjoajan asema",
          standards: "EN 319 401, ETSI EN 319 411",
          deliverables: ["TSP-pätevyys ja valvonnan vaatimustenmukaisuus", "Luottamuspalvelujen tarjoamisen infrastruktuuri", "Laatuvarmenteisen varmenteiden myöntäjän toiminta", "Sääntelyn vaatimustenmukaisuus- ja auditointikehykset", "Liiketoiminnan jatkuvuus ja katastrofipalautus"]
        }
      ]
    },
    eidasLevels: {
      title: "eIDAS-varmuustasot",
      subtitle: "Ymmärrys kolmesta sähköisen tunnistamisen varmuustasosta eIDAS-asetuksen nojalla.",
      items: [
        { level: "Matala", assurance: "Perustason identiteetin varmennus", requirements: ["Käyttäjätunnus/salasana", "Perustason henkilöllisyystarkistukset"], useCases: ["Pienen riskin verkkopalvelut", "Tiedon saatavuus"] },
        { level: "Merkittävä", assurance: "Monivaiheinen tunnistautuminen vaaditaan", requirements: ["Monivaiheinen tunnistautuminen", "Tehostettu henkilöllisyyden varmennus"], useCases: ["Verkkopankki", "Veroilmoitus", "Terveyspalvelut"] },
        { level: "Korkea", assurance: "Korkein turvallisuuden ja identiteetin varmuustaso", requirements: ["Laitteistoturvamoduulit", "Henkilökohtainen henkilöllisyyden varmennus"], useCases: ["Oikeudelliset asiakirjat", "Suuren arvon tapahtumat", "Julkishallinnon palvelut"] }
      ]
    },
    benefits: {
      title: "eIDAS-vaatimustenmukaisuuden edut",
      subtitle: "Muuta digitaalisia kyvykkyyksiäsi oikeudellisesti tunnustetuilla ja rajat ylittävästi yhteentoimivilla luottamuspalveluilla.",
      items: [
        { title: "Rajat ylittävä tunnustaminen", description: "eIDAS-laatuvarmenteiset palvelut tunnustetaan kaikissa EU:n jäsenvaltioissa", impact: "Saumaton liiketoiminta Euroopassa", icon: "globe-alt" },
        { title: "Oikeudellinen varmuus", description: "Laatuvarmenteisilla palveluilla on oletus eheydestä ja aitoudesta", impact: "Vähentyneet oikeudelliset riskit ja erimielisyydet", icon: "gavel" },
        { title: "Digitaalinen muutos", description: "Mahdollista täysin digitaaliset liiketoimintaprosessit ja asiakaspolut", impact: "Lisääntynyt tehokkuus ja asiakastyytyväisyys", icon: "trending-up" },
        { title: "Tehostettu turvallisuus", description: "Vahva kryptografinen suoja ja identiteetin varmuus", impact: "Vähentyneet petokset ja turvallisuuspoikkeamat", icon: "shield" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- eIDAS Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.eidasServices.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.eidasServices.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.eidasServices.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <div class="flex flex-wrap gap-2 mb-2">
                <span class="text-xs text-slate-500">
                  <span class="font-semibold text-slate-700">{isFi ? 'Oikeudellinen arvo:' : 'Legal Value:'}</span> {service.legalValue}
                </span>
              </div>
              <ul class="space-y-1">
                {service.deliverables.slice(0, 3).map((deliverable) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {deliverable}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- eIDAS Assurance Levels Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.eidasLevels.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.eidasLevels.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.eidasLevels.items.map((level, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="text-center mb-2 relative z-10">
              <h3 class="text-lg font-bold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                {level.level}
              </h3>
              <p class="text-xs text-slate-500">{level.assurance}</p>
            </div>
            
            <div class="mb-2 relative z-10">
              <h4 class="text-xs font-semibold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">
                {isFi ? 'Vaatimukset' : 'Requirements'}
              </h4>
              <ul class="space-y-0.5">
                {level.requirements.map((req) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <h4 class="text-xs font-semibold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300">
                {isFi ? 'Käyttötapaukset' : 'Use Cases'}
              </h4>
              <ul class="space-y-0.5">
                {level.useCases.map((useCase) => (
                  <li class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">• {useCase}</li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={benefit.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {benefit.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {benefit.description}
            </p>
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <span class="text-xs font-medium text-[#3B82F6]">{benefit.impact}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>