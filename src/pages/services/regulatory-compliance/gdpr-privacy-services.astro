---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "GDPR & Privacy";

const content = {
  en: {
    title: "GDPR & Privacy",
    subtitle: "Data Protection Compliance & Privacy Governance",
    heroDescription: "Expert GDPR implementation and privacy program management including data mapping, privacy impact assessments, consent management, data subject rights automation, and continuous compliance monitoring to build competitive advantage through privacy excellence.",
    forWho: "For organizations handling personal data of EU residents that need to achieve and maintain GDPR compliance.",
    achieve: "Full GDPR compliance with privacy-by-design, automated subject rights, and sustainable privacy governance.",
    services: {
      title: "Comprehensive Privacy Services",
      subtitle: "End-to-end GDPR compliance services that transform privacy obligations into competitive advantages through excellence in data protection.",
      items: [
        {
          title: "Data Protection Impact Assessment (DPIA)",
          description: "Systematic privacy impact assessments for high-risk processing activities",
          icon: "shield-check",
          timeline: "4-8 weeks per assessment",
          compliance: "Mandatory for high-risk processing",
          deliverables: [
            "DPIA methodology and framework development",
            "High-risk processing identification and assessment",
            "Stakeholder consultation and privacy expert review",
            "Mitigation measures and residual risk evaluation",
            "Ongoing monitoring and review processes"
          ]
        },
        {
          title: "Comprehensive Data Mapping & Inventory",
          description: "Complete mapping of personal data flows and processing activities",
          icon: "database",
          timeline: "6-12 weeks",
          compliance: "Foundation for GDPR compliance",
          deliverables: [
            "Personal data inventory and classification",
            "Data flow mapping across systems and processes",
            "Legal basis identification and documentation",
            "Data retention and disposal schedules",
            "Third-party data sharing agreements"
          ]
        },
        {
          title: "Data Subject Rights Management",
          description: "Automated systems for managing individual privacy rights",
          icon: "users",
          timeline: "8-16 weeks",
          compliance: "Response within 30 days required",
          deliverables: [
            "Subject access request (SAR) automation",
            "Right to rectification and erasure procedures",
            "Data portability and structured export capabilities",
            "Consent management and withdrawal systems",
            "Objection and automated decision-making opt-outs"
          ]
        },
        {
          title: "Privacy-by-Design Implementation",
          description: "Integration of privacy principles into systems and processes",
          icon: "cog",
          timeline: "12-24 weeks",
          compliance: "Proactive privacy protection",
          deliverables: [
            "Privacy impact assessment integration",
            "System design privacy reviews",
            "Default privacy settings implementation",
            "Data minimization and purpose limitation controls",
            "Privacy-enhancing technology deployment"
          ]
        },
        {
          title: "Records of Processing Activities (RoPA)",
          description: "Comprehensive documentation of all data processing activities",
          icon: "document-check",
          timeline: "4-8 weeks",
          compliance: "Mandatory documentation requirement",
          deliverables: [
            "Article 30 records of processing activities",
            "Processing purpose and legal basis documentation",
            "Data categories and retention period schedules",
            "Recipient and transfer documentation",
            "Regular review and update procedures"
          ]
        },
        {
          title: "International Transfer Compliance",
          description: "Lawful frameworks for cross-border data transfers",
          icon: "globe-alt",
          timeline: "6-12 weeks",
          compliance: "Transfers must have legal basis",
          deliverables: [
            "Transfer impact assessments (TIAs)",
            "Standard Contractual Clauses (SCCs) implementation",
            "Adequacy decision compliance verification",
            "Binding Corporate Rules (BCRs) for multinationals",
            "Supplementary measures and safeguards"
          ]
        }
      ]
    },
    principles: {
      title: "GDPR Principles & Compliance Requirements",
      subtitle: "Understanding the core GDPR principles and potential penalties for non-compliance.",
      items: [
        { principle: "Lawfulness, Fairness & Transparency", description: "Clear legal basis and transparent processing", penalty: "Up to €20M or 4% annual turnover" },
        { principle: "Purpose Limitation", description: "Specified, explicit and legitimate purposes", penalty: "Up to €20M or 4% annual turnover" },
        { principle: "Data Minimisation", description: "Adequate, relevant and limited processing", penalty: "Up to €20M or 4% annual turnover" },
        { principle: "Accuracy", description: "Accurate and up-to-date personal data", penalty: "Up to €20M or 4% annual turnover" },
        { principle: "Storage Limitation", description: "Limited retention periods", penalty: "Up to €20M or 4% annual turnover" },
        { principle: "Security", description: "Appropriate technical and organisational measures", penalty: "Up to €10M or 2% annual turnover" }
      ]
    },
    benefits: {
      title: "Privacy as Competitive Advantage",
      subtitle: "Transform GDPR compliance from regulatory burden into business advantage through privacy excellence.",
      items: [
        { title: "Customer Trust Building", description: "Demonstrate commitment to privacy protection, building stronger customer relationships and brand loyalty", icon: "users" },
        { title: "Cost Reduction", description: "Avoid significant regulatory fines while reducing data management costs through privacy-by-design", icon: "chart-line" },
        { title: "Market Differentiation", description: "Use privacy excellence as competitive differentiator in privacy-conscious markets", icon: "star" }
      ]
    }
  },
  fi: {
    title: "GDPR & Tietosuoja",
    subtitle: "Tietosuojavaatimustenmukaisuus & tietosuojahallinta",
    heroDescription: "Asiantunteva GDPR-toteutus ja tietosuojaohjelman hallinta, mukaan lukien tietokartoitus, tietosuojan vaikutusten arvioinnit, suostumushallinta, rekisteröityjen oikeuksien automatisointi ja jatkuva vaatimustenmukaisuuden seuranta kilpailuedun rakentamiseksi tietosuojan huippuosaamisen avulla.",
    forWho: "Organisaatioille, jotka käsittelevät EU:n asukkaiden henkilötietoja ja joiden on saavutettava ja ylläpidettävä GDPR-vaatimustenmukaisuus.",
    achieve: "Täysi GDPR-vaatimustenmukaisuus tietosuoja-by-designilla, automatisoiduilla rekisteröityjen oikeuksilla ja kestävällä tietosuojahallinnalla.",
    services: {
      title: "Kattavat tietosuojapalvelut",
      subtitle: "Päästä päähän -GDPR-vaatimustenmukaisuuspalvelut, jotka muuttavat tietosuojavelvoitteet kilpailueduiksi tietosuojan huippuosaamisen avulla.",
      items: [
        {
          title: "Tietosuojan vaikutusten arviointi (DPIA)",
          description: "Systemaattiset tietosuojan vaikutusten arvioinnit riskialttiille tietojenkäsittelytoimille",
          icon: "shield-check",
          timeline: "4-8 viikkoa per arviointi",
          compliance: "Pakollinen riskialttiille käsittelylle",
          deliverables: ["DPIA-menetelmän ja -kehyksen kehittäminen", "Riskialttiin käsittelyn tunnistaminen ja arviointi", "Sidosryhmien kuuleminen ja tietosuoja-asiantuntijan arvio", "Hallintatoimenpiteet ja jäännösriskin arviointi", "Jatkuvan seurannan ja tarkistuksen prosessit"]
        },
        {
          title: "Kattava tietokartoitus ja inventaario",
          description: "Täydellinen henkilötietojen virtojen ja käsittelytoimien kartoitus",
          icon: "database",
          timeline: "6-12 viikkoa",
          compliance: "GDPR-vaatimustenmukaisuuden perusta",
          deliverables: ["Henkilötietojen inventaario ja luokittelu", "Tietovirtojen kartoitus järjestelmien ja prosessien välillä", "Oikeudellisen perusteen tunnistaminen ja dokumentointi", "Tietojen säilytys- ja poistoaikataulut", "Kolmannen osapuolen tietojakamisjärjestelyt"]
        },
        {
          title: "Rekisteröityjen oikeuksien hallinta",
          description: "Automatisoidut järjestelmät yksilöiden tietosuojaoikeuksien hallintaan",
          icon: "users",
          timeline: "8-16 viikkoa",
          compliance: "Vastaus 30 päivän kuluessa vaaditaan",
          deliverables: ["Tarkastuspyyntöjen (SAR) automatisointi", "Oikaisu- ja poistamisoikeusmenettelyt", "Tietojen siirrettävyys ja jäsennelty vientikyvykkyys", "Suostumushallinta- ja peruuttamisjärjestelmät", "Vastustamis- ja automatisoidun päätöksenteon poistumismahdollisuudet"]
        },
        {
          title: "Tietosuoja-by-design -toteutus",
          description: "Tietosuojaperiaatteiden integrointi järjestelmiin ja prosesseihin",
          icon: "cog",
          timeline: "12-24 viikkoa",
          compliance: "Ennakoiva tietosuojaus",
          deliverables: ["Tietosuojavaikutusten arvioinnin integrointi", "Järjestelmäsuunnittelun tietosuojakatselmukset", "Oletusarvoisten tietosuoja-asetusten toteutus", "Tietojen minimointi- ja tarkoitussidonnaisuuskontrollit", "Tietosuojaa parantavan teknologian käyttöönotto"]
        },
        {
          title: "Kirjanpito käsittelytoimista (RoPA)",
          description: "Kattava dokumentointi kaikista tietojenkäsittelytoimista",
          icon: "document-check",
          timeline: "4-8 viikkoa",
          compliance: "Pakollinen dokumentointivaatimus",
          deliverables: ["Artikla 30:n mukainen kirjanpito käsittelytoimista", "Käsittelytarkoituksen ja oikeudellisen perusteen dokumentointi", "Tietoluokat ja säilytysaikataulut", "Vastaanottaja- ja siirtodokumentointi", "Säännölliset tarkistus- ja päivitysmenettelyt"]
        },
        {
          title: "Kansainvälisten siirtojen vaatimustenmukaisuus",
          description: "Lailliset puitteet rajat ylittäville tietosiirroille",
          icon: "globe-alt",
          timeline: "6-12 viikkoa",
          compliance: "Siirroilla on oltava laillinen peruste",
          deliverables: ["Siirron vaikutusten arvioinnit (TIA)", "Vakiosopimuslausekkeiden (SCC) käyttöönotto", "Riittävyyspäätösvaatimustenmukaisuuden varmennus", "Sitovat yrityssäännöt (BCR) monikansallisille yrityksille", "Lisätoimenpiteet ja suojatoimet"]
        }
      ]
    },
    principles: {
      title: "GDPR-periaatteet ja vaatimustenmukaisuusvaatimukset",
      subtitle: "GDPR:n keskeisten periaatteiden ja mahdollisten seuraamusten ymmärtäminen.",
      items: [
        { principle: "Laillisuus, asianmukaisuus ja läpinäkyvyys", description: "Selkeä laillinen peruste ja läpinäkyvä käsittely", penalty: "Jopa 20 miljoonaa euroa tai 4% vuosiliikevaihdosta" },
        { principle: "Tarkoituksen sidonnaisuus", description: "Erityiset, nimenomaiset ja lailliset tarkoitukset", penalty: "Jopa 20 miljoonaa euroa tai 4% vuosiliikevaihdosta" },
        { principle: "Tietojen minimointi", description: "Riittävä, olennainen ja rajoitettu käsittely", penalty: "Jopa 20 miljoonaa euroa tai 4% vuosiliikevaihdosta" },
        { principle: "Tarkkuus", description: "Tarkka ja ajantasainen henkilötieto", penalty: "Jopa 20 miljoonaa euroa tai 4% vuosiliikevaihdosta" },
        { principle: "Säilytyksen rajoittaminen", description: "Rajoitetut säilytysajat", penalty: "Jopa 20 miljoonaa euroa tai 4% vuosiliikevaihdosta" },
        { principle: "Turvallisuus", description: "Asianmukaiset tekniset ja organisatoriset toimenpiteet", penalty: "Jopa 10 miljoonaa euroa tai 2% vuosiliikevaihdosta" }
      ]
    },
    benefits: {
      title: "Tietosuoja kilpailuetuna",
      subtitle: "Muuta GDPR-vaatimustenmukaisuus sääntelytaakasta liiketoimintaeduksi tietosuojan huippuosaamisen avulla.",
      items: [
        { title: "Asiakasluottamuksen rakentaminen", description: "Osoita sitoutuminen tietosuojaan, rakentaen vahvempia asiakassuhteita ja brändiuskollisuutta", icon: "users" },
        { title: "Kustannusten vähentäminen", description: "Vältä merkittävät sääntelysakot vähentäen samalla tietojenhallintakustannuksia tietosuoja-by-designin avulla", icon: "chart-line" },
        { title: "Markkinaerottautuminen", description: "Käytä tietosuojan huippuosaamista kilpailullisena erottautumistekijänä tietosuojatietoisilla markkinoilla", icon: "star" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex items-center justify-between mb-1.5">
              <h3 class="text-sm font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                {service.title}
              </h3>
              <span class="text-xs font-medium text-[#0EA5E9] bg-blue-50 px-2 py-0.5 rounded-full border border-[#0EA5E9] relative z-10">
                {service.timeline}
              </span>
            </div>
            <p class="text-xs text-slate-500 mb-1.5 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
            <p class="text-xs text-slate-400 mb-2 relative z-10">{service.compliance}</p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <h4 class="text-xs font-semibold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300">
                {isFi ? 'Keskeiset toimitettavat' : 'Key Deliverables'}
              </h4>
              <ul class="space-y-1">
                {service.deliverables.slice(0, 4).map((deliverable) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {deliverable}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GDPR Principles Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.principles.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.principles.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.principles.items.map((principle) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {principle.principle}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {principle.description}
            </p>
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <p class="text-xs font-medium text-red-600">
                {isFi ? 'Enimmäisseuraamus:' : 'Max Penalty:'} {principle.penalty}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={benefit.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {benefit.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>