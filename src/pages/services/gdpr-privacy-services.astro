---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "GDPR and Privacy Services";

const content = {
  en: {
    title: "GDPR & Privacy",
    subtitle: "Data Protection Compliance",
    heroDescription: "Professional GDPR compliance and privacy services. We help organizations protect personal data and meet EU General Data Protection Regulation requirements. Protect personal data and meet GDPR requirements. We help organizations build a strong privacy foundation and achieve EU General Data Protection Regulation compliance.",
    forWho: "For organizations seeking to protect personal data and achieve EU GDPR compliance.",
    achieve: "GDPR compliance with comprehensive privacy protection and data management.",
    overview: {
      title: "Overview",
      description: "The General Data Protection Regulation (GDPR) is the EU's comprehensive data protection law that establishes rules for personal data processing. It requires organizations to implement appropriate technical and organizational measures to protect personal data and ensure individuals' privacy rights.",
      highlight: "Our expert team provides comprehensive GDPR compliance services, from initial assessment and gap analysis through implementation and ongoing compliance monitoring."
    },
    principles: {
      title: "GDPR Principles",
      subtitle: "GDPR is based on six principles that define the rules for personal data processing.",
      items: [
        { title: "Lawfulness", description: "Personal data processing must be lawful and justified", icon: "check", requirements: ["Consent", "Contract", "Legitimate interest"] },
        { title: "Purpose Limitation", description: "Personal data is processed only for specified purposes", icon: "target", requirements: ["Clear purposes", "No incompatible uses", "Purpose documentation"] },
        { title: "Data Minimization", description: "Only necessary personal data is processed", icon: "minus", requirements: ["Minimum data", "Adequate data", "No excessive data"] },
        { title: "Accuracy", description: "Personal data is up-to-date and accurate", icon: "check", requirements: ["Data updates", "Error correction", "Verification processes"] },
        { title: "Storage Limitation", description: "Personal data is stored only for necessary time", icon: "clock", requirements: ["Retention periods", "Deletion processes", "Archiving"] },
        { title: "Security & Confidentiality", description: "Personal data is protected with appropriate technical and organizational measures", icon: "shield", requirements: ["Encryption", "Access controls", "Security policies"] }
      ]
    },
    services: {
      title: "Privacy Services",
      subtitle: "Comprehensive services for GDPR compliance and privacy.",
      items: [
        { title: "GDPR Assessment", description: "Assess current GDPR compliance and identify gaps", icon: "chart-line", features: ["Compliance audit", "Risk assessment", "Recommendations"] },
        { title: "Privacy by Design", description: "Integrate privacy into system design from the start", icon: "shield", features: ["Privacy impact assessment", "Design guidelines", "Testing"] },
        { title: "Privacy Documentation", description: "Create required privacy documents and processes", icon: "document", features: ["Privacy notices", "Policy documentation", "Process descriptions"] },
        { title: "Personal Data Management", description: "Manage personal data throughout its lifecycle", icon: "user", features: ["Data mapping", "Processing register", "Deletion processes"] }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Clear and structured process for GDPR compliance.",
      items: [
        { number: "01", title: "GDPR Assessment", description: "Assess current privacy and GDPR compliance" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Planning", description: "Plan GDPR compliance program" },
        { number: "04", title: "Implementation", description: "Implement required privacy measures" },
        { number: "05", title: "Monitoring", description: "Continuous compliance monitoring and updates" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "GDPR compliance assessment report",
        "Privacy gap analysis and roadmap",
        "Privacy by design framework",
        "Privacy notice and policy documentation",
        "Data processing register",
        "Privacy impact assessment procedures",
        "Staff training materials",
        "Ongoing compliance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Meet EU GDPR requirements",
        "Protect personal data",
        "Reduce privacy risks",
        "Improve customer trust",
        "Avoid fines and sanctions"
      ]
    }
  },
  fi: {
    title: "GDPR & Tietosuoja",
    subtitle: "Tietosuojan Vaatimustenmukaisuus",
    heroDescription: "Ammattimaiset GDPR yhteensopivuus- ja tietosuoja-palvelut. Autamme organisaatioita suojaamaan henkilötietoja ja täyttämään EU:n tietosuoja-asetuksen vaatimukset. Suojaa henkilötietoja ja täytä GDPR vaatimukset. Autamme organisaatioita rakentamaan vahvan tietosuoja-perustan ja saavuttamaan EU:n tietosuoja-asetuksen yhteensopivuuden.",
    forWho: "Organisaatioille, jotka haluavat suojata henkilötietoja ja saavuttaa EU:n GDPR-vaatimustenmukaisuuden.",
    achieve: "GDPR-vaatimustenmukaisuus kattavalla tietosuojalla ja henkilötietojen hallinnalla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Yleinen tietosuoja-asetus (GDPR) on EU:n kattava tietosuojalaki, joka asettaa säännöt henkilötietojen käsittelylle. Se vaatii organisaatioita toteuttamaan asianmukaiset tekniset ja organisatoriset toimenpiteet henkilötietojen suojaamiseksi ja yksilöiden tietosuoja-oikeuksien varmistamiseksi.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia GDPR-yhteensopivuuspalveluita alkukartoituksesta ja aukkoanalyysistä toteutukseen ja jatkuvaan vaatimustenmukaisuuden seurantaan."
    },
    principles: {
      title: "GDPR Periaatteet",
      subtitle: "GDPR perustuu kuuteen periaatteeseen, jotka määrittelevät henkilötietojen käsittelyn säännöt.",
      items: [
        { title: "Lainmukaisuus", description: "Henkilötietojen käsittely on oltava laillista ja oikeutettua", icon: "check", requirements: ["Suostumus", "Sopimus", "Lainmukainen etu"] },
        { title: "Tarkoituksenmukaisuus", description: "Henkilötietoja käsitellään vain määriteltyihin tarkoituksiin", icon: "target", requirements: ["Selkeät tarkoitukset", "Ei yhteensopimattomia käyttötarkoituksia", "Tarkoituksen dokumentointi"] },
        { title: "Tietojen Minimointi", description: "Käsitellään vain tarvittavat henkilötiedot", icon: "minus", requirements: ["Vähimmäistieto", "Tarkoituksenmukaiset tiedot", "Ei ylimääräisiä tietoja"] },
        { title: "Tarkkuus", description: "Henkilötiedot ovat ajan tasalla ja tarkkoja", icon: "check", requirements: ["Tietojen päivitys", "Virheiden korjaus", "Tarkistusprosessit"] },
        { title: "Tallennusrajoitukset", description: "Henkilötiedot säilytetään vain tarvittavan ajan", icon: "clock", requirements: ["Säilytysajat", "Poistoprosessit", "Arkkivointi"] },
        { title: "Tietoturva & Luottamuksellisuus", description: "Henkilötiedot suojataan asianmukaisilla teknisillä ja organisatorisilla toimenpiteillä", icon: "shield", requirements: ["Salaus", "Käyttöoikeudet", "Tietoturvapolitiikat"] }
      ]
    },
    services: {
      title: "Tietosuoja Palvelut",
      subtitle: "Kattavat palvelut GDPR yhteensopivuuteen ja tietosuojaan.",
      items: [
        { title: "GDPR Arviointi", description: "Arvioidaan nykyinen GDPR yhteensopivuus ja tunnistetaan puutteet", icon: "chart-line", features: ["Yhteensopivuusauditointi", "Riskien arviointi", "Suositukset"] },
        { title: "Tietosuoja Suunnittelu", description: "Integroidaan tietosuoja jo järjestelmien suunnitteluvaiheessa", icon: "shield", features: ["Tietosuoja-analyysi", "Suunnitteluohjeet", "Testaus"] },
        { title: "Tietosuoja Dokumentaatio", description: "Luodaan tarvittavat tietosuoja-asiakirjat ja prosessit", icon: "document", features: ["Tietosuojaselosteet", "Käytäntöjen dokumentointi", "Prosessikuvaukset"] },
        { title: "Henkilötietojen Hallinta", description: "Hallitaan henkilötietojen koko elinkaari", icon: "user", features: ["Tietojen kartoitus", "Käsittelyrekisteri", "Poistoprosessit"] }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi GDPR yhteensopivuuteen.",
      items: [
        { number: "01", title: "GDPR Arviointi", description: "Arvioidaan nykyinen tietosuoja ja GDPR yhteensopivuus" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Suunnittelu", description: "Suunnitellaan GDPR yhteensopivuusohjelma" },
        { number: "04", title: "Toteutus", description: "Toteutetaan tarvittavat tietosuoja-toimenpiteet" },
        { number: "05", title: "Valvonta", description: "Jatkuva yhteensopivuuden valvonta ja päivitys" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "GDPR-yhteensopivuusarviointiraportti",
        "Tietosuoja-aukkoanalyysi ja tiekartta",
        "Tietosuoja-suunnittelun kehys",
        "Tietosuojaselosteet ja käytäntödokumentaatio",
        "Henkilötietojen käsittelyrekisteri",
        "Tietosuoja-analyysimenettelyt",
        "Henkilöstön koulutusmateriaalit",
        "Jatkuva yhteensopivuustuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Täytä EU tietosuoja-asetuksen vaatimukset",
        "Suojaa henkilötietoja",
        "Vähennä tietosuoja-riskejä",
        "Paranna asiakkaiden luottamusta",
        "Vältä sakot ja sanktiot"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Principles Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.principles.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.principles.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.principles.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.requirements.map((req) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {item.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>