---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Virtual CISO (V-CISO)";

const content = {
  en: {
    title: "Virtual CISO (V-CISO)",
    subtitle: "Chief Information Security Officer Service",
    heroDescription: "Experienced Chief Information Security Officer expertise without full-time recruitment. From strategy to execution in security leadership. We build security strategy, governance, and hands-on execution from a single partner.",
    forWho: "For organizations seeking experienced security leadership without full-time recruitment costs.",
    achieve: "Strategic security leadership with governance, risk management, and compliance oversight.",
    overview: {
      title: "Service Overview",
      description: "Our Virtual CISO service provides experienced Chief Information Security Officer expertise without full-time recruitment. We offer strategic leadership, compliance oversight, and risk management tailored to your organization's needs.",
      highlight: "We build security strategy, governance, and hands-on execution from a single partner."
    },
    serviceModels: {
      title: "Service Models",
      subtitle: "Choose the V-CISO service model that best fits your organization's needs",
      items: [
        {
          title: "Full-Service V-CISO",
          description: "Comprehensive security leadership solution covering all aspects of cybersecurity governance and strategy.",
          icon: "user-circle",
          features: ["Strategic Planning", "Governance Framework Development", "Risk Management Strategy", "Stakeholder Reporting", "Crisis Management", "Privacy Governance"]
        },
        {
          title: "Strategic V-CISO",
          description: "Focuses on strategic planning, governance development, and long-term security vision.",
          icon: "chart-bar",
          features: ["Security Strategy Development", "Governance Model Design", "Risk Prioritization", "Stakeholder Training", "Board Meetings", "Investment Plans"]
        },
        {
          title: "Project V-CISO",
          description: "Supports specific projects such as certifications, incident response, or crisis management.",
          icon: "clipboard",
          features: ["Certification Projects", "Incident Response Management", "Crisis Management Planning", "Security Audits", "Vendor Risk Management", "Contract Negotiations"]
        }
      ]
    },
    process: {
      title: "Engagement Process",
      subtitle: "Structured approach to delivering V-CISO services.",
      items: [
        { number: "01", title: "Discovery", description: "Assess current security posture and objectives" },
        { number: "02", title: "Strategy", description: "Develop security strategy and roadmap" },
        { number: "03", title: "Implementation", description: "Implement governance and controls" },
        { number: "04", title: "Monitoring", description: "Ongoing management and reporting" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Security strategy and roadmap",
        "Governance model and practices",
        "Risk management framework",
        "Stakeholder reporting",
        "Training programs",
        "Crisis management plans",
        "Cybersecurity risk management plans",
        "Compliance assurance"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "No full-time recruitment or salary overhead",
        "Access to senior expertise",
        "Flexible engagement model",
        "Quick deployment",
        "No recruitment costs",
        "Scalable support as needed"
      ]
    }
  },
  fi: {
    title: "Virtuaalinen CISO (V-CISO)",
    subtitle: "Chief Information Security Officer -palvelu",
    heroDescription: "Kokeneen Chief Information Security Officerin palvelu osaamisella ilman pysyvää rekrytointia. Strategiaa toteutukseen turvallisuuden johtamisessa. Rakennamme turvallisuusstrategian, hallintamallin ja käytännön toteutuksen yhden kumppanin kautta.",
    forWho: "Organisaatioille, jotka tarvitsevat kokenutta turvallisuusjohtamista ilman kokoaikaisen rekrytoinnin kustannuksia.",
    achieve: "Strateginen turvallisuusjohtaminen hallintamallilla, riskienhallinnalla ja sääntelyn noudattamisella.",
    overview: {
      title: "Yleiskatsaus palveluun",
      description: "Virtuaalinen CISO -palvelumme tarjoaa kokeneen Chief Information Security Officerin osaamisen ilman pysyvää rekrytointia. Tarjoamme strategista johtajuutta, sääntelyn noudattamista ja riskienhallintaa organisaatiosi tarpeisiin sopivalla mallilla.",
      highlight: "Rakennamme turvallisuusstrategian, hallintamallin ja käytännön toteutuksen yhden kumppanin kautta."
    },
    serviceModels: {
      title: "Palvelumallit",
      subtitle: "Valitse organisaatiosi tarpeisiin sopivin V-CISO-palvelumalli",
      items: [
        {
          title: "Täyspalvelu V-CISO",
          description: "Kokonaisvaltainen turvallisuuden johtamisratkaisu, joka kattaa kaikki kyberturvan hallinnolliset ja strategiset toiminnot.",
          icon: "user-circle",
          features: ["Strateginen suunnittelu", "Hallintamallin rakentaminen", "Riskinhallintastrategia", "Sidosryhmäraportointi", "Kriisinhallinta", "Tietosuojan hallinta"]
        },
        {
          title: "Strateginen V-CISO",
          description: "Keskittyy strategiseen suunnitteluun, hallintamallin kehittämiseen ja pitkän aikavälin turvallisuusvision luomiseen.",
          icon: "chart-bar",
          features: ["Turvallisuusstrategian kehittäminen", "Hallintamallin suunnittelu", "Riskien priorisointi", "Sidosryhmäkoulutus", "Kokoukset johtokunnan kanssa", "Sijoitussuunnitelmat"]
        },
        {
          title: "Projekti-V-CISO",
          description: "Tukee tiettyjä projekteja kuten sertifiointeja, vaarallisten tilanteiden hallintaa tai kriisinhallintaa.",
          icon: "clipboard",
          features: ["Sertifiointiprojektit", "Tietoturvaloukkausten hallinta", "Kriisinhallintasuunnittelu", "Tietoturvaa koskevat tarkastukset", "Toimittajien riskien hallinta", "Sopimusneuvottelut"]
        }
      ]
    },
    process: {
      title: "Toimintamalli",
      subtitle: "Rakenteinen lähestymistapa V-CISO-palveluiden tuottamiseen.",
      items: [
        { number: "01", title: "Alkukartoitus", description: "Arvioidaan nykyinen turvallisuustilanne ja tavoitteet" },
        { number: "02", title: "Strategia", description: "Kehitetään turvallisuusstrategia ja tiekartta" },
        { number: "03", title: "Toteutus", description: "Toteutetaan hallintamalli ja kontrollit" },
        { number: "04", title: "Seuranta", description: "Jatkuva hallinta ja raportointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Turvallisuusstrategia ja roadmap",
        "Hallintamalli ja käytännöt",
        "Riskinhallintakehys",
        "Sidosryhmäraportointi",
        "Koulutussuunnitelmat",
        "Kriisinhallintasuunnitelmat",
        "Tietoturvariskien hallintasuunnitelmat",
        "Sääntelyn noudattamisen takaaminen"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Ei kokopäiväisen rekrytoinnin tai palkan kustannuksia",
        "Pääsy kokeneeseen asiantuntijaosaamiseen",
        "Joustava käyttöönotto",
        "Nopea käynnistys",
        "Ilman rekrytointikustannuksia",
        "Skaalautuva tuki tarpeen mukaan"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#131c2e] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#003580] p-4 rounded-r-lg">
          <p class="text-[#131c2e] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>
  <!-- Service Models Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.serviceModels.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.serviceModels.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.serviceModels.items.map((model) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={model.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {model.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {model.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {model.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>