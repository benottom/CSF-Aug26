---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Audit Preparation and Internal Audits";

const content = {
  en: {
    title: "Audit Preparation",
    subtitle: "ISO 27001, SOC 2, NIS2/DORA",
    heroDescription: "We prepare and lead audits (ISO 27001, SOC 2, NIS2/DORA) with no surprises. Comprehensive audit preparation and internal audit services to ensure your audit proceeds smoothly and objectives are achieved.",
    forWho: "For organizations preparing for ISO 27001, SOC 2, NIS2/DORA, or other compliance audits seeking expert preparation and internal audit support.",
    achieve: "Successful audit outcomes with comprehensive preparation, internal audits, and no surprises.",
    overview: {
      title: "Overview",
      description: "Audit preparation is critical for achieving successful certification or compliance outcomes. Whether you're preparing for ISO 27001, SOC 2, NIS2/DORA, or other frameworks, comprehensive preparation ensures your audit proceeds smoothly and objectives are achieved.",
      highlight: "Our expert team provides comprehensive audit preparation and internal audit services, ensuring no surprises and successful audit outcomes across all major cybersecurity and compliance frameworks."
    },
    offerings: {
      title: "Audit Preparation Services",
      subtitle: "We ensure your audit proceeds smoothly and objectives are achieved.",
      items: [
        { title: "Gap Analysis & Remediation", description: "Identify gaps and remediate them before the audit", icon: "check" },
        { title: "Evidence Management", description: "Documentation and evidence properly organized", icon: "document" },
        { title: "Auditor Coordination", description: "Smooth communication and scheduling", icon: "user" },
        { title: "Internal Auditing", description: "Pre-audit and preparation activities", icon: "shield" }
      ]
    },
    standards: {
      title: "Supported Standards",
      subtitle: "We help prepare for all major cybersecurity and compliance audits.",
      items: [
        { title: "ISO 27001", description: "Information Security Management System certification", icon: "shield-check" },
        { title: "SOC 2", description: "SOC 2 Type I and Type II reports", icon: "building" },
        { title: "NIS2 & DORA", description: "EU cybersecurity and financial regulation", icon: "globe" },
        { title: "ISO 22301", description: "Business Continuity Management", icon: "award" }
      ]
    },
    phases: {
      title: "Audit Phases",
      subtitle: "We support your organization at each phase to achieve a successful audit.",
      items: [
        {
          title: "Pre-Preparation",
          icon: "search",
          features: ["Requirements mapping", "Gap analysis", "Remediation actions", "Evidence collection"]
        },
        {
          title: "Preparation",
          icon: "clipboard",
          features: ["Documentation organization", "Staff training", "Process testing", "Internal audit"]
        },
        {
          title: "Audit",
          icon: "certificate",
          features: ["Auditor support", "Interview support", "Documentation assistance", "Technical support"]
        }
      ]
    },
    process: {
      title: "Preparation Process",
      subtitle: "Systematic approach to audit success.",
      items: [
        { number: "01", title: "Initial Assessment", description: "Current state and objectives definition" },
        { number: "02", title: "Gap Analysis", description: "Gap identification and prioritization" },
        { number: "03", title: "Remediation Plan", description: "Action plan and timeline" },
        { number: "04", title: "Implementation", description: "Control implementation and testing" },
        { number: "05", title: "Readiness", description: "Final preparation and audit" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Gap analysis report",
        "Remediation plan and roadmap",
        "Evidence management framework",
        "Documentation organization",
        "Internal audit program",
        "Staff training materials",
        "Auditor coordination support",
        "Post-audit improvement plan"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Successful audit outcomes",
        "No surprises during audit",
        "Efficient audit process",
        "Reduced audit costs",
        "Comprehensive preparation"
      ]
    }
  },
  fi: {
    title: "Auditointivalmistelu",
    subtitle: "ISO 27001, SOC 2, NIS2/DORA",
    heroDescription: "Valmistelemme ja johdamme auditoinnit (ISO 27001, SOC 2, NIS2/DORA) ilman yllätyksiä. Kattava auditointien valmistelu- ja sisäiset auditointipalvelut varmistamaan, että auditointinne sujuu ongelmitta ja tavoitteet saavutetaan.",
    forWho: "Organisaatioille, jotka valmistautuvat ISO 27001, SOC 2, NIS2/DORA tai muihin compliance-auditointeihin ja tarvitsevat asiantuntevaa valmistelu- ja sisäistä auditointitukea.",
    achieve: "Onnistuneet auditointitulokset kattavalla valmistelulla, sisäisillä auditoinneilla ja ilman yllätyksiä.",
    overview: {
      title: "Yleiskatsaus",
      description: "Auditointivalmistelu on kriittinen onnistuneen sertifioinnin tai vaatimustenmukaisuuden saavuttamiseksi. Valmistauduitpa ISO 27001, SOC 2, NIS2/DORA tai muihin viitekehyksiin, kattava valmistelu varmistaa, että auditointinne sujuu ongelmitta ja tavoitteet saavutetaan.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia auditointivalmistelu- ja sisäisiä auditointipalveluita, varmistaen ettei yllätyksiä tule ja onnistuneet auditointitulokset saavutetaan kaikissa keskeisissä kyberturva- ja compliance-viitekehyksissä."
    },
    offerings: {
      title: "Auditointivalmistelupalvelut",
      subtitle: "Varmistamme, että auditointinne sujuu ongelmitta ja tavoitteet saavutetaan.",
      items: [
        { title: "Aukkoanalyysi & korjaukset", description: "Tunnistamme puutteet ja korjaamme ne ennen auditointia", icon: "check" },
        { title: "Evidenssien hallinta", description: "Dokumentaatio ja todistusaineisto kunnossa", icon: "document" },
        { title: "Auditoijan koordinointi", description: "Sujuva kommunikaatio ja aikataulutus", icon: "user" },
        { title: "Sisäinen auditointi", description: "Ennakkoauditointi ja valmistautuminen", icon: "shield" }
      ]
    },
    standards: {
      title: "Tuetut standardit",
      subtitle: "Autamme valmistautumaan kaikkiin keskeisimpiin kyberturva- ja compliance-auditointeihin.",
      items: [
        { title: "ISO 27001", description: "Tietoturvan hallintajärjestelmän sertifiointi", icon: "shield-check" },
        { title: "SOC 2", description: "SOC 2 Type I ja Type II raportit", icon: "building" },
        { title: "NIS2 & DORA", description: "EU:n kyberturva- ja rahoitussääntely", icon: "globe" },
        { title: "ISO 22301", description: "Liiketoiminnan jatkuvuuden hallinta", icon: "award" }
      ]
    },
    phases: {
      title: "Auditointivaiheet",
      subtitle: "Jokaisessa vaiheessa tuemme organisaatiotanne menestyksekkään auditoinnin saavuttamiseksi.",
      items: [
        {
          title: "Ennakkovalmistelu",
          icon: "search",
          features: ["Vaatimusten kartoitus", "Aukkoanalyysi", "Korjaustoimenpiteet", "Evidenssien keruu"]
        },
        {
          title: "Valmistelu",
          icon: "clipboard",
          features: ["Dokumentaation organisointi", "Henkilöstön koulutus", "Prosessien testaus", "Sisäinen auditointi"]
        },
        {
          title: "Auditointi",
          icon: "certificate",
          features: ["Auditoijan tuki", "Haastattelutuki", "Dokumentaatio-apu", "Tekninen tuki"]
        }
      ]
    },
    process: {
      title: "Valmisteluprosessi",
      subtitle: "Systemaattinen lähestymistapa auditointimenestykseen.",
      items: [
        { number: "01", title: "Alkukartoitus", description: "Nykytilan ja tavoitteiden määrittely" },
        { number: "02", title: "Aukkoanalyysi", description: "Puutteiden tunnistaminen ja priorisointi" },
        { number: "03", title: "Korjaussuunnitelma", description: "Toimenpidesuunnitelma ja aikataulu" },
        { number: "04", title: "Toteutus", description: "Kontrollien käyttöönotto ja testaus" },
        { number: "05", title: "Valmius", description: "Lopullinen valmistelu ja auditointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Aukkoanalyysiraportti",
        "Korjaussuunnitelma ja tiekartta",
        "Evidenssien hallintakehys",
        "Dokumentaation organisointi",
        "Sisäinen auditointiohjelma",
        "Henkilöstön koulutusmateriaalit",
        "Auditoijan koordinointituki",
        "Auditoinnin jälkeinen parannussuunnitelma"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Onnistuneet auditointitulokset",
        "Ei yllätyksiä auditoinnin aikana",
        "Tehokas auditointiprosessi",
        "Pienemmät auditointikustannukset",
        "Kattava valmistelu"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-blue-50 rounded-2xl border-2 border-[#003580] shadow-lg p-6 md:p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#003580] rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl md:text-2xl font-bold text-[#131c2e]">{currentContent.overview.title}</h2>
        </div>
        <p class="text-slate-700 leading-relaxed mb-4 pl-14">{currentContent.overview.description}</p>
        <div class="bg-white/70 rounded-xl border border-[#003580]/30 p-4 pl-14">
          <p class="text-[#131c2e] font-semibold flex items-start gap-2">
            <svg class="w-5 h-5 text-[#003580] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {currentContent.overview.highlight}
          </p>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Offerings Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.offerings.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.offerings.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.offerings.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Standards Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.standards.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.standards.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.standards.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Audit Phases Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.phases.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.phases.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-lg flex items-center justify-center text-white font-bold text-sm">
                {index + 1}
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {phase.title}
            </h3>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {phase.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>