---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Common Criteria";

const content = {
  en: {
    title: "Common Criteria",
    subtitle: "Security Evaluation & Certification",
    heroDescription: "Professional Common Criteria certification and evaluation services. We help organizations achieve international cybersecurity standards. Achieve Common Criteria certification and strengthen your organization's security reliability.",
    forWho: "For organizations seeking Common Criteria certification for their IT products at EAL1-EAL7 levels.",
    achieve: "Successful Common Criteria certification with expert guidance and comprehensive documentation.",
    overview: {
      title: "Overview",
      description: "Common Criteria is an international standard (ISO/IEC 15408) for computer security certification. It provides a framework for specifying security requirements and evaluating IT products against those requirements.",
      highlight: "Our expert team provides end-to-end support for Common Criteria certification, from Security Target development and Protection Profile compliance through evaluation support and certification maintenance."
    },
    components: {
      title: "Common Criteria Components",
      subtitle: "Common Criteria is based on four main components that define security evaluation.",
      items: [
        { title: "Security Objectives", description: "Define security objectives and requirements", icon: "target", features: ["Security objectives", "Security requirements", "Threat models"] },
        { title: "Security Measures", description: "Implement security measures and mechanisms", icon: "shield", features: ["Security mechanisms", "Security policies", "Security protocols"] },
        { title: "Security Testing", description: "Conduct comprehensive security testing", icon: "clipboard-check", features: ["Penetration testing", "Vulnerability testing", "Security analysis"] },
        { title: "Security Documentation", description: "Create comprehensive security documentation", icon: "document", features: ["Security guides", "Security policies", "Security processes"] }
      ]
    },
    levels: {
      title: "Evaluation Assurance Levels (EAL)",
      subtitle: "Common Criteria defines seven evaluation levels (EAL1-EAL7) to determine security assurance.",
      items: [
        { level: "EAL1", title: "Functionally Tested", description: "Basic security testing and documentation", icon: "minus" },
        { level: "EAL2", title: "Structurally Tested", description: "Substantial security testing and analysis", icon: "check" },
        { level: "EAL3", title: "Methodically Tested & Checked", description: "High level security testing and analysis", icon: "shield" },
        { level: "EAL4", title: "Methodically Designed & Reviewed", description: "Substantial design and testing", icon: "target" },
        { level: "EAL5", title: "Semiformally Designed & Tested", description: "High level design and testing", icon: "shield" },
        { level: "EAL6", title: "Semiformally Verified Design & Tested", description: "Substantial assurance and testing", icon: "check" },
        { level: "EAL7", title: "Formally Verified Design & Tested", description: "High level assurance and testing", icon: "shield" }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Clear and structured process for Common Criteria certification.",
      items: [
        { number: "01", title: "Common Criteria Assessment", description: "Assess current security posture against Common Criteria requirements" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Planning", description: "Plan Common Criteria certification program" },
        { number: "04", title: "Implementation", description: "Implement required security measures" },
        { number: "05", title: "Certification", description: "Pass Common Criteria certification" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Security Target (ST) documentation",
        "Protection Profile (PP) compliance assessment",
        "Evaluation evidence and documentation",
        "Certification package and reports",
        "Evaluation lab support and liaison",
        "Certification body communication",
        "Maintenance and renewal support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Achieve internationally recognized certification",
        "Demonstrate product security to customers",
        "Competitive advantage in security markets",
        "Meet government and defense requirements",
        "Streamlined evaluation process support"
      ]
    }
  },
  fi: {
    title: "Common Criteria",
    subtitle: "Tietoturvan Arviointi & Sertifiointi",
    heroDescription: "Ammattimaiset Common Criteria sertifiointi- ja arviointipalvelut. Autamme organisaatioita saavuttamaan kansainvälisen tietoturvastandardin. Saavuta Common Criteria sertifiointi ja vahvista organisaatiosi tietoturvan luotettavuus.",
    forWho: "Organisaatioille, jotka tavoittelevat Common Criteria -sertifiointia IT-tuotteilleen EAL1-EAL7-tasoilla.",
    achieve: "Onnistunut Common Criteria -sertifiointi asiantuntevalla ohjauksella ja kattavalla dokumentaatiolla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Common Criteria on kansainvälinen standardi (ISO/IEC 15408) tietokoneiden turvallisuussertifiointiin. Se tarjoaa kehyksen turvallisuusvaatimusten määrittelyyn ja IT-tuotteiden arviointiin näitä vaatimuksia vastaan.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea Common Criteria -sertifiointiin Security Target -kehityksestä ja Protection Profile -vaatimustenmukaisuudesta arviointitukeen ja sertifioinnin ylläpitoon."
    },
    components: {
      title: "Common Criteria -komponentit",
      subtitle: "Common Criteria perustuu neljään pääkomponenttiin, jotka määrittelevät tietoturvan arvioinnin.",
      items: [
        { title: "Tietoturvatavoitteet", description: "Määritellään tietoturvatavoitteet ja -vaatimukset", icon: "target", features: ["Tietoturvatavoitteet", "Tietoturvavaatimukset", "Uhkien mallit"] },
        { title: "Tietoturvatoimenpiteet", description: "Toteutetaan tietoturvatoimenpiteet ja -mekanismit", icon: "shield", features: ["Tietoturvamekanismit", "Tietoturvapolitiikat", "Tietoturvaprotokollat"] },
        { title: "Tietoturvatestaus", description: "Suoritetaan kattavat tietoturvatestit", icon: "clipboard-check", features: ["Penetraatiotestit", "Haavoittuvuustestit", "Tietoturva-analyysi"] },
        { title: "Tietoturvadokumentaatio", description: "Luodaan kattava tietoturvadokumentaatio", icon: "document", features: ["Tietoturvaohjeet", "Tietoturvapolitiikat", "Tietoturvaprosessit"] }
      ]
    },
    levels: {
      title: "Arvioinnin varmuustasot (EAL)",
      subtitle: "Common Criteria määrittelee seitsemän arviointitasoa (EAL1-EAL7) tietoturvan luotettavuuden määrittämiseksi.",
      items: [
        { level: "EAL1", title: "Toiminnallisesti testattu", description: "Perustason tietoturvatestaus ja dokumentaatio", icon: "minus" },
        { level: "EAL2", title: "Rakenteellisesti testattu", description: "Merkittävä tietoturvatestaus ja analyysi", icon: "check" },
        { level: "EAL3", title: "Menetelmällisesti testattu ja tarkistettu", description: "Korkeatason tietoturvatestaus ja analyysi", icon: "shield" },
        { level: "EAL4", title: "Menetelmällisesti suunniteltu ja tarkastettu", description: "Merkittävä suunnittelu ja testaus", icon: "target" },
        { level: "EAL5", title: "Puoliformaalisti suunniteltu ja testattu", description: "Korkeatason suunnittelu ja testaus", icon: "shield" },
        { level: "EAL6", title: "Puoliformaalisti varmennettu suunnittelu ja testaus", description: "Merkittävä varmistus ja testaus", icon: "check" },
        { level: "EAL7", title: "Formaalisti varmennettu suunnittelu ja testaus", description: "Korkeatason varmistus ja testaus", icon: "shield" }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi Common Criteria -sertifiointiin.",
      items: [
        { number: "01", title: "Common Criteria -arviointi", description: "Arvioidaan nykyinen tietoturvataso Common Criteria -vaatimusten suhteen" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Suunnittelu", description: "Suunnitellaan Common Criteria -sertifiointiohjelma" },
        { number: "04", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { number: "05", title: "Sertifiointi", description: "Läpäistään Common Criteria -sertifiointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Security Target (ST) -dokumentaatio",
        "Protection Profile (PP) -vaatimustenmukaisuusarviointi",
        "Arviointitodisteet ja dokumentaatio",
        "Sertifiointipaketti ja raportit",
        "Arviointilaboratorion tuki ja yhteistyö",
        "Sertifiointielimen viestintä",
        "Ylläpito- ja uusimistuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Saavuta kansainvälisesti tunnustettu sertifiointi",
        "Osoita tuoteturvallisuus asiakkaille",
        "Kilpailuetu turvallisuusmarkkinoilla",
        "Täytä hallituksen ja puolustuksen vaatimukset",
        "Virtaviivaistettu arviointiprosessin tuki"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#3B82F6] p-4 rounded-r-lg">
          <p class="text-[#1E2A7A] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>
  <!-- Components Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.components.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.components.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.components.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Evaluation Levels Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.levels.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.levels.subtitle}
        </p>
      </div>
      
      <div class="max-w-3xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {currentContent.levels.items.map((level) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {level.level.slice(-1)}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {level.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {level.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>