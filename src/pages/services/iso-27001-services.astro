---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO 27001 Services";

const content = {
  en: {
    title: "ISO 27001",
    subtitle: "Information Security Management System",
    heroDescription: "Professional ISO 27001 Information Security Management System certification and consulting services. We help organizations build a strong cybersecurity foundation. Build a strong cybersecurity foundation according to ISO 27001 standard. We help organizations achieve international information security standard.",
    forWho: "For organizations seeking ISO 27001 certification and building a strong information security management system.",
    achieve: "ISO 27001 certification with comprehensive security controls and risk management.",
    overview: {
      title: "Overview",
      description: "ISO 27001 is the international standard for Information Security Management Systems (ISMS). It provides a systematic approach to managing sensitive company information, ensuring it remains secure through people, processes, and technology.",
      highlight: "Our expert team provides comprehensive ISO 27001 services, from gap analysis and ISMS design through certification support and ongoing maintenance, helping you build a strong security foundation."
    },
    services: {
      title: "ISO 27001 Services",
      subtitle: "Comprehensive services for ISO 27001 certification that support your organization's cybersecurity development.",
      items: [
        { title: "Gap Analysis", description: "Assess current security posture and identify gaps against ISO 27001 requirements", icon: "chart-line", features: ["Security risk assessment", "Requirements compliance check", "Improvement recommendations"] },
        { title: "ISMS Design", description: "Design and implement information security management system according to ISO 27001 standard", icon: "shield", features: ["Security policies", "Process definitions", "Role and responsibility clarification"] },
        { title: "Certification Support", description: "Prepare for and pass ISO 27001 certification audit", icon: "certificate", features: ["Internal auditing", "Certification audit preparation", "Continuous maintenance"] }
      ]
    },
    process: {
      title: "Certification Process",
      subtitle: "Clear and structured process for ISO 27001 certification.",
      items: [
        { number: "01", title: "Initial Assessment", description: "Assess current security posture and define objectives" },
        { number: "02", title: "ISMS Design", description: "Design security management system and define processes" },
        { number: "03", title: "Implementation", description: "Implement planned security measures" },
        { number: "04", title: "Internal Audit", description: "Conduct internal audit and fix gaps" },
        { number: "05", title: "Certification", description: "Pass certification audit and achieve ISO 27001" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Gap analysis report",
        "ISMS framework and documentation",
        "Security policies and procedures",
        "Risk assessment and treatment plan",
        "Statement of Applicability (SoA)",
        "Internal audit program",
        "Certification audit preparation",
        "Ongoing maintenance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Strengthen customer trust",
        "Protect business secrets",
        "Meet regulatory requirements",
        "Improve risk management",
        "Reduce security risks"
      ]
    }
  },
  fi: {
    title: "ISO 27001",
    subtitle: "Tietoturvajärjestelmän Hallinta",
    heroDescription: "Ammattimaiset ISO 27001 tietoturvajärjestelmän sertifiointi- ja konsultointipalvelut. Autamme organisaatioita rakentamaan vahvan tietoturvan perustan. Rakenna vahva tietoturvan perusta ISO 27001 standardin mukaisesti. Autamme organisaatioita saavuttamaan kansainvälisen tietoturvastandardin.",
    forWho: "Organisaatioille, jotka tavoittelevat ISO 27001 -sertifiointia ja rakentavat vahvaa tietoturvallisuuden hallintajärjestelmää.",
    achieve: "ISO 27001 -sertifiointi kattavilla turvallisuuskontrolleilla ja riskienhallinnalla.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27001 on kansainvälinen standardi tietoturvallisuuden hallintajärjestelmille (ISMS). Se tarjoaa systemaattisen lähestymistavan organisaation arkaluonteisten tietojen hallintaan varmistaen niiden turvallisuuden ihmisten, prosessien ja teknologian avulla.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia ISO 27001 -palveluita aukkoanalyysistä ja ISMS-suunnittelusta sertifiointitukeen ja jatkuvaan ylläpitoon auttaen sinua rakentamaan vahvan tietoturvan perustan."
    },
    services: {
      title: "ISO 27001 -palvelut",
      subtitle: "Kattavat palvelut ISO 27001 -sertifiointiin, joka tukee organisaatiosi tietoturvan kehitystä.",
      items: [
        { title: "Aukkoanalyysi", description: "Arvioi nykyisen tietoturvatason ja ISO 27001 -vaatimusten väliset erot", icon: "chart-line", features: ["Tietoturvariskien arviointi", "Vaatimusten vastaavuus", "Suositukset parannuksista"] },
        { title: "ISMS Suunnittelu", description: "Suunnittele ja toteuta tietoturvajärjestelmä ISO 27001 -standardin mukaisesti", icon: "shield", features: ["Tietoturvapolitiikat", "Prosessien määrittely", "Roolien ja vastuiden selvennys"] },
        { title: "Sertifiointituki", description: "Valmistaudu ja läpäise ISO 27001 -sertifiointiauditointi", icon: "certificate", features: ["Sisäinen auditointi", "Sertifiointiauditoinnin valmistelu", "Jatkuva ylläpito"] }
      ]
    },
    process: {
      title: "Sertifiointiprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi ISO 27001 -sertifiointiin.",
      items: [
        { number: "01", title: "Alustava arviointi", description: "Arvioidaan nykyinen tietoturvataso ja määritellään tavoitteet" },
        { number: "02", title: "ISMS Suunnittelu", description: "Suunnitellaan tietoturvajärjestelmä ja määritellään prosessit" },
        { number: "03", title: "Toteutus", description: "Toteutetaan suunnitellut tietoturvatoimenpiteet" },
        { number: "04", title: "Sisäinen auditointi", description: "Suoritetaan sisäinen auditointi ja korjataan puutteet" },
        { number: "05", title: "Sertifiointi", description: "Läpäistään sertifiointiauditointi ja saavutetaan ISO 27001" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Aukkoanalyysiraportti",
        "ISMS-kehys ja dokumentaatio",
        "Tietoturvakäytännöt ja -menettelyt",
        "Riskienarviointi- ja käsittelysuunnitelma",
        "Soveltuvuuslausuma (SoA)",
        "Sisäinen auditointiohjelma",
        "Sertifiointiauditoinnin valmistelu",
        "Jatkuva ylläpitotuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Vahvista asiakkaiden luottamusta",
        "Suojaa liikesalaisuudet",
        "Täytä sääntelyvaatimukset",
        "Paranna riskienhallintaa",
        "Vähennä tietoturvariskejä"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {service.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:border-[#3B82F6] transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>