---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "IEC 62443 Security";

const content = {
  en: {
    title: "IEC 62443 (OT/ICS) Security",
    subtitle: "Industrial Control Systems Compliance",
    heroDescription: "Expert IEC 62443 compliance services to secure your industrial automation and control systems (OT/ICS) infrastructure. IEC 62443 is the leading international standard for industrial cybersecurity. Our specialized team provides comprehensive maturity assessments, gap analysis, and remediation strategies to protect your critical operational technology from cyber threats.",
    forWho: "For industrial organizations with OT/ICS environments needing IEC 62443 compliance and security.",
    achieve: "IEC 62443 compliance with comprehensive maturity assessments and OT/ICS security controls.",
    overview: {
      title: "Overview",
      description: "IEC 62443 is the international standard for security of industrial automation and control systems (IACS). It provides a comprehensive framework for securing operational technology (OT) environments across manufacturing, energy, utilities, and critical infrastructure sectors.",
      highlight: "Our expert team specializes in OT/ICS cybersecurity, offering maturity assessments, remediation planning, and implementation support to help organizations achieve IEC 62443 compliance while maintaining operational safety and availability."
    },
    features: {
      title: "Our IEC 62443 Services",
      subtitle: "Comprehensive OT/ICS security services covering all aspects of IEC 62443 compliance",
      items: [
        { title: "Maturity Assessment", description: "Comprehensive evaluation of your OT/ICS security posture against IEC 62443 maturity levels", icon: "chart" },
        { title: "Gap Analysis & Remediation", description: "Detailed gap analysis with prioritized remediation roadmap for industrial control systems", icon: "wrench" },
        { title: "Zone & Conduit Design", description: "Strategic segmentation and secure communication design for industrial networks", icon: "network" },
        { title: "Risk Assessment", description: "OT-specific risk assessments considering safety, availability, and security requirements", icon: "shield" },
        { title: "Control Implementation", description: "Implementation of IEC 62443 security controls tailored for operational technology", icon: "cog" },
        { title: "Certification Support", description: "Expert guidance through IEC 62443 certification process and compliance validation", icon: "award" }
      ]
    },
    industries: {
      title: "Industries We Serve",
      subtitle: "Specialized IEC 62443 expertise across critical industrial sectors",
      items: [
        "Manufacturing",
        "Energy & Utilities",
        "Oil & Gas",
        "Chemical Processing",
        "Water Treatment",
        "Transportation",
        "Critical Infrastructure"
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "IEC 62443 maturity assessment report",
        "OT/ICS security gap analysis",
        "Zone and conduit architecture design",
        "Security requirements specification",
        "Remediation roadmap and timeline",
        "Control implementation guidelines",
        "Incident response procedures for OT",
        "Ongoing monitoring and maintenance plan"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Protect critical industrial infrastructure",
        "Meet international OT security standards",
        "Reduce operational disruption risks",
        "Demonstrate security maturity to stakeholders",
        "Comply with industrial cybersecurity regulations"
      ]
    }
  },
  fi: {
    title: "IEC 62443 (OT/ICS) -turvallisuus",
    subtitle: "Teollisuuden ohjausjärjestelmien vaatimustenmukaisuus",
    heroDescription: "Asiantuntevat IEC 62443 -vaatimustenmukaisuuspalvelut teollisuuden automaatio- ja ohjausjärjestelmien (OT/ICS) infrastruktuurin suojaamiseen. IEC 62443 on johtava kansainvälinen standardi teollisuuden kyberturvallisuudelle. Erikoistunut tiimimme tarjoaa kattavia kypsyysarviointeja, aukkoanalyysejä ja korjausstrategioita kriittisen operatiivisen teknologian suojaamiseksi kyberuhilta.",
    forWho: "Teollisille organisaatioille, joilla on OT/ICS-ympäristöjä ja jotka tarvitsevat IEC 62443 -vaatimustenmukaisuutta ja turvallisuutta.",
    achieve: "IEC 62443 -vaatimustenmukaisuus kattavilla kypsyysarvioinneilla ja OT/ICS-turvakontrolleilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "IEC 62443 on kansainvälinen standardi teollisuuden automaatio- ja ohjausjärjestelmien (IACS) turvallisuudelle. Se tarjoaa kattavan kehyksen operatiivisen teknologian (OT) ympäristöjen turvaamiseen valmistuksen, energian, vesihuollon ja kriittisen infrastruktuurin sektoreilla.",
      highlight: "Erikoistunut tiimimme keskittyy OT/ICS-kyberturvallisuuteen tarjoten kypsyysarviointeja, korjausten suunnittelua ja toteutustukea auttaaksemme organisaatioita saavuttamaan IEC 62443 -vaatimustenmukaisuuden samalla kun ylläpidetään toiminnan turvallisuutta ja käytettävyyttä."
    },
    features: {
      title: "IEC 62443 -palvelumme",
      subtitle: "Kattavat OT/ICS-turvallisuuspalvelut, jotka kattavat kaikki IEC 62443 -vaatimustenmukaisuuden näkökohdat",
      items: [
        { title: "Kypsyysarviointi", description: "Kattava arviointi OT/ICS-turvallisuustilanteestasi IEC 62443 -kypsyystasoja vastaan", icon: "chart" },
        { title: "Aukkoanalyysi ja korjaus", description: "Yksityiskohtainen aukkoanalyysi priorisoidulla korjaussuunnitelmalla teollisuuden ohjausjärjestelmille", icon: "wrench" },
        { title: "Vyöhyke- ja väyläsuunnittelu", description: "Strateginen segmentointi ja turvallinen viestintäsuunnittelu teollisuusverkoille", icon: "network" },
        { title: "Riskinarviointi", description: "OT-spesifiset riskinarvioinnit, joissa huomioidaan turvallisuus-, käytettävyys- ja suojausvaatimukset", icon: "shield" },
        { title: "Kontrollien toteutus", description: "IEC 62443 -turvakontrollien toteutus operatiiviselle teknologialle räätälöitynä", icon: "cog" },
        { title: "Sertifiointituki", description: "Asiantunteva ohjaus IEC 62443 -sertifiointiprosessin ja vaatimustenmukaisuuden validoinnin läpi", icon: "award" }
      ]
    },
    industries: {
      title: "Toimialat joita palvelemme",
      subtitle: "Erikoistunut IEC 62443 -asiantuntemus kriittisillä teollisuudenaloilla",
      items: [
        "Teollisuus",
        "Energia ja vesihuolto",
        "Öljy ja kaasu",
        "Kemiallinen prosessointi",
        "Vedenkäsittely",
        "Liikenne",
        "Kriittinen infrastruktuuri"
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "IEC 62443 -kypsyysarviointiraportti",
        "OT/ICS-turvallisuuden aukkoanalyysi",
        "Vyöhyke- ja väyläarkkitehtuurisuunnittelu",
        "Turvallisuusvaatimusten määrittely",
        "Korjausten tiekartta ja aikataulu",
        "Kontrollien toteutusohjeet",
        "Tapahtumien hallintamenettelyt OT:lle",
        "Jatkuvan seurannan ja ylläpidon suunnitelma"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Suojaa kriittistä teollisuusinfrastruktuuria",
        "Täytä kansainväliset OT-turvallisuusstandardit",
        "Vähennä operatiivisten häiriöiden riskejä",
        "Osoita turvallisuuskypsyyttä sidosryhmille",
        "Noudata teollisuuden kyberturvallisuusmääräyksiä"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.features.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.features.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.features.items.map((feature) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={feature.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {feature.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.industries.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industries.subtitle}
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3">
        {currentContent.industries.items.map((industry) => (
          <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3bb1f6]
                      transition-all duration-300
                      flex items-center gap-3 p-3 group">
            <div class="w-6 h-6 bg-[#3B82F6] rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-[#3B82F6] transition-colors duration-300">{industry}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefits.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefits.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>