---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "SOC 1 / ISAE 3402";

const content = {
  en: {
    title: "SOC 1 / ISAE 3402",
    subtitle: "Financial Reporting Controls Attestation",
    heroDescription: "Controls for financial reporting; evidence and auditor support. Comprehensive support for SOC 1 and ISAE 3402 attestation services.",
    forWho: "For organizations providing services that impact their customers' financial reporting and need SOC 1 / ISAE 3402 attestation.",
    achieve: "Successful SOC 1 / ISAE 3402 attestation with comprehensive controls evidence and auditor support.",
    overview: {
      title: "Overview",
      description: "SOC 1 (Service Organization Control 1) and ISAE 3402 are international standards for reporting on controls at service organizations that are relevant to user entities' internal control over financial reporting. They provide assurance to customers and stakeholders about the effectiveness of your controls.",
      highlight: "Our expert team provides comprehensive support for SOC 1 and ISAE 3402 attestation, from gap analysis and control implementation through audit readiness and ongoing compliance maintenance."
    },
    services: {
      title: "SOC 1 / ISAE 3402 Services",
      subtitle: "Comprehensive support for every stage of your attestation journey",
      items: [
        {
          title: "Gap Analysis & Readiness",
          description: "Assess your current controls and readiness for SOC 1 / ISAE 3402 attestation.",
          icon: "search",
          features: ["Current state assessment", "Compliance gap identification", "Remediation roadmap", "Readiness workshops"]
        },
        {
          title: "Control Mapping & Documentation",
          description: "Map and document controls relevant to financial reporting.",
          icon: "clipboard-check",
          features: ["Control framework mapping", "Policy and procedure documentation", "Evidence collection guidance", "Stakeholder training"]
        },
        {
          title: "Audit & Attestation Support",
          description: "Support for external audits and successful attestation.",
          icon: "certificate",
          features: ["Evidence management", "Audit liaison", "Remediation support", "Certification preparation"]
        }
      ]
    },
    process: {
      title: "Attestation Process",
      subtitle: "Structured approach to achieve SOC 1 / ISAE 3402 attestation",
      items: [
        { number: "01", title: "Assessment & Gap Analysis", description: "Evaluate current controls against SOC 1 / ISAE 3402 requirements." },
        { number: "02", title: "Control Implementation", description: "Implement and document required controls for financial reporting." },
        { number: "03", title: "Evidence Collection", description: "Gather and organize evidence to support control effectiveness." },
        { number: "04", title: "Audit & Attestation", description: "Support external audit and achieve successful attestation." }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Control gap analysis report",
        "Control framework documentation",
        "Policies and procedures",
        "Evidence collection framework",
        "Audit readiness assessment",
        "Audit liaison support",
        "Remediation guidance",
        "Ongoing compliance maintenance"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Enhanced customer trust and confidence",
        "Demonstrated control effectiveness",
        "Streamlined audit process",
        "Reduced audit risk",
        "Competitive advantage in financial services"
      ]
    }
  },
  fi: {
    title: "SOC 1 / ISAE 3402",
    subtitle: "Taloudellisen raportoinnin kontrollien varmentaminen",
    heroDescription: "Kontrollit taloudelliseen raportointiin; todisteet ja auditorituki. Kattava tuki SOC 1 ja ISAE 3402 -varmennuspalveluihin.",
    forWho: "Organisaatioille, jotka tarjoavat palveluita, jotka vaikuttavat asiakkaidensa taloudelliseen raportointiin ja tarvitsevat SOC 1 / ISAE 3402 -varmennusta.",
    achieve: "Onnistunut SOC 1 / ISAE 3402 -varmennus kattavilla kontrollitodisteilla ja auditorituella.",
    overview: {
      title: "Yleiskatsaus",
      description: "SOC 1 (Service Organization Control 1) ja ISAE 3402 ovat kansainvälisiä standardeja palveluorganisaatioiden kontrollien raportointiin, jotka ovat olennaisia käyttäjäorganisaatioiden sisäisen valvonnan kannalta taloudellisessa raportoinnissa. Ne tarjoavat varmuutta asiakkaille ja sidosryhmille kontrollien tehokkuudesta.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea SOC 1 ja ISAE 3402 -varmennukseen aukkoanalyysistä ja kontrollien toteutuksesta auditointivalmiuteen ja jatkuvaan vaatimustenmukaisuuden ylläpitoon."
    },
    services: {
      title: "SOC 1 / ISAE 3402 -palvelut",
      subtitle: "Kattava tuki jokaiseen varmennusmatkan vaiheeseen",
      items: [
        {
          title: "Aukkoanalyysi & valmius",
          description: "Arvioi nykyiset kontrollisi ja valmiutesi SOC 1 / ISAE 3402 -varmennusta varten.",
          icon: "search",
          features: ["Nykytilan arviointi", "Vaatimustenmukaisuuspuutteiden tunnistaminen", "Korjausten tiekartta", "Valmiuspajatyöskentely"]
        },
        {
          title: "Kontrollien kartoitus & dokumentointi",
          description: "Kartta ja dokumentoi taloudelliseen raportointiin liittyvät kontrollit.",
          icon: "clipboard-check",
          features: ["Kontrollikehyksen kartoitus", "Käytäntöjen ja menettelyjen dokumentointi", "Todisteiden keruun ohjaus", "Sidosryhmäkoulutus"]
        },
        {
          title: "Auditointi- & varmennustuki",
          description: "Tuki ulkoisille auditoinneille ja onnistuneelle varmentamiselle.",
          icon: "certificate",
          features: ["Todisteiden hallinta", "Auditointiyhteistyö", "Korjaustoimien tuki", "Sertifiointivalmistelu"]
        }
      ]
    },
    process: {
      title: "Varmennusprosessi",
      subtitle: "Rakenteinen lähestymistapa SOC 1 / ISAE 3402 -varmennuksen saavuttamiseksi",
      items: [
        { number: "01", title: "Arviointi & aukkoanalyysi", description: "Arvioi nykyiset kontrollit SOC 1 / ISAE 3402 -vaatimuksia vastaan." },
        { number: "02", title: "Kontrollien toteutus", description: "Toteuta ja dokumentoi taloudelliseen raportointiin vaadittavat kontrollit." },
        { number: "03", title: "Todisteiden keruu", description: "Kerää ja järjestä todisteet kontrollien tehokkuuden osoittamiseksi." },
        { number: "04", title: "Auditointi & varmennus", description: "Tuki ulkoiselle auditoinnille ja onnistuneen varmennuksen saavuttaminen." }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Kontrollien aukkoanalyysiraportti",
        "Kontrollikehyksen dokumentaatio",
        "Käytännöt ja menettelyt",
        "Todisteiden keruun kehys",
        "Auditointivalmiusarviointi",
        "Auditointiyhteistyön tuki",
        "Korjaustoimien ohjaus",
        "Jatkuvan vaatimustenmukaisuuden ylläpito"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Parantunut asiakasluottamus",
        "Osoitettu kontrollien tehokkuus",
        "Virtaviivaistettu auditointiprosessi",
        "Vähentynyt auditointiriski",
        "Kilpailuetu rahoituspalvelumarkkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section - Centered cards with aligned descriptions -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            
            <!-- Description with fixed min-height for alignment -->
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center min-h-[2.5rem]">
              {service.description}
            </p>
            
            <!-- Darker, more visible separator line -->
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>