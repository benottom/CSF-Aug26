---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "CSA STAR Cloud Security Certification";

const content = {
  en: {
    title: "CSA STAR",
    subtitle: "Cloud Security Certification",
    heroDescription: "Cloud security assurance through CSA STAR certification levels 1-3. Demonstrate comprehensive cloud security excellence and build customer trust with globally recognized cloud security certification.",
    forWho: "For cloud service providers seeking globally recognized cloud security certification.",
    achieve: "CSA STAR certification at the appropriate level with comprehensive security controls and customer trust.",
    overview: {
      title: "Overview",
      description: "CSA STAR (Security, Trust, Assurance, and Risk) is the Cloud Security Alliance's certification program for cloud service providers. It builds on the CSA Cloud Controls Matrix (CCM) and provides progressive levels of certification that demonstrate increasing maturity in cloud security management.",
      highlight: "Our expert team provides comprehensive support for CSA STAR certification at all levels, from self-assessment to continuous monitoring, helping you demonstrate cloud security excellence and build customer trust."
    },
    levels: {
      title: "CSA STAR Certification Levels",
      subtitle: "Progressive certification levels that demonstrate increasing maturity and assurance in cloud security management.",
      items: [
        {
          level: "1",
          title: "CSA STAR Level 1",
          subtitle: "Self-Assessment",
          description: "Open self-assessment based on Cloud Controls Matrix (CCM) and Consensus Assessments Initiative Questionnaire (CAIQ).",
          features: ["Free registration and assessment", "Public registry listing", "CCM-based control documentation", "CAIQ questionnaire completion"]
        },
        {
          level: "2",
          title: "CSA STAR Level 2",
          subtitle: "Third-Party Assessment",
          description: "Independent third-party assessment based on ISO/IEC 27001 or SOC 2 frameworks with CCM integration.",
          features: ["Independent auditor assessment", "ISO 27001 or SOC 2 based", "CCM controls mapping", "Annual recertification"]
        },
        {
          level: "3",
          title: "CSA STAR Level 3",
          subtitle: "Continuous Monitoring",
          description: "Continuous monitoring-based assessment demonstrating real-time security posture and maturity.",
          features: ["Continuous monitoring program", "Real-time security metrics", "Maturity model assessment", "Enhanced public disclosure"]
        }
      ]
    },
    benefits: {
      title: "Why Choose CSA STAR Certification?",
      subtitle: "Demonstrate cloud security excellence and build customer confidence with globally recognized cloud security certification.",
      items: [
        { title: "Industry Recognition", description: "Globally recognized certification that demonstrates cloud security leadership and best practices.", icon: "shield-check" },
        { title: "Customer Confidence", description: "Build customer trust through transparent security assessments and public registry listings.", icon: "users" },
        { title: "Competitive Advantage", description: "Differentiate your cloud services with verified security capabilities and transparent reporting.", icon: "trending-up" },
        { title: "Security Maturity", description: "Progressive certification levels demonstrate continuous improvement in cloud security maturity.", icon: "chart-line" },
        { title: "Compliance Alignment", description: "Align with regulatory requirements and industry standards through comprehensive security frameworks.", icon: "document-check" },
        { title: "Cloud-Native Focus", description: "Purpose-built for cloud environments with controls specifically designed for cloud security challenges.", icon: "cloud" }
      ]
    },
    process: {
      title: "CSA STAR Implementation Process",
      subtitle: "Structured approach to achieving CSA STAR certification across all levels.",
      items: [
        { number: "01", title: "Current State Assessment", description: "Evaluate existing cloud security controls against CCM framework and identify gaps." },
        { number: "02", title: "Level Strategy Planning", description: "Determine appropriate CSA STAR level and develop implementation roadmap." },
        { number: "03", title: "Controls Implementation", description: "Implement required security controls and documentation aligned with CCM requirements." },
        { number: "04", title: "Certification & Maintenance", description: "Complete certification process and establish ongoing maintenance and monitoring programs." }
      ]
    },
    services: {
      title: "Comprehensive CSA STAR Services",
      items: [
        {
          title: "Assessment & Certification Support",
          icon: "clipboard",
          features: ["CCM controls gap analysis", "CAIQ questionnaire completion", "Level 2 third-party assessment coordination", "Level 3 continuous monitoring design", "Registry submission support"]
        },
        {
          title: "Ongoing Maintenance & Improvement",
          icon: "refresh-cw",
          features: ["Annual recertification support", "Security metrics monitoring", "CCM updates implementation", "Maturity progression planning", "Customer communication support"]
        }
      ]
    },
    frameworks: {
      title: "Framework Integration",
      subtitle: "CSA STAR integrates seamlessly with existing security frameworks and standards.",
      items: [
        { title: "ISO 27001", icon: "shield" },
        { title: "SOC 2", icon: "document" },
        { title: "NIST Framework", icon: "target" },
        { title: "GDPR Compliance", icon: "lock-closed" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "CCM controls gap analysis report",
        "CAIQ questionnaire completion",
        "Level strategy and roadmap",
        "Controls implementation plan",
        "Certification package and submission",
        "Continuous monitoring program (Level 3)",
        "Annual recertification support",
        "Public registry listing"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Globally recognized cloud security certification",
        "Enhanced customer trust and confidence",
        "Competitive advantage in cloud markets",
        "Demonstrated security maturity",
        "Regulatory compliance alignment"
      ]
    }
  },
  fi: {
    title: "CSA STAR",
    subtitle: "Pilvipalveluiden turvallisuussertifiointi",
    heroDescription: "Pilvipalveluiden turvallisuusvarmennus CSA STAR -sertifiointitasojen 1-3 kautta. Osoita kattavaa pilvipalveluiden turvallisuuden huippuosaamista ja rakenna asiakasluottamusta maailmanlaajuisesti tunnetulla pilvipalveluiden turvallisuussertifioinnilla.",
    forWho: "Pilvipalveluntarjoajille, jotka tavoittelevat maailmanlaajuisesti tunnustettua pilvipalveluiden turvallisuussertifiointia.",
    achieve: "CSA STAR -sertifiointi sopivalla tasolla kattavilla turvallisuuskontrolleilla ja asiakasluottamuksella.",
    overview: {
      title: "Yleiskatsaus",
      description: "CSA STAR (Security, Trust, Assurance, and Risk) on Cloud Security Alliancen sertifiointiohjelma pilvipalveluntarjoajille. Se perustuu CSA Cloud Controls Matrix (CCM) -menetelmään ja tarjoaa progressiivisia sertifiointitasoja, jotka osoittavat kasvavaa kypsyyttä pilvipalveluiden turvallisuuden hallinnassa.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea CSA STAR -sertifiointiin kaikilla tasoilla oma-arvioinnista jatkuvaan seurantaan auttaen sinua osoittamaan pilvipalveluiden turvallisuuden huippuosaamista ja rakentamaan asiakasluottamusta."
    },
    levels: {
      title: "CSA STAR -sertifiointitasot",
      subtitle: "Progressiiviset sertifiointitasot, jotka osoittavat kasvavaa kypsyyttä ja varmuutta pilvipalveluiden turvallisuuden hallinnassa.",
      items: [
        {
          level: "1",
          title: "CSA STAR -taso 1",
          subtitle: "Oma-arviointi",
          description: "Avoin oma-arviointi, joka perustuu Cloud Controls Matrix (CCM) -menetelmään ja Consensus Assessments Initiative Questionnaire (CAIQ) -kyselyyn.",
          features: ["Ilmainen rekisteröinti ja arviointi", "Julkinen rekisterilistaus", "CCM-pohjainen kontrollidokumentaatio", "CAIQ-kyselylomakkeen täyttö"]
        },
        {
          level: "2",
          title: "CSA STAR -taso 2",
          subtitle: "Kolmannen osapuolen arviointi",
          description: "Riippumaton kolmannen osapuolen arviointi, joka perustuu ISO/IEC 27001 tai SOC 2 -kehyksiin CCM-integraatiolla.",
          features: ["Riippumaton auditoijan arviointi", "ISO 27001 tai SOC 2 -pohjainen", "CCM-kontrollien kartoitus", "Vuotuinen uudelleensertifiointi"]
        },
        {
          level: "3",
          title: "CSA STAR -taso 3",
          subtitle: "Jatkuva seuranta",
          description: "Jatkuvaan seurantaan perustuva arviointi, joka osoittaa reaaliaikaista turvallisuustilaa ja kypsyyttä.",
          features: ["Jatkuva seurantaohjelma", "Reaaliaikaiset turvallisuusmittarit", "Kypsyysmallin arviointi", "Tehostettu julkinen tiedottaminen"]
        }
      ]
    },
    benefits: {
      title: "Miksi valita CSA STAR -sertifiointi?",
      subtitle: "Osoita pilvipalveluiden turvallisuuden huippuosaamista ja rakenna asiakasluottamusta maailmanlaajuisesti tunnetulla pilvipalveluiden turvallisuussertifioinnilla.",
      items: [
        { title: "Toimialan tunnustus", description: "Globaalisti tunnustettu sertifiointi, joka osoittaa pilvipalveluiden turvallisuuden johtajuutta ja parhaita käytäntöjä.", icon: "shield-check" },
        { title: "Asiakasluottamus", description: "Rakenna asiakasluottamusta läpinäkyvien turvallisuusarviointien ja julkisten rekisterilistausten avulla.", icon: "users" },
        { title: "Kilpailuetu", description: "Erota pilvipalvelusi varmennetuilla turvallisuuskyvykkyyksillä ja läpinäkyvällä raportoinnilla.", icon: "trending-up" },
        { title: "Turvallisuuden kypsyys", description: "Progressiiviset sertifiointitasot osoittavat jatkuvaa parannusta pilvipalveluiden turvallisuuden kypsyydessä.", icon: "chart-line" },
        { title: "Vaatimustenmukaisuuden yhdenmukaistaminen", description: "Yhdenmukaista sääntelyvaatimusten ja toimialastandardien kanssa kattavien turvallisuuskehysten avulla.", icon: "document-check" },
        { title: "Pilvipalvelulähtöinen fokus", description: "Erityisesti pilviympäristöjä varten suunniteltu kontrolleilla, jotka on suunniteltu erityisesti pilvipalveluiden turvallisuushaasteisiin.", icon: "cloud" }
      ]
    },
    process: {
      title: "CSA STAR -toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa CSA STAR -sertifioinnin saavuttamiseksi kaikilla tasoilla.",
      items: [
        { number: "01", title: "Nykytilan arviointi", description: "Arvioi olemassa olevat pilvipalveluiden turvallisuuskontrollit CCM-kehystä vastaan ja tunnista puutteet." },
        { number: "02", title: "Tasostrategian suunnittelu", description: "Määritä sopiva CSA STAR -taso ja kehitä toteutuksen tiekartta." },
        { number: "03", title: "Kontrollien toteutus", description: "Toteuta vaaditut turvallisuuskontrollit ja dokumentaatio CCM-vaatimusten mukaisesti." },
        { number: "04", title: "Sertifiointi ja ylläpito", description: "Suorita sertifiointiprosessi ja perusta jatkuvat ylläpito- ja seurantaohjelmat." }
      ]
    },
    services: {
      title: "Kattavat CSA STAR -palvelut",
      items: [
        {
          title: "Arviointi- ja sertifiointituki",
          icon: "clipboard",
          features: ["CCM-kontrollien aukkoanalyysi", "CAIQ-kyselylomakkeen täyttö", "Tason 2 kolmannen osapuolen arvioinnin koordinointi", "Tason 3 jatkuvan seurannan suunnittelu", "Rekisteriin ilmoittamisen tuki"]
        },
        {
          title: "Jatkuva ylläpito ja parantaminen",
          icon: "refresh-cw",
          features: ["Vuotuinen uudelleensertifioinnin tuki", "Turvallisuusmittareiden seuranta", "CCM-päivitysten toteutus", "Kypsyyden kehityssuunnittelu", "Asiakasviestinnän tuki"]
        }
      ]
    },
    frameworks: {
      title: "Kehysintegraatio",
      subtitle: "CSA STAR integroituu saumattomasti olemassa oleviin turvallisuuskehyksiin ja -standardeihin.",
      items: [
        { title: "ISO 27001", icon: "shield" },
        { title: "SOC 2", icon: "document" },
        { title: "NIST Framework", icon: "target" },
        { title: "GDPR-vaatimustenmukaisuus", icon: "lock-closed" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "CCM-kontrollien aukkoanalyysiraportti",
        "CAIQ-kyselylomakkeen täyttö",
        "Tasostrategia ja tiekartta",
        "Kontrollien toteutussuunnitelma",
        "Sertifiointipaketti ja ilmoittaminen",
        "Jatkuva seurantaohjelma (taso 3)",
        "Vuotuinen uudelleensertifioinnin tuki",
        "Julkinen rekisterilistaus"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Globaalisti tunnustettu pilvipalveluiden turvallisuussertifiointi",
        "Parantunut asiakasluottamus",
        "Kilpailuetu pilvipalvelumarkkinoilla",
        "Osoitettu turvallisuuden kypsyys",
        "Sääntelyvaatimusten yhdenmukaistaminen"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- CSA STAR Levels Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.levels.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.levels.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.levels.items.map((level) => (
          <div class={`bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden ${getLevelColor(level.color)}`}>
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <span className={`text-lg font-bold ${getIconColor(level.color)} group-hover:text-white transition-colors duration-300`}>
                  {level.level}
                </span>
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-0.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {level.title}
            </h3>
            <p className={`text-xs font-semibold ${getIconColor(level.color)} mb-2 text-left relative z-10`}>{level.subtitle}</p>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">{level.description}</p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {level.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={benefit.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {benefit.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.services.title}
        </h2>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-2 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {service.title}
            </h3>
            
            <ul class="space-y-1 relative z-10">
              {service.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Framework Integration Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.frameworks.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.frameworks.subtitle}
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
        {currentContent.frameworks.items.map((framework) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={framework.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {framework.title}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>