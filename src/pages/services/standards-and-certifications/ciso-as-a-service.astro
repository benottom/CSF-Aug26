---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "CISO-as-a-Service";

const content = {
  en: {
    title: "CISO-as-a-Service",
    subtitle: "Virtual Chief Information Security Officer",
    heroDescription: "Our CISO-as-a-Service provides organizations with a virtual Chief Information Security Officer to lead strategy, develop roadmaps, define metrics, and report to stakeholders. We help you build and maintain a robust security program.",
    forWho: "For organizations seeking expert security leadership without full-time CISO recruitment costs.",
    achieve: "Expert security leadership with strategic direction, measurable metrics, and stakeholder confidence.",
    overview: {
      title: "Overview",
      description: "CISO-as-a-Service provides organizations with a virtual Chief Information Security Officer to lead security strategy, develop roadmaps, define metrics, and report to stakeholders. We help you build and maintain a robust security program.",
      highlight: "Our virtual CISO service delivers expert security leadership on demand, helping you navigate complex security challenges and build stakeholder confidence."
    },
    services: {
      title: "Our Services",
      subtitle: "Comprehensive security leadership support across all key areas",
      items: [
        { title: "Security Strategy", description: "Develop comprehensive security strategies aligned with business objectives", icon: "target" },
        { title: "Roadmap Development", description: "Create detailed security roadmaps with clear milestones and timelines", icon: "map" },
        { title: "Metrics & Reporting", description: "Define meaningful security metrics and executive-level reporting", icon: "chart-line" },
        { title: "Stakeholder Engagement", description: "Effective communication with boards, executives, and stakeholders", icon: "users" },
        { title: "Security Program Management", description: "Oversee and coordinate security initiatives across the organization", icon: "shield" },
        { title: "Governance & Compliance", description: "Establish security governance structures and compliance frameworks", icon: "building-library" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Comprehensive security strategy and roadmap",
        "Security metrics framework and reporting",
        "Board and executive presentations",
        "Risk management framework",
        "Security program governance structure",
        "Incident response planning",
        "Compliance alignment and management",
        "Ongoing security leadership support"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Expert security leadership without full-time recruitment",
        "Strategic direction and measurable outcomes",
        "Enhanced stakeholder confidence and trust",
        "Cost-effective security leadership solution",
        "Flexible engagement models"
      ]
    }
  },
  fi: {
    title: "CISO-palveluna",
    subtitle: "Virtuaalinen tietoturvapäällikkö",
    heroDescription: "CISO-palveluna tarjoaa organisaatioille virtuaalisen tietoturvapäällikön johtamaan strategiaa, kehittämään tiekarttoja, määrittelemään mittareita ja raportoimaan sidosryhmille. Autamme sinua rakentamaan ja ylläpitämään vankkaa tietoturvaohjelmaa.",
    forWho: "Organisaatioille, jotka tarvitsevat asiantuntevaa tietoturvajohtamista ilman kokoaikaisen tietoturvapäällikön rekrytointikustannuksia.",
    achieve: "Asiantunteva tietoturvajohtaminen strategisella suunnalla, mitattavilla mittareilla ja sidosryhmien luottamuksella.",
    overview: {
      title: "Yleiskatsaus",
      description: "CISO-palveluna tarjoaa organisaatioille virtuaalisen tietoturvapäällikön johtamaan tietoturvastrategiaa, kehittämään tiekarttoja, määrittelemään mittareita ja raportoimaan sidosryhmille. Autamme sinua rakentamaan ja ylläpitämään vankkaa tietoturvaohjelmaa.",
      highlight: "Virtuaalinen tietoturvapäällikköpalvelumme tarjoaa asiantuntevaa tietoturvajohtamista tarvittaessa, auttaen sinua navigoimaan monimutkaisissa tietoturvahaasteissa ja rakentamaan sidosryhmien luottamusta."
    },
    services: {
      title: "Palvelumme",
      subtitle: "Kattava tietoturvajohtamisen tuki kaikilla keskeisillä osa-alueilla",
      items: [
        { title: "Tietoturvastrategia", description: "Kehitä kattavia tietoturvastrategioita liiketoiminnan tavoitteiden mukaisesti", icon: "target" },
        { title: "Tiekartan kehittäminen", description: "Luo yksityiskohtaiset tietoturvan tiekartat selkeine virstanpylväineen ja aikatauluineen", icon: "map" },
        { title: "Mittarit ja raportointi", description: "Määrittele merkitykselliset tietoturvamittarit ja johdon raportointi", icon: "chart-line" },
        { title: "Sidosryhmien osallistaminen", description: "Tehokas viestintä hallituksen, johdon ja sidosryhmien kanssa", icon: "users" },
        { title: "Tietoturvaohjelman hallinta", description: "Valvo ja koordinoi tietoturvatoimia koko organisaatiossa", icon: "shield" },
        { title: "Hallinto ja vaatimustenmukaisuus", description: "Perusta tietoturvan hallintorakenteet ja vaatimustenmukaisuuden kehykset", icon: "building-library" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Kattava tietoturvastrategia ja tiekartta",
        "Tietoturvamittareiden kehys ja raportointi",
        "Hallituksen ja johdon esitykset",
        "Riskienhallintakehys",
        "Tietoturvaohjelman hallintarakenne",
        "Tapahtumien hallintasuunnittelu",
        "Vaatimustenmukaisuuden yhdenmukaistaminen ja hallinta",
        "Jatkuva tietoturvajohtamisen tuki"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Asiantunteva tietoturvajohtaminen ilman kokoaikaista rekrytointia",
        "Strateginen suunta ja mitattavat tulokset",
        "Parantunut sidosryhmien luottamus",
        "Kustannustehokas tietoturvajohtamisen ratkaisu",
        "Joustavat toimeksiantomallit"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {service.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefits.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefits.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>