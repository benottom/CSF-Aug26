---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "SOC 2 Readiness";

const content = {
  en: {
    title: "SOC 2 Readiness",
    subtitle: "Trust Services Criteria Compliance",
    heroDescription: "Map controls to Trust Services Criteria, collect evidence, and prepare for Type I/II audits. Comprehensive preparation for successful SOC 2 Type I and Type II audits.",
    forWho: "For organizations seeking SOC 2 attestation and needing comprehensive readiness preparation for Type I or Type II audits.",
    achieve: "Successful SOC 2 Type I or Type II attestation with comprehensive controls mapping and audit readiness.",
    overview: {
      title: "Overview",
      description: "SOC 2 is an attestation standard developed by the American Institute of CPAs (AICPA) for service organizations. It evaluates controls related to the Trust Services Criteria: Security, Availability, Processing Integrity, Confidentiality, and Privacy.",
      highlight: "Our expert team provides comprehensive SOC 2 readiness services, from controls mapping and evidence collection through Type I and Type II audit preparation, ensuring successful attestation."
    },
    services: {
      title: "SOC 2 Readiness Services",
      subtitle: "Comprehensive preparation for successful SOC 2 Type I and Type II audits",
      items: [
        {
          title: "Controls Mapping",
          description: "Map your existing controls to SOC 2 Trust Services Criteria",
          icon: "map",
          features: ["Security controls assessment", "Availability controls review", "Processing integrity evaluation", "Confidentiality controls mapping"]
        },
        {
          title: "Evidence Collection",
          description: "Systematic evidence gathering and documentation for audit readiness",
          icon: "folder",
          features: ["Evidence identification and collection", "Documentation standardization", "Control testing procedures", "Evidence repository setup"]
        },
        {
          title: "Type I Preparation",
          description: "Prepare for SOC 2 Type I audit focusing on control design",
          icon: "clipboard",
          features: ["Control design assessment", "Policy and procedure review", "Gap analysis and remediation", "Pre-audit readiness check"]
        },
        {
          title: "Type II Preparation",
          description: "Full operational effectiveness testing for Type II audit",
          icon: "shield-check",
          features: ["Operating effectiveness testing", "Continuous monitoring setup", "Exception management", "Auditor engagement support"]
        }
      ]
    },
    process: {
      title: "Readiness Process",
      subtitle: "Structured approach to achieve SOC 2 Type I or Type II attestation",
      items: [
        { number: "01", title: "Assessment & Gap Analysis", description: "Evaluate current controls against SOC 2 Trust Services Criteria and identify gaps." },
        { number: "02", title: "Controls Mapping & Implementation", description: "Map and implement controls to meet SOC 2 requirements." },
        { number: "03", title: "Evidence Collection & Documentation", description: "Gather and organize evidence to support control effectiveness." },
        { number: "04", title: "Audit Preparation & Attestation", description: "Prepare for Type I or Type II audit and achieve successful attestation." }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Controls gap analysis report",
        "Trust Services Criteria mapping",
        "Policy and procedure documentation",
        "Evidence collection framework",
        "Type I or Type II readiness assessment",
        "Audit preparation support",
        "Remediation guidance",
        "Ongoing compliance maintenance"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Enhanced customer trust and confidence",
        "Demonstrated control effectiveness",
        "Streamlined audit process",
        "Reduced audit risk",
        "Competitive advantage in the market"
      ]
    }
  },
  fi: {
    title: "SOC 2 -valmius",
    subtitle: "Trust Services -kriteerien vaatimustenmukaisuus",
    heroDescription: "Kartta kontrollit Trust Services -kriteereihin, kerää todisteita ja valmistaudu tyyppi I/II auditointeihin. Kattava valmistautuminen onnistuneisiin SOC 2 Type I ja Type II auditointeihin.",
    forWho: "Organisaatioille, jotka tavoittelevat SOC 2 -varmennusta ja tarvitsevat kattavaa valmistautumista tyypin I tai tyypin II auditointeihin.",
    achieve: "Onnistunut SOC 2 Type I tai Type II -varmennus kattavalla kontrollien kartoituksella ja auditointivalmiudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "SOC 2 on American Institute of CPAs (AICPA) -järjestön kehittämä varmennusstandardi palveluorganisaatioille. Se arvioi kontrolleja, jotka liittyvät Trust Services -kriteereihin: Turvallisuus, Saatavuus, Käsittelyn eheys, Luottamuksellisuus ja Yksityisyys.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia SOC 2 -valmiuspalveluita kontrollien kartoituksesta ja todisteiden keruusta tyypin I ja tyypin II auditointivalmisteluun, varmistaen onnistuneen varmennuksen."
    },
    services: {
      title: "SOC 2 -valmiuspalvelut",
      subtitle: "Kattava valmistautuminen onnistuneisiin SOC 2 Type I ja Type II auditointeihin",
      items: [
        {
          title: "Kontrollien kartoitus",
          description: "Kartta olemassa olevat kontrollisi SOC 2 Trust Services -kriteereihin",
          icon: "map",
          features: ["Turvallisuuskontrollien arviointi", "Saatavuuskontrollien tarkistus", "Käsittelyn eheyden arviointi", "Luottamuksellisuuskontrollien kartoitus"]
        },
        {
          title: "Todisteiden keruu",
          description: "Systemaattinen todisteiden keruu ja dokumentointi auditointivalmiutta varten",
          icon: "folder",
          features: ["Todisteiden tunnistaminen ja keruu", "Dokumentoinnin standardointi", "Kontrollien testausmenettelyt", "Todisteiden arkiston perustaminen"]
        },
        {
          title: "Tyypin I valmistelu",
          description: "Valmistaudu SOC 2 Type I -auditointiin, joka keskittyy kontrollien suunnitteluun",
          icon: "clipboard",
          features: ["Kontrollien suunnittelun arviointi", "Käytäntöjen ja menettelyjen tarkistus", "Aukkoanalyysi ja korjaukset", "Esisertifioinnin valmiusarviointi"]
        },
        {
          title: "Tyypin II valmistelu",
          description: "Täydellinen operatiivisen tehokkuuden testaus tyypin II auditointia varten",
          icon: "shield-check",
          features: ["Operatiivisen tehokkuuden testaus", "Jatkuvan seurannan asennus", "Poikkeamien hallinta", "Auditorin sitoutumisen tuki"]
        }
      ]
    },
    process: {
      title: "Valmiusprosessi",
      subtitle: "Rakenteinen lähestymistapa SOC 2 Type I tai Type II -varmennuksen saavuttamiseksi",
      items: [
        { number: "01", title: "Arviointi & aukkoanalyysi", description: "Arvioi nykyiset kontrollit SOC 2 Trust Services -kriteereitä vastaan ja tunnista puutteet." },
        { number: "02", title: "Kontrollien kartoitus & toteutus", description: "Kartta ja toteuta kontrollit SOC 2 -vaatimusten täyttämiseksi." },
        { number: "03", title: "Todisteiden keruu & dokumentointi", description: "Kerää ja järjestä todisteet kontrollien tehokkuuden osoittamiseksi." },
        { number: "04", title: "Auditointivalmistelu & varmennus", description: "Valmistaudu tyypin I tai tyypin II auditointiin ja saavuta onnistunut varmennus." }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Kontrollien aukkoanalyysiraportti",
        "Trust Services -kriteerien kartoitus",
        "Käytäntöjen ja menettelyjen dokumentaatio",
        "Todisteiden keruun kehys",
        "Tyypin I tai tyypin II valmiusarviointi",
        "Auditointivalmistelun tuki",
        "Korjaustoimien ohjaus",
        "Jatkuvan vaatimustenmukaisuuden ylläpito"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Parantunut asiakasluottamus",
        "Osoitettu kontrollien tehokkuus",
        "Virtaviivaistettu auditointiprosessi",
        "Vähentynyt auditointiriski",
        "Kilpailuetu markkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section - Centered cards -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {service.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>