---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO 27701 (PIMS)";

const content = {
  en: {
    title: "ISO 27701 (PIMS)",
    subtitle: "Privacy Information Management System",
    heroDescription: "Extend your ISMS to privacy; GDPR-aligned certification readiness with comprehensive Privacy Information Management System implementation. Build on your existing ISO 27001 ISMS to create a comprehensive privacy management framework that ensures GDPR compliance and demonstrates privacy leadership.",
    forWho: "For organizations with existing ISO 27001 ISMS seeking to extend to privacy management and achieve GDPR compliance.",
    achieve: "GDPR-aligned privacy management with ISO 27701 certification and demonstrated privacy leadership.",
    overview: {
      title: "Overview",
      description: "ISO 27701 is a privacy extension to ISO 27001 that provides a framework for implementing, maintaining, and continually improving a Privacy Information Management System (PIMS). It builds on your existing ISMS to create comprehensive privacy management that ensures GDPR compliance and demonstrates privacy leadership.",
      highlight: "Our expert team provides comprehensive ISO 27701 implementation support, extending your existing ISMS with privacy management capabilities and achieving GDPR-aligned certification readiness."
    },
    benefits: {
      title: "Why Choose ISO 27701 (PIMS)?",
      subtitle: "Build on your existing ISO 27001 ISMS to create a comprehensive privacy management framework that ensures GDPR compliance and demonstrates privacy leadership.",
      items: [
        { title: "GDPR Alignment", description: "Seamlessly integrate privacy requirements with your information security management system.", icon: "shield-check" },
        { title: "Extend Existing ISMS", description: "Build upon your ISO 27001 foundation without duplicating effort or resources.", icon: "refresh-cw" },
        { title: "Competitive Advantage", description: "Demonstrate privacy leadership and gain competitive advantage in privacy-conscious markets.", icon: "trending-up" }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Structured approach to extend your existing ISMS with privacy management capabilities.",
      items: [
        { number: "01", title: "Privacy Gap Analysis", description: "Assess current privacy controls against ISO 27701 requirements and GDPR obligations." },
        { number: "02", title: "PIMS Design", description: "Design Privacy Information Management System extending your existing ISMS framework." },
        { number: "03", title: "Implementation", description: "Implement privacy controls, processes, and documentation aligned with ISO 27701." },
        { number: "04", title: "Certification Readiness", description: "Prepare for certification audit with comprehensive readiness assessment and support." }
      ]
    },
    services: {
      title: "Comprehensive ISO 27701 Services",
      subtitle: "Expert implementation support for Privacy Information Management System",
      items: [
        {
          title: "Privacy Management System Development",
          icon: "shield",
          features: ["Privacy policy framework development", "Data processing inventory and mapping", "Privacy impact assessment procedures", "Data subject rights management"]
        },
        {
          title: "GDPR Integration & Compliance",
          icon: "document-check",
          features: ["GDPR compliance gap analysis", "Privacy by design implementation", "Breach notification procedures", "Third-party processor agreements"]
        }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Privacy gap analysis report",
        "PIMS framework and documentation",
        "Privacy policies and procedures",
        "Data processing inventory and mapping",
        "Privacy impact assessment framework",
        "Data subject rights procedures",
        "GDPR compliance alignment",
        "Certification readiness assessment"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "GDPR-aligned privacy management",
        "Extended ISMS capabilities",
        "Demonstrated privacy leadership",
        "Competitive advantage in privacy-conscious markets",
        "Regulatory compliance assurance"
      ]
    }
  },
  fi: {
    title: "ISO 27701 (PIMS)",
    subtitle: "Tietosuojaa koskeva hallintajärjestelmä",
    heroDescription: "Laajenna ISMS:si kattamaan tietosuoja; GDPR-yhteensopiva sertifiointivalmius kattavalla tietosuojan hallintajärjestelmän toteutuksella. Rakenna olemassa olevan ISO 27001 ISMS:si päälle luodaksesi kattavan tietosuojakehyksen, joka varmistaa GDPR-vaatimustenmukaisuuden ja osoittaa tietosuojan johtajuutta.",
    forWho: "Organisaatioille, joilla on olemassa oleva ISO 27001 ISMS ja jotka haluavat laajentaa tietosuojan hallintaan ja saavuttaa GDPR-vaatimustenmukaisuuden.",
    achieve: "GDPR-yhteensopiva tietosuojan hallinta ISO 27701 -sertifioinnilla ja osoitetulla tietosuojan johtajuudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27701 on ISO 27001 -standardin tietosuojalaajennus, joka tarjoaa kehyksen tietosuojaa koskevan hallintajärjestelmän (PIMS) käyttöönottoon, ylläpitoon ja jatkuvaan parantamiseen. Se rakentuu olemassa olevan ISMS:si päälle luodakseen kattavan tietosuojahallinnan, joka varmistaa GDPR-vaatimustenmukaisuuden ja osoittaa tietosuojan johtajuutta.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa ISO 27701 -toteutustukea, laajentaen olemassa olevaa ISMS:ääsi tietosuojakyvykkyyksillä ja saavuttaen GDPR-yhteensopivan sertifiointivalmiuden."
    },
    benefits: {
      title: "Miksi valita ISO 27701 (PIMS)?",
      subtitle: "Rakenna olemassa olevan ISO 27001 ISMS:si päälle luodaksesi kattavan tietosuojakehyksen, joka varmistaa GDPR-vaatimustenmukaisuuden ja osoittaa tietosuojan johtajuutta.",
      items: [
        { title: "GDPR-yhdenmukaistaminen", description: "Yhdenmukaista tietosuojavaatimukset saumattomasti tietoturvallisuuden hallintajärjestelmäsi kanssa.", icon: "shield-check" },
        { title: "Laajenna olemassa olevaa ISMS:ää", description: "Rakenna ISO 27001 -pohjasi päälle ilman työn tai resurssien päällekkäisyyttä.", icon: "refresh-cw" },
        { title: "Kilpailuetu", description: "Osoita tietosuojan johtajuutta ja saavuta kilpailuetua tietosuojatietoisilla markkinoilla.", icon: "trending-up" }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa olemassa olevan ISMS:si laajentamiseksi tietosuojakyvykkyyksillä.",
      items: [
        { number: "01", title: "Tietosuojan aukkoanalyysi", description: "Arvioi nykyiset tietosuojakontrollit ISO 27701 -vaatimuksia ja GDPR-velvoitteita vastaan." },
        { number: "02", title: "PIMS:n suunnittelu", description: "Suunnittele tietosuojaa koskeva hallintajärjestelmä, joka laajentaa olemassa olevaa ISMS-kehystäsi." },
        { number: "03", title: "Toteutus", description: "Toteuta tietosuojakontrollit, -prosessit ja -dokumentaatio ISO 27701 -standardin mukaisesti." },
        { number: "04", title: "Sertifiointivalmius", description: "Valmistaudu sertifiointiauditointiin kattavalla valmiusarvioinnilla ja tuella." }
      ]
    },
    services: {
      title: "Kattavat ISO 27701 -palvelut",
      subtitle: "Asiantuntevaa toteutustukea tietosuojaa koskevalle hallintajärjestelmälle",
      items: [
        {
          title: "Tietosuojan hallintajärjestelmän kehitys",
          icon: "shield",
          features: ["Tietosuojapolitiikkakehyksen kehitys", "Tietojenkäsittelyinventaario ja kartoitus", "Tietosuojan vaikutusten arviointimenettelyt", "Rekisteröityjen oikeuksien hallinta"]
        },
        {
          title: "GDPR-integraatio ja vaatimustenmukaisuus",
          icon: "document-check",
          features: ["GDPR-vaatimustenmukaisuuden aukkoanalyysi", "Tietosuoja-by-design -toteutus", "Tietoturvaloukkauksen ilmoitusmenettelyt", "Kolmannen osapuolen käsittelijäsopimukset"]
        }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Tietosuojan aukkoanalyysiraportti",
        "PIMS-kehys ja dokumentaatio",
        "Tietosuojakäytännöt ja -menettelyt",
        "Tietojenkäsittelyinventaario ja kartoitus",
        "Tietosuojan vaikutusten arviointikehys",
        "Rekisteröityjen oikeuksien menettelyt",
        "GDPR-vaatimustenmukaisuuden yhdenmukaistaminen",
        "Sertifiointivalmiusarviointi"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "GDPR-yhteensopiva tietosuojan hallinta",
        "Laajennetut ISMS-kyvykkyydet",
        "Osoitettu tietosuojan johtajuus",
        "Kilpailuetu tietosuojatietoisilla markkinoilla",
        "Sääntelyvaatimusten noudattamisen varmistus"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={benefit.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {benefit.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {benefit.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section - Centered, better cards -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E293B] mb-3 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            
            <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
              {service.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#0EA5E9] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>