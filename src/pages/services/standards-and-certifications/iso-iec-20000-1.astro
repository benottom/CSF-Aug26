---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO/IEC 20000-1";

const content = {
  en: {
    title: "ISO/IEC 20000-1",
    subtitle: "IT Service Management for MSSPs",
    heroDescription: "IT service management alignment for MSSP processes and SLAs. Comprehensive service management solutions for managed security service providers.",
    forWho: "For managed security service providers seeking IT service management alignment and certification.",
    achieve: "IT service management excellence with ISO/IEC 20000-1 certification and optimized MSSP operations.",
    overview: {
      title: "Overview",
      description: "ISO/IEC 20000-1 is the international standard for IT Service Management (ITSM). It provides a framework for implementing, maintaining, and continually improving a service management system (SMS) that ensures consistent, high-quality IT service delivery.",
      highlight: "Our expert team provides comprehensive ISO/IEC 20000-1 implementation support, aligning your MSSP processes with international service management standards and achieving certification readiness."
    },
    services: {
      title: "MSSP Service Management Solutions",
      subtitle: "Comprehensive IT service management alignment for managed security service providers",
      items: [
        {
          title: "MSSP Process Alignment",
          description: "Align your managed security service provider processes with ISO/IEC 20000-1 standards",
          icon: "cog",
          features: ["Security operations center (SOC) process optimization", "Incident response workflow standardization", "Threat monitoring service alignment", "Security event management processes"]
        },
        {
          title: "SLA Framework Development",
          description: "Develop comprehensive service level agreements that meet ISO/IEC 20000-1 requirements",
          icon: "document",
          features: ["Security service level objectives (SLOs)", "Response time guarantees", "Availability and uptime commitments", "Performance measurement frameworks"]
        },
        {
          title: "Service Management Implementation",
          description: "Complete IT service management system implementation for security services",
          icon: "shield",
          features: ["Service catalog development", "Change management processes", "Configuration management database (CMDB)", "Problem and incident management"]
        },
        {
          title: "Continuous Improvement",
          description: "Establish continuous service improvement processes for managed security services",
          icon: "refresh-cw",
          features: ["Service performance monitoring", "Customer satisfaction measurement", "Process optimization initiatives", "Regular service reviews and updates"]
        }
      ]
    },
    processes: {
      title: "Key Service Management Processes",
      subtitle: "Comprehensive coverage of all required service management processes",
      items: [
        "Service Level Management",
        "Availability Management",
        "Capacity Management",
        "Information Security Management",
        "Incident Management",
        "Problem Management",
        "Change Management",
        "Release Management",
        "Configuration Management",
        "Supplier Management",
        "Service Continuity Management",
        "Service Reporting"
      ]
    },
    benefits: {
      title: "Benefits for MSSPs",
      subtitle: "Why ISO/IEC 20000-1 certification is essential for managed security service providers",
      items: [
        { title: "Enhanced Service Quality", description: "Standardized processes ensure consistent, high-quality security service delivery", icon: "shield-check" },
        { title: "Improved SLA Compliance", description: "Meet and exceed service level agreements with structured management processes", icon: "document-check" },
        { title: "Better Risk Management", description: "Integrated risk management across all IT and security service operations", icon: "chart-line" },
        { title: "Customer Confidence", description: "Demonstrate commitment to service excellence through international certification", icon: "users" }
      ]
    },
    approach: {
      title: "Implementation Approach",
      subtitle: "Structured approach to achieve ISO/IEC 20000-1 certification for your MSSP",
      items: [
        { number: "01", title: "Assessment & Gap Analysis", description: "Evaluate current MSSP processes against ISO/IEC 20000-1 requirements" },
        { number: "02", title: "Process Design & Documentation", description: "Design and document service management processes tailored for security services" },
        { number: "03", title: "SLA Development & Integration", description: "Create comprehensive SLAs that align with service management objectives" },
        { number: "04", title: "Implementation & Training", description: "Deploy processes, train staff, and establish monitoring mechanisms" },
        { number: "05", title: "Certification & Continuous Improvement", description: "Support certification process and establish ongoing improvement cycles" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Service management framework and documentation",
        "SLA framework and agreements",
        "Service catalog and portfolio",
        "Process documentation and procedures",
        "Training materials and programs",
        "Certification readiness assessment",
        "Continuous improvement framework",
        "Ongoing support and maintenance"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Internationally recognized IT service management certification",
        "Enhanced service quality and consistency",
        "Improved SLA compliance and customer satisfaction",
        "Optimized MSSP operations and efficiency",
        "Competitive advantage in security services market"
      ]
    }
  },
  fi: {
    title: "ISO/IEC 20000-1",
    subtitle: "IT-palveluhallinta MSSP:ille",
    heroDescription: "IT-palveluhallinnan yhdenmukaistaminen MSSP-prosesseille ja SLA:ille. Kattavat palveluhallintaratkaisut hallituille tietoturvapalveluntarjoajille.",
    forWho: "Hallituille tietoturvapalveluntarjoajille, jotka tavoittelevat IT-palveluhallinnan yhdenmukaistamista ja sertifiointia.",
    achieve: "IT-palveluhallinnan huippuosaaminen ISO/IEC 20000-1 -sertifioinnilla ja optimoiduilla MSSP-operaatioilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO/IEC 20000-1 on kansainvälinen standardi IT-palveluhallinnalle (ITSM). Se tarjoaa kehyksen palveluhallintajärjestelmän (SMS) käyttöönottoon, ylläpitoon ja jatkuvaan parantamiseen, mikä varmistaa johdonmukaisen ja korkealaatuisen IT-palvelutoimituksen.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa ISO/IEC 20000-1 -toteutustukea, yhdenmukaistaen MSSP-prosessisi kansainvälisten palveluhallintastandardien kanssa ja saavuttaen sertifiointivalmiuden."
    },
    services: {
      title: "MSSP-palveluhallintaratkaisut",
      subtitle: "Kattava IT-palveluhallinnan yhdenmukaistaminen hallituille tietoturvapalveluntarjoajille",
      items: [
        {
          title: "MSSP-prosessien yhdenmukaistaminen",
          description: "Yhdenmukaista hallitut tietoturvapalveluntarjoajaprosessisi ISO/IEC 20000-1 -standardien kanssa",
          icon: "cog",
          features: ["Tietoturvaoperaatioiden (SOC) prosessien optimointi", "Tapahtumien hallinnan työnkulkujen standardointi", "Uhkien valvontapalvelun yhdenmukaistaminen", "Tietoturvatapahtumien hallintaprosessit"]
        },
        {
          title: "SLA-kehyksen kehitys",
          description: "Kehitä kattavat palvelutasosopimukset, jotka täyttävät ISO/IEC 20000-1 -vaatimukset",
          icon: "document",
          features: ["Turvallisuuspalvelun tavoitetasot (SLO)", "Vasteaikatakuut", "Saatavuus- ja käyttöaikasitoumukset", "Suorituskyvyn mittauskehykset"]
        },
        {
          title: "Palveluhallinnan toteutus",
          description: "Täydellinen IT-palveluhallintajärjestelmän toteutus tietoturvapalveluille",
          icon: "shield",
          features: ["Palveluluettelon kehitys", "Muutosten hallintaprosessit", "Konfiguraatiohallintatietokanta (CMDB)", "Ongelma- ja tapahtumahallinta"]
        },
        {
          title: "Jatkuva parantaminen",
          description: "Perusta jatkuvat palvelunparannusprosessit hallituille tietoturvapalveluille",
          icon: "refresh-cw",
          features: ["Palvelun suorituskyvyn seuranta", "Asiakastyytyväisyyden mittaus", "Prosessien optimointihankkeet", "Säännölliset palvelukatselmukset ja päivitykset"]
        }
      ]
    },
    processes: {
      title: "Keskeiset palveluhallintaprosessit",
      subtitle: "Kattava kattavuus kaikista vaadituista palveluhallintaprosesseista",
      items: [
        "Palvelutason hallinta",
        "Saatavuuden hallinta",
        "Kapasiteetin hallinta",
        "Tietoturvallisuuden hallinta",
        "Tapahtumien hallinta",
        "Ongelmaiden hallinta",
        "Muutosten hallinta",
        "Käyttöönottoprosessit",
        "Konfiguraatioiden hallinta",
        "Toimittajahallinta",
        "Palvelujen jatkuvuuden hallinta",
        "Palveluraportointi"
      ]
    },
    benefits: {
      title: "Edut MSSP:ille",
      subtitle: "Miksi ISO/IEC 20000-1 -sertifiointi on välttämätöntä hallituille tietoturvapalveluntarjoajille",
      items: [
        { title: "Parannettu palvelun laatu", description: "Standardoidut prosessit varmistavat johdonmukaisen, korkealaatuisen tietoturvapalvelun toimituksen", icon: "shield-check" },
        { title: "Parannettu SLA-vaatimustenmukaisuus", description: "Täytä ja ylitä palvelutasosopimukset rakenteellisilla hallintaprosesseilla", icon: "document-check" },
        { title: "Parempi riskienhallinta", description: "Integroitu riskienhallinta kaikissa IT- ja tietoturvapalveluoperaatioissa", icon: "chart-line" },
        { title: "Asiakasluottamus", description: "Osoita sitoutuminen palvelun huippuosaamiseen kansainvälisen sertifioinnin avulla", icon: "users" }
      ]
    },
    approach: {
      title: "Toteutuslähestymistapa",
      subtitle: "Rakenteinen lähestymistapa ISO/IEC 20000-1 -sertifioinnin saavuttamiseksi MSSP:llesi",
      items: [
        { number: "01", title: "Arviointi & aukkoanalyysi", description: "Arvioi nykyiset MSSP-prosessit ISO/IEC 20000-1 -vaatimuksia vastaan" },
        { number: "02", title: "Prosessien suunnittelu & dokumentointi", description: "Suunnittele ja dokumentoi tietoturvapalveluille räätälöidyt palveluhallintaprosessit" },
        { number: "03", title: "SLA-kehitys & integrointi", description: "Luo kattavat SLA:t, jotka vastaavat palveluhallinnan tavoitteita" },
        { number: "04", title: "Toteutus & koulutus", description: "Ota prosessit käyttöön, kouluta henkilöstö ja perusta seurantamekanismit" },
        { number: "05", title: "Sertifiointi & jatkuva parantaminen", description: "Tukee sertifiointiprosessia ja perusta jatkuvat parannussykli" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Palveluhallintakehys ja dokumentaatio",
        "SLA-kehys ja -sopimukset",
        "Palveluluettelo ja -portfolio",
        "Prosessidokumentaatio ja -menettelyt",
        "Koulutusmateriaalit ja -ohjelmat",
        "Sertifiointivalmiusarviointi",
        "Jatkuvan parantamisen kehys",
        "Jatkuva tuki ja ylläpito"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Kansainvälisesti tunnustettu IT-palveluhallinnan sertifiointi",
        "Parannettu palvelun laatu ja johdonmukaisuus",
        "Parannettu SLA-vaatimustenmukaisuus ja asiakastyytyväisyys",
        "Optimoidut MSSP-operaatiot ja tehokkuus",
        "Kilpailuetu tietoturvapalvelumarkkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section - Centered cards -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {service.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Processes Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.processes.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.processes.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {currentContent.processes.items.map((process) => (
          <div class="bg-white rounded-lg border-2 border-slate-100 p-3
                      hover:shadow-md hover:bg-white
                      hover:shadow-md transition-all duration-300
                      flex items-center gap-2 group">
            <svg class="w-4 h-4 text-[#0EA5E9] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-slate-700 text-xs font-medium group-hover:text-[#1E293B] transition-colors duration-300">{process}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.benefits.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Approach Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.approach.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.approach.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {currentContent.approach.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-xs font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>