---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO 27001 Implementation & Auditing";

const content = {
  en: {
    title: "ISO 27001",
    subtitle: "Implementation & Auditing",
    heroDescription: "Comprehensive ISO 27001 ISMS implementation and internal auditing services to achieve certification and maintain robust information security. Our expert team serves as your ISMS Manager and Internal Auditor, providing end-to-end support from initial scope definition through certification and ongoing compliance maintenance.",
    forWho: "For organizations seeking ISO 27001 certification and comprehensive ISMS implementation support.",
    achieve: "ISO 27001 certification with robust information security management and compliance assurance.",
    overview: {
      title: "Overview",
      description: "ISO 27001 is the international standard for Information Security Management Systems (ISMS). Achieving certification requires systematic implementation of security controls, comprehensive documentation, and ongoing management of information security risks.",
      highlight: "Our comprehensive implementation and auditing service provides dedicated ISMS expertise to guide your organization through every step of the certification journey, ensuring efficient implementation and successful audit outcomes."
    },
    phases: {
      title: "Implementation Process",
      subtitle: "Structured approach to ISO 27001 implementation and certification",
      items: [
        { number: "01", title: "Planning & Scoping", description: "Define ISMS scope, conduct context and stakeholder analysis, and perform initial risk assessment." },
        { number: "02", title: "Risk Assessment & SoA", description: "Perform detailed risk assessment, develop risk treatment plans, and create Statement of Applicability." },
        { number: "03", title: "Control Implementation", description: "Implement Annex A controls, develop policies and procedures, and collect evidence." },
        { number: "04", title: "Internal Audit & Certification", description: "Execute internal audits, conduct management review, and prepare for certification audit." }
      ]
    },
    isoControls: {
      title: "ISO 27001 Annex A Controls",
      subtitle: "Comprehensive implementation of all 14 security control categories",
      items: [
        { title: "Information Security Policies", icon: "document" },
        { title: "Organization of Information Security", icon: "building-library" },
        { title: "Human Resource Security", icon: "users" },
        { title: "Asset Management", icon: "folder" },
        { title: "Access Control", icon: "lock-closed" },
        { title: "Cryptography", icon: "shield" },
        { title: "Physical & Environmental Security", icon: "building" },
        { title: "Operations Security", icon: "cog" },
        { title: "Communications Security", icon: "globe" },
        { title: "System Acquisition & Development", icon: "code" },
        { title: "Supplier Relationships", icon: "link" },
        { title: "Incident Management", icon: "alert-triangle" },
        { title: "Business Continuity", icon: "chart-line" },
        { title: "Compliance", icon: "check-badge" }
      ]
    },
    features: {
      title: "Our Implementation Services",
      subtitle: "Comprehensive ISO 27001 services covering all aspects of ISMS implementation and auditing",
      items: [
        { title: "ISMS Scope & Risk Assessment", description: "Define ISMS scope, conduct comprehensive risk assessments, and establish risk treatment plans", icon: "map" },
        { title: "Statement of Applicability (SoA)", description: "Develop comprehensive SoA documenting applicable controls and justifications", icon: "document" },
        { title: "Control Implementation", description: "Implement ISO 27001 Annex A controls with detailed procedures and evidence collection", icon: "cog" },
        { title: "Internal Audit Program", description: "Design and execute comprehensive internal audit programs for ISMS compliance", icon: "clipboard" },
        { title: "Evidence Management", description: "Systematic collection and organization of evidence for compliance demonstration", icon: "folder" },
        { title: "Certification Support", description: "Complete preparation and support for external certification audits", icon: "award" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "ISMS scope definition and context analysis",
        "Comprehensive risk assessment and treatment plan",
        "Statement of Applicability (SoA)",
        "Security policies and procedures library",
        "Control implementation roadmap",
        "Evidence repository and documentation",
        "Internal audit program and reports",
        "Certification audit preparation and support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Achieve ISO 27001 certification efficiently",
        "Demonstrate security to customers and partners",
        "Reduce information security risks",
        "Meet regulatory and contractual requirements",
        "Competitive advantage through certification"
      ]
    }
  },
  fi: {
    title: "ISO 27001",
    subtitle: "Toteutus & Auditointi",
    heroDescription: "Kattavat ISO 27001 ISMS -toteutus- ja sisäiset auditointipalvelut sertifioinnin saavuttamiseksi ja vahvan tietoturvallisuuden ylläpitämiseksi. Asiantuntijatiimimme toimii ISMS-päällikkönäsi ja sisäisenä auditoijana tarjoten päästä päähän -tukea alkuperäisestä laajuuden määrittelystä sertifiointiin ja jatkuvaan vaatimustenmukaisuuden ylläpitoon.",
    forWho: "Organisaatioille, jotka tavoittelevat ISO 27001 -sertifiointia ja kattavaa ISMS-toteutustukea.",
    achieve: "ISO 27001 -sertifiointi vahvalla tietoturvallisuuden hallinnalla ja vaatimustenmukaisuusvarmennuksella.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27001 on kansainvälinen standardi tietoturvallisuuden hallintajärjestelmille (ISMS). Sertifioinnin saavuttaminen vaatii turvallisuuskontrollien systemaattista käyttöönottoa, kattavaa dokumentointia ja tietoturvariskien jatkuvaa hallintaa.",
      highlight: "Kattava toteutus- ja auditointipalvelumme tarjoaa omistautunutta ISMS-asiantuntemusta ohjatakseen organisaatiosi jokaisen sertifiointimatkan vaiheen läpi varmistaen tehokkaan toteutuksen ja onnistuneet auditointitulokset."
    },
    phases: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa ISO 27001 -toteutukseen ja sertifiointiin",
      items: [
        { number: "01", title: "Suunnittelu & laajuus", description: "Määrittele ISMS-laajuus, suorita toimintaympäristö- ja sidosryhmäanalyysi sekä alustava riskinarviointi." },
        { number: "02", title: "Riskinarviointi & SoA", description: "Suorita yksityiskohtainen riskinarviointi, kehitä riskien käsittelysuunnitelmat ja luo soveltuvuuslausuma." },
        { number: "03", title: "Kontrollien toteutus", description: "Toteuta liitteen A kontrollit, kehitä käytännöt ja menettelyt sekä kerää todisteet." },
        { number: "04", title: "Sisäinen auditointi & sertifiointi", description: "Toteuta sisäiset auditoinnit, suorita johdon katselmus ja valmistaudu sertifiointiauditointiin." }
      ]
    },
    isoControls: {
      title: "ISO 27001 -liitteen A kontrollit",
      subtitle: "Kaikkien 14 turvallisuuskontrollikategorian kattava toteutus",
      items: [
        { title: "Tietoturvapolitiikat", icon: "document" },
        { title: "Tietoturvallisuuden organisointi", icon: "building-library" },
        { title: "Henkilöstöturvallisuus", icon: "users" },
        { title: "Resurssien hallinta", icon: "folder" },
        { title: "Käyttöoikeuksien hallinta", icon: "lock-closed" },
        { title: "Kryptografia", icon: "shield" },
        { title: "Fyysinen & ympäristöturvallisuus", icon: "building" },
        { title: "Toiminnan turvallisuus", icon: "cog" },
        { title: "Viestinnän turvallisuus", icon: "globe" },
        { title: "Järjestelmien hankinta & kehitys", icon: "code" },
        { title: "Toimittajasuhteet", icon: "link" },
        { title: "Poikkeamien hallinta", icon: "alert-triangle" },
        { title: "Liiketoiminnan jatkuvuus", icon: "chart-line" },
        { title: "Vaatimustenmukaisuus", icon: "check-badge" }
      ]
    },
    features: {
      title: "Toteutuspalvelumme",
      subtitle: "Kattavat ISO 27001 -palvelut, jotka kattavat kaikki ISMS-toteutuksen ja auditoinnin näkökohdat",
      items: [
        { title: "ISMS-laajuus & riskinarviointi", description: "Määrittele ISMS-laajuus, suorita kattavat riskinarvioinnit ja perusta riskien käsittelysuunnitelmat", icon: "map" },
        { title: "Soveltuvuuslausuma (SoA)", description: "Kehitä kattava SoA, joka dokumentoi sovellettavat kontrollit ja perustelut", icon: "document" },
        { title: "Kontrollien toteutus", description: "Toteuta ISO 27001 -liitteen A kontrollit yksityiskohtaisilla menettelyillä ja todisteiden keruulla", icon: "cog" },
        { title: "Sisäinen auditointiohjelma", description: "Suunnittele ja toteuta kattavat sisäiset auditointiohjelmat ISMS-vaatimustenmukaisuudelle", icon: "clipboard" },
        { title: "Todisteiden hallinta", description: "Systemaattinen todisteiden keruu ja järjestäminen vaatimustenmukaisuuden osoittamiseksi", icon: "folder" },
        { title: "Sertifiointituki", description: "Täydellinen valmistelu ja tuki ulkoisia sertifiointiauditointia varten", icon: "award" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "ISMS-laajuuden määrittely ja toimintaympäristöanalyysi",
        "Kattava riskinarviointi ja käsittelysuunnitelma",
        "Soveltuvuuslausuma (SoA)",
        "Tietoturvakäytäntöjen ja -menettelyjen kirjasto",
        "Kontrollien toteutuksen tiekartta",
        "Todisteiden arkisto ja dokumentointi",
        "Sisäinen auditointiohjelma ja raportit",
        "Sertifiointiauditoinnin valmistelu ja tuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Saavuta ISO 27001 -sertifiointi tehokkaasti",
        "Osoita turvallisuus asiakkaille ja kumppaneille",
        "Vähennä tietoturvariskejä",
        "Täytä sääntely- ja sopimusvaatimukset",
        "Kilpailuetu sertifioinnin avulla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Implementation Phases Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.phases.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.phases.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ISO Controls Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.isoControls.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.isoControls.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
        {currentContent.isoControls.items.map((control) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-3 md:p-4 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-8 h-8 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={control.icon} class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {control.title}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.features.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.features.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.features.items.map((feature) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={feature.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {feature.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>