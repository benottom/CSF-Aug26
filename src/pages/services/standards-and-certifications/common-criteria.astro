---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Common Criteria";

const content = {
  en: {
    title: "Common Criteria",
    subtitle: "Security Evaluation & Certification",
    heroDescription: "Security Targets, Protection Profiles, and evaluation guidance for Common Criteria certification. Expert guidance for every aspect of Common Criteria certification including Security Target development, Protection Profile compliance, and evaluation support.",
    forWho: "For organizations seeking Common Criteria certification for their IT products at EAL1-EAL7 levels.",
    achieve: "Successful Common Criteria certification with expert guidance and comprehensive documentation.",
    overview: {
      title: "Overview",
      description: "Common Criteria is an international standard (ISO/IEC 15408) for computer security certification. It provides a framework for specifying security requirements and evaluating IT products against those requirements.",
      highlight: "Our expert team provides end-to-end support for Common Criteria certification, from Security Target development and Protection Profile compliance through evaluation support and certification maintenance."
    },
    services: {
      title: "Our Common Criteria Services",
      subtitle: "Expert guidance for every aspect of Common Criteria certification",
      items: [
        {
          title: "Security Targets (ST)",
          description: "Comprehensive Security Target development for your IT products",
          icon: "target",
          features: ["Security objective identification", "Threat and risk analysis", "Security functional requirements", "Security assurance requirements"]
        },
        {
          title: "Protection Profiles (PP)",
          description: "Industry-standard Protection Profile development and compliance",
          icon: "shield",
          features: ["PP compliance assessment", "Custom PP development", "Security requirements mapping", "Industry alignment verification"]
        },
        {
          title: "Evaluation Guidance",
          description: "Expert guidance throughout the Common Criteria evaluation process",
          icon: "clipboard-check",
          features: ["Evaluation lab selection", "Evaluation process support", "Evidence preparation", "Evaluator interaction management"]
        },
        {
          title: "Certification Support",
          description: "End-to-end support for successful Common Criteria certification",
          icon: "certificate",
          features: ["Certification body liaison", "Documentation review", "Compliance verification", "Certification maintenance"]
        }
      ]
    },
    evaluationLevels: {
      title: "Evaluation Assurance Levels (EAL)",
      subtitle: "We support certification at all EAL levels",
      items: [
        { level: "EAL1", description: "Functionally tested" },
        { level: "EAL2", description: "Structurally tested" },
        { level: "EAL3", description: "Methodically tested and checked" },
        { level: "EAL4", description: "Methodically designed, tested, and reviewed" },
        { level: "EAL5", description: "Semiformally designed and tested" },
        { level: "EAL6", description: "Semiformally verified design and tested" },
        { level: "EAL7", description: "Formally verified design and tested" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Security Target (ST) documentation",
        "Protection Profile (PP) compliance assessment",
        "Evaluation evidence and documentation",
        "Certification package and reports",
        "Evaluation lab support and liaison",
        "Certification body communication",
        "Maintenance and renewal support"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Achieve internationally recognized certification",
        "Demonstrate product security to customers",
        "Competitive advantage in security markets",
        "Meet government and defense requirements",
        "Streamlined evaluation process support"
      ]
    }
  },
  fi: {
    title: "Common Criteria",
    subtitle: "Turvallisuusarviointi ja sertifiointi",
    heroDescription: "Turvallisuustavoitteet, suojausprofiilit ja arviointiohjaus Common Criteria -sertifiointiin. Asiantuntevaa ohjausta jokaiseen Common Criteria -sertifioinnin osa-alueeseen, mukaan lukien Security Target -kehitys, Protection Profile -vaatimustenmukaisuus ja arviointituki.",
    forWho: "Organisaatioille, jotka tavoittelevat Common Criteria -sertifiointia IT-tuotteilleen EAL1-EAL7-tasoilla.",
    achieve: "Onnistunut Common Criteria -sertifiointi asiantuntevalla ohjauksella ja kattavalla dokumentaatiolla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Common Criteria on kansainvälinen standardi (ISO/IEC 15408) tietokoneiden turvallisuussertifiointiin. Se tarjoaa kehyksen turvallisuusvaatimusten määrittelyyn ja IT-tuotteiden arviointiin näitä vaatimuksia vastaan.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea Common Criteria -sertifiointiin Security Target -kehityksestä ja Protection Profile -vaatimustenmukaisuudesta arviointitukeen ja sertifioinnin ylläpitoon."
    },
    services: {
      title: "Common Criteria -palvelumme",
      subtitle: "Asiantuntevaa ohjausta jokaiseen Common Criteria -sertifioinnin osa-alueeseen",
      items: [
        {
          title: "Turvallisuustavoitteet (ST)",
          description: "Kattava Security Target -kehitys IT-tuotteillesi",
          icon: "target",
          features: ["Turvallisuustavoitteiden tunnistaminen", "Uhka- ja riskianalyysi", "Turvallisuustoiminnalliset vaatimukset", "Turvallisuusvarmuusvaatimukset"]
        },
        {
          title: "Suojausprofiilit (PP)",
          description: "Toimialastandardien mukainen Protection Profile -kehitys ja vaatimustenmukaisuus",
          icon: "shield",
          features: ["PP-vaatimustenmukaisuusarviointi", "Mukautettu PP-kehitys", "Turvallisuusvaatimusten kartoitus", "Toimialojen yhdenmukaisuuden varmennus"]
        },
        {
          title: "Arviointiohjaus",
          description: "Asiantuntevaa ohjausta koko Common Criteria -arviointiprosessin ajan",
          icon: "clipboard-check",
          features: ["Arviointilaboratorion valinta", "Arviointiprosessin tuki", "Todisteiden valmistelu", "Arvioijan vuorovaikutuksen hallinta"]
        },
        {
          title: "Sertifiointituki",
          description: "Päästä päähän -tuki onnistuneeseen Common Criteria -sertifiointiin",
          icon: "certificate",
          features: ["Sertifiointielimen yhteistyö", "Dokumentoinnin tarkistus", "Vaatimustenmukaisuuden varmennus", "Sertifioinnin ylläpito"]
        }
      ]
    },
    evaluationLevels: {
      title: "Arvioinnin varmuustasot (EAL)",
      subtitle: "Tuemme sertifiointia kaikilla EAL-tasoilla",
      items: [
        { level: "EAL1", description: "Toiminnallisesti testattu" },
        { level: "EAL2", description: "Rakenteellisesti testattu" },
        { level: "EAL3", description: "Menetelmällisesti testattu ja tarkistettu" },
        { level: "EAL4", description: "Menetelmällisesti suunniteltu, testattu ja tarkastettu" },
        { level: "EAL5", description: "Puoliformaalisti suunniteltu ja testattu" },
        { level: "EAL6", description: "Puoliformaalisti varmennettu suunnittelu ja testaus" },
        { level: "EAL7", description: "Formaalisti varmennettu suunnittelu ja testaus" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Security Target (ST) -dokumentaatio",
        "Protection Profile (PP) -vaatimustenmukaisuusarviointi",
        "Arviointitodisteet ja dokumentaatio",
        "Sertifiointipaketti ja raportit",
        "Arviointilaboratorion tuki ja yhteistyö",
        "Sertifiointielimen viestintä",
        "Ylläpito- ja uusimistuki"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Saavuta kansainvälisesti tunnustettu sertifiointi",
        "Osoita tuoteturvallisuus asiakkaille",
        "Kilpailuetu turvallisuusmarkkinoilla",
        "Täytä hallituksen ja puolustuksen vaatimukset",
        "Virtaviivaistettu arviointiprosessin tuki"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

<!-- Services Section -->
<section class="py-12 md:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
        {currentContent.services.title}
      </h2>
      <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
        {currentContent.services.subtitle}
      </p>
    </div>
    
    <!-- max-w-5xl makes cards narrower, 3 columns on desktop -->
    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentContent.services.items.map((service) => (
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                    hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                    transition-all duration-300
                    flex flex-col p-4 md:p-5 group relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
          
          <div class="flex justify-end mb-2 relative z-10">
            <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                        border-2 border-[#3B82F6]
                        transition-all duration-300
                        group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                        group-hover:border-transparent">
              <Icon name={service.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
            </div>
          </div>
          
          <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
            {service.title}
          </h3>
          <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
            {service.description}
          </p>
          
          <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
            <ul class="space-y-1">
              {service.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
  <!-- Evaluation Assurance Levels Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.evaluationLevels.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.evaluationLevels.subtitle}
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3">
        {currentContent.evaluationLevels.items.map((eal) => (
          <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3bb1f6]
                      transition-all duration-300
                      flex items-center gap-3 p-3 group">
            <div class="w-8 h-8 bg-[#3B82F6] rounded-full flex items-center justify-center flex-shrink-0">
              <span class="text-white font-bold text-xs">{eal.level.slice(-1)}</span>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-slate-900 group-hover:text-[#3B82F6] transition-colors duration-300">{eal.level}</h3>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">{eal.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefits.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefits.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>