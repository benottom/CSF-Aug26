---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO 27017 & 27018 Cloud Security";

const content = {
  en: {
    title: "ISO 27017 & 27018",
    subtitle: "Cloud Security & Privacy Protection",
    heroDescription: "Comprehensive cloud security implementation covering both cloud computing security controls (ISO 27017) and cloud privacy protection (ISO 27018). Secure your cloud infrastructure and data with internationally recognized standards.",
    forWho: "For organizations using cloud services seeking comprehensive security and privacy protection.",
    achieve: "Complete cloud security and privacy protection with ISO 27017 and ISO 27018 certification.",
    overview: {
      title: "Overview",
      description: "ISO 27017 provides specific security controls for cloud services, extending ISO 27001/27002 with cloud-specific guidance for both cloud service providers and customers. ISO 27018 focuses specifically on protecting personally identifiable information (PII) in public clouds.",
      highlight: "Our expert team provides comprehensive implementation support for both ISO 27017 and ISO 27018, ensuring complete cloud security and privacy protection across your cloud infrastructure."
    },
    standards: {
      title: "Cloud Security Standards",
      subtitle: "Two complementary standards that provide comprehensive security and privacy controls for cloud environments.",
      items: [
        {
          title: "ISO 27017",
          subtitle: "Cloud Computing Security",
          description: "Provides specific security controls for cloud services, extending ISO 27001/27002 with cloud-specific guidance for both cloud service providers and customers.",
          icon: "cloud",
          features: ["Cloud service security architecture", "Shared responsibility model", "Cloud-specific risk management"],
          color: "blue"
        },
        {
          title: "ISO 27018",
          subtitle: "Cloud Privacy Protection",
          description: "Focuses specifically on protecting personally identifiable information (PII) in public clouds, providing guidance for cloud service providers handling personal data.",
          icon: "shield",
          features: ["PII protection in cloud environments", "Transparency and communication", "Data location and portability"],
          color: "cyan"
        }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Comprehensive approach to implementing both ISO 27017 and ISO 27018 standards for complete cloud security coverage.",
      items: [
        { number: "01", title: "Cloud Assessment", description: "Comprehensive assessment of current cloud infrastructure, services, and security posture." },
        { number: "02", title: "Control Mapping", description: "Map ISO 27017 & 27018 controls to your cloud environment and identify implementation gaps." },
        { number: "03", title: "Security Implementation", description: "Implement cloud-specific security and privacy controls across your infrastructure." },
        { number: "04", title: "Continuous Monitoring", description: "Establish ongoing monitoring and compliance validation for cloud environments." }
      ]
    },
    services: {
      title: "Comprehensive Cloud Security Services",
      subtitle: "Expert implementation support for both ISO 27017 and ISO 27018 standards",
      items: [
        {
          title: "ISO 27017 Implementation",
          icon: "cloud",
          features: ["Cloud service customer/provider guidance", "Shared responsibility model documentation", "Cloud-specific security controls", "Multi-cloud security architecture", "Cloud service agreement review"]
        },
        {
          title: "ISO 27018 Implementation",
          icon: "shield",
          features: ["PII identification and classification", "Cloud privacy notice development", "Data location transparency controls", "Data portability and return procedures", "Third-party audit and transparency"]
        }
      ]
    },
    platforms: {
      title: "Multi-Cloud Platform Expertise",
      subtitle: "We support ISO 27017 & 27018 implementation across all major cloud platforms.",
      items: [
        { title: "AWS", icon: "cloud" },
        { title: "Azure", icon: "cloud" },
        { title: "GCP", icon: "cloud" },
        { title: "Multi-Cloud", icon: "cloud" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Cloud security controls implementation",
        "Shared responsibility model documentation",
        "PII protection framework",
        "Cloud privacy notice development",
        "Data location and portability controls",
        "Multi-cloud security architecture",
        "Continuous monitoring program",
        "Compliance validation framework"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Comprehensive cloud security and privacy protection",
        "Internationally recognized certification",
        "Enhanced customer trust and confidence",
        "Competitive advantage in cloud markets",
        "Regulatory compliance alignment"
      ]
    }
  },
  fi: {
    title: "ISO 27017 & 27018",
    subtitle: "Pilvipalveluiden turvallisuus & tietosuojaus",
    heroDescription: "Kattava pilvipalveluiden turvallisuustoteutus, joka kattaa sekä pilvipalveluiden turvallisuuskontrollit (ISO 27017) että pilvipalveluiden tietosuojauksen (ISO 27018). Turvaa pilvi-infrastruktuurisi ja datasi kansainvälisesti tunnustetuilla standardeilla.",
    forWho: "Organisaatioille, jotka käyttävät pilvipalveluita ja tarvitsevat kattavaa turvallisuus- ja tietosuojausratkaisua.",
    achieve: "Kattava pilvipalveluiden turvallisuus ja tietosuojaus ISO 27017- ja ISO 27018 -sertifioinnilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27017 tarjoaa erityisiä turvakontrolleja pilvipalveluille laajentaen ISO 27001/27002:ta pilvikohtaisella ohjeistuksella sekä pilvipalveluntarjoajille että asiakkaille. ISO 27018 keskittyy erityisesti henkilötietojen suojaamiseen julkisissa pilvissä.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa toteutustukea sekä ISO 27017- että ISO 27018 -standardeille varmistaen täydellisen pilvipalveluiden turvallisuuden ja tietosuojauksen koko pilvi-infrastruktuurissasi."
    },
    standards: {
      title: "Pilvipalveluiden turvallisuusstandardit",
      subtitle: "Kaksi toisiaan täydentävää standardia, jotka tarjoavat kattavat turvallisuus- ja tietosuojakontrollit pilviympäristöille.",
      items: [
        {
          title: "ISO 27017",
          subtitle: "Pilvipalveluiden turvallisuus",
          description: "Tarjoaa erityisiä turvakontrolleja pilvipalveluille, laajentaen ISO 27001/27002:ta pilvikohtaisella ohjeistuksella sekä pilvipalveluntarjoajille että asiakkaille.",
          icon: "cloud",
          features: ["Pilvipalveluiden turvallisuusarkkitehtuuri", "Jaettu vastuumalli", "Pilvikohtainen riskienhallinta"],
          color: "blue"
        },
        {
          title: "ISO 27018",
          subtitle: "Pilvipalveluiden tietosuojaus",
          description: "Keskittyy erityisesti henkilötietojen suojaamiseen julkisissa pilvissä tarjoten ohjeistusta pilvipalveluntarjoajille, jotka käsittelevät henkilötietoja.",
          icon: "shield",
          features: ["Henkilötietojen suojaaminen pilviympäristöissä", "Läpinäkyvyys ja viestintä", "Tietojen sijainti ja siirrettävyys"],
          color: "cyan"
        }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Kattava lähestymistapa sekä ISO 27017- että ISO 27018 -standardien toteuttamiseen täydellistä pilvipalveluiden turvallisuuskattavuutta varten.",
      items: [
        { number: "01", title: "Pilvipalveluarviointi", description: "Kattava arviointi nykyisestä pilvi-infrastruktuurista, palveluista ja turvallisuustilanteesta." },
        { number: "02", title: "Kontrollien kartoitus", description: "Kartuta ISO 27017- ja 27018 -kontrollit pilviympäristöösi ja tunnista toteutuspuutteet." },
        { number: "03", title: "Turvallisuuden toteutus", description: "Toteuta pilvikohtaiset turvallisuus- ja tietosuojakontrollit infrastruktuurissasi." },
        { number: "04", title: "Jatkuva seuranta", description: "Perusta jatkuva seuranta ja vaatimustenmukaisuuden validointi pilviympäristöille." }
      ]
    },
    services: {
      title: "Kattavat pilvipalveluiden turvallisuuspalvelut",
      subtitle: "Asiantuntevaa toteutustukea sekä ISO 27017- että ISO 27018 -standardeille",
      items: [
        {
          title: "ISO 27017 -toteutus",
          icon: "cloud",
          features: ["Pilvipalveluasiakkaan/tarjoajan ohjeistus", "Jaetun vastuumallin dokumentointi", "Pilvikohtaiset turvallisuuskontrollit", "Monipilvipalveluiden turvallisuusarkkitehtuuri", "Pilvipalvelusopimuksen tarkistus"]
        },
        {
          title: "ISO 27018 -toteutus",
          icon: "shield",
          features: ["Henkilötietojen tunnistaminen ja luokittelu", "Pilvipalveluiden tietosuojailmoituksen kehitys", "Tietojen sijainnin läpinäkyvyyskontrollit", "Tietojen siirrettävyys- ja palautusmenettelyt", "Kolmannen osapuolen auditointi ja läpinäkyvyys"]
        }
      ]
    },
    platforms: {
      title: "Monipilvialustojen asiantuntemus",
      subtitle: "Tuemme ISO 27017- ja 27018 -standardien toteutusta kaikilla merkittävimmillä pilvialustoilla.",
      items: [
        { title: "AWS", icon: "cloud" },
        { title: "Azure", icon: "cloud" },
        { title: "GCP", icon: "cloud" },
        { title: "Monipilvi", icon: "cloud" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Pilvipalveluiden turvallisuuskontrollien toteutus",
        "Jaetun vastuumallin dokumentointi",
        "Henkilötietojen suojaamisen kehys",
        "Pilvipalveluiden tietosuojailmoituksen kehitys",
        "Tietojen sijainti- ja siirrettävyyskontrollit",
        "Monipilvipalveluiden turvallisuusarkkitehtuuri",
        "Jatkuva seurantaohjelma",
        "Vaatimustenmukaisuuden validointikehys"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Kattava pilvipalveluiden turvallisuus ja tietosuojaus",
        "Kansainvälisesti tunnustettu sertifiointi",
        "Parantunut asiakasluottamus",
        "Kilpailuetu pilvipalvelumarkkinoilla",
        "Sääntelyvaatimusten yhdenmukaistaminen"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Standards Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.standards.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.standards.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.standards.items.map((standard) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={standard.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-0.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {standard.title}
            </h3>
            <p class="text-xs font-semibold text-[#003580] mb-2 text-left relative z-10">{standard.subtitle}</p>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">{standard.description}</p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {standard.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Section - Centered, better cards -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            
            <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
              {service.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Platforms Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.platforms.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.platforms.subtitle}
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-6">
        {currentContent.platforms.items.map((platform) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={platform.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {platform.title}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

