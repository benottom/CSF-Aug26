---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "TISAX (Automotive)";

const content = {
  en: {
    title: "TISAX (Automotive)",
    subtitle: "Trusted Information Security Assessment Exchange",
    heroDescription: "Scope definition, assessment support, and label attainment for TISAX. Comprehensive support for automotive industry information security requirements.",
    forWho: "For organizations in the automotive industry seeking TISAX label attainment and compliance with VDA information security requirements.",
    achieve: "Successful TISAX label attainment with comprehensive assessment support and automotive industry compliance.",
    overview: {
      title: "Overview",
      description: "TISAX (Trusted Information Security Assessment Exchange) is the automotive industry's standard for information security assessment. It provides a standardized approach for assessing and exchanging information security results across the automotive supply chain.",
      highlight: "Our expert team provides comprehensive TISAX support, from scope definition and readiness assessment through label attainment and ongoing compliance, ensuring successful assessment results."
    },
    services: {
      title: "TISAX Services",
      subtitle: "Comprehensive support for every stage of your TISAX assessment journey",
      items: [
        {
          title: "Scope Definition & Readiness",
          description: "Define scope and assess readiness for TISAX assessment.",
          icon: "search",
          features: ["Scope definition workshops", "Readiness assessment", "Gap analysis", "Remediation roadmap"]
        },
        {
          title: "Assessment Preparation & Support",
          description: "Prepare for TISAX assessment and support through the process.",
          icon: "clipboard-check",
          features: ["Assessment planning", "Documentation review", "Stakeholder training", "Evidence collection"]
        },
        {
          title: "Label Attainment & Auditor Liaison",
          description: "Achieve TISAX label and coordinate with auditors.",
          icon: "certificate",
          features: ["Remediation support", "Audit liaison", "Certification preparation", "Label attainment guidance"]
        }
      ]
    },
    process: {
      title: "TISAX Assessment Process",
      subtitle: "Structured approach to achieve TISAX label attainment",
      items: [
        { number: "01", title: "Scope Definition", description: "Define assessment scope and identify relevant VDA information security requirements." },
        { number: "02", title: "Readiness Assessment", description: "Assess current security posture and identify gaps against TISAX requirements." },
        { number: "03", title: "Assessment Preparation", description: "Prepare documentation, evidence, and stakeholders for the assessment." },
        { number: "04", title: "Label Attainment", description: "Support the assessment process and achieve TISAX label." }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Scope definition report",
        "Readiness assessment and gap analysis",
        "Documentation framework",
        "Evidence collection guidelines",
        "Assessment preparation support",
        "Audit liaison and coordination",
        "Remediation guidance",
        "Label attainment support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Automotive industry recognition",
        "Enhanced supply chain trust",
        "Streamlined assessment process",
        "Competitive advantage in automotive market",
        "VDA compliance assurance"
      ]
    }
  },
  fi: {
    title: "TISAX (Autoala)",
    subtitle: "Trusted Information Security Assessment Exchange",
    heroDescription: "Laajuuden määrittely, arviointituki ja labelin saavuttaminen TISAXia varten. Kattava tuki autoteollisuuden tietoturvavaatimuksille.",
    forWho: "Autoteollisuuden organisaatioille, jotka tavoittelevat TISAX-labelia ja VDA-tietoturvavaatimusten noudattamista.",
    achieve: "Onnistunut TISAX-labelin saavuttaminen kattavalla arviointituella ja autoteollisuuden vaatimustenmukaisuudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "TISAX (Trusted Information Security Assessment Exchange) on autoteollisuuden standardi tietoturva-arvioinnille. Se tarjoaa standardisoidun lähestymistavan tietoturvatulosten arviointiin ja vaihtoon autoteollisuuden toimitusketjussa.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa TISAX-tukea laajuuden määrittelystä ja valmiusarvioinnista labelin saavuttamiseen ja jatkuvaan vaatimustenmukaisuuteen, varmistaen onnistuneet arviointitulokset."
    },
    services: {
      title: "TISAX-palvelut",
      subtitle: "Kattava tuki jokaiseen TISAX-arviointimatkan vaiheeseen",
      items: [
        {
          title: "Laajuuden määrittely & valmius",
          description: "Määrittele laajuus ja arvioi valmius TISAX-arviointiin.",
          icon: "search",
          features: ["Laajuuden määrittelytyöpajat", "Valmiusarviointi", "Aukkoanalyysi", "Korjausten tiekartta"]
        },
        {
          title: "Arviointivalmistelu & tuki",
          description: "Valmistaudu TISAX-arviointiin ja tue prosessin läpi.",
          icon: "clipboard-check",
          features: ["Arvioinnin suunnittelu", "Dokumentoinnin tarkistus", "Sidosryhmäkoulutus", "Todisteiden keruu"]
        },
        {
          title: "Labelin saavuttaminen & auditoriyhteistyö",
          description: "Saavuta TISAX-label ja tee yhteistyötä auditorien kanssa.",
          icon: "certificate",
          features: ["Korjaustoimien tuki", "Auditointiyhteistyö", "Sertifiointivalmistelu", "Labelin saavuttamisen ohjaus"]
        }
      ]
    },
    process: {
      title: "TISAX-arviointiprosessi",
      subtitle: "Rakenteinen lähestymistapa TISAX-labelin saavuttamiseksi",
      items: [
        { number: "01", title: "Laajuuden määrittely", description: "Määrittele arviointilaajuus ja tunnista sovellettavat VDA-tietoturvavaatimukset." },
        { number: "02", title: "Valmiusarviointi", description: "Arvioi nykyinen tietoturvatilanne ja tunnista puutteet TISAX-vaatimuksia vastaan." },
        { number: "03", title: "Arviointivalmistelu", description: "Valmistele dokumentaatio, todisteet ja sidosryhmät arviointia varten." },
        { number: "04", title: "Labelin saavuttaminen", description: "Tue arviointiprosessia ja saavuta TISAX-label." }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Laajuuden määrittelyraportti",
        "Valmiusarviointi ja aukkoanalyysi",
        "Dokumentointikehys",
        "Todisteiden keruun ohjeet",
        "Arviointivalmistelun tuki",
        "Auditointiyhteistyö ja koordinointi",
        "Korjaustoimien ohjaus",
        "Labelin saavuttamisen tuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Autoteollisuuden tunnustus",
        "Parantunut toimitusketjun luottamus",
        "Virtaviivaistettu arviointiprosessi",
        "Kilpailuetu autoteollisuuden markkinoilla",
        "VDA-vaatimustenmukaisuuden varmistus"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section - Centered cards with aligned descriptions -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            
            <!-- Description with fixed min-height for alignment -->
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center min-h-[2.5rem]">
              {service.description}
            </p>
            
            <!-- Darker, more visible separator line -->
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:border-[#3B82F6] transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>