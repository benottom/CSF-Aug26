---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO 27001 Services";

const content = {
  en: {
    title: "ISO 27001",
    subtitle: "Gap Analysis & Certification Support",
    heroDescription: "Gap analysis, ISMS build, internal audit, and end-to-end certification readiness support. Comprehensive support for every stage of your ISO 27001 certification journey.",
    forWho: "For organizations at any stage of their ISO 27001 certification journey seeking expert guidance.",
    achieve: "Successful ISO 27001 certification with comprehensive support and reduced timeline.",
    overview: {
      title: "Overview",
      description: "Achieving ISO 27001 certification requires systematic implementation of security controls, comprehensive documentation, and ongoing management of information security risks. Our comprehensive services guide you through every step of the certification journey.",
      highlight: "Our expert team provides end-to-end support for ISO 27001 certification, from gap analysis and ISMS implementation through internal auditing and certification readiness."
    },
    services: {
      title: "Our ISO 27001 Services",
      subtitle: "Comprehensive support for every stage of your ISO 27001 certification journey",
      items: [
        {
          title: "Gap Analysis",
          description: "Comprehensive assessment of your current security posture against ISO 27001 requirements",
          icon: "search",
          features: ["Current state assessment", "Compliance gap identification", "Risk analysis and prioritization", "Detailed remediation roadmap"]
        },
        {
          title: "ISMS Implementation",
          description: "Complete Information Security Management System design and implementation",
          icon: "shield",
          features: ["ISMS framework design", "Policy and procedure development", "Security control implementation", "Documentation and training"]
        },
        {
          title: "Internal Audits",
          description: "Regular internal audit services to maintain compliance and identify improvements",
          icon: "clipboard-check",
          features: ["Audit planning and execution", "Non-conformity identification", "Corrective action recommendations", "Continuous improvement support"]
        },
        {
          title: "Certification Readiness",
          description: "End-to-end support to ensure successful external certification audit",
          icon: "certificate",
          features: ["Pre-audit readiness assessment", "Documentation review and optimization", "Staff training and preparation", "Certification body liaison"]
        }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Gap analysis report with remediation roadmap",
        "ISMS framework and documentation",
        "Security policies and procedures",
        "Internal audit program and reports",
        "Certification readiness assessment",
        "Staff training materials",
        "Certification body support",
        "Ongoing maintenance guidance"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Faster certification timeline",
        "Reduced audit costs",
        "Expert guidance throughout the process",
        "Comprehensive documentation",
        "Ongoing support and maintenance"
      ]
    }
  },
  fi: {
    title: "ISO 27001",
    subtitle: "Aukkoanalyysi & Sertifiointituki",
    heroDescription: "Aukkoanalyysi, ISMS-rakennus, sisäinen auditointi ja päästä päähän -sertifiointivalmiustuki. Kattava tuki jokaiseen ISO 27001 -sertifiointimatkan vaiheeseen.",
    forWho: "Organisaatioille, jotka ovat missä tahansa ISO 27001 -sertifiointimatkan vaiheessa ja tarvitsevat asiantuntijaohjausta.",
    achieve: "Onnistunut ISO 27001 -sertifiointi kattavalla tuella ja nopeutetulla aikataululla.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27001 -sertifioinnin saavuttaminen vaatii turvallisuuskontrollien systemaattista käyttöönottoa, kattavaa dokumentointia ja tietoturvariskien jatkuvaa hallintaa. Kattavat palvelumme ohjaavat sinut jokaisen sertifiointimatkan vaiheen läpi.",
      highlight: "Asiantuntijatiimimme tarjoaa päästä päähän -tukea ISO 27001 -sertifiointiin aukkoanalyysistä ja ISMS-toteutuksesta sisäisen auditoinnin ja sertifiointivalmiuden kautta."
    },
    services: {
      title: "ISO 27001 -palvelumme",
      subtitle: "Kattava tuki jokaiseen ISO 27001 -sertifiointimatkan vaiheeseen",
      items: [
        {
          title: "Aukkoanalyysi",
          description: "Kattava arviointi nykyisestä turvallisuustilanteesta ISO 27001 -vaatimuksia vastaan",
          icon: "search",
          features: ["Nykytilan arviointi", "Vaatimustenmukaisuuspuutteiden tunnistaminen", "Riskianalyysi ja priorisointi", "Yksityiskohtainen korjausten tiekartta"]
        },
        {
          title: "ISMS-toteutus",
          description: "Täydellinen tietoturvallisuuden hallintajärjestelmän suunnittelu ja toteutus",
          icon: "shield",
          features: ["ISMS-kehyksen suunnittelu", "Käytäntöjen ja menettelyjen kehittäminen", "Turvallisuuskontrollien toteutus", "Dokumentointi ja koulutus"]
        },
        {
          title: "Sisäiset auditoinnit",
          description: "Säännölliset sisäiset auditointipalvelut vaatimustenmukaisuuden ylläpitämiseksi ja parannusten tunnistamiseksi",
          icon: "clipboard-check",
          features: ["Auditoinnin suunnittelu ja toteutus", "Poikkeamien tunnistaminen", "Korjaavien toimenpiteiden suositukset", "Jatkuvan parantamisen tuki"]
        },
        {
          title: "Sertifiointivalmius",
          description: "Päästä päähän -tuki onnistuneen ulkoisen sertifiointiauditoinnin varmistamiseksi",
          icon: "certificate",
          features: ["Esisertifioinnin valmiusarviointi", "Dokumentoinnin tarkistus ja optimointi", "Henkilöstön koulutus ja valmistelu", "Sertifiointielimen yhteistyö"]
        }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Aukkoanalyysiraportti korjausten tiekartalla",
        "ISMS-kehys ja dokumentaatio",
        "Tietoturvakäytännöt ja -menettelyt",
        "Sisäinen auditointiohjelma ja raportit",
        "Sertifiointivalmiusarviointi",
        "Henkilöstön koulutusmateriaalit",
        "Sertifiointielimen tuki",
        "Jatkuvan ylläpidon ohjeistus"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Nopeampi sertifiointiaikataulu",
        "Pienemmät auditointikustannukset",
        "Asiantuntijaohjaus koko prosessin ajan",
        "Kattava dokumentointi",
        "Jatkuva tuki ja ylläpito"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>