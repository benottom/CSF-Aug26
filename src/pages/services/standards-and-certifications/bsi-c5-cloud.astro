---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "BSI C5 Cloud Attestation";

const content = {
  en: {
    title: "BSI C5",
    subtitle: "German Cloud Security Compliance",
    heroDescription: "Expert BSI C5 compliance services to help cloud service providers meet German security standards and demonstrate trustworthy cloud operations. BSI C5 (Cloud Computing Compliance Controls Catalogue) is the German federal security standard for cloud service providers.",
    forWho: "For cloud service providers operating in Germany and the EU needing BSI C5 compliance.",
    achieve: "Full BSI C5 compliance with comprehensive control mapping, testing, and attestation.",
    overview: {
      title: "Overview",
      description: "BSI C5 is a German cloud security standard developed by the Federal Office for Information Security (BSI) for attestation of cloud service providers. It establishes comprehensive security requirements for cloud computing services operating in Germany and the European Union.",
      highlight: "Our expert team provides end-to-end support for BSI C5 compliance, from initial control mapping and gap analysis through testing, evidence collection, and attestation reporting."
    },
    features: {
      title: "Our BSI C5 Services",
      subtitle: "Comprehensive cloud security compliance services covering all aspects of BSI C5 requirements",
      items: [
        { title: "Control Mapping & Gap Analysis", description: "Comprehensive mapping of BSI C5 controls to your cloud infrastructure and identification of compliance gaps", icon: "map" },
        { title: "Testing & Evidence Collection", description: "Systematic testing of security controls and collection of evidence for attestation requirements", icon: "clipboard" },
        { title: "Attestation Reporting", description: "Professional attestation reports and documentation supporting BSI C5 compliance demonstration", icon: "document" },
        { title: "Auditor Support", description: "Expert liaison with auditors and support throughout the attestation process", icon: "users" },
        { title: "Remediation Planning", description: "Detailed remediation plans to address identified gaps and improve security posture", icon: "wrench" },
        { title: "Ongoing Compliance", description: "Continuous monitoring and maintenance of BSI C5 compliance requirements", icon: "monitor" }
      ]
    },
    cloudServices: {
      title: "Cloud Service Types",
      subtitle: "BSI C5 compliance support for all types of cloud service offerings",
      items: [
        "Infrastructure as a Service (IaaS)",
        "Platform as a Service (PaaS)",
        "Software as a Service (SaaS)",
        "Cloud Storage Services",
        "Hybrid Cloud Environments",
        "Multi-Cloud Architectures"
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "BSI C5 compliance assessment report",
        "Control mapping and gap analysis",
        "Security testing and validation results",
        "Attestation documentation package",
        "Remediation roadmap and implementation plan",
        "Auditor preparation and support materials",
        "Continuous monitoring procedures",
        "Annual compliance maintenance program"
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Meet German cloud security regulatory requirements",
        "Demonstrate security to European customers",
        "Enhance trust in cloud service offerings",
        "Competitive advantage in German/EU markets",
        "Streamlined audit and attestation processes"
      ]
    }
  },
  fi: {
    title: "BSI C5",
    subtitle: "Saksalainen pilvipalveluiden turvallisuusstandardin mukaisuus",
    heroDescription: "Asiantuntevat BSI C5 -vaatimustenmukaisuuspalvelut auttavat pilvipalveluntarjoajia täyttämään Saksan turvallisuusstandardit ja osoittamaan luotettavan pilvitoiminnan. BSI C5 (Cloud Computing Compliance Controls Catalogue) on Saksan liittovaltion tietoturvaviraston pilvipalveluntarjoajille kehittämä turvallisuusstandardi.",
    forWho: "Saksassa ja EU:ssa toimiville pilvipalveluntarjoajille, jotka tarvitsevat BSI C5 -vaatimustenmukaisuutta.",
    achieve: "Täysi BSI C5 -vaatimustenmukaisuus kattavalla kontrollikartoituksella, testauksella ja sertifioinnilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "BSI C5 on saksalainen pilvipalveluiden turvallisuusstandardi, jonka on kehittänyt Saksan liittovaltion tietoturvavirasto (BSI) pilvipalveluntarjoajien sertifiointiin. Se asettaa kattavat turvallisuusvaatimuksille Saksassa ja Euroopan unionissa toimiville pilvipalveluille.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea BSI C5 -vaatimustenmukaisuuteen alkuperäisestä kontrollikartoituksesta ja aukkoanalyysistä testaukseen, todisteiden keruuseen ja sertifiointiraportointiin."
    },
    features: {
      title: "BSI C5 -palvelumme",
      subtitle: "Kattavat pilvipalveluiden turvallisuuspalvelut, jotka kattavat kaikki BSI C5 -vaatimusten näkökohdat",
      items: [
        { title: "Kontrollikartoitus ja aukkoanalyysi", description: "Kattava BSI C5 -kontrollien kartoitus pilvi-infrastruktuuriisi ja vaatimustenmukaisuuspuutteiden tunnistaminen", icon: "map" },
        { title: "Testaus ja todisteiden keruu", description: "Systemaattinen tietoturvakontrollien testaus ja todisteiden keruu sertifiointivaatimuksia varten", icon: "clipboard" },
        { title: "Sertifiointiraportointi", description: "Ammattimaiset sertifiointiraportit ja dokumentaatio BSI C5 -vaatimustenmukaisuuden osoittamiseksi", icon: "document" },
        { title: "Auditorituki", description: "Asiantunteva yhteistyö auditorien kanssa ja tuki koko sertifiointiprosessin ajan", icon: "users" },
        { title: "Korjausten suunnittelu", description: "Yksityiskohtaiset korjaussuunnitelmat tunnistettujen puutteiden korjaamiseksi ja turvallisuustason parantamiseksi", icon: "wrench" },
        { title: "Jatkuva vaatimustenmukaisuus", description: "BSI C5 -vaatimustenmukaisuusvaatimusten jatkuva seuranta ja ylläpito", icon: "monitor" }
      ]
    },
    cloudServices: {
      title: "Pilvipalvelutyypit",
      subtitle: "BSI C5 -vaatimustenmukaisuustuki kaikentyyppisille pilvipalvelutarjonnalle",
      items: [
        "Infrastruktuuri palveluna (IaaS)",
        "Alusta palveluna (PaaS)",
        "Ohjelmisto palveluna (SaaS)",
        "Pilvitallennuspalvelut",
        "Hybridipilviympäristöt",
        "Monipilviarkkitehtuurit"
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "BSI C5 -vaatimustenmukaisuusarviointiraportti",
        "Kontrollikartoitus ja aukkoanalyysi",
        "Turvallisuustestaus- ja validointitulokset",
        "Sertifiointidokumentaatiopaketti",
        "Korjausten tiekartta ja toteutussuunnitelma",
        "Auditorien valmistelu- ja tukimateriaalit",
        "Jatkuvan seurannan menettelyt",
        "Vuosittainen vaatimustenmukaisuuden ylläpito-ohjelma"
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Täytä Saksan pilvipalveluiden sääntelyvaatimukset",
        "Osoita turvallisuus eurooppalaisille asiakkaille",
        "Lisää luottamusta pilvipalvelutarjontaan",
        "Kilpailuetu Saksan ja EU:n markkinoilla",
        "Virtaviivaistetut auditointi- ja sertifiointiprosessit"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.features.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.features.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.features.items.map((feature) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={feature.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {feature.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cloud Services Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.cloudServices.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.cloudServices.subtitle}
        </p>
      </div>
      
      <div class="max-w-2xl mx-auto grid grid-cols-1 sm:grid-cols-2 gap-3">
        {currentContent.cloudServices.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-3 group text-center">
            <div class="w-6 h-6 bg-[#003580] rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-[#003580] transition-colors duration-300">{service}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefits.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefits.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>