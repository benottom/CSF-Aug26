---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISAE 3000 Assurance";

const content = {
  en: {
    title: "ISAE 3000 Assurance",
    subtitle: "Independent Attestation Services",
    heroDescription: "Independent attestation over security/privacy control suites. Get expert guidance and accelerate your compliance timeline with comprehensive support for ISAE 3000 assurance engagements.",
    forWho: "For organizations requiring independent attestation over security and privacy controls.",
    achieve: "Successful ISAE 3000 assurance with expert guidance and comprehensive documentation.",
    overview: {
      title: "Overview",
      description: "ISAE 3000 is an international assurance standard for engagements other than audits of historical financial information. It provides a framework for independent attestation over security, privacy, and other control suites.",
      highlight: "Our expert team provides comprehensive support for ISAE 3000 assurance engagements, from control design and evidence management through auditor coordination and certification."
    },
    services: {
      title: "Our ISAE 3000 Services",
      subtitle: "Comprehensive support for every stage of your ISAE 3000 attestation journey",
      items: [
        {
          title: "Control Suite Design",
          description: "Design and document control suites for ISAE 3000 assurance engagements.",
          icon: "shield",
          features: ["Control framework mapping", "Policy and procedure development", "Documentation and training", "Evidence preparation"]
        },
        {
          title: "Evidence Management",
          description: "Prepare and manage evidence for independent attestation.",
          icon: "clipboard-check",
          features: ["Evidence collection guidance", "Documentation review", "Remediation support", "Audit readiness assessment"]
        },
        {
          title: "Auditor Coordination",
          description: "Coordinate with independent auditors for successful attestation.",
          icon: "certificate",
          features: ["Audit liaison", "Remediation planning", "Certification preparation", "Stakeholder communication"]
        }
      ]
    },
    benefits: {
      title: "Why Choose Our ISAE 3000 Services?",
      items: [
        "Independent attestation for security/privacy controls",
        "Comprehensive documentation",
        "Accelerated audit readiness",
        "Expert guidance throughout the process",
        "Ongoing compliance support"
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Control suite design and documentation",
        "Evidence management framework",
        "Auditor coordination and support",
        "Remediation planning and tracking",
        "Certification preparation materials"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Independent validation of security controls",
        "Enhanced stakeholder confidence",
        "Compliance with regulatory requirements",
        "Streamlined audit processes",
        "Demonstrated control effectiveness"
      ]
    }
  },
  fi: {
    title: "ISAE 3000 -varmennus",
    subtitle: "Riippumattomat varmennuspalvelut",
    heroDescription: "Riippumaton varmennus turvallisuus-/tietosuojakontrollikokonaisuuksista. Hanki asiantuntijaohjausta ja nopeuta vaatimustenmukaisuusaikatauluasi kattavalla tuella ISAE 3000 -varmennusprosesseihin.",
    forWho: "Organisaatioille, jotka tarvitsevat riippumatonta varmennusta turvallisuus- ja tietosuojakontrolleille.",
    achieve: "Onnistunut ISAE 3000 -varmennus asiantuntijaohjauksella ja kattavalla dokumentaatiolla.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISAE 3000 on kansainvälinen varmennusstandardi toimeksiannoille, jotka eivät koske historiallisen taloudellisen tiedon tilintarkastuksia. Se tarjoaa kehyksen riippumattomalle varmennukselle turvallisuus-, tietosuoja- ja muille kontrollikokonaisuuksille.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavaa tukea ISAE 3000 -varmennustoimeksiantoihin kontrollikokonaisuuksien suunnittelusta ja todisteiden hallinnasta auditorien koordinointiin ja sertifiointiin."
    },
    services: {
      title: "ISAE 3000 -palvelumme",
      subtitle: "Kattava tuki jokaiseen ISAE 3000 -varmennusprosessin vaiheeseen",
      items: [
        {
          title: "Kontrollikokonaisuuksien suunnittelu",
          description: "Suunnittele ja dokumentoi kontrollikokonaisuuksia ISAE 3000 -varmennustoimeksiantoja varten.",
          icon: "shield",
          features: ["Kontrollikehyksen kartoitus", "Politiikkojen ja menettelyjen kehittäminen", "Dokumentointi ja koulutus", "Todisteiden valmistelu"]
        },
        {
          title: "Todisteiden hallinta",
          description: "Valmistele ja hallitse todisteita riippumatonta varmennusta varten.",
          icon: "clipboard-check",
          features: ["Todisteiden keruun ohjaus", "Dokumentoinnin tarkistus", "Korjaustoimien tuki", "Auditointivalmiuden arviointi"]
        },
        {
          title: "Auditorien koordinointi",
          description: "Tee yhteistyötä riippumattomien auditorien kanssa onnistuneen varmennuksen saavuttamiseksi.",
          icon: "certificate",
          features: ["Auditointiyhteistyö", "Korjaustoimien suunnittelu", "Sertifiointivalmistelu", "Sidosryhmäviestintä"]
        }
      ]
    },
    benefits: {
      title: "Miksi valita ISAE 3000 -palvelumme?",
      items: [
        "Riippumaton varmennus turvallisuus-/tietosuojakontrolleille",
        "Kattava dokumentointi",
        "Nopeutettu auditointivalmius",
        "Asiantuntijaohjaus koko prosessin ajan",
        "Jatkuva vaatimustenmukaisuustuki"
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Kontrollikokonaisuuksien suunnittelu ja dokumentointi",
        "Todisteiden hallintakehys",
        "Auditorien koordinointi ja tuki",
        "Korjaustoimien suunnittelu ja seuranta",
        "Sertifiointivalmistelumateriaalit"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Riippumaton validointi turvallisuuskontrolleille",
        "Parantunut sidosryhmien luottamus",
        "Sääntelyvaatimusten noudattaminen",
        "Virtaviivaistetut auditointiprosessit",
        "Osoitettu kontrollien tehokkuus"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
      </div>
      
      <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-3 group">
            <div class="w-6 h-6 bg-[#0EA5E9] rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-[#0EA5E9] transition-colors duration-300">{benefit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits List Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits List -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>