---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "DORA Compliance";

const content = {
  en: {
    title: "DORA Compliance",
    subtitle: "Digital Operational Resilience Act",
    heroDescription: "DORA compliance services for financial service organizations. DORA has been applicable since 17 January 2025 — we help you strengthen ICT risk management, incident reporting, and digital operational resilience on an ongoing basis, not just for a one-time deadline.",
    forWho: "For financial service organizations in scope of the EU Digital Operational Resilience Act (DORA).",
    achieve: "Stronger ICT risk management, incident reporting processes, and digital operational resilience aligned with DORA.",
    overview: {
      title: "Overview",
      description: "The Digital Operational Resilience Act (DORA) is an EU regulation that establishes a comprehensive framework for ICT risk management in financial services. It requires financial organizations to strengthen their digital operational resilience and manage ICT-related risks.",
      highlight: "Our expert team provides comprehensive DORA compliance services, from initial assessment and gap analysis through implementation and ongoing compliance monitoring."
    },
    pillars: {
      title: "DORA Pillars",
      subtitle: "DORA is based on four pillars that define requirements for financial service organizations.",
      items: [
        { title: "ICT Risk Management", description: "Comprehensive ICT risk management system for financial services", icon: "chart-line", requirements: ["ICT risk identification and assessment", "Risk management strategies", "Continuous monitoring and reporting"] },
        { title: "ICT Incident Reporting", description: "Rapid and effective incident response and reporting", icon: "alert-triangle", requirements: ["Incident detection", "Response processes", "Regulatory reporting"] },
        { title: "Digital Resilience", description: "Strengthen digital service resilience and continuity", icon: "shield", requirements: ["Service continuity", "Backup and recovery", "Planned testing"] },
        { title: "Third-Party Risks", description: "Manage cybersecurity risks from vendors and partners", icon: "network", requirements: ["Vendor assessment", "Contract management", "Continuous monitoring"] }
      ]
    },
    timeline: {
      title: "DORA Timeline",
      subtitle: "Key milestones so far, and what ongoing compliance looks like now.",
      items: [
        { year: "2022", title: "Regulation Adopted", description: "DORA was adopted and entered into force in the EU" },
        { year: "2023–2024", title: "Preparation Period", description: "Organizations and regulatory technical standards were finalized ahead of applicability" },
        { year: "17 Jan 2025", title: "DORA Became Applicable", description: "DORA requirements became applicable for in-scope financial service organizations" },
        { year: "Ongoing", title: "Continuous Compliance", description: "In-scope organizations maintain ICT risk management, incident reporting, resilience testing, and third-party risk oversight on an ongoing basis" }
      ]
    },
    entities: {
      title: "Affected Organizations",
      subtitle: "DORA applies broadly across EU financial services, with proportionality provisions for some smaller entities.",
      items: ["Banks", "Insurance Companies", "Investment Services", "Payment Services", "Crypto Asset Services", "Financial Market Infrastructure"]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Clear and structured process for DORA compliance.",
      items: [
        { number: "01", title: "DORA Assessment", description: "Assess current security posture against DORA requirements" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Planning", description: "Plan DORA compliance program" },
        { number: "04", title: "Implementation", description: "Implement required security measures" },
        { number: "05", title: "Monitoring", description: "Continuous compliance monitoring and reporting" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "DORA compliance assessment report",
        "ICT risk management framework",
        "Incident response and reporting procedures",
        "Digital resilience strategy",
        "Third-party risk management program",
        "Compliance monitoring framework",
        "Staff training materials",
        "Ongoing compliance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Meet EU regulatory requirements",
        "Strengthen cybersecurity resilience",
        "Improve customer trust",
        "Reduce regulatory risks",
        "Competitive advantage in markets"
      ]
    }
  },
  fi: {
    title: "DORA Yhteensopivuus",
    subtitle: "Digitaalisen Operatiivisen Resilienssin Laki",
    heroDescription: "DORA-yhteensopivuuspalvelut rahoituspalveluorganisaatioille. DORA on ollut sovellettavissa 17.1.2025 alkaen — autamme vahvistamaan ICT-riskienhallintaa, häiriöraportointia ja digitaalista operatiivista resilienssiä jatkuvasti, ei vain kertaluonteisena määräaikaprojektina.",
    forWho: "Rahoituspalveluorganisaatioille, jotka kuuluvat EU:n digitaalisen operatiivisen resilienssin lain (DORA) soveltamisalaan.",
    achieve: "Vahvempi ICT-riskienhallinta, häiriöraportointiprosessit ja digitaalinen operatiivinen resilienssi DORA:n mukaisesti.",
    overview: {
      title: "Yleiskatsaus",
      description: "Digitaalisen operatiivisen resilienssin laki (DORA) on EU:n asetus, joka luo kattavan kehyksen ICT-riskienhallinnalle rahoituspalveluissa. Se vaatii rahoitusorganisaatioita vahvistamaan digitaalista operatiivista resilienssiään ja hallitsemaan ICT-riskejä.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia DORA-yhteensopivuuspalveluita alkukartoituksesta ja aukkoanalyysistä toteutukseen ja jatkuvaan vaatimustenmukaisuuden seurantaan."
    },
    pillars: {
      title: "DORA Pilarit",
      subtitle: "DORA perustuu neljään pilariin, jotka määrittelevät rahoituspalveluorganisaatioiden vaatimukset.",
      items: [
        { title: "ICT Riskienhallinta", description: "Kattava ICT riskienhallintajärjestelmä rahoituspalveluille", icon: "chart-line", requirements: ["ICT riskien tunnistus ja arviointi", "Riskien hallintastrategiat", "Jatkuva seuranta ja raportointi"] },
        { title: "ICT Vikatilanteiden Vastaus", description: "Nopea ja tehokas vikatilanteiden vastaus ja raportointi", icon: "alert-triangle", requirements: ["Vikatilanteiden tunnistus", "Vastausprosessit", "Sääntelyraportointi"] },
        { title: "Digitaalinen Resilienssi", description: "Vahvista digitaalisten palvelujen kestävyys ja jatkuvuus", icon: "shield", requirements: ["Palvelujen jatkuvuus", "Varmuuskopiointi ja palautus", "Suunnitelmallinen testaus"] },
        { title: "Kolmannen Osapuolen Riskit", description: "Hallitse toimittajien ja kumppaneiden kyberturvariskit", icon: "network", requirements: ["Toimittajien arviointi", "Sopimusten hallinta", "Jatkuva valvonta"] }
      ]
    },
    timeline: {
      title: "DORA Aikajana",
      subtitle: "Keskeiset virstanpylväät tähän mennessä ja mitä jatkuva vaatimustenmukaisuus tarkoittaa nyt.",
      items: [
        { year: "2022", title: "Asetus hyväksytty", description: "DORA hyväksyttiin ja astui voimaan EU:ssa" },
        { year: "2023–2024", title: "Valmistelukausi", description: "Organisaatiot ja tekniset sääntelystandardit viimeisteltiin ennen soveltamisen alkua" },
        { year: "17.1.2025", title: "DORA tuli sovellettavaksi", description: "DORA-vaatimukset tulivat sovellettaviksi soveltamisalaan kuuluville rahoituspalveluorganisaatioille" },
        { year: "Jatkuva", title: "Jatkuva vaatimustenmukaisuus", description: "Soveltamisalaan kuuluvat organisaatiot ylläpitävät ICT-riskienhallintaa, häiriöraportointia, kestävyystestausta ja kolmannen osapuolen riskien valvontaa jatkuvasti" }
      ]
    },
    entities: {
      title: "Koskevat Organisaatiot",
      subtitle: "DORA koskee laajasti EU:n rahoituspalvelusektoria, ja joillekin pienemmille toimijoille on suhteellisuusperiaatteeseen perustuvia kevennyksiä.",
      items: ["Pankit", "Vakuutusyhtiöt", "Sijoituspalvelut", "Maksupalvelut", "Kryptovaluuttapalvelut", "Rahoitusmarkkinoiden infrastruktuuri"]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi DORA yhteensopivuuteen.",
      items: [
        { number: "01", title: "DORA Arviointi", description: "Arvioidaan nykyinen tietoturvataso DORA vaatimusten suhteen" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Suunnittelu", description: "Suunnitellaan DORA yhteensopivuusohjelma" },
        { number: "04", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { number: "05", title: "Valvonta", description: "Jatkuva yhteensopivuuden valvonta ja raportointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "DORA-yhteensopivuusarviointiraportti",
        "ICT-riskienhallintakehys",
        "Vikatilanteiden vastaus- ja raportointimenettelyt",
        "Digitaalinen resilienssistrategia",
        "Kolmannen osapuolen riskienhallintaohjelma",
        "Vaatimustenmukaisuuden seurantakehys",
        "Henkilöstön koulutusmateriaalit",
        "Jatkuva yhteensopivuustuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Täytä EU sääntelyvaatimukset",
        "Vahvista kyberturvan kestävyyttä",
        "Paranna asiakkaiden luottamusta",
        "Vähennä sääntelyriskejä",
        "Kilpailuetu markkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.pillars.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.pillars.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.pillars.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.requirements.map((req) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.timeline.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.timeline.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.timeline.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-14 h-14 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {item.year}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Affected Entities Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.entities.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.entities.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-4">
        {currentContent.entities.items.map((entity) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center justify-center gap-2 p-3 group">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0
                        transition-all duration-300
                        group-hover:bg-[#003580]">
              <Icon name="building" class="w-4 h-4 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
            <span class="text-slate-700 text-xs font-medium group-hover:text-[#14171a] transition-colors duration-300">{entity}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
