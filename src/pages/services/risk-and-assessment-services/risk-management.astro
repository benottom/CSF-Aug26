---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Risk Management";

const content = {
  en: {
    title: "Risk Management",
    subtitle: "Enterprise Risk Framework & Governance",
    heroDescription: "Establish a practical risk framework, registers, KRIs, and governance that guide security decisions. A comprehensive risk management system that guides decision-making and ensures your organization focuses on the right risks in the right order.",
    forWho: "For organizations seeking to establish or improve their enterprise risk management framework and governance.",
    achieve: "A comprehensive risk management system with clear frameworks, registers, and monitoring.",
    components: {
      title: "Risk Management Components",
      subtitle: "Comprehensive approach to risk management across all organizational levels.",
      items: [
        { title: "Risk Framework", description: "ISO 27005/NIST-based risk management framework", icon: "target" },
        { title: "Risk Register", description: "Centralized risk register with tracking and reporting", icon: "database" },
        { title: "KRI Metrics", description: "Key Risk Indicator monitoring and alerting", icon: "trending-up" },
        { title: "Governance Model", description: "Roles, responsibilities and decision-making processes", icon: "users" }
      ]
    },
    riskTypes: {
      title: "Risk Types",
      subtitle: "We cover all key risk categories in your organization.",
      items: [
        { title: "Cybersecurity Risks", description: "Technology risks, vulnerabilities and cyber threats", icon: "shield" },
        { title: "Operational Risks", description: "Process, personnel and operational risks", icon: "users" },
        { title: "Third-Party Risks", description: "Vendor, partner and supply chain risks", icon: "building" },
        { title: "Regulatory Risks", description: "Compliance risks and regulatory changes", icon: "book-open" }
      ]
    },
    process: {
      title: "Risk Management Process",
      subtitle: "Structured approach to risk management throughout the entire lifecycle.",
      items: [
        { title: "Identification", items: ["Threat mapping", "Vulnerability analysis", "Impact analysis", "Risk scenario development"] },
        { title: "Assessment", items: ["Probability assessment", "Impact assessment", "Risk classification", "Priority ranking"] },
        { title: "Treatment", items: ["Control design", "Risk acceptance", "Risk transfer", "Risk avoidance"] },
        { title: "Monitoring", items: ["KRI monitoring", "Regular reviews", "Executive reporting", "Continuous improvement"] }
      ]
    },
    steps: {
      title: "Implementation Process",
      subtitle: "Step-by-step approach to effective risk management.",
      items: [
        { number: "01", title: "Framework Design", description: "Risk framework and methodology definition" },
        { number: "02", title: "Risk Identification", description: "Comprehensive risk mapping and documentation" },
        { number: "03", title: "Assessment & Prioritization", description: "Risk assessment and priority ranking" },
        { number: "04", title: "Control Design", description: "Risk treatment approach design" },
        { number: "05", title: "Implementation & Monitoring", description: "KRI metrics and monitoring processes" }
      ]
    }
  },
  fi: {
    title: "Riskienhallinta",
    subtitle: "Yrityksen riskikehys & hallintamalli",
    heroDescription: "Rakenna käytännöllinen riskikehikko, rekisterit, KRI-mittarit ja hallintamalli, joka ohjaa turvallisuuspäätöksiä. Kattava riskienhallintajärjestelmä, joka ohjaa päätöksentekoa ja varmistaa, että organisaatiosi keskittyy oikeisiin riskeihin oikeassa järjestyksessä.",
    forWho: "Organisaatioille, jotka haluavat rakentaa tai parantaa yrityksen riskienhallintakehystä ja hallintamallia.",
    achieve: "Kattava riskienhallintajärjestelmä selkeillä kehyksillä, rekistereillä ja seurannalla.",
    components: {
      title: "Riskienhallintakomponentit",
      subtitle: "Kokonaisvaltainen lähestymistapa riskien hallintaan organisaation kaikilla tasoilla.",
      items: [
        { title: "Riskikehikko", description: "ISO 27005/NIST-pohjainen riskienhallintakehikko", icon: "target" },
        { title: "Riskirekisteri", description: "Keskitetty riskirekisteri seurannalla ja raportoinnilla", icon: "database" },
        { title: "KRI-mittarit", description: "Keskeisten riskiindikaattoreiden seuranta ja hälytykset", icon: "trending-up" },
        { title: "Hallintamalli", description: "Roolit, vastuut ja päätöksentekoprosessit", icon: "users" }
      ]
    },
    riskTypes: {
      title: "Riskityypit",
      subtitle: "Kattamme kaikki keskeiset riskikategoriat organisaatiossanne.",
      items: [
        { title: "Kyberturvariskit", description: "Teknologiariskit, haavoittuvuudet ja kyberuhkat", icon: "shield" },
        { title: "Operatiiviset riskit", description: "Prosessi-, henkilöstö- ja toimintariskit", icon: "users" },
        { title: "Kolmannen osapuolen riskit", description: "Toimittaja-, kumppani- ja toimitusketjuriskit", icon: "building" },
        { title: "Sääntelyriskit", description: "Compliance-riskit ja säädösmuutokset", icon: "book-open" }
      ]
    },
    process: {
      title: "Riskienhallintaprosessi",
      subtitle: "Strukturoitu lähestymistapa riskien hallintaan koko elinkaaren ajan.",
      items: [
        { title: "Tunnistaminen", items: ["Uhkien kartoitus", "Haavoittuvuusanalyysi", "Vaikutusanalyysi", "Riskiskenaarioiden kehittäminen"] },
        { title: "Arviointi", items: ["Todennäköisyyden arviointi", "Vaikutuksen arviointi", "Riskin luokittelu", "Prioriteettijärjestys"] },
        { title: "Käsittely", items: ["Kontrollien suunnittelu", "Riskien hyväksyminen", "Riskien siirtäminen", "Riskien välttäminen"] },
        { title: "Seuranta", items: ["KRI-seuranta", "Säännölliset katselmukset", "Raportointi johdolle", "Jatkuva parantaminen"] }
      ]
    },
    steps: {
      title: "Toteutusprosessi",
      subtitle: "Vaiheittainen lähestymistapa tehokkaaseen riskienhallintaan.",
      items: [
        { number: "01", title: "Kehyksen suunnittelu", description: "Riskikehikon ja menetelmien määrittely" },
        { number: "02", title: "Riskien tunnistus", description: "Kattava riskien kartoitus ja dokumentointi" },
        { number: "03", title: "Arviointi ja priorisointi", description: "Riskien arviointi ja tärkeysjärjestys" },
        { number: "04", title: "Kontrollien suunnittelu", description: "Riskien käsittelytapojen suunnittelu" },
        { number: "05", title: "Toteutus ja seuranta", description: "KRI-mittarit ja seurantaprosessit" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Risk Management Components Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.components.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.components.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.components.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Risk Types Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.riskTypes.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.riskTypes.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.riskTypes.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-1.5">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
                <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Risk Management Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                {index + 1}
              </div>
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                {step.title}
              </h3>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {step.items.map((item) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>