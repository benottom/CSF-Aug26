---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Third-Party Risk Management";

const content = {
  en: {
    title: "Third-Party Risk",
    subtitle: "Complete TPRM Lifecycle & Vendor Risk Management",
    heroDescription: "Implement a complete TPRM lifecycle: onboarding, due diligence, contractual controls, and continuous monitoring. A comprehensive TPRM system that manages vendor risks throughout the entire lifecycle - from onboarding to continuous monitoring and potential termination.",
    forWho: "For organizations that rely on third-party vendors, suppliers, and partners and need to manage associated risks.",
    achieve: "A complete TPRM system with structured onboarding, due diligence, and continuous monitoring.",
    components: {
      title: "TPRM Components",
      subtitle: "Comprehensive approach to third-party risk management.",
      items: [
        { title: "Vendor Onboarding", description: "Structured process for evaluating and approving new vendors", icon: "user-plus" },
        { title: "Due Diligence", description: "Thorough background research and risk assessment", icon: "search" },
        { title: "Contractual Controls", description: "Security requirements and clauses in contracts", icon: "file-text" },
        { title: "Continuous Monitoring", description: "Regular assessment of vendor risk profiles", icon: "activity" }
      ]
    },
    riskCategories: {
      title: "Risk Categories",
      subtitle: "Key risk areas in third-party services.",
      items: [
        { title: "Cybersecurity Risks", description: "Vendor cybersecurity risks and vulnerabilities", icon: "shield" },
        { title: "Data Processing", description: "Personal data and confidential information processing", icon: "database" },
        { title: "Regulatory Risks", description: "Compliance requirements and legal adherence", icon: "globe" },
        { title: "Operational Risks", description: "Service availability and business continuity", icon: "trending-down" }
      ]
    },
    lifecycle: {
      title: "TPRM Lifecycle",
      subtitle: "Structured process for managing vendor risks throughout the entire partnership.",
      items: [
        { title: "Identification & Classification", items: ["Vendor inventory", "Criticality classification", "Risk level definition", "Service category mapping"] },
        { title: "Assessment & Approval", items: ["Due diligence process", "Security assessment", "Reference checks", "Approval process"] },
        { title: "Contract Management", items: ["Security clauses", "SLA requirements", "Audit rights", "Termination conditions"] },
        { title: "Ongoing Management", items: ["Regular assessments", "KRI monitoring", "Incident management", "Performance monitoring"] }
      ]
    },
    criteria: {
      title: "Assessment Criteria",
      subtitle: "Key factors in vendor risk assessment.",
      items: [
        { title: "Security Level", description: "ISO 27001, SOC 2, and other certifications", icon: "shield-check" },
        { title: "Geographic Location", description: "Data location and jurisdictional risks", icon: "map" },
        { title: "Organizational Maturity", description: "Governance models and process maturity", icon: "users" },
        { title: "Financial Stability", description: "Creditworthiness and financial situation", icon: "trending-up" }
      ]
    },
    steps: {
      title: "Implementation Process",
      subtitle: "Step-by-step approach to building a TPRM system.",
      items: [
        { number: "01", title: "Inventory", description: "Vendor mapping and classification" },
        { number: "02", title: "Risk Assessment", description: "Vendor-specific risk analysis" },
        { number: "03", title: "Due Diligence", description: "Thorough background investigation" },
        { number: "04", title: "Contract Negotiation", description: "Security requirements inclusion" },
        { number: "05", title: "Ongoing Monitoring", description: "Regular risk profile updates" }
      ]
    }
  },
  fi: {
    title: "Kolmannen osapuolen riskit",
    subtitle: "Koko TPRM-elinkaari & toimittajariskien hallinta",
    heroDescription: "Toteuta täydellinen TPRM-elinkaari: perehdyttäminen, due diligence, sopimusvalvonta ja jatkuva seuranta. Kattava TPRM-järjestelmä, joka hallitsee toimittajariskejä koko elinkaaren ajan - perehdytyksestä jatkuvaan seurantaan ja mahdolliseen irtisanomiseen.",
    forWho: "Organisaatioille, jotka ovat riippuvaisia kolmannen osapuolen toimittajista ja kumppaneista ja joiden on hallittava niihin liittyviä riskejä.",
    achieve: "Täydellinen TPRM-järjestelmä strukturoidulla perehdytyksellä, due diligence -prosessilla ja jatkuvalla seurannalla.",
    components: {
      title: "TPRM-komponentit",
      subtitle: "Kokonaisvaltainen lähestymistapa kolmannen osapuolen riskien hallintaan.",
      items: [
        { title: "Toimittajan perehdytys", description: "Strukturoitu prosessi uusien toimittajien arviointiin ja hyväksyntään", icon: "user-plus" },
        { title: "Due Diligence", description: "Perusteellinen taustatutkimus ja riskiarviointi", icon: "search" },
        { title: "Sopimusvalvonta", description: "Turvallisuusvaatimukset ja -klausuulit sopimuksissa", icon: "file-text" },
        { title: "Jatkuva seuranta", description: "Toimittajien riskiprofiilin säännöllinen arviointi", icon: "activity" }
      ]
    },
    riskCategories: {
      title: "Riskikategoriat",
      subtitle: "Keskeiset riskialueet kolmannen osapuolen palveluissa.",
      items: [
        { title: "Kyberturvariskit", description: "Toimittajien tietoturvariskit ja haavoittuvuudet", icon: "shield" },
        { title: "Tietojen käsittely", description: "Henkilötietojen ja liikesalaisuuksien käsittely", icon: "database" },
        { title: "Sääntelyriskit", description: "Compliance-vaatimukset ja lakien noudattaminen", icon: "globe" },
        { title: "Operatiiviset riskit", description: "Palvelun saatavuus ja liiketoiminnan jatkuvuus", icon: "trending-down" }
      ]
    },
    lifecycle: {
      title: "TPRM-elinkaari",
      subtitle: "Strukturoitu prosessi toimittajariskien hallintaan koko yhteistyön ajan.",
      items: [
        { title: "Tunnistaminen ja luokittelu", items: ["Toimittajainventaario", "Kriittisyysluokittelu", "Riskitasojen määrittely", "Palvelukategorioiden mapping"] },
        { title: "Arviointi ja hyväksyntä", items: ["Due diligence -prosessi", "Turvallisuusarviointi", "Referenssien tarkistus", "Hyväksyntäprosessi"] },
        { title: "Sopimushallinta", items: ["Turvallisuusklausuulit", "SLA-vaatimukset", "Audit-oikeudet", "Irtisanomisehdot"] },
        { title: "Jatkuva hallinta", items: ["Säännölliset arvioinnit", "KRI-seuranta", "Incident-hallinta", "Suorituskyvyn seuranta"] }
      ]
    },
    criteria: {
      title: "Arviointikriteerit",
      subtitle: "Keskeisimmät tekijät toimittajien riskiarvioinnissa.",
      items: [
        { title: "Tietoturvataso", description: "ISO 27001, SOC 2, ja muut sertifikaatit", icon: "shield-check" },
        { title: "Maantieteellinen sijainti", description: "Tietojen sijainti ja lainsäädäntöriskit", icon: "map" },
        { title: "Organisaation kypsyys", description: "Hallintamallit ja prosessien kypsyys", icon: "users" },
        { title: "Taloudellinen vakaus", description: "Luottokelpoisuus ja taloudellinen tilanne", icon: "trending-up" }
      ]
    },
    steps: {
      title: "Toteutusprosessi",
      subtitle: "Vaiheittainen lähestymistapa TPRM-järjestelmän rakentamiseen.",
      items: [
        { number: "01", title: "Inventaario", description: "Toimittajien kartoitus ja luokittelu" },
        { number: "02", title: "Riskiarviointi", description: "Toimittajakohtainen riskianalyysi" },
        { number: "03", title: "Due Diligence", description: "Perusteellinen taustatutkimus" },
        { number: "04", title: "Sopimusneuvottelut", description: "Turvallisuusvaatimusten sisällyttäminen" },
        { number: "05", title: "Jatkuva seuranta", description: "Säännöllinen riskiprofiilin päivitys" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TPRM Components Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.components.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.components.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.components.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Risk Categories Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.riskCategories.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.riskCategories.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.riskCategories.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-1.5">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-4 h-4 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
                <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                  {item.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TPRM Lifecycle Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.lifecycle.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.lifecycle.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.lifecycle.items.map((step, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                {index + 1}
              </div>
              <h3 class="text-sm font-bold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
                {step.title}
              </h3>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {step.items.map((item) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Assessment Criteria Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.criteria.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.criteria.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.criteria.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>