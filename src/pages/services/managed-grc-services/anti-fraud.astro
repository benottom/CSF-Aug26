---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Anti-Fraud Services";

const content = {
  en: {
    title: "Anti-Fraud Services",
    subtitle: "BEC Protection & Payment Fraud Prevention",
    heroDescription: "Reduce fraud losses with pragmatic controls for BEC/invoice fraud, payment controls, and detection and response. Protect your organization from BEC fraud, invoice fraud, and payment fraud with multi-layered controls and real-time detection.",
    forWho: "For organizations seeking to protect against BEC fraud, invoice fraud, payment fraud, and identity fraud.",
    achieve: "Reduced fraud losses with multi-layered controls, rapid detection, and effective response.",
    fraudTypes: {
      title: "Key Fraud Types",
      subtitle: "Identify and understand the most common fraud types threatening organizations today",
      items: [
        { title: "Email Fraud (BEC)", description: "Business Email Compromise and CEO fraud", risk: "Average €175k loss", icon: "mail" },
        { title: "Invoice Fraud", description: "Falsification and vendor data manipulation", risk: "Often undetected", icon: "file-text" },
        { title: "Payment Fraud", description: "Payment system manipulation", risk: "Rapid loss accumulation", icon: "credit-card" },
        { title: "Identity Fraud", description: "Identity misuse and impersonation", risk: "Reputation and legal risks", icon: "user-x" }
      ]
    },
    defense: {
      title: "Three-Layer Defense Strategy",
      subtitle: "Comprehensive approach to fraud prevention through technology, processes, and people",
      items: [
        { title: "Technology Controls", icon: "shield", controls: ["Email security", "MFA enforcement", "Payment validation", "Anomaly detection"] },
        { title: "Process Controls", icon: "settings", controls: ["Four-eyes principle", "Approval limits", "Vendor verification", "Change management"] },
        { title: "Human Controls", icon: "users", controls: ["Awareness training", "Phishing simulations", "Reporting channels", "Role definition"] }
      ]
    },
    detection: {
      title: "Detection Methods",
      subtitle: "Advanced analytical methods for early detection of fraudulent activities",
      items: [
        { title: "Real-time Detection", description: "Automated alerts for suspicious activities", icon: "search", details: ["Email analysis", "Payment anomalies", "Behavioral patterns", "Geolocation tracking"] },
        { title: "Trend Analysis", description: "Long-term pattern recognition", icon: "activity", details: ["Vendor analytics", "Payment behavior", "Timing analysis", "Volume changes"] },
        { title: "Forensic Analysis", description: "Deep investigation of fraud cases", icon: "database", details: ["Digital forensics", "Data mining", "Network analysis", "Timeline reconstruction"] }
      ]
    },
    response: {
      title: "Response Framework",
      subtitle: "Rapid and systematic response to minimize fraud impact",
      items: [
        { title: "Detection", time: "0-15 min", actions: ["Automatic alert", "Event classification", "Initial assessment", "Escalation"] },
        { title: "Containment", time: "15-60 min", actions: ["Payment freeze", "Account suspension", "Access blocking", "Evidence preservation"] },
        { title: "Investigation", time: "1-24 h", actions: ["Forensic analysis", "Impact assessment", "Root cause analysis", "Reporting"] },
        { title: "Recovery", time: "1-7 days", actions: ["Operations restore", "Control enhancement", "Process updates", "Lessons learned"] }
      ]
    },
    metrics: {
      title: "Target Metrics",
      subtitle: "Measurable outcomes from implementing effective anti-fraud program",
      items: [
        { metric: "Fraud Loss Reduction", target: "-85% annually" },
        { metric: "Detection Time", target: "<15 minutes" },
        { metric: "False Positives", target: "<5% of alerts" },
        { metric: "Staff Awareness", target: "95% trained" }
      ]
    }
  },
  fi: {
    title: "Petostentorjuntapalvelut",
    subtitle: "BEC-suojaus & maksupetosten torjunta",
    heroDescription: "Vähennä petostappioita pragmaattisilla kontrolleilla BEC/laskupetoksiin, maksukontrolleilla ja tunnistuksella. Suojaa organisaatiosi BEC-petoksilta, laskupetoksilta ja maksupetoksilta monipuolisilla kontrolleilla ja reaaliaikaisella tunnistuksella.",
    forWho: "Organisaatioille, jotka haluavat suojautua BEC-petoksilta, laskupetoksilta, maksupetoksilta ja identiteettipetoksilta.",
    achieve: "Vähennetyt petostappiot monipuolisilla kontrolleilla, nopealla tunnistuksella ja tehokkaalla vastetoiminnalla.",
    fraudTypes: {
      title: "Tärkeimmät petostyypit",
      subtitle: "Tunnista ja ymmärrä yleisimmät petostyypit, jotka uhkaavat organisaatioita tänään",
      items: [
        { title: "Sähköpostipetokset (BEC)", description: "Business Email Compromise ja CEO-petokset", risk: "Keskimäärin €175k tappio", icon: "mail" },
        { title: "Laskupetokset", description: "Väärennökset ja toimittajatietojen manipulointi", risk: "Usein huomaamaton", icon: "file-text" },
        { title: "Maksupetokset", description: "Maksujärjestelmien väärinkäyttö", risk: "Nopea tappioiden kertyminen", icon: "credit-card" },
        { title: "Identiteettipetokset", description: "Henkilöllisyyksien väärinkäyttö", risk: "Maine- ja lakihaasteet", icon: "user-x" }
      ]
    },
    defense: {
      title: "Kolmikerroksinen puolustusstrategia",
      subtitle: "Kattava lähestymistapa petostentorjuntaan teknologian, prosessien ja ihmisten kautta",
      items: [
        { title: "Teknologiakontrollit", icon: "shield", controls: ["Email-turvallisuus", "MFA-pakotus", "Maksujen validointi", "Anomalian tunnistus"] },
        { title: "Prosessikontrollit", icon: "settings", controls: ["Nelisilmäperiaate", "Hyväksymisrajat", "Toimittajien verifiointi", "Muutosten hallinta"] },
        { title: "Inhimilliset kontrollit", icon: "users", controls: ["Tietoisuuskoulutus", "Phishing-simulaatiot", "Ilmoituskanavat", "Vastuiden määrittely"] }
      ]
    },
    detection: {
      title: "Tunnistusmenetelmät",
      subtitle: "Edistyneet analyysimenetelmät petostoiminnan varhaiseen tunnistamiseen",
      items: [
        { title: "Reaaliaikainen tunnistus", description: "Automaattiset hälytykset epäilyttävistä tapahtumista", icon: "search", details: ["Sähköpostianalyysi", "Maksupoikkeamat", "Käyttäytymismallit", "Geolokation seuranta"] },
        { title: "Trendianalyysi", description: "Pitkän aikavälin mallien tunnistaminen", icon: "activity", details: ["Toimittaja-analyysit", "Maksukäyttäytyminen", "Ajankohta-analyysi", "Volyymimuutokset"] },
        { title: "Forensinen analyysi", description: "Syvällinen petostapausten tutkinta", icon: "database", details: ["Digitaalinen forensiikka", "Tiedonlouhinta", "Verkostoanalyysi", "Aikajanarekonstruktio"] }
      ]
    },
    response: {
      title: "Vastetoimintakehys",
      subtitle: "Nopea ja järjestelmällinen vastetoiminta petostapausten minimoimiseksi",
      items: [
        { title: "Tunnistaminen", time: "0-15 min", actions: ["Automaattinen hälytys", "Tapahtuman luokittelu", "Alustava arviointi", "Eskalointi"] },
        { title: "Eristäminen", time: "15-60 min", actions: ["Maksun pysäytys", "Tilin sulkeminen", "Pääsyn estäminen", "Evidenssin säilytys"] },
        { title: "Tutkinta", time: "1-24 h", actions: ["Forensinen analyysi", "Vaikutusarvio", "Juurisyyn analyysi", "Raportointi"] },
        { title: "Palautus", time: "1-7 päivää", actions: ["Toiminnan palautus", "Kontrollien vahvistus", "Prosessien päivitys", "Oppimispisteet"] }
      ]
    },
    metrics: {
      title: "Tavoitemittarit",
      subtitle: "Mitattavat tulokset tehokkaan petostentorjuntaohjelman käyttöönotosta",
      items: [
        { metric: "Petostappioiden vähennys", target: "-85% vuodessa" },
        { metric: "Tunnistusaika", target: "<15 minuuttia" },
        { metric: "Väärät hälytykset", target: "<5% hälytyksistä" },
        { metric: "Henkilöstön tietoisuus", target: "95% koulutetuista" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Fraud Types Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.fraudTypes.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.fraudTypes.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.fraudTypes.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t border-slate-100 relative z-10">
              <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium text-red-600 bg-red-50 rounded-[2px] border border-red-200 group-hover:bg-red-100 transition-colors duration-300">
                {item.risk}
              </span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Defense Strategy Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.defense.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.defense.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.defense.items.map((layer, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                {index + 1}
              </div>
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                {layer.title}
              </h3>
            </div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={layer.icon} class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {layer.controls.map((control) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {control}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detection Methods Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.detection.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.detection.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.detection.items.map((method) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={method.icon} class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {method.title}
                </h3>
                <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                  {method.description}
                </p>
              </div>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {method.details.map((detail) => (
                <li class="flex items-center text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Response Framework Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.response.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.response.subtitle}
        </p>
      </div>
      
      <div class="space-y-4 max-w-4xl mx-auto">
        {currentContent.response.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-10 h-10 bg-[#003580] text-white rounded-xl flex items-center justify-center text-sm font-bold">
                {index + 1}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {phase.title}
                </h3>
                <span class="inline-flex items-center px-2 py-0.5 text-xs font-medium text-red-600 bg-red-50 rounded-[2px] border border-red-200 group-hover:bg-red-100 transition-colors duration-300">
                  {phase.time}
                </span>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {phase.actions.map((action) => (
                  <span class="inline-flex items-center text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {action}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.metrics.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.metrics.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.metrics.items.map((metric) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="text-2xl font-bold text-[#131c2e] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {metric.target}
            </div>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {metric.metric}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>