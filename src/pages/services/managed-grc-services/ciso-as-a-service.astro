---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "CISO-as-a-Service";

const content = {
  en: {
    title: "CISO-as-a-Service",
    subtitle: "Expert Security Leadership on Demand",
    heroDescription: "Access experienced CISO expertise and leadership without full-time recruitment. From strategy to execution. Expert leadership on demand: strategy, roadmap, governance, metrics, and board reporting.",
    forWho: "For organizations that need security leadership without full-time recruitment costs.",
    achieve: "Enhanced security maturity, regulatory compliance, and stakeholder confidence.",
    services: {
      title: "Core CISO Service Areas",
      subtitle: "Comprehensive security leadership from strategic planning to daily operational management",
      items: [
        { title: "Strategic Leadership", description: "Security strategy development and execution", icon: "target" },
        { title: "Roadmap Planning", description: "Long-term security planning and roadmaps", icon: "map" },
        { title: "Metrics & Reporting", description: "KPI tracking and executive reporting", icon: "bar-chart" },
        { title: "Stakeholder Management", description: "Board and executive communication", icon: "users" }
      ]
    },
    leadership: {
      title: "Leadership Areas",
      subtitle: "Three key areas where CISO service delivers significant value to your organization",
      items: [
        {
          title: "Governance & Compliance",
          description: "ISMS management and regulatory compliance",
          icon: "shield",
          details: ["ISO 27001 management", "GDPR compliance", "SOC 2 preparation", "Risk management framework"]
        },
        {
          title: "Strategic Development",
          description: "Security architecture and program development",
          icon: "trending-up",
          details: ["Zero Trust architecture", "Cloud security", "DevSecOps integration", "Modernization projects"]
        },
        {
          title: "Team Leadership",
          description: "Security team development and leadership",
          icon: "users",
          details: ["Skill development", "Recruitment strategy", "Team structure", "Performance management"]
        }
      ]
    },
    deliverables: {
      title: "Deliverables and Outcomes",
      subtitle: "Concrete deliverables and measurable outcomes from CISO service",
      items: [
        {
          title: "Strategic Documents",
          details: ["Security strategy", "Annual plan", "Technology roadmap", "Budget and resources"]
        },
        {
          title: "Governance Documents",
          details: ["Policies and processes", "Risk register", "Compliance matrix", "Operating models"]
        },
        {
          title: "Reporting",
          details: ["Monthly reports", "Quarterly reviews", "Board presentations", "Dashboards"]
        },
        {
          title: "Operational Support",
          details: ["Incident coordination", "Vendor management", "Project oversight", "Training programs"]
        }
      ]
    },
    engagement: {
      title: "Engagement Models",
      subtitle: "Choose the CISO service model that best fits your organization's needs",
      items: [
        { title: "Full-Service CISO", time: "3-5 days/week", description: "Comprehensive security leadership responsibility", suited: "Mid-size enterprises" },
        { title: "Strategic CISO", time: "1-2 days/week", description: "Strategic guidance and executive leadership", suited: "Mature organizations" },
        { title: "Project CISO", time: "Project-based", description: "Interim leadership for special projects", suited: "Transformation projects" }
      ]
    },
    outcomes: {
      title: "Measurable Outcomes",
      subtitle: "Typical improvements in client organizations after CISO service implementation",
      items: [
        { metric: "Cybersecurity Maturity", improvement: "+40% annually" },
        { metric: "Regulatory Compliance", improvement: "99% of requirements" },
        { metric: "Incident Management", improvement: "-60% resolution time" },
        { metric: "Executive Satisfaction", improvement: "9.2/10 rating" }
      ]
    }
  },
  fi: {
    title: "CISO-palveluna",
    subtitle: "Asiantuntijajohtoinen tietoturvajohtaminen",
    heroDescription: "Saat käyttöösi kokeneen CISO:n osaamisen ja johtajuuden ilman kokoaikaista rekrytointia. Strategiasta toteutukseen. Asiantuntijajohtoinen tietoturvajohtaminen: strategia, roadmap, mittarit ja sidosryhmäraportointi.",
    forWho: "Organisaatioille, jotka tarvitsevat tietoturvajohtamista ilman kokoaikaisia rekrytointikustannuksia.",
    achieve: "Parantunut tietoturvakypsyys, säädöstenmukaisuus ja sidosryhmien luottamus.",
    services: {
      title: "CISO-palvelun keskeiset alueet",
      subtitle: "Kattava tietoturvajohtaminen strategisesta suunnittelusta päivittäiseen operatiiviseen johtamiseen",
      items: [
        { title: "Strateginen johtaminen", description: "Tietoturvastrategian kehittäminen ja toimeenpano", icon: "target" },
        { title: "Roadmap-suunnittelu", description: "Pitkän aikavälin tietoturvasuunnitelmien laatiminen", icon: "map" },
        { title: "Mittarit ja raportointi", description: "KPI-seuranta ja johtoryhmäraportointi", icon: "bar-chart" },
        { title: "Sidosryhmähallinta", description: "Hallituksen ja johdon viestintä", icon: "users" }
      ]
    },
    leadership: {
      title: "Johtamisen osa-alueet",
      subtitle: "Kolme keskeistä aluetta, joissa CISO-palvelu tuottaa merkittävää lisäarvoa organisaatiollesi",
      items: [
        {
          title: "Governance & Compliance",
          description: "ISMS-hallinta ja säädösten noudattaminen",
          icon: "shield",
          details: ["ISO 27001 -hallinta", "GDPR-vaatimustenmukaisuus", "SOC 2 -valmistelu", "Riskinhallintakehys"]
        },
        {
          title: "Strateginen kehittäminen",
          description: "Tietoturva-arkkitehtuurin ja -ohjelman kehittäminen",
          icon: "trending-up",
          details: ["Zero Trust -arkkitehtuuri", "Cloud-turvallisuus", "DevSecOps-integraatio", "Modernisointihankkeet"]
        },
        {
          title: "Tiimin johtaminen",
          description: "Tietoturvatiimin kehittäminen ja johtaminen",
          icon: "users",
          details: ["Osaamisen kehittäminen", "Rekrytointi-strategia", "Tiimin rakenne", "Suorituksen johtaminen"]
        }
      ]
    },
    deliverables: {
      title: "Toimitukset ja tulokset",
      subtitle: "Konkreettiset toimitukset ja mitattavat tulokset CISO-palvelusta",
      items: [
        {
          title: "Strategiset dokumentit",
          details: ["Tietoturvastrategia", "Vuosisuunnitelma", "Teknologia-roadmap", "Budjetti ja resurssit"]
        },
        {
          title: "Hallinnolliset dokumentit",
          details: ["Politiikat ja prosessit", "Riskirekisteri", "Compliance-matriisi", "Toimintamallit"]
        },
        {
          title: "Raportointi",
          details: ["Kuukausiraportit", "Neljännesvuosikatsaukset", "Hallitusesitykset", "Mittaristot"]
        },
        {
          title: "Toiminnallinen tuki",
          details: ["Incident-koordinointi", "Toimittajahallinta", "Projektien ohjaus", "Koulutusohjelmat"]
        }
      ]
    },
    engagement: {
      title: "Toimeksiantomoodit",
      subtitle: "Valitse organisaatiosi tarpeisiin sopivin CISO-palvelumalli",
      items: [
        { title: "Täyden palvelun CISO", time: "3-5 päivää/viikko", description: "Kokonaisvaltainen tietoturvajohdon vastuu", suited: "Keskisuurille yrityksille" },
        { title: "Strateginen CISO", time: "1-2 päivää/viikko", description: "Strateginen ohjaus ja johtoryhmätyöskentely", suited: "Kypsille organisaatioille" },
        { title: "Projekti-CISO", time: "Projektikohtainen", description: "Määräaikainen johtaminen erityishankkeissa", suited: "Transformaatiohankkeille" }
      ]
    },
    outcomes: {
      title: "Mitattavat tulokset",
      subtitle: "Tyypilliset parannukset asiakasorganisaatioissa CISO-palvelun käyttöönoton jälkeen",
      items: [
        { metric: "Kyberturvallisuuskypsyys", improvement: "+40% vuodessa" },
        { metric: "Säädöstenmukaisuus", improvement: "99% vaatimuksista" },
        { metric: "Incidentien hallinta", improvement: "-60% käsittelyajassa" },
        { metric: "Johdon tyytyväisyys", improvement: "9.2/10 arvosana" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.services.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Leadership Areas Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.leadership.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.leadership.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.leadership.items.map((area) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={area.icon} class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {area.title}
                </h3>
                <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                  {area.description}
                </p>
              </div>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {area.details.map((detail) => (
                <li class="flex items-center text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.deliverables.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.deliverables.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.deliverables.items.map((category) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {category.title}
            </h3>
            
            <ul class="space-y-1 relative z-10">
              {category.details.map((detail) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engagement Models Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.engagement.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.engagement.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.engagement.items.map((model) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {model.title}
            </h3>
            
            <div class="text-lg font-bold text-[#131c2e] mb-2 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {model.time}
            </div>
            
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {model.description}
            </p>
            
            <div class="bg-blue-50 rounded-lg p-2 mt-auto relative z-10">
              <p class="text-xs text-blue-800 font-medium">
                {isFi ? 'Sopii: ' : 'Suited for: '}{model.suited}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.outcomes.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.outcomes.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.outcomes.items.map((outcome) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="text-2xl font-bold text-[#131c2e] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {outcome.improvement}
            </div>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {outcome.metric}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>