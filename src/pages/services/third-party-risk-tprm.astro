---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = lang === 'fi' ? "Kolmannen Osapuolen Riskit (TPRM)" : "Third-Party Risk (TPRM)";

const content = {
  en: {
    title: "Third-Party Risk (TPRM)",
    subtitle: "Third-Party Risk Management",
    heroDescription: "Professional third-party risk management services. We help organizations manage cybersecurity risks from vendors and partners.",
    forWho: "For organizations seeking to manage cybersecurity risks from vendors, partners, and third-party providers.",
    achieve: "Comprehensive third-party risk management with systematic TPRM processes and controls.",
    overview: {
      title: "Overview",
      description: "Third-Party Risk Management (TPRM) is the process of identifying, assessing, and mitigating risks posed by third-party organizations, including vendors, partners, and service providers. Effective TPRM is essential for protecting your organization from supply chain and partner-related risks.",
      highlight: "Our expert team provides comprehensive TPRM services, helping you build a strong third-party risk management program and reduce risks from vendors and partners."
    },
    tprmCategories: [
      {
        title: "Vendor Risks",
        description: "Cybersecurity risks from vendors and service providers",
        icon: "building",
        risks: ["Vendor vulnerabilities", "Data exposure", "Service disruption"]
      },
      {
        title: "Partner Risks",
        description: "Risks from business partners and collaboration partners",
        icon: "network",
        risks: ["Collaboration risks", "Data sharing", "Integrations"]
      },
      {
        title: "Supply Chain Risks",
        description: "Supply chain and subcontractor risks",
        icon: "truck",
        risks: ["Subcontractor risks", "Supply chain vulnerabilities", "Dependencies"]
      },
      {
        title: "Cloud Service Providers",
        description: "Risks from cloud service providers and SaaS companies",
        icon: "cloud",
        risks: ["Cloud service risks", "Data location", "Service availability"]
      }
    ],
    tprmProcess: [
      {
        title: "Risk Identification",
        description: "Identify third-party cybersecurity risks",
        icon: "search",
        steps: ["Vendor mapping", "Risk identification", "Threat analysis"]
      },
      {
        title: "Risk Assessment",
        description: "Assess risk probability and impact",
        icon: "chart-line",
        steps: ["Risk assessment", "Prioritization", "Risk matrix"]
      },
      {
        title: "Risk Treatment",
        description: "Plan and implement risk treatment",
        icon: "shield",
        steps: ["Action plan", "Risk mitigation", "Risk transfer"]
      },
      {
        title: "Risk Monitoring",
        description: "Monitor risk development and effectiveness",
        icon: "eye",
        steps: ["Continuous monitoring", "Reporting", "Evaluation"]
      }
    ],
    assessmentSteps: [
      {
        number: "01",
        title: "TPRM Assessment",
        description: "Assess current TPRM process and identify gaps"
      },
      {
        number: "02",
        title: "Gap Analysis",
        description: "Identify gaps and plan remediation measures"
      },
      {
        number: "03",
        title: "Planning",
        description: "Plan TPRM program and processes"
      },
      {
        number: "04",
        title: "Implementation",
        description: "Implement TPRM processes and tools"
      },
      {
        number: "05",
        title: "Monitoring",
        description: "Continuous TPRM process monitoring and improvement"
      }
    ],
    deliverables: {
      title: "What You Get",
      items: [
        "TPRM assessment report",
        "Risk management plan",
        "Vendor risk matrix",
        "TPRM processes",
        "Monitoring tools"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Identify third-party risks",
        "Reduce security risks",
        "Improve vendor management",
        "Meet regulatory requirements",
        "Strengthen cybersecurity resilience"
      ]
    }
  },
  fi: {
    title: "Kolmannen Osapuolen Riskit (TPRM)",
    subtitle: "Kolmannen Osapuolen Riskienhallinta",
    heroDescription: "Ammattimaiset kolmannen osapuolen riskien hallintapalvelut. Autamme organisaatioita hallitsemaan toimittajien ja kumppaneiden kyberturvariskejä.",
    forWho: "Organisaatioille, jotka haluavat hallita kyberturvariskejä toimittajilta, kumppaneilta ja kolmannen osapuolen palveluntarjoajilta.",
    achieve: "Kattava kolmannen osapuolen riskienhallinta systemaattisilla TPRM-prosesseilla ja kontrolleilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Kolmannen osapuolen riskienhallinta (TPRM) on prosessi, jolla tunnistetaan, arvioidaan ja vähennetään kolmannen osapuolen organisaatioiden aiheuttamia riskejä, mukaan lukien toimittajat, kumppanit ja palveluntarjoajat. Tehokas TPRM on olennaista organisaatiosi suojaamiseksi toimitusketjuun ja kumppaneihin liittyviltä riskeiltä.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia TPRM-palveluita auttaen sinua rakentamaan vahvan kolmannen osapuolen riskienhallintaohjelman ja vähentämään toimittajien ja kumppaneiden riskejä."
    },
    tprmCategories: [
      {
        title: "Toimittajien Riskit",
        description: "Toimittajien ja palveluntarjoajien kyberturvariskit",
        icon: "building",
        risks: ["Toimittajien haavoittuvuudet", "Tietojen paljastuminen", "Palvelun keskeytys"]
      },
      {
        title: "Kumppaneiden Riskit",
        description: "Liikekumppaneiden ja yhteistyökumppaneiden riskit",
        icon: "network",
        risks: ["Yhteistyön riskit", "Tietojen jakaminen", "Integraatiot"]
      },
      {
        title: "Toimitusketjun Riskit",
        description: "Toimitusketjun ja alihankkijoiden riskit",
        icon: "truck",
        risks: ["Alihankkijoiden riskit", "Toimitusketjun haavoittuvuudet", "Riippuvuudet"]
      },
      {
        title: "Cloud Palveluntarjoajat",
        description: "Pilvipalveluntarjoajien ja SaaS-yritysten riskit",
        icon: "cloud",
        risks: ["Pilvipalveluiden riskit", "Tietojen sijainti", "Palvelun saatavuus"]
      }
    ],
    tprmProcess: [
      {
        title: "Riskien Tunnistus",
        description: "Tunnistetaan kolmannen osapuolen kyberturvariskit",
        icon: "search",
        steps: ["Toimittajien kartoitus", "Riskien tunnistus", "Uhkien analyysi"]
      },
      {
        title: "Riskien Arviointi",
        description: "Arvioidaan riskien todennäköisyys ja vaikutus",
        icon: "chart-line",
        steps: ["Riskien arviointi", "Priorisointi", "Riskien matriisi"]
      },
      {
        title: "Riskien Käsittely",
        description: "Suunnitellaan ja toteutetaan riskien käsittely",
        icon: "shield",
        steps: ["Toimenpidesuunnitelma", "Riskien vähentäminen", "Riskien siirto"]
      },
      {
        title: "Riskien Seuranta",
        description: "Seurataan riskien kehitystä ja tehokkuutta",
        icon: "eye",
        steps: ["Jatkuva seuranta", "Raportointi", "Arviointi"]
      }
    ],
    assessmentSteps: [
      {
        number: "01",
        title: "TPRM Arviointi",
        description: "Arvioidaan nykyinen TPRM prosessi ja tunnistetaan puutteet"
      },
      {
        number: "02",
        title: "Aukkoanalyysi",
        description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot"
      },
      {
        number: "03",
        title: "Suunnittelu",
        description: "Suunnitellaan TPRM ohjelma ja prosessit"
      },
      {
        number: "04",
        title: "Toteutus",
        description: "Toteutetaan TPRM prosessit ja työkalut"
      },
      {
        number: "05",
        title: "Valvonta",
        description: "Jatkuva TPRM prosessien valvonta ja parantaminen"
      }
    ],
    deliverables: {
      title: "Mitä saat",
      items: [
        "TPRM arviointiraportti",
        "Riskienhallintasuunnitelma",
        "Toimittajien riskien matriisi",
        "TPRM prosessit",
        "Seurantatyökalut"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Tunnista kolmannen osapuolen riskit",
        "Vähennä tietoturvariskejä",
        "Paranna toimittajien hallintaa",
        "Täytä sääntelyvaatimukset",
        "Vahvista kyberturvan kestävyys"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- TPRM Categories Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {isFi ? 'TPRM Kategoriat' : 'TPRM Categories'}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {isFi
            ? "Kolmannen osapuolen riskit voidaan luokitella neljään pääkategoriaan."
            : "Third-party risks can be classified into four main categories."
          }
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.tprmCategories.map((category) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={category.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {category.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {category.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {category.risks.map((risk) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {risk}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TPRM Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {isFi ? 'TPRM Prosessi' : 'TPRM Process'}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {isFi
            ? "TPRM perustuu neljään pääprosessiin, jotka muodostavat kattavan riskienhallintajärjestelmän."
            : "TPRM is based on four main processes that form a comprehensive risk management system."
          }
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.tprmProcess.map((process) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={process.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {process.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {process.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {process.steps.map((step) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {step}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Assessment Steps Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {isFi ? 'Arviointivaiheet' : 'Assessment Steps'}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {isFi
            ? "Selkeä ja strukturoitu prosessi TPRM arviointiin ja toteutukseen."
            : "Clear and structured process for TPRM assessment and implementation."
          }
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.assessmentSteps.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
