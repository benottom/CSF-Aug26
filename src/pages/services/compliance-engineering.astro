---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const isFi = lang === 'fi';

const seo = {
  en: {
    title: "Compliance Engineering: NIS2, CRA & EUCC",
    description: "CRA compliance engineering — SBOM guidance, PSIRT and vulnerability-disclosure setup, secure development lifecycle, and technical documentation — plus NIS2 and EUCC support for EU organizations.",
    keywords: "compliance engineering, NIS2 compliance, CRA compliance, Cyber Resilience Act, EUCC certification, EU cybersecurity compliance, VAPT, secure code review, SBOM, PSIRT"
  },
  fi: {
    title: "Compliance Engineering: NIS2, CRA ja EUCC",
    description: "CRA-vaatimustenmukaisuuden toteutus — SBOM-ohjeistus, PSIRT- ja haavoittuvuuksien ilmoituskäytännöt, turvallinen ohjelmistokehitys ja tekninen dokumentaatio — sekä NIS2- ja EUCC-tuki EU-organisaatioille.",
    keywords: "compliance engineering, NIS2 vaatimustenmukaisuus, CRA vaatimustenmukaisuus, kyberkestävyyssäädös, EUCC-sertifiointi, kyberturvallisuus, haavoittuvuusskannaus, SBOM, PSIRT"
  }
};

// ProfessionalService JSON-LD, scoped to this service (site-wide Organization/LocalBusiness
// schema is already injected globally in Layout.astro — this augments it, it does not replace it)
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "Cyber Security Finland",
  "url": `https://cybersecurity.fi${currentPath}`,
  "logo": "https://cybersecurity.fi/csf-logo-2026.png",
  "image": "https://cybersecurity.fi/csf-logo-2026.png",
  "description": isFi ? seo.fi.description : seo.en.description,
  "serviceType": "Compliance Engineering",
  "areaServed": {
    "@type": "Place",
    "name": "European Union"
  },
  "knowsAbout": ["Compliance Engineering", "NIS2 Compliance", "CRA Compliance", "EUCC", "VAPT"],
  "provider": {
    "@type": "Organization",
    "name": "Cyber Security Finland"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+358 44 5040308",
    "email": "info@cybersecurity.fi",
    "contactType": "sales",
    "availableLanguage": ["English", "Finnish"]
  }
};

const content = {
  en: {
    h1: "Compliance Engineering for NIS2, CRA & EUCC",
    h2: "Audit-ready controls, engineered — not just documented",
    hero: "NIS2 and the Cyber Resilience Act reward evidence, not good intentions. We engineer the technical controls, risk management processes, and audit trails you need to satisfy NIS2 Article 21, CRA essential requirements, and EUCC criteria. NIS2, CRA, and EUCC are our core areas of depth: we work inside your stack on vulnerability handling, secure development lifecycle, and technical documentation that produces defensible evidence, not shelfware.",
    ctaPrimary: "Request a Compliance Assessment",
    ctaSecondary: "Explore Compliance Services",
    trustTitle: "Engineering-Led Compliance for NIS2, CRA & EUCC",
    trustSubtitle: "We connect regulatory requirements to governance, architecture, technical controls and evidence — not just policy documents.",
    cards: [
      {
        title: "NIS2 Readiness",
        body: "We map your risk management, incident reporting, and supply-chain controls directly to NIS2 Article 21. Gap analysis and remediation are engineered together, not handed off in a slide deck."
      },
      {
        title: "CRA Compliance",
        body: "SBOM guidance, PSIRT and coordinated vulnerability disclosure setup, secure development lifecycle practices, and the technical documentation the Cyber Resilience Act requires — built with you before your product reaches the EU market."
      },
      {
        title: "EUCC Support",
        body: "Incident response setup, gap analysis, and hands-on help meeting European Cybersecurity Certification Scheme (EUCC) requirements — one of our strongest areas alongside NIS2 and CRA."
      }
    ],
    craSection: {
      title: "CRA Capabilities We Deliver Today",
      subtitle: "Product security and vulnerability-handling work we're already doing for EU organizations",
      items: [
        { title: "SBOM Guidance", body: "Software bill of materials practices to meet CRA transparency and component-tracking expectations." },
        { title: "PSIRT & Vulnerability Disclosure", body: "Setting up a Product Security Incident Response Team function and coordinated vulnerability disclosure (CVD) processes." },
        { title: "Secure Development Lifecycle", body: "Embedding security requirements, review gates, and vulnerability handling into your existing development process." },
        { title: "Technical Documentation", body: "Building the technical documentation and evidence trail CRA conformity assessment expects." }
      ]
    },
    euccSection: {
      title: "EUCC Support We Deliver Today",
      subtitle: "Helping organizations meet European Cybersecurity Certification Scheme requirements",
      items: [
        { title: "Incident Response", body: "Setting up incident response processes aligned to EUCC expectations." },
        { title: "Gap Analysis", body: "Identifying where current controls and evidence fall short of EUCC requirements." },
        { title: "Requirement Support", body: "Hands-on help closing the gaps identified, ahead of formal evaluation." }
      ]
    },
    disclaimer: "This describes our cybersecurity and compliance engineering work — not regulated legal advice. For legal interpretation of CRA, NIS2, or EUCC obligations, we work alongside your legal counsel or partner firms."
  },
  fi: {
    h1: "Compliance Engineering NIS2-, CRA- ja EUCC-vaatimuksiin",
    h2: "Auditointivalmiit kontrollit — ei vain dokumentteja",
    hero: "NIS2 ja kyberkestävyyssäädös (CRA) palkitsevat näyttöä, eivät hyviä aikeita. Suunnittelemme tekniset kontrollit, riskienhallintaprosessit ja auditointijäljet, joita tarvitset täyttääksesi NIS2:n 21 artiklan, CRA:n olennaiset vaatimukset ja EUCC-kriteerit. NIS2, CRA ja EUCC ovat vahvinta osaamisaluettamme: työskentelemme järjestelmässäsi haavoittuvuuksien hallinnan, turvallisen ohjelmistokehityksen ja teknisen dokumentaation parissa, jotka tuottavat puolustettavaa näyttöä.",
    ctaPrimary: "Pyydä vaatimustenmukaisuusarviointi",
    ctaSecondary: "Tutustu palveluihin",
    trustTitle: "Insinöörivetoista vaatimustenmukaisuutta NIS2:lle, CRA:lle ja EUCC:lle",
    trustSubtitle: "Kytkemme sääntelyvaatimukset hallintoon, arkkitehtuuriin, teknisiin kontrolleihin ja näyttöön – emme vain käytäntödokumentteihin.",
    cards: [
      {
        title: "NIS2-valmius",
        body: "Kartoitamme riskienhallintasi, häiriöilmoitusprosessisi ja toimitusketjun kontrollit suoraan NIS2:n 21 artiklaan. Aukkoanalyysi ja korjaustoimet suunnitellaan yhdessä – ei erillisenä diaesityksenä."
      },
      {
        title: "CRA-vaatimustenmukaisuus",
        body: "SBOM-ohjeistus, PSIRT- ja koordinoidun haavoittuvuuksien ilmoituskäytännön käyttöönotto, turvallinen ohjelmistokehityksen elinkaari ja kyberkestävyyssäädöksen edellyttämä tekninen dokumentaatio – rakennettuna yhdessä kanssasi ennen tuotteesi tuloa EU:n markkinoille."
      },
      {
        title: "EUCC-tuki",
        body: "Poikkeamanhallinnan käyttöönotto, aukkoanalyysi ja käytännön apu eurooppalaisen kyberturvallisuuden sertifiointijärjestelmän (EUCC) vaatimusten täyttämisessä – yksi vahvimmista osaamisalueistamme NIS2:n ja CRA:n ohella."
      }
    ],
    craSection: {
      title: "CRA-osaaminen jota tarjoamme jo nyt",
      subtitle: "Tuoteturvallisuus- ja haavoittuvuudenhallintatyötä, jota teemme jo EU-organisaatioille",
      items: [
        { title: "SBOM-ohjeistus", body: "Ohjelmiston osaluettelokäytännöt CRA:n läpinäkyvyys- ja komponenttiseurantavaatimusten täyttämiseksi." },
        { title: "PSIRT ja haavoittuvuuksien ilmoittaminen", body: "Product Security Incident Response Team -toiminnon ja koordinoidun haavoittuvuuksien ilmoituskäytännön (CVD) käyttöönotto." },
        { title: "Turvallinen ohjelmistokehityksen elinkaari", body: "Turvallisuusvaatimusten, katselmointipisteiden ja haavoittuvuuksien hallinnan sisällyttäminen nykyiseen kehitysprosessiisi." },
        { title: "Tekninen dokumentaatio", body: "CRA:n vaatimustenmukaisuuden arvioinnin edellyttämän teknisen dokumentaation ja näyttöketjun rakentaminen." }
      ]
    },
    euccSection: {
      title: "EUCC-tuki jota tarjoamme jo nyt",
      subtitle: "Autamme organisaatioita täyttämään eurooppalaisen kyberturvallisuuden sertifiointijärjestelmän vaatimukset",
      items: [
        { title: "Poikkeamanhallinta", body: "EUCC-odotusten mukaisten poikkeamanhallintaprosessien käyttöönotto." },
        { title: "Aukkoanalyysi", body: "Nykyisten kontrollien ja näytön puutteiden tunnistaminen suhteessa EUCC-vaatimuksiin." },
        { title: "Vaatimustenmukaisuustuki", body: "Käytännön apu tunnistettujen puutteiden korjaamiseen ennen virallista arviointia." }
      ]
    },
    disclaimer: "Tämä kuvaa kyberturvallisuus- ja vaatimustenmukaisuustyötämme – ei säänneltyä oikeudellista neuvontaa. CRA:n, NIS2:n tai EUCC:n velvoitteiden oikeudellisessa tulkinnassa teemme yhteistyötä lakiasiantuntijasi tai kumppaniyritysten kanssa."
  }
};

const c = content[lang];
---

<Layout
  title={seo[lang].title}
  description={seo[lang].description}
  keywords={seo[lang].keywords}
  schema={schema}
  type="service"
>
  <style>
    /* Lexend is now loaded sitewide in Layout.astro; only the grid background is page-specific. */
    .ce-grid {
      background-image:
        linear-gradient(to right, rgba(20, 23, 26, 0.06) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(20, 23, 26, 0.06) 1px, transparent 1px);
      background-size: 40px 40px;
    }
  </style>

  <!-- ============ HERO ============ -->
  <section class="ce-lexend ce-grid relative overflow-hidden bg-[#f4f1ea] py-8 md:py-12 border-b border-slate-200">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[#131c2e] shadow-sm">
            <span class="h-1.5 w-1.5 rounded-full bg-[#DC2626]"></span>
            {isFi ? 'NIS2 · CRA · EUCC' : 'NIS2 · CRA · EUCC'}
          </span>

          <h1 class="mt-6 text-4xl sm:text-5xl font-extrabold tracking-tight text-[#131c2e] leading-[1.05]">
            {c.h1}
          </h1>

          <h2 class="mt-5 text-lg md:text-xl font-medium text-[#14171a]">
            {c.h2}
          </h2>

          <p class="mt-6 text-base md:text-lg text-slate-600 leading-relaxed">
            {c.hero}
          </p>

          <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
            <Button href={isFi ? '/fi/contact' : '/contact'} variant="primary" size="lg" className="!rounded-md !font-bold !tracking-tight">
              {c.ctaPrimary}
            </Button>
            <Button href={isFi ? '/fi/services' : '/services'} variant="secondary" size="lg" className="!rounded-md !font-bold !tracking-tight">
              {c.ctaSecondary}
            </Button>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-2 border border-slate-300 rounded-lg hidden lg:block"></div>
          <img
            src="/images/services/eu-compliance-frankfurt.jpg"
            alt="European Central Bank district, Frankfurt — the seat of EU financial and regulatory institutions"
            class="relative rounded-lg shadow-[0_8px_30px_rgba(20,23,26,0.12)] w-full h-[320px] md:h-[420px] object-cover"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ E-E-A-T TRUST BANNER ============ -->
  <section class="ce-lexend py-16 md:py-20 bg-[#ece7db] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h3 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#131c2e]">
          {c.trustTitle}
        </h3>
        <p class="mt-3 text-base text-slate-600 leading-relaxed">
          {c.trustSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.cards.map((card) => (
          <div class="bg-white rounded-lg border border-slate-200 shadow-[0_1px_2px_rgba(20,23,26,0.06)] hover:shadow-[0_8px_24px_rgba(20,23,26,0.08)] transition-shadow duration-200 p-6 md:p-7">
            <div class="w-10 h-10 rounded-md bg-[#131c2e] flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h4 class="text-base font-bold tracking-tight text-[#131c2e] mb-2">
              {card.title}
            </h4>
            <p class="text-sm text-slate-600 leading-relaxed">
              {card.body}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CRA DEPTH SECTION ============ -->
  <section class="ce-lexend py-16 md:py-20 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h3 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#131c2e]">
          {c.craSection.title}
        </h3>
        <p class="mt-3 text-base text-slate-600 leading-relaxed">
          {c.craSection.subtitle}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {c.craSection.items.map((item) => (
          <div class="bg-[#ece7db] rounded-lg border border-slate-200 p-6 md:p-7">
            <h4 class="text-base font-bold tracking-tight text-[#131c2e] mb-2">{item.title}</h4>
            <p class="text-sm text-slate-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EUCC DEPTH SECTION ============ -->
  <section class="ce-lexend py-16 md:py-20 bg-[#ece7db] border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h3 class="text-2xl md:text-3xl font-extrabold tracking-tight text-[#131c2e]">
          {c.euccSection.title}
        </h3>
        <p class="mt-3 text-base text-slate-600 leading-relaxed">
          {c.euccSection.subtitle}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {c.euccSection.items.map((item) => (
          <div class="bg-white rounded-lg border border-slate-200 p-6 md:p-7">
            <h4 class="text-base font-bold tracking-tight text-[#131c2e] mb-2">{item.title}</h4>
            <p class="text-sm text-slate-600 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ DISCLAIMER + CTA ============ -->
  <section class="ce-lexend py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xs text-slate-500 leading-relaxed max-w-2xl mx-auto mb-8">
        {c.disclaimer}
      </p>
      <Button href={isFi ? '/fi/contact' : '/contact'} variant="primary" size="lg" className="!rounded-md !font-bold !tracking-tight">
        {c.ctaPrimary}
      </Button>
    </div>
  </section>
</Layout>
