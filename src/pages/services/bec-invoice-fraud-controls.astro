---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "BEC/Invoice Fraud Controls";

const content = {
  en: {
    title: "BEC/Invoice Fraud",
    subtitle: "Business Email Compromise Protection",
    heroDescription: "Prevent BEC and invoice fraud with process, technology and people controls. Multi-layered protection against Business Email Compromise and invoice fraud.",
    forWho: "For organizations seeking to protect against Business Email Compromise and invoice fraud through multi-layered controls.",
    achieve: "Comprehensive BEC and invoice fraud protection with technical, process, and human controls.",
    overview: {
      title: "Overview",
      description: "Business Email Compromise (BEC) and invoice fraud are among the most costly and fastest-growing fraud threats facing organizations today. Attackers use sophisticated social engineering and technical techniques to deceive employees and manipulate payment processes.",
      highlight: "Our expert team provides comprehensive BEC and invoice fraud protection services, implementing multi-layered controls across technology, processes, and people to prevent financial fraud."
    },
    controls: {
      title: "BEC/Invoice Fraud Controls",
      subtitle: "Multi-layered protection against Business Email Compromise and invoice fraud.",
      items: [
        { title: "Dual-Control Approvals", description: "Four-eyes principle for all payments and vendor detail changes", icon: "user" },
        { title: "Payment Communication Checks", description: "Email origin and authenticity verification", icon: "mail" },
        { title: "Domain & SPF/DMARC", description: "Technical protection against domain spoofing", icon: "lock" },
        { title: "Call-Back & Verification", description: "Phone verification for changes and large payments", icon: "document" }
      ]
    },
    scenarios: {
      title: "Common BEC Scenarios",
      subtitle: "Know the most common attacker tactics and build protection against them.",
      items: [
        { title: "CEO Fraud", description: "False payment requests using executive credentials", icon: "alert-triangle" },
        { title: "Vendor Impersonation", description: "Banking detail changes for existing vendors", icon: "mail" },
        { title: "Fraudulent Invoices", description: "Fake invoices for non-existent orders", icon: "file-text" },
        { title: "Phone Manipulation", description: "Phone fraud supporting payment requests", icon: "phone" }
      ]
    },
    layers: {
      title: "Protection Layers",
      subtitle: "Effective BEC protection requires combining technical, process, and human controls.",
      items: [
        {
          title: "Technical Protection",
          icon: "shield",
          features: ["SPF/DKIM/DMARC configuration", "Anti-spoofing filters", "Email scanners", "Anomaly detection"]
        },
        {
          title: "Process Controls",
          icon: "clipboard",
          features: ["Four-eyes payment approval", "Vendor data locking", "Change process verification", "Payment limit controls"]
        },
        {
          title: "Staff Training",
          icon: "users",
          features: ["BEC simulations", "Verification procedures", "Reporting channels", "Regular updates"]
        }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Systematic approach to building BEC protection.",
      items: [
        { number: "01", title: "Threat Analysis", description: "BEC scenario mapping" },
        { number: "02", title: "Process Review", description: "Payment process assessment" },
        { number: "03", title: "Technical Testing", description: "Spoofing and phishing tests" },
        { number: "04", title: "Control Design", description: "Multi-layered control design" },
        { number: "05", title: "Implementation", description: "Control implementation and training" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "BEC threat assessment report",
        "Payment process review",
        "Technical controls implementation",
        "Process controls framework",
        "Staff training program",
        "BEC simulation results",
        "Control monitoring plan",
        "Incident response procedures"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Reduced BEC and invoice fraud risk",
        "Protected financial assets",
        "Enhanced payment process security",
        "Improved employee awareness",
        "Regulatory compliance assurance"
      ]
    }
  },
  fi: {
    title: "BEC/Laskupetokset",
    subtitle: "Business Email Compromise -suojaus",
    heroDescription: "Estä sähköpostin kaappaukset ja laskupetokset prosessi‑, teknologia‑ ja ihmiskontrolleilla. Monikerroksinen suojaus Business Email Compromise ja laskupetoksia vastaan.",
    forWho: "Organisaatioille, jotka haluavat suojautua Business Email Compromise -petoksilta ja laskupetoksilta monikerroksisilla kontrolleilla.",
    achieve: "Kattava BEC- ja laskupetossuoja teknisillä, prosessuaalisilla ja henkilöstökontrolleilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Business Email Compromise (BEC) ja laskupetokset ovat organisaatioiden kalleimpia ja nopeimmin kasvavia petosuhkia. Hyökkääjät käyttävät kehittyneitä sosiaalisen manipuloinnin ja teknisiä tekniikoita huijatakseen työntekijöitä ja manipuloidakseen maksuprosesseja.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia BEC- ja laskupetossuojauspalveluita toteuttaen monikerroksisia kontrolleja teknologian, prosessien ja ihmisten välillä taloudellisten petosten estämiseksi."
    },
    controls: {
      title: "BEC/Laskupetosten kontrollit",
      subtitle: "Monikerroksinen suojaus Business Email Compromise ja laskupetoksia vastaan.",
      items: [
        { title: "Kaksivaiheinen vahvistus", description: "Nelisilmäperiaate kaikille maksuille ja toimittajatietojen muutoksille", icon: "user" },
        { title: "Maksuviestien tarkistukset", description: "Sähköpostiviestien alkuperän ja aitouden varmistaminen", icon: "mail" },
        { title: "Domain & SPF/DMARC", description: "Tekninen suojaus domain-väärentämistä vastaan", icon: "lock" },
        { title: "Soittopaluu & todentaminen", description: "Puhelinvahvistus muutoksille ja suurille maksuille", icon: "document" }
      ]
    },
    scenarios: {
      title: "Yleisimmät BEC-skenaariot",
      subtitle: "Tunne hyökkääjien yleisimmät taktikat ja rakenna suojaus niitä vastaan.",
      items: [
        { title: "CEO Fraud", description: "Johdon tunnuksilla tehdyt väärät maksupyynnöt", icon: "alert-triangle" },
        { title: "Toimittajan kaappaus", description: "Olemassa olevan toimittajan pankkitietojen vaihto", icon: "mail" },
        { title: "Väärät laskut", description: "Väärennetyt laskut olemattomista tilauksista", icon: "file-text" },
        { title: "Puhelinmanipulointi", description: "Puhelinpetokset maksupyyntöjen tueksi", icon: "phone" }
      ]
    },
    layers: {
      title: "Suojauskerrokset",
      subtitle: "Tehokas BEC-suojaus vaatii teknisten, prosessuaalisten ja henkilöstöön liittyvien kontrollien yhdistämistä.",
      items: [
        {
          title: "Tekninen suojaus",
          icon: "shield",
          features: ["SPF/DKIM/DMARC konfigurointi", "Anti-spoofing suodattimet", "Sähköpostiskannerit", "Anomalianseuranta"]
        },
        {
          title: "Prosessikontrollit",
          icon: "clipboard",
          features: ["Nelisilmäperiaate maksuille", "Toimittajatietojen lukitseminen", "Muutosprosessien vahvistus", "Maksurajojen asettaminen"]
        },
        {
          title: "Henkilöstökoulutus",
          icon: "users",
          features: ["BEC-simulaatiot", "Varmistusprosessit", "Raportointikanavat", "Säännöllinen päivitys"]
        }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Systemaattinen lähestymistapa BEC-suojauksen rakentamiseen.",
      items: [
        { number: "01", title: "Uhka-analyysi", description: "BEC-skenaarioiden kartoitus" },
        { number: "02", title: "Prosessikatsaus", description: "Maksuprosessien arviointi" },
        { number: "03", title: "Tekninen testaus", description: "Spoofing ja phishing-testit" },
        { number: "04", title: "Kontrollisuunnittelu", description: "Monikerroksisten kontrollien suunnittelu" },
        { number: "05", title: "Käyttöönotto", description: "Kontrollien käyttöönotto ja koulutus" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "BEC-uhka-arviointiraportti",
        "Maksuprosessien katsaus",
        "Teknisten kontrollien toteutus",
        "Prosessikontrollien kehys",
        "Henkilöstön koulutusohjelma",
        "BEC-simulaation tulokset",
        "Kontrollien seurantasuunnitelma",
        "Tapahtumien hallintamenettelyt"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Vähentynyt BEC- ja laskupetosriski",
        "Suojatut taloudelliset varat",
        "Parannettu maksuprosessien turvallisuus",
        "Parantunut työntekijöiden tietoisuus",
        "Sääntelyvaatimusten noudattamisen varmistus"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-blue-50 rounded-2xl border-2 border-[#003580] shadow-lg p-6 md:p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#003580] rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl md:text-2xl font-bold text-[#131c2e]">{currentContent.overview.title}</h2>
        </div>
        <p class="text-slate-700 leading-relaxed mb-4 pl-14">{currentContent.overview.description}</p>
        <div class="bg-white/70 rounded-xl border border-[#003580]/30 p-4 pl-14">
          <p class="text-[#131c2e] font-semibold flex items-start gap-2">
            <svg class="w-5 h-5 text-[#003580] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {currentContent.overview.highlight}
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Controls Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.controls.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.controls.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.controls.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BEC Scenarios Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.scenarios.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.scenarios.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.scenarios.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Protection Layers Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.layers.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.layers.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.layers.items.map((layer, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={layer.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-8 h-8 bg-[#003580] rounded-lg flex items-center justify-center text-white font-bold text-xs">
                {index + 1}
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10 text-center">
              {layer.title}
            </h3>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {layer.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>