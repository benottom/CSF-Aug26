---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Governance & Strategy";

const content = {
  en: {
    title: "Governance & Strategy",
    subtitle: "Build robust security governance frameworks",
    heroDescription: "Professional governance and strategy services to build robust security governance frameworks. We help organizations establish effective security governance structures.",
    forWho: "For organizations seeking to build robust security governance frameworks and strategic security direction.",
    achieve: "Effective security governance with clear policies, business continuity, and audit readiness.",
    overview: {
      title: "Overview",
      description: "Security governance and strategy provide the foundation for effective information security management. A robust governance framework ensures clear accountability, informed decision-making, and sustainable security practices that align with business objectives.",
      highlight: "Our expert team provides comprehensive governance and strategy services, helping you build robust security frameworks that drive continuous improvement and demonstrate compliance."
    },
    services: {
      title: "Our Services",
      subtitle: "Comprehensive governance and strategy services for your organization",
      items: [
        {
          title: "Policy Governance",
          icon: "document",
          description: "Develop and maintain a clear policy architecture with ownership, lifecycle, and compliance mapping.",
          features: ["Policy framework design", "Ownership and accountability", "Lifecycle management", "Compliance mapping"]
        },
        {
          title: "Business Continuity",
          icon: "refresh-cw",
          description: "Design and operate a BCMS: BIA, continuity strategies, plans, exercises, and continual improvement.",
          features: ["Business impact analysis", "Continuity strategies", "Plan development", "Exercises and testing"]
        },
        {
          title: "Audit Preparation",
          icon: "clipboard",
          description: "Prepare for internal and external audits with evidence readiness and remediation tracking.",
          features: ["Evidence management", "Remediation tracking", "Audit liaison", "Readiness assessment"]
        }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Structured approach to building security governance frameworks.",
      items: [
        { number: "01", title: "Assessment", description: "Assess current governance and identify gaps" },
        { number: "02", title: "Framework Design", description: "Design governance framework and strategy" },
        { number: "03", title: "Implementation", description: "Implement policies, processes, and controls" },
        { number: "04", title: "Monitoring", description: "Continuous monitoring and improvement" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Governance framework assessment",
        "Policy architecture and documentation",
        "Business continuity strategy and plans",
        "Audit readiness assessment",
        "Evidence management framework",
        "Remediation tracking system",
        "Staff training materials",
        "Ongoing governance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Clear accountability and decision-making",
        "Compliance with regulatory requirements",
        "Improved risk management",
        "Enhanced stakeholder confidence",
        "Sustainable security practices"
      ]
    }
  },
  fi: {
    title: "Hallinta & Strategia",
    subtitle: "Rakenna vankkoja turvallisuushallintakehyksiä",
    heroDescription: "Ammattimaiset hallinta- ja strategiapalvelut vankkojen turvallisuushallintakehysten rakentamiseen. Autamme organisaatioita luomaan tehokkaita turvallisuushallintarakenteita.",
    forWho: "Organisaatioille, jotka haluavat rakentaa vankkoja turvallisuushallintakehyksiä ja strategista turvallisuussuuntausta.",
    achieve: "Tehokas turvallisuushallinta selkeillä politiikoilla, liiketoiminnan jatkuvuudella ja auditointivalmiudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "Turvallisuushallinta ja strategia luovat perustan tehokkaalle tietoturvallisuuden hallinnalle. Vankka hallintakehys varmistaa selkeän vastuullisuuden, tietoon perustuvan päätöksenteon ja kestävät turvallisuuskäytännöt, jotka ovat liiketoiminnan tavoitteiden mukaisia.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia hallinta- ja strategiapalveluita auttaen sinua rakentamaan vankkoja turvallisuuskehyksiä, jotka ohjaavat jatkuvaa parantamista ja osoittavat vaatimustenmukaisuutta."
    },
    services: {
      title: "Palvelumme",
      subtitle: "Kattavat hallinta- ja strategiapalvelut organisaatiollesi",
      items: [
        {
          title: "Politiikkahallinta",
          icon: "document",
          description: "Kehitä ja ylläpidä selkeää politiikka-arkkitehtuuria omistajuudella, elinkaaressa ja compliance-kartoituksella.",
          features: ["Politiikkakehyksen suunnittelu", "Omistajuus ja vastuullisuus", "Elinkaaren hallinta", "Vaatimustenmukaisuuden kartoitus"]
        },
        {
          title: "Liiketoiminnan Jatkuvuus",
          icon: "refresh-cw",
          description: "Suunnittele ja operoi BCMS: BIA, jatkuvuusstrategiat, suunnitelmat, harjoitukset ja jatkuva parantaminen.",
          features: ["Liiketoimintavaikutusanalyysi", "Jatkuvuusstrategiat", "Suunnitelmien kehitys", "Harjoitukset ja testaus"]
        },
        {
          title: "Auditointivalmistelu",
          icon: "clipboard",
          description: "Valmistaudu sisäisiin ja ulkoisiin auditointeihin todistevalmiudella ja korjaustoimien seurannalla.",
          features: ["Todisteiden hallinta", "Korjaustoimien seuranta", "Auditointiyhteistyö", "Valmiusarviointi"]
        }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa turvallisuushallintakehysten rakentamiseen.",
      items: [
        { number: "01", title: "Arviointi", description: "Arvioidaan nykyinen hallinta ja tunnistetaan puutteet" },
        { number: "02", title: "Kehyksen Suunnittelu", description: "Suunnitellaan hallintakehys ja strategia" },
        { number: "03", title: "Toteutus", description: "Toteutetaan politiikat, prosessit ja kontrollit" },
        { number: "04", title: "Valvonta", description: "Jatkuva seuranta ja parantaminen" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Hallintakehyksen arviointi",
        "Politiikka-arkkitehtuuri ja dokumentaatio",
        "Liiketoiminnan jatkuvuusstrategia ja -suunnitelmat",
        "Auditointivalmiusarviointi",
        "Todisteiden hallintakehys",
        "Korjaustoimien seurantajärjestelmä",
        "Henkilöstön koulutusmateriaalit",
        "Jatkuva hallintatuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Selkeä vastuullisuus ja päätöksenteko",
        "Sääntelyvaatimusten noudattaminen",
        "Parantunut riskienhallinta",
        "Parantunut sidosryhmien luottamus",
        "Kestävät turvallisuuskäytännöt"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#3B82F6] p-4 rounded-r-lg">
          <p class="text-[#1E2A7A] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>
  <!-- Services Section -->
  <section id="services" class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10 text-center">
              {service.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {service.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:border-[#3B82F6] transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {service.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>