---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Policy Development and Governance";

const content = {
  en: {
    title: "Policy Development",
    subtitle: "Unified Security Policy Library",
    heroDescription: "Unified policy library, ownership, and governance that meets ISO 27001, NIS2, SOC 2, and GDPR. Comprehensive policy development services for your organization.",
    forWho: "For organizations seeking a unified policy library and governance framework that meets international standards.",
    achieve: "Comprehensive policy library with clear ownership, governance, and compliance alignment.",
    overview: {
      title: "Overview",
      description: "Security policies are the foundation of an effective information security program. A unified policy library with clear ownership, governance, and compliance alignment ensures consistent security practices across your organization.",
      highlight: "Our expert team provides comprehensive policy development and governance services, helping you build a unified policy library that meets ISO 27001, NIS2, SOC 2, and GDPR requirements."
    },
    policies: {
      title: "Core Policies",
      subtitle: "Comprehensive policy library that meets international standards and regulations.",
      items: [
        { title: "Information Security Policy", description: "High-level information security principles and objectives", icon: "document" },
        { title: "Access Control Policy", description: "Access rights management and monitoring", icon: "user" },
        { title: "Cryptography Policy", description: "Encryption requirements and key management", icon: "lock" },
        { title: "Cloud Security Policy", description: "Cloud service security requirements", icon: "cloud" },
        { title: "Supplier Management Policy", description: "Third-party risk management", icon: "building" },
        { title: "Incident Response Policy", description: "Security incident handling", icon: "alert-triangle" }
      ]
    },
    governance: {
      title: "Governance Model",
      subtitle: "Clear roles, responsibilities and processes for policy lifecycle management.",
      items: [
        { title: "Roles & Responsibilities", description: "Policy ownership and maintenance responsibility", icon: "users" },
        { title: "Update Cycle", description: "Regular reviews and updates", icon: "calendar" },
        { title: "Training & Communication", description: "Staff training and communication", icon: "book-open" },
        { title: "Compliance Monitoring", description: "Policy compliance monitoring", icon: "shield-check" }
      ]
    },
    categories: {
      title: "Policy Categories",
      subtitle: "Structured approach to comprehensive policy library.",
      items: [
        { title: "Organizational", icon: "building", policies: ["Information Security Policy", "Risk Management Policy", "Business Continuity", "Personnel Security Policy"] },
        { title: "Technical Policies", icon: "cpu", policies: ["Access Control Policy", "Cryptography Policy", "Network Security Policy", "Anti-malware Policy"] },
        { title: "Operational Policies", icon: "clipboard", policies: ["Incident Response Policy", "Change Management", "Backup Policy", "Monitoring Policy"] }
      ]
    },
    process: {
      title: "Development Process",
      subtitle: "Systematic approach to policy development and maintenance.",
      items: [
        { number: "01", title: "Framework", description: "Select framework and scope" },
        { number: "02", title: "Drafts", description: "Draft policies and ownership" },
        { number: "03", title: "Approval", description: "Management approval and publishing" },
        { number: "04", title: "Rollout", description: "Training and rollout" },
        { number: "05", title: "Maintenance", description: "Periodic updates" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Unified policy library",
        "Policy ownership framework",
        "Governance model documentation",
        "Policy lifecycle procedures",
        "Staff training materials",
        "Compliance monitoring framework",
        "Update and review schedule",
        "Ongoing governance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Unified policy framework",
        "Clear ownership and accountability",
        "Compliance with international standards",
        "Consistent security practices",
        "Improved audit readiness"
      ]
    }
  },
  fi: {
    title: "Politiikkakehitys",
    subtitle: "Yhtenäinen turvallisuuspolitiikkakirjasto",
    heroDescription: "Yhtenäinen politiikkakirjasto, omistajuudet ja hallintamalli, joka täyttää standardit (ISO 27001, NIS2, SOC 2, GDPR). Kattavat politiikan kehityspalvelut organisaatiollesi.",
    forWho: "Organisaatioille, jotka tarvitsevat yhtenäisen politiikkakirjaston ja hallintamallin, joka täyttää kansainväliset standardit.",
    achieve: "Kattava politiikkakirjasto selkeällä omistajuudella, hallintamallilla ja vaatimustenmukaisuudella.",
    overview: {
      title: "Yleiskatsaus",
      description: "Turvallisuuspolitiikat ovat tehokkaan tietoturvaohjelman perusta. Yhtenäinen politiikkakirjasto selkeällä omistajuudella, hallintamallilla ja vaatimustenmukaisuudella varmistaa yhtenäiset turvallisuuskäytännöt koko organisaatiossasi.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia politiikkakehitys- ja hallintapalveluita auttaen sinua rakentamaan yhtenäisen politiikkakirjaston, joka täyttää ISO 27001, NIS2, SOC 2 ja GDPR -vaatimukset."
    },
    policies: {
      title: "Keskeisimmät politiikat",
      subtitle: "Kattava politiikkakirjasto, joka täyttää kansainväliset standardit ja säädökset.",
      items: [
        { title: "Tietoturvapolitiikka", description: "Ylätason tietoturvaperiaatteet ja tavoitteet", icon: "document" },
        { title: "Käyttöoikeuspolitiikka", description: "Käyttöoikeuksien hallinta ja valvonta", icon: "user" },
        { title: "Salauspolitiikka", description: "Salausvaatimukset ja avainten hallinta", icon: "lock" },
        { title: "Pilvipolitiikka", description: "Pilvipalveluiden turvallisuusvaatimukset", icon: "cloud" },
        { title: "Toimittajahallinnan politiikka", description: "Kolmannen osapuolen riskienhallinta", icon: "building" },
        { title: "Vikatilanteiden hallinta", description: "Tietoturvapoikkeamien käsittely", icon: "alert-triangle" }
      ]
    },
    governance: {
      title: "Hallintamalli",
      subtitle: "Selkeät roolit, vastuut ja prosessit politiikkojen elinkaaren hallintaan.",
      items: [
        { title: "Roolit & vastuut", description: "Politiikkojen omistajuus ja ylläpitovastuu", icon: "users" },
        { title: "Päivityssykli", description: "Säännölliset katselmukset ja päivitykset", icon: "calendar" },
        { title: "Koulutus & viestintä", description: "Henkilöstön koulutus ja tiedottaminen", icon: "book-open" },
        { title: "Compliance-seuranta", description: "Politiikkojen noudattamisen valvonta", icon: "shield-check" }
      ]
    },
    categories: {
      title: "Politiikkakategoriat",
      subtitle: "Strukturoitu lähestymistapa kattavaan politiikkakirjastoon.",
      items: [
        { title: "Organisaatioon liittyvät", icon: "building", policies: ["Tietoturvapolitiikka", "Riskienhallintapolitiikka", "Liiketoiminnan jatkuvuus", "Henkilöstöturvapolitiikka"] },
        { title: "Tekniset politiikat", icon: "cpu", policies: ["Käyttöoikeuspolitiikka", "Salauspolitiikka", "Verkkoturvapolitiikka", "Haittaohjelmien torjunta"] },
        { title: "Operatiiviset politiikat", icon: "clipboard", policies: ["Vikatilanteiden hallinta", "Muutoshallinta", "Varmuuskopiointipolitiikka", "Valvontapolitiikka"] }
      ]
    },
    process: {
      title: "Kehitysprosessi",
      subtitle: "Systemaattinen lähestymistapa politiikkojen kehittämiseen ja ylläpitoon.",
      items: [
        { number: "01", title: "Kehys", description: "Valitaan viitekehys ja laajuus" },
        { number: "02", title: "Luonnokset", description: "Luodaan politiikat ja omistajuudet" },
        { number: "03", title: "Hyväksyntä", description: "Johdon hyväksyntä ja julkaisu" },
        { number: "04", title: "Käyttöönotto", description: "Koulutus ja jalkautus" },
        { number: "05", title: "Ylläpito", description: "Säännölliset päivitykset" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Yhtenäinen politiikkakirjasto",
        "Politiikkojen omistajuuskehys",
        "Hallintamallin dokumentaatio",
        "Politiikkojen elinkaaren menettelyt",
        "Henkilöstön koulutusmateriaalit",
        "Compliance-seurannan kehys",
        "Päivitys- ja katselmointiaikataulu",
        "Jatkuva hallintatuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Yhtenäinen politiikkakehys",
        "Selkeä omistajuus ja vastuullisuus",
        "Kansainvälisten standardien noudattaminen",
        "Yhtenäiset turvallisuuskäytännöt",
        "Parantunut auditointivalmius"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Policies Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.policies.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.policies.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.policies.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governance Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.governance.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.governance.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.governance.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.categories.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.categories.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.categories.items.map((cat, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={cat.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-8 h-8 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-lg flex items-center justify-center text-white font-bold text-xs">
                {index + 1}
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-3 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10 text-center">
              {cat.title}
            </h3>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:border-[#3B82F6] transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {cat.policies.map((policy) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {policy}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>