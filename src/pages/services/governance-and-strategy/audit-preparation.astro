---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Audit Preparation";

const content = {
  en: {
    title: "Audit Preparation",
    subtitle: "Evidence Management & Compliance Readiness",
    heroDescription: "Ensure smooth and successful audit processes with evidence management, control documentation, and systematic preparation.",
    forWho: "For organizations preparing for ISO 27001, SOC 2, PCI DSS, GDPR, and other compliance audits.",
    achieve: "Full audit readiness with comprehensive evidence management, control documentation, and systematic preparation.",
    components: {
      title: "Audit Preparation Components",
      subtitle: "Comprehensive approach to ensuring audit readiness through four core elements",
      items: [
        { title: "Evidence Management", description: "Audit evidence collection, organization, and management", icon: "folder" },
        { title: "Control Narratives", description: "Detailed process and control documentation", icon: "file-text" },
        { title: "Gap Remediation", description: "Systematic remediation of identified gaps", icon: "target" },
        { title: "Readiness Assessment", description: "Systematic audit readiness evaluation", icon: "check-circle" }
      ]
    },
    evidence: {
      title: "Evidence Types & Management",
      subtitle: "Systematic approach to collecting and managing different types of audit evidence",
      items: [
        {
          title: "System Evidence",
          description: "Automated reports and logs",
          icon: "database",
          examples: ["Access rights reports", "Log files", "Configuration settings", "Change history"]
        },
        {
          title: "Manual Evidence",
          description: "Personnel activity documentation",
          icon: "users",
          examples: ["Approval processes", "Review tasks", "Training records", "Signatures"]
        },
        {
          title: "Security Evidence",
          description: "Information security measures documentation",
          icon: "shield",
          examples: ["Vulnerability scans", "Penetration tests", "Risk assessments", "Incident reports"]
        }
      ]
    },
    standards: {
      title: "Supported Audit Standards",
      subtitle: "Preparation for various international audit and certification standards",
      items: [
        { title: "SOC 2 Type II", focus: "Service organization controls", criteria: ["Security", "Availability", "Processing integrity", "Confidentiality", "Privacy"] },
        { title: "ISO 27001", focus: "Information security management system", criteria: ["ISMS policy", "Risk management", "Controls", "Continual improvement"] },
        { title: "PCI DSS", focus: "Payment card data protection", criteria: ["Network protection", "Data encryption", "Vulnerability management", "Access control"] },
        { title: "GDPR", focus: "Personal data protection", criteria: ["Privacy practices", "Rights", "Data breaches", "DPO role"] }
      ]
    },
    phases: {
      title: "Preparation Process Phases",
      subtitle: "Four-phase systematic approach to ensuring audit readiness",
      items: [
        { number: "01", title: "Pre-audit", description: "Current state mapping and gap identification", tasks: ["Control inventory", "Evidence mapping", "Gap analysis", "Remediation plan"] },
        { number: "02", title: "Remediation", description: "Fixing identified gaps", tasks: ["Control implementation", "Process improvement", "Documentation completion", "Testing"] },
        { number: "03", title: "Evidence Preparation", description: "Audit evidence compilation and organization", tasks: ["Evidence collection", "Organization", "Indexing", "Verification"] },
        { number: "04", title: "Readiness Testing", description: "Final audit readiness verification", tasks: ["Mock audit", "Walkthrough tests", "Evidence validation", "Team preparation"] }
      ]
    },
    metrics: {
      title: "Tracking Metrics",
      subtitle: "Metrics for objective assessment and tracking of audit readiness",
      items: [
        { metric: "Control Coverage", target: "100% of requirements" },
        { metric: "Evidence Completeness", target: "≥95% of evidence" },
        { metric: "Average Remediation Time", target: "<30 days" },
        { metric: "Mock Audit Results", target: "≥90% passed" }
      ]
    }
  },
  fi: {
    title: "Tilintarkastuksen valmistelu",
    subtitle: "Evidenssien hallinta ja vaatimustenmukaisuusvalmius",
    heroDescription: "Varmista sujuva ja onnistunut tarkastusprosessi evidenssien hallinnalla, kontrollien dokumentoinnilla ja systemaattisella valmistelulla.",
    forWho: "Organisaatioille, jotka valmistautuvat ISO 27001, SOC 2, PCI DSS, GDPR ja muihin vaatimustenmukaisuustarkastuksiin.",
    achieve: "Täysi tarkastusvalmius kattavalla evidenssien hallinnalla, kontrollien dokumentoinnilla ja systemaattisella valmistelulla.",
    components: {
      title: "Tarkastusvalmistelun komponentit",
      subtitle: "Kattava lähestymistapa tarkastusvalmiuden varmistamiseen neljän keskeisen elementin kautta",
      items: [
        { title: "Evidenssien hallinta", description: "Tarkastusevidenssin kerääminen, järjestely ja hallinta", icon: "folder" },
        { title: "Kontrollien kuvaukset", description: "Yksityiskohtaiset prosessi- ja kontrollien dokumentoinnit", icon: "file-text" },
        { title: "Puutteiden korjaus", description: "Löydettyjen puutteiden systemaattinen korjaaminen", icon: "target" },
        { title: "Valmiuden arviointi", description: "Tarkastusvalmiuden systemaattinen arviointi", icon: "check-circle" }
      ]
    },
    evidence: {
      title: "Evidenssityypit ja hallinta",
      subtitle: "Systemaattinen lähestymistapa erilaisten tarkastusevidenssien keräämiseen ja hallintaan",
      items: [
        {
          title: "Järjestelmäevidenssi",
          description: "Automaattiset raportit ja lokit",
          icon: "database",
          examples: ["Käyttöoikeusraportit", "Lokitiedot", "Konfiguraatioasetukset", "Muutoshistoria"]
        },
        {
          title: "Manuaalinen evidenssi",
          description: "Henkilöstön toiminnan dokumentointi",
          icon: "users",
          examples: ["Hyväksyntäprosessit", "Tarkastustehtävät", "Koulutustiedot", "Allekirjoitukset"]
        },
        {
          title: "Turvallisuusevidenssi",
          description: "Tietoturvatoimenpiteiden dokumentointi",
          icon: "shield",
          examples: ["Haavoittuvuusskannaukset", "Penetraatiotestit", "Riskiarvioinnit", "Incidenttiraportit"]
        }
      ]
    },
    standards: {
      title: "Tuetut tarkastusstandardit",
      subtitle: "Valmistautuminen eri kansainvälisiin tarkastus- ja sertifiointistandardeihin",
      items: [
        { title: "SOC 2 Type II", focus: "Palvelun organisaatioiden kontrollit", criteria: ["Turvallisuus", "Saatavuus", "Prosessien eheys", "Luottamuksellisuus", "Yksityisyys"] },
        { title: "ISO 27001", focus: "Tietoturvallisuuden hallintajärjestelmä", criteria: ["ISMS-politiikka", "Riskinhallinta", "Kontrollit", "Jatkuva parantaminen"] },
        { title: "PCI DSS", focus: "Maksukorttitietojen suojaus", criteria: ["Verkon suojaus", "Tietojen salaus", "Haavoittuvuuksien hallinta", "Pääsynhallinta"] },
        { title: "GDPR", focus: "Henkilötietojen suoja", criteria: ["Tietosuojakäytännöt", "Oikeudet", "Tietoturvaloukkaukset", "DPO-rooli"] }
      ]
    },
    phases: {
      title: "Valmisteluprosessin vaiheet",
      subtitle: "Neljän vaiheen systemaattinen lähestymistapa tarkastusvalmiuden varmistamiseen",
      items: [
        { number: "01", title: "Esiauditointi", description: "Nykytilan kartoitus ja puutteiden tunnistaminen", tasks: ["Kontrollien inventointi", "Evidenssien kartoitus", "Puuteanalyysi", "Korjaussuunnitelma"] },
        { number: "02", title: "Korjaustoimenpiteet", description: "Löydettyjen puutteiden korjaaminen", tasks: ["Kontrollien implementointi", "Prosessien parantaminen", "Dokumentoinnin täydentäminen", "Testaus"] },
        { number: "03", title: "Evidenssien valmistelu", description: "Tarkastusevidenssin kokoaminen ja järjestäminen", tasks: ["Evidenssien kerääminen", "Järjestäminen", "Indeksointi", "Varmistaminen"] },
        { number: "04", title: "Valmiuden testaus", description: "Tarkastusvalmiuden lopullinen varmistaminen", tasks: ["Mock audit", "Walkthrough-testit", "Evidenssien validointi", "Tiimin valmistaminen"] }
      ]
    },
    metrics: {
      title: "Seurantamittarit",
      subtitle: "Mittarit tarkastusvalmiuden objektiiviseen arviointiin ja seurantaan",
      items: [
        { metric: "Kontrollien kattavuus", target: "100% vaatimuksista" },
        { metric: "Evidenssien täydellisyys", target: "≥95% evidensseistä" },
        { metric: "Korjausajan keskiarvo", target: "<30 päivää" },
        { metric: "Mock audit -tulokset", target: "≥90% hyväksytty" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section - Smaller font -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Audit Components Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.components.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.components.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.components.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Evidence Types Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.evidence.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.evidence.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.evidence.items.map((type) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={type.icon} class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                  {type.title}
                </h3>
                <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                  {type.description}
                </p>
              </div>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {type.examples.map((example) => (
                <li class="flex items-center text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {example}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Audit Standards Section - 4 in a line -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.standards.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.standards.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.standards.items.map((standard) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {standard.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {standard.focus}
            </p>
            
            <div class="flex flex-wrap gap-1.5 relative z-10">
              {standard.criteria.map((criterion) => (
                <span class="px-2 py-0.5 text-xs font-medium text-[#0EA5E9] bg-white rounded-full border border-[#0EA5E9] group-hover:text-white group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                  {criterion}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Preparation Phases Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.phases.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.phases.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.phases.items.map((phase, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                {index + 1}
              </div>
              <h3 class="text-sm font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                {phase.title}
              </h3>
            </div>
            
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {phase.description}
            </p>
            
            <ul class="space-y-1 mt-auto relative z-10">
              {phase.tasks.map((task) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {task}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tracking Metrics Section - Smaller font -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.metrics.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.metrics.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.metrics.items.map((metric) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="text-2xl font-bold text-[#0F172A] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {metric.target}
            </div>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {metric.metric}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>