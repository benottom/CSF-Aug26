---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Policy Governance";

const content = {
  en: {
    title: "Policy Governance",
    subtitle: "Security Policy Management & Compliance",
    heroDescription: "Create a clear, owned, and maintained security policy architecture mapped to compliance requirements. A comprehensive policy framework where every policy is clearly owned, regularly updated, and linked to compliance requirements.",
    forWho: "For organizations seeking to build or improve their security policy framework and ensure compliance with regulatory requirements.",
    achieve: "A clear policy framework with defined ownership, regular updates, and compliance mapping.",
    framework: {
      title: "Policy Framework Foundations",
      subtitle: "We build a policy management system that supports your organizational objectives and meets regulatory requirements.",
      items: [
        { title: "Policy Architecture", description: "Hierarchical policy structure from standards to procedures", icon: "document" },
        { title: "Ownership Model", description: "Clear roles and responsibilities in policy management", icon: "users" },
        { title: "Lifecycle Management", description: "Policy creation, update and retirement processes", icon: "refresh-cw" },
        { title: "Compliance Mapping", description: "Policy mapping to regulations and standards", icon: "shield-check" }
      ]
    },
    categories: {
      title: "Policy Categories",
      subtitle: "We organize policies into clear categories that cover all organizational areas.",
      items: [
        {
          title: "Organizational Policies",
          description: "High-level strategic policies and principles",
          icon: "building",
          examples: ["Information Security Policy", "Risk Management Policy", "Personnel Security"]
        },
        {
          title: "Operational Policies",
          description: "Policies guiding practical operations",
          icon: "cog",
          examples: ["Access Control Policy", "Backup Policy", "Change Management"]
        },
        {
          title: "Technical Policies",
          description: "Policies defining technical requirements for IT systems",
          icon: "tool",
          examples: ["Encryption Policy", "Network Security Policy", "Cloud Policy"]
        }
      ]
    },
    process: {
      title: "Governance Process",
      subtitle: "Structured approach to managing the entire policy lifecycle.",
      items: [
        { title: "Planning", items: ["Policy architecture planning", "Ownership definition", "Scheduling and resourcing", "Stakeholder analysis"] },
        { title: "Development", items: ["Policy drafting", "Stakeholder consultation", "Legal expert consultation", "Internal review"] },
        { title: "Approval", items: ["Management review", "Formal approval", "Publication process", "Communication"] },
        { title: "Maintenance", items: ["Regular reviews", "Update needs assessment", "Version control", "Archiving"] }
      ]
    },
    mapping: {
      title: "Compliance Mapping",
      subtitle: "We link policies directly to regulations and standards for easy compliance tracking.",
      items: [
        { title: "ISO 27001", description: "Annex A controls mapping to policies", icon: "shield" },
        { title: "GDPR", description: "Meeting data protection article requirements", icon: "globe" },
        { title: "SOC 2", description: "Meeting Trust Services Criteria requirements", icon: "building-2" },
        { title: "NIS2/DORA", description: "Meeting EU regulation requirements", icon: "flag" }
      ]
    },
    steps: {
      title: "Implementation Process",
      subtitle: "Step-by-step approach to building a policy management system.",
      items: [
        { number: "01", title: "Architecture Design", description: "Policy hierarchy and category definition" },
        { number: "02", title: "Ownership Assignment", description: "Responsible persons and role assignment" },
        { number: "03", title: "Content Development", description: "Policy drafting and review" },
        { number: "04", title: "Approval Process", description: "Formal approval and publication" },
        { number: "05", title: "Maintenance Model", description: "Ongoing maintenance process implementation" }
      ]
    }
  },
  fi: {
    title: "Politiikkahallinta",
    subtitle: "Tietoturvapolitiikkojen hallinta & vaatimustenmukaisuus",
    heroDescription: "Luo selkeä, omistettu ja ylläpidetty tietoturvapolitiikka-arkkitehtuuri, joka on kartoitettu compliance-vaatimuksiin. Kattava politiikkakehikko, jossa jokainen politiikka on selkeästi omistettu, säännöllisesti päivitetty ja linkitetty compliance-vaatimuksiin.",
    forWho: "Organisaatioille, jotka haluavat rakentaa tai parantaa tietoturvapolitiikkakehikkoaan ja varmistaa sääntelyvaatimusten noudattamisen.",
    achieve: "Selkeä politiikkakehikko määritellyllä omistajuudella, säännöllisillä päivityksillä ja compliance-kartoituksella.",
    framework: {
      title: "Politiikkakehikon perusteet",
      subtitle: "Rakennamme politiikkahallintajärjestelmän, joka tukee organisaatiosi tavoitteita ja täyttää säädösvaatimukset.",
      items: [
        { title: "Politiikka-arkkitehtuuri", description: "Hierarkkinen politiikkarakenne standardeista prosesseihin", icon: "document" },
        { title: "Omistajuusmalli", description: "Selkeät roolit ja vastuut politiikkojen hallinnassa", icon: "users" },
        { title: "Elinkaaren hallinta", description: "Politiikkojen luonti, päivitys ja poistamisprosessit", icon: "refresh-cw" },
        { title: "Compliance-kartoitus", description: "Politiikkojen linkitys säädöksiin ja standardeihin", icon: "shield-check" }
      ]
    },
    categories: {
      title: "Politiikkakategoriat",
      subtitle: "Järjestämme politiikat selkeisiin kategorioihin, jotka kattavat kaikki organisaation toiminta-alueet.",
      items: [
        {
          title: "Organisaatiotason politiikat",
          description: "Ylätason strategiset politiikat ja periaatteet",
          icon: "building",
          examples: ["Tietoturvapolitiikka", "Riskienhallintapolitiikka", "Henkilöstöturvallisuus"]
        },
        {
          title: "Operatiiviset politiikat",
          description: "Käytännön toimintaa ohjaavat politiikat",
          icon: "cog",
          examples: ["Käyttöoikeuspolitiikka", "Varmuuskopiointipolitiikka", "Muutoshallinta"]
        },
        {
          title: "Tekniset politiikat",
          description: "IT-järjestelmien teknisiä vaatimuksia määrittävät politiikat",
          icon: "tool",
          examples: ["Salauspolitiikka", "Verkkoturvapolitiikka", "Pilvipolitiikka"]
        }
      ]
    },
    process: {
      title: "Hallintaprosessi",
      subtitle: "Strukturoitu lähestymistapa politiikkojen koko elinkaaren hallintaan.",
      items: [
        { title: "Suunnittelu", items: ["Politiikka-arkkitehtuurin suunnittelu", "Omistajuuksien määrittely", "Aikataulutus ja resursointi", "Stakeholder-analyysi"] },
        { title: "Kehittäminen", items: ["Politiikkojen laatiminen", "Stakeholder-kuuleminen", "Lakiasiantuntijoiden konsultointi", "Sisäinen arviointi"] },
        { title: "Hyväksyntä", items: ["Johdon katselmointi", "Muodollinen hyväksyntä", "Julkaisuprosessi", "Kommunikaatio"] },
        { title: "Ylläpito", items: ["Säännölliset katselmukset", "Päivitystarpeiden arviointi", "Versioiden hallinta", "Arkistointi"] }
      ]
    },
    mapping: {
      title: "Compliance-kartoitus",
      subtitle: "Linkitämme politiikat suoraan säädöksiin ja standardeihin, jotta compliance on helppoa seurata.",
      items: [
        { title: "ISO 27001", description: "Liite A kontrollien kartoitus politiikkoihin", icon: "shield" },
        { title: "GDPR", description: "Tietosuoja-artiklojen vaatimusten täyttäminen", icon: "globe" },
        { title: "SOC 2", description: "Trust Services Criteria -vaatimusten täyttäminen", icon: "building-2" },
        { title: "NIS2/DORA", description: "EU-säädösten vaatimusten täyttäminen", icon: "flag" }
      ]
    },
    steps: {
      title: "Toteutusprosessi",
      subtitle: "Vaiheittainen lähestymistapa politiikkahallintajärjestelmän rakentamiseen.",
      items: [
        { number: "01", title: "Arkkitehtuurin suunnittelu", description: "Politiikkahierarkian ja -kategorioiden määrittely" },
        { number: "02", title: "Omistajuuksien määrittely", description: "Vastuuhenkilöiden ja roolien määrittäminen" },
        { number: "03", title: "Sisällön kehittäminen", description: "Politiikkojen laatiminen ja tarkastelu" },
        { number: "04", title: "Hyväksyntäprosessi", description: "Muodollinen hyväksyntä ja julkaisu" },
        { number: "05", title: "Ylläpitomalli", description: "Jatkuvan ylläpidon prosessien käyttöönotto" }
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Policy Framework Foundations Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.framework.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.framework.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.framework.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Policy Categories Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.categories.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.categories.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.categories.items.map((category) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={category.icon} class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {category.title}
                </h3>
                <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                  {category.description}
                </p>
              </div>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {category.examples.map((example) => (
                <li class="flex items-center text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {example}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governance Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                {index + 1}
              </div>
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                {step.title}
              </h3>
            </div>
            
            <ul class="space-y-1 mt-1 relative z-10">
              {step.items.map((item) => (
                <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Mapping Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.mapping.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.mapping.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.mapping.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-4 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-10 h-10 bg-[#003580] text-white rounded-xl flex items-center justify-center text-sm font-bold">
                {step.number}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>