---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "CISO-as-a-Service";

const content = {
  en: {
    title: "CISO-as-a-Service",
    subtitle: "Fractional Chief Information Security Officer",
    heroDescription: "Flexible, senior Fractional CISO to build strategy, governance, and execution for your cybersecurity program. The impact of a full-time CISO delivered in a flexible, fractional model – strategy, governance and hands-on execution from a single partner.",
    forWho: "For organizations seeking expert security leadership without the cost of a full-time CISO.",
    achieve: "Expert security leadership with strategic direction, governance, and measurable security outcomes.",
    overview: {
      title: "Overview",
      description: "CISO-as-a-Service provides organizations with a fractional Chief Information Security Officer to lead security strategy, develop roadmaps, define metrics, and report to stakeholders. We help you build and maintain a robust security program with the impact of a full-time CISO delivered in a flexible, fractional model.",
      highlight: "Our virtual CISO service delivers expert security leadership on demand, helping you navigate complex security challenges, build stakeholder confidence, and achieve measurable security outcomes."
    },
    offerings: {
      title: "Our Services",
      subtitle: "Comprehensive security leadership coverage",
      items: [
        { title: "Security Strategy", description: "Risk-based security roadmap and prioritization", icon: "shield" },
        { title: "Policies and Governance", description: "Policy library, ownership and approval processes", icon: "document" },
        { title: "Risk Management", description: "ISO 27005/NIST based risk identification and treatment", icon: "chart-line" },
        { title: "Monitoring and Metrics", description: "KPI/KRI, executive reporting and continuous improvement", icon: "eye" },
        { title: "Regulatory and Audits", description: "NIS2, DORA, GDPR, SOC 2 and ISO 27001 compliance", icon: "building-library" }
      ]
    },
    process: {
      title: "Engagement Process",
      subtitle: "A clear, iterative model that delivers outcomes from month one.",
      items: [
        { number: "01", title: "Discovery", description: "Assess current state and objectives" },
        { number: "02", title: "Roadmap", description: "12-18 month program and priorities" },
        { number: "03", title: "Execution", description: "Policies, controls and processes" },
        { number: "04", title: "Metrics", description: "KPIs/KRIs and executive reporting" },
        { number: "05", title: "Continuous Improvement", description: "Quarterly reviews and tuning" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Security strategy and roadmap",
        "Policy and governance framework",
        "Risk management program",
        "Security metrics and reporting",
        "Executive presentations",
        "Regulatory compliance alignment",
        "Incident response planning",
        "Ongoing security leadership support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Fast access to senior CISO expertise",
        "Cost-effective fractional model",
        "Rapid maturity uplift",
        "Executive visibility and accountability",
        "Meet compliance requirements"
      ]
    }
  },
  fi: {
    title: "CISO-as-a-Service",
    subtitle: "Osa-aikainen tietoturvapäällikkö",
    heroDescription: "Joustava ja kokenut CISO-palvelu (osa-aikainen), joka rakentaa kyberturvan strategian, hallintamallin ja käytännön toteutuksen. Kokopäiväisen CISO:n vaikutus osa-aikaisella ja joustavalla mallilla – strategia, hallintamalli ja käytännön toteutus yhden kumppanin kautta.",
    forWho: "Organisaatioille, jotka tarvitsevat asiantuntevaa tietoturvajohtamista ilman kokoaikaisen tietoturvapäällikön kustannuksia.",
    achieve: "Asiantunteva tietoturvajohtaminen strategisella suunnalla, hallintamallilla ja mitattavilla tuloksilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "CISO-palveluna tarjoaa organisaatioille osa-aikaisen tietoturvapäällikön johtamaan tietoturvastrategiaa, kehittämään tiekarttoja, määrittelemään mittareita ja raportoimaan sidosryhmille. Autamme sinua rakentamaan ja ylläpitämään vankkaa tietoturvaohjelmaa kokopäiväisen CISO:n vaikutuksella joustavassa osa-aikaisessa mallissa.",
      highlight: "Virtuaalinen tietoturvapäällikköpalvelumme tarjoaa asiantuntevaa tietoturvajohtamista tarvittaessa, auttaen sinua navigoimaan monimutkaisissa tietoturvahaasteissa, rakentamaan sidosryhmien luottamusta ja saavuttamaan mitattavia tietoturvatuloksia."
    },
    offerings: {
      title: "Palvelumme",
      subtitle: "Kattava tietoturvajohtamisen kattavuus",
      items: [
        { title: "Kyberturvastrategia", description: "Riskiperusteinen kyberturvan tiekartta ja priorisointi", icon: "shield" },
        { title: "Politiikat ja hallintamalli", description: "Politiikkakirjasto, omistajuudet ja hyväksymisprosessit", icon: "document" },
        { title: "Riskienhallinta", description: "ISO 27005/NIST-pohjainen riskien tunnistus ja käsittely", icon: "chart-line" },
        { title: "Valvonta ja mittarit", description: "KPI/KRI-mittarit, johdon raportointi ja jatkuva parantaminen", icon: "eye" },
        { title: "Sääntely ja auditit", description: "NIS2, DORA, GDPR, SOC 2 ja ISO 27001 -yhteensopivuus", icon: "building-library" }
      ]
    },
    process: {
      title: "Toimintamalli",
      subtitle: "Selkeä, iteratiivinen malli, joka tuottaa tuloksia ensimmäisestä kuukaudesta alkaen.",
      items: [
        { number: "01", title: "Alkukartoitus", description: "Nykytilan arviointi ja tavoitteet" },
        { number: "02", title: "Tiekartta", description: "12–18 kk ohjelma ja prioriteetit" },
        { number: "03", title: "Toteutus", description: "Politiikat, kontrollit ja prosessit" },
        { number: "04", title: "Mittarit", description: "KPI/KRI ja johtoryhmäraportointi" },
        { number: "05", title: "Jatkuva kehitys", description: "Kausittaiset katselmoinnit" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Tietoturvastrategia ja tiekartta",
        "Politiikka- ja hallintakehys",
        "Riskienhallintaohjelma",
        "Tietoturvamittarit ja raportointi",
        "Johdon esitykset",
        "Sääntelyvaatimusten yhdenmukaistaminen",
        "Tapahtumien hallintasuunnittelu",
        "Jatkuva tietoturvajohtamisen tuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Nopea pääsy kokeneeseen CISO-osaamiseen",
        "Kustannustehokas osa-aikainen malli",
        "Nopea kypsyystason nosto",
        "Johdon läpinäkyvyys ja vastuullisuus",
        "Yhteensopivuusvaatimusten täyttäminen"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-gradient-to-br from-blue-50 to-indigo-50/30 rounded-2xl border-2 border-[#3B82F6] shadow-lg p-6 md:p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#3B82F6] rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl md:text-2xl font-bold text-[#1E2A7A]">{currentContent.overview.title}</h2>
        </div>
        <p class="text-slate-700 leading-relaxed mb-4 pl-14">{currentContent.overview.description}</p>
        <div class="bg-white/70 rounded-xl border border-[#3B82F6]/30 p-4 pl-14">
          <p class="text-[#1E2A7A] font-semibold flex items-start gap-2">
            <svg class="w-5 h-5 text-[#3B82F6] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {currentContent.overview.highlight}
          </p>
        </div>
      </div>
    </div>
  </section>
  <!-- Offerings Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.offerings.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.offerings.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.offerings.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>