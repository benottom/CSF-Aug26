---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Virtual DPO (V-DPO)";

const content = {
  en: {
    title: "Virtual DPO (V-DPO)",
    subtitle: "Experienced Data Protection Officer Service",
    heroDescription: "Experienced Data Protection Officer service for GDPR and privacy governance needs without full-time recruitment. We meet GDPR Article 37 requirements and provide strategic privacy guidance to your organization.",
    forWho: "For organizations seeking expert Data Protection Officer services without full-time recruitment costs.",
    achieve: "GDPR compliance and strategic privacy governance with experienced DPO expertise.",
    overview: {
      title: "Service Overview",
      description: "Our Virtual DPO service provides experienced Data Protection Officer expertise for GDPR requirements and privacy governance without full-time recruitment. We offer the expertise needed for privacy management, compliance oversight, and stakeholder communication.",
      highlight: "We meet GDPR Article 37 requirements and provide strategic privacy guidance to your organization."
    },
    serviceModels: {
      title: "Service Models",
      subtitle: "Choose the V-DPO service model that best fits your organization's needs",
      items: [
        {
          title: "Full-Service V-DPO",
          description: "Comprehensive privacy governance solution covering all GDPR requirements and data protection operations.",
          icon: "shield-check",
          features: ["GDPR Compliance", "Privacy Notices", "Data Protection Impact Assessments (DPIA)", "Records of Processing Activities (RoPA)", "Data Breach Management", "Regulatory Authority Liaison"]
        },
        {
          title: "Advisory V-DPO",
          description: "Provides expertise and guidance on privacy governance without daily operational responsibility.",
          icon: "light-bulb",
          features: ["Privacy Strategic Planning", "Privacy Policy Development", "Staff Training", "Privacy Assessments", "Privacy Governance Framework Design", "Privacy Questionnaires"]
        },
        {
          title: "Project V-DPO",
          description: "Supports specific privacy projects such as DPIAs, certifications, or crisis management.",
          icon: "clipboard",
          features: ["Data Protection Impact Assessments (DPIA)", "Privacy Governance Framework Implementation", "Data Breach Response", "Privacy Audits", "Vendor Privacy Management", "Contract Documentation"]
        }
      ]
    },
    requirements: {
      title: "GDPR Requirements",
      subtitle: "Comprehensive coverage of key GDPR requirements",
      items: [
        "Article 30 - Records of Processing Activities (RoPA)",
        "Article 35 - Data Protection Impact Assessments (DPIA)",
        "Article 37 - DPO Appointment Requirements",
        "Article 33/34 - Breach Notification",
        "Article 13/14 - Privacy Notices",
        "Article 7 - Consent Management"
      ]
    },
    process: {
      title: "Engagement Process",
      subtitle: "Structured approach to delivering V-DPO services.",
      items: [
        { number: "01", title: "Discovery", description: "Assess current privacy posture and GDPR compliance" },
        { number: "02", title: "Strategy", description: "Develop privacy strategy and governance framework" },
        { number: "03", title: "Implementation", description: "Implement privacy policies and procedures" },
        { number: "04", title: "Monitoring", description: "Ongoing compliance monitoring and reporting" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Data Protection Officer appointment",
        "Data Protection Impact Assessments (DPIA)",
        "Records of Processing Activities (RoPA)",
        "Privacy policies and procedures",
        "Data breach response procedures",
        "Staff training programs",
        "Regulatory correspondence",
        "Privacy governance framework"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Save costs compared to full-time DPO",
        "Access to privacy expertise",
        "Flexible engagement as needed",
        "Meet GDPR requirements",
        "Avoid regulatory risks and fines",
        "Improve customer trust"
      ]
    }
  },
  fi: {
    title: "Virtuaalinen DPO (V-DPO)",
    subtitle: "Kokenut tietosuojavastaavan palvelu",
    heroDescription: "Kokeneen tietosuojavastaavan palvelu GDPR:n ja tietosuojan hallinnan tarpeisiin ilman pysyvää rekrytointia. Täytämme GDPR-artiklan 37 vaatimukset ja tarjoamme strategista tietosuojan ohjausta organisaatiollesi.",
    forWho: "Organisaatioille, jotka tarvitsevat kokenutta tietosuojavastaavan palvelua ilman kokoaikaisen rekrytoinnin kustannuksia.",
    achieve: "GDPR-vaatimustenmukaisuus ja strateginen tietosuojan hallinta kokeneella DPO-osaamisella.",
    overview: {
      title: "Yleiskatsaus palveluun",
      description: "Virtuaalinen DPO -palvelumme tarjoaa kokeneen tietosuojavastaavan osaamisen GDPR-vaatimusten ja tietosuojan hallinnan tarpeisiin ilman pysyvää rekrytointia. Tarjoamme asiantuntemusta, jota tarvitaan tietosuojan hallinnassa, sääntelyn noudattamisessa ja sidosryhmien kanssa käytävässä viestinnässä.",
      highlight: "Täytämme GDPR-artiklan 37 vaatimukset ja tarjoamme strategista tietosuojan ohjausta organisaatiollesi."
    },
    serviceModels: {
      title: "Palvelumallit",
      subtitle: "Valitse organisaatiosi tarpeisiin sopivin V-DPO-palvelumalli",
      items: [
        {
          title: "Täyspalvelu V-DPO",
          description: "Kokonaisvaltainen tietosuojan hallintaratkaisu, joka kattaa kaikki GDPR-vaatimukset ja tietosuojan hallinnolliset toiminnot.",
          icon: "shield-check",
          features: ["GDPR-sääntelyn noudattaminen", "Tietosuojaselosteet", "Tietosuojavaikutusten arviointi (DPIA)", "Käsittelytietojen rekisteröinti (RoPA)", "Tietoturvaloukkausten hallinta", "Sääntelyviranomaisten yhteistyö"]
        },
        {
          title: "Konsultoiva V-DPO",
          description: "Tarjoaa asiantuntemusta ja ohjausta tietosuojan hallintaan ilman päivittäistä operatiivista vastuuta.",
          icon: "light-bulb",
          features: ["Tietosuojan strateginen suunnittelu", "Tietosuojakäytäntöjen kehittäminen", "Henkilöstökoulutus", "Tietosuojan arviointi", "Tietosuojan hallintakehyksen suunnittelu", "Tietosuojaa koskevat kyselyt"]
        },
        {
          title: "Projekti-V-DPO",
          description: "Tukee tiettyjä tietosuojaprojekteja kuten DPIA-arviointeja, sertifiointeja tai kriisinhallintaa.",
          icon: "clipboard",
          features: ["Tietosuojavaikutusten arviointi (DPIA)", "Tietosuojan hallintakehyksen toteutus", "Tietoturvaloukkausten hallinta", "Tietosuojaa koskevat tarkastukset", "Toimittajien tietosuojan hallinta", "Sopimusasiakirjat"]
        }
      ]
    },
    requirements: {
      title: "GDPR-vaatimukset",
      subtitle: "Kattava kattavuus keskeisiin GDPR-vaatimuksiin",
      items: [
        "Artikla 30 - Käsittelytietojen rekisteröinti (RoPA)",
        "Artikla 35 - Tietosuojavaikutusten arviointi (DPIA)",
        "Artikla 37 - Tietosuojavastaavan nimittämisvaatimukset",
        "Artiklat 33/34 - Tietoturvaloukkauksesta ilmoittaminen",
        "Artiklat 13/14 - Tietosuojaselosteet",
        "Artikla 7 - Suostumushallinta"
      ]
    },
    process: {
      title: "Toimintamalli",
      subtitle: "Rakenteinen lähestymistapa V-DPO-palveluiden tuottamiseen.",
      items: [
        { number: "01", title: "Alkukartoitus", description: "Arvioidaan nykyinen tietosuojatilanne ja GDPR-vaatimustenmukaisuus" },
        { number: "02", title: "Strategia", description: "Kehitetään tietosuojastrategia ja hallintakehys" },
        { number: "03", title: "Toteutus", description: "Toteutetaan tietosuojakäytännöt ja -menettelyt" },
        { number: "04", title: "Seuranta", description: "Jatkuva vaatimustenmukaisuuden seuranta ja raportointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Tietosuojavastaavan nimitys",
        "Tietosuojavaikutusten arviointi (DPIA)",
        "Käsittelytietojen rekisteröinti (RoPA)",
        "Tietosuojakäytännöt ja -menettelyt",
        "Tietoturvaloukkausten hallintamenettelyt",
        "Henkilöstökoulutusohjelmat",
        "Sääntelyviranomaisten vastineet",
        "Tietosuojan hallintakehys"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Säästä kustannuksia kokopäiväisen DPO:n sijaan",
        "Pääsy kokeneeseen tietosuojan asiantuntijaan",
        "Joustava käyttöönotto tarpeen mukaan",
        "GDPR-vaatimusten täyttäminen",
        "Vältä sääntelyriskejä ja sakkoja",
        "Paranna asiakasluottamusta"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#1E2A7A] mb-4">{currentContent.overview.title}</h2>
        <p class="text-slate-600 leading-relaxed mb-4">{currentContent.overview.description}</p>
        <div class="bg-blue-50 border-l-4 border-[#3B82F6] p-4 rounded-r-lg">
          <p class="text-[#1E2A7A] font-semibold">{currentContent.overview.highlight}</p>
        </div>
      </div>
    </div>
  </section>
  <!-- Service Models Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.serviceModels.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.serviceModels.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.serviceModels.items.map((model) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={model.icon} class="w-6 h-6 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10 text-center">
              {model.title}
            </h3>
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 relative z-10 text-center">
              {model.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:border-[#3B82F6] transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {model.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GDPR Requirements Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.requirements.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirements.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentContent.requirements.items.map((req) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex items-center justify-center p-4 group text-center">
            <p class="text-xs font-medium text-slate-700 group-hover:text-[#1E40AF] transition-colors duration-300">{req}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>