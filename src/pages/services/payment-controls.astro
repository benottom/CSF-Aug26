---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Payment Controls";

const content = {
  en: {
    title: "Payment Controls",
    subtitle: "Fraud Protection & Recovery",
    heroDescription: "We harden payment processes against fraud and build recovery readiness. Comprehensive payment fraud protection for your organization.",
    forWho: "For organizations seeking to harden payment processes and build fraud recovery readiness.",
    achieve: "Comprehensive payment fraud protection with technical, process, and human controls.",
    overview: {
      title: "Overview",
      description: "Payment fraud, including BEC, invoice fraud, and payment system abuse, is one of the fastest-growing threats facing organizations. Effective protection requires a comprehensive approach combining technical, process, and human controls.",
      highlight: "Our expert team provides comprehensive payment control services, helping you build robust fraud protection and recovery readiness across your payment processes."
    },
    pillars: {
      title: "Three Pillars of Payment Controls",
      subtitle: "Effective payment fraud protection requires combining technical, process, and human controls.",
      items: [
        { title: "Process Controls", description: "Four‑eyes approvals, payment limits and change control.", icon: "document" },
        { title: "Technical Controls", description: "SPF/DMARC, treasury/ERP integrations, strong authentication.", icon: "lock" },
        { title: "People Controls", description: "Call‑backs, verification, training and simulations.", icon: "user" }
      ]
    },
    threats: {
      title: "Payment Fraud Threats",
      subtitle: "Identify and protect against the most common payment frauds.",
      items: [
        { title: "BEC/CEO Fraud", description: "False payment requests using executive credentials", icon: "alert-triangle" },
        { title: "Vendor Fraud", description: "Vendor banking detail changes and false invoices", icon: "mail" },
        { title: "Payment System Fraud", description: "ERP and payment system abuse", icon: "credit-card" },
        { title: "Social Engineering", description: "Phone fraud and staff manipulation", icon: "phone" }
      ]
    },
    framework: {
      title: "Control Framework",
      subtitle: "Comprehensive approach to payment fraud risk management.",
      items: [
        { title: "Prevention", icon: "shield", features: ["Payment limit setting", "Four-eyes principle", "Vendor data locking", "Technical protection"] },
        { title: "Detection", icon: "eye", features: ["Anomaly detection", "Transaction monitoring", "Reporting channels", "Regular reviews"] },
        { title: "Response", icon: "alert-triangle", features: ["Payment stopping", "Bank contacts", "Incident investigation", "Authority reporting"] }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Structured approach to building payment controls and recovery readiness.",
      items: [
        { number: "01", title: "Risk Assessment", description: "Assess payment process risks and vulnerabilities" },
        { number: "02", title: "Control Design", description: "Design preventive controls and recovery playbooks" },
        { number: "03", title: "Implementation", description: "Implement controls and train staff" },
        { number: "04", title: "Testing & Monitoring", description: "Test controls and establish monitoring" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Payment process risk assessment",
        "Control framework and documentation",
        "Recovery playbook documentation",
        "Staff training materials",
        "Bank contact protocols",
        "Incident response procedures",
        "Testing and monitoring plan",
        "Ongoing support and updates"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Reduced payment fraud risk",
        "Fast and effective incident response",
        "Protected financial assets",
        "Improved process security",
        "Regulatory compliance assurance"
      ]
    }
  },
  fi: {
    title: "Maksukontrollit",
    subtitle: "Petossuoja & Palautuminen",
    heroDescription: "Kovennamme maksuprosessit petoksia vastaan ja rakennamme palautumisvalmiuden. Kattava maksupetossuoja organisaatiollesi.",
    forWho: "Organisaatioille, jotka haluavat koventaa maksuprosesseja ja rakentaa petosten palautumisvalmiutta.",
    achieve: "Kattava maksupetossuoja teknisillä, prosessuaalisilla ja henkilöstökontrolleilla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Maksupetokset, kuten BEC, laskupetokset ja maksujärjestelmien väärinkäyttö, ovat yksi nopeimmin kasvavista uhista, joita organisaatiot kohtaavat. Tehokas suojaus vaatii kattavaa lähestymistapaa, joka yhdistää tekniset, prosessuaaliset ja henkilöstökontrollit.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia maksukontrollipalveluita auttaen sinua rakentamaan vankkaa petossuojaa ja palautumisvalmiutta maksuprosesseihisi."
    },
    pillars: {
      title: "Maksukontrollien kolme pilaria",
      subtitle: "Tehokas maksupetossuojaus vaatii teknisten, prosessuaalisten ja henkilöstöön liittyvien kontrollien yhdistämistä.",
      items: [
        { title: "Prosessikontrollit", description: "Neljän silmän periaate, maksurajojen ja muutosten hallinta.", icon: "document" },
        { title: "Tekniset kontrollit", description: "SPF/DMARC, treasuryn ja ERP‑integraatiot, vahva tunnistus.", icon: "lock" },
        { title: "Ihmiskontrollit", description: "Soittopaluu, todennus, koulutus ja simulaatiot.", icon: "user" }
      ]
    },
    threats: {
      title: "Maksupetosuhkat",
      subtitle: "Tunnista ja suojaudu yleisimmiltä maksupetoksilta.",
      items: [
        { title: "BEC/CEO Fraud", description: "Johdon tunnuksilla tehdyt väärät maksupyynnöt", icon: "alert-triangle" },
        { title: "Toimittajapetokset", description: "Toimittajan pankkitietojen vaihto ja väärät laskut", icon: "mail" },
        { title: "Maksujärjestelmäpetokset", description: "ERP- ja maksujärjestelmien väärinkäyttö", icon: "credit-card" },
        { title: "Sosiaalinen manipulointi", description: "Puhelinpetokset ja henkilöstön manipulointi", icon: "phone" }
      ]
    },
    framework: {
      title: "Kontrollikehikko",
      subtitle: "Kattava lähestymistapa maksupetosriskien hallintaan.",
      items: [
        { title: "Ennaltaehkäisy", icon: "shield", features: ["Maksulimiitin asettaminen", "Nelisilmäperiaate", "Toimittajatietojen lukitseminen", "Tekninen suojaus"] },
        { title: "Tunnistaminen", icon: "eye", features: ["Anomalianseuranta", "Transaktion valvonta", "Raportointikanavat", "Säännölliset tarkastukset"] },
        { title: "Vastaus", icon: "alert-triangle", features: ["Maksun pysäytys", "Pankkikontaktit", "Tapauksen selvitys", "Viranomaisilmoitus"] }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen lähestymistapa maksukontrollien ja palautumisvalmiuden rakentamiseen.",
      items: [
        { number: "01", title: "Riskien arviointi", description: "Arvioidaan maksuprosessien riskit ja haavoittuvuudet" },
        { number: "02", title: "Kontrollien suunnittelu", description: "Suunnitellaan ennaltaehkäisevät kontrollit ja palautumisohjeet" },
        { number: "03", title: "Toteutus", description: "Toteutetaan kontrollit ja koulutetaan henkilöstö" },
        { number: "04", title: "Testaus & Seuranta", description: "Testataan kontrollit ja perustetaan seuranta" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Maksuprosessien riskiarviointi",
        "Kontrollikehys ja dokumentaatio",
        "Palautumisohjeiden dokumentaatio",
        "Henkilöstön koulutusmateriaalit",
        "Pankkikontaktien protokollat",
        "Tapahtumien hallintamenettelyt",
        "Testaus- ja seurantasuunnitelma",
        "Jatkuva tuki ja päivitykset"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Vähentynyt maksupetosriski",
        "Nopea ja tehokas tapahtumien hallinta",
        "Suojatut taloudelliset varat",
        "Parannettu prosessiturvallisuus",
        "Sääntelyvaatimusten noudattamisen varmistus"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Pillars Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.pillars.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.pillars.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.pillars.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Threats Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.threats.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.threats.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.threats.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Control Framework Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.framework.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.framework.subtitle}
        </p>
      </div>
      
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.framework.items.map((item, index) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-8 h-8 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-lg flex items-center justify-center text-white font-bold text-xs">
                {index + 1}
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#1E293B] mb-3 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10 text-center">
              {item.title}
            </h3>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300 relative z-10">
              <ul class="space-y-1.5 relative z-10 text-left mx-auto w-full max-w-xs">
                {item.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>