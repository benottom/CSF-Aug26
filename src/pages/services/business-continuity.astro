---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "Business Continuity";

const content = {
  en: {
    title: "Business Continuity",
    subtitle: "Disaster Recovery & Crisis Management",
    heroDescription: "Professional business continuity and disaster recovery planning services. We help organizations ensure operational continuity during crisis situations. Ensure your organization's operational continuity during crisis situations. We help organizations build a strong business continuity and disaster recovery plan.",
    forWho: "For organizations seeking to ensure operational continuity and resilience during crisis situations.",
    achieve: "Operational continuity and resilience with comprehensive business continuity and disaster recovery planning.",
    overview: {
      title: "Overview",
      description: "Business continuity and disaster recovery planning is essential for ensuring your organization can continue operations during and after crisis situations. From natural disasters and cyber threats to technical failures and pandemics, organizations face numerous risks that can disrupt operations.",
      highlight: "Our expert team provides comprehensive business continuity and disaster recovery planning services, helping you build resilience and ensure operational continuity in the face of any crisis."
    },
    components: {
      title: "Business Continuity Components",
      subtitle: "Business continuity consists of four main components.",
      items: [
        { title: "Business Continuity Planning", description: "Plan organizational operational continuity during crisis situations", icon: "target", features: ["Crisis identification", "Critical operations definition", "Continuity strategies"] },
        { title: "Disaster Recovery", description: "Plan IT systems and data recovery", icon: "refresh-cw", features: ["RTO and RPO definition", "Recovery plans", "Testing and validation"] },
        { title: "Crisis Communication", description: "Plan effective communication during crisis situations", icon: "chat", features: ["Communication plans", "Stakeholder communication", "Media relations"] },
        { title: "Crisis Management", description: "Plan crisis management and response", icon: "alert-triangle", features: ["Crisis management team", "Response processes", "Training and simulation"] }
      ]
    },
    threats: {
      title: "Threats and Risks",
      subtitle: "Business continuity is threatened by various threats and risks.",
      items: [
        { title: "Natural Disasters", description: "Earthquakes, floods, storms and other natural disasters", icon: "cloud", examples: ["Earthquakes", "Floods", "Storms"] },
        { title: "Cyber Threats", description: "Ransomware, DDoS attacks and data breaches", icon: "shield", examples: ["Ransomware", "DDoS attacks", "Data breaches"] },
        { title: "Technical Failures", description: "System failures, power outages and hardware failures", icon: "computer", examples: ["System failures", "Power outages", "Hardware failures"] },
        { title: "Pandemic & Health", description: "Pandemics, diseases and health threats", icon: "user", examples: ["Pandemic", "Diseases", "Health threats"] }
      ]
    },
    process: {
      title: "Implementation Process",
      subtitle: "Clear and structured process for implementing business continuity.",
      items: [
        { number: "01", title: "BCM Assessment", description: "Assess current business continuity and identify gaps" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Planning", description: "Plan business continuity program" },
        { number: "04", title: "Implementation", description: "Implement required continuity measures" },
        { number: "05", title: "Testing & Monitoring", description: "Test and monitor continuity processes" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "BCM assessment report",
        "Business continuity strategy",
        "Disaster recovery plans",
        "Crisis communication framework",
        "Crisis management procedures",
        "Training and simulation program",
        "Testing and validation framework",
        "Ongoing monitoring and improvement"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Ensure operational continuity",
        "Reduce crisis impacts",
        "Improve customer trust",
        "Meet regulatory requirements",
        "Strengthen competitive advantage"
      ]
    }
  },
  fi: {
    title: "Liiketoiminnan Jatkuvuus",
    subtitle: "Katastrofien Palautuminen & Kriisienhallinta",
    heroDescription: "Ammattimaiset liiketoiminnan jatkuvuus- ja katastrofien palautumissuunnittelupalvelut. Autamme organisaatioita varmistamaan toimintojen jatkuvuuden kriisitilanteissa. Varmista organisaatiosi toimintojen jatkuvuus kriisitilanteissa. Autamme organisaatioita rakentamaan vahvan liiketoiminnan jatkuvuus- ja katastrofien palautumissuunnitelman.",
    forWho: "Organisaatioille, jotka haluavat varmistaa toimintojen jatkuvuuden ja resilienssin kriisitilanteissa.",
    achieve: "Toimintojen jatkuvuus ja resilienssi kattavalla liiketoiminnan jatkuvuus- ja katastrofien palautumissuunnittelulla.",
    overview: {
      title: "Yleiskatsaus",
      description: "Liiketoiminnan jatkuvuus- ja katastrofien palautumissuunnittelu on olennaista organisaatiosi toimintojen jatkumisen varmistamiseksi kriisitilanteiden aikana ja jälkeen. Luonnonkatastrofeista kyberuhkiin, teknisistä vioista pandemioihin, organisaatiot kohtaavat lukuisia riskejä, jotka voivat häiritä toimintoja.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia liiketoiminnan jatkuvuus- ja katastrofien palautumissuunnittelupalveluita auttaen sinua rakentamaan resilienssiä ja varmistamaan toimintojen jatkuvuuden minkä tahansa kriisin edessä."
    },
    components: {
      title: "Liiketoiminnan Jatkuvuuden Komponentit",
      subtitle: "Liiketoiminnan jatkuvuus koostuu neljästä pääkomponentista.",
      items: [
        { title: "Liiketoiminnan Jatkuvuus Suunnittelu", description: "Suunnitellaan organisaation toimintojen jatkuvuus kriisitilanteissa", icon: "target", features: ["Kriisitilanteiden tunnistus", "Kriittisten toimintojen määrittely", "Jatkuvuusstrategiat"] },
        { title: "Katastrofien Palautuminen", description: "Suunnitellaan IT-järjestelmien ja tietojen palautuminen", icon: "refresh-cw", features: ["RTO ja RPO määrittely", "Palautumissuunnitelmat", "Testaus ja validointi"] },
        { title: "Kriisiviestintä", description: "Suunnitellaan tehokas viestintä kriisitilanteissa", icon: "chat", features: ["Viestintäsuunnitelmat", "Sidosryhmäviestintä", "Mediasuhteet"] },
        { title: "Kriisienhallinta", description: "Suunnitellaan kriisien hallinta ja vastaus", icon: "alert-triangle", features: ["Kriisienhallintatiimi", "Vastausprosessit", "Koulutus ja simulointi"] }
      ]
    },
    threats: {
      title: "Uhat ja Riskit",
      subtitle: "Liiketoiminnan jatkuvuutta uhkaavat erilaiset uhat ja riskit.",
      items: [
        { title: "Luonnonkatastrofit", description: "Maat, tulvat, myrskyt ja muut luonnonkatastrofit", icon: "cloud", examples: ["Maat", "Tulvat", "Myrskyt"] },
        { title: "Kybertuhkat", description: "Ransomware, DDoS hyökkäykset ja tietomurrot", icon: "shield", examples: ["Ransomware", "DDoS hyökkäykset", "Tietomurrot"] },
        { title: "Tekniset Viat", description: "Järjestelmäviat, sähkökatkot ja laitteistoviat", icon: "computer", examples: ["Järjestelmäviat", "Sähkökatkot", "Laitteistoviat"] },
        { title: "Pandemia & Terveys", description: "Pandemia, sairaudet ja terveysuhkat", icon: "user", examples: ["Pandemia", "Sairaudet", "Terveysuhkat"] }
      ]
    },
    process: {
      title: "Toteutusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi liiketoiminnan jatkuvuuden toteuttamiseen.",
      items: [
        { number: "01", title: "BCM Arviointi", description: "Arvioidaan nykyinen liiketoiminnan jatkuvuus ja tunnistetaan puutteet" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Suunnittelu", description: "Suunnitellaan liiketoiminnan jatkuvuusohjelma" },
        { number: "04", title: "Toteutus", description: "Toteutetaan tarvittavat jatkuvuustoimenpiteet" },
        { number: "05", title: "Testaus & Valvonta", description: "Testataan ja valvotaan jatkuvuusprosesseja" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "BCM-arviointiraportti",
        "Liiketoiminnan jatkuvuusstrategia",
        "Katastrofien palautumissuunnitelmat",
        "Kriisiviestinnän kehys",
        "Kriisienhallintamenettelyt",
        "Koulutus- ja simulointiohjelma",
        "Testaus- ja validointikehys",
        "Jatkuva seuranta ja parantaminen"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Varmista toimintojen jatkuvuus",
        "Vähennä kriisien vaikutuksia",
        "Paranna asiakkaiden luottamusta",
        "Täytä sääntelyvaatimukset",
        "Vahvista kilpailuetua"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-gradient-to-br from-blue-50 to-indigo-50/30 rounded-2xl border-2 border-[#0EA5E9] shadow-lg p-6 md:p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#0EA5E9] rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl md:text-2xl font-bold text-[#0F172A]">{currentContent.overview.title}</h2>
        </div>
        <p class="text-slate-700 leading-relaxed mb-4 pl-14">{currentContent.overview.description}</p>
        <div class="bg-white/70 rounded-xl border border-[#0EA5E9]/30 p-4 pl-14">
          <p class="text-[#0F172A] font-semibold flex items-start gap-2">
            <svg class="w-5 h-5 text-[#0EA5E9] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {currentContent.overview.highlight}
          </p>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Components Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.components.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.components.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.components.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.features.map((feature) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#0EA5E9] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Threats Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.threats.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.threats.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.threats.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <div class="flex flex-wrap gap-1.5">
                {item.examples.map((example) => (
                  <span class="inline-flex items-center gap-1 text-xs text-slate-500 bg-slate-50 px-2 py-1 rounded border border-slate-200">
                    <span class="text-amber-500">⚠️</span> {example}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>