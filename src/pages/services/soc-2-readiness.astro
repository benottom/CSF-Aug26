---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "SOC 2 Readiness";

const content = {
  en: {
    title: "SOC 2 Readiness",
    subtitle: "Trust Service Criteria Certification",
    heroDescription: "Professional SOC 2 Type II certification services. We help SaaS and technology companies achieve trust and security standards. Achieve SOC 2 Type II certification and strengthen customer trust. We help SaaS and technology companies build a strong cybersecurity foundation.",
    forWho: "For SaaS and technology companies seeking SOC 2 Type II certification and customer trust.",
    achieve: "SOC 2 Type II certification with comprehensive trust service criteria compliance.",
    overview: {
      title: "Overview",
      description: "SOC 2 (Service Organization Control 2) is an auditing standard developed by the AICPA that evaluates controls related to security, availability, processing integrity, confidentiality, and privacy. It is essential for SaaS and technology companies building customer trust.",
      highlight: "Our expert team provides comprehensive SOC 2 readiness services, helping you achieve Type II certification and build customer trust."
    },
    trustServices: {
      title: "Trust Service Criteria",
      subtitle: "SOC 2 is based on five trust service criteria that define security standards.",
      items: [
        { title: "Security", description: "Protect systems and data from unauthorized access", icon: "shield", criteria: ["User access management", "Encryption and security", "Security monitoring"] },
        { title: "Availability", description: "Ensure continuous service availability and performance", icon: "clock", criteria: ["Planned maintenance", "Incident management", "Performance monitoring"] },
        { title: "Processing Integrity", description: "Ensure accurate data processing and integrity", icon: "check", criteria: ["Data validation", "Error handling", "Data backup"] },
        { title: "Confidentiality", description: "Protect sensitive information from unauthorized disclosure", icon: "lock", criteria: ["Data classification", "Non-disclosure agreements", "Data encryption"] },
        { title: "Privacy", description: "Comply with privacy and personal data processing", icon: "user", criteria: ["GDPR compliance", "Personal data management", "Privacy protection"] }
      ]
    },
    process: {
      title: "Readiness Process",
      subtitle: "Clear and structured process for SOC 2 certification.",
      items: [
        { number: "01", title: "Initial Assessment", description: "Assess current security posture against SOC 2 requirements" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Implementation", description: "Implement required security measures" },
        { number: "04", title: "Internal Audit", description: "Conduct internal audit and fix gaps" },
        { number: "05", title: "External Audit", description: "Pass external SOC 2 audit" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "SOC 2 readiness assessment report",
        "Gap analysis and remediation plan",
        "Control implementation framework",
        "Evidence collection guidelines",
        "Internal audit program",
        "External audit preparation",
        "Trust service criteria compliance",
        "Ongoing readiness support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Strengthen customer trust",
        "Differentiate from competitors",
        "Meet regulatory requirements",
        "Improve security posture",
        "Accelerate sales process"
      ]
    }
  },
  fi: {
    title: "SOC 2 Valmistelu",
    subtitle: "Luottamuspalvelukriteerien Sertifiointi",
    heroDescription: "Ammattimaiset SOC 2 Type II sertifiointipalvelut. Autamme SaaS- ja teknologiayrityksiä saavuttamaan luotettavuus- ja tietoturvastandardit. Saavuta SOC 2 Type II sertifiointi ja vahvista asiakkaiden luottamus. Autamme SaaS- ja teknologiayrityksiä rakentamaan vahvan tietoturvan perustan.",
    forWho: "SaaS- ja teknologiayrityksille, jotka tavoittelevat SOC 2 Type II -sertifiointia ja asiakasluottamusta.",
    achieve: "SOC 2 Type II -sertifiointi kattavalla luottamuspalvelukriteerien noudattamisella.",
    overview: {
      title: "Yleiskatsaus",
      description: "SOC 2 (Service Organization Control 2) on AICPA:n kehittämä auditointistandardi, joka arvioi kontrolleja, jotka liittyvät turvallisuuteen, saatavuuteen, käsittelyn eheyteen, luottamuksellisuuteen ja yksityisyyteen. Se on olennaista SaaS- ja teknologiayrityksille, jotka rakentavat asiakasluottamusta.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia SOC 2 -valmiuspalveluita auttaen sinua saavuttamaan Type II -sertifioinnin ja rakentamaan asiakasluottamusta."
    },
    trustServices: {
      title: "Luottamuspalvelukriteerit",
      subtitle: "SOC 2 perustuu viiteen luottamuspalvelukriteeriin, jotka määrittelevät tietoturvan standardit.",
      items: [
        { title: "Tietoturva", description: "Suojaa järjestelmiä ja tietoja luvattomalta käytöltä", icon: "shield", criteria: ["Käyttäjien hallinta", "Salaus ja tietoturva", "Tietoturvavalvonta"] },
        { title: "Saatavuus", description: "Varmista palvelun jatkuva saatavuus ja suorituskyky", icon: "clock", criteria: ["Suunnitelmallinen ylläpito", "Vikatilanteiden hallinta", "Suorituskyvyn seuranta"] },
        { title: "Käsittelyn Eheys", description: "Varmista tietojen oikeellinen käsittely ja eheys", icon: "check", criteria: ["Tietojen validointi", "Virheiden käsittely", "Tietojen varmuuskopiointi"] },
        { title: "Luottamuksellisuus", description: "Suojaa arkaluontoista tietoa luvattomalta paljastumiselta", icon: "lock", criteria: ["Tietojen luokittelu", "Salassapitosopimukset", "Tietojen salaus"] },
        { title: "Yksityisyys", description: "Noudata tietosuojaa ja henkilötietojen käsittelyä", icon: "user", criteria: ["GDPR yhteensopivuus", "Henkilötietojen hallinta", "Yksityisyyden suoja"] }
      ]
    },
    process: {
      title: "Valmisteluprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi SOC 2 -sertifiointiin.",
      items: [
        { number: "01", title: "Alustava arviointi", description: "Arvioidaan nykyinen tietoturvataso SOC 2 -vaatimusten suhteen" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { number: "04", title: "Sisäinen auditointi", description: "Suoritetaan sisäinen auditointi ja korjataan puutteet" },
        { number: "05", title: "Ulkoinen auditointi", description: "Läpäistään ulkoinen SOC 2 -auditointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "SOC 2 -valmiusarviointiraportti",
        "Aukkoanalyysi ja korjaussuunnitelma",
        "Kontrollien toteutuskehys",
        "Todisteiden keruun ohjeet",
        "Sisäinen auditointiohjelma",
        "Ulkoisen auditoinnin valmistelu",
        "Luottamuspalvelukriteerien noudattaminen",
        "Jatkuva valmiuspalvelu"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Vahvista asiakkaiden luottamusta",
        "Erota kilpailijoista",
        "Täytä sääntelyvaatimukset",
        "Paranna tietoturvaa",
        "Nopeuta myyntiprosessia"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getLevelColor(color: string) {
  switch(color) {
    case 'green': return 'border-l-4 border-green-500';
    case 'blue': return 'border-l-4 border-blue-500';
    case 'purple': return 'border-l-4 border-purple-500';
    default: return 'border-l-4 border-blue-500';
  }
}

function getIconColor(color: string) {
  switch(color) {
    case 'green': return 'text-green-600';
    case 'blue': return 'text-blue-600';
    case 'purple': return 'text-purple-600';
    default: return 'text-blue-600';
  }
}
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#1E2A7A] to-[#3bb1f6] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6] transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#3B82F6] group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E40AF] group-hover:text-[#3bb1f6] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Trust Services Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.trustServices.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.trustServices.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.trustServices.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#3B82F6]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#3B82F6] group-hover:to-[#3bb1f6] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#3B82F6] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1.5 group-hover:text-[#3bb1f6] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.criteria.map((criterion) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <svg class="w-3 h-3 text-[#3B82F6] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {criterion}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#3B82F6] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#1E2A7A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:border-[#3B82F6]
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#3B82F6] to-[#3bb1f6] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#3B82F6] to-[#1E2A7A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E40AF] mb-1 group-hover:text-[#3bb1f6] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#3B82F6] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#3B82F6] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#3B82F6] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>