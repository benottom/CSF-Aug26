---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';
import { t, getLanguageFromPath, getLanguagePrefix } from '@/utils/language';

// SEO Configuration
const seoConfig = {
  title: "Regulatory Compliance Services | EU Cybersecurity & Data Protection",
  description: "Comprehensive regulatory compliance services for NIS2, DORA, GDPR, eIDAS, and ePrivacy. Expert guidance for Finnish organizations.",
  keywords: "regulatory compliance, NIS2, DORA, GDPR, eIDAS, ePrivacy, Finland",
  type: "service" as const,
};

const currentPath = Astro.url.pathname;
const lang = getLanguageFromPath(currentPath);
const langPrefix = getLanguagePrefix(lang);

const title = t('regulatoryComplianceTitle', lang);
const tagline = t('regulatoryComplianceTagline', lang);

const items = [
  {
    title: t('nis2ComplianceTitle', lang),
    href: `${langPrefix}/services/nis2-compliance`,
    description: t('nis2ComplianceDesc', lang),
    icon: "shield-check"
  },
  {
    title: t('doraComplianceTitle', lang),
    href: `${langPrefix}/services/dora-compliance`,
    description: t('doraComplianceDesc', lang),
    icon: "building-library"
  },
  {
    title: t('gdprPrivacyTitle', lang),
    href: `${langPrefix}/services/gdpr-privacy-services`,
    description: t('gdprPrivacyDesc', lang),
    icon: "lock-closed"
  },
  {
    title: t('eidasDigitalTrustTitle', lang),
    href: `${langPrefix}/services/eidas-digital-trust`,
    description: t('eidasDigitalTrustDesc', lang),
    icon: "globe-alt"
  },
  {
    title: t('eprivacyCookieTitle', lang),
    href: `${langPrefix}/services/regulatory-compliance/eprivacy-cookie-compliance`,
    description: t('eprivacyCookieDesc', lang),
    icon: "cookie"
  }
];

const stats = [
  { value: "5+", label: lang === 'fi' ? 'Säädöskehikkoa' : 'Regulatory Frameworks' },
  { value: "100%", label: lang === 'fi' ? 'Vaatimusten kattavuus' : 'Requirements Coverage' },
  { value: "24/7", label: lang === 'fi' ? 'Asiantuntijatuki' : 'Expert Support' },
  { value: "98%", label: lang === 'fi' ? 'Asiakastyytyväisyys' : 'Client Satisfaction' }
];
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {title}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {tagline}
        </p>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-8 bg-slate-50 border-b border-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-bold text-[#003580] mb-1">
              {stat.value}
            </div>
            <div class="text-slate-500 text-sm">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {lang === 'fi' ? 'Sääntelypalvelumme' : 'Our Regulatory Services'}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {lang === 'fi' 
            ? 'Kattavat ratkaisut kaikkiin keskeisiin kyberturvallisuuden ja tietosuojan sääntelyvaatimuksiin.'
            : 'Comprehensive solutions for all key cybersecurity and data protection regulatory requirements.'}
        </p>
      </div>

      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((item) => (
          <a href={item.href} class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group cursor-pointer text-center">
            
            <div class="flex justify-center mb-3 relative">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-center">
              {item.title}
            </h3>
            
            <p class="text-xs text-slate-500 mb-3 group-hover:text-slate-600 transition-colors duration-300 text-center flex-1">
              {item.description}
            </p>
            
            <div class="mt-auto pt-3 border-t-2 border-slate-200 group-hover:shadow-md transition-colors duration-300">
              <span class="inline-flex items-center text-[#14171a] group-hover:text-[#003580] font-semibold text-xs gap-1 transition-all duration-300">
                {lang === 'fi' ? 'Tutustu palveluun' : 'Explore Service'}
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>