  keywords: lang === 'fi'
    ? "CISO palveluna, virtuaalinen CISO, tietoturva johto, kyberturvallisuus konsultointi, riskienhallinta, vaatimustenmukaisuus"
    : "CISO as a service, virtual CISO, security leadership, cybersecurity consulting, risk management, compliance",
  type: "product" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "CISO-as-a-Service",
    "description": "Expert Chief Information Security Officer services without the full-time commitment",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "url": "https://cybersecurity.fi"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Finland"
    },
    "offers": {
      "@type": "Offer",
      "price": "Contact for pricing",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
