                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section - Enhanced with prominent styling -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-blue-50 rounded-2xl border-2 border-[#003580] shadow-lg p-6 md:p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#003580] rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl md:text-2xl font-bold text-[#131c2e]">{currentContent.overview.title}</h2>
        </div>
        <p class="text-slate-700 leading-relaxed mb-4 pl-14">{currentContent.overview.description}</p>
        <div class="bg-white/70 rounded-xl border border-[#003580]/30 p-4 pl-14">
          <p class="text-[#131c2e] font-semibold flex items-start gap-2">
            <svg class="w-5 h-5 text-[#003580] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {currentContent.overview.highlight}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CISO Responsibilities Section - Improved with better visual balance -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.cisoResponsibilities.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.cisoResponsibilities.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
        {currentContent.cisoResponsibilities.items.map((category) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-3 relative z-10">
              <div class="w-8 h-8 bg-[#003580]/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-[#003580]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {category.category}
              </h3>
            </div>
            
            <ul class="space-y-1.5 relative z-10">
              {category.responsibilities.map((responsibility) => (
                <li class="flex items-start text-xs text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="leading-relaxed">{responsibility}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Service Plans Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.servicePlans.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.servicePlans.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.servicePlans.items.map((plan) => (
          <div class={`bg-white rounded-xl border-2 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden
                      ${plan.popular ? 'border-[#003580]' : 'border-slate-100'}`}>
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            {plan.popular && (
              <div class="flex justify-center mb-3 relative z-10">
                <span class="bg-[#003580] text-white text-xs font-medium px-3 py-1 rounded-[2px]">
                  {isFi ? 'Suosituin' : 'Most Popular'}
                </span>
              </div>
            )}
            
            <div class="text-center mb-4 relative z-10">
              <h3 class="text-lg font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {plan.name}
              </h3>
              <p class="text-xs text-slate-500 mt-1">{plan.commitment}</p>
              <p class="text-sm font-semibold text-[#131c2e] mt-1">{plan.hours}</p>
              <p class="text-xs text-slate-600 mt-2">{plan.description}</p>
            </div>
            
            <div class="mb-4 relative z-10">
              <p class="text-xs font-semibold text-[#14171a] mb-1">{isFi ? 'Sopii:' : 'Suitable for:'}</p>
              <p class="text-xs text-slate-600">{plan.suitable}</p>
            </div>
            
            <ul class="space-y-1.5 mb-4 relative z-10 flex-grow">
              {plan.features.map((feature) => (
                <li class="flex items-start text-xs text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                  <svg class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
            
            <a href={`/contact?package=ciso-${plan.name.toLowerCase().replace(' ', '-')}`} 
               class={`relative z-10 inline-flex items-center justify-center px-4 py-2 rounded-[2px] text-sm font-medium transition-all duration-300
                       ${plan.popular 
                         ? 'bg-[#131c2e] text-white hover:bg-[#003580] hover:shadow-lg' 
                         : 'border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent'}`}>
              {isFi ? 'Aloita' : 'Get Started'}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industry Expertise Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.industryExpertise.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.industryExpertise.subtitle}
        </p>
      </div>
      
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">        {currentContent.industryExpertise.items.map((industry) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-lg font-bold text-[#14171a] mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {industry.industry}
            </h3>
            
            <div class="mb-3 relative z-10">
              <h4 class="text-xs font-semibold text-[#14171a] mb-1.5">{isFi ? 'Keskeiset säädökset:' : 'Key Regulations:'}</h4>
              <div class="flex flex-wrap gap-1.5">
                {industry.regulations.map((regulation) => (
                  <span class="bg-[#003580]/10 text-[#14171a] text-xs px-2 py-0.5 rounded-[2px]">{regulation}</span>
                ))}
              </div>
            </div>
            
            <div class="mb-3 relative z-10">
              <h4 class="text-xs font-semibold text-[#14171a] mb-1.5">{isFi ? 'Yleiset haasteet:' : 'Common Challenges:'}</h4>
              <ul class="space-y-1">
                {industry.challenges.map((challenge) => (
                  <li class="flex items-start text-xs text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                    <span class="w-1 h-1 bg-[#003580] rounded-full mr-2 mt-1.5 flex-shrink-0"></span>
                    {challenge}
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="relative z-10">
              <h4 class="text-xs font-semibold text-[#14171a] mb-1">{isFi ? 'Kokemuksemme:' : 'Our Experience:'}</h4>
              <p class="text-xs text-slate-600">{industry.experience}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credentials Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.credentials.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.credentials.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.credentials.items.map((credential) => (
          <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col items-center p-5 text-center group">
            <div class="w-14 h-14 bg-[#131c2e] rounded-full flex items-center justify-center text-white font-bold text-sm mb-3">
              {credential.credential}
            </div>
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300">
              {credential.credential}
            </h3>
            <p class="text-xs text-slate-500 mb-2">{credential.description}</p>
            <p class="text-xs text-slate-500">{credential.focus}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.implementation.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.implementation.subtitle}
        </p>
      </div>
      
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">        {currentContent.implementation.items.map((phase) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {phase.phase}
            </h3>
            
            <ul class="space-y-2 relative z-10">
              {phase.activities.map((activity) => (
                <li class="flex items-start text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                  <svg class="w-3.5 h-3.5 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {activity}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.deliverables.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.deliverables.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {currentContent.deliverables.items.map((delivery) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-3 text-center group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {isFi 
                ? (delivery.frequency === 'Monthly' ? 'Kuukausittain' : delivery.frequency === 'Quarterly' ? 'Kvartaaleittain' : 'Vuosittain')
                : delivery.frequency}
            </h3>
            
            <ul class="space-y-2 relative z-10">
              {delivery.deliverables.map((item) => (
                <li class="flex items-start text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                  <svg class="w-3.5 h-3.5 text-[#003580] mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.benefitsList.title}
        </h2>
      </div>
      
      <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-3">
        {currentContent.benefitsList.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-3 group">
            <div class="w-6 h-6 bg-[#003580] rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-[#003580] transition-colors duration-300">{benefit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>