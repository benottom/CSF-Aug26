          timeline: "Months 2-4"
        },
        {
          pillar: "Digital Operational Resilience Testing",
          description: "Establish comprehensive testing framework for ICT systems, applications, and operational processes",
          requirements: [
            "Testing strategy and methodology",
            "Vulnerability assessments",
            "Threat-led penetration testing",
            "Scenario-based testing",
            "Testing documentation and reporting",
            "Red team exercises"
          ],
          timeline: "Months 3-6"
        },
        {
          pillar: "Third-party ICT Service Provider Management",
          description: "Comprehensive management of risks from ICT third-party dependencies and critical service providers",
