---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

// SEO Configuration
const seoConfig = {
  title: lang === 'fi' ? "DORA-ohjelma-laatikossa | Cyber Security Finland" : "DORA Program-in-a-Box | Cyber Security Finland",
  description: lang === 'fi'
    ? "Kokonaisvaltainen DORA-direktiivin toteutusohjelma 75-105 päivässä. ICT-riskinhallinta, kolmannen osapuolen riskit ja operaattorisen resilierenssin testaus mukana."
    : "Comprehensive DORA directive implementation program in 75-105 days. ICT risk management, third-party risks, and operational resilience testing included.",
  keywords: lang === 'fi'
    ? "DORA Suomi, DORA direktiivi, DORA yhteensopivuus, DORA toteutus, digitaalinen operatiivinen resilierenssi, rahoituspalvelut Suomi"
    : "DORA finland, DORA directive, DORA compliance, DORA implementation, digital operational resilience, financial services finland",
  type: "product" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "DORA Program-in-a-Box",
    "description": "Complete Digital Operational Resilience Act implementation for financial services organizations",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "url": "https://cybersecurity.fi"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Finland"
    },
    "offers": {
      "@type": "Offer",
      "price": "Contact for pricing",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": "Cyber Security Finland"
      }
    },
    "serviceType": "DORA Implementation and Digital Operational Resilience",
    "availableLanguage": ["English", "Finnish"]
  }
};

const content = {
  en: {
    title: "DORA Program-in-a-Box",
    subtitle: "Digital Operational Resilience Excellence",
    heroDescription: "Digital Operational Resilience Act (DORA) compliance program for financial institutions and critical third-party ICT service providers, covering ICT risk management, incident response, operational resilience testing, and third-party risk management. DORA has been applicable since 17 January 2025 — this is an ongoing compliance obligation, not a one-time deadline.",
    forWho: "For financial institutions and critical ICT third-party service providers subject to DORA regulations.",
    achieve: "Full DORA compliance with digital operational resilience capabilities, and an ongoing program to maintain it.",
    overview: {
      title: "Overview",
      description: "The Digital Operational Resilience Act (DORA) establishes uniform requirements for the security of network and information systems supporting the business processes of financial entities and critical ICT third-party service providers in the EU.",
      highlight: "DORA compliance is mandatory for all in-scope financial entities and has been enforced since 17 January 2025. Significant fines and sanctions apply for non-compliance."
    },
    doraPillars: {
      title: "DORA's Five Pillars of Digital Resilience",
      subtitle: "Our comprehensive program addresses all five pillars of DORA with detailed implementation guidance and tools",
      items: [
        {
          pillar: "ICT Risk Management Framework",
          description: "Establish comprehensive ICT risk management framework with governance, strategy, and risk appetite alignment",
          requirements: [
            "ICT risk management policy and procedures",
            "Risk assessment methodologies",
            "ICT asset inventory and dependency mapping",
            "Risk monitoring and KRI frameworks",
            "Regular risk assessment updates",
            "Integration with operational risk management"
          ],
          timeline: "Months 1-3"
        },
        {
          pillar: "ICT Incident Management & Reporting",
          description: "Implement robust incident detection, classification, management, and regulatory reporting capabilities",
