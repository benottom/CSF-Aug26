---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

// SEO Configuration
const seoConfig = {
  title: lang === 'fi' ? "ISO 27001 Fast-Track (90–120 päivää) | Cyber Security Finland" : "ISO 27001 Fast‑Track (90–120 days) | Cyber Security Finland",
  description: lang === 'fi'
    ? "Nopea ISO 27001 -toteutus 90-120 päivässä. Kattava tietoturvajärjestelmän toteutus, dokumentointi, koulutus ja sertifiointituki mukana."
    : "Fast-track ISO 27001 implementation in 90-120 days. Complete ISMS implementation, documentation, training, and certification support included.",
  keywords: lang === 'fi'
    ? "ISO 27001 Suomi, ISO 27001 nopea toteutus, ISO 27001 sertifiointi, tietoturvajärjestelmä Suomi, ISO 27001 konsultointi"
    : "ISO 27001 finland, ISO 27001 fast track, ISO 27001 certification, information security management system, ISO 27001 consulting",
  type: "product" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "ISO 27001 Fast-Track Package",
    "description": "Complete ISO 27001 Information Security Management System implementation in 90-120 days with expert guidance and ongoing support",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "url": "https://cybersecurity.fi"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Finland"
    },
    "offers": {
      "@type": "Offer",
      "price": "Contact for pricing",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": "Cyber Security Finland"
      }
    },
    "serviceType": "ISO 27001 Implementation and Certification",
    "availableLanguage": ["English", "Finnish"]
  }
};

const content = {
  en: {
    title: "ISO 27001 Fast-Track",
    subtitle: "Accelerated Certification Program",
    heroDescription: "Transform your information security management in just 3-4 months with our proven fast-track methodology. This all-inclusive program takes you from initial assessment to ISO 27001 certification with everything you need included.",
    forWho: "For organizations seeking rapid ISO 27001 certification to meet customer requirements and win new business opportunities.",
    achieve: "ISO 27001 certification in 90-120 days with comprehensive implementation and audit support.",
    overview: {
      title: "Overview",
      description: "ISO 27001 Fast-Track is a comprehensive implementation program designed to take your organization from zero to certified in just 90-120 days. Our proven methodology combines expert guidance, pre-built documentation, and structured implementation to accelerate your certification journey.",
      highlight: "Join over 50 organizations that have achieved ISO 27001 certification with our fast-track program, featuring a 95% first-time certification success rate."
    },
    phases: {
      title: "Implementation Process",
      subtitle: "Structured 16-week methodology from assessment to certification",
      items: [
        { number: "01", title: "Assessment & Planning", description: "Security posture assessment, gap analysis, and implementation roadmap" },
        { number: "02", title: "Implementation", description: "ISMS design, policy library development, and control deployment" },
        { number: "03", title: "Training & Documentation", description: "Staff training, documentation package, and systems setup" },
        { number: "04", title: "Certification & Support", description: "Audit preparation, certification body liaison, and post-certification support" }
      ]
    },
    packageIncludes: {
      title: "What's Included",
      items: [
        {
          title: "Complete ISO 27001 Implementation",
          description: "End-to-end ISMS implementation with expert guidance",
          icon: "shield-check"
        },
        {
          title: "All Required Documentation",
          description: "50+ policies, procedures, and templates included",
          icon: "document"
        },
        {
          title: "Staff Training Program",
          description: "Comprehensive training for up to 20 employees",
          icon: "users"
        },
        {
          title: "Internal Audit & Gap Analysis",
          description: "Full internal audit and remediation support",
          icon: "clipboard-check"
        },
        {
          title: "Certification Audit Support",
          description: "Complete support through external certification audit",
          icon: "award"
        },
        {
          title: "Post-Certification Support",
          description: "3 months of ongoing support after certification",
          icon: "support"
        }
      ]
    },
    benefits: {
      title: "Key Benefits",
      items: [
        "Achieve certification 3x faster than traditional approaches",
        "Comprehensive documentation package included",
        "Dedicated project manager assigned",
        "Weekly progress reviews and reporting",
        "Post-certification maintenance support",
        "Risk register and treatment plan",
        "Employee training and awareness program",
        "Incident response procedures"
      ]
    },
    process: {
      title: "Why Choose Fast-Track?",
      subtitle: "Accelerate your ISO 27001 certification with our proven methodology",
      items: [
        { number: "01", title: "Time to Market", description: "Get certified quickly to meet customer requirements and win new business opportunities" },
        { number: "02", title: "Proven Success", description: "95% first-time certification success rate with our fast-track methodology" },
        { number: "03", title: "Cost Effective", description: "Fixed-price package with no hidden costs or scope creep concerns" },
        { number: "04", title: "Expert Guidance", description: "Dedicated project manager and expert team throughout your certification journey" },
        { number: "05", title: "Comprehensive Package", description: "All required documentation, training, and audit support included" },
        { number: "06", title: "Ongoing Support", description: "12 months of post-certification support to maintain your ISMS" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "Certification readiness assessment",
        "Complete ISMS implementation",
        "Policy library (50+ policies)",
        "Risk register and treatment plan",
        "Internal audit program",
        "Staff training materials",
        "Certification audit support",
        "Post-certification maintenance"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Rapid certification in 90-120 days",
        "Expert guidance throughout the journey",
        "Comprehensive documentation included",
        "95% first-time success rate",
        "Fixed-price with no hidden costs"
      ]
    }
  },
  fi: {
    title: "ISO 27001 Fast-Track",
    subtitle: "Nopeutettu sertifiointiohjelma",
    heroDescription: "Muuta tietoturvasi hallinta vain 3-4 kuukaudessa todistetulla fast-track -menetelmällämme. Tämä kattava ohjelma vie sinut alkukartoituksesta ISO 27001 -sertifiointiin sisältäen kaiken tarvittavan.",
    forWho: "Organisaatioille, jotka tavoittelevat nopeaa ISO 27001 -sertifiointia täyttääkseen asiakasvaatimukset ja voittaakseen uusia liiketoimintamahdollisuuksia.",
    achieve: "ISO 27001 -sertifiointi 90-120 päivässä kattavalla toteutuksella ja auditointituella.",
    overview: {
      title: "Yleiskatsaus",
      description: "ISO 27001 Fast-Track on kattava toteutusohjelma, joka vie organisaatiosi nollasta sertifioituun vain 90-120 päivässä. Todistettu menetelmämme yhdistää asiantuntijaohjauksen, valmiin dokumentaation ja rakenteellisen toteutuksen sertifiointimatkasi nopeuttamiseksi.",
      highlight: "Yli 50 organisaatiota on saavuttanut ISO 27001 -sertifioinnin fast-track-ohjelmamme avulla 95%:n ensimmäisen kerran onnistumisprosentilla."
    },
    phases: {
      title: "Toteutusprosessi",
      subtitle: "Rakenteinen 16 viikon menetelmä arvioinnista sertifiointiin",
      items: [
        { number: "01", title: "Arviointi & Suunnittelu", description: "Tietoturvan tilan arviointi, puuteanalyysi ja toteutussuunnitelma" },
        { number: "02", title: "Toteutus", description: "ISMS-suunnittelu, politiikkakirjasto ja kontrollien käyttöönotto" },
        { number: "03", title: "Koulutus & Dokumentaatio", description: "Henkilöstön koulutus, dokumentaatiopaketti ja järjestelmien asennus" },
        { number: "04", title: "Sertifiointi & Tuki", description: "Auditointivalmistelu, sertifiointielimen yhteistyö ja sertifioinnin jälkeinen tuki" }
      ]
    },
    packageIncludes: {
      title: "Paketti sisältää",
      items: [
        {
          title: "Täydellinen ISO 27001 -toteutus",
          description: "Päästä päähän -ISMS-toteutus asiantuntijaohjauksella",
          icon: "shield-check"
        },
        {
          title: "Kaikki vaadittu dokumentaatio",
          description: "50+ käytäntöä, menettelytapaa ja mallia mukana",
          icon: "document"
        },
        {
          title: "Henkilöstön koulutusohjelma",
          description: "Kattava koulutus jopa 20 työntekijälle",
          icon: "users"
        },
        {
          title: "Sisäinen auditointi & puuteanalyysi",
          description: "Täysi sisäinen auditointi ja korjaustuki",
          icon: "clipboard-check"
        },
        {
          title: "Sertifiointiauditoinnin tuki",
          description: "Täydellinen tuki ulkoisen sertifiointiauditoinnin läpi",
          icon: "award"
        },
        {
          title: "Sertifioinnin jälkeinen tuki",
          description: "3 kuukauden jatkuva tuki sertifioinnin jälkeen",
          icon: "support"
        }
      ]
    },
    benefits: {
      title: "Keskeiset edut",
      items: [
        "Saavuta sertifiointi 3x nopeammin",
        "Kattava dokumentaatiopaketti sisältyy hintaan",
        "Oma nimetty projektipäällikkö",
        "Viikoittaiset edistymiskatsaukset",
        "Sertifioinnin jälkeinen ylläpitotuki",
        "Riskirekisteri ja käsittelysuunnitelma",
        "Henkilöstön koulutusohjelma",
        "Häiriönhallintamenettelyt"
      ]
    },
    process: {
      title: "Miksi valita Fast-Track?",
      subtitle: "Nopeuta ISO 27001 -sertifiointiasi todistetulla menetelmällämme",
      items: [
        { number: "01", title: "Nopeampi sertifiointi", description: "Saavuta sertifiointi 3x nopeammin kuin perinteisillä tavoilla" },
        { number: "02", title: "Todistettu menestys", description: "95%:n ensimmäisen kerran onnistumisprosentti fast-track-menetelmällämme" },
        { number: "03", title: "Kustannustehokas", description: "Kiinteähintainen paketti ilman piilokustannuksia" },
        { number: "04", title: "Asiantuntijaohjaus", description: "Oma projektipäällikkö ja asiantuntijatiimi koko matkan ajan" },
        { number: "05", title: "Kattava paketti", description: "Kaikki tarvittava dokumentaatio, koulutus ja auditointituki mukana" },
        { number: "06", title: "Jatkuva tuki", description: "12 kuukauden tuki sertifioinnin jälkeen ISMS:n ylläpitoon" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "Sertifiointivalmiusarviointi",
        "Täydellinen ISMS-toteutus",
        "Politiikkakirjasto (50+ käytäntöä)",
        "Riskirekisteri ja käsittelysuunnitelma",
        "Sisäinen auditointiohjelma",
        "Henkilöstön koulutusmateriaalit",
        "Sertifiointiauditoinnin tuki",
        "Sertifioinnin jälkeinen ylläpito"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Nopea sertifiointi 90-120 päivässä",
        "Asiantuntijaohjaus koko matkan ajan",
        "Kattava dokumentaatio mukana",
        "95% ensimmäisen kerran onnistumisprosentti",
        "Kiinteähintainen ilman piilokustannuksia"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-4.5 h-4.5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-gradient-to-br from-blue-50 to-indigo-50/30 rounded-2xl border-2 border-[#0EA5E9] shadow-lg p-6 md:p-8">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-10 h-10 bg-[#0EA5E9] rounded-xl flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-xl md:text-2xl font-bold text-[#0F172A]">{currentContent.overview.title}</h2>
        </div>
        <p class="text-slate-700 leading-relaxed mb-4 pl-14">{currentContent.overview.description}</p>
        <div class="bg-white/70 rounded-xl border border-[#0EA5E9]/30 p-4 pl-14">
          <p class="text-[#0F172A] font-semibold flex items-start gap-2">
            <svg class="w-5 h-5 text-[#0EA5E9] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {currentContent.overview.highlight}
          </p>
        </div>
      </div>
    </div>
  </section>

  
  <!-- Package Includes Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.packageIncludes.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {isFi 
            ? 'Kattava paketti joka sisältää kaiken tarvittavan sertifiointiin'
            : 'Comprehensive package includes everything needed for certification'}
        </p>
      </div>

      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.packageIncludes.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-3 relative z-10">
              <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1.5 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
      </div>
      
      <div class="max-w-3xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-3">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-3 group">
            <div class="w-6 h-6 bg-[#0EA5E9] rounded-lg flex items-center justify-center flex-shrink-0">
              <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <span class="text-sm font-medium text-slate-700 group-hover:text-[#0EA5E9] transition-colors duration-300">{benefit}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Fast-Track Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.process.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {item.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits List -->
        <div class="bg-white rounded-xl border-2 border-[#0EA5E9] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#0EA5E9] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg class="w-3.5 h-3.5 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>