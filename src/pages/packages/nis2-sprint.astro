const currentContent = content[lang];
const isFi = lang === 'fi';

function getStatusClass(status: string) {
  if (status === 'Completed' || status === 'Valmis') return 'bg-green-100 text-green-700';
  if (status === 'Active' || status === 'Aktiivinen') return 'bg-orange-100 text-orange-700';
  if (status === 'Ongoing' || status === 'Jatkuva') return 'bg-blue-100 text-blue-700';
  return 'bg-slate-100 text-slate-700';
}
