            <ul class="space-y-1.5 relative z-10">
              {phase.objectives.map((objective) => (
                <li class="flex items-start text-[10px] text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                  <svg class="w-2.5 h-2.5 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {objective}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

<!-- Compliance Timeline Section -->
<section class="py-12 md:py-16 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 md:mb-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
        {currentContent.complianceTimeline.title}
      </h2>
      <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
        {currentContent.complianceTimeline.subtitle}
      </p>
    </div>
    
    <div class="max-w-3xl mx-auto space-y-3">
      {currentContent.complianceTimeline.items.map((milestone) => (
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                    hover:shadow-md hover:shadow-md
                    transition-all duration-300
                    flex items-center p-4 md:p-5 group">
          <div class="w-3 h-3 rounded-full mr-4 flex-shrink-0 bg-[#003580]"></div>
          <div class="flex-1">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <h3 class="text-sm font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {milestone.milestone}
              </h3>
              <span class="text-[10px] font-medium px-2 py-0.5 rounded-[2px] bg-[#003580]/10 text-[#003580]">
                {milestone.status}
              </span>
            </div>
            <p class="text-[10px] text-slate-500">{milestone.date}</p>
            <p class="text-[10px] text-slate-600">{milestone.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

  <!-- Penalties Section -->
