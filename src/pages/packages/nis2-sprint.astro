  type: "product" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "NIS2 Compliance Program",
    "description": "Structured NIS2 directive compliance program for essential and important entities",
    "provider": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "url": "https://cybersecurity.fi"
    },
    "areaServed": {
      "@type": "Country",
      "name": "Finland"
    },
    "offers": {
      "@type": "Offer",
      "price": "Contact for pricing",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "seller": {
        "@type": "Organization",
        "name": "Cyber Security Finland"
      }
    },
    "serviceType": "NIS2 Directive Implementation and Compliance",
    "availableLanguage": ["English", "Finnish"]
  }
