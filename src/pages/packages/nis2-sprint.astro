          {currentContent.penalties.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {currentContent.penalties.items.map((penalty) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-center gap-2 mb-2 relative z-10">
              <div class="w-6 h-6 bg-red-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-3.5 h-3.5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" />
                </svg>
              </div>
              <h3 class="text-sm font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {penalty.severity}
              </h3>
            </div>
            <p class="text-sm font-bold text-red-600 mb-1.5 relative z-10">{penalty.amount}</p>
            <p class="text-[10px] text-slate-500 mb-1 relative z-10">
              <span class="font-semibold text-[#14171a]">{isFi ? 'Koskee:' : 'Applies to:'}</span> {penalty.applies_to}
            </p>
            <p class="text-[10px] text-slate-600 relative z-10">{penalty.violations}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

