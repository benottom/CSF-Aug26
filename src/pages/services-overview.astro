---
import Layout from '@layouts/Layout.astro';
import Icon from '@ui/icons/Icon.astro';
import Button from '@ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const serviceCategories = [
  {
    title: lang === 'fi' ? 'Sääntelyvaatimukset' : 'Regulatory Compliance',
    description: lang === 'fi' 
      ? 'Täysi yhteensopivuus GDPR, NIS2, DORA ja muiden sääntelyvaatimusten kanssa.' 
      : 'Full compliance with GDPR, NIS2, DORA, and other regulatory requirements.',
    icon: 'shield-check',
    services: [
      {
        name: lang === 'fi' ? 'GDPR-yhteensopivuus' : 'GDPR Compliance',
        description: lang === 'fi' 
          ? 'Tietosuojan hallinta ja vaatimustenmukaisuus EU:n yleisen tietosuoja-asetuksen mukaisesti.' 
          : 'Privacy governance and compliance with the EU General Data Protection Regulation.',
        href: '/services/gdpr-compliance',
        level: 'Enterprise'
      },
      {
        name: lang === 'fi' ? 'NIS2-direktiivi' : 'NIS2 Directive',
        description: lang === 'fi' 
          ? 'Verkko- ja informaatioturvallisuuden parantaminen koko EU:ssa.' 
          : 'Network and information security improvements across the EU.',
        href: '/services/nis2-compliance',
        level: 'Strategic'
      },
      {
        name: lang === 'fi' ? 'DORA-sääntely' : 'DORA Regulation',
        description: lang === 'fi' 
          ? 'Digitaalisen toiminnan resilierenssin vaatimukset rahoitussektorille.' 
          : 'Digital operational resilience requirements for the financial sector.',
        href: '/services/dora-compliance',
        level: 'Strategic'
      }
    ]
  },
  {
    title: lang === 'fi' ? 'Standardit ja sertifiointi' : 'Standards & Certification',
    description: lang === 'fi' 
      ? 'ISO 27001, SOC 2 ja muiden kansainvälisten standardien toteutus ja ylläpito.' 
      : 'Implementation and maintenance of ISO 27001, SOC 2, and other international standards.',
    icon: 'document-check',
    services: [
      {
        name: 'ISO 27001',
        description: lang === 'fi' 
          ? 'Informaation turvallisuuden hallintajärjestelmän toteutus ja sertifiointi.' 
          : 'Information security management system implementation and certification.',
        href: '/services/iso-27001',
        level: 'Enterprise'
      },
      {
        name: 'SOC 2',
        description: lang === 'fi' 
          ? 'Pilvipalveluiden tietoturvan ja yksityisyydensuojan sertifiointi.' 
          : 'Security and privacy controls certification for cloud services.',
        href: '/services/soc-2',
        level: 'Enterprise'
      },
      {
        name: 'Common Criteria',
        description: lang === 'fi' 
          ? 'Tietotekniikan turvallisuuden arviointi ja varmentaminen kansainvälisillä standardeilla.' 
          : 'Evaluation and certification of IT security products using international standards.',
        href: '/services/common-criteria',
        level: 'Specialized'
      }
    ]
  },
  {
    title: lang === 'fi' ? 'Johtaminen ja strategia' : 'Governance & Strategy',
    description: lang === 'fi' 
      ? 'Kyberturvallisuuden johtaminen, strategian kehittäminen ja riskienhallinta.' 
      : 'Cybersecurity leadership, strategy development, and risk management.',
    icon: 'building-office',
    services: [
      {
        name: lang === 'fi' ? 'V-CISO-palvelu' : 'V-CISO Service',
        description: lang === 'fi' 
          ? 'Virtuaalinen pääkäyttöturvallisuuspäällikkö organisaatiollesi.' 
          : 'Virtual Chief Information Security Officer for your organization.',
        href: '/services/virtual-ciso',
        level: 'Strategic'
      },
      {
        name: lang === 'fi' ? 'V-DPO-palvelu' : 'V-DPO Service',
        description: lang === 'fi' 
          ? 'Virtuaalinen tietosuojavastaava tietosuojan hallintaan.' 
          : 'Virtual Data Protection Officer for privacy governance.',
        href: '/services/virtual-dpo',
        level: 'Strategic'
      },
      {
        name: lang === 'fi' ? 'Riskienhallinta' : 'Risk Management',
        description: lang === 'fi' 
          ? 'Järjestelmällinen riskien tunnistaminen, arviointi ja hallinta.' 
          : 'Systematic identification, assessment, and treatment of risks.',
        href: '/services/risk-management',
        level: 'Strategic'
      }
    ]
  }
];
---

<Layout 
  title={lang === 'fi' ? 'Palvelut - Cyber Security Finland' : 'Services - Cyber Security Finland'}
  description={lang === 'fi' 
    ? 'Tutustu Cyber Security Finlandin tarjoamiin kyberturvallisuuden ja sääntelyn noudattamisen palveluihin.' 
    : 'Explore Cyber Security Finland\'s cybersecurity and compliance services.'}
>
  <div class="min-h-screen bg-slate-50">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white py-20">
      <div class="container-professional text-center">
        <h1 class="heading-primary text-white mb-6">
          {lang === 'fi' ? 'Kattavat palvelumme' : 'Our Comprehensive Services'}
        </h1>
        <p class="text-xl text-slate-200 max-w-3xl mx-auto">
          {lang === 'fi' 
            ? 'Strategista kyberturvallisuutta ja sääntelyn noudattamista tukevia palveluita, jotka on suunniteltu vastaamaan nykyaikaisiin haasteisiin.' 
            : 'Strategic cybersecurity and compliance services designed to address modern challenges and requirements.'}
        </p>
      </div>
    </section>

    <!-- Services by Category -->
    <section class="py-20">
      <div class="container-professional">
        <div class="text-center mb-16">
          <h2 class="heading-primary mb-4">
            {lang === 'fi' ? 'Palveluluokat' : 'Service Categories'}
          </h2>
          <p class="text-paragraph max-w-3xl mx-auto text-slate-600">
            {lang === 'fi' 
              ? 'Järjestelmällinen lähestymistapa kyberturvallisuuden hallintaan eri toimialoilla ja organisaatiotasoilla.' 
              : 'Systematic approach to cybersecurity governance across industries and organizational levels.'}
          </p>
        </div>

        <div class="grid grid-3col gap-8">
          {serviceCategories.map(category => (
            <div class="card-professional group">
              <div class="flex items-center mb-6">
                <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                  <Icon name={category.icon} class="w-6 h-6 text-blue-600" />
                </div>
                <h3 class="heading-secondary ml-4">
                  {category.title}
                </h3>
              </div>
              <p class="text-paragraph text-slate-600 mb-8">
                {category.description}
              </p>
              
              <div class="space-y-6">
                {category.services.map(service => (
                  <div class="border border-slate-200 rounded-lg p-5 hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start">
                      <div>
                        <h4 class="font-semibold text-slate-900 mb-2">{service.name}</h4>
                        <p class="text-sm text-slate-600 mb-3">{service.description}</p>
                      </div>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                        {service.level}
                      </span>
                    </div>
                    <a 
                      href={service.href}
                      class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm mt-2"
                    >
                      {lang === 'fi' ? 'Lue lisää' : 'Learn more'}
                      <Icon name="arrowRight" class="w-4 h-4 ml-1" />
                    </a>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-blue-600 to-cyan-600 text-white">
      <div class="container-professional text-center">
        <h2 class="heading-primary text-white mb-6">
          {lang === 'fi' ? 'Tarvitsetko apua palveluiden valinnassa?' : 'Need help choosing the right services?'}
        </h2>
        <p class="text-xl text-blue-100 max-w-2xl mx-auto mb-8">
          {lang === 'fi' 
            ? 'Asiantuntijatietoomme auttaa sinua tunnistamaan tärkeimmät kyberturvallisuuden ja sääntelyn noudattamisen tarpeet organisaatiossasi.' 
            : 'Our expertise will help you identify the most critical cybersecurity and compliance needs for your organization.'}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <Button href="/contact" variant="white">
            {lang === 'fi' ? 'Ota yhteyttä' : 'Contact Us'}
          </Button>
          <Button href="/consultation" variant="outline-white">
            {lang === 'fi' ? 'Aseta konsultaatiotapaaminen' : 'Schedule Consultation'}
          </Button>
        </div>
      </div>
    </section>
  </div>
</Layout>