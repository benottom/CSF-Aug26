---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import { useState } from 'react';

const seoConfig = {
  title: "Button Showcase | Cyber Security Finland",
  description: "Showcase of improved button designs with enhanced UX and accessibility",
  type: "website"
};

const buttonVariants = [
  { variant: 'primary', label: 'Primary' },
  { variant: 'secondary', label: 'Secondary' },
  { variant: 'tertiary', label: 'Tertiary' },
  { variant: 'white', label: 'White' },
  { variant: 'outline-white', label: 'Outline White' },
  { variant: 'brand', label: 'Brand' },
  { variant: 'danger', label: 'Danger' },
  { variant: 'success', label: 'Success' },
  { variant: 'warning', label: 'Warning' },
  { variant: 'ghost', label: 'Ghost' },
  { variant: 'link', label: 'Link' },
];

const buttonSizes = [
  { size: 'sm', label: 'Small' },
  { size: 'md', label: 'Medium' },
  { size: 'lg', label: 'Large' },
];
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#0F172A]">Button Showcase</span>
        </h1>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          Explore our improved button designs with enhanced UX and accessibility
        </p>
      </div>
      
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 py-16">
    
    <!-- Button Variants Section -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0F172A] mb-6">
        Button Variants
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {buttonVariants.map((item) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
            <h3 class="text-lg font-semibold text-slate-900 mb-4 capitalize">{item.label}</h3>
            <div class="space-y-3">
              <Button variant={item.variant} size="sm">Small</Button>
              <div class="mt-2">
                <Button variant={item.variant} size="md">Medium</Button>
              </div>
              <div class="mt-2">
                <Button variant={item.variant} size="lg">Large</Button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
    
    <!-- Button States Section -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0F172A] mb-6">
        Button States
      </h2>
      <div class="space-y-6">
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Normal State</h3>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary">Primary</Button>
            <Button variant="secondary">Secondary</Button>
            <Button variant="danger">Danger</Button>
          </div>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Disabled State</h3>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary" disabled={true}>Primary</Button>
            <Button variant="secondary" disabled={true}>Secondary</Button>
            <Button variant="danger" disabled={true}>Danger</Button>
          </div>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">Loading State</h3>
          <div class="flex flex-wrap gap-4">
            <Button variant="primary" loading={true}>Loading...</Button>
            <Button variant="secondary" loading={true}>Loading...</Button>
            <Button variant="danger" loading={true}>Loading...</Button>
          </div>
        </div>
        
      </div>
    </section>
    
    <!-- Button Sizes Section -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0F172A] mb-6">
        Button Sizes
      </h2>
      <div class="space-y-6">
        {buttonSizes.map((item) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
            <h3 class="text-lg font-semibold text-slate-900 mb-4 capitalize">{item.label} Buttons</h3>
            <div class="flex flex-wrap gap-4">
              <Button variant="primary" size={item.size}>Primary</Button>
              <Button variant="secondary" size={item.size}>Secondary</Button>
              <Button variant="success" size={item.size}>Success</Button>
              <Button variant="warning" size={item.size}>Warning</Button>
              <Button variant="danger" size={item.size}>Danger</Button>
            </div>
          </div>
        ))}
      </div>
    </section>
    
    <!-- Button with Icons Section -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0F172A] mb-6">
        Button with Icons
      </h2>
      <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
        <div class="flex flex-wrap gap-4">
          <Button variant="primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            With Icon
          </Button>
          <Button variant="secondary">
            Download
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
          </Button>
          <Button variant="ghost">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
            </svg>
          </Button>
        </div>
      </div>
    </section>
    
    <!-- Button Links Section -->
    <section class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#0F172A] mb-6">
        Button Links
      </h2>
      <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 transition-all duration-300">
        <div class="flex flex-wrap gap-4">
          <Button href="/contact" variant="primary">Contact Us</Button>
          <Button href="/services" variant="secondary">Our Services</Button>
          <Button href="/about" variant="ghost">About Us</Button>
        </div>
      </div>
    </section>
    
  </div>

  <!-- CTA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#0F172A]">
          Ready to Use These Buttons?
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          All buttons are consistent with our design system and fully responsive.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#0F172A] to-[#0EA5E9] text-white hover:from-[#0EA5E9] hover:to-[#0F172A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            Get in Touch
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
          <a href="/services" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E293B] text-[#1E293B] hover:bg-gradient-to-r hover:from-[#0F172A] hover:to-[#0EA5E9] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            View Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>