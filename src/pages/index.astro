---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Security Finland | Enterprise Cybersecurity & Compliance Advisory",
  description: "Global cybersecurity and compliance advisory firm. Specialized in ISO 27001, NIS2, GDPR, and DORA compliance across regulated industries. Proven methodologies trusted by enterprises worldwide.",
  keywords: "cybersecurity consulting, ISO 27001 compliance, NIS2 directive, GDPR expert, DORA implementation, information security consulting, enterprise security, compliance advisory, risk management, governance risk compliance",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cyber Security Finland",
    "url": "https://cybersecurity.fi",
    "description": "Enterprise cybersecurity and compliance advisory services. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies for global organizations.",
    "publisher": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cybersecurity.fi/CSFlogoT.png",
        "width": 300,
        "height": 300
      }
    },
    "potentialAction": {
      "@type": "ContactAction",
      "target": "https://cybersecurity.fi/contact",
      "name": "Contact Us"
    }
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Enterprise Cybersecurity & Compliance Advisory",
      subtitle: "Strategic guidance for complex regulatory environments. ISO 27001, NIS2, GDPR, and DORA implementation with proven methodologies trusted by global organizations.",
      primaryCTA: { text: "Request Consultation", href: "/contact" },
      secondaryCTA: { text: "Explore Capabilities", href: "/services" }
    },
    services: {
      title: "Core Capabilities",
      description: "Comprehensive cybersecurity and regulatory compliance solutions for enterprises across regulated industries",
      items: [
        {
          title: "Information Security Management",
          description: "ISO 27001 implementation and certification readiness programs",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Regulatory Compliance",
          description: "NIS2 directive compliance and cybersecurity resilience frameworks",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Data Protection & Privacy",
          description: "GDPR compliance programs and privacy governance frameworks",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Digital Operational Resilience",
          description: "DORA compliance for financial institutions and critical infrastructure",
          icon: "building-library",
          href: "/services/dora-compliance"
        }
      ]
    },
    cta: {
      title: "Transform Your Security Posture",
      subtitle: "Partner with experienced advisors trusted by enterprises in highly regulated industries worldwide.",
      primaryCTA: { text: "Schedule Consultation", href: "/contact" },
      secondaryCTA: { text: "View Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      title: "Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta",
      subtitle: "Strateginen ohjaus monimutkaisissa sääntelyympäristöissä. ISO 27001, NIS2, GDPR ja DORA toteutus todistetuin menetelmin, joihin maailmanlaajuiset organisaatiot luottavat.",
      primaryCTA: { text: "Pyydä konsultaatio", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihin", href: "/services" }
    },
    services: {
      title: "Ydinosaamisalueet",
      description: "Kattavat kyberturvallisuus- ja sääntelyvaatimustenmukaisuusratkaisut yrityksille säännellyillä toimialoilla",
      items: [
        {
          title: "Tietoturvallisuuden hallinta",
          description: "ISO 27001 -toteutus ja sertifiointivalmius-ohjelmat",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Sääntelyvaatimustenmukaisuus",
          description: "NIS2-direktiivin vaatimustenmukaisuus ja kyberturvallisuuden resilienssi",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Tietosuoja ja yksityisyys",
          description: "GDPR-vaatimustenmukaisuusohjelmat ja tietosuojan hallintakehykset",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Digitaalinen toimintakyky",
          description: "DORA-vaatimustenmukaisuus rahoituslaitoksille ja kriittiselle infrastruktuurille",
          icon: "building-library",
          href: "/services/dora-compliance"
        }
      ]
    },
    cta: {
      title: "Muuta turvallisuusasemaasi",
      subtitle: "Kumppani kokeneiden neuvonantajien kanssa, joihin luottavat yritykset erittäin säännellyillä toimialoilla maailmanlaajuisesti.",
      primaryCTA: { text: "Varaa konsultaatio", href: "/contact" },
      secondaryCTA: { text: "Näytä palvelut", href: "/services" }
    }
  }
};

const currentContent = content[lang];

const keyServices = [
  {
    title: "Compliance Frameworks",
    description: "Transform regulatory requirements into competitive advantages. Expert implementation of ISO 27001, SOC 2, GDPR, NIS2, and DORA frameworks with proven fast-track methodologies.",
    icon: "shield-check",
    href: "/services"
  },
  {
    title: "Risk Management",
    description: "Identify, assess, and mitigate cybersecurity risks effectively. Comprehensive risk assessments, third-party risk management, and business continuity planning tailored to your organization.",
    icon: "chart-line",
    href: "/services"
  },
  {
    title: "Governance & Policy",
    description: "Establish robust cybersecurity governance structures. Strategic policy development, CISO-as-a-Service, Virtual CISO (V-CISO), and board-level risk reporting to ensure organizational security maturity.",
    icon: "building-library",
    href: "/services"
  },
  {
    title: "Specialized Services",
    description: "Expert services for unique cybersecurity challenges. Anti-fraud services, digital trust solutions, audit preparation, and specialized compliance support for complex requirements.",
    icon: "star",
    href: "/services"
  }
];

const complianceFrameworks = [
  {
    title: "ISO 27001",
    description: "Information Security Management System - the international standard for cybersecurity management.",
    icon: "shield-check",
    href: "/frameworks/iso-27001"
  },
  {
    title: "NIS2 Directive",
    description: "Network and Information Security Directive - EU cybersecurity legislation for essential and important entities.",
    icon: "globe-alt",
    href: "/frameworks/nis2"
  },
  {
    title: "GDPR",
    description: "General Data Protection Regulation - EU privacy regulation for personal data protection and privacy.",
    icon: "lock-closed",
    href: "/regulatory/gdpr"
  },
  {
    title: "DORA",
    description: "Digital Operational Resilience Act - EU regulation for digital operational resilience in financial services.",
    icon: "building-library",
    href: "/regulatory/dora"
  },
  {
    title: "SOC 2",
    description: "Service Organization Control 2 - auditing procedure that ensures service providers securely manage data.",
    icon: "document-check",
    href: "/frameworks/soc-2"
  },
  {
    title: "Common Criteria",
    description: "International standard for computer security certification - evaluation criteria for IT security products.",
    icon: "star",
    href: "/frameworks/common-criteria"
  }
];

const industries = [
  { 
    name: "Financial Services & Fintech", 
    icon: "bank", 
    href: "/industries/financial-services-fintech",
    image: "/images/industries/financial.avif",
    description: "Specialized DORA, PCI DSS, and operational resilience expertise for banks, payment processors, and fintech companies."
  },
  { 
    name: "SaaS & Technology", 
    icon: "code", 
    href: "/industries/saas-technology",
    image: "/images/industries/saas.avif",
    description: "ISO 27001, SOC 2, and cloud security frameworks tailored for software companies and technology service providers."
  },
  { 
    name: "Healthcare & Life Sciences", 
    icon: "heart", 
    href: "/industries/healthcare-life-sciences",
    image: "/images/industries/healthcare.avif",
    description: "GDPR, Virtual DPO (V-DPO), medical device regulations, and patient data protection compliance for healthcare organizations and life sciences companies."
  },
  { 
    name: "Critical Infrastructure", 
    icon: "bolt", 
    href: "/industries/critical-infrastructure-energy",
    image: "/images/industries/critical.avif",
    description: "NIS2 directive implementation, operational technology security, and resilience planning for essential service providers."
  },
  { 
    name: "Public Sector", 
    icon: "building", 
    href: "/industries/public-sector-finland",
    image: "/images/industries/public.avif",
    description: "Government-specific compliance frameworks, public procurement requirements, and citizen data protection standards."
  },
  { 
    name: "Manufacturing & Industrial", 
    icon: "cog", 
    href: "/industries/manufacturing-industrial",
    image: "/images/industries/manufacturing.avif",
    description: "Industrial IoT security, supply chain protection, and operational continuity for manufacturing and industrial organizations."
  }
];
const latestResources = [
  {
    title: "ISO 27001 Quick Start Guide",
    excerpt: "25-page implementation roadmap",
    href: "/resources/guides/iso-27001-quick-start",
    category: "Guide"
  },
  {
    title: "NIS2 Compliance Checklist",
    excerpt: "Complete requirement assessment tool",
    href: "/resources/guides/nis2-compliance-checklist",
    category: "Checklist"
  },
  {
    title: "GDPR Privacy Impact Assessment Template",
    excerpt: "Ready-to-use PIA framework",
    href: "/resources/guides/gdpr-pia-template",
    category: "Template"
  }
];
---

<Layout {...seoConfig}>

<!-- Hero Section - WITH BACKGROUND IMAGE -->
<section class="text-slate-900 md:min-h-screen flex items-center relative overflow-hidden bg-cover bg-center bg-no-repeat" style="background-image: url('/images/bgf.jpg')">
  
  <!-- Fade overlay at top -->
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-white to-transparent"></div>
  
  <!-- Fade with blur effect -->
  <div class="absolute bottom-0 left-0 right-0 h-56 bg-gradient-to-t from-white via-white/80 to-transparent backdrop-blur-sm"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-4">
    
    <!-- TITLE AT THE VERY TOP - CENTERED -->
    <div class="text-center mb-6 md:mb-12 lg:mb-20">
      <h1 class="font-bold tracking-tight leading-tight"
          style="font-family: 'Montserrat', sans-serif; font-size: clamp(24px, 5vw, 45px);">
        <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">
          {lang === 'fi' ? content.fi.hero.title : content.en.hero.title}
        </span>
      </h1>
    </div>

    <!-- Mobile layout (stacked vertically) -->
    <div class="flex flex-col items-center justify-center gap-6 mb-8 md:hidden">
      <img 
        src="/images/cyber.webp"
        alt="cybersecurity concept"
        class="w-full max-w-xs object-cover"
        loading="eager"
      />
    </div>
    
    <div class="text-center">
      
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Side: Content -->
        <div class="text-center">
          <div class="text-center">
            <div class="hidden md:flex items-center justify-center gap-4 mb-4 -mt-20">
              <div class="h-px w-16 bg-gradient-to-r from-transparent to-[#0F172A]"></div>
              <span class="text-[#0F172A] text-3xl font-bold animate-pulse" style="animation-duration: 2s;">✦</span>
              <div class="h-px w-16 bg-gradient-to-l from-transparent to-[#0F172A]"></div>
            </div>
            
            <p class="text-slate-600 leading-relaxed mx-auto text-center"
               style="font-family: 'Montserrat', sans-serif; font-size: clamp(16px, 2.5vw, 25px); max-width: 600px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);">
              {lang === 'fi' ? content.fi.hero.subtitle : content.en.hero.subtitle}
            </p>
          </div>
        </div>
        
        <!-- Right Side: cyber.webp image -->
        <div class="hidden md:block">
          <img 
            src="/images/cyber.webp"
            alt="Cybersecurity strategy concept"
            class="object-contain -mt-8"
            style="width: 100%; max-width: 600px; height: auto;"
            loading="eager"
          />
        </div>
        
      </div>
      
      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 justify-center mt-8 md:mt-14"
           style="font-family: 'Montserrat', sans-serif;">
        
        <a href="/contact" 
           class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] text-white rounded-full hover:from-[#22D3EE] hover:to-[#0EA5E9] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
          {lang === 'fi' ? content.fi.hero.primaryCTA.text : content.en.hero.primaryCTA.text}
        </a>
        
        <a href="/services" 
           class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#0EA5E9] text-[#0EA5E9] rounded-full hover:bg-gradient-to-r hover:from-[#22D3EE] hover:to-[#0EA5E9] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
          {lang === 'fi' ? content.fi.hero.secondaryCTA.text : content.en.hero.secondaryCTA.text}
        </a>
      </div>
      
    </div>
  </div>

  <style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient {
    animation: gradient 4s ease infinite;
    background-size: 200% 200%;
  }
  </style>
</section>

<!-- Trust Bar - WHITE BACKGROUND with subtle border -->
<section class="py-8 bg-white border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text -->
      <div class="text-center md:text-left">
        <!-- Decorative element -->
        <div class="flex items-center gap-3 mb-3 md:justify-start justify-center">
          <div class="h-px w-8 bg-gradient-to-r from-transparent to-[#0F172A]"></div>
          <span class="text-[#0F172A] text-xs font-medium tracking-wider uppercase">Trusted Partners</span>
          <div class="h-px w-8 bg-gradient-to-l from-transparent to-[#0F172A]"></div>
        </div>
        
        <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
          From compliance<br/>to 
          <span class="bg-gradient-to-r from-black to-[#0F172A] bg-clip-text text-transparent">
            competitive advantage
          </span>.
        </p>
        
        <!-- Rating -->
        <div class="flex items-center gap-3 mt-3 md:justify-start justify-center">
          <div class="flex items-center gap-0.5">
            {[...Array(5)].map((_, i) => (
              <svg key={i} class="w-3.5 h-3.5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
              </svg>
            ))}
          </div>
          <span class="text-xs text-slate-500">4.9/5 (200+ reviews)</span>
        </div>
      </div>
      
      <!-- Right Side: Auto-scrolling Logos Carousel -->
      <div class="relative overflow-hidden">
        
        <!-- Label above logos -->
        <div class="text-center mb-3">
          <span class="text-xs text-slate-400 uppercase tracking-wider">Trusted by industry leaders</span>
        </div>
        
        <!-- Marquee / Auto-scrolling container -->
        <div class="overflow-hidden">
          <div class="flex animate-scroll gap-6 md:gap-8 py-2">
            
            {[
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/dora.webp', alt: 'DORA' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
              // Duplicate for seamless loop
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/dora.webp', alt: 'DORA' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
            ].map((logo, idx) => (
              <div key={idx} class="flex-shrink-0 flex items-center justify-center h-16 md:h-20 w-24 md:w-32 rounded-xl p-2 md:p-3 hover:scale-105 transition-all duration-300">
                <img
  src={logo.src}
  alt={logo.alt}
  class="max-h-12 md:max-h-20 w-auto object-contain"
  loading="lazy"
/>
              </div>
            ))}
            
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</section>

<style>
  /* Auto-scroll animation */
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  
  .animate-scroll {
    animation: scroll 20s linear infinite;
    width: fit-content;
  }
  
  .animate-scroll:hover {
    animation-play-state: paused;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<!-- Featured Packages Section - MATCHING HERO SECTION STYLE -->
<section class="text-slate-900 md:min-h-screen flex items-center relative overflow-hidden bg-cover bg-center bg-no-repeat" style="background-image: url('/images/bgf.jpg')">
  
  <!-- Top fade overlay -->
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-white to-transparent"></div>
  
  <!-- Bottom fade overlay -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white to-transparent"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-12">  
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-4">
        Featured Fast-Track Packages
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        Fast-track solutions designed for regulated organizations
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- ISO 27001 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <!-- Badge - Blue Border -->
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#0EA5E9] bg-white rounded-full border-2 border-[#0EA5E9] group-hover:text-white group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
            Become certification-ready in 90–120 days
          </div>
        </div>

        <!-- Title - Centered -->
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#22D3EE] transition-colors duration-300 text-center">
          ISO 27001 Fast-Track
        </h3>
        
        <!-- Description - More prominent -->
        <p class="text-base font-semibold text-[#0F172A] mb-6 leading-relaxed text-center">
          Build and implement a complete ISMS with expert guidance.
        </p>        
        
        <!-- Features List -->
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Complete ISMS implementation tailored to your operations</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Policy library with 50+ ready-to-use documents</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Risk assessment &amp; gap analysis</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Audit preparation and certification support</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Staff training and security awareness</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>12 months of post-certification support</span>
          </li>
        </ul>
        
        <!-- Button -->
        <a href="/packages/iso-27001-fast-track" class="mt-auto inline-flex items-center justify-center px-5 py-2.5 rounded-full border-2 border-[#0EA5E9] text-[#0EA5E9] bg-white hover:bg-gradient-to-r hover:from-[#22D3EE] hover:to-[#0EA5E9] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm w-fit self-center">
          Start program
        </a>
      </div>

      <!-- NIS2 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <!-- Badge - Blue Border -->
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#0EA5E9] bg-white rounded-full border-2 border-[#0EA5E9] group-hover:text-white group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
            Become NIS2 compliant in 60–90 days
          </div>
        </div>
        
        <!-- Title - Centered -->
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#22D3EE] transition-colors duration-300 text-center">
          NIS2 Sprint Program
        </h3>
        
        <!-- Description -->
        <p class="text-base font-semibold text-[#0F172A] mb-6 leading-relaxed text-center">
          Prepare for NIS2 requirements with expert support.
        </p>        
        
        <!-- Features List -->
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>NIS2 gap analysis &amp; roadmap</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Risk management framework</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Incident response framework and procedures</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
            <span>Supply chain security and third-party risk controls</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#0EA5E9] font-bold mt-0.5">✓</span> 
