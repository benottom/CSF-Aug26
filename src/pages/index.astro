---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import ComplianceFrameworks from '@/components/sections/ComplianceFrameworks.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Security Finland | Enterprise Cybersecurity & Compliance Advisory",
  description: "Global cybersecurity and compliance advisory firm. Specialized in ISO 27001, NIS2, CRA, and EUCC compliance across regulated industries. Proven methodologies trusted by enterprises worldwide.",
  keywords: "cybersecurity consulting, ISO 27001 compliance, NIS2 directive, GDPR expert, CRA compliance, EUCC certification, information security consulting, enterprise security, compliance advisory, risk management, governance risk compliance",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cyber Security Finland",
    "url": "https://cybersecurity.fi",
    "description": "Enterprise cybersecurity and compliance advisory services. ISO 27001, NIS2, CRA, and EUCC implementation with proven methodologies for global organizations.",
    "publisher": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cybersecurity.fi/csf-logo-2026.png",
        "width": 300,
        "height": 300
      }
    },
    "potentialAction": {
      "@type": "ContactAction",
      "target": "https://cybersecurity.fi/contact",
      "name": "Contact Us"
    }
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      eyebrow: "NIS2 · CRA · EUCC",
      title: "Enterprise Cybersecurity & Compliance Advisory for Regulated Europe",
      subtitle: "NIS2, CRA, and EUCC deadlines are closing in. We help regulated European enterprises engineer audit-ready ISO 27001 and GDPR controls — turning compliance from a cost center into a competitive advantage.",
      primaryCTA: { text: "Request Consultation", href: "/contact" },
      secondaryCTA: { text: "Explore Capabilities", href: "/services" }
    },
    services: {
      title: "Core Capabilities",
      description: "Comprehensive cybersecurity and regulatory compliance solutions for enterprises across regulated industries",
      items: [
        {
          title: "Information Security Management",
          description: "ISO 27001 implementation and certification readiness programs",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Regulatory Compliance",
          description: "NIS2 directive compliance and cybersecurity resilience frameworks",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Data Protection & Privacy",
          description: "GDPR compliance programs and privacy governance frameworks",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Cyber Resilience Act (CRA)",
          description: "CRA and EUCC compliance engineering for connected products and software placed on the EU market",
          icon: "cog",
          href: "/services/compliance-engineering"
        }
      ]
    },
    cta: {
      title: "Transform Your Security Posture",
      subtitle: "Partner with experienced advisors trusted by enterprises in highly regulated industries worldwide.",
      primaryCTA: { text: "Schedule Consultation", href: "/contact" },
      secondaryCTA: { text: "View Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      eyebrow: "NIS2 · CRA · EUCC",
      title: "Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta säännellylle Euroopalle",
      subtitle: "NIS2-, CRA- ja EUCC-määräajat lähestyvät nopeasti. Autamme säänneltyjä eurooppalaisia yrityksiä rakentamaan auditointivalmiit ISO 27001- ja GDPR-kontrollit – ja muuttamaan vaatimustenmukaisuuden kilpailueduksi.",
      primaryCTA: { text: "Pyydä konsultaatio", href: "/contact" },
      secondaryCTA: { text: "Tutustu palveluihin", href: "/services" }
    },
    services: {
      title: "Ydinosaamisalueet",
      description: "Kattavat kyberturvallisuus- ja sääntelyvaatimustenmukaisuusratkaisut yrityksille säännellyillä toimialoilla",
      items: [
        {
          title: "Tietoturvallisuuden hallinta",
          description: "ISO 27001 -toteutus ja sertifiointivalmius-ohjelmat",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Sääntelyvaatimustenmukaisuus",
          description: "NIS2-direktiivin vaatimustenmukaisuus ja kyberturvallisuuden resilienssi",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Tietosuoja ja yksityisyys",
          description: "GDPR-vaatimustenmukaisuusohjelmat ja tietosuojan hallintakehykset",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Kyberkestävyyssäädös (CRA)",
          description: "CRA- ja EUCC-vaatimustenmukaisuus EU:n markkinoille tuotaville yhdistetyille tuotteille ja ohjelmistoille",
          icon: "cog",
          href: "/services/compliance-engineering"
        }
      ]
    },
    cta: {
      title: "Muuta turvallisuusasemaasi",
      subtitle: "Kumppani kokeneiden neuvonantajien kanssa, joihin luottavat yritykset erittäin säännellyillä toimialoilla maailmanlaajuisesti.",
      primaryCTA: { text: "Varaa konsultaatio", href: "/contact" },
      secondaryCTA: { text: "Näytä palvelut", href: "/services" }
    }
  }
};

const currentContent = content[lang];

const keyServices = [
  {
    title: "Compliance Frameworks",
    description: "Transform regulatory requirements into competitive advantages. Expert implementation of ISO 27001, SOC 2, GDPR, NIS2, CRA, and EUCC frameworks with proven fast-track methodologies.",
    icon: "shield-check",
    href: "/services"
  },
  {
    title: "Risk Management",
    description: "Identify, assess, and mitigate cybersecurity risks effectively. Comprehensive risk assessments, third-party risk management, and business continuity planning tailored to your organization.",
    icon: "chart-line",
    href: "/services"
  },
  {
    title: "Governance & Policy",
    description: "Establish robust cybersecurity governance structures. Strategic policy development, CISO-as-a-Service, Virtual CISO (V-CISO), and board-level risk reporting to ensure organizational security maturity.",
    icon: "building-library",
    href: "/services"
  },
  {
    title: "Specialized Services",
    description: "Expert services for unique cybersecurity challenges. Anti-fraud services, digital trust solutions, audit preparation, and specialized compliance support for complex requirements.",
    icon: "star",
    href: "/services"
  }
];


const industries = [
  { 
    name: "Financial Services & Fintech", 
    icon: "bank", 
    href: "/industries/financial-services-fintech",
    image: "/images/industries/financial.svg",
    description: "Specialized DORA, PCI DSS, and operational resilience expertise for banks, payment processors, and fintech companies."
  },
  { 
    name: "SaaS & Technology", 
    icon: "code", 
    href: "/industries/saas-technology",
    image: "/images/industries/saas.svg",
    description: "ISO 27001, SOC 2, and cloud security frameworks tailored for software companies and technology service providers."
  },
  { 
    name: "Healthcare & Life Sciences", 
    icon: "heart", 
    href: "/industries/healthcare-life-sciences",
    image: "/images/industries/healthcare.svg",
    description: "GDPR, Virtual DPO (V-DPO), medical device regulations, and patient data protection compliance for healthcare organizations and life sciences companies."
  },
  { 
    name: "Critical Infrastructure", 
    icon: "bolt", 
    href: "/industries/critical-infrastructure-energy",
    image: "/images/industries/critical.svg",
    description: "NIS2 directive implementation, operational technology security, and resilience planning for essential service providers."
  },
  { 
    name: "Public Sector", 
    icon: "building", 
    href: "/industries/public-sector-finland",
    image: "/images/industries/public.svg",
    description: "Government-specific compliance frameworks, public procurement requirements, and citizen data protection standards."
  },
  { 
    name: "Manufacturing & Industrial", 
    icon: "cog", 
    href: "/industries/manufacturing-industrial",
    image: "/images/industries/manufacturing.svg",
    description: "Industrial IoT security, supply chain protection, and operational continuity for manufacturing and industrial organizations."
  }
];
const latestResources = [
  {
    title: "ISO 27001 Quick Start Guide",
    excerpt: "25-page implementation roadmap",
    href: "/resources/guides/iso-27001-quick-start",
    category: "Guide"
  },
  {
    title: "NIS2 Compliance Checklist",
    excerpt: "Complete requirement assessment tool",
    href: "/resources/guides/nis2-compliance-checklist",
    category: "Checklist"
  },
  {
    title: "GDPR Privacy Impact Assessment Template",
    excerpt: "Ready-to-use PIA framework",
    href: "/resources/guides/gdpr-pia-template",
    category: "Template"
  }
];
---

<Layout {...seoConfig}>

<!-- Hero Section - technical-paper, flat -->
<section class="text-[#14171a] bg-[#f4f1ea] relative overflow-hidden border-b" style="border-color: #e2dac5; background-image: linear-gradient(#e2dac5 1px, transparent 1px), linear-gradient(90deg, #e2dac5 1px, transparent 1px); background-size: 42px 42px;">

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16 md:py-24">

    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Content -->
      <div class="text-center md:text-left">
        <div class="kicker justify-center md:justify-start mx-auto md:mx-0">
          {lang === 'fi' ? content.fi.hero.eyebrow : content.en.hero.eyebrow}
        </div>

        <h1 class="font-bold tracking-tight leading-[1.1] mt-5"
            style="font-size: clamp(28px, 5vw, 48px);">
          {lang === 'fi' ? content.fi.hero.title : content.en.hero.title}
        </h1>

        <p class="text-[#48443b] leading-relaxed mt-6 mx-auto md:mx-0"
           style="font-size: clamp(16px, 2.2vw, 20px); max-width: 560px;">
          {lang === 'fi' ? content.fi.hero.subtitle : content.en.hero.subtitle}
        </p>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start mt-9">
          <a href="/contact"
             class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-[#14171a] text-[#f4f1ea] border border-[#14171a] rounded-[2px] hover:bg-[#003580] hover:border-[#003580] transition-colors duration-200 font-medium text-sm sm:text-base">
            {lang === 'fi' ? content.fi.hero.primaryCTA.text : content.en.hero.primaryCTA.text}
          </a>

          <a href="/services"
             class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border border-[#14171a] text-[#14171a] rounded-[2px] hover:border-[#003580] hover:text-[#003580] transition-colors duration-200 font-medium text-sm sm:text-base">
            {lang === 'fi' ? content.fi.hero.secondaryCTA.text : content.en.hero.secondaryCTA.text}
          </a>
        </div>
      </div>

      <!-- Right: flat line-art compliance diagram, technical-paper style -->
      <div class="frame p-4 sm:p-6 bg-[#f4f1ea]/60">
        <img
          src="/images/hero-compliance-diagram.svg"
          alt="Diagram of governance, risk, assurance, regulatory, response, and audit domains connected around a central security core"
          class="object-contain w-full h-auto"
          style="max-width: 600px;"
          loading="eager"
        />
      </div>

    </div>
  </div>
</section>

<!-- Trust Bar - WHITE BACKGROUND with subtle border -->
<section class="py-8 bg-white border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      <!-- Decorative element -->
      <div class="flex items-center gap-3 mb-3 justify-center">
        <div class="h-px w-8 bg-transparent"></div>
        <span class="text-[#131c2e] text-xs font-medium tracking-wider uppercase">Trusted Partners</span>
        <div class="h-px w-8 bg-transparent"></div>
      </div>

      <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
        From compliance<br/>to
        <span class="bg-black bg-clip-text text-transparent">
          competitive advantage
        </span>.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">
      {[
        { icon: "globe", title: "Finnish & EU Regulatory Expertise", desc: "NIS2, DORA, GDPR, ISO 27001" },
        { icon: "cog", title: "Structured Compliance Engineering", desc: "A defined, repeatable methodology" },
        { icon: "documentChartBar", title: "Audit-Ready, Board-Level Reporting", desc: "Built for executive and regulator scrutiny" },
        { icon: "userGroup", title: "Dedicated Senior Advisory Team", desc: "Experienced practitioners, not generalists" },
      ].map((item) => (
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-[#f4f1ea] border-2 border-[#003580] flex items-center justify-center">
            <Icon name={item.icon} class="w-6 h-6 text-[#003580]" />
          </div>
          <h3 class="text-sm font-bold text-[#14171a] mb-1">{item.title}</h3>
          <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Featured Packages Section - MATCHING HERO SECTION STYLE -->
<section class="text-slate-900 md:min-h-screen flex items-center relative overflow-hidden bg-[#f4f1ea]" style="background-image: linear-gradient(#e2dac5 1px, transparent 1px), linear-gradient(90deg, #e2dac5 1px, transparent 1px); background-size: 42px 42px;">
  
  <!-- Top fade overlay -->
  <div class="absolute top-0 left-0 right-0 h-32 bg-white"></div>
  
  <!-- Bottom fade overlay -->
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-white"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-12">  
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#003580] mb-4">
        Featured Fast-Track Packages
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        Fast-track solutions designed for regulated organizations
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- ISO 27001 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <!-- Badge - Blue Border -->
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#003580] bg-white rounded-[2px] border-2 border-[#003580] group-hover:text-white group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
            Become certification-ready in 90–120 days
          </div>
        </div>

        <!-- Title - Centered -->
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 text-center">
          ISO 27001 Fast-Track
        </h3>
        
        <!-- Description - More prominent -->
        <p class="text-base font-semibold text-[#131c2e] mb-6 leading-relaxed text-center">
          Build and implement a complete ISMS with expert guidance.
        </p>        
        
        <!-- Features List -->
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Complete ISMS implementation tailored to your operations</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Policy library with 50+ ready-to-use documents</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Risk assessment &amp; gap analysis</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Audit preparation and certification support</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Staff training and security awareness</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>12 months of post-certification support</span>
          </li>
        </ul>
        
        <!-- Button -->
        <a href="/packages/iso-27001-fast-track" class="mt-auto inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm w-fit self-center">
          Start program
        </a>
      </div>

      <!-- NIS2 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <!-- Badge - Blue Border -->
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#003580] bg-white rounded-[2px] border-2 border-[#003580] group-hover:text-white group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
            Become NIS2 compliant in 60–90 days
          </div>
        </div>
        
        <!-- Title - Centered -->
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 text-center">
          NIS2 Sprint Program
        </h3>
        
        <!-- Description -->
        <p class="text-base font-semibold text-[#131c2e] mb-6 leading-relaxed text-center">
          Prepare for NIS2 requirements with expert support.
        </p>        
        
        <!-- Features List -->
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>NIS2 gap analysis &amp; roadmap</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Risk management framework</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Incident response framework and procedures</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Supply chain security and third-party risk controls</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Regulatory reporting setup for audit readiness</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Executive and board-level compliance training</span>
          </li>
        </ul>
        
        <!-- Button -->
        <a href="/packages/nis2-sprint" class="mt-auto inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm w-fit self-center">
          Start program
        </a>
      </div>
      
      <!-- SOC 2 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <!-- Badge - Blue Border -->
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#003580] bg-white rounded-[2px] border-2 border-[#003580] group-hover:text-white group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
            Become SOC 2 ready in 12 weeks
          </div>
        </div>

        <!-- Title -->
        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 text-center">
          SOC 2 Readiness
        </h3>
        
        <!-- Description -->
        <p class="text-base font-semibold text-[#131c2e] mb-6 leading-relaxed text-center">
          Prepare for SOC 2 Type I and Type II audits.
        </p>        
        
        <!-- Features List -->
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Type I &amp; Type II preparation</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Control implementation &amp; testing</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Evidence collection framework</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Continuous monitoring setup</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>Audit preparation and support</span>
          </li>
        </ul>
        
        <!-- Button -->
        <a href="/packages/soc2-readiness-12-weeks" class="mt-auto inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm w-fit self-center">
          Start program
        </a>
      </div>
      
    </div>
    
    <!-- View All Button -->
    <div class="text-center mt-12">
      <a href="/packages" class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#003580] text-white hover:bg-[#2E6FBA] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2">
        View All Programs
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
    
  </div>
</section>

<!-- Core Capabilities Section - WHITE BACKGROUND -->
<section class="py-8 md:py-20 bg-white relative overflow-hidden">
  <!-- Subtle decorative elements -->
  <div class="absolute top-0 left-0 right-0 h-px bg-transparent opacity-30"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-transparent opacity-20"></div>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Mobile: Title & Description at top -->
    <div class="md:hidden text-center mb-6 px-2">
      <div class="flex items-center justify-center gap-4 mb-4">
        <div class="h-px w-8 bg-transparent"></div>
        <span class="text-[#131c2e] text-2xl font-bold">✦</span>
        <div class="h-px w-8 bg-transparent"></div>
      </div>
      
      <h2 class="text-3xl font-bold tracking-tight text-[#003580] mb-4">
        {currentContent.services.title}
      </h2>
      
      <p class="text-base text-slate-500 leading-relaxed">
        {currentContent.services.description}
      </p>
    </div>

    <div class="grid md:grid-cols-5 gap-10 items-start">
      
      <!-- Left Side: Title & Description - Desktop only -->
      <div class="hidden md:block md:col-span-2">
        <div class="flex items-center justify-center gap-4 mb-6">
