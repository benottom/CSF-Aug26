---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Cybersecurity Regulatory Center | Compliance Resources & Guides",
  description: "Stay informed about the latest cybersecurity regulations, compliance requirements, and industry standards. NIS2, DORA, GDPR, eIDAS and more.",
  keywords: "regulatory center, cybersecurity regulations, NIS2, DORA, GDPR, compliance resources",
  type: "website" as const,
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      title: "Cybersecurity Regulatory Center",
      subtitle: "Navigate the complex landscape of cybersecurity regulations",
      description: "Stay informed about the latest cybersecurity regulations with our comprehensive regulatory center. Get expert insights, compliance guides, and implementation resources.",
      primaryCTA: { text: "Explore Regulations", href: "#regulations" },
      secondaryCTA: { text: "Get Compliance Help", href: "/contact?compliance=true" }
    },
    regulations: {
      title: "Regulatory Landscape",
      subtitle: "Stay up-to-date with the evolving cybersecurity regulatory environment. Our experts monitor changes and provide actionable compliance guidance.",
      items: [
        {
          title: "NIS2 in Finland",
          description: "Comprehensive guide to the NIS2 Directive implementation in Finland, requirements, and compliance timeline.",
          status: "Active",
          lastUpdated: "Updated: March 2024",
          href: "/regulatory/nis2-finland",
          keyPoints: ["Applies to essential and important entities", "Mandatory incident reporting within 24 hours", "Risk management measures required", "Penalties up to 2% of annual turnover"]
        },
        {
          title: "DORA for Financial Services",
          description: "Digital Operational Resilience Act requirements for financial institutions and their ICT service providers.",
          status: "Active",
          lastUpdated: "Updated: January 2024",
          href: "/regulatory/dora",
          keyPoints: ["Applies to all financial entities in EU", "ICT risk management framework required", "Incident reporting obligations", "Third-party risk management"]
        },
        {
          title: "GDPR and Privacy",
          description: "General Data Protection Regulation compliance guide with practical implementation steps.",
          status: "Active",
          lastUpdated: "Updated: December 2023",
          href: "/regulatory/gdpr",
          keyPoints: ["Data protection by design and default", "Consent management requirements", "Data breach notification rules", "Individual privacy rights"]
        },
        {
          title: "ISO 27001 and NIS2 Alignment",
          description: "How to align ISO 27001 implementation with NIS2 compliance requirements for maximum efficiency.",
          status: "Guide",
          lastUpdated: "Updated: February 2024",
          href: "/regulatory/iso-to-nis2-mapping",
          keyPoints: ["Control mapping between standards", "Gap analysis methodology", "Integrated implementation approach", "Audit efficiency strategies"]
        },
        {
          title: "eIDAS and Digital Trust",
          description: "Electronic identification and trust services regulation for digital identity and signatures.",
          status: "Active",
          lastUpdated: "Updated: November 2023",
          href: "/services/regulatory-compliance/eidas-digital-trust",
          keyPoints: ["Digital identity requirements", "Qualified electronic signatures", "Trust service providers", "Cross-border recognition"]
        }
      ]
    },
    services: {
      title: "Regulatory Services",
      subtitle: "We help organizations navigate complex regulatory requirements with expert guidance and practical solutions.",
      items: [
        {
          title: "Compliance Assessment",
          description: "Comprehensive assessment of your current compliance status against applicable regulations.",
          icon: "document-check",
          points: ["Gap analysis and risk assessment", "Compliance roadmap development", "Regulatory impact analysis", "Implementation planning"]
        },
        {
          title: "Implementation Support",
          description: "Hands-on support to implement compliance measures and meet regulatory requirements.",
          icon: "tool",
          points: ["Policy and procedure development", "Control implementation", "Staff training and awareness", "Documentation and evidence"]
        },
        {
          title: "Ongoing Monitoring",
          description: "Continuous monitoring and updates to maintain compliance as regulations evolve.",
          icon: "refresh-cw",
          points: ["Regulatory change monitoring", "Compliance health checks", "Incident response support", "Audit preparation and support"]
        }
      ]
    },
    cta: {
      title: "Need Regulatory Compliance Help?",
      subtitle: "Our regulatory experts can help you navigate complex compliance requirements and implement effective solutions.",
      primaryCTA: { text: "Schedule Consultation", href: "/contact?compliance=true" },
      secondaryCTA: { text: "View Resources", href: "/resources/guides" }
    }
  },
  fi: {
    hero: {
      title: "Kyberturvallisuuden sääntelykeskus",
      subtitle: "Navigoi kyberturvallisuussäännösten monimutkaisessa kentässä",
      description: "Pysy ajan tasalla uusimmista kyberturvallisuussäännöksistä kattavan sääntelykeskuksemme avulla. Hanki asiantuntijatietoa, vaatimustenmukaisuusoppaita ja toteutusresursseja.",
      primaryCTA: { text: "Tutustu säännöksiin", href: "#regulations" },
      secondaryCTA: { text: "Pyydä apua vaatimustenmukaisuuteen", href: "/contact?compliance=true" }
    },
    regulations: {
      title: "Sääntelymaisema",
      subtitle: "Pysy ajan tasalla kehittyvästä kyberturvallisuuden sääntely-ympäristöstä. Asiantuntijamme seuraavat muutoksia ja tarjoavat käytännönläheistä vaatimustenmukaisuusohjausta.",
      items: [
        {
          title: "NIS2 Suomessa",
          description: "Kattava opas NIS2-direktiivin toteutukseen Suomessa, vaatimuksiin ja vaatimustenmukaisuuden aikatauluun.",
          status: "Aktiivinen",
          lastUpdated: "Päivitetty: maaliskuu 2024",
          href: "/regulatory/nis2-finland",
          keyPoints: ["Koskee olennaisia ja tärkeitä toimijoita", "Pakollinen tapahtumaraportointi 24 tunnin sisällä", "Riskienhallintatoimenpiteet vaaditaan", "Sakot jopa 2% vuosiliikevaihdosta"]
        },
        {
          title: "DORA rahoituspalveluille",
          description: "Digitaalisen toimintakyvyn säädös (DORA) rahoituslaitoksille ja niiden ICT-palveluntarjoajille.",
          status: "Aktiivinen",
          lastUpdated: "Päivitetty: tammikuu 2024",
          href: "/regulatory/dora",
          keyPoints: ["Koskee kaikkia EU:n rahoitusalan toimijoita", "ICT-riskienhallintakehys vaaditaan", "Tapahtumaraportointivelvollisuudet", "Kolmannen osapuolen riskienhallinta"]
        },
        {
          title: "GDPR ja tietosuoja",
          description: "Yleinen tietosuoja-asetus (GDPR) -vaatimustenmukaisuusopas käytännön toteutusvaiheilla.",
          status: "Aktiivinen",
          lastUpdated: "Päivitetty: joulukuu 2023",
          href: "/regulatory/gdpr",
          keyPoints: ["Tietosuoja suunnittelussa ja oletuksena", "Suostumushallinnan vaatimukset", "Tietoturvaloukkauksen ilmoitussäännöt", "Yksilön tietosuojaoikeudet"]
        },
        {
          title: "ISO 27001 ja NIS2 yhteensovitus",
          description: "Kuinka sovittaa ISO 27001 -toteutus NIS2-vaatimustenmukaisuuden kanssa maksimaalisen tehokkuuden saavuttamiseksi.",
          status: "Opas",
          lastUpdated: "Päivitetty: helmikuu 2024",
          href: "/regulatory/iso-to-nis2-mapping",
          keyPoints: ["Kontrollien kartoitus standardien välillä", "Aukkoanalyysimenetelmä", "Integroitu toteutuslähestymistapa", "Auditoinnin tehokkuusstrategiat"]
        },
        {
          title: "eIDAS ja digitaalinen luottamus",
          description: "Asetus sähköisestä tunnistamisesta ja luottamuspalveluista digitaalista identiteettiä ja allekirjoituksia varten.",
          status: "Aktiivinen",
          lastUpdated: "Päivitetty: marraskuu 2023",
          href: "/services/regulatory-compliance/eidas-digital-trust",
          keyPoints: ["Digitaalisen identiteetin vaatimukset", "Laatuvarmenteiset sähköiset allekirjoitukset", "Luottamuspalveluntarjoajat", "Rajat ylittävä tunnustaminen"]
        }
      ]
    },
    services: {
      title: "Sääntelypalvelut",
      subtitle: "Autamme organisaatioita navigoimaan monimutkaisissa sääntelyvaatimuksissa asiantuntijaohjauksella ja käytännön ratkaisuilla.",
      items: [
        {
          title: "Vaatimustenmukaisuusarviointi",
          description: "Kattava arviointi nykyisestä vaatimustenmukaisuustilanteesta sovellettavia säännöksiä vastaan.",
          icon: "document-check",
          points: ["Aukkoanalyysi ja riskiarviointi", "Vaatimustenmukaisuuden tiekartan kehitys", "Sääntelyvaikutusten analyysi", "Toteutussuunnittelu"]
        },
        {
          title: "Toteutustuki",
          description: "Käytännönläheinen tuki vaatimustenmukaisuustoimenpiteiden toteuttamiseen ja sääntelyvaatimusten täyttämiseen.",
          icon: "tool",
          points: ["Käytäntöjen ja menettelytapojen kehittäminen", "Kontrollien toteutus", "Henkilöstön koulutus ja tietoisuus", "Dokumentointi ja todisteet"]
        },
        {
          title: "Jatkuva seuranta",
          description: "Jatkuva seuranta ja päivitykset vaatimustenmukaisuuden ylläpitämiseksi säännösten kehittyessä.",
          icon: "refresh-cw",
          points: ["Sääntelymuutosten seuranta", "Vaatimustenmukaisuuden terveystarkastukset", "Tapahtumien hallinnan tuki", "Auditointivalmistelu ja -tuki"]
        }
      ]
    },
    cta: {
      title: "Tarvitsetko apua sääntelyvaatimustenmukaisuuteen?",
      subtitle: "Sääntelyasiantuntijamme voivat auttaa sinua navigoimaan monimutkaisissa vaatimustenmukaisuusvaatimuksissa ja toteuttamaan tehokkaita ratkaisuja.",
      primaryCTA: { text: "Varaa konsultaatio", href: "/contact?compliance=true" },
      secondaryCTA: { text: "Tutustu resursseihin", href: "/resources/guides" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

function getStatusStyles(status: string) {
  if (status === 'Active' || status === 'Aktiivinen') {
    return 'bg-[#003580]/10 text-[#003580]';
  }
  return 'bg-blue-100 text-blue-800';
}
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base">
            {currentContent.hero.primaryCTA.text}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
            {currentContent.hero.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Regulations Section -->
  <section id="regulations" class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#003580] mb-2">
          {currentContent.regulations.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.regulations.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {currentContent.regulations.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start justify-between mb-3 relative z-10">
              <h3 class="text-lg font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {item.title}
              </h3>
              <div class="flex flex-col items-end gap-1">
                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-[2px] text-xs font-medium ${getStatusStyles(item.status)}`}>
                  {item.status}
                </span>
                <span class="text-xs text-slate-500">{item.lastUpdated}</span>
              </div>
            </div>
            
            <p class="text-sm text-slate-500 leading-relaxed mb-4 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mb-5 relative z-10">
              <h4 class="text-xs font-semibold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300">{isFi ? 'Keskeiset kohdat:' : 'Key Points:'}</h4>
              <ul class="space-y-1">
                {item.keyPoints.map((point) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                    <svg class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    {point}
                  </li>
                ))}
              </ul>
            </div>
            
            <a href={item.href} class="mt-auto relative z-10 inline-flex items-center justify-center px-4 py-2 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-1.5 w-auto">
              {isFi ? 'Lue koko opas' : 'Read Full Guide'}
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Regulatory Services Section -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center mb-8">
        <h2 class="text-2xl md:text-3xl font-bold text-[#003580] mb-2">
          {currentContent.services.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.services.subtitle}
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {currentContent.services.items.map((service) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full p-5 md:p-6 group relative overflow-hidden">
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-3 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={service.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-base font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {service.title}
            </h3>
            
            <p class="text-sm text-slate-500 leading-relaxed mb-4 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {service.description}
            </p>
            
            <ul class="space-y-1.5 relative z-10">
              {service.points.map((point) => (
                <li class="flex items-start gap-2 text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300">
                  <span class="text-[#003580] font-bold mt-0.5">✓</span> {point}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-2xl border-2 border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 p-8 md:p-12 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580]"></div>
        
        <div class="flex items-center justify-center gap-4 mb-4">
          <div class="h-px w-10 bg-transparent"></div>
          <span class="text-[#131c2e] text-xl font-bold">✦</span>
          <div class="h-px w-10 bg-transparent"></div>
        </div>
        
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3 text-[#131c2e]">
          {currentContent.cta.title}
        </h2>

        <p class="text-sm md:text-base text-[#131c2e] mb-6 max-w-2xl mx-auto leading-relaxed">
          {currentContent.cta.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={isFi ? "/fi/contact?compliance=true" : "/contact?compliance=true"} 
             class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] bg-[#003580] text-white hover:bg-[#2E6FBA] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2 group">
            {currentContent.cta.primaryCTA.text}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={isFi ? "/fi/resources/guides" : "/resources/guides"} 
             class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-2 group">
            {currentContent.cta.secondaryCTA.text}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>