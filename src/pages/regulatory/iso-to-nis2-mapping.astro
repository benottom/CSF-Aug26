---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "ISO 27001 & NIS2 Alignment";

const content = {
  en: {
    title: "ISO 27001 & NIS2 Alignment",
    subtitle: "Bridging International Standards with European Cybersecurity Requirements",
    heroDescription: "Understand how ISO 27001 certification aligns with NIS2 compliance requirements and leverage your existing security framework.",
    forWho: "For organizations that already have ISO 27001 certification and need to achieve NIS2 compliance efficiently.",
    achieve: "Seamless alignment between ISO 27001 and NIS2, reducing compliance costs and accelerating implementation.",
    alignment: {
      title: "What is ISO 27001 and NIS2 Alignment?",
      description: "ISO 27001 and NIS2 alignment refers to the strategic mapping between the international information security management standard and the European Union's Network and Information Security directive. This alignment enables organizations to leverage existing ISO 27001 controls to meet NIS2 requirements efficiently."
    },
    benefits: {
      title: "Key Benefits of Alignment",
      subtitle: "Maximize your security investments and streamline compliance",
      items: [
        { title: "Reduced Compliance Costs", description: "Leverage existing ISO 27001 controls to minimize additional NIS2 implementation costs" },
        { title: "Faster Implementation", description: "Accelerate NIS2 compliance by building upon your established security framework" },
        { title: "Unified Security Approach", description: "Create a cohesive security strategy that satisfies both international and European requirements" },
        { title: "Risk Reduction", description: "Address overlapping security requirements through integrated control implementation" }
      ]
    },
    mapping: {
      title: "ISO 27001 to NIS2 Mapping Framework",
      subtitle: "Comprehensive control mapping and gap analysis",
      items: [
        {
          title: "Risk Assessment & Management",
          isoControls: "ISO 27001:2013 Clauses 6.1, 8.2, 8.3",
          nis2Requirements: "NIS2 Article 8 - Risk Management",
          description: "Map existing risk assessment processes to NIS2 risk management requirements"
        },
        {
          title: "Incident Management",
          isoControls: "ISO 27001:2013 Clause 16.1",
          nis2Requirements: "NIS2 Article 10 - Incident Reporting",
          description: "Extend incident management to include NIS2 reporting obligations"
        },
        {
          title: "Business Continuity",
          isoControls: "ISO 27001:2013 Clause 17.1",
          nis2Requirements: "NIS2 Article 9 - Business Continuity",
          description: "Align business continuity planning with NIS2 resilience requirements"
        },
        {
          title: "Access Control",
          isoControls: "ISO 27001:2013 Clauses 9.1-9.4",
          nis2Requirements: "NIS2 Article 8 - Access Control",
          description: "Ensure access control measures meet NIS2 security requirements"
        }
      ]
    },
    steps: {
      title: "Implementation Steps",
      subtitle: "Systematic approach to achieving alignment",
      items: [
        { number: "01", title: "Gap Analysis", description: "Conduct comprehensive mapping between existing ISO 27001 controls and NIS2 requirements" },
        { number: "02", title: "Control Enhancement", description: "Enhance existing controls to meet NIS2-specific requirements where gaps exist" },
        { number: "03", title: "Documentation Update", description: "Update policies, procedures, and documentation to reflect NIS2 compliance" },
        { number: "04", title: "Training & Awareness", description: "Train staff on NIS2 requirements and updated security procedures" },
        { number: "05", title: "Testing & Validation", description: "Test enhanced controls and validate NIS2 compliance through internal audits" }
      ]
    },
    benefitsList: {
      title: "Benefits of Professional Alignment",
      subtitle: "Maximize your security framework investment",
      items: [
        "Reduced compliance costs through control reuse",
        "Faster NIS2 compliance achievement",
        "Maintained ISO 27001 certification benefits",
        "Enhanced security posture and risk management",
        "Streamlined audit and reporting processes"
      ]
    }
  },
  fi: {
    title: "ISO 27001 & NIS2 Yhteensovittaminen",
    subtitle: "Kansainvälisten standardien yhdistäminen eurooppalaisiin kyberturvallisuusvaatimuksiin",
    heroDescription: "Ymmärrä miten ISO 27001 sertifikaatti yhdistyy NIS2 yhteensopivuusvaatimuksiin ja hyödynnä olemassa olevaa turvallisuuskehystäsi.",
    forWho: "Organisaatioille, joilla on jo ISO 27001 sertifikaatti ja jotka tarvitsevat NIS2 yhteensopivuuden tehokkaasti.",
    achieve: "Saumaton yhteensovittaminen ISO 27001:n ja NIS2:n välillä, alentaen yhteensopivuuskustannuksia ja nopeuttaen toteutusta.",
    alignment: {
      title: "Mikä on ISO 27001 ja NIS2 yhteensovittaminen?",
      description: "ISO 27001 ja NIS2 yhteensovittaminen viittaa strategiseen kartoittamiseen kansainvälisen tietoturvajohtamisen standardin ja Euroopan unionin verkko- ja tietoturvadirektiivin välillä."
    },
    benefits: {
      title: "Yhteensovittamisen tärkeimmät edut",
      subtitle: "Maksimoi turvallisuusinvestointisi ja tehosta yhteensopivuutta",
      items: [
        { title: "Alennetut yhteensopivuuskustannukset", description: "Hyödynnä olemassa olevia ISO 27001 kontrolleja NIS2 toteutuskustannusten minimoimiseen" },
        { title: "Nopeampi toteutus", description: "Nopeuta NIS2 yhteensopivuutta rakentamalla vakiintuneen turvallisuuskehyksen päälle" },
        { title: "Yhdistetty turvallisuuslähestymistapa", description: "Luo yhtenäinen turvallisuusstrategia, joka täyttää sekä kansainväliset että eurooppalaiset vaatimukset" },
        { title: "Riskien vähentäminen", description: "Käsittele päällekkäisiä turvallisuusvaatimuksia integroidun kontrollin toteutuksen kautta" }
      ]
    },
    mapping: {
      title: "ISO 27001 NIS2:een kartoituskehys",
      subtitle: "Kattava kontrollikartoitus ja aukkoanalyysi",
      items: [
        {
          title: "Riskinarviointi ja -johtaminen",
          isoControls: "ISO 27001:2013 kohdat 6.1, 8.2, 8.3",
          nis2Requirements: "NIS2 artikla 8 - Riskinjohtaminen",
          description: "Kartoi olemassa olevat riskinarviointiprosessit NIS2 riskinjohtamisvaatimuksille"
        },
        {
          title: "Tapahtumien johtaminen",
          isoControls: "ISO 27001:2013 kohta 16.1",
          nis2Requirements: "NIS2 artikla 10 - Tapahtumaraportointi",
          description: "Laajenna tapahtumien johtamista sisältämään NIS2 raportointivelvollisuudet"
        },
        {
          title: "Liiketoiminnan jatkuvuus",
          isoControls: "ISO 27001:2013 kohta 17.1",
          nis2Requirements: "NIS2 artikla 9 - Liiketoiminnan jatkuvuus",
          description: "Yhdistä liiketoiminnan jatkuvuussuunnittelu NIS2 kestävyysvaatimuksille"
        },
        {
          title: "Käyttöoikeuksien hallinta",
          isoControls: "ISO 27001:2013 kohdat 9.1-9.4",
          nis2Requirements: "NIS2 artikla 8 - Käyttöoikeuksien hallinta",
          description: "Varmista että käyttöoikeuksien hallintatoimet täyttävät NIS2 turvallisuusvaatimukset"
        }
      ]
    },
    steps: {
      title: "Toteutusvaiheet",
      subtitle: "Systemaattinen lähestymistapa yhteensovittamisen saavuttamiseen",
      items: [
        { number: "01", title: "Aukkoanalyysi", description: "Suorita kattava kartoitus olemassa olevien ISO 27001 kontrollien ja NIS2 vaatimusten välillä" },
        { number: "02", title: "Kontrollien parantaminen", description: "Paranna olemassa olevia kontrolleja täyttämään NIS2-spesifiset vaatimukset" },
        { number: "03", title: "Dokumentaation päivittäminen", description: "Päivitä politiikat, proseduurit ja dokumentaatio" },
        { number: "04", title: "Koulutus ja tietoisuus", description: "Kouluta henkilökuntaa NIS2 vaatimuksista" },
        { number: "05", title: "Testaus ja validointi", description: "Testaa paranneltuja kontrolleja ja validoi NIS2 yhteensopivuus" }
      ]
    },
    benefitsList: {
      title: "Ammattimaisen yhteensovittamisen edut",
      subtitle: "Maksimoi turvallisuuskehystesi investointi",
      items: [
        "Alennetut yhteensopivuuskustannukset kontrollien uudelleenkäytön kautta",
        "Nopeampi NIS2 yhteensopivuuden saavuttaminen",
        "Säilytetyt ISO 27001 sertifikaatin edut",
        "Parannettu turvallisuustaso ja riskinjohtaminen",
        "Tehostetut audit- ja raportointiprosessit"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is Alignment Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-4">
          {currentContent.alignment.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.alignment.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Key Benefits Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.benefits.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapping Framework Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.mapping.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.mapping.subtitle}
        </p>
      </div>
      
      <div class="space-y-4">
        {currentContent.mapping.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <h3 class="text-base md:text-lg font-bold text-[#14171a] mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {item.title}
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 relative z-10">
              <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                <h4 class="font-semibold text-slate-700 text-sm mb-1">ISO 27001 Controls</h4>
                <p class="text-slate-500 text-xs">{item.isoControls}</p>
              </div>
              <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                <h4 class="font-semibold text-slate-700 text-sm mb-1">NIS2 Requirements</h4>
                <p class="text-slate-500 text-xs">{item.nis2Requirements}</p>
              </div>
              <div class="bg-slate-50 rounded-lg p-3 border border-slate-100">
                <h4 class="font-semibold text-slate-700 text-sm mb-1">Alignment Approach</h4>
                <p class="text-slate-500 text-xs">{item.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-4 p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-12 h-12 bg-[#003580] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                {step.number}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <h3 class="text-base md:text-lg font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-sm text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits List Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.benefitsList.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefitsList.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentContent.benefitsList.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-[#003580] group-hover:h-[4px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <span class="text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300 relative z-10">
              {benefit}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>