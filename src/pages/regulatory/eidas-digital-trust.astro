---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "eIDAS";

const content = {
  en: {
    title: "eIDAS",
    subtitle: "Electronic Identification and Trust Services",
    heroDescription: "Navigate eIDAS compliance requirements with expert guidance and proven implementation strategies for digital identity and trust services.",
    forWho: "For organizations providing digital identity services, trust services, or needing to integrate with eIDAS-compliant systems in the EU.",
    achieve: "Full eIDAS compliance with enhanced digital identity and trust service capabilities.",
    eidas: {
      title: "What is eIDAS?",
      description: "The Electronic Identification, Authentication and Trust Services (eIDAS) regulation is an EU framework that ensures secure and seamless electronic interactions between businesses, citizens, and public authorities across the European Union."
    },
    components: {
      title: "eIDAS Key Components",
      subtitle: "Three main pillars of digital trust",
      items: [
        { title: "Electronic Identification", description: "Secure digital identity verification and authentication" },
        { title: "Electronic Signatures", description: "Legally recognized digital signature services" },
        { title: "Trust Services", description: "Certified digital trust and security services" }
      ]
    },
    compliance: {
      title: "eIDAS Compliance Requirements",
      subtitle: "Essential areas for achieving compliance",
      items: [
        { title: "Identity Verification", description: "Implement secure electronic identification processes" },
        { title: "Signature Services", description: "Provide qualified electronic signature services" },
        { title: "Trust Infrastructure", description: "Establish secure trust service infrastructure" },
        { title: "Cross-Border Recognition", description: "Ensure cross-border service recognition" },
        { title: "Security Standards", description: "Meet EU security and privacy standards" },
        { title: "Audit & Certification", description: "Obtain necessary certifications and audits" }
      ]
    },
    steps: {
      title: "Implementation Steps",
      subtitle: "Systematic approach to eIDAS compliance",
      items: [
        { number: "01", title: "Assessment", description: "Assess current digital identity and trust services" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps against eIDAS requirements" },
        { number: "03", title: "Architecture Design", description: "Design eIDAS-compliant service architecture" },
        { number: "04", title: "Implementation", description: "Implement required services and controls" },
        { number: "05", title: "Certification", description: "Obtain necessary certifications and validations" }
      ]
    },
    benefits: {
      title: "Benefits of eIDAS Compliance",
      subtitle: "Strategic advantages of achieving compliance",
      items: [
        "Enhanced digital identity security",
        "Improved cross-border service recognition",
        "Reduced regulatory and legal risks",
        "Better customer trust and confidence",
        "Competitive advantage in EU market"
      ]
    }
  },
  fi: {
    title: "eIDAS",
    subtitle: "Sähköinen tunnistaminen ja luottamuspalvelut",
    heroDescription: "Navigoi eIDAS yhteensopivuusvaatimukset asiantuntevan ohjauksen ja todistettujen toteutusstrategioiden avulla digitaaliseen identiteettiin ja luottamuspalveluihin.",
    forWho: "Organisaatioille, jotka tarjoavat digitaalisia identiteettipalveluita, luottamuspalveluita tai tarvitsevat integraatiota eIDAS-yhteensopiviin järjestelmiin EU:ssa.",
    achieve: "Täysi eIDAS yhteensopivuus parannetulla digitaalisen identiteetin ja luottamuspalvelun kyvyillä.",
    eidas: {
      title: "Mikä on eIDAS?",
      description: "Sähköinen tunnistaminen, autentikointi ja luottamuspalvelut (eIDAS) -asetus on EU:n kehys, joka varmistaa turvalliset ja saumattomat sähköiset vuorovaikutukset yritysten, kansalaisten ja julkisten viranomaisten välillä koko Euroopan unionissa."
    },
    components: {
      title: "eIDAS:n keskeiset komponentit",
      subtitle: "Digitaalisen luottamuksen kolme pilaria",
      items: [
        { title: "Sähköinen tunnistaminen", description: "Turvallinen digitaalinen identiteetin vahvistus ja autentikointi" },
        { title: "Sähköiset allekirjoitukset", description: "Oikeudellisesti tunnustetut digitaaliset allekirjoituspalvelut" },
        { title: "Luottamuspalvelut", description: "Sertifioidut digitaaliset luottamus- ja turvallisuuspalvelut" }
      ]
    },
    compliance: {
      title: "eIDAS yhteensopivuusvaatimukset",
      subtitle: "Yhteensopivuuden saavuttamisen keskeiset alueet",
      items: [
        { title: "Identiteetin vahvistus", description: "Toteuta turvalliset sähköiset tunnistamisprosessit" },
        { title: "Allekirjoituspalvelut", description: "Tarjoa päteviä sähköisiä allekirjoituspalveluita" },
        { title: "Luottamusinfrastruktuuri", description: "Perusta turvallinen luottamuspalvelun infrastruktuuri" },
        { title: "Rajat ylittävä tunnustus", description: "Varmista rajat ylittävän palvelun tunnustus" },
        { title: "Turvallisuusstandardit", description: "Täytä EU:n turvallisuus- ja yksityisyysstandardit" },
        { title: "Auditointi ja sertifiointi", description: "Hanki tarvittavat sertifikaatit ja auditit" }
      ]
    },
    steps: {
      title: "Toteutusvaiheet",
      subtitle: "Systemaattinen lähestymistapa eIDAS yhteensopivuuteen",
      items: [
        { number: "01", title: "Arviointi", description: "Arvioi nykyiset digitaaliset identiteetti- ja luottamuspalvelut" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnista aukot eIDAS vaatimuksia vastaan" },
        { number: "03", title: "Arkkitehtuurin suunnittelu", description: "Suunnittele eIDAS-yhteensopiva palveluarkkitehtuuri" },
        { number: "04", title: "Toteutus", description: "Toteuta vaaditut palvelut ja kontrollit" },
        { number: "05", title: "Sertifiointi", description: "Hanki tarvittavat sertifikaatit ja validoinnit" }
      ]
    },
    benefits: {
      title: "eIDAS yhteensopivuuden edut",
      subtitle: "Yhteensopivuuden saavuttamisen strategiset edut",
      items: [
        "Parannettu digitaalisen identiteetin turvallisuus",
        "Parannettu rajat ylittävän palvelun tunnustus",
        "Alennettu sääntely- ja oikeusriski",
        "Parempi asiakkaiden luottamus ja varmuus",
        "Kilpailuetu EU-markkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is eIDAS Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-4">
          {currentContent.eidas.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.eidas.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Key Components Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.components.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.components.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {currentContent.components.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Requirements Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.compliance.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.compliance.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.compliance.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-4 p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-12 h-12 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                {step.number}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <h3 class="text-base md:text-lg font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-sm text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[4px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <span class="text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300 relative z-10">
              {benefit}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>