---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "DORA";

const content = {
  en: {
    title: "DORA",
    subtitle: "Digital Operational Resilience Act",
    heroDescription: "Navigate DORA compliance requirements for financial institutions with expert guidance and proven implementation strategies.",
    forWho: "For financial institutions, investment firms, and financial market infrastructure providers operating in the EU.",
    achieve: "Full DORA compliance with enhanced operational resilience and cybersecurity capabilities.",
    dora: {
      title: "What is DORA?",
      description: "The Digital Operational Resilience Act (DORA) is a comprehensive EU regulation that establishes uniform requirements for the financial sector's digital operational resilience, ensuring financial entities can withstand, respond to, and recover from ICT-related disruptions."
    },
    requirements: {
      title: "DORA Key Requirements",
      subtitle: "Five pillars of digital operational resilience",
      items: [
        { title: "ICT Risk Management", description: "Establish comprehensive ICT risk management framework" },
        { title: "Incident Reporting", description: "Implement incident detection, classification, and reporting" },
        { title: "Digital Resilience Testing", description: "Conduct regular digital resilience testing programs" },
        { title: "ICT Third-Party Risk", description: "Manage ICT third-party risk and concentration risk" },
        { title: "Information Sharing", description: "Participate in information sharing arrangements" }
      ]
    },
    compliance: {
      title: "DORA Compliance Areas",
      subtitle: "Comprehensive coverage of digital operational resilience",
      items: [
        { title: "Risk Assessment", description: "Identify and assess ICT risks across all business areas" },
        { title: "Business Continuity", description: "Develop ICT business continuity and disaster recovery plans" },
        { title: "Access Control", description: "Implement robust identity and access management controls" },
        { title: "Data Protection", description: "Ensure data security and privacy compliance" },
        { title: "Monitoring & Detection", description: "Establish continuous monitoring and threat detection" },
        { title: "Response & Recovery", description: "Develop incident response and recovery procedures" }
      ]
    },
    steps: {
      title: "Implementation Steps",
      subtitle: "Systematic approach to DORA compliance",
      items: [
        { number: "01", title: "Gap Analysis", description: "Assess current ICT resilience against DORA requirements" },
        { number: "02", title: "Framework Design", description: "Design comprehensive ICT risk management framework" },
        { number: "03", title: "Control Implementation", description: "Implement required ICT controls and processes" },
        { number: "04", title: "Testing & Validation", description: "Conduct digital resilience testing and validation" },
        { number: "05", title: "Monitoring & Reporting", description: "Establish ongoing monitoring and reporting capabilities" }
      ]
    },
    benefits: {
      title: "Benefits of DORA Compliance",
      subtitle: "Strategic advantages of achieving compliance",
      items: [
        "Enhanced operational resilience and business continuity",
        "Improved customer and stakeholder confidence",
        "Reduced regulatory and reputational risks",
        "Better incident response and recovery capabilities",
        "Competitive advantage in the financial market"
      ]
    }
  },
  fi: {
    title: "DORA",
    subtitle: "Digitaalisen toiminnallisen kestävyyden asetus",
    heroDescription: "Navigoi DORA yhteensopivuusvaatimukset rahoituslaitoksille asiantuntevan ohjauksen ja todistettujen toteutusstrategioiden avulla.",
    forWho: "EU:ssa toimiville rahoituslaitoksille, sijoitusyhtiöille ja rahoitusmarkkinoiden infrastruktuurin tarjoajille.",
    achieve: "Täysi DORA yhteensopivuus parannetulla toiminnallisella kestävyydellä ja kyberturvallisuuskyvyillä.",
    dora: {
      title: "Mikä on DORA?",
      description: "Digitaalisen toiminnallisen kestävyyden asetus (DORA) on kattava EU-asetus, joka määrittää yhtenäiset vaatimukset rahoitussektorin digitaaliselle toiminnalliselle kestävyydelle."
    },
    requirements: {
      title: "DORA:n keskeiset vaatimukset",
      subtitle: "Digitaalisen toiminnallisen kestävyyden viisi pilaria",
      items: [
        { title: "ICT-riskinjohtaminen", description: "Perusta kattava ICT-riskinjohtamiskehys" },
        { title: "Tapahtumaraportointi", description: "Toteuta tapahtumien tunnistus, luokittelu ja raportointi" },
        { title: "Digitaalisen kestävyyden testaus", description: "Suorita säännöllisiä digitaalisen kestävyyden testausohjelmia" },
        { title: "ICT kolmannen osapuolen riski", description: "Hallitse ICT kolmannen osapuolen riskiä" },
        { title: "Tiedon jakaminen", description: "Osallistu tiedon jakamissopimuksiin" }
      ]
    },
    compliance: {
      title: "DORA yhteensopivuusalueet",
      subtitle: "Kattava digitaalisen toiminnallisen kestävyyden kattavuus",
      items: [
        { title: "Riskinarviointi", description: "Tunnista ja arvioi ICT-riskejä kaikilla liiketoiminta-alueilla" },
        { title: "Liiketoiminnan jatkuvuus", description: "Kehitä ICT liiketoiminnan jatkuvuussuunnitelmat" },
        { title: "Käyttöoikeuksien hallinta", description: "Toteuta vahvat identiteetti- ja käyttöoikeuksien hallintakontrollit" },
        { title: "Tietojen suojelu", description: "Varmista tietoturva ja yksityisyyden suojelu" },
        { title: "Seuranta ja tunnistus", description: "Perusta jatkuva seuranta ja uhkien tunnistus" },
        { title: "Vastaus ja palautuminen", description: "Kehitä tapahtumien vastaus- ja palautumisproseduurit" }
      ]
    },
    steps: {
      title: "Toteutusvaiheet",
      subtitle: "Systemaattinen lähestymistapa DORA yhteensopivuuteen",
      items: [
        { number: "01", title: "Aukkoanalyysi", description: "Arvioi nykyinen ICT-kestävyys DORA vaatimuksia vastaan" },
        { number: "02", title: "Kehyksen suunnittelu", description: "Suunnittele kattava ICT-riskinjohtamiskehys" },
        { number: "03", title: "Kontrollin toteutus", description: "Toteuta vaaditut ICT-kontrollit" },
        { number: "04", title: "Testaus ja validointi", description: "Suorita digitaalisen kestävyyden testaus" },
        { number: "05", title: "Seuranta ja raportointi", description: "Perusta jatkuva seuranta ja raportointikyvyt" }
      ]
    },
    benefits: {
      title: "DORA yhteensopivuuden edut",
      subtitle: "Yhteensopivuuden saavuttamisen strategiset edut",
      items: [
        "Parannettu toiminnallinen kestävyys",
        "Parannettu asiakkaiden luottamus",
        "Alennettu sääntelyriski",
        "Paremmat tapahtumien vastauskyvyt",
        "Kilpailuetu rahoitusmarkkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is DORA Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-4">
          {currentContent.dora.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.dora.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Key Requirements Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.requirements.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirements.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.requirements.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Areas Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.compliance.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.compliance.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.compliance.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-4 p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-12 h-12 bg-[#003580] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                {step.number}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <h3 class="text-base md:text-lg font-bold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-sm text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-[#003580] group-hover:h-[4px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <span class="text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300 relative z-10">
              {benefit}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>