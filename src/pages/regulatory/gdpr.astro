---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import Button from '@/components/ui/Button.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "GDPR";

const content = {
  en: {
    title: "GDPR",
    subtitle: "General Data Protection Regulation",
    heroDescription: "Navigate GDPR compliance requirements with expert guidance and proven implementation strategies for data protection and privacy.",
    forWho: "For organizations that process personal data of EU residents and need to ensure GDPR compliance.",
    achieve: "Full GDPR compliance with enhanced data protection and privacy capabilities.",
    gdpr: {
      title: "What is GDPR?",
      description: "The General Data Protection Regulation (GDPR) is a comprehensive EU data protection law that governs how organizations collect, process, store, and protect personal data of EU residents."
    },
    principles: {
      title: "GDPR Key Principles",
      subtitle: "Seven fundamental principles of data protection",
      items: [
        { title: "Lawfulness, Fairness & Transparency", description: "Process data lawfully, fairly, and transparently" },
        { title: "Purpose Limitation", description: "Collect data for specified, explicit, and legitimate purposes" },
        { title: "Data Minimization", description: "Collect only data that is adequate, relevant, and necessary" },
        { title: "Accuracy", description: "Ensure data is accurate and kept up to date" },
        { title: "Storage Limitation", description: "Retain data only for as long as necessary" },
        { title: "Integrity & Confidentiality", description: "Process data securely and protect against unauthorized access" },
        { title: "Accountability", description: "Demonstrate compliance with GDPR principles" }
      ]
    },
    compliance: {
      title: "GDPR Compliance Requirements",
      subtitle: "Essential areas for achieving compliance",
      items: [
        { title: "Data Mapping", description: "Identify and document all personal data processing activities" },
        { title: "Legal Basis", description: "Establish legal basis for data processing activities" },
        { title: "Consent Management", description: "Implement effective consent collection and management" },
        { title: "Data Subject Rights", description: "Enable data subjects to exercise their rights" },
        { title: "Data Protection Impact Assessment", description: "Conduct DPIAs for high-risk processing activities" },
        { title: "Breach Notification", description: "Establish data breach detection and notification procedures" }
      ]
    },
    steps: {
      title: "Implementation Steps",
      subtitle: "Systematic approach to GDPR compliance",
      items: [
        { number: "01", title: "Data Audit", description: "Conduct comprehensive data audit and mapping exercise" },
        { number: "02", title: "Gap Analysis", description: "Assess current practices against GDPR requirements" },
        { number: "03", title: "Policy Development", description: "Develop and implement data protection policies" },
        { number: "04", title: "Process Implementation", description: "Implement required data protection processes" },
        { number: "05", title: "Training & Awareness", description: "Train staff on GDPR requirements and procedures" }
      ]
    },
    benefits: {
      title: "Benefits of GDPR Compliance",
      subtitle: "Strategic advantages of achieving compliance",
      items: [
        "Enhanced data protection and privacy",
        "Improved customer trust and confidence",
        "Reduced regulatory and legal risks",
        "Better data governance and management",
        "Competitive advantage in the market"
      ]
    }
  },
  fi: {
    title: "GDPR",
    subtitle: "Yleinen tietosuoja-asetus",
    heroDescription: "Navigoi GDPR yhteensopivuusvaatimukset asiantuntevan ohjauksen ja todistettujen toteutusstrategioiden avulla tietojen suojelun ja yksityisyyden osalta.",
    forWho: "Organisaatioille, jotka käsittelevät EU:n asukkaiden henkilötietoja ja tarvitsevat GDPR yhteensopivuuden.",
    achieve: "Täysi GDPR yhteensopivuus parannetulla tietojen suojelulla ja yksityisyyskyvyillä.",
    gdpr: {
      title: "Mikä on GDPR?",
      description: "Yleinen tietosuoja-asetus (GDPR) on kattava EU:n tietosuoja-laki, joka säätelee miten organisaatiot keräävät, käsittelevät, säilyttävät ja suojaavat EU:n asukkaiden henkilötietoja."
    },
    principles: {
      title: "GDPR:n keskeiset periaatteet",
      subtitle: "Tietojen suojelun seitsemän perusperiaatetta",
      items: [
        { title: "Laillisuus, oikeudenmukaisuus ja läpinäkyvyys", description: "Käsittele tietoja laillisesti, oikeudenmukaisesti ja läpinäkyvästi" },
        { title: "Tarkoituksen rajoittaminen", description: "Kerää tietoja määritellyihin, selkeisiin ja oikeutettuihin tarkoituksiin" },
        { title: "Tietojen minimointi", description: "Kerää vain riittäviä, asiaankuuluvia ja tarpeellisia tietoja" },
        { title: "Tarkkuus", description: "Varmista että tiedot ovat tarkkoja ja ajan tasalla" },
        { title: "Säilytysajan rajoittaminen", description: "Säilytä tietoja vain niin kauan kuin tarpeen" },
        { title: "Eheys ja luottamuksellisuus", description: "Käsittele tietoja turvallisesti ja suojaa luvattomalta pääsyltä" },
        { title: "Vastuullisuus", description: "Näytä GDPR periaatteiden noudattaminen" }
      ]
    },
    compliance: {
      title: "GDPR yhteensopivuusvaatimukset",
      subtitle: "Yhteensopivuuden saavuttamisen keskeiset alueet",
      items: [
        { title: "Tietojen kartoitus", description: "Tunnista ja dokumentoi kaikki henkilötietojen käsittelytoiminnot" },
        { title: "Oikeusperusta", description: "Perusta oikeusperusta tietojen käsittelytoiminnoille" },
        { title: "Suostumuksen hallinta", description: "Toteuta tehokas suostumuksen keräys ja hallinta" },
        { title: "Tietojen subjektin oikeudet", description: "Mahdollista tietojen subjektien oikeuksien käyttö" },
        { title: "Tietojen suojelun vaikutusarviointi", description: "Suorita TSVA:t korkeariskisille käsittelytoiminnoille" },
        { title: "Tietoturvaloukkauksen ilmoittaminen", description: "Perusta tietoturvaloukkauksen tunnistus- ja ilmoitusproseduurit" }
      ]
    },
    steps: {
      title: "Toteutusvaiheet",
      subtitle: "Systemaattinen lähestymistapa GDPR yhteensopivuuteen",
      items: [
        { number: "01", title: "Tietojen auditointi", description: "Suorita kattava tietojen auditointi ja kartoitus" },
        { number: "02", title: "Aukkoanalyysi", description: "Arvioi nykyiset käytännöt GDPR vaatimuksia vastaan" },
        { number: "03", title: "Politiikkojen kehitys", description: "Kehitä ja toteuta tietojen suojelupolitiikat" },
        { number: "04", title: "Prosessien toteutus", description: "Toteuta vaaditut tietojen suojeluprosessit" },
        { number: "05", title: "Koulutus ja tietoisuus", description: "Kouluta henkilökuntaa GDPR vaatimuksista ja proseduureista" }
      ]
    },
    benefits: {
      title: "GDPR yhteensopivuuden edut",
      subtitle: "Yhteensopivuuden saavuttamisen strategiset edut",
      items: [
        "Parannettu tietojen suojelu ja yksityisyys",
        "Parannettu asiakkaiden luottamus ja varmuus",
        "Alennettu sääntely- ja oikeusriski",
        "Parempi tietojen hallinta ja johtaminen",
        "Kilpailuetu markkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-12 md:pt-16 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight mb-4">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout (Centered) -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <!-- Who is this for? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <!-- What will you achieve? -->
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300"></div>
            
            <div class="flex items-start gap-3 mb-3">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
                <svg class="w-5 h-5 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-sm font-semibold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What is GDPR Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-4">
          {currentContent.gdpr.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.gdpr.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Key Principles Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.principles.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.principles.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.principles.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Compliance Requirements Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.compliance.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.compliance.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {currentContent.compliance.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex items-start gap-3 mb-2">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center flex-shrink-0
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300 relative z-10">
                  {item.title}
                </h3>
              </div>
            </div>
            <p class="text-xs md:text-sm text-slate-500 leading-relaxed text-left pl-11 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Implementation Steps Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.steps.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.steps.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto space-y-4">
        {currentContent.steps.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col md:flex-row md:items-center gap-4 p-5 md:p-6 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-12 h-12 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] text-white rounded-xl flex items-center justify-center text-lg font-bold">
                {step.number}
              </div>
            </div>
            <div class="flex-1 relative z-10">
              <h3 class="text-base md:text-lg font-bold text-[#1E293B] group-hover:text-[#22D3EE] transition-colors duration-300">
                {step.title}
              </h3>
              <p class="text-sm text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-2">
          {currentContent.benefits.title}
        </h2>
        <p class="text-base text-[#0F172A] max-w-3xl mx-auto leading-relaxed">
          {currentContent.benefits.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {currentContent.benefits.items.map((benefit) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center gap-3 p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#0EA5E9] to-[#22D3EE] group-hover:h-[4px] transition-all duration-300 z-20"></div>
            
            <div class="flex-shrink-0 relative z-10">
              <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center
                          border-2 border-[#0EA5E9]
                          transition-all duration-300
                          group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:shadow-lg
                          group-hover:border-transparent">
                <svg class="w-4 h-4 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>
            <span class="text-sm text-slate-600 group-hover:text-slate-700 transition-colors duration-300 relative z-10">
              {benefit}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>