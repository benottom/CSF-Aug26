---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Palvelut | Kyberturvallisuus & Yhteensopivuus" : "Services | Cybersecurity & Compliance",
  description: lang === 'fi'
    ? "Laajat kyberturvallisuuden ja sääntelyvaatimustenmukaisuuspalvelut. ISO 27001, NIS2, GDPR, DORA toteutus ja hallinta. Asiantuntijapalvelut."
    : "Comprehensive cybersecurity and regulatory compliance services. ISO 27001, NIS2, GDPR, DORA implementation and management. Expert services.",
  type: "page" as const,
};

const content = {
  en: {
    hero: {
      title: "Comprehensive Cybersecurity & Compliance Services",
      subtitle: "Fast-track compliance with ISO 27001, NIS2, GDPR & DORA requirements",
      description: "Comprehensive cybersecurity and regulatory compliance services designed to meet the complex challenges of modern enterprises. Expert guidance, comprehensive documentation, and ongoing support included.",
      primaryCTA: { text: "Start Free Assessment", href: "/contact" },
      secondaryCTA: { text: "View All Services", href: "/services" }
    },
    serviceCategories: [
      {
        title: "Regulatory Compliance",
        description: "Full compliance with EU regulatory requirements",
        icon: "shield-check",
        services: [
          {
            title: "NIS2 Compliance",
            description: "Prepare for NIS2 directive requirements with expert guidance",
            href: "/services/nis2-compliance",
            level: "Strategic"
          },
          {
            title: "DORA Compliance",
            description: "Digital operational resilience for financial services",
            href: "/services/dora-compliance",
            level: "Strategic"
          },
          {
            title: "GDPR & Privacy Services",
            description: "Data protection compliance and privacy management solutions",
            href: "/services/gdpr-privacy",
            level: "Operational"
          },
          {
            title: "eIDAS & Digital Trust",
            description: "Electronic identification and trust services regulation",
            href: "/services/eidas-digital-trust",
            level: "Operational"
          }
        ]
      },
      {
        title: "Standards & Certification",
        description: "ISO 27001, SOC 2, and international standards implementation",
        icon: "document-check",
        services: [
          {
            title: "ISO 27001 Services",
            description: "Complete ISMS implementation in 90 days with certification support",
            href: "/services/iso-27001-services",
            level: "Strategic"
          },
          {
            title: "SOC 2 Readiness",
            description: "Type I and Type II readiness in 12 weeks",
            href: "/services/soc-2-readiness",
            level: "Operational"
          },
          {
            title: "Common Criteria",
            description: "International certification standard for IT security products",
            href: "/services/common-criteria",
            level: "Specialized"
          },
          {
            title: "ISO/IEC 20000-1",
            description: "IT service management standard",
            href: "/services/iso-20000-1",
            level: "Operational"
          }
        ]
      },
      {
        title: "Risk Management & Assessment",
        description: "Comprehensive risk management and assessment services",
        icon: "chart-bar",
        services: [
          {
            title: "Risk Management",
            description: "ISO 27005 and ISO 31000 compliant risk management",
            href: "/services/risk-management",
            level: "Strategic"
          },
          {
            title: "Risk Assessment",
            description: "Comprehensive risk assessment and management services",
            href: "/services/risk-assessments",
            level: "Operational"
          },
          {
            title: "Third-Party Risk (TPRM)",
            description: "Vendor risk management and assessment",
            href: "/services/third-party-risk",
            level: "Operational"
          },
          {
            title: "Security Assessment",
            description: "Comprehensive security assessment",
            href: "/services/security-assessment",
            level: "Operational"
          }
        ]
      },
      {
        title: "Governance & Strategy",
        description: "Cybersecurity governance and strategy",
        icon: "building-library",
        services: [
          {
            title: "Policy & Governance",
            description: "Strategic policy development and governance frameworks",
            href: "/services/policy-governance",
            level: "Strategic"
          },
          {
            title: "Business Continuity",
            description: "ISO 22301 business continuity management",
            href: "/services/business-continuity",
            level: "Strategic"
          },
          {
            title: "Audit Preparation",
            description: "Internal audits and certification readiness",
            href: "/services/audit-preparation",
            level: "Operational"
          },
          {
            title: "CISO-as-a-Service",
            description: "Virtual Chief Information Security Officer",
            href: "/services/ciso-as-a-service",
            level: "Strategic"
          }
        ]
      }
    ],
    cta: {
      title: "Ready to Secure Your Business?",
      subtitle: "Join hundreds of Finnish organizations that trust us for cybersecurity and compliance.",
      primaryCTA: { text: "Start Free Assessment", href: "/contact" },
      secondaryCTA: { text: "View All Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      title: "Laajat kyberturvallisuus- ja sääntelypalvelut",
      subtitle: "Nopea yhteensopivuus ISO 27001, NIS2, GDPR ja DORA -vaatimusten kanssa",
      description: "Kattavat kyberturvallisuuden ja sääntelyvaatimustenmukaisuuspalvelut, jotka on suunniteltu vastaamaan nykyaikaisten yritysten monimutkaisiin haasteisiin. Asiantunteva ohjaus, kattava dokumentointi ja jatkuva tuki mukana.",
      primaryCTA: { text: "Aloita ilmainen arviointi", href: "/fi/contact" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/fi/services" }
    },
    serviceCategories: [
      {
        title: "Sääntelyn noudattaminen",
        description: "Täysi yhteensopivuus EU:n sääntelyvaatimusten kanssa",
        icon: "shield-check",
        services: [
          {
            title: "NIS2 Yhteensopivuus",
            description: "Valmistele NIS2-direktiivin vaatimuksia asiantuntijan ohjauksella",
            href: "/fi/services/nis2-compliance",
            level: "Strateginen"
          },
          {
            title: "DORA Yhteensopivuus",
            description: "Digitaalinen toiminnallinen resilierenssi rahoituspalveluille",
            href: "/fi/services/dora-compliance",
            level: "Strateginen"
          },
          {
            title: "GDPR & Tietosuojapalvelut",
            description: "Tietosuojan noudattaminen ja yksityisyyden hallintaratkaisut",
            href: "/fi/services/gdpr-privacy",
            level: "Operatiivinen"
          },
          {
            title: "eIDAS & Digitaalinen luottamus",
            description: "Elektronisen tunnistamisen ja luottamispalvelujen sääntely",
            href: "/fi/services/eidas-digital-trust",
            level: "Operatiivinen"
          }
        ]
      },
      {
        title: "Standardit & Sertifiointi",
        description: "ISO 27001, SOC 2, ja muiden kansainvälisten standardien toteutus",
        icon: "document-check",
        services: [
          {
            title: "ISO 27001 -palvelut",
            description: "Täysi ISMS-toteutus 90 päivässä sertifiointituelle",
            href: "/fi/services/iso-27001-services",
            level: "Strateginen"
          },
          {
            title: "SOC 2 Valmius",
            description: "Type I ja Type II valmius 12 viikossa",
            href: "/fi/services/soc-2-readiness",
            level: "Operatiivinen"
          },
          {
            title: "Yhteiset kriteerit",
            description: "IT-turvallisuustuotteiden kansainvälinen sertifiointistandardi",
            href: "/fi/services/common-criteria",
            level: "Erityisala"
          },
          {
            title: "ISO/IEC 20000-1",
            description: "IT-palveluiden hallintastandardi",
            href: "/fi/services/iso-20000-1",
            level: "Operatiivinen"
          }
        ]
      },
      {
        title: "Riskienhallinta & Arviointipalvelut",
        description: "Kattava riskienhallinta ja arviointipalvelut",
        icon: "chart-bar",
        services: [
          {
            title: "Riskienhallinta",
            description: "ISO 27005 ja ISO 31000 -standardien mukainen riskienhallinta",
            href: "/fi/services/risk-management",
            level: "Strateginen"
          },
          {
            title: "Riskien arviointi",
            description: "Kattavat riskien arviointi- ja hallintapalvelut",
            href: "/fi/services/risk-assessments",
            level: "Operatiivinen"
          },
          {
            title: "Kolmannen osapuolen riski (TPRM)",
            description: "Toimittajariskien hallinta ja arviointi",
            href: "/fi/services/third-party-risk",
            level: "Operatiivinen"
          },
          {
            title: "Tietoturva-arviointi",
            description: "Kokonaisvaltainen tietoturva-arviointi",
            href: "/fi/services/security-assessment",
            level: "Operatiivinen"
          }
        ]
      },
      {
        title: "Hallinto & Strategia",
        description: "Kyberturvallisuuden hallinto ja strategiat",
        icon: "building-library",
        services: [
          {
            title: "Käytäntösäännöt & Hallinto",
            description: "Strateginen politiikan kehitys ja hallintokehykset",
            href: "/fi/services/policy-governance",
            level: "Strateginen"
          },
          {
            title: "Jatkuvuuden hallinta",
            description: "ISO 22301 -liiketoiminnan jatkuvuuden hallinta",
            href: "/fi/services/business-continuity",
            level: "Strateginen"
          },
          {
            title: "Tarkastuksen valmistelu",
            description: "Sisäiset tarkastukset ja sertifiointivalmius",
            href: "/fi/services/audit-preparation",
            level: "Operatiivinen"
          },
          {
            title: "CISO-palveluna",
            description: "Virtuaalinen pääkäyttöturvallisuuspäällikkö",
            href: "/fi/services/ciso-as-a-service",
            level: "Strateginen"
          }
        ]
      }
    ],
    cta: {
      title: "Oletko valmis suojaamaan liiketoimintaasi?",
      subtitle: "Liity satojen suomalaisten yritysten joukkoon, jotka luottavat meihin kyberturvallisuuteen ja vaatimustenmukaisuuteen.",
      primaryCTA: { text: "Aloita ilmainen arviointi", href: "/fi/contact" },
      secondaryCTA: { text: "Näytä kaikki palvelut", href: "/fi/services" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.hero.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.hero.description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base">
            {currentContent.hero.primaryCTA.text}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
            {currentContent.hero.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Services by Category -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {currentContent.serviceCategories.map((category) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col h-full group relative overflow-hidden" >
            
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="p-5 md:p-6 flex-1 flex flex-col">
              <div class="flex justify-end mb-3 relative z-10">
                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                            border-2 border-[#003580]
                            transition-all duration-300
                            group-hover:bg-[#003580] group-hover:shadow-lg
                            group-hover:border-transparent">
                  <Icon name={category.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
                </div>
              </div>
              
              <h3 class="text-lg font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
                {category.title}
              </h3>
              <p class="text-sm text-slate-500 leading-relaxed mb-4 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
                {category.description}
              </p>
              
              <div class="space-y-3 flex-1 relative z-10">
                {category.services.map((service) => (
                  <div class="border border-slate-200 rounded-lg p-3 hover:shadow-md hover:bg-slate-50 transition-all duration-200" >
                    <div class="flex justify-between items-start mb-1">
                      <h4 class="font-semibold text-slate-900 text-sm">{service.title}</h4>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-[2px] text-xs font-medium bg-[#003580]/10 text-[#003580]">
                        {service.level}
                      </span>
                    </div>
                    <p class="text-slate-600 text-xs mb-2">{service.description}</p>
                    <a 
                      href={service.href} 
                      class="inline-flex items-center text-sm text-[#14171a] hover:text-[#003580] font-medium gap-1 transition-all duration-300 group/link"
                    >
                      {isFi ? 'Lue lisää' : 'Learn more'}
                      <Icon name="arrowRight" class="w-3 h-3 transition-transform duration-300 group-hover/link:translate-x-1" />
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl border-2 border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 p-8 md:p-12 text-center relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580]"></div>
        
        <div class="flex items-center justify-center gap-4 mb-4">
          <div class="h-px w-10 bg-transparent"></div>
          <span class="text-[#131c2e] text-xl font-bold">✦</span>
          <div class="h-px w-10 bg-transparent"></div>
        </div>
        
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3 text-[#131c2e]">
          {currentContent.cta.title}
        </h2>
        <p class="text-sm md:text-base text-[#131c2e] mb-6 max-w-2xl mx-auto leading-relaxed">
          {currentContent.cta.subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href={currentContent.cta.primaryCTA.href} class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] bg-[#003580] text-white hover:bg-[#2E6FBA] transition-all duration-300 hover:shadow-lg font-medium text-sm gap-2 group">
            {currentContent.cta.primaryCTA.text}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={currentContent.cta.secondaryCTA.href} class="inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm gap-2 group">
            {currentContent.cta.secondaryCTA.text}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>