---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';
const title = "NIS2 Compliance";

const content = {
  en: {
    title: "NIS2 Compliance",
    subtitle: "EU Cybersecurity Directive",
    heroDescription: "Professional NIS2 compliance services. We help organizations meet EU Digital Operational Resilience Act requirements. Meet NIS2 requirements and strengthen your organization's cybersecurity resilience. We help critical infrastructure organizations achieve EU regulatory requirements.",
    forWho: "For organizations in critical infrastructure sectors seeking NIS2 compliance and regulatory readiness.",
    achieve: "NIS2 compliance with comprehensive cybersecurity risk management and resilience.",
    overview: {
      title: "Overview",
      description: "NIS2 (Network and Information Security Directive 2) is the EU's comprehensive cybersecurity directive that establishes requirements for critical infrastructure organizations. It mandates robust cybersecurity risk management, incident reporting, and resilience measures.",
      highlight: "Our expert team provides comprehensive NIS2 compliance services, from initial assessment and gap analysis through implementation and ongoing compliance monitoring."
    },
    requirements: {
      title: "NIS2 Requirements",
      subtitle: "NIS2 sets comprehensive requirements for cybersecurity and risk management.",
      items: [
        { title: "Risk Management", description: "Comprehensive cybersecurity risk management system", icon: "chart-line", requirements: ["Risk identification and assessment", "Risk management strategies", "Continuous monitoring"] },
        { title: "Security Monitoring", description: "24/7 security monitoring and threat detection", icon: "eye", requirements: ["SIEM systems", "Threat detection", "Incident response"] },
        { title: "Security Training", description: "Developing staff cybersecurity expertise", icon: "user", requirements: ["Regular training", "Security awareness", "Testing and simulation"] },
        { title: "Vendor Management", description: "Third-party risk management", icon: "users", requirements: ["Vendor assessment", "Contract management", "Continuous monitoring"] }
      ]
    },
    sectors: {
      title: "Affected Sectors",
      subtitle: "NIS2 applies to organizations in critical infrastructure sectors.",
      items: ["Financial Services", "Energy", "Transport", "Healthcare", "Water and Wastewater", "Digital Infrastructure"]
    },
    process: {
      title: "Compliance Process",
      subtitle: "Clear and structured process for NIS2 compliance.",
      items: [
        { number: "01", title: "NIS2 Assessment", description: "Assess current security posture against NIS2 requirements" },
        { number: "02", title: "Gap Analysis", description: "Identify gaps and plan remediation measures" },
        { number: "03", title: "Planning", description: "Plan NIS2 compliance program" },
        { number: "04", title: "Implementation", description: "Implement required security measures" },
        { number: "05", title: "Monitoring", description: "Continuous compliance monitoring and reporting" }
      ]
    },
    deliverables: {
      title: "What You Get",
      items: [
        "NIS2 compliance assessment report",
        "Risk management framework",
        "Security monitoring program",
        "Incident response procedures",
        "Staff training program",
        "Vendor management framework",
        "Compliance monitoring plan",
        "Ongoing compliance support"
      ]
    },
    benefitsList: {
      title: "Key Benefits",
      items: [
        "Meet EU regulatory requirements",
        "Strengthen cybersecurity resilience",
        "Reduce regulatory risks",
        "Improve customer trust",
        "Competitive advantage in markets"
      ]
    }
  },
  fi: {
    title: "NIS2 Yhteensopivuus",
    subtitle: "EU:n Kyberturvallisuusdirektiivi",
    heroDescription: "Ammattimaiset NIS2 yhteensopivuuspalvelut. Autamme organisaatioita täyttämään EU:n digitaalisen operatiivisen resilienssin lain vaatimukset. Täytä NIS2 vaatimukset ja vahvista organisaatiosi kyberturvan kestävyys. Autamme kriittisten infrastruktuurien organisaatioita saavuttamaan EU:n sääntelyvaatimukset.",
    forWho: "Kriittisten infrastruktuurisektorien organisaatioille, jotka tavoittelevat NIS2-vaatimustenmukaisuutta ja sääntelyvalmiutta.",
    achieve: "NIS2-vaatimustenmukaisuus kattavalla kyberturvariskien hallinnalla ja resilienssillä.",
    overview: {
      title: "Yleiskatsaus",
      description: "NIS2 (Network and Information Security Directive 2) on EU:n kattava kyberturvallisuusdirektiivi, joka asettaa vaatimuksia kriittisen infrastruktuurin organisaatioille. Se edellyttää vankkaa kyberturvariskien hallintaa, vikatilanteiden raportointia ja resilienssitoimenpiteitä.",
      highlight: "Asiantuntijatiimimme tarjoaa kattavia NIS2-yhteensopivuuspalveluita alkukartoituksesta ja aukkoanalyysistä toteutukseen ja jatkuvaan vaatimustenmukaisuuden seurantaan."
    },
    requirements: {
      title: "NIS2 Vaatimukset",
      subtitle: "NIS2 asettaa kattavat vaatimukset kyberturvalle ja riskienhallinnalle.",
      items: [
        { title: "Riskienhallinta", description: "Kattava kyberturvariskien hallintajärjestelmä", icon: "chart-line", requirements: ["Riskien tunnistus ja arviointi", "Riskien hallintastrategiat", "Jatkuva seuranta"] },
        { title: "Tietoturvavalvonta", description: "24/7 tietoturvavalvonta ja uhkien tunnistus", icon: "eye", requirements: ["SIEM järjestelmät", "Uhkien tunnistus", "Vikatilanteiden vastaus"] },
        { title: "Tietoturvakoulutus", description: "Henkilöstön tietoturvaosaamisen kehittäminen", icon: "user", requirements: ["Säännöllinen koulutus", "Tietoturvatietoisuus", "Testaus ja simulointi"] },
        { title: "Toimittajien hallinta", description: "Kolmannen osapuolen riskien hallinta", icon: "users", requirements: ["Toimittajien arviointi", "Sopimusten hallinta", "Jatkuva seuranta"] }
      ]
    },
    sectors: {
      title: "Koskevat Sektorit",
      subtitle: "NIS2 koskee organisaatioita kriittisissä infrastruktuurisektoreissa.",
      items: ["Rahoituspalvelut", "Energia", "Liikenne", "Terveydenhuolto", "Vesi ja jätevesi", "Digitaalinen infrastruktuuri"]
    },
    process: {
      title: "Yhteensopivuusprosessi",
      subtitle: "Selkeä ja strukturoitu prosessi NIS2 yhteensopivuuteen.",
      items: [
        { number: "01", title: "NIS2 Arviointi", description: "Arvioidaan nykyinen tietoturvataso NIS2 vaatimusten suhteen" },
        { number: "02", title: "Aukkoanalyysi", description: "Tunnistetaan puutteet ja suunnitellaan korjauskeinot" },
        { number: "03", title: "Suunnittelu", description: "Suunnitellaan NIS2 yhteensopivuusohjelma" },
        { number: "04", title: "Toteutus", description: "Toteutetaan tarvittavat tietoturvatoimenpiteet" },
        { number: "05", title: "Valvonta", description: "Jatkuva yhteensopivuuden valvonta ja raportointi" }
      ]
    },
    deliverables: {
      title: "Mitä saat",
      items: [
        "NIS2-yhteensopivuusarviointiraportti",
        "Riskienhallintakehys",
        "Tietoturvavalvontaohjelma",
        "Vikatilanteiden hallintamenettelyt",
        "Henkilöstön koulutusohjelma",
        "Toimittajien hallintakehys",
        "Vaatimustenmukaisuuden seurantasuunnitelma",
        "Jatkuva yhteensopivuustuki"
      ]
    },
    benefitsList: {
      title: "Keskeiset edut",
      items: [
        "Täytä EU sääntelyvaatimukset",
        "Vahvista kyberturvan kestävyyttä",
        "Vähennä sääntelyriskejä",
        "Paranna asiakkaiden luottamusta",
        "Kilpailuetu markkinoilla"
      ]
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout title={title}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-[#131c2e] bg-clip-text text-transparent">
            {currentContent.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {currentContent.heroDescription}
        </p>
        
        <!-- Info Section - Two Column Layout -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <Icon name="users" class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Kelle tämä on tarkoitettu?' : 'Who is this for?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.forWho}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6 group hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 relative overflow-hidden text-left">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start gap-3 mb-2">
              <div class="w-9 h-9 bg-white rounded-xl flex items-center justify-center flex-shrink-0 border-2 border-[#003580] group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
                <Icon name="check" class="w-4.5 h-4.5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
              <div>
                <h2 class="text-xs font-semibold text-[#14171a] group-hover:text-[#2E6FBA] transition-colors duration-300">
                  {isFi ? 'Mitä saavutat?' : 'What will you achieve?'}
                </h2>
                <p class="text-xs md:text-sm text-slate-600 leading-relaxed group-hover:text-slate-700 transition-colors duration-300">
                  {currentContent.achieve}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Overview Section -->
  <section class="py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto bg-white rounded-xl border-2 border-slate-100 shadow-sm p-5 md:p-6">
        <p class="text-sm text-slate-600 leading-relaxed">{currentContent.overview.description}</p>
        <p class="text-sm text-blue-600 font-semibold mt-3">{currentContent.overview.highlight}</p>
      </div>
    </div>
  </section>

  <!-- Requirements Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.requirements.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.requirements.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {currentContent.requirements.items.map((item) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-end mb-2 relative z-10">
              <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center
                          border-2 border-[#003580]
                          transition-all duration-300
                          group-hover:bg-[#003580] group-hover:shadow-lg
                          group-hover:border-transparent">
                <Icon name={item.icon} class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" />
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1.5 group-hover:text-[#2E6FBA] transition-colors duration-300 text-left relative z-10">
              {item.title}
            </h3>
            <p class="text-xs text-slate-500 mb-2 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {item.description}
            </p>
            
            <div class="mt-auto pt-2 border-t border-slate-100 relative z-10">
              <ul class="space-y-1">
                {item.requirements.map((req) => (
                  <li class="flex items-start text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300">
                    <Icon name="check" class="w-3 h-3 text-[#003580] mr-1.5 mt-0.5 flex-shrink-0" />
                    {req}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sectors Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.sectors.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.sectors.subtitle}
        </p>
      </div>
      
      <div class="max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-3 gap-4">
        {currentContent.sectors.items.map((sector) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex items-center justify-center gap-2 p-3 group">
            <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0
                        transition-all duration-300
                        group-hover:bg-[#003580]">
              <Icon name="building" class="w-4 h-4 text-blue-600 group-hover:text-white transition-colors duration-300" />
            </div>
            <span class="text-slate-700 text-xs font-medium group-hover:text-[#14171a] transition-colors duration-300">{sector}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-[#003580] mb-2">
          {currentContent.process.title}
        </h2>
        <p class="text-base text-[#131c2e] max-w-3xl mx-auto leading-relaxed">
          {currentContent.process.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {currentContent.process.items.map((step) => (
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-4 md:p-5 group relative overflow-hidden text-center">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300 z-20"></div>
            
            <div class="flex justify-center mb-2 relative z-10">
              <div class="w-10 h-10 bg-[#003580] rounded-full flex items-center justify-center text-white font-bold text-sm">
                {step.number}
              </div>
            </div>
            
            <h3 class="text-sm font-bold text-[#14171a] mb-1 group-hover:text-[#2E6FBA] transition-colors duration-300 relative z-10">
              {step.title}
            </h3>
            <p class="text-xs text-slate-500 group-hover:text-slate-600 transition-colors duration-300 relative z-10">
              {step.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Deliverables & Benefits Section -->
  <section class="py-12 md:py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 max-w-3xl mx-auto">
        
        <!-- Deliverables -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.deliverables.title}</h2>
          <ul class="space-y-2">
            {currentContent.deliverables.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <Icon name="check" class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" />
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
        <!-- Benefits -->
        <div class="bg-white rounded-xl border-2 border-[#003580] shadow-sm p-5 md:p-6">
          <h2 class="text-base font-bold text-[#003580] mb-4 text-center">{currentContent.benefitsList.title}</h2>
          <ul class="space-y-2">
            {currentContent.benefitsList.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <Icon name="check" class="w-3.5 h-3.5 text-[#003580] mt-0.5 flex-shrink-0" />
                <span class="text-xs md:text-sm text-slate-600">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        
      </div>
    </div>
  </section>

</Layout>