---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const seoConfig = {
  title: lang === 'fi' ? "Ota yhteyttä" : "Contact",
  description: lang === 'fi'
    ? "Ota yhteyttä Cyber Security Finlandin kyberturvallisuusasiantuntijoihin."
    : "Contact Cyber Security Finland's cybersecurity experts.",
  type: "page" as const,
};

const content = {
  en: {
    title: "Contact",
    subtitle: "Get in Touch",
    description: "Connect with our team of cybersecurity experts. We're here to help you with your security challenges.",
  },
  fi: {
    title: "Yhteystiedot",
    subtitle: "Ota yhteyttä",
    description: "Ota yhteyttä kyberturvallisuusasiantuntijatiimiimme. Olemme täällä auttamassa sinua turvallisuushaasteissasi.",
  }
};

const c = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="pt-10 md:pt-14 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight mb-3">
          <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent">
            {c.subtitle}
          </span>
        </h1>
        <p class="text-base md:text-lg text-slate-600 leading-relaxed max-w-3xl mx-auto">
          {c.description}
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information Cards -->
  <section class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Phone -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
            <Icon name="phone" class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300">{isFi ? 'Puhelin' : 'Phone'}</h3>
          <p class="text-sm text-slate-500">+358 44 5040308</p>
          <p class="text-xs text-slate-400 mt-1">{isFi ? 'Ma-Pe, 9:00-17:00' : 'Mon-Fri, 9:00-17:00'}</p>
        </div>

        <!-- Email -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
            <Icon name="mail" class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300">{isFi ? 'Sähköposti' : 'Email'}</h3>
          <p class="text-sm text-slate-500">info@cybersecurity.fi</p>
          <p class="text-xs text-slate-400 mt-1">{isFi ? 'Vastaamme 24 tunnin sisällä' : 'We respond within 24h'}</p>
        </div>

        <!-- Location -->
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 text-center hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300 group">
          <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center mx-auto mb-3 border-2 border-[#0EA5E9] group-hover:bg-gradient-to-r group-hover:from-[#0EA5E9] group-hover:to-[#22D3EE] group-hover:border-transparent transition-all duration-300">
            <Icon name="map-pin" class="w-6 h-6 text-[#0EA5E9] group-hover:text-white transition-colors duration-300" />
          </div>
          <h3 class="text-sm font-bold text-[#1E293B] mb-1 group-hover:text-[#22D3EE] transition-colors duration-300">{isFi ? 'Osoite' : 'Location'}</h3>
          <p class="text-sm text-slate-500">{isFi ? 'Helsinki, Suomi' : 'Helsinki, Finland'}</p>
          <p class="text-xs text-slate-400 mt-1">{isFi ? 'Palvelemme asiakkaita maailmanlaajuisesti' : 'Serving clients globally'}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form -->
  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <h2 class="text-2xl md:text-3xl font-bold text-[#0EA5E9] mb-6">{isFi ? 'Lähetä viesti' : 'Send Us a Message'}</h2>
          <form id="contact-form" action="https://formspree.io/f/mljrnwnn" method="POST" class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 md:p-8">
            <input type="hidden" name="_language" value={isFi ? 'fi' : 'en'} />
            
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Etunimi *' : 'First Name *'}</label>
                <input type="text" id="firstName" name="firstName" required aria-required="true" autocomplete="given-name" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna etunimesi' : 'Enter your first name'} />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Sukunimi *' : 'Last Name *'}</label>
                <input type="text" id="lastName" name="lastName" required aria-required="true" autocomplete="family-name" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna sukunimesi' : 'Enter your last name'} />
              </div>
            </div>
            
            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Yritys' : 'Company'}</label>
              <input type="text" id="company" name="company" autocomplete="organization" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna yrityksesi nimi' : 'Enter your company name'} />
            </div>

            <div class="grid md:grid-cols-2 gap-6 mt-6">
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Sähköposti *' : 'Email *'}</label>
                <input type="email" id="email" name="email" required aria-required="true" autocomplete="email" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna sähköpostiosoitteesi' : 'Enter your email address'} />
              </div>
              <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Puhelinnumero' : 'Phone Number'}</label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Anna puhelinnumerosi' : 'Enter your phone number'} />
              </div>
            </div>

            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Kiinnostuksen kohde' : 'Service Interest'}</label>
              <select id="service" name="service" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white">
                <option value="">{isFi ? 'Valitse palvelu' : 'Select a service'}</option>
                <option value="iso-27001">ISO 27001 Certification</option>
                <option value="nis2">NIS2 Compliance</option>
                <option value="gdpr">GDPR & Privacy</option>
                <option value="dora">DORA Compliance</option>
                <option value="soc2">SOC2 Readiness</option>
                <option value="ciso">CISO as a Service</option>
                <option value="dpo">DPO as a Service</option>
                <option value="risk">Risk Assessment</option>
                <option value="other">{isFi ? 'Muu / Yleinen tiedustelu' : 'Other/General Inquiry'}</option>
              </select>
            </div>

            <div class="mt-6">
              <label class="block text-sm font-medium text-slate-700 mb-2">{isFi ? 'Viesti *' : 'Message *'}</label>
              <textarea id="message" name="message" required aria-required="true" rows="5" class="w-full px-4 py-3 rounded-xl border-2 border-slate-200 focus:border-[#0EA5E9] focus:ring-2 focus:ring-[#0EA5E9]/20 transition-all duration-200 bg-white" placeholder={isFi ? 'Kuvaile tarpeitasi tai kysymyksiäsi...' : 'Describe your needs or questions...'}></textarea>
            </div>

            <div class="mt-6">
              <button type="submit" id="submit-btn" class="w-full md:w-auto inline-flex items-center justify-center px-8 py-3 rounded-full bg-gradient-to-r from-[#0F172A] to-[#0EA5E9] text-white hover:from-[#0EA5E9] hover:to-[#0F172A] transition-all duration-300 hover:shadow-lg font-medium text-sm">
                <span id="btn-text">{isFi ? 'Lähetä viesti' : 'Send Message'}</span>
                <svg id="btn-spinner" class="hidden w-5 h-5 animate-spin ml-2" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </button>
            </div>

            <!-- Success Message -->
            <div id="form-success" class="hidden mt-6 p-4 bg-green-50 border border-green-200 rounded-xl">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h4 class="text-green-800 font-semibold">{isFi ? 'Viesti vastaanotettu!' : 'Message Received!'}</h4>
                  <p class="text-green-700 text-sm">{isFi ? 'Kiitos yhteydenotostasi. Olemme vastaanottaneet pyyntösi ja tiimimme ottaa sinuun yhteyttä 24 tunnin kuluessa.' : 'Thank you for contacting us. We have received your request and our team will get back to you within 24 hours.'}</p>
                  <p class="text-green-600 text-sm mt-1">{isFi ? 'Jos asiasi on kiireellinen, soita meille numeroon +358 44 5040308.' : 'If your matter is urgent, please call us at +358 44 5040308.'}</p>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="form-error" class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-xl">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h4 class="text-red-800 font-semibold">{isFi ? 'Lähetys epäonnistui' : 'Submission Failed'}</h4>
                  <p class="text-red-700 text-sm">{isFi ? 'Jokin meni pieleen viestiä lähetettäessä. Yritä uudelleen.' : 'Something went wrong while sending your message. Please try again.'}</p>
                  <p class="text-red-600 text-sm mt-1">{isFi ? 'Tai ota meihin yhteyttä suoraan osoitteessa info@cybersecurity.fi tai soita +358 44 5040308.' : 'Or contact us directly at info@cybersecurity.fi or call +358 44 5040308.'}</p>
                </div>
              </div>
            </div>
          </form>
        </div>
        
        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <h3 class="text-base font-bold text-[#1E293B] mb-3">{isFi ? 'Palvelumme' : 'Our Services'}</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">ISO 27001</span> — {isFi ? 'Täydellinen ISMS-toteutus 90 päivässä' : 'Complete ISMS implementation in 90 days'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">NIS2 Compliance</span> — {isFi ? 'Valmistaudu NIS2-direktiivin vaatimuksiin' : 'Prepare for NIS2 directive requirements'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">GDPR Compliance</span> — {isFi ? 'Tietosuoja ja tietosuojan hallinta' : 'Data protection and privacy management'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">DORA Compliance</span> — {isFi ? 'Digitaalinen operatiivinen resilienssi' : 'Digital operational resilience'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">V-CISO Service</span> — {isFi ? 'Virtuaalinen tietoturvapäällikkö' : 'Virtual CISO guidance'}</span>
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span><span class="font-semibold text-slate-700">V-DPO Service</span> — {isFi ? 'Virtuaalinen tietosuojavastaava' : 'Virtual Data Protection Officer'}</span>
              </li>
            </ul>
          </div>
          <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm p-6 hover:shadow-xl hover:-translate-y-1 hover:shadow-md transition-all duration-300">
            <h3 class="text-base font-bold text-[#1E293B] mb-3">{isFi ? 'Miksi valita meidät?' : 'Why Choose Us?'}</h3>
            <ul class="space-y-3">
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Asiantuntijatiimi Suomessa' : 'Expert team based in Finland'}
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Todistetut menetelmät 90 päivän toteutuksella' : 'Proven methodologies with 90-day implementation'}
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Jatkuva tuki ja asiantuntemus' : 'Ongoing support and expertise'}
              </li>
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="w-4 h-4 text-[#0EA5E9] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {isFi ? 'Toimialakohtainen asiantuntemus' : 'Industry-specific expertise'}
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  (function() {
    var form = document.getElementById('contact-form');
    var submitBtn = document.getElementById('submit-btn');
    var btnText = document.getElementById('btn-text');
    var btnSpinner = document.getElementById('btn-spinner');
    var successMsg = document.getElementById('form-success');
    var errorMsg = document.getElementById('form-error');

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();

        btnText.textContent = 'Lähetetään...';
        btnSpinner.classList.remove('hidden');
        submitBtn.disabled = true;
        successMsg.classList.add('hidden');
        errorMsg.classList.add('hidden');

        fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        })
        .then(function(response) {
          if (response.ok) {
            form.reset();
            successMsg.classList.remove('hidden');
            btnText.textContent = 'Lähetä viesti';
          } else {
            throw new Error('Form submission failed');
          }
        })
        .catch(function(error) {
          errorMsg.classList.remove('hidden');
          btnText.textContent = 'Lähetä viesti';
        })
        .finally(function() {
          btnSpinner.classList.add('hidden');
          submitBtn.disabled = false;
        });
      });
    }
  })();
</script>