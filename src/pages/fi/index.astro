---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Security Finland | Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta",
  description: "Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta. ISO 27001, NIS2, CRA ja EUCC -toteutus todistetuin menetelmin maailmanlaajuisille organisaatioille.",
  keywords: "kyberturvallisuus suomi, ISO 27001 yhteensopivuus, NIS2 direktiivi, GDPR asiantuntija, CRA vaatimustenmukaisuus, EUCC-sertifiointi, tietoturva konsultointi, kyberturvallisuus palvelut suomi, sääntely konsultointi, riskienhallinta palvelut",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cyber Security Finland",
    "url": "https://cybersecurity.fi",
    "description": "Kyberturvallisuus- ja vaatimustenmukaisuusneuvontapalvelut. ISO 27001, NIS2, CRA ja EUCC -toteutus todistetuin menetelmin maailmanlaajuisille organisaatioille.",
    "publisher": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cybersecurity.fi/csf-logo-2026.png",
        "width": 300,
        "height": 300
      }
    },
    "potentialAction": {
      "@type": "ContactAction",
      "target": "https://cybersecurity.fi/fi/contact",
      "name": "Ota yhteyttä"
    }
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      eyebrow: "NIS2 · CRA · EUCC",
      title: "Enterprise Cybersecurity & Compliance Advisory for Regulated Europe",
      subtitle: "NIS2, CRA, and EUCC deadlines are closing in. We help regulated European enterprises engineer audit-ready ISO 27001 and GDPR controls — turning compliance from a cost center into a competitive advantage.",
      primaryCTA: { text: "Request Consultation", href: "/contact" },
      secondaryCTA: { text: "Explore Capabilities", href: "/services" }
    },
    services: {
      title: "Core Capabilities",
      description: "Comprehensive cybersecurity and regulatory compliance solutions for enterprises across regulated industries",
      items: [
        {
          title: "Information Security Management",
          description: "ISO 27001 implementation and certification readiness programs",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Regulatory Compliance",
          description: "NIS2 directive compliance and cybersecurity resilience frameworks",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Data Protection & Privacy",
          description: "GDPR compliance programs and privacy governance frameworks",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Cyber Resilience Act (CRA)",
          description: "CRA and EUCC compliance engineering for connected products and software placed on the EU market",
          icon: "cog",
          href: "/services/compliance-engineering"
        }
      ]
    },
    cta: {
      title: "Transform Your Security Posture",
      subtitle: "Partner with experienced advisors trusted by enterprises in highly regulated industries worldwide.",
      primaryCTA: { text: "Schedule Consultation", href: "/contact" },
      secondaryCTA: { text: "View Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      eyebrow: "NIS2 · CRA · EUCC",
      title: "Kyberturvallisuus- ja vaatimustenmukaisuusneuvonta säännellylle Euroopalle",
      subtitle: "NIS2-, CRA- ja EUCC-määräajat lähestyvät nopeasti. Autamme säänneltyjä eurooppalaisia yrityksiä rakentamaan auditointivalmiit ISO 27001- ja GDPR-kontrollit – ja muuttamaan vaatimustenmukaisuuden kilpailueduksi.",
      primaryCTA: { text: "Pyydä konsultaatio", href: "/fi/contact" },
      secondaryCTA: { text: "Tutustu palveluihin", href: "/fi/services" }
    },
    services: {
      title: "Ydinosaamisalueet",
      description: "Kattavat kyberturvallisuus- ja sääntelyvaatimustenmukaisuusratkaisut yrityksille säännellyillä toimialoilla",
      items: [
        {
          title: "Tietoturvallisuuden hallinta",
          description: "ISO 27001 -toteutus ja sertifiointivalmius-ohjelmat",
          icon: "shield-check",
          href: "/fi/packages/iso-27001-fast-track"
        },
        {
          title: "Sääntelyvaatimustenmukaisuus",
          description: "NIS2-direktiivin vaatimustenmukaisuus ja kyberturvallisuuden resilienssi",
          icon: "globe-alt",
          href: "/fi/services/nis2-compliance"
        },
        {
          title: "Tietosuoja ja yksityisyys",
          description: "GDPR-vaatimustenmukaisuusohjelmat ja tietosuojan hallintakehykset",
          icon: "lock-closed",
          href: "/fi/services/gdpr-privacy-services"
        },
        {
          title: "Kyberkestävyyssäädös (CRA)",
          description: "CRA- ja EUCC-vaatimustenmukaisuus EU:n markkinoille tuotaville yhdistetyille tuotteille ja ohjelmistoille",
          icon: "cog",
          href: "/fi/services/compliance-engineering"
        }
      ]
    },
    cta: {
      title: "Muuta turvallisuusasemaasi",
      subtitle: "Kumppani kokeneiden neuvonantajien kanssa, joihin luottavat yritykset erittäin säännellyillä toimialoilla maailmanlaajuisesti.",
      primaryCTA: { text: "Varaa konsultaatio", href: "/fi/contact" },
      secondaryCTA: { text: "Näytä palvelut", href: "/fi/services" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

const keyServices = [
  {
    title: isFi ? "Yhteensopivuuskehykset" : "Compliance Frameworks",
    description: isFi
      ? "Muunna sääntelyvaatimukset kilpailueduksi. Asiantunteva ISO 27001, SOC 2, GDPR, NIS2, CRA ja EUCC -kehyksien toteutus todistettujen nopean toteutuksen metodologioiden avulla."
      : "Transform regulatory requirements into competitive advantages. Expert implementation of ISO 27001, SOC 2, GDPR, NIS2, CRA, and EUCC frameworks with proven fast-track methodologies.",
    icon: "shield-check",
    href: isFi ? "/fi/services" : "/services"
  },
  {
    title: isFi ? "Riskienhallinta" : "Risk Management",
    description: isFi
      ? "Tunnista, arvioi ja lievitä kyberturvallisuusriskit tehokkaasti. Kattavat riskien arvioinnit, kolmannen osapuolen riskienhallinta ja liiketoiminnan jatkuvuuden suunnittelu organisaatiollesi räätälöitynä."
      : "Identify, assess, and mitigate cybersecurity risks effectively. Comprehensive risk assessments, third-party risk management, and business continuity planning tailored to your organization.",
    icon: "chart-line",
    href: isFi ? "/fi/services" : "/services"
  },
  {
    title: isFi ? "Hallinto & Strategia" : "Governance & Policy",
    description: isFi
      ? "Rakenna vahvoja kyberturvallisuuden hallintorakenteita. Strateginen politiikan kehitys, CISO-palveluna ja hallituksen tason riskiraportointi varmistaaksesi organisaation turvallisuuden kypsyyden."
      : "Establish robust cybersecurity governance structures. Strategic policy development, CISO-as-a-Service, Virtual CISO (V-CISO), and board-level risk reporting to ensure organizational security maturity.",
    icon: "building-library",
    href: isFi ? "/fi/services" : "/services"
  },
  {
    title: isFi ? "Erikoispalvelut" : "Specialized Services",
    description: isFi
      ? "Asiantuntijapalvelut ainutlaatuisiin kyberturvallisuuden haasteisiin. Petostorjuntapalvelut, digitaalisen luottamuksen ratkaisut, tarkastuksen valmistelu ja erikoisvaatimustenmukaisuustuki monimutkaisiin vaatimuksiin."
      : "Expert services for unique cybersecurity challenges. Anti-fraud services, digital trust solutions, audit preparation, and specialized compliance support for complex requirements.",
    icon: "star",
    href: isFi ? "/fi/services" : "/services"
  }
];

const complianceFrameworks = [
  {
    title: "ISO 27001",
    description: isFi 
      ? "Tietoturvan hallintajärjestelmä - kansainvälinen standardi kyberturvallisuuden hallinnolle."
      : "Information Security Management System - the international standard for cybersecurity management.",
    icon: "shield-check",
    href: isFi ? "/fi/frameworks/iso-27001" : "/frameworks/iso-27001"
  },
  {
    title: "NIS2 Direktiivi",
    description: isFi
      ? "Verkko- ja tietoturvalaki - EU:n kyberturvallisuuslainsäädäntö keskeisille ja tärkeille toimijoille."
      : "Network and Information Security Directive - EU cybersecurity legislation for essential and important entities.",
    icon: "globe-alt",
    href: isFi ? "/fi/regulatory/nis2" : "/frameworks/nis2"
  },
  {
    title: "GDPR",
    description: isFi
      ? "Yleinen tietosuoja-asetus - EU:n tietosuojalainsäädäntö henkilötietojen suojelulle ja yksityisyydelle."
      : "General Data Protection Regulation - EU privacy regulation for personal data protection and privacy.",
    icon: "lock-closed",
    href: isFi ? "/fi/regulatory/gdpr" : "/regulatory/gdpr"
  },
  {
    title: "EUCC",
    description: isFi
      ? "Euroopan yhteisiin kriteereihin perustuva kyberturvallisuuden sertifiointijärjestelmä - EU:n yhdenmukaistettu järjestelmä ICT-tuotteiden kyberturvallisuuden sertifiointiin."
      : "European Common Criteria-based Cybersecurity Certification Scheme - the EU's harmonized scheme for certifying ICT product cybersecurity.",
    icon: "badge",
    href: isFi ? "/fi/services/compliance-engineering" : "/services/compliance-engineering"
  },
  {
    title: "SOC 2",
    description: isFi
      ? "Service Organization Control 2 - tarkastusmenettely, joka varmistaa palveluntarjoajien hallitsevan tietojen turvallisuuden."
      : "Service Organization Control 2 - auditing procedure that ensures service providers securely manage data.",
    icon: "document-check",
    href: isFi ? "/fi/frameworks/soc-2" : "/frameworks/soc-2"
  },
  {
    title: "Yhteiset kriteerit",
    description: isFi
      ? "Kansainvälinen standardi tietoturvan sertifiointiin - arviointikriteerit IT-turvallisuustuotteille."
      : "International standard for computer security certification - evaluation criteria for IT security products.",
    icon: "star",
    href: isFi ? "/fi/frameworks/common-criteria" : "/frameworks/common-criteria"
  }
];

const industries = [
  { 
    name: isFi ? "Rahoituspalvelut & Fintech" : "Financial Services & Fintech", 
    icon: "bank", 
    href: isFi ? "/fi/industries/financial-services-fintech" : "/industries/financial-services-fintech",
    image: "/images/industries/financial.avif",
    description: isFi 
      ? "Erikoistunut DORA, PCI DSS ja toiminnan resilierenssin asiantuntemus pankeille, maksunkäsittelyyrityksille ja fintech-yrityksille."
      : "Specialized DORA, PCI DSS, and operational resilience expertise for banks, payment processors, and fintech companies."
  },
  { 
    name: isFi ? "SaaS & Teknologia" : "SaaS & Technology", 
    icon: "code", 
    href: isFi ? "/fi/industries/saas-technology" : "/industries/saas-technology",
    image: "/images/industries/saas.avif",
    description: isFi
      ? "ISO 27001, SOC 2 ja pilvitietoturvan kehykset räätälöitynä ohjelmisto- ja teknologiayrityksille."
      : "ISO 27001, SOC 2, and cloud security frameworks tailored for software companies and technology service providers."
  },
  { 
    name: isFi ? "Terveys & Elintarviketeollisuus" : "Healthcare & Life Sciences", 
    icon: "heart", 
    href: isFi ? "/fi/industries/healthcare-life-sciences" : "/industries/healthcare-life-sciences",
    image: "/images/industries/healthcare.avif",
    description: isFi
      ? "GDPR, Virtuaalinen DPO (V-DPO), lääketieteellisten laitteiden sääntely ja potilastietojen suojaus yhteensopivuus terveydenhuollon organisaatioille ja elintarviketeollisuuden yrityksille."
      : "GDPR, Virtual DPO (V-DPO), medical device regulations, and patient data protection compliance for healthcare organizations and life sciences companies."
  },
  { 
    name: isFi ? "Kriittinen infrastruktuuri" : "Critical Infrastructure", 
    icon: "bolt", 
    href: isFi ? "/fi/industries/critical-infrastructure-energy" : "/industries/critical-infrastructure-energy",
    image: "/images/industries/critical.avif",
    description: isFi
      ? "NIS2-direktiivin toteutus, operaatioteknologian turvallisuus ja resilierenssin suunnittelu oleellisille palveluntarjoajille."
      : "NIS2 directive implementation, operational technology security, and resilience planning for essential service providers."
  },
  { 
    name: isFi ? "Julkinen sektori" : "Public Sector", 
    icon: "building", 
    href: isFi ? "/fi/industries/public-sector-finland" : "/industries/public-sector-finland",
    image: "/images/industries/public.avif",
    description: isFi
      ? "Hallituksen erityiset sääntelykehykset, julkiset hankinnat ja kansalaisten tietosuojan standardit."
      : "Government-specific compliance frameworks, public procurement requirements, and citizen data protection standards."
  },
  { 
    name: isFi ? "Valmistava teollisuus" : "Manufacturing & Industrial", 
    icon: "cog", 
    href: isFi ? "/fi/industries/manufacturing-industrial" : "/industries/manufacturing-industrial",
    image: "/images/industries/manufacturing.avif",
    description: isFi
      ? "Teollisuuden IoT-tietoturva, toimittajaketjun suojaus ja operaatioiden jatkuvuus valmistaville ja teollisille organisaatioille."
      : "Industrial IoT security, supply chain protection, and operational continuity for manufacturing and industrial organizations."
  }
];

const latestResources = [
  {
    title: isFi ? "ISO 27001 Pika-aloitusopas" : "ISO 27001 Quick Start Guide",
    excerpt: isFi ? "25-sivuinen toteutusroadmap" : "25-page implementation roadmap",
    href: isFi ? "/fi/resources/guides/iso-27001-quick-start" : "/resources/guides/iso-27001-quick-start",
    category: isFi ? "Opas" : "Guide"
  },
  {
    title: isFi ? "NIS2 Yhteensopivuus Tarkistuslista" : "NIS2 Compliance Checklist",
    excerpt: isFi ? "Täysi vaatimusanalyysityökalu" : "Complete requirement assessment tool",
    href: isFi ? "/fi/resources/guides/nis2-compliance-checklist" : "/resources/guides/nis2-compliance-checklist",
    category: isFi ? "Tarkistuslista" : "Checklist"
  },
  {
    title: isFi ? "GDPR Tietosuoja-vaikutusten Arviointi Malli" : "GDPR Privacy Impact Assessment Template",
    excerpt: isFi ? "Valmiiksi määritelty PIA-kehys" : "Ready-to-use PIA framework",
    href: isFi ? "/fi/resources/guides/gdpr-pia-template" : "/resources/guides/gdpr-pia-template",
    category: isFi ? "Malli" : "Template"
  }
];
---

<Layout {...seoConfig}>

<!-- Hero Section - WITH BACKGROUND IMAGE -->
<section class="text-slate-900 md:min-h-screen flex items-center relative overflow-hidden bg-cover bg-center bg-no-repeat" style="background-image: url('/images/bgf.jpg')">
  
  <!-- Fade overlay at top -->
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-white to-transparent"></div>
  
  <!-- Fade with blur effect -->
  <div class="absolute bottom-0 left-0 right-0 h-56 bg-gradient-to-t from-white via-white/80 to-transparent backdrop-blur-sm"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-4">
    
    <!-- TITLE AT THE VERY TOP - CENTERED -->
    <div class="text-center mb-6 md:mb-12 lg:mb-20">
      <div class="flex justify-center mb-4">
        <span class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-1 text-xs font-semibold uppercase tracking-widest text-[#0F172A] shadow-sm">
          <span class="h-1.5 w-1.5 rounded-full bg-[#DC2626]"></span>
          {currentContent.hero.eyebrow}
        </span>
      </div>
      <h1 class="font-bold tracking-tight leading-tight"
          style="font-size: clamp(24px, 5vw, 45px);">
        <span class="bg-gradient-to-r from-[#0F172A] to-[#22D3EE] bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient">
          {currentContent.hero.title}
        </span>
      </h1>
    </div>

    <!-- Mobile layout (stacked vertically) -->
    <div class="flex flex-col items-center justify-center gap-6 mb-8 md:hidden">
      <img 
        src="/images/cyber.webp"
        alt="kyberturvallisuus konsepti"
        class="w-full max-w-xs object-cover"
        loading="eager"
      />
    </div>
    
    <div class="text-center">
      
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Side: Content -->
        <div class="text-center">
          <div class="text-center">
            <div class="hidden md:flex items-center justify-center gap-4 mb-4 -mt-20">
              <div class="h-px w-16 bg-gradient-to-r from-transparent to-[#0F172A]"></div>
              <span class="text-[#0F172A] text-3xl font-bold animate-pulse" style="animation-duration: 2s;">✦</span>
              <div class="h-px w-16 bg-gradient-to-l from-transparent to-[#0F172A]"></div>
            </div>
            
            <p class="text-slate-600 leading-relaxed mx-auto text-center"
               style="font-size: clamp(16px, 2.5vw, 25px); max-width: 600px; text-shadow: 0 2px 8px rgba(0, 0, 0, 0.10);">
              {currentContent.hero.subtitle}
            </p>
          </div>
        </div>
        
        <!-- Right Side: cyber.webp image -->
        <div class="hidden md:block">
          <img 
            src="/images/cyber.webp"
            alt="Kyberturvallisuusstrategia konsepti"
            class="object-contain -mt-8"
            style="width: 100%; max-width: 600px; height: auto;"
            loading="eager"
          />
        </div>
        
      </div>
      
      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-8 justify-center mt-8 md:mt-14">
        
        <a href={isFi ? "/fi/contact" : "/contact"} 
           class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] text-white rounded-full hover:from-[#22D3EE] hover:to-[#0EA5E9] transition-all duration-300 hover:shadow-xl font-medium text-sm sm:text-base">
          {currentContent.hero.primaryCTA.text}
        </a>
        
        <a href={isFi ? "/fi/services" : "/services"} 
           class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border-2 border-[#0EA5E9] text-[#0EA5E9] rounded-full hover:bg-gradient-to-r hover:from-[#22D3EE] hover:to-[#0EA5E9] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
          {currentContent.hero.secondaryCTA.text}
        </a>
      </div>
      
    </div>
  </div>

  <style>
  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
  .animate-gradient {
    animation: gradient 4s ease infinite;
    background-size: 200% 200%;
  }
  </style>
</section>

<!-- Trust Bar - WHITE BACKGROUND with subtle border -->
<section class="py-8 bg-white border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid md:grid-cols-2 gap-8 items-center">
      
      <!-- Left Side: Text -->
      <div class="text-center md:text-left">
        <div class="flex items-center gap-3 mb-3 md:justify-start justify-center">
          <div class="h-px w-8 bg-gradient-to-r from-transparent to-[#0F172A]"></div>
          <span class="text-[#0F172A] text-xs font-medium tracking-wider uppercase">{isFi ? 'Luotetut kumppanit' : 'Trusted Partners'}</span>
          <div class="h-px w-8 bg-gradient-to-l from-transparent to-[#0F172A]"></div>
        </div>
        
        <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
          {isFi ? 'Yhteensopivuudesta' : 'From compliance'}<br/>{isFi ? 'kilpailueduksi' : 'to competitive advantage'}.
        </p>
        
        <div class="flex items-center gap-3 mt-3 md:justify-start justify-center">
          <div class="flex items-center gap-0.5">
            {[...Array(5)].map((_, i) => (
              <svg key={i} class="w-3.5 h-3.5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
              </svg>
            ))}
          </div>
          <span class="text-xs text-slate-500">4.9/5 (200+ {isFi ? 'arvostelua' : 'reviews'})</span>
        </div>
      </div>
      
      <!-- Right Side: Auto-scrolling Logos Carousel -->
      <div class="relative overflow-hidden">
        
        <div class="text-center mb-3">
          <span class="text-xs text-slate-400 uppercase tracking-wider">{isFi ? 'Toimialajohtajien luottama' : 'Trusted by industry leaders'}</span>
        </div>
        
        <div class="overflow-hidden">
          <div class="flex animate-scroll gap-6 md:gap-8 py-2">
            
            {[
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
              { src: '/images/nis2.webp', alt: 'NIS2' },
              { src: '/images/logo-client-1.webp', alt: 'Client 3' },
              { src: '/images/CRA.jpg', alt: 'CRA' },
              { src: '/images/SOC-2-logo.jpg', alt: 'SOC2' },
              { src: '/images/gdpr.webp', alt: 'GDPR' },
            ].map((logo, idx) => (
              <div key={idx} class="flex-shrink-0 flex items-center justify-center h-16 md:h-20 w-24 md:w-32 rounded-xl p-2 md:p-3 hover:scale-105 transition-all duration-300">
                <img
                  src={logo.src}
                  alt={logo.alt}
                  class="max-h-12 md:max-h-20 w-auto object-contain"
                  loading="lazy"
                />
              </div>
            ))}
            
          </div>
        </div>
        
      </div>
      
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  
  .animate-scroll {
    animation: scroll 20s linear infinite;
    width: fit-content;
  }
  
  .animate-scroll:hover {
    animation-play-state: paused;
  }
</style>

<!-- Featured Packages Section -->
<section class="text-slate-900 md:min-h-screen flex items-center relative overflow-hidden bg-cover bg-center bg-no-repeat" style="background-image: url('/images/bgf.jpg')">
  
  <div class="absolute top-0 left-0 right-0 h-32 bg-gradient-to-b from-white to-transparent"></div>
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white to-transparent"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-12">  
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#0EA5E9] mb-4">
        {isFi ? 'Esittelyssä Fast-Track Paketit' : 'Featured Fast-Track Packages'}
      </h2>
