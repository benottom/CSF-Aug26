          <a href={isFi ? "/fi/contact?assessment=true" : "/contact?assessment=true"} class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-gradient-to-r from-[#0EA5E9] to-[#0F172A] text-white hover:from-[#22D3EE] hover:to-[#0EA5E9] transition-all duration-300 hover:shadow-lg hover:shadow-blue-500/30 font-medium text-sm gap-2 group">
            {isFi ? 'Hanki ilmainen arviointi' : 'Get Free Assessment'}
            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

