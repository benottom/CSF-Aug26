---
import Layout from '@/layouts/Layout.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/icons/Icon.astro';
import ComplianceFrameworks from '@/components/sections/ComplianceFrameworks.astro';

// SEO Configuration
const seoConfig = {
  title: "Cyber Security Finland | EU:n kyberturvallisuuden vaatimustenmukaisuusosaaminen",
  description: "Cyber Security Finland auttaa Suomessa ja EU:ssa toimivia organisaatioita muuttamaan NIS2-, CRA-, ISO 27001-, DORA- ja GDPR-vaatimukset toteutetuiksi kontrolleiksi ja auditointivalmiiksi ohjelmiksi.",
  keywords: "kyberturvallisuus suomi, ISO 27001 yhteensopivuus, NIS2 direktiivi, GDPR asiantuntija, CRA vaatimustenmukaisuus, EUCC-sertifiointi, tietoturva konsultointi, kyberturvallisuus palvelut suomi, sääntely konsultointi, riskienhallinta palvelut",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Cyber Security Finland",
    "url": "https://cybersecurity.fi",
    "description": "Kyberturvallisuuden vaatimustenmukaisuusosaamista ja neuvontapalveluita eurooppalaista kyberturvallisuussääntelyä noudattaville organisaatioille, mukaan lukien NIS2, CRA, ISO 27001, DORA ja GDPR.",
    "publisher": {
      "@type": "Organization",
      "name": "Cyber Security Finland",
      "logo": {
        "@type": "ImageObject",
        "url": "https://cybersecurity.fi/csf-logo-2026.png",
        "width": 300,
        "height": 300
      }
    },
    "potentialAction": {
      "@type": "ContactAction",
      "target": "https://cybersecurity.fi/fi/contact",
      "name": "Ota yhteyttä"
    }
  }
};

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

const content = {
  en: {
    hero: {
      eyebrow: "NIS2 · CRA · EUCC",
      title: "EU Cybersecurity Compliance, Engineered for Audit",
      subtitle: "Cyber Security Finland helps European organizations translate NIS2, CRA, ISO 27001, DORA and related cybersecurity requirements into implemented controls, defensible evidence and practical compliance programs.",
      primaryCTA: { text: "Request a Compliance Assessment", href: "/contact" },
      secondaryCTA: { text: "Explore Compliance Services", href: "/services" }
    },
    services: {
      title: "Core Capabilities",
      description: "Comprehensive cybersecurity and regulatory compliance solutions for enterprises across regulated industries",
      items: [
        {
          title: "Information Security Management",
          description: "ISO 27001 implementation and certification readiness programs",
          icon: "shield-check",
          href: "/packages/iso-27001-fast-track"
        },
        {
          title: "Regulatory Compliance",
          description: "NIS2 directive compliance and cybersecurity resilience frameworks",
          icon: "globe-alt",
          href: "/services/nis2-compliance"
        },
        {
          title: "Data Protection & Privacy",
          description: "GDPR compliance programs and privacy governance frameworks",
          icon: "lock-closed",
          href: "/services/gdpr-privacy-services"
        },
        {
          title: "Cyber Resilience Act (CRA)",
          description: "CRA and EUCC compliance engineering for connected products and software placed on the EU market",
          icon: "cog",
          href: "/services/compliance-engineering"
        }
      ]
    },
    cta: {
      title: "Discuss Your Compliance Requirements",
      subtitle: "Speak directly with a cybersecurity and compliance specialist about NIS2, CRA, ISO 27001, DORA or GDPR requirements relevant to your organization.",
      primaryCTA: { text: "Request a Compliance Assessment", href: "/contact" },
      secondaryCTA: { text: "View Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      eyebrow: "NIS2 · CRA · EUCC",
      title: "EU:n kyberturvallisuusvaatimustenmukaisuutta, auditointia varten",
      subtitle: "Cyber Security Finland auttaa eurooppalaisia organisaatioita muuttamaan NIS2-, CRA-, ISO 27001-, DORA- ja muut kyberturvallisuusvaatimukset toteutetuiksi kontrolleiksi, todennettavaksi näytöksi ja käytännön vaatimustenmukaisuusohjelmiksi.",
      primaryCTA: { text: "Pyydä vaatimustenmukaisuusarviointi", href: "/fi/contact" },
      secondaryCTA: { text: "Tutustu palveluihin", href: "/fi/services" }
    },
    services: {
      title: "Ydinosaamisalueet",
      description: "Kattavat kyberturvallisuus- ja sääntelyvaatimustenmukaisuusratkaisut yrityksille säännellyillä toimialoilla",
      items: [
        {
          title: "Tietoturvallisuuden hallinta",
          description: "ISO 27001 -toteutus ja sertifiointivalmius-ohjelmat",
          icon: "shield-check",
          href: "/fi/packages/iso-27001-fast-track"
        },
        {
          title: "Sääntelyvaatimustenmukaisuus",
          description: "NIS2-direktiivin vaatimustenmukaisuus ja kyberturvallisuuden resilienssi",
          icon: "globe-alt",
          href: "/fi/services/nis2-compliance"
        },
        {
          title: "Tietosuoja ja yksityisyys",
          description: "GDPR-vaatimustenmukaisuusohjelmat ja tietosuojan hallintakehykset",
          icon: "lock-closed",
          href: "/fi/services/gdpr-privacy-services"
        },
        {
          title: "Kyberkestävyyssäädös (CRA)",
          description: "CRA- ja EUCC-vaatimustenmukaisuus EU:n markkinoille tuotaville yhdistetyille tuotteille ja ohjelmistoille",
          icon: "cog",
          href: "/fi/services/compliance-engineering"
        }
      ]
    },
    cta: {
      title: "Keskustele vaatimustenmukaisuustarpeistasi",
      subtitle: "Keskustele suoraan kyberturvallisuus- ja vaatimustenmukaisuusasiantuntijan kanssa organisaatiollesi merkityksellisistä NIS2-, CRA-, ISO 27001-, DORA- tai GDPR-vaatimuksista.",
      primaryCTA: { text: "Pyydä vaatimustenmukaisuusarviointi", href: "/fi/contact" },
      secondaryCTA: { text: "Näytä palvelut", href: "/fi/services" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';

const keyServices = [
  {
    title: isFi ? "Yhteensopivuuskehykset" : "Compliance Frameworks",
    description: isFi
      ? "Muunna sääntelyvaatimukset kilpailueduksi. Asiantunteva ISO 27001, SOC 2, GDPR, NIS2, CRA ja EUCC -kehyksien toteutus todistettujen nopean toteutuksen metodologioiden avulla."
      : "Transform regulatory requirements into competitive advantages. Expert implementation of ISO 27001, SOC 2, GDPR, NIS2, CRA, and EUCC frameworks with proven fast-track methodologies.",
    icon: "shield-check",
    href: isFi ? "/fi/services" : "/services"
  },
  {
    title: isFi ? "Riskienhallinta" : "Risk Management",
    description: isFi
      ? "Tunnista, arvioi ja lievitä kyberturvallisuusriskit tehokkaasti. Kattavat riskien arvioinnit, kolmannen osapuolen riskienhallinta ja liiketoiminnan jatkuvuuden suunnittelu organisaatiollesi räätälöitynä."
      : "Identify, assess, and mitigate cybersecurity risks effectively. Comprehensive risk assessments, third-party risk management, and business continuity planning tailored to your organization.",
    icon: "chart-line",
    href: isFi ? "/fi/services" : "/services"
  },
  {
    title: isFi ? "Hallinto & Strategia" : "Governance & Policy",
    description: isFi
      ? "Rakenna vahvoja kyberturvallisuuden hallintorakenteita. Strateginen politiikan kehitys, CISO-palveluna ja hallituksen tason riskiraportointi varmistaaksesi organisaation turvallisuuden kypsyyden."
      : "Establish robust cybersecurity governance structures. Strategic policy development, CISO-as-a-Service, Virtual CISO (V-CISO), and board-level risk reporting to ensure organizational security maturity.",
    icon: "building-library",
    href: isFi ? "/fi/services" : "/services"
  },
  {
    title: isFi ? "Erikoispalvelut" : "Specialized Services",
    description: isFi
      ? "Asiantuntijapalvelut ainutlaatuisiin kyberturvallisuuden haasteisiin. Petostorjuntapalvelut, digitaalisen luottamuksen ratkaisut, tarkastuksen valmistelu ja erikoisvaatimustenmukaisuustuki monimutkaisiin vaatimuksiin."
      : "Expert services for unique cybersecurity challenges. Anti-fraud services, digital trust solutions, audit preparation, and specialized compliance support for complex requirements.",
    icon: "star",
    href: isFi ? "/fi/services" : "/services"
  }
];

const industries = [
  { 
    name: isFi ? "Rahoituspalvelut & Fintech" : "Financial Services & Fintech", 
    icon: "bank", 
    href: isFi ? "/fi/industries/financial-services-fintech" : "/industries/financial-services-fintech",
    image: "/images/industries/financial.svg",
    description: isFi 
      ? "Erikoistunut DORA, PCI DSS ja toiminnan resilierenssin asiantuntemus pankeille, maksunkäsittelyyrityksille ja fintech-yrityksille."
      : "Specialized DORA, PCI DSS, and operational resilience expertise for banks, payment processors, and fintech companies."
  },
  { 
    name: isFi ? "SaaS & Teknologia" : "SaaS & Technology", 
    icon: "code", 
    href: isFi ? "/fi/industries/saas-technology" : "/industries/saas-technology",
    image: "/images/industries/saas.svg",
    description: isFi
      ? "ISO 27001, SOC 2 ja pilvitietoturvan kehykset räätälöitynä ohjelmisto- ja teknologiayrityksille."
      : "ISO 27001, SOC 2, and cloud security frameworks tailored for software companies and technology service providers."
  },
  { 
    name: isFi ? "Terveys & Elintarviketeollisuus" : "Healthcare & Life Sciences", 
    icon: "heart", 
    href: isFi ? "/fi/industries/healthcare-life-sciences" : "/industries/healthcare-life-sciences",
    image: "/images/industries/healthcare.svg",
    description: isFi
      ? "GDPR, Virtuaalinen DPO (V-DPO), lääketieteellisten laitteiden sääntely ja potilastietojen suojaus yhteensopivuus terveydenhuollon organisaatioille ja elintarviketeollisuuden yrityksille."
      : "GDPR, Virtual DPO (V-DPO), medical device regulations, and patient data protection compliance for healthcare organizations and life sciences companies."
  },
  { 
    name: isFi ? "Kriittinen infrastruktuuri" : "Critical Infrastructure", 
    icon: "bolt", 
    href: isFi ? "/fi/industries/critical-infrastructure-energy" : "/industries/critical-infrastructure-energy",
    image: "/images/industries/critical.svg",
    description: isFi
      ? "NIS2-direktiivin toteutus, operaatioteknologian turvallisuus ja resilierenssin suunnittelu oleellisille palveluntarjoajille."
      : "NIS2 directive implementation, operational technology security, and resilience planning for essential service providers."
  },
  { 
    name: isFi ? "Julkinen sektori" : "Public Sector", 
    icon: "building", 
    href: isFi ? "/fi/industries/public-sector-finland" : "/industries/public-sector-finland",
    image: "/images/industries/public.svg",
    description: isFi
      ? "Hallituksen erityiset sääntelykehykset, julkiset hankinnat ja kansalaisten tietosuojan standardit."
      : "Government-specific compliance frameworks, public procurement requirements, and citizen data protection standards."
  },
  { 
    name: isFi ? "Valmistava teollisuus" : "Manufacturing & Industrial", 
    icon: "cog", 
    href: isFi ? "/fi/industries/manufacturing-industrial" : "/industries/manufacturing-industrial",
    image: "/images/industries/manufacturing.svg",
    description: isFi
      ? "Teollisuuden IoT-tietoturva, toimittajaketjun suojaus ja operaatioiden jatkuvuus valmistaville ja teollisille organisaatioille."
      : "Industrial IoT security, supply chain protection, and operational continuity for manufacturing and industrial organizations."
  }
];

const latestResources = [
  {
    title: isFi ? "ISO 27001 Pika-aloitusopas" : "ISO 27001 Quick Start Guide",
    excerpt: isFi ? "25-sivuinen toteutusroadmap" : "25-page implementation roadmap",
    href: isFi ? "/fi/resources/guides/iso-27001-quick-start" : "/resources/guides/iso-27001-quick-start",
    category: isFi ? "Opas" : "Guide"
  },
  {
    title: isFi ? "NIS2 Yhteensopivuus Tarkistuslista" : "NIS2 Compliance Checklist",
    excerpt: isFi ? "Täysi vaatimusanalyysityökalu" : "Complete requirement assessment tool",
    href: isFi ? "/fi/resources/guides/nis2-compliance-checklist" : "/resources/guides/nis2-compliance-checklist",
    category: isFi ? "Tarkistuslista" : "Checklist"
  },
  {
    title: isFi ? "GDPR Tietosuoja-vaikutusten Arviointi Malli" : "GDPR Privacy Impact Assessment Template",
    excerpt: isFi ? "Valmiiksi määritelty PIA-kehys" : "Ready-to-use PIA framework",
    href: isFi ? "/fi/resources/guides/gdpr-pia-template" : "/resources/guides/gdpr-pia-template",
    category: isFi ? "Malli" : "Template"
  }
];
---

<Layout {...seoConfig}>

<!-- Hero Section - technical-paper, flat -->
<section class="text-[#14171a] bg-[#f4f1ea] relative overflow-hidden border-b" style="border-color: #e2dac5; background-image: linear-gradient(#e2dac5 1px, transparent 1px), linear-gradient(90deg, #e2dac5 1px, transparent 1px); background-size: 42px 42px;">

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16 md:py-24">

    <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Content -->
      <div class="text-center md:text-left">
        <div class="kicker justify-center md:justify-start mx-auto md:mx-0">
          {currentContent.hero.eyebrow}
        </div>

        <h1 class="font-bold tracking-tight leading-[1.1] mt-5"
            style="font-size: clamp(28px, 5vw, 48px);">
          {currentContent.hero.title}
        </h1>

        <p class="text-[#48443b] leading-relaxed mt-6 mx-auto md:mx-0"
           style="font-size: clamp(16px, 2.2vw, 20px); max-width: 560px;">
          {currentContent.hero.subtitle}
        </p>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start mt-9">
          <a href={isFi ? "/fi/contact" : "/contact"}
             class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 bg-[#14171a] text-[#f4f1ea] border border-[#14171a] rounded-[2px] hover:bg-[#003580] hover:border-[#003580] transition-colors duration-200 font-medium text-sm sm:text-base">
            {currentContent.hero.primaryCTA.text}
          </a>

          <a href={isFi ? "/fi/services" : "/services"}
             class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 sm:px-7 sm:py-3.5 border border-[#14171a] text-[#14171a] rounded-[2px] hover:border-[#003580] hover:text-[#003580] transition-colors duration-200 font-medium text-sm sm:text-base">
            {currentContent.hero.secondaryCTA.text}
          </a>
        </div>
      </div>

      <!-- Right: flat line-art compliance diagram, technical-paper style -->
      <div class="frame p-4 sm:p-6 bg-[#f4f1ea]/60">
        <img
          src="/images/hero-compliance-diagram.svg"
          alt="Kaavio hallinnon, riskien, varmuuden, sääntelyn, häiriönhallinnan ja auditoinnin osa-alueista keskeisen turvallisuusytimen ympärillä"
          class="object-contain w-full h-auto"
          style="max-width: 600px;"
          loading="eager"
        />
      </div>

    </div>
  </div>
</section>

<!-- Trust Bar - WHITE BACKGROUND with subtle border -->
<section class="py-8 bg-white border-y border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      <div class="flex items-center gap-3 mb-3 justify-center">
        <div class="h-px w-8 bg-transparent"></div>
        <span class="text-[#131c2e] text-xs font-medium tracking-wider uppercase">{isFi ? 'Miksi meidän kanssamme työskennellään' : 'Why Organizations Work With Us'}</span>
        <div class="h-px w-8 bg-transparent"></div>
      </div>

      <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight leading-tight text-slate-800">
        {isFi ? 'Yhteensopivuudesta' : 'From compliance'}<br/>{isFi ? 'kilpailueduksi' : 'to competitive advantage'}.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-10">
      {[
        {
          icon: "globe",
          title: isFi ? 'Suomalainen ja EU-sääntelyosaaminen' : 'Finnish & EU Regulatory Expertise',
          desc: isFi ? 'NIS2, DORA, GDPR, ISO 27001' : 'NIS2, DORA, GDPR, ISO 27001'
        },
        {
          icon: "cog",
          title: isFi ? 'Jäsennelty vaatimustenmukaisuuden toteutus' : 'Structured Compliance Engineering',
          desc: isFi ? 'Määritelty, toistettava menetelmä' : 'A defined, repeatable methodology'
        },
        {
          icon: "documentChartBar",
          title: isFi ? 'Auditointivalmis, hallitustason raportointi' : 'Audit-Ready, Board-Level Reporting',
          desc: isFi ? 'Rakennettu johdon ja valvojien tarpeisiin' : 'Built for executive and regulator scrutiny'
        },
        {
          icon: "userGroup",
          title: isFi ? 'Nimetty senioritason asiantuntijatiimi' : 'Dedicated Senior Advisory Team',
          desc: isFi ? 'Kokeneita asiantuntijoita, ei yleisosaajia' : 'Experienced practitioners, not generalists'
        },
      ].map((item) => (
        <div class="text-center">
          <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-[#f4f1ea] border-2 border-[#003580] flex items-center justify-center">
            <Icon name={item.icon} class="w-6 h-6 text-[#003580]" />
          </div>
          <h3 class="text-sm font-bold text-[#14171a] mb-1">{item.title}</h3>
          <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Featured Packages Section -->
<section class="text-slate-900 md:min-h-screen flex items-center relative overflow-hidden bg-[#f4f1ea]" style="background-image: linear-gradient(#e2dac5 1px, transparent 1px), linear-gradient(90deg, #e2dac5 1px, transparent 1px); background-size: 42px 42px;">
  
  <div class="absolute top-0 left-0 right-0 h-32 bg-white"></div>
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-white"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-8 md:py-12">  
    
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#003580] mb-4">
        {isFi ? 'Esittelyssä Fast-Track Paketit' : 'Featured Fast-Track Packages'}
      </h2>
      <p class="text-base md:text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
        {isFi ? 'Nopeat ratkaisut säännellyille organisaatioille' : 'Fast-track solutions designed for regulated organizations'}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- ISO 27001 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#003580] bg-white rounded-[2px] border-2 border-[#003580] group-hover:text-white group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
            {isFi ? 'Valmiina sertifiointiin 90–120 päivässä' : 'Become certification-ready in 90–120 days'}
          </div>
        </div>

        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 text-center">
          {isFi ? 'ISO 27001 Fast-Track' : 'ISO 27001 Fast-Track'}
        </h3>
        
        <p class="text-base font-semibold text-[#131c2e] mb-6 leading-relaxed text-center">
          {isFi ? 'Rakenna ja toteuta täydellinen ISMS asiantuntijaohjauksella.' : 'Build and implement a complete ISMS with expert guidance.'}
        </p>        
        
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? 'Täydellinen ISMS-toteutus räätälöitynä toimintoihisi' : 'Complete ISMS implementation tailored to your operations'}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? 'Politiikkakirjasto 50+ valmiilla asiakirjalla' : 'Policy library with 50+ ready-to-use documents'}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? 'Riskien arviointi ja aukkoanalyysi' : 'Risk assessment & gap analysis'}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? 'Auditointivalmistelu ja sertifiointituki' : 'Audit preparation and certification support'}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? 'Henkilöstön koulutus ja tietoturvatietoisuus' : 'Staff training and security awareness'}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? '12 kuukauden sertifioinnin jälkeinen tuki' : '12 months of post-certification support'}</span>
          </li>
        </ul>
        
        <a href={isFi ? "/fi/packages/iso-27001-fast-track" : "/packages/iso-27001-fast-track"} class="mt-auto inline-flex items-center justify-center px-5 py-2.5 rounded-[2px] border-2 border-[#003580] text-[#003580] bg-white hover:bg-[#2E6FBA] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm w-fit self-center">
          {isFi ? 'Aloita ohjelma' : 'Start program'}
        </a>
      </div>

      <!-- NIS2 Card -->
      <div class="bg-white rounded-xl border border-slate-100 shadow-sm
                  hover:shadow-xl hover:-translate-y-1 hover:shadow-md hover:border-2
                  transition-all duration-300
                  flex flex-col p-6 group">
        
        <div class="flex justify-center mb-4">
          <div class="inline-block px-3 py-1 text-xs font-medium text-[#003580] bg-white rounded-[2px] border-2 border-[#003580] group-hover:text-white group-hover:bg-[#003580] group-hover:border-transparent transition-all duration-300">
            {isFi ? 'NIS2-aukkoanalyysi ja toteutustuki' : 'NIS2 gap assessment & implementation support'}
          </div>
        </div>

        <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-[#2E6FBA] transition-colors duration-300 text-center">
          {isFi ? 'NIS2-vaatimustenmukaisuusohjelma' : 'NIS2 Compliance Program'}
        </h3>
        
        <p class="text-base font-semibold text-[#131c2e] mb-6 leading-relaxed text-center">
          {isFi ? 'Valmistaudu NIS2-vaatimuksiin asiantuntijatuella.' : 'Prepare for NIS2 requirements with expert support.'}
        </p>        
        
        <ul class="text-sm text-slate-600 space-y-2.5 mb-6 text-left">
          <li class="flex items-start gap-2.5">
            <span class="text-[#003580] font-bold mt-0.5">✓</span> 
            <span>{isFi ? 'NIS2 aukkoanalyysi ja tiekartta' : 'NIS2 gap analysis & roadmap'}</span>
