---
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

// SEO Configuration
const seoConfig = {
  title: lang === 'fi'
    ? "Tietoa meistä | Kyberturvallisuuden asiantuntijat Suomessa"
    : "About Us | Cybersecurity Experts in Finland",
  description: lang === 'fi'
    ? "Cyber Security Finland on kyberturvallisuuden ja vaatimustenmukaisuuden asiantuntijayritys. Kokemusta ISO 27001, NIS2 ja GDPR -toteutuksista."
    : "Cyber Security Finland is a cybersecurity and compliance consulting firm. Experienced in ISO 27001, NIS2, and GDPR implementations across industries.",
  keywords: lang === 'fi'
    ? "kyberturvallisuusyritys suomi, ISO 27001 konsultit, vaatimustenmukaisuus asiantuntijat, tietoturva konsultointi suomi"
    : "cybersecurity company finland, ISO 27001 consultants, compliance experts, information security consulting finland",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Cyber Security Finland",
    "legalName": "Cyber Security Finland Oy",
    "taxID": "3195889-5",
    "description": "Cybersecurity and compliance consulting firm based in Finland",
    "url": "https://cybersecurity.fi",
    "logo": "https://cybersecurity.fi/csf-logo-2026.png",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Mikonkatu 9",
      "postalCode": "00100",
      "addressLocality": "Helsinki",
      "addressCountry": "FI"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+358 44 5040308",
      "contactType": "customer service",
      "areaServed": ["FI", "EU"],
      "availableLanguage": ["English", "Finnish"]
    },
    "sameAs": [
      "https://www.linkedin.com/company/cyber-security-finland"
    ]
  }
};

const content = {
  en: {
    hero: {
      title: "About Cybersecurity.fi",
      subtitle: "A Finland-based cybersecurity and compliance consultancy.",
      description: "We help organizations operating in Finland and the EU work through cybersecurity regulations while building resilient security programs.",
      primaryCTA: { text: "Meet Our Team", href: "#team" },
      secondaryCTA: { text: "Our Story", href: "#story" }
    },
    story: {
      title: "Our Story",
      paragraphs: [
        "Cybersecurity.fi was founded with a vision to make cybersecurity compliance simple and accessible for Finnish businesses. Our team of experienced professionals combines deep technical expertise with practical business understanding to deliver solutions that protect organizations while enabling growth.",
        "Based in Finland with expertise across EU regulations, we specialize in structured implementation programs for NIS2, CRA, ISO 27001, DORA, EUCC and related requirements.",
        "Our approach focuses on building genuine security capabilities rather than just checking compliance boxes. We work as true partners, providing ongoing support and guidance to ensure long-term success.",
        "We help organizations translate EU cybersecurity regulation into implemented controls, technical evidence, and audit-ready compliance programs."
      ]
    },
    team: {
      title: "How We Deliver Engagements",
      subtitle: "Every engagement is structured around these functions.",
      members: [
        {
          role: "Engagement Lead",
          description: "Owns the overall program, coordinates scope and timeline, and is the primary point of contact between your organization and our team throughout the engagement."
        },
        {
          role: "Compliance Specialist",
          description: "Works through the applicable regulatory or standards requirements (NIS2, CRA, ISO 27001, DORA, GDPR) with your team, translating them into a concrete gap assessment and control set."
        },
        {
          role: "Technical Security Specialist",
          description: "Supports the technical implementation and validation side of an engagement — architecture, control implementation, and evidence gathering for audit or certification readiness."
        }
      ]
    },
    values: {
      title: "Our Values",
      subtitle: "The principles that guide our work and define our commitment.",
      items: [
        { title: "Excellence", description: "We strive for excellence in every engagement, delivering high-quality solutions that exceed expectations.", icon: "star" },
        { title: "Integrity", description: "We operate with the highest ethical standards and maintain complete transparency in all our interactions.", icon: "shield" },
        { title: "Innovation", description: "We continuously innovate our approaches to stay ahead of evolving cybersecurity challenges.", icon: "lightbulb" },
        { title: "Partnership", description: "We build long-term partnerships with our clients, supporting their cybersecurity journey every step of the way.", icon: "users" }
      ]
    },
    whyChoose: {
      title: "Why Choose Us",
      items: [
        { title: "Structured Methodology", description: "A defined, repeatable implementation methodology across the frameworks we support.", icon: "rocket" },
        { title: "Expert Team", description: "Certified professionals with deep expertise in cybersecurity and compliance.", icon: "users" },
        { title: "Practical Approach", description: "Implementation-focused solutions that work in real-world business environments.", icon: "check-circle" }
      ]
    },
    cta: {
      title: "Ready to Work with Us?",
      subtitle: "Tell us about your compliance requirements and we'll recommend a practical next step.",
      primaryCTA: { text: "Request a Compliance Assessment", href: "/contact?consultation=true" },
      secondaryCTA: { text: "View Our Services", href: "/services" }
    }
  },
  fi: {
    hero: {
      title: "Tietoa Cybersecurity.fi:stä",
      subtitle: "Suomalainen kyberturvallisuuden ja vaatimustenmukaisuuden konsulttiyritys.",
      description: "Autamme Suomessa ja EU:ssa toimivia organisaatioita työskentelemään kyberturvallisuussäännösten kanssa samalla kun rakennamme kestäviä turvallisuusohjelmia.",
      primaryCTA: { text: "Tapaa tiimimme", href: "#team" },
      secondaryCTA: { text: "Tarinaamme", href: "#story" }
    },
    story: {
      title: "Tarinaamme",
      paragraphs: [
        "Cybersecurity.fi perustettiin visiona tehdä kyberturvallisuuden vaatimustenmukaisuudesta yksinkertaista ja helposti saavutettavaa suomalaisille yrityksille. Asiantuntijatiimimme yhdistää syvällisen teknisen osaamisen käytännön liiketoiminnan ymmärrykseen tarjotakseen ratkaisuja, jotka suojaavat organisaatioita samalla kun mahdollistavat kasvun.",
        "Suomessa toimivana ja EU:n säädöksiin erikoistuneena yrityksenä tarjoamme jäsenneltyjä toteutusohjelmia NIS2:lle, CRA:lle, ISO 27001:lle, DORA:lle, EUCC:lle ja muille vaatimuksille.",
        "Lähestymistapamme keskittyy todellisten turvallisuuskyvykkyyksien rakentamiseen pelkän vaatimusten täyttämisen sijaan. Toimimme aitona kumppanina tarjoten jatkuvaa tukea ja ohjausta pitkäaikaisen menestyksen varmistamiseksi.",
        "Autamme organisaatioita muuttamaan EU:n kyberturvallisuussääntelyn toteutetuiksi kontrolleiksi, tekniseksi näytöksi ja auditointivalmiiksi vaatimustenmukaisuusohjelmiksi."
      ]
    },
    team: {
      title: "Näin Toteutamme Toimeksiantoja",
      subtitle: "Jokainen toimeksianto rakentuu näiden roolien ympärille.",
      members: [
        {
          role: "Vastuullinen projektipäällikkö",
          description: "Vastaa koko ohjelmasta, koordinoi laajuuden ja aikataulun, ja on ensisijainen yhteyshenkilö organisaatiosi ja tiimimme välillä koko toimeksiannon ajan."
        },
        {
          role: "Vaatimustenmukaisuusasiantuntija",
          description: "Käy läpi sovellettavat sääntely- tai standardivaatimukset (NIS2, CRA, ISO 27001, DORA, GDPR) yhdessä tiimisi kanssa, muuttaen ne konkreettiseksi aukkoanalyysiksi ja kontrollikokonaisuudeksi."
        },
        {
          role: "Tekninen turvallisuusasiantuntija",
          description: "Tukee toimeksiannon teknistä toteutusta ja validointia – arkkitehtuuria, kontrollien toteutusta ja näytön keräämistä auditointi- tai sertifiointivalmiutta varten."
        }
      ]
    },
    values: {
      title: "Arvomme",
      subtitle: "Periaatteet, jotka ohjaavat työtämme ja määrittelevät sitoutumisemme.",
      items: [
        { title: "Huippuosaaminen", description: "Pyrimme huippuosaamiseen jokaisessa toimeksiannossa tarjoten korkealaatuisia ratkaisuja, jotka ylittävät odotukset.", icon: "star" },
        { title: "Rehellisyys", description: "Toimimme korkeimpien eettisten standardien mukaisesti ja ylläpidämme täydellistä läpinäkyvyyttä kaikessa vuorovaikutuksessamme.", icon: "shield" },
        { title: "Innovaatio", description: "Kehitämme jatkuvasti lähestymistapojamme pysyäksemme kehittyvien kyberturvallisuushaasteiden edellä.", icon: "lightbulb" },
        { title: "Kumppanuus", description: "Rakennamme pitkäaikaisia kumppanuuksia asiakkaidemme kanssa tukien heidän kyberturvallisuusmatkaansa joka vaiheessa.", icon: "users" }
      ]
    },
    whyChoose: {
      title: "Miksi valita meidät",
      items: [
        { title: "Jäsennelty menetelmä", description: "Määritelty, toistettava toteutusmenetelmä kaikille tukemillemme kehyksille.", icon: "rocket" },
        { title: "Asiantuntijatiimi", description: "Sertifioidut ammattilaiset, joilla on syvällistä osaamista kyberturvallisuudesta ja vaatimustenmukaisuudesta.", icon: "users" },
        { title: "Käytännönläheinen lähestymistapa", description: "Toteutuskeskeiset ratkaisut, jotka toimivat todellisissa liiketoimintaympäristöissä.", icon: "check-circle" }
      ]
    },
    cta: {
      title: "Valmis työskentelemään kanssamme?",
      subtitle: "Kerro meille vaatimustenmukaisuustarpeistasi, niin suosittelemme käytännön seuraavaa askelta.",
      primaryCTA: { text: "Pyydä vaatimustenmukaisuusarviointi", href: "/contact?consultation=true" },
      secondaryCTA: { text: "Tutustu palveluihimme", href: "/services" }
    }
  }
};

const currentContent = content[lang];
const isFi = lang === 'fi';
---

<Layout {...seoConfig}>

  <!-- Hero Section -->
  <section class="bg-blue-50 text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#131c2e]">{currentContent.hero.title}</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
          {currentContent.hero.subtitle}
        </p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.hero.description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href={currentContent.hero.primaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base">
            {currentContent.hero.primaryCTA.text}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={currentContent.hero.secondaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
            {currentContent.hero.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      
    </div>
  </section>

  <!-- Our Story Section -->
  <section id="story" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
            {currentContent.story.title}
          </h2>
        </div>
        
        <div class="space-y-6">
          {currentContent.story.paragraphs.map((paragraph, index) => (
            <p class="text-base md:text-lg text-slate-500 leading-relaxed">
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- How We Deliver Engagements Section -->
  <section id="team" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.team.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.team.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {currentContent.team.members.map((member, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-[#131c2e] transition-all duration-300">
                <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#131c2e] transition-colors duration-300">{member.role}</h3>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">{member.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Values Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.values.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {currentContent.values.subtitle}
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {currentContent.values.items.map((value, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex justify-center mb-4">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-[#131c2e] transition-all duration-300">
                <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {value.icon === 'star' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  )}
                  {value.icon === 'shield' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  )}
                  {value.icon === 'lightbulb' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  )}
                  {value.icon === 'users' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  )}
                </svg>
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#131c2e] transition-colors duration-300">{value.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#131c2e] mb-4">
          {currentContent.whyChoose.title}
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {currentContent.whyChoose.items.map((item, index) => (
          <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex justify-center mb-4">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-[#131c2e] transition-all duration-300">
                <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {item.icon === 'rocket' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  )}
                  {item.icon === 'users' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  )}
                  {item.icon === 'check-circle' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  )}
                </svg>
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#131c2e] transition-colors duration-300">{item.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#131c2e]">
          {currentContent.cta.title}
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          {currentContent.cta.subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={isFi ? "/fi/contact?consultation=true" : "/contact?consultation=true"} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] bg-[#131c2e] text-white hover:bg-[#003580] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            {currentContent.cta.primaryCTA.text}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={isFi ? "/fi/services" : "/services"} class="inline-flex items-center justify-center px-6 py-3 rounded-[2px] border-2 border-[#14171a] text-[#14171a] hover:bg-[#131c2e] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            {currentContent.cta.secondaryCTA.text}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>