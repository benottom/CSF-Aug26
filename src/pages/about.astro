---
import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import CTA from '@/components/sections/CTA.astro';
import Icon from '@/components/ui/icons/Icon.astro';

const currentPath = Astro.url.pathname;
const lang = currentPath.startsWith('/fi') ? 'fi' : 'en';

// SEO Configuration
const seoConfig = {
  title: lang === 'fi'
    ? "Tietoa meistä | Kyberturvallisuuden asiantuntijat Suomessa"
    : "About Us | Cybersecurity Experts in Finland",
  description: lang === 'fi'
    ? "Cyber Security Finland on johtava kyberturvallisuuden ja vaatimustenmukaisuuden asiantuntijayritys. Kokemusta ISO 27001, NIS2 ja GDPR -toteutuksista."
    : "Cyber Security Finland is a leading cybersecurity and compliance consulting firm. Experienced in ISO 27001, NIS2, and GDPR implementations across industries.",
  keywords: lang === 'fi'
    ? "kyberturvallisuusyritys suomi, ISO 27001 konsultit, vaatimustenmukaisuus asiantuntijat, tietoturva konsultointi suomi"
    : "cybersecurity company finland, ISO 27001 consultants, compliance experts, information security consulting finland",
  type: "website" as const,
  schema: {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Cyber Security Finland",
    "description": "Leading cybersecurity and compliance consulting firm in Finland",
    "url": "https://cybersecurity.fi",
    "logo": "https://cybersecurity.fi/logo-2025.jpg",
    "foundingDate": "2020",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "FI",
      "addressRegion": "Finland"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+358 44 5040308",
      "contactType": "customer service",
      "areaServed": "Finland",
      "availableLanguage": ["English", "Finnish"]
    },
    "sameAs": [
      "https://www.linkedin.com/company/cyber-security-finland"
    ]
  }
};

const heroContent = {
  title: "About Cybersecurity.fi",
  subtitle: "Finland's premier cybersecurity and compliance consultancy.",
  description: "We help Finnish organizations and international companies operating in the EU navigate complex cybersecurity regulations while building robust, resilient security programs.",
  primaryCTA: { text: "Meet Our Team", href: "#team" },
  secondaryCTA: { text: "Our Story", href: "#story" }
};

const teamMembers = [
  {
    role: "Chief Executive Officer & Founder",
    description: "Our Chief Executive Officer brings over 15 years of cybersecurity expertise with deep knowledge in compliance frameworks and risk management. Having served as CISO at major financial institutions, they lead our organization with strategic vision in ISO 27001 implementation, enterprise risk management, and cybersecurity strategy development."
  },
  {
    role: "Chief Technology Officer",
    description: "Our Chief Technology Officer is a former CISO with exceptional technical expertise in security architecture and threat assessment. They specialize in cloud security, incident response, and penetration testing methodologies."
  },
  {
    role: "Compliance Director",
    description: "Our Compliance Director is a legal and compliance expert specializing in EU cybersecurity regulations. Having served as legal counsel at European cybersecurity agencies, they bring invaluable expertise in NIS2, GDPR, and DORA compliance frameworks."
  },
  {
    role: "Senior Security Consultant",
    description: "Our Senior Security Consultant is a former Big 4 auditor with extensive experience in security assessments and compliance audits across multiple industries. They specialize in SOC 2 preparations and audit readiness."
  },
  {
    role: "Head of Risk Management",
    description: "Our Head of Risk Management specializes in enterprise risk management and business continuity planning. As an expert in ISO 31000 and ISO 22301 frameworks, they provide comprehensive risk assessment and business continuity solutions."
  },
  {
    role: "Technical Security Lead",
    description: "Our Technical Security Lead is a cloud security specialist with multi-cloud platform expertise. Having served as a senior security engineer at major technology companies, they bring deep knowledge in DevSecOps and cloud security architectures."
  }
];

const values = [
  {
    title: "Excellence",
    description: "We strive for excellence in every engagement, delivering high-quality solutions that exceed expectations.",
    icon: "star"
  },
  {
    title: "Integrity",
    description: "We operate with the highest ethical standards and maintain complete transparency in all our interactions.",
    icon: "shield"
  },
  {
    title: "Innovation",
    description: "We continuously innovate our approaches to stay ahead of evolving cybersecurity challenges.",
    icon: "lightbulb"
  },
  {
    title: "Partnership",
    description: "We build long-term partnerships with our clients, supporting their cybersecurity journey every step of the way.",
    icon: "users"
  }
];

const certifications = [
  { 
    name: "ISO 27001 Certified Organization", 
    logo: "iso27001",
    description: "Information Security Management" 
  },
  { 
    name: "SOC 2 Type II Compliant", 
    logo: "soc2",
    description: "Service Organization Controls" 
  },
  { 
    name: "GDPR Compliant", 
    logo: "gdpr",
    description: "General Data Protection Regulation" 
  },
  { 
    name: "Cyber Essentials Plus", 
    logo: "cyber-essentials",
    description: "UK Cyber Security Standard" 
  }
];
---

<Layout {...seoConfig}>

  <!-- Hero Section - Centered -->
  <section class="bg-gradient-to-br from-blue-50 to-white text-slate-900 overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-12 md:py-16">
      
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-5xl xl:text-6xl font-bold tracking-tight mb-4">
          <span class="text-[#1E2A7A]">{heroContent.title}</span>
        </h1>
        <p class="text-xl md:text-2xl text-slate-600 mb-3 font-semibold">
          {heroContent.subtitle}
        </p>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          {heroContent.description}
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
          <a href={heroContent.primaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base">
            {heroContent.primaryCTA.text}
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href={heroContent.secondaryCTA.href} class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base">
            {heroContent.secondaryCTA.text}
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      
    </div>
  </section>

  <!-- Our Story Section -->
  <section id="story" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
            Our Story
          </h2>
        </div>
        
        <div class="space-y-6">
          <p class="text-base md:text-lg text-slate-500 leading-relaxed">
            Cybersecurity.fi was founded with a vision to make cybersecurity compliance simple and accessible for Finnish businesses. 
            Our team of experienced professionals combines deep technical expertise with practical business understanding to deliver 
            solutions that protect organizations while enabling growth.
          </p>
          
          <p class="text-base md:text-lg text-slate-500 leading-relaxed">
            Based in Finland with expertise across EU regulations, we specialize in fast-track implementation programs that achieve 
            compliance in 90-120 days rather than traditional 12-18 month approaches. We've helped 200+ organizations achieve their 
            cybersecurity goals with a 95% first-time certification success rate.
          </p>
          
          <p class="text-base md:text-lg text-slate-500 leading-relaxed">
            Our approach focuses on building genuine security capabilities rather than just checking compliance boxes. We work as 
            true partners, providing ongoing support and guidance to ensure long-term success.
          </p>
          
          <p class="text-base md:text-lg text-slate-500 leading-relaxed">
            Today, we continue to lead the market in cybersecurity innovation, helping organizations transform regulatory requirements 
            into competitive advantages while building resilient security programs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Leadership Team Section -->
  <section id="team" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Our Leadership Team
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          Meet the experienced professionals leading our cybersecurity practice.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {teamMembers.map((member, index) => (
          <div key={index} class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex items-center gap-4 mb-4">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
                <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-slate-900 group-hover:text-[#1E2A7A] transition-colors duration-300">{member.role}</h3>
            </div>
            <p class="text-sm text-slate-500 leading-relaxed">{member.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Values Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Our Values
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          The principles that guide our work and define our commitment.
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {values.map((value, index) => (
          <div key={index} class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="flex justify-center mb-4">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
                <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  {value.icon === 'star' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                  )}
                  {value.icon === 'shield' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  )}
                  {value.icon === 'lightbulb' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                  )}
                  {value.icon === 'users' && (
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  )}
                </svg>
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">{value.title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Certifications Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Our Certifications
        </h2>
        <p class="text-base md:text-lg text-slate-500 max-w-3xl mx-auto leading-relaxed">
          We maintain the highest industry standards and certifications.
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {certifications.map((cert, index) => (
          <div key={index} class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
            <div class="w-20 h-20 mx-auto mb-4 flex items-center justify-center">
              <svg class="w-16 h-16" viewBox="0 0 100 100" fill="none">
                <rect width="100" height="100" rx="8" fill={cert.logo === 'iso27001' ? '#003366' : cert.logo === 'soc2' ? '#2563eb' : cert.logo === 'gdpr' ? '#0066cc' : '#dc2626'}/>
                <text x="50" y="45" text-anchor="middle" fill="white" font-size="12" font-weight="bold">
                  {cert.logo === 'iso27001' ? 'ISO' : cert.logo === 'soc2' ? 'SOC' : cert.logo === 'gdpr' ? 'GDPR' : 'CE'}
                </text>
                {cert.logo === 'iso27001' && <text x="50" y="60" text-anchor="middle" fill="white" font-size="8">27001</text>}
                {cert.logo === 'soc2' && <text x="50" y="60" text-anchor="middle" fill="white" font-size="8">2</text>}
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-slate-900 mb-2">{cert.name}</h3>
            <p class="text-xs text-slate-500">{cert.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#1E2A7A] mb-4">
          Why Choose Us
        </h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Proven Track Record</h3>
          <p class="text-sm text-slate-500">200+ successful implementations across multiple industries and frameworks.</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Expert Team</h3>
          <p class="text-sm text-slate-500">Certified professionals with deep expertise in cybersecurity and compliance.</p>
        </div>
        
        <div class="bg-slate-50/50 rounded-xl border border-slate-100 p-6 text-center hover:border-blue-300 hover:bg-slate-50 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 group">
          <div class="flex justify-center mb-4">
            <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-gradient-to-r group-hover:from-[#1E2A7A] group-hover:to-[#3B82F6] transition-all duration-300">
              <svg class="w-8 h-8 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-[#1E2A7A] transition-colors duration-300">Practical Approach</h3>
          <p class="text-sm text-slate-500">Implementation-focused solutions that work in real-world business environments.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-slate-50/50 rounded-2xl border border-slate-100 p-12 text-center shadow-sm hover:shadow-md hover:border-blue-300 transition-all duration-300">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 text-[#1E2A7A]">
          Ready to Work with Us?
        </h2>
        <p class="text-base md:text-lg text-slate-500 mb-8 max-w-2xl mx-auto leading-relaxed">
          Join over 200 organizations that trust us with their cybersecurity and compliance needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact?consultation=true" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gradient-to-r from-[#1E2A7A] to-[#3B82F6] text-white hover:from-[#3B82F6] hover:to-[#1E2A7A] transition-all duration-300 hover:shadow-lg font-medium text-sm sm:text-base gap-2">
            Schedule Consultation
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/services" class="inline-flex items-center justify-center px-6 py-3 rounded-full border-2 border-[#1E40AF] text-[#1E40AF] hover:bg-gradient-to-r hover:from-[#1E2A7A] hover:to-[#3B82F6] hover:text-white hover:border-transparent transition-all duration-300 font-medium text-sm sm:text-base gap-2">
            View Our Services
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>