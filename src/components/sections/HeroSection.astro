---
interface Props {
  content: {
    title: string;
    subtitle?: string;
    description?: string;
    primaryCTA?: { text: string; href: string };
  };
}

const { content } = Astro.props as Props;
---

<section class="relative bg-slate-50 min-h-[50vh] flex items-center">
  <div class="relative z-10 max-w-5xl mx-auto px-6 py-16 text-center">
    <h1 class="text-3xl md:text-5xl font-bold mb-4">{content?.title ?? 'Welcome'}</h1>
    {content?.subtitle && <p class="text-lg text-slate-600 mb-4">{content.subtitle}</p>}
    {content?.description && <p class="text-base text-slate-500 mb-6">{content.description}</p>}
    {content?.primaryCTA?.href && (
      <a href={content.primaryCTA.href} class="inline-block bg-blue-600 text-white px-5 py-3 rounded-md">{content.primaryCTA.text}</a>
    )}
  </div>
</section>