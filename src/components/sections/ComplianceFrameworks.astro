---
import Icon from '@/components/ui/icons/Icon.astro';

interface Props {
  lang?: 'en' | 'fi';
}
const { lang = 'en' } = Astro.props;
const isFi = lang === 'fi';

interface Row {
  name: string;
  acronym: string;
  focus: string;
  scope: string;
  type: string;
  href: string;
}

const regulations: Row[] = isFi ? [
  { name: 'Yleinen tietosuoja-asetus', acronym: 'GDPR', focus: 'Sääntelee henkilötietojen keräämistä, käsittelyä ja suojaamista.', scope: 'Kaikki organisaatiot, jotka käsittelevät EU:n kansalaisten henkilötietoja, sijainnista riippumatta.', type: 'Asetus', href: '/fi/regulatory/gdpr' },
  { name: 'Verkko- ja tietoturvadirektiivi', acronym: 'NIS2', focus: 'Asettaa vähimmäisvaatimukset kyberturvallisuuden riskienhallinnalle ja häiriöraportoinnille.', scope: 'Oleelliset ja tärkeät toimijat noin 18 sektorilla (energia, liikenne, terveys, digitaalinen infrastruktuuri).', type: 'Direktiivi', href: '/fi/frameworks/nis2' },
  { name: 'Kyberkestävyyssäädös', acronym: 'CRA', focus: 'Edellyttää tietoturvaa jo suunnitteluvaiheessa digitaalisia elementtejä sisältäville tuotteille.', scope: 'Valmistajat, maahantuojat ja jakelijat, jotka tuovat laitteita tai ohjelmistoja EU-markkinoille.', type: 'Asetus', href: '/fi/regulatory/cyber-resilience-act' },
  { name: 'Digitaalisen toimintakyvyn asetus', acronym: 'DORA', focus: 'Asettaa ICT-riskienhallinnan, häiriöraportoinnin ja resilienssitestauksen vaatimukset.', scope: 'Pankit, vakuutusyhtiöt, sijoituspalveluyritykset ja niiden kriittiset ICT-kolmannen osapuolen palveluntarjoajat.', type: 'Asetus', href: '/fi/frameworks/dora' },
  { name: 'Kriittisten toimijoiden häiriönsietokykydirektiivi', acronym: 'CER', focus: 'Edellyttää fyysisiä ja operatiivisia häiriönsietokykytoimenpiteitä keskeisten palveluiden tarjoajille.', scope: 'Keskeisten palveluiden (energia, vesi, liikenne, terveys) tarjoajat.', type: 'Direktiivi', href: '/fi/regulatory' },
  { name: 'Sähköinen tunnistaminen ja luottamuspalvelut', acronym: 'eIDAS 2.0', focus: 'Määrittää säännöt luotettavalle digitaaliselle identiteetille, mukaan lukien EU:n digitaalinen lompakko.', scope: 'Luottamuspalveluiden tarjoajat, jäsenvaltiot ja digitaalista identiteettiä hyödyntävät organisaatiot.', type: 'Asetus', href: '/fi/frameworks/eidas' },
  { name: 'Tekoälysäädös', acronym: 'EU AI Act', focus: 'Asettaa riskiperusteiset velvoitteet tekoälyjärjestelmien kehittämiselle ja käytölle.', scope: 'Tekoälyjärjestelmien tarjoajat ja käyttöönottajat EU-markkinoilla tai EU-käyttäjille.', type: 'Asetus', href: '/fi/services/ai-act-compliance' },
] : [
  { name: 'General Data Protection Regulation', acronym: 'GDPR', focus: 'Governs how organizations collect, process, and protect personal data.', scope: 'Any organization processing personal data of EU residents, regardless of location.', type: 'Regulation', href: '/regulatory/gdpr' },
  { name: 'Network and Information Security Directive 2', acronym: 'NIS2', focus: 'Sets minimum cybersecurity risk-management and incident-reporting requirements.', scope: 'Essential and important entities across ~18 sectors (energy, transport, health, digital infrastructure).', type: 'Directive', href: '/frameworks/nis2' },
  { name: 'Cyber Resilience Act', acronym: 'CRA', focus: 'Mandates cybersecurity-by-design and vulnerability handling for connected products.', scope: 'Manufacturers, importers, and distributors of hardware or software placed on the EU market.', type: 'Regulation', href: '/regulatory/cyber-resilience-act' },
  { name: 'Digital Operational Resilience Act', acronym: 'DORA', focus: 'Establishes ICT risk-management, incident-reporting, and resilience-testing requirements.', scope: 'Banks, insurers, investment firms, and their critical ICT third-party providers.', type: 'Regulation', href: '/frameworks/dora' },
  { name: 'Critical Entities Resilience Directive', acronym: 'CER', focus: 'Requires physical and operational resilience measures for essential-service providers.', scope: 'Operators of essential services such as energy, water, transport, and health.', type: 'Directive', href: '/regulatory' },
  { name: 'Electronic Identification, Authentication and Trust Services', acronym: 'eIDAS 2.0', focus: 'Establishes rules for trusted digital identity, including the EU Digital Identity Wallet.', scope: 'Trust service providers, member states, and organizations relying on digital identity or signatures.', type: 'Regulation', href: '/frameworks/eidas' },
  { name: 'Artificial Intelligence Act', acronym: 'EU AI Act', focus: 'Introduces risk-based obligations for the development and use of AI systems.', scope: 'Providers and deployers of AI systems placed on the EU market or affecting EU users.', type: 'Regulation', href: '/services/ai-act-compliance' },
];

const standards: Row[] = isFi ? [
  { name: 'Tietoturvallisuuden hallintajärjestelmä', acronym: 'ISO/IEC 27001', focus: 'Määrittää vaatimukset tietoturvan hallintajärjestelmän perustamiselle ja jatkuvalle kehittämiselle.', scope: 'Organisaatiot, jotka haluavat osoittaa järjestelmällistä tietoturvan hallintaa.', type: 'Standardi / Sertifiointi', href: '/fi/frameworks/iso-27001' },
  { name: 'Tietosuojan hallintajärjestelmä', acronym: 'ISO/IEC 27701', focus: 'Laajentaa ISO 27001:tä tietosuojaspesifisillä kontrolleilla GDPR-yhteensopivuuden osoittamiseksi.', scope: 'Organisaatiot, jotka käsittelevät henkilötietoja rekisterinpitäjänä tai käsittelijänä.', type: 'Standardi / Sertifiointi', href: '/fi/services/standards-and-certifications/iso-27701-pims' },
  { name: 'Tekoälyn hallintajärjestelmä', acronym: 'ISO/IEC 42001', focus: 'Tarjoaa kehyksen tekoälyjärjestelmien vastuulliselle hallinnalle koko niiden elinkaaren ajan.', scope: 'Organisaatiot, jotka kehittävät, tarjoavat tai käyttävät tekoälyjärjestelmiä.', type: 'Standardi / Sertifiointi', href: '/fi/services' },
  { name: 'Pilvipalveluiden tietoturva- ja tietosuojakontrollit', acronym: 'ISO/IEC 27017 & 27018', focus: 'Täydentävät tietoturva- (27017) ja tietosuojakontrollit (27018) pilvipalveluympäristöille.', scope: 'Pilvipalveluntarjoajat ja niiden yritysasiakkaat.', type: 'Standardi', href: '/fi/services/standards-and-certifications/iso-27017-27018' },
  { name: 'Palveluorganisaation valvontaraportti 2', acronym: 'SOC 2', focus: 'Arviointiraportti, joka arvioi palveluntarjoajan kontrolleja turvallisuuden, saatavuuden ja luottamuksellisuuden osalta.', scope: 'SaaS- ja teknologiapalveluntarjoajat, joilta yritysasiakkaat usein vaativat raporttia.', type: 'Sertifiointi / Todistus', href: '/fi/frameworks/soc-2' },
  { name: 'NIST-kyberturvallisuuskehys', acronym: 'NIST CSF', focus: 'Vapaaehtoinen parhaiden käytäntöjen kehys kyberriskien tunnistamiseen, suojaamiseen ja niistä toipumiseen.', scope: 'Mikä tahansa organisaatio; laajalti käytetty vertailukehyksenä.', type: 'Kehys', href: '/fi/services' },
  { name: 'CIS-tietoturvakontrollit', acronym: 'CIS Controls', focus: 'Priorisoitu joukko teknisiä suojatoimia yleisiä kyberhyökkäyksiä vastaan.', scope: 'Mikä tahansa organisaatio, erityisesti teknisen perustason vahvistamiseen.', type: 'Kehys', href: '/fi/services' },
  { name: 'Maksukorttialan tietoturvastandardi', acronym: 'PCI DSS', focus: 'Asettaa tietoturvavaatimukset organisaatioille, jotka tallentavat tai käsittelevät maksukorttitietoja.', scope: 'Kauppiaat, maksunvälittäjät ja korttitietoja käsittelevät palveluntarjoajat.', type: 'Standardi / Sertifiointi', href: '/fi/services' },
] : [
  { name: 'Information Security Management System', acronym: 'ISO/IEC 27001', focus: 'Defines requirements for establishing and continually improving an information security management system.', scope: 'Any organization seeking to demonstrate systematic security governance.', type: 'Standard / Certification', href: '/frameworks/iso-27001' },
  { name: 'Privacy Information Management System', acronym: 'ISO/IEC 27701', focus: 'Extends ISO 27001 with privacy-specific controls to demonstrate GDPR-aligned governance.', scope: 'Organizations managing personal data as controllers or processors.', type: 'Standard / Certification', href: '/services/standards-and-certifications/iso-27701-pims' },
  { name: 'AI Management System', acronym: 'ISO/IEC 42001', focus: 'Provides a framework for responsible governance of AI systems across their lifecycle.', scope: 'Organizations that develop, provide, or use AI systems.', type: 'Standard / Certification', href: '/services' },
  { name: 'Cloud Security & Privacy Controls', acronym: 'ISO/IEC 27017 & 27018', focus: 'Add security (27017) and personal-data-protection (27018) controls specific to cloud environments.', scope: 'Cloud service providers and their enterprise customers.', type: 'Standard', href: '/services/standards-and-certifications/iso-27017-27018' },
  { name: 'Service Organization Control 2', acronym: 'SOC 2', focus: 'An attestation report evaluating a service provider’s controls for security, availability, and confidentiality.', scope: 'SaaS and technology providers, typically demanded by enterprise customers.', type: 'Certification / Attestation', href: '/frameworks/soc-2' },
  { name: 'NIST Cybersecurity Framework', acronym: 'NIST CSF', focus: 'A voluntary framework of best practices for identifying, protecting against, and recovering from cyber risk.', scope: 'Any organization; widely used as a benchmarking framework.', type: 'Framework', href: '/services' },
  { name: 'Center for Internet Security Controls', acronym: 'CIS Controls', focus: 'A prioritized set of technical safeguards that defend against common cyberattacks.', scope: 'Any organization, especially for technical baseline hardening.', type: 'Framework', href: '/services' },
  { name: 'Payment Card Industry Data Security Standard', acronym: 'PCI DSS', focus: 'Sets security requirements for organizations that store, process, or transmit payment card data.', scope: 'Merchants, payment processors, and service providers handling cardholder data.', type: 'Standard / Certification', href: '/services' },
];

const t = {
  heading: isFi ? 'Yhteensopivuuskehykset' : 'Compliance Frameworks',
  subheading: isFi
    ? 'Pakolliset EU-säädökset ja vapaaehtoiset standardit yhdessä johdonmukaisessa ohjelmassa.'
    : 'Mandatory EU regulation and voluntary trust-building standards, in one coherent program.',
  regTitle: isFi ? 'EU-säädökset (lakisääteisiä)' : 'EU Regulations (Legally Mandatory)',
  regIntro: isFi
    ? 'Nämä ovat lakisääteisiä velvoitteita, joiden noudattamatta jättämisestä seuraa valvontatoimia ja sanktioita.'
    : 'These are legal obligations. Non-compliance carries enforcement action and financial penalties.',
  stdTitle: isFi ? 'Standardit ja sertifioinnit (vapaaehtoisia / luottamusta rakentavia)' : 'Standards & Certifications (Voluntary / Trust-Building)',
  stdIntro: isFi
    ? 'Nämä kehykset ovat vapaaehtoisia, mutta ne osoittavat kypsyyttä ja rakentavat luottamusta markkinoilla ja asiakkaiden silmissä.'
    : 'These frameworks are voluntary, but they prove operational maturity and build trust with customers, partners, and the market.',
  colName: isFi ? 'Nimi' : 'Name',
  colFocus: isFi ? 'Painopiste' : 'Focus',
  colScope: isFi ? 'Soveltamisala' : 'Scope',
  colType: isFi ? 'Tyyppi' : 'Type',
  connectTitle: isFi ? 'Miten nämä liittyvät toisiinsa' : 'How they connect',
  connectBody: isFi
    ? 'Kategorian 2 standardien käyttöönotto on tehokkain tapa täyttää kategorian 1 säädökset. ISO 27001 tukee suoraan GDPR- ja NIS2-vaatimusten täyttämistä, ja tunnustetun sertifiointijärjestelmän mukainen sertifiointi voi myöntää vaatimustenmukaisuusolettaman CRA:n alaisuudessa.'
    : 'Adopting the Category 2 standards is the most efficient path to satisfying the Category 1 regulations. ISO 27001 directly supports GDPR and NIS2 compliance, and certification under a recognized scheme can grant a presumption of conformity under the CRA.',
  cta: isFi ? 'Pyydä yhteensopivuusarviointi' : 'Request a Compliance Assessment',
};
---

<section class="py-16 relative overflow-hidden bg-[#f4f1ea]" style="background-image: linear-gradient(#e2dac5 1px, transparent 1px), linear-gradient(90deg, #e2dac5 1px, transparent 1px); background-size: 42px 42px;">
  <div class="absolute top-0 left-0 right-0 h-32 bg-white"></div>
  <div class="absolute bottom-0 left-0 right-0 h-32 bg-white"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-[#003580] mb-4">{t.heading}</h2>
      <p class="text-base md:text-lg text-[#131c2e] max-w-3xl mx-auto leading-relaxed">{t.subheading}</p>
    </div>

    <!-- Category 1: EU Regulations -->
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-2 h-2 rounded-full bg-[#B91C1C]"></div>
        <h3 class="text-lg md:text-xl font-bold text-[#14171a]">{t.regTitle}</h3>
      </div>
      <p class="text-sm text-slate-600 mb-5 max-w-3xl">{t.regIntro}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {regulations.map((row) => (
          <a href={row.href} class="group bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#B91C1C] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start justify-between gap-2 mb-2 relative z-10">
              <h4 class="text-base font-bold text-[#14171a] group-hover:text-[#B91C1C] transition-colors duration-300">{row.acronym}</h4>
              <span class="flex-shrink-0 text-[10px] font-bold uppercase tracking-wider text-[#B91C1C] border border-[#B91C1C]/30 rounded-[2px] px-1.5 py-0.5 whitespace-nowrap">{row.type}</span>
            </div>
            <p class="text-xs text-slate-500 mb-3 relative z-10">{row.name}</p>
            <p class="text-sm text-slate-600 leading-relaxed flex-1 relative z-10">{row.focus}</p>
            <div class="mt-4 pt-3 border-t border-slate-100 relative z-10">
              <p class="text-xs text-slate-500 leading-relaxed"><span class="font-semibold text-[#14171a]">{t.colScope}:</span> {row.scope}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- Category 2: Standards & Certifications -->
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-2">
        <div class="w-2 h-2 rounded-full bg-[#003580]"></div>
        <h3 class="text-lg md:text-xl font-bold text-[#14171a]">{t.stdTitle}</h3>
      </div>
      <p class="text-sm text-slate-600 mb-5 max-w-3xl">{t.stdIntro}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {standards.map((row) => (
          <a href={row.href} class="group bg-white rounded-xl border-2 border-slate-100 shadow-sm
                      hover:shadow-xl hover:-translate-y-1 hover:shadow-md
                      transition-all duration-300
                      flex flex-col p-5 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#003580] group-hover:h-[6px] transition-all duration-300"></div>
            <div class="flex items-start justify-between gap-2 mb-2 relative z-10">
              <h4 class="text-base font-bold text-[#14171a] group-hover:text-[#003580] transition-colors duration-300">{row.acronym}</h4>
              <span class="flex-shrink-0 text-[10px] font-bold uppercase tracking-wider text-[#003580] border border-[#003580]/30 rounded-[2px] px-1.5 py-0.5 whitespace-nowrap">{row.type}</span>
            </div>
            <p class="text-xs text-slate-500 mb-3 relative z-10">{row.name}</p>
            <p class="text-sm text-slate-600 leading-relaxed flex-1 relative z-10">{row.focus}</p>
            <div class="mt-4 pt-3 border-t border-slate-100 relative z-10">
              <p class="text-xs text-slate-500 leading-relaxed"><span class="font-semibold text-[#14171a]">{t.colScope}:</span> {row.scope}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <!-- How they connect -->
    <div class="bg-white border-2 border-[#003580] rounded-xl p-6 md:p-8 flex flex-col md:flex-row gap-4 md:items-start">
      <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[#003580] flex items-center justify-center">
        <Icon name="check" class="w-5 h-5 text-white" />
      </div>
      <div class="flex-1">
        <h4 class="text-base font-bold text-[#14171a] mb-1">{t.connectTitle}</h4>
        <p class="text-sm text-slate-600 leading-relaxed">{t.connectBody}</p>
      </div>
      <div class="flex-shrink-0 self-center md:self-auto">
        <a href={isFi ? '/fi/contact' : '/contact'} class="inline-flex items-center gap-1.5 bg-[#14171a] hover:bg-[#003580] text-white text-sm font-semibold px-5 py-2.5 rounded-[2px] transition-all duration-300 whitespace-nowrap">
          {t.cta}
          <Icon name="arrowRight" class="w-4 h-4" />
        </a>
      </div>
    </div>

  </div>
</section>
