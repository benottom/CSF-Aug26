---
import { twMerge } from "tailwind-merge";
const { type, href, rel, target, variant, className, id, size, disabled, loading } = Astro.props;

export interface Props {
  type?: "button" | "submit" | "reset";
  href?: string;
  rel?: string;
  target?: "_self" | "_blank" | "_parent" | "_top";
  variant?: "primary" | "secondary" | "tertiary" | "white" | "outline-white" | "brand" | "danger" | "success" | "warning" | "ghost" | "link"; // added legacy variants
  size?: "sm" | "md" | "lg";
  className?: string;
  id?: string;
  disabled?: boolean;
  loading?: boolean;
}

/**
 * Variants: Defines predefined styling options for the 'variant' prop.
 * - primary: A solid teal button with white text and hover/active effects.
 * - secondary: A bordered button with teal and slate accents with hover effects.
 * - tertiary: A soft teal background with hover effects.
 * - white: Solid white button for dark backgrounds.
 * - outline-white: Transparent background with white border/text for dark sections.
 * - brand: Brand-styled button matching template design
 * - danger: Danger-styled button for destructive actions
 * - success: Success-styled button for positive actions
 * - warning: Warning-styled button for cautionary actions
 * - ghost: Minimal button with subtle hover effect
 * - link: Link-styled button that looks like a text link
 */

const variants = {
  primary:
    "bg-[#14171a] hover:bg-[#003580] text-[#f4f1ea] border border-[#14171a] hover:border-[#003580] font-semibold transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003580]",
  secondary:
    "bg-transparent text-[#14171a] border border-[#14171a] hover:border-[#003580] hover:text-[#003580] font-semibold transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#003580]",
  tertiary: "bg-sky-50 text-sky-700 hover:bg-sky-100 border border-transparent font-medium transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-300",
  white: "bg-[#f4f1ea] text-[#14171a] hover:bg-[#ece7db] border border-[#cbc0a4] font-medium transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-300",
  "outline-white": "bg-transparent text-[#eef1f5] border border-[#eef1f5] hover:bg-white/10 font-medium transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white",
  brand: "bg-[var(--brand-primary)] hover:bg-[var(--brand-accent)] text-[#f4f1ea] font-semibold border border-[var(--brand-primary)] hover:border-[var(--brand-accent)] transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[var(--brand-primary)]",
  danger: "bg-red-600 hover:bg-red-700 text-white font-semibold border border-red-600 hover:border-red-700 transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500",
  success: "bg-green-600 hover:bg-green-700 text-white font-semibold border border-green-600 hover:border-green-700 transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500",
  warning: "bg-amber-500 hover:bg-amber-600 text-white font-semibold border border-amber-500 hover:border-amber-600 transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500",
  ghost: "bg-transparent text-slate-700 hover:bg-slate-100 border border-transparent font-medium transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-300",
  link: "bg-transparent text-[#002D6C] hover:text-[#003580] underline decoration-transparent hover:decoration-current underline-offset-4 transition-colors duration-150 ease-in-out focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-300"
};

const sizes = {
  sm: "text-sm px-4 py-2 rounded-[2px] min-h-[36px] inline-flex items-center justify-center gap-2 self-center sm:self-auto",
  md: "text-base px-6 py-3 rounded-[2px] min-h-[44px] inline-flex items-center justify-center gap-2 self-center sm:self-auto",
  lg: "text-lg px-8 py-4 rounded-[2px] min-h-[52px] inline-flex items-center justify-center gap-2 self-center sm:self-auto"
};
---

{
  /*
Button Component:
This component dynamically renders either a `<button>` element or an `<a>` (link) element based on the provided `href` prop.

 - If the `href` prop is provided, an `<a>` tag is rendered to allow navigation.
 - If no `href` is provided, a `<button>` tag is rendered for performing actions and supports the `type` attribute (e.g., 'button', 'submit', or 'reset') to specify its behavior.

 Both types of elements share a similar structure and styling logic, with customization through the `variant`, `size`, `className`, and `id` props.
*/
}

{
  href ? (
    <a
      id={id}
      href={href}
      rel={rel ? rel : undefined}
      target={target ? target : undefined}
      class={twMerge(
        `${variants[variant ?? "primary"]} ${sizes[size ?? "md"]} ${className || ""} ${
          disabled
            ? 'opacity-50 cursor-not-allowed'
            : 'cursor-pointer'
        }`,
      )}
      aria-disabled={disabled}
    >
      {loading && (
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      )}
      <slot />
    </a>
  ) : (
    <button
      id={id}
      type={type || "button"}
      disabled={disabled || loading}
      class={twMerge(
        `${variants[variant ?? "primary"]} ${sizes[size ?? "md"]} ${className || ""} ${
          disabled || loading
            ? 'opacity-50 cursor-not-allowed'
            : 'cursor-pointer'
        }`,
      )}
    >
      {loading && (
        <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-current" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      )}
      <slot />
    </button>
  )
}

