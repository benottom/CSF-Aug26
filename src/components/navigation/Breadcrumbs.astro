---
/**
 * Simple Breadcrumbs component - clean Home / Services / Page format
 * Usage: <Breadcrumbs segments={[{ href: '/', label: 'Home' }, ...]} />
 * If segments not passed, builds from current path.
 */
interface Crumb { href: string; label: string }
interface Props { segments?: Crumb[] }
const { segments } = Astro.props as Props;
const path = Astro.url.pathname.replace(/\/$/, '');
const isFi = path.startsWith('/fi');

const parts = segments ?? path.split('/').filter(Boolean).reduce((acc: Crumb[], part, idx, arr) => {
  const href = '/' + arr.slice(0, idx + 1).join('/');
  acc.push({ href, label: decodeURIComponent(part.replace(/-/g,' ')) });
  return acc;
}, []);

const homeHref = isFi ? '/fi' : '/';
const homeLabel = isFi ? 'Etusivu' : 'Home';
---

<nav aria-label="Breadcrumb" class="pt-4 pb-1 mb-1 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ol class="flex flex-wrap items-center gap-1 text-slate-500">
      <li><a href={homeHref} class="hover:text-sky-700 transition-colors duration-200">{homeLabel}</a></li>
      {parts.map(p => (
        <li class="flex items-center">
          <span class="mx-1 text-slate-400">/</span>
          <a href={p.href} class="capitalize hover:text-sky-700 transition-colors duration-200 aria-[current=page]:text-slate-700" aria-current={p.href === path ? 'page' : undefined}>{p.label}</a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<script>
  // Simple breadcrumb component - no JavaScript needed
</script>

