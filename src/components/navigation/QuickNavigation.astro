---
import Icon from '@ui/icons/Icon.astro';

interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const quickNavItems: NavItem[] = [
  {
    label: "Services",
    href: "/services",
    icon: "briefcase"
  },
  {
    label: "Compliance",
    href: "/regulatory",
    icon: "shield-check"
  },
  {
    label: "Frameworks",
    href: "/frameworks",
    icon: "cube"
  },
  {
    label: "Industries",
    href: "/industries",
    icon: "building-office"
  },
  {
    label: "Resources",
    href: "/resources",
    icon: "document-text"
  },
  {
    label: "Contact",
    href: "/contact",
    icon: "envelope"
  }
];
---

<!-- Quick Navigation Sidebar -->
<div class="fixed right-0 top-1/2 transform -translate-y-1/2 z-[80] hidden lg:flex flex-col items-center">
  <!-- Toggle Button -->
  <button 
    id="quick-nav-toggle"
    class="bg-gradient-to-b from-sky-600 to-cyan-700 text-white p-3 rounded-l-lg shadow-lg hover:shadow-xl transition-all duration-300 group"
    aria-label="Toggle quick navigation"
  >
    <Icon name="bars" class="w-5 h-5 transform group-hover:rotate-180 transition-transform duration-300" />
  </button>
  
  <!-- Navigation Items -->
  <div id="quick-nav-menu" class="bg-white rounded-l-lg shadow-xl border border-slate-200 mt-1 hidden opacity-0 transition-all duration-300 transform translate-x-4">
    <div class="flex flex-col py-2 min-w-[200px]">
      {quickNavItems.map(item => (
        <a
          href={item.href}
          class="flex items-center px-4 py-3 text-sm text-slate-700 hover:bg-slate-50 hover:text-sky-600 border-l-4 border-transparent hover:border-sky-500 transition-all duration-200"
        >
          <Icon name={item.icon} class="w-4 h-4 mr-3 text-slate-500" />
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButton = document.getElementById('quick-nav-toggle');
    const navMenu = document.getElementById('quick-nav-menu');
    
    if (!toggleButton || !navMenu) return;
    
    toggleButton.addEventListener('click', () => {
      navMenu.classList.toggle('hidden');
      navMenu.classList.toggle('opacity-0');
      navMenu.classList.toggle('translate-x-4');
      
      // Rotate the toggle icon
      const icon = toggleButton.querySelector('svg');
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      if (!toggleButton.contains(event.target) && !navMenu.contains(event.target)) {
        navMenu.classList.add('hidden');
        navMenu.classList.add('opacity-0');
        navMenu.classList.remove('translate-x-4');
        
        // Reset rotation
        const icon = toggleButton.querySelector('svg');
        if (icon) {
          icon.classList.remove('rotate-180');
        }
      }
    });
  });
</script>