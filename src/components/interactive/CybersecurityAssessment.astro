---
import Icon from '@/components/ui/icons/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  formType?: 'assessment' | 'calculator' | 'consultation';
}

const { 
  title = "Cybersecurity Risk Assessment", 
  description = "Evaluate your organization's cybersecurity posture with our quick assessment", 
  formType = 'assessment' 
}: Props = Astro.props;

// Questions for the assessment
const assessmentQuestions = [
  {
    id: 1,
    question: "How many employees does your organization have?",
    type: "radio",
    options: [
      { value: "1-10", label: "1-10 employees", weight: 1 },
      { value: "11-50", label: "11-50 employees", weight: 2 },
      { value: "51-200", label: "51-200 employees", weight: 3 },
      { value: "201+", label: "201+ employees", weight: 4 }
    ]
  },
  {
    id: 2,
    question: "Which industry best describes your organization?",
    type: "radio",
    options: [
      { value: "finance", label: "Financial Services", weight: 3 },
      { value: "healthcare", label: "Healthcare", weight: 4 },
      { value: "tech", label: "Technology/SaaS", weight: 2 },
      { value: "manufacturing", label: "Manufacturing", weight: 2 },
      { value: "other", label: "Other", weight: 1 }
    ]
  },
  {
    id: 3,
    question: "Does your organization handle personal data of EU residents?",
    type: "radio",
    options: [
      { value: "yes", label: "Yes", weight: 4 },
      { value: "no", label: "No", weight: 1 }
    ]
  },
  {
    id: 4,
    question: "How would you rate your current cybersecurity measures?",
    type: "radio",
    options: [
      { value: "excellent", label: "Excellent - Well-established program", weight: 1 },
      { value: "good", label: "Good - Basic measures in place", weight: 2 },
      { value: "fair", label: "Fair - Some gaps exist", weight: 3 },
      { value: "poor", label: "Poor - Significant gaps", weight: 4 }
    ]
  },
  {
    id: 5,
    question: "What is your biggest cybersecurity concern?",
    type: "checkbox",
    options: [
      { value: "data-breaches", label: "Data breaches", weight: 3 },
      { value: "compliance", label: "Regulatory compliance", weight: 4 },
      { value: "employee-training", label: "Employee training", weight: 2 },
      { value: "incident-response", label: "Incident response", weight: 3 },
      { value: "vendor-security", label: "Third-party vendor security", weight: 2 }
    ]
  }
];
---

<div class="bg-slate-50/80 rounded-xl border border-slate-200 shadow-sm p-6 md:p-8">
  <div class="max-w-2xl mx-auto">
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-12 h-12 bg-[#003580]/10 rounded-full mb-4 border border-[#003580]">
        <Icon name="shieldCheck" class="w-6 h-6 text-[#003580]" />
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-[#131c2e] mb-3">{title}</h2>
      <p class="text-slate-600">{description}</p>
    </div>
    
    <!-- About the Assessment Section -->
    <div class="bg-white rounded-xl border-2 border-slate-100 p-5 md:p-6 mb-6
                hover:shadow-md hover:shadow-md
                transition-all duration-300 group">
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <div class="w-10 h-10 bg-[#003580]/10 rounded-lg flex items-center justify-center
                      group-hover:bg-[#003580] transition-colors duration-300">
            <svg class="w-5 h-5 text-[#003580] group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-[#14171a] group-hover:text-[#003580] transition-colors duration-300 mb-1">
            About the Assessment
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            Our cybersecurity assessment covers core cybersecurity domains and gives you a preliminary picture of your organization's current state.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed mt-2">
            The assessment takes about 5-10 minutes and is completely anonymized. Results are kept confidential and used solely for generating recommendations.
          </p>
        </div>
      </div>
    </div>
    
    <form id="interactive-assessment-form" class="space-y-5">
      {assessmentQuestions.map((q) => (
        <div class="bg-white rounded-xl border-2 border-slate-100 shadow-sm hover:shadow-md transition-all duration-300 p-5">
          <h3 class="text-sm font-bold text-[#14171a] mb-4">{q.question}</h3>
          
          {q.type === 'radio' && (
            <div class="space-y-2">
              {q.options.map((option) => (
                <label class="flex items-start p-3 border border-slate-200 rounded-lg hover:shadow-md hover:bg-slate-50 cursor-pointer transition-all duration-200">
                  <input 
                    type="radio" 
                    name={`question-${q.id}`} 
                    value={option.value}
                    class="mt-1 mr-3 text-[#003580] focus:ring-[#003580] focus:ring-2"
                    required={q.id <= 4}
                  />
                  <span class="text-sm text-slate-700">{option.label}</span>
                </label>
              ))}
            </div>
          )}
          
          {q.type === 'checkbox' && (
            <div class="space-y-2">
              {q.options.map((option) => (
                <label class="flex items-start p-3 border border-slate-200 rounded-lg hover:shadow-md hover:bg-slate-50 cursor-pointer transition-all duration-200">
                  <input 
                    type="checkbox" 
                    name={`question-${q.id}`} 
                    value={option.value}
                    class="mt-1 mr-3 text-[#003580] focus:ring-[#003580] focus:ring-2"
                  />
                  <span class="text-sm text-slate-700">{option.label}</span>
                </label>
              ))}
            </div>
          )}
        </div>
      ))}
      
      <div class="pt-2">
        <button 
          type="submit"
          class="w-full bg-[#131c2e] text-white font-medium py-3 px-6 rounded-[2px] hover:bg-[#003580] transition-all duration-300 shadow-md hover:shadow-lg"
        >
          Calculate Risk Level
        </button>
      </div>
    </form>
    
    <!-- Results Display (initially hidden) -->
    <div id="assessment-results" class="hidden mt-8 p-6 bg-white rounded-xl border-2 border-[#003580] shadow-sm">
      <h3 class="text-lg font-bold text-[#131c2e] mb-4">Your Assessment Results</h3>
      <div class="space-y-4">
        <div class="flex items-center justify-between p-4 bg-slate-50 rounded-lg border border-slate-100">
          <span class="font-medium text-slate-700">Risk Level:</span>
          <span id="risk-level" class="px-3 py-1 bg-red-100 text-red-800 rounded-[2px] text-sm font-medium">Medium</span>
        </div>
        <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
          <h4 class="font-medium text-[#14171a] mb-2">Recommended Actions:</h4>
          <ul id="recommendations" class="space-y-2 text-sm text-slate-600">
            <li class="flex items-start">
              <Icon name="arrowRight" class="w-4 h-4 text-[#003580] mt-0.5 mr-2 flex-shrink-0" />
              <span>Consider implementing a Virtual CISO (V-CISO) service</span>
            </li>
            <li class="flex items-start">
              <Icon name="arrowRight" class="w-4 h-4 text-[#003580] mt-0.5 mr-2 flex-shrink-0" />
              <span>Evaluate GDPR compliance needs with Virtual DPO (V-DPO) service</span>
            </li>
            <li class="flex items-start">
              <Icon name="arrowRight" class="w-4 h-4 text-[#003580] mt-0.5 mr-2 flex-shrink-0" />
              <span>Review our ISO 27001 Fast-Track package</span>
            </li>
          </ul>
        </div>
        <div class="pt-2">
          <a
            href="/contact?service=consultation"
            class="inline-block w-full text-center bg-[#131c2e] text-white font-medium py-3 px-6 rounded-[2px] hover:bg-[#003580] transition-all duration-300 hover:shadow-lg"
          >
            Request a Compliance Assessment
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const assessmentForm = document.getElementById('interactive-assessment-form') as HTMLFormElement | null;
  assessmentForm?.addEventListener('submit', function(this: HTMLFormElement, e: SubmitEvent) {
    e.preventDefault();

    // Calculate risk level based on selections
    const formData = new FormData(this);
    let totalScore = 0;
    let questionCount = 0;

    // Get all radio questions (1-4) and checkbox question (5)
    for (let i = 1; i <= 4; i++) {
      const selectedRadio = this.querySelector<HTMLInputElement>(`input[name="question-${i}"]:checked`);
      if (selectedRadio) {
        // Find the option in our data to get the weight
        const question = {
          1: {options: [{value:"1-10",weight:1},{value:"11-50",weight:2},{value:"51-200",weight:3},{value:"201+",weight:4}]},
          2: {options: [{value:"finance",weight:3},{value:"healthcare",weight:4},{value:"tech",weight:2},{value:"manufacturing",weight:2},{value:"other",weight:1}]},
          3: {options: [{value:"yes",weight:4},{value:"no",weight:1}]},
          4: {options: [{value:"excellent",weight:1},{value:"good",weight:2},{value:"fair",weight:3},{value:"poor",weight:4}]}
        }[i];
        
        if (question) {
          const selectedOption = question.options.find(opt => opt.value === selectedRadio.value);
          if (selectedOption) {
            totalScore += selectedOption.weight;
            questionCount++;
          }
        }
      }
    }
    
    // Handle checkbox question (5)
    const checkedBoxes = this.querySelectorAll<HTMLInputElement>('input[name="question-5"]:checked');
    if (checkedBoxes.length > 0) {
      // For checkboxes, we'll add weights for each selected option
      const question5 = {options: [
        {value:"data-breaches",weight:3},
        {value:"compliance",weight:4},
        {value:"employee-training",weight:2},
        {value:"incident-response",weight:3},
        {value:"vendor-security",weight:2}
      ]};
      
      checkedBoxes.forEach(checkbox => {
        const option = question5.options.find(opt => opt.value === checkbox.value);
        if (option) {
          totalScore += option.weight;
          questionCount++;
        }
      });
    }
    
    // Calculate average score
    const avgScore = questionCount > 0 ? totalScore / questionCount : 0;
    
    // Determine risk level
    let riskLevel = 'Low';
    let riskColor = 'green';
    if (avgScore > 2.5) {
      riskLevel = 'High';
      riskColor = 'red';
    } else if (avgScore > 1.5) {
      riskLevel = 'Medium';
      riskColor = 'yellow';
    }
    
    // Update risk level display
    const riskLevelEl = document.getElementById('risk-level');
    if (riskLevelEl) {
      riskLevelEl.textContent = riskLevel;
      riskLevelEl.className = `px-3 py-1 bg-${riskColor}-100 text-${riskColor}-800 rounded-[2px] text-sm font-medium`;
    }
    
    // Update recommendations based on risk level
    const recommendationsEl = document.getElementById('recommendations');
    if (recommendationsEl) {
      let recommendations = [];
      
      if (riskLevel === 'High') {
        recommendations = [
          'Immediate Virtual CISO (V-CISO) consultation recommended',
          'Priority GDPR compliance with Virtual DPO (V-DPO) service',
          'Urgent ISO 27001 implementation needed',
          'Comprehensive risk assessment required'
        ];
      } else if (riskLevel === 'Medium') {
        recommendations = [
          'Consider implementing a Virtual CISO (V-CISO) service',
          'Evaluate GDPR compliance needs with Virtual DPO (V-DPO) service',
          'Review our ISO 27001 Fast-Track package',
          'Schedule a security gap analysis'
        ];
      } else {
        recommendations = [
          'Maintain current security measures',
          'Consider periodic security assessments',
          'Stay updated on emerging threats',
          'Review compliance requirements annually'
        ];
      }
      
      recommendationsEl.innerHTML = recommendations.map(rec => 
        `<li class="flex items-start">
          <svg class="w-4 h-4 text-[#003580] mt-0.5 mr-2 flex-shrink-0" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>${rec}</span>
        </li>`
      ).join('');
    }
    
    // Show results
    const resultsEl = document.getElementById('assessment-results');
    if (resultsEl) {
      resultsEl.classList.remove('hidden');
      resultsEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  });
</script>