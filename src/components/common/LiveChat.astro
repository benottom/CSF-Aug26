---
import Icon from '@ui/icons/Icon.astro';

// Define props for the chat component
interface Props {
  isOpen?: boolean;
  position?: 'bottom-right' | 'bottom-left';
}

const { isOpen = false, position = 'bottom-right' }: Props = Astro.props;

// Position classes
const positionClasses = {
  'bottom-right': 'bottom-6 right-6',
  'bottom-left': 'bottom-6 left-6'
}[position];
---

<!-- Floating Chat Button -->
<button 
  id="chat-toggle"
  class="fixed z-[9999] bg-gradient-to-r from-teal-600 to-cyan-600 text-white rounded-full p-4 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-opacity-50"
  style={`${positionClasses}`}
  aria-label="Open chat"
>
  <div class="relative">
    <Icon name="chatBubble" class="w-6 h-6" />
    <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">3</span>
  </div>
</button>

<!-- Chat Container -->
<div 
  id="chat-container"
  class="fixed z-[9999] w-80 h-[500px] bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all duration-300 opacity-0 scale-95 translate-y-4"
  style={`${positionClasses.replace('bottom-', 'bottom-[calc(100px+)]').replace('right-', 'right-[calc(100px+)]').replace('left-', 'left-[calc(100px+)]')}`}
  aria-hidden="true"
>
  <!-- Chat Header -->
  <div class="bg-gradient-to-r from-teal-600 to-cyan-600 text-white p-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center">
        <div class="bg-white/20 p-2 rounded-full mr-3">
          <Icon name="chatBubble" class="w-5 h-5" />
        </div>
        <div>
          <h3 class="font-semibold">Live Support</h3>
          <p class="text-xs opacity-80">We're online now</p>
        </div>
      </div>
      <button id="chat-close" class="text-white hover:text-teal-200 focus:outline-none">
        <Icon name="x" class="w-5 h-5" />
      </button>
    </div>
  </div>
  
  <!-- Chat Messages Area -->
  <div id="chat-messages" class="h-[calc(100%-100px)] overflow-y-auto p-4 bg-slate-50">
    <div class="mb-4">
      <div class="bg-teal-100 text-slate-800 rounded-lg p-3 max-w-[80%] inline-block">
        <p>Hello! 👋 How can we help you today?</p>
      </div>
      <p class="text-xs text-slate-500 mt-1 ml-2">Support • Just now</p>
    </div>
    
    <div class="mb-4 text-right">
      <div class="bg-slate-200 text-slate-800 rounded-lg p-3 max-w-[80%] inline-block ml-auto">
        <p>Hi there! I have a question about your V-CISO services.</p>
      </div>
      <p class="text-xs text-slate-500 mt-1 mr-2 text-right">You • Just now</p>
    </div>
  </div>
  
  <!-- Chat Input Area -->
  <div class="border-t border-slate-200 p-3 bg-white">
    <div class="flex">
      <input
        type="text"
        placeholder="Type your message..."
        class="flex-1 border border-slate-300 rounded-l-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-teal-500 focus:border-teal-500"
        aria-label="Type your message"
      />
      <button 
        class="bg-gradient-to-r from-teal-600 to-cyan-600 text-white px-4 rounded-r-lg hover:opacity-90 transition-opacity"
        aria-label="Send message"
      >
        <Icon name="arrowRight" class="w-4 h-4" />
      </button>
    </div>
    <p class="text-xs text-slate-500 mt-2 text-center">Responses typically within minutes</p>
  </div>
</div>

<style>
  #chat-container.open {
    opacity: 1;
    scale: 1;
    transform: translateY(0);
  }
</style>

<script>
  // Get DOM elements
  const chatToggle = document.getElementById('chat-toggle');
  const chatContainer = document.getElementById('chat-container');
  const chatClose = document.getElementById('chat-close');
  const chatMessages = document.getElementById('chat-messages');
  
  // Toggle chat visibility
  function toggleChat() {
    chatContainer.classList.toggle('open');
    const isOpen = chatContainer.classList.contains('open');
    chatContainer.setAttribute('aria-hidden', !isOpen);
  }
  
  // Close chat
  function closeChat() {
    chatContainer.classList.remove('open');
    chatContainer.setAttribute('aria-hidden', 'true');
  }
  
  // Handle sending a message
  function sendMessage(event) {
    event.preventDefault();
    const input = chatContainer.querySelector('input[type="text"]');
    const message = input.value.trim();
    
    if (message) {
      // Add user message to chat
      const userMessageDiv = document.createElement('div');
      userMessageDiv.className = 'mb-4 text-right';
      userMessageDiv.innerHTML = `
        <div class="bg-slate-200 text-slate-800 rounded-lg p-3 max-w-[80%] inline-block ml-auto">
          <p>${message}</p>
        </div>
        <p class="text-xs text-slate-500 mt-1 mr-2 text-right">You • Just now</p>
      `;
      chatMessages.appendChild(userMessageDiv);
      
      // Clear input
      input.value = '';
      
      // Scroll to bottom
      chatMessages.scrollTop = chatMessages.scrollHeight;
      
      // Simulate bot response after a short delay
      setTimeout(() => {
        const botMessageDiv = document.createElement('div');
        botMessageDiv.className = 'mb-4';
        botMessageDiv.innerHTML = `
          <div class="bg-teal-100 text-slate-800 rounded-lg p-3 max-w-[80%] inline-block">
            <p>Thanks for your message! Our support team will get back to you shortly.</p>
          </div>
          <p class="text-xs text-slate-500 mt-1 ml-2">Support • Just now</p>
        `;
        chatMessages.appendChild(botMessageDiv);
        
        // Scroll to bottom again
        chatMessages.scrollTop = chatMessages.scrollHeight;
      }, 1000);
    }
  }
  
  // Event listeners
  chatToggle.addEventListener('click', toggleChat);
  chatClose.addEventListener('click', closeChat);
  
  // Handle form submission
  const form = chatContainer.querySelector('form') || document.createElement('form');
  const input = chatContainer.querySelector('input[type="text"]');
  const sendButton = chatContainer.querySelector('button[aria-label="Send message"]');
  
  // Since we don't have a form wrapper, we'll listen for Enter key on the input
  input.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') {
      sendMessage(e);
    }
  });
  
  // Also listen for clicks on the send button
  sendButton.addEventListener('click', (e) => {
    sendMessage(e);
  });
  
  // Close chat when clicking outside
  document.addEventListener('click', (event) => {
    if (
      !chatContainer.contains(event.target) && 
      !chatToggle.contains(event.target) &&
      chatContainer.classList.contains('open')
    ) {
      closeChat();
    }
  });
</script>