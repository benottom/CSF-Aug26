---
import Icon from "@ui/icons/Icon.astro";

// Scam warning banner for Cyber Security Finland scams
const warningLabel = "Security Alert";
const warningMessage = "Scam messages have been sent in the name of Cyber Security Finland.";
const linkText = "Read more about the scams";
const linkHref = "/resources/scam-awareness"; // You can update this to your actual scams resource page
---

<div class="w-full bg-white border-b border-[#DC2626]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Always a single row, on every viewport -->
    <div class="flex items-center justify-between gap-2 py-1">
      <!-- Left section: Warning icon and message -->
      <div class="flex items-center gap-1.5 min-w-0 flex-1">
        <Icon
          name="alert"
          class="w-3 h-3 flex-shrink-0 text-[#DC2626]"
          aria-hidden="true"
        />
        <p class="text-[11px] leading-tight text-slate-500 truncate sm:whitespace-normal">
          <span class="font-semibold text-[#DC2626]">{warningLabel}:</span>
          <span class="hidden sm:inline"> {warningMessage}</span>
        </p>
      </div>

      <!-- Right section: Action link + dismiss -->
      <div class="flex items-center gap-2 flex-shrink-0 pl-2">
        <a
          href={linkHref}
          class="inline-flex items-center gap-0.5 text-[11px] font-semibold text-[#DC2626] hover:underline whitespace-nowrap"
          aria-label={linkText}
        >
          <span>Learn more</span>
          <Icon name="chevronRight" class="w-2.5 h-2.5 flex-shrink-0" aria-hidden="true" />
        </a>

        <button
          class="flex-shrink-0 p-0.5 rounded text-slate-300 hover:text-[#DC2626] transition-colors duration-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-[#DC2626]"
          aria-label="Dismiss scam warning"
          onclick="this.closest('[data-scam-banner]').remove(); localStorage.setItem('scamBannerDismissed', 'true');"
        >
          <Icon name="x" class="w-3 h-3" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Check if localStorage is available (client-side only)
  if (typeof window !== 'undefined' && window.localStorage) {
    // Hide banner on page load if dismissed by user
    const isDismissed = localStorage.getItem('scamBannerDismissed') === 'true';
    if (isDismissed) {
      const banner = document.currentScript.closest('div'); // Get the parent div
      if (banner) {
        banner.style.display = 'none';
      }
    }

    // Re-show banner on specific pages or after 1 day
    const dismissDate = localStorage.getItem('scamBannerDismissDate');
    const now = new Date().getTime();
    const dayInMs = 24 * 60 * 60 * 1000;

    // Show banner again after 24 hours
    if (dismissDate && (now - parseInt(dismissDate)) > dayInMs) {
      localStorage.removeItem('scamBannerDismissed');
      localStorage.removeItem('scamBannerDismissDate');
    }
  }
</script>
